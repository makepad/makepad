mod.theme = mod.themes.dark

// Glossy anthracite. Dark blue-grey metal: a brushed ground under a soft
// light from the top, raised caps with a deep gloss fall, a light line on
// their top edge and a specular sheen on their upper left, polished metal
// knobs and slider balls, brushed-metal plates. State is said by light: a
// small blue-white lamp lit or dark, a lit blue tube in a groove, a legend
// that glows. The faces are drawn in widgets.splash; this file holds the
// tokens every face and every stock widget reads.
mod.theme.color_bg_app = #262c35
mod.theme.color_fg_app = #262c35
mod.theme.color_bg_container = #262c35

// Raised caps: the middle of the face, for any stock face this sheet does
// not replace.
mod.theme.color_outset = #323a44
mod.theme.color_outset_1 = #3d4652
mod.theme.color_outset_2 = #232932
mod.theme.color_outset_hover = #38414c
mod.theme.color_outset_1_hover = #46505c
mod.theme.color_outset_2_hover = #283039
mod.theme.color_outset_focus = #323a44
mod.theme.color_outset_1_focus = #3d4652
mod.theme.color_outset_2_focus = #232932
mod.theme.color_outset_active = #23344a
mod.theme.color_outset_1_active = #23344a
mod.theme.color_outset_2_active = #23344a
mod.theme.color_outset_down = #20262e
mod.theme.color_outset_1_down = #20262e
mod.theme.color_outset_2_down = #20262e
mod.theme.color_outset_drag = #20262e
mod.theme.color_outset_1_drag = #20262e
mod.theme.color_outset_2_drag = #20262e
mod.theme.color_outset_disabled = #2a3038
mod.theme.color_outset_1_disabled = #2a3038
mod.theme.color_outset_2_disabled = #2a3038

// Wells cut into the ground: fields, tracks, trays.
mod.theme.color_inset = #171c22
mod.theme.color_inset_1 = #171c22
mod.theme.color_inset_2 = #1d232a
mod.theme.color_inset_hover = #1a1f26
mod.theme.color_inset_1_hover = #1a1f26
mod.theme.color_inset_2_hover = #1d232a
mod.theme.color_inset_focus = #171c22
mod.theme.color_inset_1_focus = #171c22
mod.theme.color_inset_2_focus = #1d232a
mod.theme.color_inset_active = #171c22
mod.theme.color_inset_1_active = #171c22
mod.theme.color_inset_2_active = #1d232a
mod.theme.color_inset_down = #171c22
mod.theme.color_inset_1_down = #171c22
mod.theme.color_inset_2_down = #1d232a
mod.theme.color_inset_drag = #171c22
mod.theme.color_inset_1_drag = #171c22
mod.theme.color_inset_2_drag = #1d232a
mod.theme.color_inset_empty = #171c22
mod.theme.color_inset_1_empty = #171c22
mod.theme.color_inset_2_empty = #1d232a
mod.theme.color_inset_disabled = #20252c
mod.theme.color_inset_1_disabled = #20252c
mod.theme.color_inset_2_disabled = #20252c

// Every edge a stock face strokes is the black outline; the light comes from
// the one top line the faces draw, not from a bevel.
mod.theme.beveling = 0.34
mod.theme.color_bevel = #0a0a0c
mod.theme.color_bevel_hover = #0a0a0c
mod.theme.color_bevel_focus = #4f8fd6
mod.theme.color_bevel_active = #0a0a0c
mod.theme.color_bevel_empty = #0a0a0c
mod.theme.color_bevel_down = #0a0a0c
mod.theme.color_bevel_drag = #0a0a0c
mod.theme.color_bevel_disabled = #161a1f
mod.theme.color_bevel_inset_1 = #0a0a0c
mod.theme.color_bevel_inset_2 = #0a0a0c
mod.theme.color_bevel_outset_1 = #0a0a0c
mod.theme.color_bevel_outset_2 = #040405
mod.theme.color_bevel_inset_1_hover = #0a0a0c
mod.theme.color_bevel_inset_2_hover = #0a0a0c
mod.theme.color_bevel_outset_1_hover = #0a0a0c
mod.theme.color_bevel_outset_2_hover = #040405
mod.theme.color_bevel_inset_1_focus = #4f8fd6
mod.theme.color_bevel_inset_2_focus = #4f8fd6
mod.theme.color_bevel_outset_1_focus = #4f8fd6
mod.theme.color_bevel_outset_2_focus = #4f8fd6
mod.theme.color_bevel_inset_1_down = #0a0a0c
mod.theme.color_bevel_inset_2_down = #0a0a0c
mod.theme.color_bevel_outset_1_down = #0a0a0c
mod.theme.color_bevel_outset_2_down = #0a0a0c
mod.theme.color_bevel_inset_1_disabled = #161a1f
mod.theme.color_bevel_inset_2_disabled = #161a1f
mod.theme.color_bevel_outset_1_disabled = #161a1f
mod.theme.color_bevel_outset_2_disabled = #161a1f

// Ink. Caps carry #d4dae2; words on the ground a touch lighter, never past
// #e3e7ec at rest. Dim and disabled ink is #626a74.
mod.theme.color_text = #d4dae2
mod.theme.color_text_hover = #dde2e8
mod.theme.color_text_focus = #dde2e8
mod.theme.color_text_active = #dde2e8
mod.theme.color_text_down = #d4dae2
mod.theme.color_text_val = #aeb5be
mod.theme.color_text_disabled = #626a74
mod.theme.color_text_placeholder = #7d8793
mod.theme.color_text_placeholder_hover = #87919d
mod.theme.color_text_meta = #838b96
mod.theme.color_text_cursor = #f0fbff
mod.theme.color_cursor = #f0fbff
mod.theme.color_label = #dde2e8
mod.theme.color_label_hover = #e3e7ec
mod.theme.color_label_focus = #e3e7ec
mod.theme.color_label_active = #e3e7ec
mod.theme.color_label_down = #dde2e8
mod.theme.color_label_disabled = #626a74
mod.theme.color_label_inner = #d4dae2
mod.theme.color_label_inner_hover = #dde2e8
mod.theme.color_label_inner_focus = #d4dae2
mod.theme.color_label_inner_active = #f4f7fa
mod.theme.color_label_inner_down = #c3c9d1
mod.theme.color_label_inner_drag = #c3c9d1
mod.theme.color_label_inner_inactive = #838b96
mod.theme.color_label_inner_disabled = #626a74
mod.theme.color_label_outer = #dde2e8
mod.theme.color_label_outer_off = #9aa2ac
mod.theme.color_label_outer_hover = #e3e7ec
mod.theme.color_label_outer_focus = #dde2e8
mod.theme.color_label_outer_active = #e3e7ec
mod.theme.color_label_outer_active_focus = #e3e7ec
mod.theme.color_label_outer_down = #dde2e8
mod.theme.color_label_outer_drag = #dde2e8
mod.theme.color_label_outer_disabled = #626a74
mod.theme.color_icon = #c3c9d1
mod.theme.color_icon_hover = #dde2e8
mod.theme.color_icon_focus = #c3c9d1
mod.theme.color_icon_active = #f4f7fa
mod.theme.color_icon_down = #c3c9d1
mod.theme.color_icon_disabled = #626a74

// The light. The LED's rim and the focus ring are #4f8fd6; lit words and
// check marks #48a8ff; value fills #4db0ff.
mod.theme.color_focus = #4f8fd6
mod.theme.color_ctrl_active = #48a8ff
mod.theme.color_val = #4db0ff
mod.theme.color_val_hover = #4db0ff
mod.theme.color_val_focus = #4db0ff
mod.theme.color_val_drag = #4db0ff
mod.theme.color_val_disabled = #34465e
mod.theme.color_mark_active = #48a8ff
mod.theme.color_mark_active_hover = #48a8ff
mod.theme.color_mark_focus = #48a8ff
mod.theme.color_mark_disabled = #474e59
// The accent seed: the primary, secondary and tertiary families are
// grown from it, and nothing else in this file reaches them. It is the
// selected row of a menu, the one place this family fills with colour.
mod.theme.color_ctrl_selected = #3a7cc6
mod.theme.color_bg_highlight = #303843
mod.theme.color_bg_highlight_inline = #27496e
mod.theme.color_text_on_accent = #ffffff
// Selected text: the accent at a third over the well while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #00000000
mod.theme.color_selection_down = #27496e
mod.theme.color_selection_focus = #27496e

// SPACING. Rows of 26 points, gaps of 8, panels padded 12. The base theme
// froze everything it derives from space_factor when it was built, so every
// rung this sheet depends on is stated again here.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 20.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 28.0
mod.theme.tab_flat_height = 26.0
// Stock shaders draw a corner twice the number written: 1.5 is the 3 point
// corner of a cap, 3 the 6 point corner of a panel.
mod.theme.corner_radius = 1.5
mod.theme.container_corner_radius = 3.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs written in true points: caps 3, panels and cards 6.
mod.theme.radius_s = 3.0
mod.theme.radius_m = 3.0
mod.theme.radius_l = 6.0

// TYPE. The library's own neutral grotesque. Cap and field labels at 8.5
// points, so the cap height is about a third of the 26 point cap; the
// group captions and a lit legend use its bold.
mod.theme.font_size_p = 8.5
mod.theme.font_size_base = 8.5
// The whole ladder, restated: the base theme froze its rungs from its own
// 10 point base, so "small" came out larger than a cap label and panel text
// larger than both. Small 8, body 8.5, titles 9.5 to 11.5.
mod.theme.type_label_l_size = 8.5
mod.theme.type_label_m_size = 8.0
mod.theme.type_label_s_size = 7.5
mod.theme.type_body_l_size = 9.0
mod.theme.type_body_m_size = 8.5
mod.theme.type_body_s_size = 8.0
mod.theme.type_title_s_size = 9.5
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_l_size = 11.5
// The heading rung a card title takes (H4), on the same ladder.
mod.theme.font_size_4 = 10.5
// The styles built from those rungs, and the two plain faces a label takes
// when it names no size (the base draws them at 10). Only the size changes;
// each keeps the base theme's family with all its members.
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.5}
mod.theme.font_bold = mod.theme.font_bold{font_size: 9.0}
mod.theme.font_title_l = mod.theme.font_bold{font_size: 11.5 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.5 line_spacing: 1.2}
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 8.0 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 8.0 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}

// No surface material: every face that matters is drawn by the sheet, and
// the rest stay flat rather than take a relief that is not this family's.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #4f8fd6
true
