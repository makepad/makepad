// The combo box: the field one types into, its chevron drawn in chalk at
// the right end; the chevron sits down a device pixel while held.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 10.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.clip_x = false
mod.widgets.ComboBox.clip_y = false
mod.widgets.ComboBox.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    var out = cb_field(p, size, self.rect_pos, px, self.hover, self.focus, self.disabled, 6.0)
    let held = self.down * self.hover * live
    let cc = vec2(size.x - 15.0, size.y * 0.5 + held * px + 0.3)
    let chev = min(cb_seg(p, cc + vec2(-4.4, -2.2), cc + vec2(0.0, 2.2)), cb_seg(p, cc + vec2(0.0, 2.2), cc + vec2(4.4, -2.2)))
    return Finish.over(out, cb_stroke(chev, 0.85, p, px, mix(cb_chalk_c(), cb_dim_c(), self.disabled), mix(1.0, 0.6, self.disabled)))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. The strip is one box drawn in chalk; the chosen segment
// is a smaller box inside it rubbed full of chalk, its word in the board's
// dark, so it reads as the one pressed in.
let cb_strip = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    return cb_outline(cb_rbox(p, c, h, 9.0), p, px, 0.95, cb_chalk_c(), 0.9, size * vec2(0.11, 0.07))
}
// The chosen cell: the chalk field and its own line. `lo` and `hi` are the
// cell's corners in the quad's own points.
let cb_cell = fn(p: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d0 = cb_rbox(p, c, h, 7.0)
    var out = cb_filled(d0 + 1.0, p + hi * 1.7, px, cb_chalk_c(), 1.0, hi.x)
    return Finish.over(out, cb_outline(d0, p, px, 0.8, cb_chalk_c(), 0.95, hi * 0.21))
}

mod.widgets.SegmentedControlFlat.segment_height = 28.0
mod.widgets.SegmentedControlFlat.segment_padding = 12.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cb_strip(p, self.rect_size, self.rect_pos, px)
}
// The pill is the segment's own box, inside the strip's line; the chalk field
// stands two points further in. Its quad grows two points round it for the
// chalk's dust.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(2.0, 2.0), self.rect_size + vec2(4.0, 4.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(4.0, 4.0)) - vec2(2.0, 2.0)
    let lo = vec2(Finish.snap(o.x + 2.0, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 2.0, px), Finish.snap(o.y + size.y - 2.0, px)) - o
    return cb_cell(p, lo, hi, px)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #e8eae6
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #1d2120
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #1d2120
mod.widgets.SegmentedControlFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_label{}

// The tab strip: the tabs are their words written on the board; the tab in
// use is underlined in chalk, a hovered one faintly. The close mark is a
// chalk cross; the add mark a plus in a chalk ring.
let cb_tab = fn(pos: vec2, size: vec2, o: vec2, px: float, kind: float, hover: float) -> vec4 {
    let m = 5.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(Finish.snap(o.x + 6.0, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 6.0, px), Finish.snap(o.y + size.y, px)) - o
    let uy = hi.y - 4.5 + cb_wob(p, 0.4, vec2(size.x * 0.1, 3.0))
    let du = cb_seg(p, vec2(lo.x, uy), vec2(hi.x, uy - 0.6))
    var out = cb_stroke(du, 0.6, p, px, cb_chalk_c(), 0.4 * hover)
    return Finish.over(out, cb_stroke(du, 1.05, p + vec2(7.0, 3.0), px, cb_chalk_c(), step(0.5, kind)))
}
