mod.widgets.Tabs.draw_sep.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_mark.color = #e8eae6
mod.widgets.Tabs.draw_mark.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let c = self.rect_size * 0.5
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.plus > 0.5 {
        let rr = min(self.rect_size.x, self.rect_size.y) * 0.5 + 1.0
        out = cb_outline(length(p - c) - rr, p, px, 0.85, self.color.rgb, self.color.a, vec2(23.0, 7.0))
    }
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(3.4, 4.6, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(0.0 - sin(a), cos(a)) * r
    let dd = min(cb_seg(p, c - u, c + u), cb_seg(p, c - v, c + v))
    return Finish.over(out, cb_stroke(dd, mix(0.7, 0.85, self.plus), p, px, self.color.rgb, self.color.a))
}
mod.widgets.Tabs.draw_text.color = #c4c8c5
mod.widgets.Tabs.draw_text_active.color = #f8f9f6
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_label{font_size: 13.5}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_label{font_size: 13.5}

// ---------------------------------------------------------------------------
// PROGRESS. A thin chalk line the length of the bar, and over the value a
// broad band drawn round in chalk and rubbed and hatched full (a coloured
// chalk for an intent). The unknown value is a row of short upright
// capsules drawn in chalk along the whole bar: a face may not run a clock.
mod.widgets.ProgressBarFlat.height = 9.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = uniform(8.0)
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(self.thickness, size.y)
    let cy = size.y * 0.5
    let x0 = size.x * self.start
    let x1 = size.x * self.end
    let dis = step(4.5, self.intent)
    var ink = cb_chalk_c()
    if self.intent > 0.5 {
        ink = mix(self.fill_color().rgb, cb_chalk_c(), 0.35)
    }
    ink = mix(ink, cb_dim_c(), dis)
    let wy = cy + (Finish.noise(vec2(p.x * 0.04, 7.0)) - 0.5) * 0.6
    let hw = th * 0.5 - 0.3
    var out = cb_stroke(cb_seg(p, vec2(x0 + 0.8, wy), vec2(x1 - 0.8, wy)), 0.75, p, px, cb_chalk_c(), 0.6 * self.track * step(0.0, self.value))
    if self.value < 0.0 {
        let u = (p.x - x0) / 7.0
        let k = floor(u)
        let sx = x0 + (k + 0.5) * 7.0 + (Finish.hash(vec2(k, 3.0)) - 0.5) * 0.8
        let ds = cb_rbox(p, vec2(sx, wy), vec2(1.3, hw), 1.3)
        let inr = step(x0 + 1.0, sx) * step(sx, x1 - 1.0)
        out = Finish.over(out, cb_rub(ds + 0.6, p, px, ink, 0.45, inr))
        out = Finish.over(out, cb_outline(ds, p, px, 0.55, ink, inr, vec2(k, 1.0)))
    } else {
        let v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
        if v1 - x0 > 0.5 {
            let bc = vec2((x0 + v1) * 0.5, wy)
            let bh = vec2((v1 - x0) * 0.5, hw)
            let bd = cb_rbox(p, bc, bh, hw)
            out = out * (1.0 - Finish.cover(bd, px))
            out = Finish.over(out, cb_filled(bd + 1.0, p + vec2(3.0, 11.0), px, ink, 1.0, 2.0))
            out = Finish.over(out, cb_outline(bd, p, px, 0.65, ink, 1.0, vec2(5.0, 3.0)))
        }
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LAMPS: an LED set into the board, ringed round in chalk. The emitter is the
// light: at full current its middle burns toward white and its rim is its
// most saturated colour; at lower current the middle is no longer white,
// the colour deeper, the glow smaller; out, it is dark tinted glass, its
// colour barely there. Round it a dark socket, its upper wall in shade and
// a catch light on its lower rim, and round that a ring drawn in chalk.
// Over the lens one crisp highlight of a dome. Its light is added, never
// painted: a tight hot halo and a short bloom in its own hue, screened over
// the board and gone in about two radii.
let cb_led_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(0.0 - light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let cb_led = fn(p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.42 * rt, 1.0, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
    let mn = min(b.x, min(b.y, b.z))
    let pure = (b - vec3(mn, mn, mn)) / max(1.0 - mn, 0.001)
    let hue = mix(b, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, 1.0 - mn))
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let ground = cb_slate_c()
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // the ring drawn round it in chalk
    res = Finish.over(res, cb_stroke(abs(ds - 1.8 + cb_wob(p, 0.25, c * 0.1)), 0.68, p + c, px, cb_chalk_c(), 0.92))
    // the socket: the hole's wall, shade above and a catch light below
    let a_s = Finish.cover(ds, px)
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = vec3(0.060, 0.068, 0.064) * mix(0.55, 1.3, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, vec3(0.42, 0.44, 0.43), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.7)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // the light: a tight hot halo and a short bloom in its hue
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(0.0 - xl / max(0.30 * rt, 0.4)) * 1.5 + exp(0.0 - xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(0.55 * room, room, xl)
        res = cb_led_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin, ground)
    }
    // the bead: a glossy dome of coloured glass
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(0.0 - (q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(0.0 - t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    let offc = mix(vec3(0.075, 0.078, 0.076), b * 0.45, 0.24)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A row of small boxes drawn in chalk, the lit ones rubbed
// full and the last tenth in pink chalk, the unlit ones only drawn round,
// half rubbed away; the hold is a stroke drawn across; the over lamp an LED
// ringed in chalk. On a display (a meter with no lamp lying along a screen)
// the boxes are the display's pale yellow chalk, the unlit ones a smudge.
mod.widgets.LevelMeter.height = 9.0
mod.widgets.LevelMeterColumn.width = 9.0
mod.widgets.LevelMeter.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let screen = (1.0 - step(0.5, self.lamp)) * (1.0 - step(0.5, vert))
    let th = min(8.0, across - 1.0)
    let lamp_room = self.lamp * (th + 6.0)
    let bar = max(4.0, along - lamp_room)
    let pitch = mix(5.5, 4.0, screen)
    let cw = mix(3.4, 2.4, screen)
    let n = max(floor((bar - 1.0) / pitch), 1.0)
    let pad = (bar - n * pitch) * 0.5
    let k = clamp(floor((a - pad) / pitch), 0.0, n - 1.0)
    let ca = pad + (k + 0.5) * pitch
    let share = (k + 0.5) / n
    let lit = step(share, self.level + 0.5 / n) * step(0.001, self.level)
    let q = vec2(a, b)
    let hh = th * 0.5 - mix(0.5, 1.0, screen)
    let dd = cb_rbox(q, vec2(ca, across * 0.5), vec2(cw * 0.5, hh), 1.0)
    let hot = step(0.9, share)
    var ink = mix(cb_chalk_c(), cb_pink_c(), hot)
    ink = mix(ink, cb_yellow_c(), screen)
    var out = cb_rub(dd, p, px, ink, 0.85, lit)
    out = Finish.over(out, cb_stroke(abs(dd + 0.35), 0.4, p + vec2(k * 7.0, 0.0), px, ink, mix(mix(0.45, 0.85, lit), mix(0.12, 0.9, lit), screen)))
    if self.hold > 0.002 {
        let at = pad + n * pitch * self.hold
        let hd = cb_seg(q, vec2(at, across * 0.5 - hh - 1.0), vec2(at, across * 0.5 + hh + 1.0))
        out = Finish.over(out, cb_stroke(hd, 0.75, p, px, ink, 1.0))
    }
    if self.lamp > 0.5 {
        let la = bar + 3.0 + th * 0.5
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, cb_led(p, lc, vec2(2.4, 2.4), step(0.5, self.over), vec3(0.95, 0.20, 0.12), 1.0, px, 2.2))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A faint chalk line down the bar, and riding on it a narrow
// band drawn round in chalk and rubbed in; brighter under the hand.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let sc = self.rect_size * 0.5
    let sh = mix(vec2(along * 0.5 - 2.0, 0.0), vec2(0.0, along * 0.5 - 2.0), vert)
    let sd = cb_rbox(p, sc, sh, 0.0)
    var out = cb_stroke(abs(sd), 0.45, p, px, cb_chalk_c(), 0.30)
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let tc1 = t0 + tl * 0.5
    let tc = mix(vec2(tc1, sc.y), vec2(sc.x, tc1), vert)
    let th = mix(vec2(max(tl * 0.5 - 1.5, 4.0), 2.8), vec2(2.8, max(tl * 0.5 - 1.5, 4.0)), vert)
    let td = cb_rbox(p, tc, th, 2.8)
    out = out * (1.0 - Finish.cover(td, px))
    let lift = 0.10 * self.hover + 0.12 * self.drag
    out = Finish.over(out, cb_rub(td + 0.8, p, px, cb_chalk_c(), 0.35 + lift, 1.0))
    out = Finish.over(out, cb_outline(td, p, px, 0.55, cb_chalk_c(), 0.75 + lift * 2.0, vec2(3.0, 9.0)))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised panel is a box drawn round in chalk, a breath
// of dust rubbed over its inside. The sunken panel is drawn as a frame in a
// frame: its box, and a second box drawn three points inside the first, the
// board inside them a shade darker where no dust has settled.
let cb_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let seed = size * vec2(0.073, 0.119)
    let d0 = cb_rbox(p, c, h, r)
    if sunken > 0.5 {
        let a = Finish.cover(d0 + 3.0, px) * 0.32
        var out = vec4(0.0, 0.0, 0.0, a)
        out = Finish.over(out, cb_outline(d0, p, px, 0.9, cb_chalk_c(), 0.85, seed))
        let di = cb_rbox(p, c, h - vec2(3.2, 3.2), max(r - 2.5, 1.0))
        return Finish.over(out, cb_outline(di, p, px, 0.6, cb_chalk_c(), 0.55, seed + vec2(3.0, 7.0)))
    }
    var out = cb_rub(d0 + 2.0, p + seed, px, cb_chalk_c(), 0.05, 1.0)
    return Finish.over(out, cb_outline(d0, p, px, 0.95, cb_chalk_c(), 0.88, seed))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cb_plate(p, self.rect_size, self.rect_pos, px, 8.0, self.sunken)
}

// The card is a box drawn in chalk with its top right corner folded down,
// the fold drawn in and hatched, as a note card is drawn on a board; under
// the pointer its line is a shade brighter.
mod.widgets.Card.radius = 6.0
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 8.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let f = 13.0
    // the box with its corner cut, and the folded flap
    let box = cb_rbox(p, c, h, 6.0)
    let cut = (p.x - (hi.x - f)) - (p.y - lo.y)
    let d0 = max(box, cut * 0.7071)
    let flap = max(max(hi.x - f - p.x, p.y - (lo.y + f)), cut * 0.7071)
    let lift = 0.88 + 0.12 * self.hover - 0.1 * self.down
    var out = cb_rub(d0 + 2.0, p + size * 0.37, px, cb_chalk_c(), 0.04 + 0.04 * self.hover, 1.0)
    out = Finish.over(out, cb_hatch(flap + 1.0, p, px, cb_chalk_c(), 2.4, 0.6, 9.0))
    out = Finish.over(out, cb_outline(d0, p, px, 0.95, cb_chalk_c(), lift, size * 0.05))
    return Finish.over(out, cb_outline(flap, p, px, 0.75, cb_chalk_c(), lift * 0.9, size * 0.03))
}

// The plain rounded view keeps the colour its caller gives it, laid as a
// patch of that colour with the slate's grain in it; the edge a chalk line
// where the caller asks for one.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, max(self.border_radius, 1.0))
    let grain = cb_slate(p + self.rect_size * 0.29, px, step(0.9, fill.a)) / cb_slate_c()
    let col = fill.rgb * grain
    let a = Finish.cover(d, px) * fill.a
    var out = vec4(col * a, a)
    if self.border_size > 0.0 {
        out = Finish.over(out, cb_stroke(abs(d + max(self.border_size, 0.6)), max(self.border_size * 0.6, 0.5), p, px, self.border_color.rgb, self.border_color.a))
    }
    return out
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points of words on the board; a hovered row is
// underlined in faint chalk; the chosen row is a soft band drawn round and
// lightly rubbed, so its chalk words still stand out on it.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 8.0 top: 0.0 bottom: 0.0}
let cb_row_band = fn(p: vec2, lo: vec2, hi: vec2, px: float, seed: float) -> vec4 {
    let h = vec2((hi.x - lo.x) * 0.5 - 4.0, (hi.y - lo.y) * 0.5 - 1.5)
    let c = vec2((lo.x + hi.x) * 0.5, (lo.y + hi.y) * 0.5)
    let d0 = cb_rbox(p, c, h, h.y)
    var out = cb_rub(d0 + 1.2, p + vec2(3.0, 41.0 + seed), px, cb_chalk_c(), 0.22, 1.0)
    out = Finish.over(out, cb_hatch(d0 + 1.5, p + vec2(seed, 7.0), px, cb_chalk_c(), 3.2, 0.32, seed))
    return Finish.over(out, cb_outline(d0, p, px, 0.65, cb_chalk_c(), 0.8, vec2(seed, 3.0)))
}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.selected > 0.5 {
        out = cb_row_band(p, lo, hi - vec2(10.0, 0.0), px, 5.0)
    }
    let uy = hi.y - 2.5 + (Finish.noise(vec2(p.x * 0.07, 5.0)) - 0.5) * 0.6
    let du = cb_seg(p, vec2(lo.x + 8.0, uy), vec2(hi.x - 14.0, uy))
    out = Finish.over(out, cb_stroke(du, 0.45, p, px, cb_chalk_c(), (0.35 * self.hover + 0.25 * self.down) * live * (1.0 - self.selected)))
    return out
}
mod.widgets.ListItem.draw_text.color = #e8eae6

// The open list of a drop-down: a small slate held over the board, drawn
// round in chalk; the row under the pointer is rubbed with a little chalk,
// the chosen row carries a chalk tick.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d0 = cb_rbox(p, c, h, 6.0)
    let a = Finish.cover(d0 + 0.5, px)
    let face = cb_slate(p + vec2(17.0, 9.0), px, 1.0) * 0.92
    var out = vec4(face * a, a)
    return Finish.over(out, cb_outline(d0, p, px, 0.9, cb_chalk_c(), 0.92, size * 0.07))
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let live = 1.0 - self.disabled
    let h = vec2(c.x - 4.0, c.y - 2.0)
    let d = cb_rbox(p, c, h, h.y)
    var out = cb_rub(d, p + vec2(5.0, 9.0), px, cb_chalk_c(), 0.30, self.hover * live)
    let m0 = vec2(6.0, c.y)
    let m1 = vec2(8.8, c.y + 3.0)
    let m2 = vec2(13.6, c.y - 3.8)
    let mk = min(cb_seg(p, m0, m1), cb_seg(p, m1, m2))
    return Finish.over(out, cb_stroke(mk, 0.85, p, px, cb_chalk_c(), self.active))
}

// The dock's tabs: the tab in use is drawn round in chalk on its top and
// sides, open at the foot where it joins the panel below; the others take a
// breath of dust under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x + 1.5, px), Finish.snap(o.y + 3.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.5, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 8.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, 6.0)
    var out = cb_rub(d + 1.5, p, px, cb_chalk_c(), 0.08, self.hover * (1.0 - self.active))
    return Finish.over(out, cb_outline(d, p, px, 0.8, cb_chalk_c(), 0.9 * self.active, vec2(7.0, 7.0)))
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = self.rect_size.y - 1.0 + (Finish.noise(vec2(p.x * 0.05, 1.0)) - 0.5) * 0.4
    return cb_stroke(abs(p.y - yb), 0.55, p, px, cb_chalk_c(), 0.6)
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small chalk box (a soft rub of its colour when
// it has one, bare until touched when a ghost); a badge is a small box drawn
// round with its count, a rub of its colour inside.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let ch = min(26.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    let has_fill = step(0.05, self.color.a)
    let mx = max(self.color.r, max(self.color.g, self.color.b))
    let mn = min(self.color.r, min(self.color.g, self.color.b))
    let neutral = 1.0 - step(0.25, (mx - mn) / max(mx, 0.01))
    let kind = mix(mix(6.0, 5.0, step(0.01, self.border_size)), mix(7.0, 0.0, neutral), has_fill)
    let tint = vec4(self.color.rgb, has_fill)
    return cb_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(6.0, 6.0, 6.0, 6.0), kind, m, tint, 0.0)
}
mod.widgets.BadgePalette.neutral = #353a37
mod.widgets.BadgePalette.on_neutral = #e8eae6
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_label{font_size: 12.0}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_label{font_size: 12.0}
mod.widgets.BadgeFlat.clip_x = false
mod.widgets.BadgeFlat.clip_y = false
mod.widgets.BadgeFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let bh = min(20.0, self.rect_size.y - 1.0)
    let y0 = (self.rect_size.y - bh) * 0.5
    let lo = vec2(1.0, y0)
    let hi = vec2(self.rect_size.x - 1.0, y0 + bh)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = mix(5.0, h.y, step(self.rect_size.x, self.rect_size.y + 0.5) * step(self.rect_size.y, 12.5))
    let d0 = cb_rbox(p, c, h, r)
    let lum = Finish.lum(self.color.rgb)
    var out = cb_rub(d0 + 1.2, p + vec2(9.0, 4.0), px, self.color.rgb, 0.4, step(0.3, lum))
    out = Finish.over(out, cb_outline(d0, p, px, 0.75, cb_chalk_c(), 0.9, vec2(2.0, 8.0)))
    return out * self.color.a
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in chalk with a faint track ring.
mod.widgets.SpinnerFlat.draw_bg.color = #e8eae6
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 3.0
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.25

// Rules between groups: a faint line of chalk drawn by hand.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = self.rect_size.y * 0.5 + (Finish.noise(vec2(p.x * 0.04, 3.0)) - 0.5) * 0.8
    return cb_stroke(abs(p.y - y), 0.5, p, px, cb_chalk_c(), 0.45)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = self.rect_size.x * 0.5 + (Finish.noise(vec2(3.0, p.y * 0.04)) - 0.5) * 0.8
    return cb_stroke(abs(p.x - x), 0.5, p, px, cb_chalk_c(), 0.45)
}

// ---------------------------------------------------------------------------
// WORDS IN CHALK. Every pale word is chalk: where the board's grain did not
// take it, a device pixel here and there shows a little of the slate through
// the letter, so the hand reads as dry chalk while every letter keeps its
// whole shape. The grain is laid in the word's own points (its glyph's place
// and the point inside it), so it is never the same on two letters and does
// not move when a page scrolls. Dark words (on a chalk field) are clean.
// Written once, handed to every label.
let cb_words = fn() {
    if self.texture_index > 0.5 && self.texture_index < 1.5 {
        return self.sample_text_pixel()
    }
    if self.texture_index > 2.5 {
        return self.sample_text_pixel()
    }
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var a0 = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.sdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
    } else {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.msdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
    }
    let pale = step(0.45, dot(c.rgb, vec3(0.299, 0.587, 0.114)))
    let dpi = max(self.draw_pass.dpi_factor, 0.5)
    let wp = (self.rect_pos + self.pos * self.rect_size) * dpi
    let g1 = Finish.noise(wp * 0.5 + vec2(3.0, 7.0))
    let g2 = Finish.hash(floor(wp) + vec2(11.0, 5.0))
    let keep = smoothstep(0.28, 0.52, g1 * 0.55 + g2 * 0.45)
    let a = a0 * mix(1.0, 0.70 + 0.30 * keep, pale) * c.a
    return vec4(c.rgb * a, a)
}
mod.widgets.Label.draw_text.pixel = cb_words
mod.widgets.H1.draw_text.pixel = cb_words
