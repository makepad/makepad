// ---------------------------------------------------------------------------
// THE BOARD under everything: the window's own ground. The slate over its
// whole face; a thin haze of chalk dust left by old lessons and the long
// soft wipes of an eraser, both kept faint under the content and heavier
// toward the frame; and a broad, soft fall of light toward the corners. Round
// it a wooden frame: a rail along the top where the caption is, thin stiles
// down the sides, and along the foot the ledge the chalk lies on, a little
// dust spilled on it, with a stick of chalk and the eraser at the right.
let cb_wipes = fn(p: vec2, ang: float, spacing: float, seed: float) -> float {
    let cs = cos(ang)
    let sn = sin(ang)
    let u = p.x * cs + p.y * sn
    let v = p.y * cs - p.x * sn
    // the lanes bend with the arm's swing, differently from place to place,
    // so no two wipes run parallel for long
    let vb = v + (Finish.noise(vec2(u * 0.0028 + seed, v * 0.004)) - 0.5) * spacing * 1.4
    let k = floor(vb / spacing)
    let hk = Finish.hash(vec2(k, seed))
    let vc = (k + 0.5 + (hk - 0.5) * 0.3) * spacing
    let hw = spacing * (0.09 + 0.07 * Finish.hash(vec2(k + 5.0, seed))) * (0.7 + 0.6 * Finish.noise(vec2(u * 0.015, k + seed)))
    let edge = abs(vb - vc) / max(hw, 1.0) + (Finish.noise(vec2(u * 0.08, vb * 0.3 + seed)) - 0.5) * 0.35
    let band = 1.0 - smoothstep(0.40, 1.0, edge)
    let run = smoothstep(0.52, 0.68, Finish.noise(vec2(u * 0.007 + hk * 9.0, k * 2.3 + seed)))
    let streak = 0.5 + 0.5 * Finish.noise(vec2(u * 0.02, (vb - vc) * 0.9 + seed))
    return band * run * streak
}
let cb_wood = fn(along: float, across: float, px: float, seed: float) -> vec3 {
    let base = vec3(0.330, 0.205, 0.115)
    let fig = Finish.noise(vec2(along * 0.012 + seed, across * 0.35))
    let lines = Finish.noise(vec2(along * 0.03 + seed * 3.0, across * 1.6 + fig * 3.0))
    let pores = Finish.noise(vec2(along * 0.35, across * 3.5 + seed))
    var col = base * (0.80 + 0.30 * fig)
    col = mix(col, vec3(0.180, 0.105, 0.055), smoothstep(0.55, 0.85, lines) * 0.55)
    col = col * (0.94 + 0.10 * pores) + g3(Finish.grain(vec2(along, across) / px, 0.010))
    return col
}
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    var col = cb_slate(p, px, 1.0)
    // dust and wipes, faint under the content, heavier at the frame
    let e = min(min(p.x, sz.x - p.x), min(p.y, sz.y - p.y))
    let edge = 1.0 - smoothstep(8.0, 70.0, e)
    let haze = smoothstep(0.38, 0.85, Finish.fbm(p * 0.004 + vec2(7.0, 2.0)))
    let w1 = cb_wipes(p, -0.12, 90.0, 1.0)
    let w2 = cb_wipes(p + vec2(400.0, 37.0), 0.20, 130.0, 7.0)
    let dust = haze * (0.024 + 0.045 * edge) + max(w1, w2 * 0.8) * (0.026 + 0.05 * edge)
    col = col + (cb_chalk_c() - col) * dust
    // the fall of light toward the corners
    let q = (p - sz * 0.5) / (sz * 0.5)
    let vig = smoothstep(0.50, 1.50, length(q))
    col = col * (1.0 - 0.40 * vig)
    // THE FRAME. Rails 27 points along the top, 5 down the sides, the ledge
    // 10 at the foot; mitred at the corners.
    let tt = 27.0
    let ts = 5.0
    let tb = 10.0
    let dt = p.y - tt
    let dl = p.x - ts
    let dr = sz.x - ts - p.x
    let db = sz.y - tb - p.y
    let fd = min(min(dt, db), min(dl, dr))
    // the slate darkened in the frame's shade along its inner edge
    col = col * (1.0 - 0.30 * (1.0 - smoothstep(0.0, 4.0, fd)))
    if fd < 0.0 {
        var wood = vec3(0.0, 0.0, 0.0)
        if dt <= min(min(dl, dr), db) && p.y < tt {
            // top rail: grain along x, lit from above
            wood = cb_wood(p.x, p.y, px, 1.0)
            let v = p.y / tt
            wood = wood * (1.10 - 0.25 * smoothstep(0.55, 1.0, v))
            wood = mix(wood, wood * 1.45, Finish.band(0.0 - p.y, 0.0, 1.2, px) * 0.5)
        } else {
            if db <= min(dl, dr) {
                // the ledge: its top face catching the light, chalk dust on
                // it, and its front edge a darker band
                let yy = p.y - (sz.y - tb)
                wood = cb_wood(p.x, yy, px, 5.0)
                let topf = 1.0 - smoothstep(4.5, 5.5, yy)
                wood = mix(wood * 0.78, wood * 1.18, topf)
                let spill = smoothstep(0.55, 0.85, Finish.noise(vec2(p.x * 0.05, yy * 0.4))) * topf
                let specks = step(0.82, Finish.hash(floor(p / px))) * topf
                wood = wood + (cb_chalk_c() - wood) * clamp(spill * 0.35 + specks * 0.18 * (0.3 + spill), 0.0, 0.6)
            } else {
                // a side stile: grain down it
                let xx = min(p.x, sz.x - p.x)
                wood = cb_wood(p.y, xx, px, 3.0)
                wood = wood * (0.92 + 0.10 * smoothstep(0.0, ts, xx))
            }
        }
        // a dark seam where the frame meets the slate and at the mitres
        wood = mix(wood, wood * 0.55, (1.0 - smoothstep(0.0, 1.2, 0.0 - fd)) * 0.8)
        col = wood
    }
    // On the ledge, at the right: a stick of chalk and the eraser.
    let ly = sz.y - tb + 2.5
    let sc = vec2(sz.x - 118.0, ly)
    let ec = vec2(sz.x - 62.0, sz.y - tb - 1.0)
    let lie = min(cb_rbox(p, sc + vec2(0.8, 1.6), vec2(16.0, 2.0), 2.0), cb_rbox(p, ec + vec2(1.0, 4.4), vec2(24.0, 2.0), 1.5))
    col = col * (1.0 - 0.45 * (1.0 - smoothstep(-0.5, 1.6, lie)))
    let stick = cb_rbox(p, sc, vec2(16.0, 2.2), 2.2)
    let sa = Finish.cover(stick, px)
    let scol = vec3(0.93, 0.93, 0.91) * (0.86 + 0.14 * Finish.noise(p * 0.9)) * (1.05 - 0.25 * smoothstep(-2.0, 2.0, p.y - sc.y))
    col = mix(col, scol, sa)
    let er = cb_rbox(p, ec, vec2(24.0, 5.0), 1.5)
    let felt = cb_rbox(p, ec + vec2(0.0, 3.2), vec2(23.5, 1.8), 1.0)
    let ea = Finish.cover(er, px)
    var ecol = cb_wood(p.x * 1.3, p.y, px, 9.0) * 1.25
    ecol = mix(ecol, vec3(0.62, 0.62, 0.60) * (0.8 + 0.2 * Finish.noise(p * 1.4)), Finish.cover(felt, px))
    col = mix(col, ecol, ea)
    return vec4(col, 1.0)
}

// A splitter is a seam between two panes: down its middle a faint line of
// chalk; under the hand, held or focused, the line is gone over along the
// grip's length.
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let v = self.is_vertical
    let across = mix(p.y, p.x, v)
    let along = mix(p.x, p.y, v)
    let thick = mix(self.rect_size.y, self.rect_size.x, v)
    let span = mix(self.rect_size.x, self.rect_size.y, v)
    let m = thick * 0.5 + (Finish.noise(vec2(along * 0.03, 2.0)) - 0.5) * 0.6
    var out = cb_stroke(abs(across - m), 0.4, p, px, cb_chalk_c(), 0.28)
    let act = max(max(self.hover, self.drag), self.focus)
    let inbar = 1.0 - smoothstep(self.bar_size * 0.5 - 2.0, self.bar_size * 0.5, abs(along - span * 0.5))
    return Finish.over(out, cb_stroke(abs(across - m), 0.8, p, px, cb_chalk_c(), act * inbar))
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES are the sheet's own toggle, in proportion with the labels
// and the controls beside them: the rocker and the slide switch take the
// toggle's face (the pill, its hatching and its dot), its size and shape,
// its quad and its label gap; the rocker's dot is pale yellow chalk and the
// slide's light blue, so the two kinds tell apart.
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 47.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 47.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.draw_bg.size = uniform(18.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(18.0)
mod.widgets.ToggleRocker.min_height = 26.0
mod.widgets.ToggleSlide.min_height = 26.0
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.111)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(2.111)
mod.widgets.ToggleRocker.draw_bg.knob_inset = uniform(9.0)
mod.widgets.ToggleSlide.draw_bg.knob_inset = uniform(9.0)
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 9.0, self.size, self.pill_aspect)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 2.0, self.size, self.pill_aspect)
}

// The readouts and the screen: the instrument frame round a clean patch of
// slate.
mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let b = 3.0
    let face = cb_screen_face(p, px, self.color.rgb)
    return cb_window(p, lo, hi, 7.0, b, px, face, max(self.recess, 2.5))
}
mod.widgets.ScreenView.bezel = 3.0
mod.widgets.ScreenView.sheen = 0.0

// THE DIGITS of a readout are written in chalk: each lit segment a chalk
// stroke with the slate showing through its grain, the unlit ones a faint
// smudge of dust where they were rubbed out.
mod.widgets.Readout.draw_bg.pixel = fn() {
    let h = max(self.rect_size.y, 1.0)
    let pp = self.pos * self.rect_size
    let over = (self.rect_size.x - self.span) * 0.5
    let p = (pp - vec2(over, 0.0)) / h
    let q = vec2(p.x + (p.y - 0.5) * self.slant, p.y)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = self.stroke
    var lit = 10.0
    var all = 10.0
    if self.colon > 0.5 {
        let cx = self.span / h * 0.5
        let rr = s * 0.62
        let d1 = length(q - vec2(cx, 0.31)) - rr
        let d2 = length(q - vec2(cx, 0.69)) - rr
        all = min(d1, d2)
        lit = all
    } else {
        let x0 = (self.span / h - self.glyph_width) * 0.3
        let dq = q - vec2(x0, 0.0)
        let dd = self.digit(dq)
        let room = self.span / h - x0 - self.glyph_width
        let dp = length(dq - vec2(self.glyph_width + room * 0.45, 1.0 - s * 0.62)) - s * 0.62
        all = min(dd.y, dp)
        lit = min(dd.x, dp + (1.0 - step(0.5, self.dot)) * 10.0)
    }
    let wp = pp + self.rect_pos * 0.37
    let body = Finish.cover(lit * h, px)
    let tooth = cb_tooth(wp, px, lit * h)
    let keep = smoothstep(0.20, 0.34, tooth)
    let a_lit = body * mix(0.35, 1.0, keep)
    let ghost = Finish.cover(all * h, px) * clamp(self.ghost, 0.0, 1.0) * smoothstep(0.35, 0.6, tooth) * (1.0 - body)
    let a = clamp(a_lit + ghost, 0.0, 1.0) * self.opacity * self.color.a
    let bright = 0.88 + 0.12 * Finish.noise(wp / px * 0.4)
    return vec4(self.color.rgb * bright * a, a)
}

// THE METER sits in the same frame as the readouts and the screen, on the
// same clean slate: its scale drawn in pale yellow chalk, the red zone
// rubbed in pink chalk, the needle a white chalk line and its pivot a dot of
// chalk.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(7.0)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#e8eae6)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#f2b3bd)
mod.widgets.NeedleMeter.draw_bg.color_scale = uniform(#f3e3a0)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let b = 3.0
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let face = cb_screen_face(p, px, vec3(0.110, 0.125, 0.118))
    var out = cb_window(p, lo, hi, self.border_radius, b, px, face, 2.5)
    // the red zone, rubbed in just inside the scale
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zd = max(rr + 0.5 - r, r - rr - 3.0)
        out = Finish.over(out, cb_rub(zd, p, px, self.color_zone.rgb, 0.8, zone_t))
    }
    // the scale: an arc and a tick at every division
    let arcd = abs(r - rr + cb_wob(p, 0.2, vec2(4.0, 4.0)))
    out = Finish.over(out, cb_stroke(arcd, 0.55, p, px, self.color_scale.rgb, on_scale))
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let tdir = vec2(sin(ak), 0.0 - cos(ak))
    let td = cb_seg(p, pv + tdir * (rr - len), pv + tdir * rr)
    out = Finish.over(out, cb_stroke(td, mix(0.45, 0.65, major), p + vec2(3.0, 0.0), px, self.color_scale.rgb, 1.0))
    // the needle, from under the pivot to just past the scale
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let nl = cb_seg(p, pv - nd * max(self.pivot_size - px, 0.0), pv + nd * (rr + 3.0))
    out = Finish.over(out, cb_stroke(nl, 0.7, p + vec2(9.0, 2.0), px, self.color_needle.rgb, 1.0))
    out = Finish.over(out, cb_disc(p, pv, max(self.pivot_size, 2.0), px, self.color_scale.rgb, 0.9, 0.0, 0.0, 0.0, vec2(4.0, 4.0)))
    return out * self.color.a * self.opacity
}
mod.widgets.NeedleMeter.draw_label.color = #f3e3a0

// ---------------------------------------------------------------- lamps
// The Lamp widget and the bar lamp. A round lamp's halo has its room in the
// lamp's own box (the library reserves a lens thickness either side once a
// halo is asked for), so the light is never cut at its edge and stays in
// its cell. A bar is a short light pipe: six points thick and a little over
// twice that long, set at the left of its cell three points in, its glow
// held to two and a half points round its socket -- so the whole lamp takes
// the first twenty points of its cell and leaves the rest free.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_accent = uniform(#ff9a2a)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let tb = min(t, 6.0)
    let lb = tb * 2.1
    let c = mix(self.rect_size * 0.5, vec2(3.5 + lb * 0.5, self.rect_size.y * 0.5), self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(lb * 0.5, tb * 0.5), self.bar)
    let glow = mix(max(room - 0.5, 2.0), 2.5, self.bar)
    let res = cb_led(p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, glow)
    return res * self.opacity
}

// ---------------------------------------------------------------- tree rows
// The rows of a tree are words written on the board one under another, the
// floor left calm; the chosen row is the list's soft band.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = vec2(0.0, 0.0)
    let hi = self.rect_size - vec2(10.0, 0.0)
    return cb_row_band(p, lo, hi, px, 11.0 + self.is_even * 7.0) * self.active
}
true
