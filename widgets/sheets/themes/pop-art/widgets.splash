use mod.prelude.widgets_internal.*

// Pop art. Every part is printed on a comic-book page: a flat shape in one
// primary ink with a thick black ink outline, and under it a solid black
// shadow the same shape moved down and to the right -- never blurred. Pressed,
// a part drops onto its shadow. Shading is a Ben-Day dot screen in the ink's
// own deeper tone whose dots grow toward the lower right, and a short white
// glint runs inside the upper left of each outline, as a letterer's white
// highlight stroke does. Every face is drawn in true points (one device pixel
// is `px`); shadows and focus rings that fall outside a layout box are drawn
// in a quad grown in `vertex`, and no padding is spent on them.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let pa_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space.
let pa_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let pa_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The inks: 0 cadmium yellow, 1 cyan-blue, 2 red, 3 white paper, 4 green,
// 5 purple, 6 magenta, 7 night blue, 8 warm grey, 9 the bright red black
// words read on, 10 orange.
let pa_col = fn(k: float) -> vec3 {
    if k < 0.5 { return vec3(0.992, 0.835, 0.012) }
    if k < 1.5 { return vec3(0.071, 0.549, 0.941) }
    if k < 2.5 { return vec3(0.910, 0.125, 0.165) }
    if k < 3.5 { return vec3(0.969, 0.953, 0.910) }
    if k < 4.5 { return vec3(0.071, 0.722, 0.361) }
    if k < 5.5 { return vec3(0.518, 0.208, 0.741) }
    if k < 6.5 { return vec3(0.898, 0.145, 0.561) }
    if k < 7.5 { return vec3(0.055, 0.106, 0.180) }
    if k < 8.5 { return vec3(0.660, 0.647, 0.608) }
    if k < 9.5 { return vec3(1.000, 0.333, 0.271) }
    return vec3(1.0, 0.541, 0.110)
}

// Black printing ink.
let pa_ink = fn() -> vec3 {
    return vec3(0.067, 0.067, 0.071)
}

// The deeper tone of an ink a dot screen shades it with: saturated and
// darker, as a second pass of the same ink is.
let pa_deep = fn(c: vec3) -> vec3 {
    return c * c * 0.8
}

// THE DOT SCREEN. The centre of the Ben-Day dot nearest `q` on a lattice
// `pitch` points apart, turned 45 degrees as a printer's screen is.
let pa_cell = fn(q: vec2, pitch: float) -> vec2 {
    let u = vec2(q.x + q.y, q.y - q.x) * (0.70710678 / pitch)
    let g = floor(u) + vec2(0.5, 0.5)
    return vec2(g.x - g.y, g.x + g.y) * (0.70710678 * pitch)
}

// A dot of radius `r` round `c`: its coverage at `q`. A dot smaller than a
// device pixel is drawn a pixel and a half across with its ink thinned to
// its area, so a screen fading out never sparkles.
let pa_dot = fn(q: vec2, c: vec2, r: float, px: float) -> float {
    let rr = max(r, px * 0.75)
    return clamp((rr - length(q - c)) / px + 0.5, 0.0, 1.0) * clamp(r * r / (rr * rr), 0.0, 1.0)
}

// A screen of dots `pitch` apart whose ink covers `cov` of the area round
// `q` (0..0.75; at 0.785 the dots touch). `cov` may change across a shape
// (a Ben-Day gradient); every dot is round, its size what the coverage asks.
let pa_screen = fn(q: vec2, pitch: float, cov: float, px: float) -> float {
    let c = pa_cell(q, pitch)
    let r = pitch * sqrt(clamp(cov, 0.0, 0.75) * 0.3183)
    return pa_dot(q, c, r, px) * step(0.002, cov)
}

// The size of the ink outline and of the shadow offset for a part whose
// smaller side is `sz` points, each a whole number of device pixels.
let pa_ow = fn(sz: float, px: float) -> float {
    return max(Finish.snap(clamp(0.075 * sz, 1.0, 2.5), px), px)
}
let pa_so = fn(sz: float, px: float) -> float {
    return max(Finish.snap(clamp(0.09 * sz, 1.3, 3.0), px), px)
}

// A signed distance to the triangle a, b, c.
let pa_sd_tri = fn(p: vec2, a: vec2, b: vec2, c: vec2) -> float {
    let e0 = b - a
    let e1 = c - b
    let e2 = a - c
    let v0 = p - a
    let v1 = p - b
    let v2 = p - c
    let pq0 = v0 - e0 * clamp(dot(v0, e0) / max(dot(e0, e0), 0.0001), 0.0, 1.0)
    let pq1 = v1 - e1 * clamp(dot(v1, e1) / max(dot(e1, e1), 0.0001), 0.0, 1.0)
    let pq2 = v2 - e2 * clamp(dot(v2, e2) / max(dot(e2, e2), 0.0001), 0.0, 1.0)
    let s = sign(e0.x * e2.y - e0.y * e2.x)
    let d0 = vec2(dot(pq0, pq0), s * (v0.x * e0.y - v0.y * e0.x))
    let d1 = vec2(dot(pq1, pq1), s * (v1.x * e1.y - v1.y * e1.x))
    let d2 = vec2(dot(pq2, pq2), s * (v2.x * e2.y - v2.y * e2.x))
    let dd = min(min(d0, d1), d2)
    return 0.0 - sqrt(dd.x) * sign(dd.y)
}

// Two distances joined with a fillet `k` points round, as an inker joins a
// speech bubble's tail to its body.
let pa_smin = fn(a: float, b: float, k: float) -> float {
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0)
    return mix(b, a, h) - k * h * (1.0 - h)
}

// ---------------------------------------------------------------- the print

// A printed shape laid on the page, premultiplied, from its distance field:
// `d` at the face (moved by the press already), `ds` at its shadow. The fill
// `base` shaded by a dot screen toward the lower right (`uv` the point in the
// face, 0..1 each way, `q` the point from the face's corner, for the
// screen), a black outline `ow` wide inside the edge, a white glint inside
// the outline along the upper left, and the solid black shadow. Hover lifts
// the ink toward white and thins the screen; disabled, the shape is printed
// grey and its shadow goes pale.
let pa_print = fn(d: float, ds: float, uv: vec2, q: vec2, px: float, ow: float, base: vec3, hover: float, disabled: float, shade: float) -> vec4 {
    let live = 1.0 - disabled
    let sa = Finish.cover(ds, px) * mix(1.0, 0.3, disabled)
    var res = vec4(pa_ink() * sa, sa)
    var b = mix(base, mix(base, pa_col(8.0), 0.85), disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.16 * hover * live
    let t = uv.x * 0.42 + uv.y * 0.58
    let cov = (0.03 + 0.34 * smoothstep(0.38, 1.02, t)) * (1.0 - 0.55 * hover) * shade
    var col = mix(b, pa_deep(b), pa_screen(q, 2.6, cov, px))
    // The glint: a white stroke a point wide, a point and a half inside the
    // outline, round the upper left corner and along the top, thinning out.
    let gd = abs(d + ow + 1.3) - 0.6
    let gm = (1.0 - smoothstep(0.42, 0.78, uv.x)) * (1.0 - smoothstep(0.32, 0.6, uv.y))
    let gl = Finish.cover(gd, px) * gm * (0.95 - 0.55 * Finish.lum(b)) * live
    col = mix(col, vec3(1.0, 1.0, 1.0), gl)
    let ink = mix(pa_ink(), vec3(0.30, 0.30, 0.31), disabled)
    col = mix(ink, col, Finish.cover(d + ow, px))
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A rounded box `lo`..`hi` printed with its shadow. `lift` scales the
// shadow (0 prints the shape flat on the page); pressed, the shape drops by
// the shadow's offset onto it. Focus: a cyan-blue ring standing off the
// edge.
let pa_block = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, base: vec3, hover: float, down: float, disabled: float, focus: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    let sz = min(hi.y - lo.y, hi.x - lo.x)
    let ow = pa_ow(sz, px)
    let so = pa_so(sz, px) * lift
    let dn = clamp(down, 0.0, 1.0) * live
    let off = vec2(so, so) * dn
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c + off, h, r)
    let ds = Material.sd_box(p, c + vec2(so, so), h, r) + 1000.0 * step(so, 0.001)
    let uv = clamp((p - lo - off) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    var res = pa_print(d, ds, uv, p - lo - off, px, ow, base, hover, disabled, 1.0)
    let fr = Finish.ring_out(d, 1.0, 2.6, px)
    return Finish.over(res, vec4(pa_col(1.0), 1.0) * fr * focus * live)
}

// A disc of radius `rad` round `c`, printed the same way.
let pa_disc = fn(p: vec2, c: vec2, rad: float, px: float, base: vec3, hover: float, down: float, disabled: float, focus: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    let ow = pa_ow(rad * 2.0, px)
    let so = pa_so(rad * 2.0, px) * lift
    let off = vec2(so, so) * clamp(down, 0.0, 1.0) * live
    let d = length(p - c - off) - rad
    let ds = length(p - c - vec2(so, so)) - rad + 1000.0 * step(so, 0.001)
    let uv = clamp((p - c - off) / (rad * 2.0) + vec2(0.5, 0.5), vec2(0.0, 0.0), vec2(1.0, 1.0))
    var res = pa_print(d, ds, uv, p - c - off, px, ow, base, hover, disabled, 1.0)
    let fr = Finish.ring_out(d, 1.0, 2.6, px)
    return Finish.over(res, vec4(pa_col(1.0), 1.0) * fr * focus * live)
}

// A speech bubble: a rounded box with a short tail at its lower left
// pointing down and out, joined to it with a fillet, printed with its shadow.
let pa_bubble = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, base: vec3, hover: float, down: float, disabled: float, focus: float) -> vec4 {
    let live = 1.0 - disabled
    let sz = min(hi.y - lo.y, hi.x - lo.x)
    let ow = pa_ow(sz, px)
    let so = pa_so(sz, px)
    let off = vec2(so, so) * clamp(down, 0.0, 1.0) * live
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let ta = vec2(lo.x + 7.0, hi.y - 3.0)
    let tb = vec2(lo.x + 15.0, hi.y - 3.0)
    let tc = vec2(lo.x + 4.0, hi.y + 4.5)
    let d = pa_smin(Material.sd_box(p - off, c, h, r), pa_sd_tri(p - off, ta, tb, tc), 1.5)
    let ds = pa_smin(Material.sd_box(p - vec2(so, so), c, h, r), pa_sd_tri(p - vec2(so, so), ta, tb, tc), 1.5)
    let uv = clamp((p - lo - off) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    var res = pa_print(d, ds, uv, p - lo - off, px, ow, base, hover, disabled, 0.6)
    let fr = Finish.ring_out(d, 1.0, 2.6, px)
    return Finish.over(res, vec4(pa_col(1.0), 1.0) * fr * focus * live)
}

// A ball: a printed disc lit from the upper left, its lower right shaded by
// a coarser dot screen, a white glint high on its left, with its shadow.
// `held` drops it onto the shadow.
let pa_ball = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, base: vec3, hover: float, held: float, disabled: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    let ow = max(Finish.snap(clamp(0.16 * rad, 1.0, 2.0), px), px)
    let so = max(Finish.snap(clamp(0.17 * rad, 1.0, 2.5), px), px) * lift
    let off = vec2(so, so) * clamp(held, 0.0, 1.0) * live
    let q = p - c - off
    let d = length(q) - rad
    let sa = Finish.cover(length(p - c - vec2(so, so)) - rad, px) * step(0.001, so) * mix(1.0, 0.3, disabled)
    var res = Finish.over(dst, vec4(pa_ink() * sa, sa))
    var b = mix(base, mix(base, pa_col(8.0), 0.85), disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.16 * hover * live
    // The shade: a crescent toward the lower right, screened.
    let qn = q / max(rad, 0.5)
    let sh = smoothstep(-0.1, 0.9, dot(qn, vec2(0.55, 0.83)) + 0.25 * length(qn))
    let cov = 0.05 + 0.5 * sh * sh
    var col = mix(b, pa_deep(b), pa_screen(q, max(2.0, rad * 0.32), cov, px))
    // The glint: a small white oval up on the left.
    let gq = (qn - vec2(-0.36, -0.40))
    let gr = vec2(gq.x * 0.8 + gq.y * 0.6, gq.y * 0.8 - gq.x * 0.6) / vec2(0.26, 0.15)
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.cover((length(gr) - 1.0) * rad * 0.15, px) * (0.95 - 0.4 * Finish.lum(b)) * live)
    col = mix(mix(pa_ink(), vec3(0.3, 0.3, 0.31), disabled), col, Finish.cover(d + ow, px))
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A lightning bolt standing on `c`, `rad` its half height: two triangles of
// yellow ink, outlined, with their shadow. `held` drops it.
let pa_bolt_d = fn(q: vec2, rad: float) -> float {
    let s = rad
    let u = pa_sd_tri(q, vec2(-0.02, -1.0) * s, vec2(0.66, -1.0) * s, vec2(-0.44, 0.20) * s)
    let l = pa_sd_tri(q, vec2(-0.34, -0.12) * s, vec2(0.52, -0.12) * s, vec2(-0.30, 1.06) * s)
    return min(u, l)
}
let pa_bolt = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, base: vec3, hover: float, held: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let ow = max(Finish.snap(1.2, px), px)
    let so = max(Finish.snap(1.6, px), px)
    let off = vec2(so, so) * clamp(held, 0.0, 1.0) * live
    let d = pa_bolt_d(p - c - off, rad)
    let ds = pa_bolt_d(p - c - vec2(so, so), rad)
    let uv = clamp((p - c - off) / (rad * 2.0) + vec2(0.5, 0.5), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let res = pa_print(d, ds, uv, p - c - off, px, ow, base, hover, disabled, 0.7)
    return Finish.over(dst, res)
}

// A chunky track: a pill outlined in ink on its own short shadow, `fill`
// over the box `flo`..`fhi` with a white highlight stroke along its upper
// edge (its left edge when the track stands, `vert` 1), night blue
// elsewhere.
let pa_track_box = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, flo: vec2, fhi: vec2, px: float, fill: vec3, disabled: float, vert: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(h.x, h.y)
    let ow = max(Finish.snap(1.3, px), px)
    let so = max(Finish.snap(1.3, px), px)
    let d = Material.sd_box(p, c, h, r)
    let sa = Finish.cover(Material.sd_box(p, c + vec2(so, so), h, r), px) * mix(1.0, 0.3, disabled)
    var res = Finish.over(dst, vec4(pa_ink() * sa, sa))
    let fc = mix(fill, mix(fill, pa_col(8.0), 0.85), disabled)
    let rest = mix(pa_col(7.0), vec3(0.42, 0.42, 0.43), disabled)
    let inf = step(flo.x, p.x) * step(p.x, fhi.x) * step(flo.y, p.y) * step(p.y, fhi.y)
    var col = mix(rest, fc, inf)
    let across = mix(p.y - lo.y, p.x - lo.x, vert)
    let wide = mix(hi.y - lo.y, hi.x - lo.x, vert)
    let hl = Finish.cover(abs(across - (ow + 0.9)) - 0.45, px) * inf
    col = mix(col, vec3(1.0, 1.0, 1.0), hl * 0.75 * (1.0 - disabled))
    col = mix(col, pa_deep(fc), pa_screen(p - lo, 2.2, 0.22 * smoothstep(0.45, 1.0, across / max(wide, 1.0)), px) * inf)
    col = mix(pa_ink(), col, Finish.cover(d + ow, px))
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}
let pa_track = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, f0: float, f1: float, px: float, fill: vec3, disabled: float) -> vec4 {
    return pa_track_box(dst, p, lo, hi, vec2(f0, lo.y - 1.0), vec2(f1, hi.y + 1.0), px, fill, disabled, 0.0)
}

// The focus ring of a shape at distance `d`: a cyan-blue line standing a
// point off its edge.
let pa_focus = fn(dst: vec4, d: float, px: float, focus: float) -> vec4 {
    return Finish.over(dst, vec4(pa_col(1.0), 1.0) * Finish.ring_out(d, 1.0, 2.6, px) * focus)
}

// The three-quarter arc a waiting button turns in place of its label.
let pa_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(0.067, 0.067, 0.071, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is a block of flat ink with a black outline on its solid
// shadow: the plain button yellow, the primary and the flat one blue, the
// secondary and the danger red, the small one blue, the large one yellow,
// the icon key yellow; the outline button is white paper. Under the hand
// the ink lifts toward white; pressed, the block drops onto its shadow and
// its legend drops with it.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlat.min_height = 24.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonSecondary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonTertiary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonOutline.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonSm.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 1.0 bottom: 1.0}
mod.widgets.ButtonLg.padding = mod.turtle.Inset{left: 15.0 right: 15.0 top: 2.0 bottom: 2.0}
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(2.5)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(1.5)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The ink of a button `kind`: 0 flat (blue), 1 plain (yellow), 2 primary
// (blue), 3 secondary (red), 4 tertiary (yellow), 5 danger (red), 8 icon
// (yellow), 9 small (blue).
let pa_key_col = fn(kind: float) -> vec3 {
    if kind < 0.5 { return pa_col(1.0) }
    if kind < 1.5 { return pa_col(0.0) }
    if kind < 2.5 { return pa_col(1.0) }
    if kind < 3.5 { return pa_col(2.0) }
    if kind < 4.5 { return pa_col(0.0) }
    if kind < 5.5 { return pa_col(2.0) }
    if kind < 8.5 { return pa_col(0.0) }
    return pa_col(1.0)
}

// The block and its states, shared by every button template; 6 is the
// outline button (white paper, its outline dashed when asked) and 7 the
// flatter button, printed only under the hand.
let pa_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 8.0
    let px = pa_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(pa_snap(0.0, o.x, px), pa_snap(0.0, o.y, px))
    let hi = vec2(pa_snap(size.x, o.x, px), pa_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let r = clamp(0.22 * hh, 3.0, 6.5)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 6.5 && kind < 7.5 {
        if hover + down + focus > 0.001 {
            res = pa_block(p, lo, hi, r, px, pa_col(3.0), hover, down, disabled, focus, 0.6) * clamp(max(max(hover, down), focus), 0.0, 1.0)
        }
    } else {
        if kind > 5.5 && kind < 6.5 {
            res = pa_block(p, lo, hi, r, px, pa_col(3.0), hover, down, disabled, focus, 1.0)
            if dash > 0.0 {
                // A dashed outline: the paper shows through the gaps.
                let so = pa_so(min(hh, hi.x - lo.x), px)
                let off = vec2(so, so) * clamp(down, 0.0, 1.0) * (1.0 - disabled)
                let c = (lo + hi) * 0.5
                let d = Material.sd_box(p, c + off, (hi - lo) * 0.5, r)
                let ow = pa_ow(min(hh, hi.x - lo.x), px)
                let gap = step(0.5, fract((p.x + p.y) / (dash * 2.0)))
                let band = Finish.cover(d, px) * (1.0 - Finish.cover(d + ow, px))
                res = Finish.over(res, vec4(pa_col(3.0), 1.0) * band * gap)
            }
        } else {
            res = pa_block(p, lo, hi, r, px, pa_key_col(kind), hover, down, disabled, focus, 1.0)
        }
    }
    if loading > 0.001 {
        let rad = max(min(hi.x - lo.x, hh) * 0.5 - 6.0, 2.0)
        res = pa_spinner(res, p, (lo + hi) * 0.5, rad, anim, loading, 1.6)
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(pa_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0), 8.0)
