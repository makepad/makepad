mod.theme.color_bevel_inset_2_disabled = #3c4553
mod.theme.color_bevel_outset_1_disabled = #3c4553
mod.theme.color_bevel_outset_2_disabled = #3c4553

// Ink: a cream yarn, about 8:1 on the denim.
mod.theme.color_text = #f1e9d6
mod.theme.color_text_hover = #f1e9d6
mod.theme.color_text_focus = #f1e9d6
mod.theme.color_text_active = #f1e9d6
mod.theme.color_text_down = #f1e9d6
mod.theme.color_text_val = #f1e9d6
mod.theme.color_text_hl = #f1e9d6
mod.theme.color_text_disabled = #6d7f96
mod.theme.color_text_placeholder = #a8b4c4
mod.theme.color_text_placeholder_hover = #a8b4c4
mod.theme.color_text_meta = #c9cfd8
mod.theme.color_text_cursor = #f1e9d6
mod.theme.color_cursor = #f1e9d6
mod.theme.color_cursor_focus = #f1e9d6
mod.theme.color_label = #f1e9d6
mod.theme.color_label_hover = #f1e9d6
mod.theme.color_label_focus = #f1e9d6
mod.theme.color_label_active = #f1e9d6
mod.theme.color_label_down = #f1e9d6
mod.theme.color_label_disabled = #6d7f96
mod.theme.color_label_inner = #f1e9d6
mod.theme.color_label_inner_hover = #f1e9d6
mod.theme.color_label_inner_focus = #f1e9d6
mod.theme.color_label_inner_active = #2a2010
mod.theme.color_label_inner_down = #f1e9d6
mod.theme.color_label_inner_drag = #f1e9d6
mod.theme.color_label_inner_inactive = #f1e9d6
