mod.theme = mod.themes.dark

// Knitted. A deep denim-blue stockinette ground with every
// control a padded patch of knit sewn on it in a bright yarn -- cream,
// yellow, teal, purple, red -- and cream lettering; yellow marks what
// is chosen and set.
// The faces are drawn in widgets.splash; this file holds the tokens every
// face and every stock widget reads.
mod.theme.color_bg_app = #255a87
mod.theme.color_fg_app = #265886
mod.theme.color_bg_container = #255a87
mod.theme.color_surface_container = #2f5c3e
mod.theme.color_surface_container_lowest = #132f4f
mod.theme.color_surface_container_highest = #1f4b75
mod.theme.color_surface_bright = #204e7a
mod.theme.color_bg_even = #00000000
mod.theme.color_bg_odd = #ffffff08
mod.theme.color_highlight = #e9b23a
mod.theme.color_bg_highlight = #2f5c3e
mod.theme.color_bg_highlight_inline = #e9b23a50

// Raised faces the sheet does not redraw: a patch of the plain yarn.
mod.theme.color_outset = #80838d
mod.theme.color_outset_1 = #80838d
mod.theme.color_outset_2 = #80838d
mod.theme.color_outset_hover = #80838d
mod.theme.color_outset_1_hover = #80838d
mod.theme.color_outset_2_hover = #80838d
mod.theme.color_outset_focus = #80838d
mod.theme.color_outset_1_focus = #80838d
mod.theme.color_outset_2_focus = #80838d
mod.theme.color_outset_active = #e9b23a
mod.theme.color_outset_1_active = #e9b23a
mod.theme.color_outset_2_active = #e9b23a
mod.theme.color_outset_down = #80838d
mod.theme.color_outset_1_down = #80838d
mod.theme.color_outset_2_down = #80838d
mod.theme.color_outset_drag = #80838d
mod.theme.color_outset_1_drag = #80838d
mod.theme.color_outset_2_drag = #80838d
mod.theme.color_outset_disabled = #3c4553
mod.theme.color_outset_1_disabled = #3c4553
mod.theme.color_outset_2_disabled = #3c4553

// Wells: the field yarn, opaque in every state.
mod.theme.color_inset = #e3d7bd
mod.theme.color_inset_1 = #e3d7bd
mod.theme.color_inset_2 = #e3d7bd
mod.theme.color_inset_hover = #e3d7bd
mod.theme.color_inset_1_hover = #e3d7bd
mod.theme.color_inset_2_hover = #e3d7bd
mod.theme.color_inset_focus = #e3d7bd
mod.theme.color_inset_1_focus = #e3d7bd
mod.theme.color_inset_2_focus = #e3d7bd
mod.theme.color_inset_active = #e3d7bd
mod.theme.color_inset_1_active = #e3d7bd
mod.theme.color_inset_2_active = #e3d7bd
mod.theme.color_inset_down = #e3d7bd
mod.theme.color_inset_1_down = #e3d7bd
mod.theme.color_inset_2_down = #e3d7bd
mod.theme.color_inset_drag = #e3d7bd
mod.theme.color_inset_1_drag = #e3d7bd
mod.theme.color_inset_2_drag = #e3d7bd
mod.theme.color_inset_empty = #e3d7bd
mod.theme.color_inset_1_empty = #e3d7bd
mod.theme.color_inset_2_empty = #e3d7bd
mod.theme.color_inset_disabled = #3c4553
mod.theme.color_inset_1_disabled = #3c4553
mod.theme.color_inset_2_disabled = #3c4553

// The edges of a stock face: the seam's yarn.
mod.theme.beveling = 0.5
mod.theme.color_bevel = #132f50
mod.theme.color_bevel_hover = #132f50
mod.theme.color_bevel_focus = #ffd25a
mod.theme.color_bevel_active = #132f50
mod.theme.color_bevel_empty = #132f50
mod.theme.color_bevel_down = #132f50
mod.theme.color_bevel_drag = #132f50
mod.theme.color_bevel_disabled = #3c4553
mod.theme.color_bevel_inset_1 = #132f50
mod.theme.color_bevel_inset_2 = #132f50
mod.theme.color_bevel_outset_1 = #132f50
mod.theme.color_bevel_outset_2 = #132f50
