mod.theme.color_label_outer = #f1e9d6
mod.theme.color_label_outer_off = #f1e9d6
mod.theme.color_label_outer_hover = #f1e9d6
mod.theme.color_label_outer_focus = #f1e9d6
mod.theme.color_label_outer_active = #f1e9d6
mod.theme.color_label_outer_active_focus = #f1e9d6
mod.theme.color_label_outer_down = #f1e9d6
mod.theme.color_label_outer_drag = #f1e9d6
mod.theme.color_label_outer_disabled = #6d7f96
mod.theme.color_icon = #f1e9d6
mod.theme.color_icon_hover = #f1e9d6
mod.theme.color_icon_focus = #f1e9d6
mod.theme.color_icon_active = #2a2010
mod.theme.color_icon_down = #f1e9d6
mod.theme.color_icon_disabled = #6d7f96
mod.theme.color_on_surface = #f1e9d6
mod.theme.color_on_surface_variant = #f1e9d6

// The accent yarn fills a value, sets a mark and draws focus.
mod.theme.color_focus = #ffd25a
mod.theme.color_ctrl_active = #e9b23a
mod.theme.color_val = #46bce6
mod.theme.color_val_hover = #46bce6
mod.theme.color_val_focus = #46bce6
mod.theme.color_val_drag = #46bce6
mod.theme.color_val_disabled = #3c4553
mod.theme.color_mark = #f1e9d6
mod.theme.color_mark_active = #e9b23a
mod.theme.color_mark_active_hover = #e9b23a
mod.theme.color_mark_focus = #e9b23a
mod.theme.color_mark_disabled = #3c4553
// The accent seed: the primary, secondary and tertiary families are grown
// from its hue.
mod.theme.color_ctrl_selected = #e9b23a
mod.theme.color_text_on_accent = #2a2010
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #e9b23a38
mod.theme.color_selection_down = #e9b23a66
mod.theme.color_selection_focus = #e9b23a66
mod.theme.color_handle = #e9ddc5
mod.theme.color_handle_hover = #e9ddc5
mod.theme.color_handle_1 = #e9ddc5
mod.theme.color_handle_2 = #e9ddc5

// Screens: dark knit with lit figures.
mod.theme.color_screen = #121b28
mod.theme.color_screen_ink = #5fe0c8
mod.theme.screen_ghost = 0.08
mod.theme.color_lamp_plain = #f4f1ea
mod.theme.color_lamp_off = #2a2a2e
mod.theme.color_terminal_bg = #121b28
mod.theme.color_terminal_text = #5fe0c8


// SPACING. Rows of 26 points, gaps of 8 between controls, panels padded
// 12. The base froze what it derived from the factor, so every rung this
// sheet depends on is stated again.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 28.0
mod.theme.tab_flat_height = 26.0
mod.theme.data_item_height = 22.0
// Stock shaders draw a corner twice the number written: 4 is the 8 point
// corner of a patch, 4.5 the 9 point corner of a panel.
mod.theme.corner_radius = 4.0
mod.theme.container_corner_radius = 4.5
mod.theme.textselection_corner_radius = 1.0
mod.theme.radius_s = 3.0
mod.theme.radius_m = 4.0
mod.theme.radius_l = 8.0

// TYPE. Fredoka, the round face whose letters look sewn on with a thick
// yarn: regular for working text, medium on the patches, semibold for the
// captions. Labels at 8.5 points, so the cap height is about a third of the
// 26 point row.
mod.theme.font_size_p = 8.5
mod.theme.font_size_base = 8.5
mod.theme.type_title_l_size = 12.0
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_s_size = 9.5
mod.theme.type_body_l_size = 9.0
mod.theme.type_body_m_size = 8.5
mod.theme.type_body_s_size = 8.0
mod.theme.type_label_l_size = 8.5
mod.theme.type_label_m_size = 8.0
mod.theme.type_label_s_size = 7.5
mod.theme.font_size_4 = 10.5
use mod.res.*
use mod.text.*
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Fredoka-Variable.ttf") weight: 460.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_label = mod.theme.font_label{font_size: 8.5 font_family: mod.theme.font_label.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Fredoka-Variable.ttf") weight: 590.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_bold = mod.theme.font_bold{font_size: 9.5 font_family: mod.theme.font_bold.font_family{ibm_plex_semibold := FontMember{res: crate_resource("self:resources/Fredoka-Variable.ttf") weight: 620.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.5 line_spacing: 1.2}
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 8.0 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 8.0 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}

// No surface material: every face that matters is drawn by the sheet.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #e9b23a
true
