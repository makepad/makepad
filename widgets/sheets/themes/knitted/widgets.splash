// An icon takes its patch's ink, whatever ink its caller gave it: a glyph
// of the wrong ink is lost on the yarn. The icon on its own patch is the
// star of the favourites, in its own yarn.
mod.widgets.Button.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    return vec4(vec3(0.949, 0.722, 0.188) * base.a, base.a) * self.opacity
}
mod.widgets.ButtonIcon.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    return vec4(vec3(0.949, 0.722, 0.188) * base.a, base.a) * self.opacity
}
// The labels are set in the round face's medium weight.
mod.widgets.ButtonFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.Button.draw_text.text_style = mod.theme.font_label{}
