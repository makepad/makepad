use mod.prelude.widgets_internal.*

// Knitted: a widget kit knitted in denim-blue wool.
// The window is a piece of stockinette: rows of V stitches, each V two plump
// legs of yarn slanting in to meet at its foot, every stitch a little
// different, a haze of loose fibre in the gaps; a ribbed cuff runs round
// the window's edge and a cord seam parts it from the fabric. Every control
// is a padded patch of finer knit sewn onto it: a bound-off rim of chain
// loops round its edge, the patch bulging a little in the middle and laying
// a soft shadow on the fabric under it. Values run in a twisted cord of
// coloured yarn in a dark cord track, thumbs and switch knobs are knitted
// balls, knobs a knitted dome in a ring of chunky loops, screens dark knit
// in a couched rope. The two sheets of the family share these faces line
// for line; only the palette differs. Every face is drawn in true points
// (one device pixel is `px`), and every shadow and halo is drawn OUTSIDE
// the layout box: the quad is grown in `vertex`, and no padding is spent
// on relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let mk_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let mk_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let mk_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A hash that does not line up: the library's hash nearly repeats every 97
// cells, so each cell is first sent to a far cell picked by its own hash.
let mk_hash = fn(i: vec2) -> float {
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j)
}
// Value noise on that hash, one unit per cell.
let mk_noise = fn(q: vec2) -> float {
    let i = floor(q)
    let f = q - i
    let u = f * f * (vec2(3.0, 3.0) - f * 2.0)
    let a = mk_hash(i)
    let b = mk_hash(i + vec2(1.0, 0.0))
    let c = mk_hash(i + vec2(0.0, 1.0))
    let d = mk_hash(i + vec2(1.0, 1.0))
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}
// Two slow clouds over each other, -0.5..0.5: the dye lot and the hand of
// the knitter, so no two stretches of fabric read alike.
let mk_cloud = fn(q: vec2) -> float {
    return (mk_noise(q / 83.0) - 0.5) * 0.6 + (mk_noise(q / 23.0 + vec2(7.7, 3.1)) - 0.5) * 0.4
}

// How much of the light from the upper left a face turned `n` takes:
// +1 facing it, -1 turned away.
let mk_lit = fn(n: vec2) -> float {
    return dot(n, vec2(-0.55, -0.835))
}

// The way the edge of a rounded box faces at `p` (the box `c`, half size
// `h`, corners `r`): the side whose edge is nearest, or the corner's own
// direction round a corner.
let mk_box_n = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let v = p - c
    let s = vec2(step(0.0, v.x) * 2.0 - 1.0, step(0.0, v.y) * 2.0 - 1.0)
    let rr = min(r, min(h.x, h.y))
    let q = abs(v) - (h - vec2(rr, rr))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = normalize(q) * s
    }
    return n
}

// How far round the edge of a rounded box `p` lies, in points, clockwise
// from the left end of its top side: the side whose edge is nearest, or the
// angle round a corner. A rim of loops counted on it runs on without a seam.
let mk_perim = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let v = p - c
    let rr = min(r, min(h.x, h.y))
    let hx = h.x - rr
    let hy = h.y - rr
    let q = abs(v) - vec2(hx, hy)
    let arc = rr * 1.5707963
    let th = atan2(max(q.y, 0.0), max(q.x, 0.0))
    var s = 0.0
    if q.x > q.y {
        if v.x > 0.0 {
            s = 2.0 * hx + arc + (v.y + hy)
        } else {
            s = 4.0 * hx + 3.0 * arc + 2.0 * hy + (hy - v.y)
        }
    } else {
        if v.y < 0.0 {
            s = v.x + hx
        } else {
            s = 2.0 * hx + 2.0 * arc + 2.0 * hy + (hx - v.x)
        }
    }
    if q.x > 0.0 && q.y > 0.0 {
        if v.x > 0.0 && v.y < 0.0 {
            s = 2.0 * hx + (1.5707963 - th) * rr
        }
        if v.x > 0.0 && v.y > 0.0 {
            s = 2.0 * hx + arc + 2.0 * hy + th * rr
        }
        if v.x < 0.0 && v.y > 0.0 {
            s = 4.0 * hx + 2.0 * arc + 2.0 * hy + (1.5707963 - th) * rr
        }
        if v.x < 0.0 && v.y < 0.0 {
            s = 4.0 * hx + 3.0 * arc + 4.0 * hy + th * rr
        }
    }
    return s
}
// The whole way round that box.
let mk_perim_len = fn(h: vec2, r: float) -> float {
    let rr = min(r, min(h.x, h.y))
    return 4.0 * (h.x - rr) + 4.0 * (h.y - rr) + 2.0 * PI * rr
}

// The three-quarter arc a waiting button turns in place of its label.
let mk_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- yarn

// ONE LEG OF A STITCH: a plump loop of yarn lying along a..b, a teardrop
// `r` thick, round at `a` and drawn to a point at `b`. Handed back: .x its
// height (1 on its spine, 0 at its edge), .y the light it takes from above
// and a little in front, with the twist of its plies in it, .z how far `p`
// lies outside it (points, negative inside).
let mk_leg = fn(p: vec2, a: vec2, b: vec2, r: float, ply: float) -> vec3 {
    let ba = b - a
    let ll = max(dot(ba, ba), 0.0001)
    let t = clamp(dot(p - a, ba) / ll, 0.0, 1.0)
    let ax = ba / sqrt(ll)
    let off = p - a - ba * t
    let rr = r * (0.86 + 0.55 * t - 0.92 * t * t)
    let d = length(off)
    let u = clamp(d / max(rr, 0.01), 0.0, 1.0)
    let h = sqrt(max(1.0 - u * u, 0.0))
    let n2 = off / max(d, 0.0001) * u
    let s = dot(p - a, ax)
    let side = off.x * ax.y - off.y * ax.x
    let tw = sin((s - side * 1.3) * 6.2831853 / max(ply, 0.4))
    let lit = n2.x * (0.0 - 0.35) + n2.y * (0.0 - 0.55) + h * 0.68 + tw * 0.04 * h
    return vec3(h, lit, d - rr)
}

// ONE STITCH of stockinette, the one in column `col` and row `row`, at `p`
// measured from the middle of the top of its cell: a V of two leaf-shaped
// legs slanting in from the top corners of the cell to meet at its foot,
// which lies just past the cell's foot, over the top of the V under it (a
// row is six tenths of a stitch's width tall, so the V is short and wide).
// Each stitch is nudged by its own hash -- its foot to one side, its legs
// fatter or thinner, its yarn a shade lighter or darker -- and each row
// pulled a little tighter or looser than the next. Handed back: .x the
// height of whichever leg stands higher at `p`, .y its light, .z the shade
// of the stitch's yarn (round 1), .w how far `p` lies outside both legs.
let mk_stitch = fn(p0: vec2, col: float, row: float, sw: float) -> vec4 {
    let p = p0 - vec2((Finish.hash(vec2(row, 9.1)) - 0.5) * 0.07 * sw, 0.0)
    let h1 = mk_hash(vec2(col, row))
    let h2 = fract(h1 * 7.13 + 0.31)
    let h3 = fract(h1 * 13.71 + 0.57)
    let foot = vec2((h1 - 0.5) * 0.11 * sw, sw * (0.60 + (h2 - 0.5) * 0.07))
    let spread = sw * (0.33 + (h3 - 0.5) * 0.04)
    let r = sw * (0.205 + (h2 - 0.5) * 0.03)
    let top = sw * ((h1 - 0.5) * 0.05)
    let ply = sw * 0.30
    let a = mk_leg(p, vec2(0.0 - spread, top), foot - vec2(sw * 0.05, 0.0), r, ply)
    let b = mk_leg(p, vec2(spread, top + (h3 - 0.5) * 0.05 * sw), foot + vec2(sw * 0.05, 0.0), r, ply)
    let shade = 1.0 + (fract(h1 * 29.3 + 0.13) - 0.5) * 0.12 + (Finish.hash(vec2(row, 4.4)) - 0.5) * 0.07
    // Where the two legs meet down the middle of the V they part in a
    // crease.
    let crease = (1.0 - smoothstep(0.0, 0.45, abs(a.x - b.x))) * smoothstep(0.0, 0.2, min(a.x, b.x))
    let sc = shade * (1.0 - 0.38 * crease)
    var res = vec4(a.x, a.y, sc, min(a.z, b.z))
    if b.x > a.x {
        res = vec4(b.x, b.y, sc * 0.97, min(a.z, b.z))
    }
    return res
}

// THE STOCKINETTE at `q0` (points), stitches `sw` wide and `sh` tall, its
// columns wavering by up to `warp` points so no column is a ruled line.
// A point is reached by the legs of its own stitch and by those of the
// stitch over it (near the top of its cell) or under it (near its foot).
// The upper V lies over the top of the one under it and lays a shade on
// it along its edge, so every row reads as a row of chevrons. Handed back:
// .x the height of the yarn (0 in the gaps), .y the light it takes, .z the
// shade of its yarn (round 1, the cast shade in it), .w unused.
let mk_knit = fn(q0: vec2, sw: float, sh: float, warp: float) -> vec4 {
    let wx = Finish.noise(q0 / (sh * 8.0)) - 0.5
    let wy = sin(q0.x * 0.071 + q0.y * 0.013 + sin(q0.y * 0.043) * 2.0) * 0.25
    let q = q0 + vec2(wx, wy) * warp
    let col = floor(q.x / sw)
    let row = floor(q.y / sh)
    let lx = q.x - (col + 0.5) * sw
    let ly = q.y - row * sh
    let nb = step(sh * 0.5, ly) * 2.0 - 1.0
    let cur = mk_stitch(vec2(lx, ly), col, row, sw)
    let nbr = mk_stitch(vec2(lx, ly - nb * sh), col, row + nb, sw)
    // Above the middle of the cell the neighbour is the stitch over this
    // one; below it, the stitch under.
    let up = step(0.0, nb)
    let upper = mix(nbr, cur, up)
    let lower = mix(cur, nbr, up)
    let cast = 1.0 - 0.42 * exp(0.0 - max(upper.w, 0.0) / (0.09 * sw))
    var res = vec4(lower.x, lower.y, lower.z * cast, 0.0)
    let over = smoothstep(0.0, 0.28, upper.x)
    res = mix(res, vec4(upper.x, upper.y, upper.z, 0.0), over)
    return res
}

// The colour of yarn `col` at a point of fabric `k` (mk_knit's result):
// each leg lit by the way it faces, its plies a little lighter and darker,
// falling into the shade of `gap` toward its edge; in the gaps loose fibre
// catching a little light; over all a fibre's grain at the device pixel.
let mk_yarn = fn(col: vec3, gap: vec3, k: vec4, q: vec2, px: float, fuzz: float) -> vec3 {
    let h = k.x
    let y = col * k.z * (0.78 + 0.32 * clamp(k.y, -0.4, 1.0))
    let cell = floor(q / px)
    let hair = Finish.hash(cell + vec2(0.7, 3.9))
    let g = mix(gap, col * 0.85, fuzz * hair * hair * 0.55)
    var c = mix(g, y, smoothstep(0.0, 0.42, h))
    c = c * (1.0 + (Finish.hash(cell * 1.37 + vec2(3.3, 1.7)) - 0.5) * 0.07)
    return max(c, vec3(0.0, 0.0, 0.0))
}

// The same yarn knitted on a patch that carries words: its stitches kept
// softer the paler the yarn, so dark words on it stay clear of the knit.
let mk_soft = fn(col: vec3, y: vec3) -> vec3 {
    let amt = mix(1.0, 0.400, smoothstep(0.15, 0.55, Finish.lum(col)))
    return mix(col * 0.95, y, amt)
}

// A TWISTED CORD of two plies, at `s` along it and `a` across it (-1 at
// the side toward the light, 1 at the other), its plies `period` apart
// and slanting across it. .x its height, .y the light it takes.
let mk_ply = fn(s: float, a: float, period: float) -> vec2 {
    let f = fract((s + a * period * 0.6) / max(period, 0.3))
    let g = (f - 0.5) * 2.0
    let across = sqrt(max(1.0 - a * a, 0.0))
    let bump = sqrt(max(1.0 - g * g, 0.0))
    let h = across * (0.45 + 0.55 * bump)
    let lit = clamp((0.0 - a) * 0.75 - g * 0.35 * across + 0.15, -1.0, 1.0)
    return vec2(h, lit)
}

// A RUNNING STITCH along a line: coverage of dashes `len` long, `gap`
// apart, at `s` along and `t` across (points), `w` thick, their ends
// round. .x coverage, .y the light along the dash's top.
let mk_running = fn(s: float, t: float, len: float, gap: float, w: float, px: float) -> vec2 {
    let pitch = len + gap
    let f = s - pitch * floor(s / pitch) - len * 0.5 - gap * 0.5
    let dx = max(abs(f) - len * 0.5 + w * 0.5, 0.0)
    let d = length(vec2(dx, t)) - w * 0.5
    let cov = Finish.cover(d, px)
    let lit = clamp(0.0 - t / max(w * 0.5, 0.2), -1.0, 1.0)
    return vec2(cov, lit)
}

// ---------------------------------------------------------------- the fabric

// K1 P1 RIBBING at `q` with its ribs running along `along` (1 down the
// window, 0 across it): a column of narrow knit V's, then a sunk column of
// purl bumps, by turns. Handed back as mk_knit's result.
let mk_rib = fn(q0: vec2, sw: float, sh: float, along: float) -> vec4 {
    let q = mix(q0.yx, q0, along)
    var k = mk_knit(q, sw, sh, 0.4)
    let colf = q.x / sw
    let purl = step(0.5, fract(colf * 0.5))
    // A purl column: a bead of yarn lying across each row, sunk.
    let ly = q.y - sh * floor(q.y / sh) - sh * 0.5
    let lx = (fract(colf) - 0.5) * sw
    let pb = mk_leg(vec2(lx, ly), vec2(0.0 - sw * 0.32, 0.0), vec2(sw * 0.32, 0.0), sh * 0.40, sw * 0.3)
    let pk = vec4(pb.x * 0.8, pb.y * 0.7, 0.86, 0.0)
    k = mix(k, pk, purl)
    // The knit columns stand proud of the purl ones: shade at their sides.
    let sd = abs(fract(colf) - 0.5) * 2.0
    k = vec4(k.x, k.y - 0.35 * smoothstep(0.55, 1.0, sd) * (1.0 - purl), k.z * mix(1.0, 0.92, purl), k.w)
    return k
}

// THE WINDOW'S GROUND at a window point `w` (points) in a window `size`
// points large. Stockinette in the sheet's yarn, its stitches 9.5 points
// wide and six tenths of that tall, lighter and darker in two slow clouds; a ribbed cuff along
// the top, where the window's caption stands, a narrower one down the sides
// and along the foot, each sewn to the fabric with a cord seam.
let mk_ground = fn(w: vec2, px: float, size: vec2) -> vec3 {
    let W = size.x
    let H = size.y
    let tb = min(32.0, H * 0.1)
    let sb = min(7.0, W * 0.02)
    // The fabric.
    let k = mk_knit(w, 9.500, 9.500 * 0.6, 2.0)
    var col = mk_yarn(vec3(0.145, 0.353, 0.529), vec3(0.039, 0.145, 0.251), k, w, px, 0.700)
    col = mix(vec3(0.145, 0.353, 0.529) * 0.93, col, 1.000)
    col = col * (1.0 + mk_cloud(w) * 0.070)
    // The cuffs: how far in from the window's edge, and which way the ribs
    // run there (down the window along the top and the foot).
    let din = min(min(w.x, W - w.x), H - w.y)
    let in_top = step(w.y, tb)
    let in_side = step(din, sb) * (1.0 - in_top)
    let along = clamp(in_top + step(H - sb, w.y), 0.0, 1.0)
    let rk = mk_rib(w, 4.2, 2.6, along)
    let rc = mk_yarn(vec3(0.106, 0.267, 0.439), vec3(0.039, 0.145, 0.251) * 0.8, rk, w, px, 0.700)
    let cuff = clamp(in_top + in_side, 0.0, 1.0)
    col = mix(col, rc, cuff)
    // The seams: a cord where each cuff is sewn to the fabric, its shadow
    // lying a little way onto the fabric under it.
    let dt = w.y - tb
    let dsd = sb - din
    var st = dt
    var sa = w.x
    if in_top < 0.5 && abs(dsd) < abs(dt) {
        st = dsd
        sa = w.y + w.x
    }
    let ds = abs(st)
    let cord_w = 1.6
    let ac = clamp(st / cord_w, -1.0, 1.0)
    let pl = mk_ply(sa, ac, 2.6)
    let on_cord = 1.0 - smoothstep(cord_w - px, cord_w + px * 0.5, ds)
    let cc = vec3(0.075, 0.184, 0.314) * (0.55 + 0.55 * pl.x) * (0.85 + 0.35 * pl.y)
    col = mix(col, col * 0.80, (1.0 - smoothstep(0.0, 3.0, ds - cord_w)) * (1.0 - cuff) * 0.6)
    col = mix(col, cc, on_cord * smoothstep(0.05, 0.4, pl.x))
    return col
}

// ---------------------------------------------------------------- the patch

// A KNITTED PATCH sewn onto the fabric: a box `lo`..`hi` with corners `rad`,
// knitted in `col`. Out to in: what it throws on the fabric (`lift` 1 a soft
// shadow falling a little down, 0 only a contact line); a faint haze of
// loose fibre past its edge, which is not a ruled line but frays a little
// along its length; the bound-off rim, a band of chain loops in `rimc`
// slanting round the edge, round across like a cord, parted from the body
// by a dark line; the body, stockinette finer than the ground's, padded so
// it bulges -- lit along the upper edge, falling into shade toward the foot
// and the sides. Hovered the yarn lightens; held the patch is pressed flat
// into the fabric: its shadow goes, its bulge turns over and it darkens.
// Focused, a running stitch of the accent yarn goes round it just outside.
// `seed` sets where the knit starts, so patches of other sizes read apart.
// Premultiplied.
let mk_patch = fn(p: vec2, lo: vec2, hi: vec2, rad: float, px: float, col: vec3, rimc: vec3, hover: float, down: float, focus: float, lift: float, seed: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(rad, min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let up = 1.0 - down
    let hh = hi.y - lo.y
    // What it throws: a dense shade right under its foot and a soft one
    // carrying on down; to the sides both stay inside half an 8 point gap.
    let s = min(hh, 26.0)
    let d1 = Finish.drop(p, c, h - vec2(0.03 * s, 0.0), r, vec2(0.0, 0.07 * s), 0.06 * s)
    let d2 = Finish.drop(p, c, h - vec2(0.10 * s, 0.02 * s), r, vec2(0.0, 0.16 * s), 0.12 * s)
    let drop = (1.0 - (1.0 - 0.70 * d1) * (1.0 - 0.55 * d2)) * lift * up * 0.550
    let contact = Finish.drop(p, c, h, r, vec2(0.0, px), px * 0.8) * 0.5
    let sha = 1.0 - (1.0 - drop) * (1.0 - contact)
    var res = vec4(vec3(0.008, 0.039, 0.078) * sha, sha)
    // Round the edge.
    let n = mk_box_n(p, c, h, r)
    let s_ed = mk_perim(p, c, h, r)
    let fray = (Finish.noise(vec2(s_ed / 0.9, seed * 7.0)) - 0.5) * 0.55 + (Finish.hash(floor(p / px) + vec2(seed, 1.0)) - 0.5) * 0.3
    let de = d - fray
    let a = Finish.cover(de, px)
    // The haze of loose fibre just past the edge.
    let haze = exp(0.0 - max(de, 0.0) / 0.45) * (1.0 - a) * 0.22 * 0.700 * step(0.0, de) * step(de, 2.0)
    res = Finish.over(res, vec4(col * 0.9, 1.0) * haze)
    // The body.
    let q = p - lo + vec2(seed * 37.0, seed * 11.0)
    let k = mk_knit(q, 4.6, 2.8, 0.7)
    var body = mk_soft(col, mk_yarn(col, col * 0.400, k, q, px, 0.700))
    // The padding: lit along the upper edge, shaded at the foot; held, the
    // light turns over and the patch darkens.
    let bul = clamp(h.y * 0.9, 3.0, 10.0)
    let e = clamp((0.0 - d) / bul, 0.0, 1.0)
    let slope = 1.0 - e
    var lt = mk_lit(n) * slope
    lt = mix(lt, 0.0 - lt * 0.7, down)
    body = body * (1.0 + 0.30 * lt - 0.22 * slope * slope + 0.05 * e * up)
    body = body * (1.0 + 0.090 * hover * up) * (1.0 - 0.13 * down)
    // Pressed into the fabric, the fabric round it overhangs its top.
    let dent = Finish.inset(p, c, h, r, vec2(0.0, 1.8), 1.8)
    body = mix(body, body * 0.55, dent * 0.75 * down)
    // The rim: chain loops round the edge, their count whole so the chain
    // closes on itself.
    let rw = clamp(h.y * 0.26, 1.7, 3.0)
    let per = mk_perim_len(h, r)
    let nl = max(floor(per / (rw * 1.3) + 0.5), 4.0)
    let period = per / nl
    let u = clamp((0.0 - d) / rw, 0.0, 1.0)
    let ac = u * 2.0 - 1.0
    let f = fract(s_ed / period + u * 0.7)
    let g = (f - 0.5) * 2.0
    let loop_h = sqrt(max(1.0 - g * g, 0.0)) * sqrt(max(1.0 - ac * ac * 0.8, 0.0))
    let rl = mk_lit(n) * (0.0 - ac) * 0.9 - g * 0.25
    var rim = rimc * (0.50 + 0.62 * loop_h) * (0.9 + 0.35 * rl * mix(1.0, -0.6, down))
    rim = rim * (1.0 + (Finish.hash(floor(p / px) + vec2(9.1, seed)) - 0.5) * 0.08)
    rim = rim * (1.0 + 0.090 * hover * up) * (1.0 - 0.10 * down)
    let in_rim = 1.0 - smoothstep(rw - px * 0.5, rw + px * 0.5, 0.0 - d)
    var face = mix(body, rim, in_rim)
    // The dark line where the rim is sewn to the body.
    face = mix(face, face * 0.45, exp(0.0 - ((0.0 - d - rw) * (0.0 - d - rw)) / 0.18) * 0.65)
    res = Finish.over(res, vec4(face * a, a))
    // Focus: a running stitch of the accent yarn two points out.
    let ts = d - 2.2
    let rs = mk_running(s_ed, ts, 2.2, 1.4, 1.2, px)
    let fc = vec3(1.000, 0.824, 0.353) * (0.8 + 0.35 * rs.y)
    res = Finish.over(res, vec4(fc, 1.0) * rs.x * focus)
    return res
}

// ---------------------------------------------------------------- buttons

// Every button is a padded patch: 26 points on a 13 point line, 12 points
// either side. Its shadow falls outside the box, so the box is the patch
// and nothing is paid in padding.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
// Glyphs sit at 14 points so an icon never makes a patch taller than the
// row; an icon alone gets a square patch.
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
// The short rungs keep their own heights under the row minimum.
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonXs.draw_text.text_style.font_size = 7.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(4.0)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.34)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The patch and its states, shared by every button template; `kind` picks
// its yarn: 0 the plain patch (flat, small, large), 1 the default action, 2
// primary, 3 secondary, 4 tertiary (sewn flatter), 5 danger, 6 outline, 7
// flatter, 8 the patch that holds an icon alone. Disabled, every patch is
// knitted in the grey of a spent skein.
let mk_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float) -> vec4 {
    let m = 12.0
    let px = mk_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mk_snap(0.0, o.x, px), mk_snap(0.0, o.y, px))
    let hi = vec2(mk_snap(size.x, o.x, px), mk_snap(size.y, o.y, px))
    let live = 1.0 - disabled
    var col = vec3(0.502, 0.514, 0.553)
    if kind > 0.5 && kind < 1.5 {
        col = vec3(0.890, 0.843, 0.741)
    }
    if kind > 1.5 && kind < 2.5 {
        col = vec3(0.914, 0.698, 0.227)
    }
    if kind > 2.5 && kind < 3.5 {
        col = vec3(0.173, 0.573, 0.733)
    }
    if kind > 3.5 && kind < 4.5 {
        col = vec3(0.482, 0.251, 0.710)
    }
    if kind > 4.5 && kind < 5.5 {
        col = vec3(0.816, 0.173, 0.239)
    }
    if kind > 5.5 && kind < 6.5 {
        col = vec3(0.890, 0.843, 0.741)
    }
    if kind > 6.5 && kind < 7.5 {
        col = vec3(0.502, 0.514, 0.553)
    }
    if kind > 7.5 {
        col = vec3(0.890, 0.843, 0.741)
    }
    var lift = 1.0
    if kind > 3.5 && kind < 4.5 {
        lift = 0.6
    }
    col = mix(col, vec3(0.235, 0.271, 0.325), disabled)
    let rimc = col * 0.840
    let seed = fract(size.x * 0.0137 + size.y * 0.071)
    var res = mk_patch(p, lo, hi, min((hi.y - lo.y) * 0.24, 6.0), px, col, rimc, hover * live, down * live, focus * live, lift * mix(1.0, 0.5, disabled), seed)
    if kind > 5.5 && kind < 6.5 {
        // The outline: a running stitch of the patch's ink sewn round
        // inside its rim.
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let r = min(min((hi.y - lo.y) * 0.24, 6.0), min(h.x, h.y))
        let d = Material.sd_box(p, c, h, r)
        let rw = clamp(h.y * 0.26, 1.7, 3.0)
        let rs = mk_running(mk_perim(p, c, h, r), d + rw + 2.0, 2.0, 1.5, 1.0, px)
        res = Finish.over(res, vec4(vec3(0.118, 0.145, 0.200) * (0.85 + 0.25 * rs.y), 1.0) * rs.x * 0.8 * live)
    }
    if loading > 0.001 {
        let c = (lo + hi) * 0.5
        let rad = max(min(c.x - lo.x, c.y - lo.y) - 7.0, 2.0)
        res = mk_spinner(res, p, c, rad, anim, loading, 1.5, vec3(0.965, 0.941, 0.886))
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0), 12.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0), 12.0)
}
mod.widgets.ButtonIcon.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 8.0), 12.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0), 12.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0), 12.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0), 12.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0), 12.0)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0), 12.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0), 12.0)
}

