mod.theme = mod.themes.dark

// Milled dark panels lit from inside. One blue-black material at three
// heights: the ground, the slabs (bezels and panels) standing on it, and
// the wells punched into the slabs. Every control is a face set into a
// bezel of its own. Nothing is coloured but the light, and the light is
// one orange: thin, hot and close to an edge -- a frame burning just
// inside a chosen face, a line under a raised key, a lit fill, an arc, a
// lamp. The faces are drawn in widgets.splash; this file holds the tokens
// every face and every stock widget reads.
mod.theme.color_bg_app = #11161b
mod.theme.color_fg_app = #171c22
mod.theme.color_bg_container = #171c22

// The surface ladder: the same dark material a step apart, every rung
// carrying the grey-white ink at well over 4.5.
mod.theme.color_surface = #11161b
mod.theme.color_surface_container = #171c22
mod.theme.color_surface_container_low = #14191e
mod.theme.color_surface_container_high = #1b2027
mod.theme.color_surface_container_highest = #20262d
mod.theme.color_surface_container_lowest = #0c1014
mod.theme.color_surface_dim = #0e1216
mod.theme.color_surface_bright = #262c34
mod.theme.color_on_surface = #d5dae0
mod.theme.color_on_surface_variant = #97a0ab
mod.theme.color_outline = #646d78
mod.theme.color_outline_variant = #2a3139

// Raised faces of any stock face this sheet does not draw: the dark key,
// its top a shade lighter, its foot a shade darker.
mod.theme.color_outset = #1d2127
mod.theme.color_outset_1 = #22262d
mod.theme.color_outset_2 = #16191e
mod.theme.color_outset_hover = #22272e
mod.theme.color_outset_1_hover = #272c34
mod.theme.color_outset_2_hover = #1a1d23
mod.theme.color_outset_focus = #1d2127
mod.theme.color_outset_1_focus = #22262d
mod.theme.color_outset_2_focus = #16191e
mod.theme.color_outset_active = #211a16
mod.theme.color_outset_1_active = #2a1c12
mod.theme.color_outset_2_active = #18120e
mod.theme.color_outset_down = #131519
mod.theme.color_outset_1_down = #131519
mod.theme.color_outset_2_down = #131519
mod.theme.color_outset_drag = #131519
mod.theme.color_outset_1_drag = #131519
mod.theme.color_outset_2_drag = #131519
mod.theme.color_outset_disabled = #16191d
mod.theme.color_outset_1_disabled = #16191d
mod.theme.color_outset_2_disabled = #16191d

// Wells: punched into the slab, near black.
mod.theme.color_inset = #0b0d10
mod.theme.color_inset_1 = #090b0d
mod.theme.color_inset_2 = #0e1114
mod.theme.color_inset_hover = #0e1114
mod.theme.color_inset_1_hover = #0e1114
mod.theme.color_inset_2_hover = #111418
mod.theme.color_inset_focus = #140e0b
mod.theme.color_inset_1_focus = #140e0b
mod.theme.color_inset_2_focus = #17100c
mod.theme.color_inset_active = #140e0b
mod.theme.color_inset_1_active = #140e0b
mod.theme.color_inset_2_active = #17100c
mod.theme.color_inset_down = #08090b
mod.theme.color_inset_1_down = #08090b
mod.theme.color_inset_2_down = #08090b
mod.theme.color_inset_drag = #0b0d10
mod.theme.color_inset_1_drag = #0b0d10
mod.theme.color_inset_2_drag = #0e1114
mod.theme.color_inset_empty = #0b0d10
mod.theme.color_inset_1_empty = #0b0d10
mod.theme.color_inset_2_empty = #0e1114
mod.theme.color_inset_disabled = #101316
mod.theme.color_inset_1_disabled = #101316
mod.theme.color_inset_2_disabled = #101316

// The one device pixel edges of a stock face: the lighter line on top of a
// slab and its dark foot; the dark line on top of a well and the faint
// light lip at its lower inner edge. What has focus burns orange.
mod.theme.beveling = 0.5
mod.theme.color_bevel = #3a4048
mod.theme.color_bevel_hover = #4d545d
mod.theme.color_bevel_focus = #ff6a1e
mod.theme.color_bevel_active = #ff6a1e
mod.theme.color_bevel_empty = #3a4048
mod.theme.color_bevel_down = #3a4048
mod.theme.color_bevel_drag = #3a4048
mod.theme.color_bevel_disabled = #262b31
mod.theme.color_bevel_inset_1 = #050607
mod.theme.color_bevel_inset_2 = #2a3038
mod.theme.color_bevel_outset_1 = #4b525b
mod.theme.color_bevel_outset_2 = #0a0c0f
mod.theme.color_bevel_inset_1_hover = #050607
mod.theme.color_bevel_inset_2_hover = #343b44
mod.theme.color_bevel_outset_1_hover = #5d656f
mod.theme.color_bevel_outset_2_hover = #0a0c0f
mod.theme.color_bevel_inset_1_focus = #ff6a1e
mod.theme.color_bevel_inset_2_focus = #ff6a1e
mod.theme.color_bevel_outset_1_focus = #ff6a1e
mod.theme.color_bevel_outset_2_focus = #ff6a1e
mod.theme.color_bevel_inset_1_down = #050607
mod.theme.color_bevel_inset_2_down = #2a3038
mod.theme.color_bevel_outset_1_down = #2a3038
mod.theme.color_bevel_outset_2_down = #0a0c0f
mod.theme.color_bevel_inset_1_disabled = #262b31
mod.theme.color_bevel_inset_2_disabled = #262b31
mod.theme.color_bevel_outset_1_disabled = #262b31
mod.theme.color_bevel_outset_2_disabled = #262b31

// Ink: grey-white, never pure white; dim words a cool grey; disabled a
// quiet slate. What is lit speaks in the orange.
mod.theme.color_text = #d0d5db
mod.theme.color_text_hover = #e4e8ec
mod.theme.color_text_focus = #e4e8ec
mod.theme.color_text_active = #e4e8ec
mod.theme.color_text_down = #d0d5db
mod.theme.color_text_val = #9aa3ae
mod.theme.color_text_disabled = #5b636d
mod.theme.color_text_placeholder = #7d8691
mod.theme.color_text_placeholder_hover = #8b949f
mod.theme.color_text_meta = #8b95a1
mod.theme.color_text_cursor = #ffc690
mod.theme.color_cursor = #ffc690
mod.theme.color_cursor_focus = #ffc690
mod.theme.color_label = #d0d5db
mod.theme.color_label_hover = #e4e8ec
mod.theme.color_label_focus = #e4e8ec
mod.theme.color_label_active = #e4e8ec
mod.theme.color_label_down = #d0d5db
mod.theme.color_label_disabled = #5b636d
// Words on a dark face.
mod.theme.color_label_inner = #c9ced4
mod.theme.color_label_inner_hover = #e4e8ec
mod.theme.color_label_inner_focus = #e4e8ec
mod.theme.color_label_inner_active = #ff8a3c
mod.theme.color_label_inner_down = #c9ced4
mod.theme.color_label_inner_drag = #c9ced4
mod.theme.color_label_inner_inactive = #8b95a1
mod.theme.color_label_inner_disabled = #5b636d
// Words beside a control, on the ground.
mod.theme.color_label_outer = #c9ced4
mod.theme.color_label_outer_off = #9aa3ae
mod.theme.color_label_outer_hover = #e4e8ec
mod.theme.color_label_outer_focus = #e4e8ec
mod.theme.color_label_outer_active = #e4e8ec
mod.theme.color_label_outer_active_focus = #e4e8ec
mod.theme.color_label_outer_down = #c9ced4
mod.theme.color_label_outer_drag = #c9ced4
mod.theme.color_label_outer_disabled = #5b636d
mod.theme.color_icon = #c9ced4
mod.theme.color_icon_hover = #e4e8ec
mod.theme.color_icon_focus = #c9ced4
mod.theme.color_icon_active = #ff8a3c
mod.theme.color_icon_down = #c9ced4
mod.theme.color_icon_disabled = #5b636d

// The light: one orange. Body #ff6a1e, deep #b8340a, pale hot core
// #ffc690, glow #ff5a14.
mod.theme.color_focus = #ff6a1e
mod.theme.color_ctrl_active = #ff6a1e
mod.theme.color_val = #ff6a1e
mod.theme.color_val_hover = #ff7a30
mod.theme.color_val_focus = #ff7a30
mod.theme.color_val_drag = #ff8a3c
mod.theme.color_val_disabled = #3a3430
mod.theme.color_mark_active = #ff8a3c
mod.theme.color_mark_active_hover = #ffa060
mod.theme.color_mark_focus = #ff8a3c
mod.theme.color_mark_disabled = #5b636d
// The accent seed: the primary, secondary and tertiary families are grown
// from it. Ink on it is near black.
mod.theme.color_ctrl_selected = #ff6a1e
mod.theme.color_bg_highlight = #1f252c
mod.theme.color_bg_highlight_inline = #3a2414
mod.theme.color_text_on_accent = #140c06
// Selected text: the light's deep brown under the words while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #00000000
mod.theme.color_selection_down = #5a2a10
mod.theme.color_selection_focus = #5a2a10

mod.theme.color_terminal_bg = #0b0d10
mod.theme.color_terminal_text = #d0d5db

// Instruments: a dark screen, orange ink, a lamp that is a dark lens when off.
mod.theme.color_screen = #0b0d10
mod.theme.color_screen_ink = #ff8a3c
mod.theme.color_lamp_off = #1a1d22
mod.theme.lamp_halo = 0.3

// SPACING. Rows of 28 points bezel included, gaps of 8 between controls,
// panels padded 10. The base froze what it derived from the factor, so
// every rung this sheet depends on is stated again.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 24.0
mod.theme.size_control_m = 28.0
mod.theme.size_control_l = 32.0
mod.theme.tab_height = 28.0
mod.theme.tab_flat_height = 28.0
// Stock shaders draw a corner twice the number written: 3 is the 6 point
// corner of a stock face, 5 the 10 point corner of a stock container. The
// faces this sheet draws take their corners in true points (see below).
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 5.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs in true points: faces 4, bezels and panels 7.
mod.theme.radius_s = 4.0
mod.theme.radius_m = 7.0
mod.theme.radius_l = 7.0

// TYPE. The library's own grotesque at 9 points (12 layout points).
mod.theme.font_size_p = 9.0
mod.theme.font_size_base = 9.0

// No surface material: the faces that matter are drawn by the sheet.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #ff6a1e
true
