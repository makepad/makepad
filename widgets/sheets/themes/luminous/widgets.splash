// ---------------------------------------------------------------- selection

// The small controls keep their bezel inside their box; the quad grows only
// for the slab's short shadow.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(16.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(2.0)
mod.widgets.CheckBoxFlat.label_walk.margin.left = 16.0

// The check box: a 16 point bezel with a 12 point well punched in it. On,
// the well's frame is lit and an orange check burns in it; mixed, a dash.
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(lm_snap(x0, o.x, px), lm_snap(y0, o.y, px))
    let hi = vec2(lm_snap(x0 + sz, o.x, px), lm_snap(y0 + sz, o.y, px))
    let wlo = vec2(lm_snap(x0 + 2.0, o.x, px), lm_snap(y0 + 2.0, o.y, px))
    let whi = vec2(lm_snap(x0 + sz - 2.0, o.x, px), lm_snap(y0 + sz - 2.0, o.y, px))
    let c = (wlo + whi) * 0.5
    let held = max(self.down, self.pressed)
    let on = max(self.active, self.mixed)
    let live = 1.0 - self.disabled
    // CheckBoxCircle asks for its corners rounded all the way: a round
    // bezel and a round well.
    let round = step(20.0, self.border_radius)
    let rb = mix(4.5, (hi.x - lo.x) * 0.5, round)
    let rw = mix(2.5, (whi.x - wlo.x) * 0.5, round)
    var res = lm_slab(p, lo, hi, rb, px, 1.0, self.hover * live, self.disabled)
    // Held, the bezel dims round a well pushed deeper.
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.3 * held * live * res.w))
    res = Finish.over(res, lm_well(p, wlo, whi, rw, px, 1.0 + 1.4 * held * live, self.disabled))
    // The frame: lit when on; focus lights its line; under the hand the
    // well's edge brightens, held it brightens more and warms.
    res = lm_edge(res, p, wlo, whi, rw, px, (0.45 * self.hover + held) * live * (1.0 - on))
    res = lm_frame(res, p, wlo, whi, rw, px, max(on * (1.0 + 0.25 * self.hover + 0.3 * held), 0.35 * held) * live)
    res = lm_focus(res, p, lo, hi, rb, px, self.focus * live * (1.0 - on))
    // The error: the bezel's edge turns red-orange.
    let bd = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, rb)
    let er = Finish.band(bd, 0.0, px, px) * self.error * live
    res = Finish.over(res, vec4(vec3(1.0, 0.29, 0.16) * er, er))
    // The mark: a check 7 points across in a 1.6 point stroke, or a dash;
    // orange with a pale middle and a close halo on the floor.
    let dm = min(lm_seg(p, vec2(c.x - 3.0, c.y + 0.1), vec2(c.x - 1.0, c.y + 2.2)), lm_seg(p, vec2(c.x - 1.0, c.y + 2.2), vec2(c.x + 3.0, c.y - 2.3)))
    let dd = lm_seg(p, vec2(c.x - 2.8, c.y), vec2(c.x + 2.8, c.y))
    let dk = mix(dm, dd, self.mixed) - 0.85
    let halo = 0.35 * exp(-max(dk, 0.0) / 0.9) * (1.0 - Finish.cover(dk, px)) * on * live
    res = Finish.over(res, vec4(lm_glowc() * halo, halo * 0.4))
    let mk = Finish.cover(dk, px) * on
    var ink = mix(lm_orange(), lm_core(), (1.0 - smoothstep(-0.8, -0.2, dk)) * 0.6)
    ink = mix(ink, vec3(0.36, 0.39, 0.43), self.disabled)
    res = Finish.over(res, vec4(ink * mk, mk))
    return res * lm_fade(self.pos, self.rect_size, m)
}

// The toggle: a 34 x 18 point bezel with a pill well punched in it. Off,
// a dark domed thumb sits at the left; on, the thumb is a lit orange ball at
// the right, its light on the floor of the track.
// Size and aspect stay uniforms: the widget reads them back to find the
// knob (a plain value here left the knob icons standing in the row).
mod.widgets.ToggleFlat.draw_bg.size = uniform(18.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(1.9)
// The knob stands centred in the track's height at both ends, 4 points in
// from the bezel's edge (the 0.5 border and 3.5 of inset); told so, the
// widget rides a knob icon on it at the knob's own size and drags it the
// same travel.
mod.widgets.ToggleFlat.draw_bg.knob_centred = uniform(1.0)
mod.widgets.ToggleFlat.draw_bg.knob_inset = uniform(3.5)
mod.widgets.ToggleFlat.label_walk.margin.left = 34.0
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(lm_snap(x0, o.x, px), lm_snap(y0, o.y, px))
    let hi = vec2(lm_snap(x0 + tw, o.x, px), lm_snap(y0 + th, o.y, px))
    let wlo = vec2(lm_snap(x0 + 2.5, o.x, px), lm_snap(y0 + 2.5, o.y, px))
    let whi = vec2(lm_snap(x0 + tw - 2.5, o.x, px), lm_snap(y0 + th - 2.5, o.y, px))
    let held = max(self.pressed, self.down)
    let live = 1.0 - self.disabled
    let on = self.active
    var res = lm_slab(p, lo, hi, th * 0.5, px, 1.0, self.hover * live, self.disabled)
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.25 * held * live * res.w))
    let wr = (whi.y - wlo.y) * 0.5
    res = Finish.over(res, lm_well(p, wlo, whi, wr, px, 1.0 + 1.0 * held, self.disabled))
    // The thumb follows the value, or the pointer while it is dragged.
    let kt = mix(on, self.drag_pos, self.drag)
    let kr = wr - 1.5
    let kc = vec2(wlo.x + 1.5 + kr + (whi.x - wlo.x - 3.0 - kr * 2.0) * kt, (wlo.y + whi.y) * 0.5)
    // Its light on the floor of the track, reaching toward the left.
    let fl = exp(-max(length((p - kc) * vec2(0.45, 1.0)) - kr, 0.0) / 3.0) * 0.28 * on * live
    let win = Finish.cover(Material.sd_box(p, (wlo + whi) * 0.5, (whi - wlo) * 0.5, wr), px)
    res = Finish.over(res, vec4(lm_glowc() * fl * win, fl * win * 0.4))
    // Under the hand and held the track's edge brightens; focus lights it.
    res = lm_edge(res, p, wlo, whi, wr, px, (0.45 * self.hover + held) * live)
    res = lm_focus(res, p, lo, hi, th * 0.5, px, self.focus * live)
    // The dark thumb, off: a domed cap with a thin light ring.
    let kd = length(p - kc) - kr
    let ka = Finish.cover(kd, px)
    let ksh = Finish.drop(p, kc + vec2(0.0, 0.8), vec2(kr, kr), kr, vec2(0.0, 0.0), 1.0) * 0.6 * (1.0 - ka)
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, ksh * (1.0 - on)))
    let kq = (p - kc) / max(kr, 1.0)
    var kcol = mix(vec3(0.21, 0.227, 0.255), vec3(0.086, 0.098, 0.114), smoothstep(-1.0, 1.0, kq.y))
    kcol = kcol + vec3(0.03, 0.032, 0.035) * self.hover * live - vec3(0.03, 0.03, 0.03) * held
    let kring = Finish.band(kd, 0.0, px, px)
    kcol = mix(kcol, mix(vec3(0.22, 0.24, 0.27), vec3(0.4, 0.43, 0.47), smoothstep(0.3, -0.6, kq.y)) + vec3(0.08, 0.08, 0.08) * self.hover * live, kring)
    kcol = mix(kcol, vec3(0.1, 0.11, 0.125), 0.5 * self.disabled)
    res = Finish.over(res, vec4(kcol * ka * (1.0 - on), ka * (1.0 - on)))
    // The lit ball, on.
    res = lm_lamp(res, p, kc, kr, px, on * (1.0 - 0.25 * held), self.disabled)
    // The error: the bezel's edge turns red-orange.
    let bd = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, th * 0.5)
    let er = Finish.band(bd, 0.0, px, px) * self.error * live
    res = Finish.over(res, vec4(vec3(1.0, 0.29, 0.16) * er, er))
    return res * lm_fade(self.pos, self.rect_size, m)
}

// The radio: a 16 point round bezel with a round well; chosen, a lamp 6
// points across burns in it; off, the well is a dark ring.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(16.0)
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 16.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(y0, o.y, px))
    let hi = vec2(lm_snap(sz, o.x, px), lm_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    var res = lm_slab(p, lo, hi, sz * 0.5, px, 1.0, self.hover * live, self.disabled)
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.3 * self.down * live * res.w))
    let wr = sz * 0.5 - 2.0
    res = Finish.over(res, lm_well(p, c - vec2(wr, wr), c + vec2(wr, wr), wr, px, 1.0 + 1.4 * self.down * live, self.disabled))
    res = lm_edge(res, p, c - vec2(wr, wr), c + vec2(wr, wr), wr, px, (0.45 * self.hover + self.down) * live)
    res = lm_frame(res, p, c - vec2(wr, wr), c + vec2(wr, wr), wr, px, 0.35 * self.down * live * (1.0 - self.active))
    res = lm_focus(res, p, lo, hi, sz * 0.5, px, self.focus * live)
    return lm_lamp(res, p, c, 3.0, px, self.active * (1.0 + 0.0 * self.hover), self.disabled) * lm_fade(self.pos, self.rect_size, m)
}

// The radio tab: a raised key in its bezel; chosen, the face is lit from
// within, dark glass behind a lit line, its word lit orange.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 5.0
    let mb = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, m + mb))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
// The label is laid at the top of its box: 2.5 more on top and 2.5 less
// below stand its capitals in the middle of the face.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 2.0 right: 14.0 top: 6.5 bottom: 1.5}
mod.widgets.RadioButtonTabFlat.min_height = 28.0
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let mb = 12.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, m + mb)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let rim = lm_rim(hh)
    let flo = vec2(lm_snap(rim, o.x, px), lm_snap(rim, o.y, px))
    let fhi = vec2(lm_snap(size.x - rim, o.x, px), lm_snap(size.y - rim, o.y, px))
    let rb = min(7.0, 0.3 * hh)
    let rf = max(rb - rim + 0.5, 2.0)
    let live = 1.0 - self.disabled
    let sel = self.active
    var res = lm_slab(p, lo, hi, rb, px, 1.0, self.hover * live, self.disabled)
    if sel > 0.5 {
        // Chosen: the face lit from within, its light spilling on the
        // bezel round it.
        res = lm_lit(res, p, flo, fhi, rf, px, 1.0 + 0.12 * self.hover - 0.3 * self.down, self.disabled)
    } else {
        res = lm_face(res, p, flo, fhi, rf, px, self.hover, self.down, self.disabled, 1.0)
        res = lm_under(res, p, flo, fhi, rf, px, 0.28 * self.hover * live * (1.0 - self.down), hi.y)
        res = lm_focus(res, p, lo, hi, rb, px, self.focus * live)
    }
    // The old 5 point fade on every side for the quiet states; the chosen
    // one has 12 below for its light.
    let e = min(min(p.x + m, p.y + m), min(size.x + m - p.x, size.y + mix(m, mb, step(0.5, sel)) - p.y))
    return res * smoothstep(0.0, 4.0, e)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #aab2bc
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #e4e8ec
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #ffb47c
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #5b636d

// ---------------------------------------------------------------- sliders

// A slider thumb: a dark round cap with a thin light ring; under the hand
// the ring brightens, dragged or focused it is lit.
let lm_thumb = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let d = length(p - c) - rad
    let a = Finish.cover(d, px)
    let sh = Finish.drop(p, c, vec2(rad, rad), rad, vec2(0.0, 1.2), 1.3) * 0.7 * (1.0 - a)
    var res = Finish.over(dst, vec4(0.0, 0.0, 0.0, sh))
    let q = (p - c) / max(rad, 1.0)
    var col = mix(vec3(0.12, 0.14, 0.165), vec3(0.035, 0.047, 0.06), smoothstep(-1.0, 0.8, q.y))
    col = col + vec3(0.04, 0.045, 0.05) * exp(-dot(q - vec2(-0.25, -0.45), q - vec2(-0.25, -0.45)) * 5.0)
    col = col - vec3(0.03, 0.03, 0.03) * drag * live
    // A small dimple in the middle.
    col = mix(col, vec3(0.05, 0.055, 0.065), Finish.cover(length(p - c) - 1.4, px))
    // Its thin ring: pale on top, lit orange-brown underneath and on the
    // side the lit tube comes from.
    let ring = Finish.band(d, 0.0, px, px)
    let warm = clamp(smoothstep(-0.5, 0.6, q.y) + smoothstep(-0.2, -0.95, q.x) * 0.8, 0.0, 1.0) * live
    var rc = mix(vec3(0.46, 0.47, 0.48), vec3(0.76, 0.74, 0.7), smoothstep(0.0, -0.9, q.y))
    rc = mix(rc, vec3(0.86, 0.5, 0.27), warm) + vec3(0.15, 0.15, 0.15) * hover * live
    rc = mix(rc, vec3(0.16, 0.17, 0.19), 0.6 * dis)
    col = mix(col, rc, ring)
    col = mix(col, vec3(0.09, 0.1, 0.115), 0.5 * dis)
    res = Finish.over(res, vec4(col * a, a))
    // Lit: an orange ring with its pale core and a close halo.
    let lit = drag * live
    if lit > 0.001 {
        let od = max(d, 0.0)
        let g = 0.4 * exp(-(od * od) / (2.0 * 1.2 * 1.2)) * (1.0 - a) * lit
        res = Finish.over(res, vec4(lm_glowc() * g, g * 0.45))
        let lr = Finish.band(d, 0.0, 1.4, px) * lit
        res = Finish.over(res, vec4(lm_orange() * lr, lr))
        let lcr = Finish.band(d, 0.45, 0.95, px) * lit * 0.85
        res = Finish.over(res, vec4(lm_core() * lcr, lcr))
    }
    return res
}

// The groove every bar slider shares: a slab 12 points tall, a well 6
// points tall punched along it, the lit fill in the well.
let lm_groove = fn(p: vec2, x0: float, x1: float, cy: float, o: vec2, px: float, bh: float, wh: float, dis: float, hover: float) -> vec4 {
    let lo = vec2(lm_snap(x0, o.x, px), cy - bh * 0.5)
    let hi = vec2(lm_snap(x1, o.x, px), cy + bh * 0.5)
    var res = lm_slab(p, lo, hi, bh * 0.5, px, 1.0, hover * (1.0 - dis), dis)
    let inset = (bh - wh) * 0.5
    let wlo = vec2(lo.x + inset, cy - wh * 0.5)
    let whi = vec2(hi.x - inset, cy + wh * 0.5)
    return Finish.over(res, lm_well(p, wlo, whi, wh * 0.5, px, 1.0, dis))
}

mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 7.0
    let cy = lm_snap(20.0 + (self.rect_size.y - 20.0) * 0.5, o.y, px)
    let live = 1.0 - self.disabled
    var res = lm_groove(p, 0.0, self.rect_size.x, cy, o, px, 12.0, 9.333, self.disabled, self.hover)
    let wlo = vec2(lm_snap(0.0, o.x, px) + 1.333, cy - 4.667)
    let whi = vec2(lm_snap(self.rect_size.x, o.x, px) - 1.333, cy + 4.667)
    let span = self.rect_size.x - rad * 2.0
    let hx = rad + self.slide_pos * span
    let ox = rad + self.origin_pos * span
    let f0 = mix(wlo.x + 1.5, min(ox, hx), self.arc_origin)
    let f1 = mix(hx, max(ox, hx), self.arc_origin)
    // Focus lights the groove's line, laid under the fill so the fill keeps
    // its own light.
    res = lm_focus(res, p, vec2(lm_snap(0.0, o.x, px), cy - 6.0), vec2(lm_snap(self.rect_size.x, o.x, px), cy + 6.0), 6.0, px, self.focus * live)
    res = lm_tube(res, p, f0, f1, 2.667, px, self.disabled, max(max(self.hover, self.drag), self.focus), wlo, whi, 4.667, 0.0)
    return lm_thumb(res, p, vec2(hx, cy), rad, px, self.hover, self.drag, self.focus, self.disabled) * lm_fade(self.pos, self.rect_size, m)
}

// The minimal slider: a slim slab with its slot and the lit value; a small
// dark cap with a lit line shows under the hand.
// Its box ends close under the value, so the groove sits at the box's foot
// and runs a point past it (the quad grows 4 for that and the short shadow;
// the next row stands 8 below): the value stands 3 points clear above it.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let m = 4.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let cy = lm_snap(self.rect_size.y - 2.5, o.y, px)
    var res = lm_groove(p, 0.0, self.rect_size.x, cy, o, px, 7.0, 4.0, self.disabled, self.hover)
    let wlo = vec2(lm_snap(0.0, o.x, px) + 1.5, cy - 2.0)
    let whi = vec2(lm_snap(self.rect_size.x, o.x, px) - 1.5, cy + 2.0)
    let lo2 = min(self.origin_pos, self.slide_pos)
    let hi2 = max(self.origin_pos, self.slide_pos)
    let f0 = mix(0.0, lo2, self.arc_origin) * self.rect_size.x
    let f1 = mix(self.slide_pos, hi2, self.arc_origin) * self.rect_size.x
    res = lm_tube(res, p, max(f0, wlo.x + 1.0), min(f1, whi.x - 1.0), 1.333, px, self.disabled, max(self.hover, self.drag), wlo, whi, 2.0, 0.0)
    let hx = clamp(self.slide_pos * self.rect_size.x, 4.0, self.rect_size.x - 4.0)
    let show = max(self.hover, self.drag)
    if show > 0.001 {
        let cap = lm_face(vec4(0.0, 0.0, 0.0, 0.0), p, vec2(hx - 3.5, cy - 5.5), vec2(hx + 3.5, cy + 5.5), 2.0, px, 0.0, 0.0, self.disabled, 1.0)
        var cl = Finish.over(res, cap)
        let ln = Finish.cover(abs(p.x - hx) - 0.5, px) * step(abs(p.y - cy), 3.5)
        cl = Finish.over(cl, vec4(lm_orange() * ln, ln))
        res = mix(res, cl, show)
    }
    return res * lm_fade(self.pos, self.rect_size, m)
}

// The round slider: a label column, then the bar slider's groove, fill and
// thumb; the groove ends short of the right edge so the value stands clear.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 7.0
    let cy = lm_snap(self.rect_size.y * 0.5, o.y, px)
    let x0 = self.label_size
    let x1 = self.rect_size.x - 37.0
    var res = lm_groove(p, x0, x1, cy, o, px, 12.0, 9.333, self.disabled, self.hover)
    let wlo = vec2(lm_snap(x0, o.x, px) + 1.333, cy - 4.667)
    let whi = vec2(lm_snap(x1, o.x, px) - 1.333, cy + 4.667)
    let span = whi.x - wlo.x - rad * 2.0 + 2.667
    let hx = wlo.x - 1.333 + rad + self.slide_pos * span
    res = lm_focus(res, p, vec2(lm_snap(x0, o.x, px), cy - 6.0), vec2(lm_snap(x1, o.x, px), cy + 6.0), 6.0, px, self.focus * (1.0 - self.disabled))
    res = lm_tube(res, p, wlo.x + 1.5, hx, 2.667, px, self.disabled, max(max(self.hover, self.drag), self.focus), wlo, whi, 4.667, 0.0)
    return lm_thumb(res, p, vec2(hx, cy), rad, px, self.hover, self.drag, self.focus, self.disabled) * lm_fade(self.pos, self.rect_size, m)
}

// The fader: his cove cap with a white line across it (the slider bench's
// "Cove cap, white line", a wedge), drawn by the cap engine (mod.sdf.Cap):
// a narrow flat ridge carrying the line, concave coves sweeping down to the
// foot along the travel and straight sides across it, the ridge brought
// toward the eye by its height. It runs a 5 point slot lit orange from its
// foot to the cap, the light's halo round the lit stretch beside the cap,
// and it throws a soft shadow down and to the right. The shape, the
// material and the inks are his bench preset number for number; the ground
// under them is this sheet's (#11161b, not the bench's #2e3034). His cap
// throws its shadow and its fill's halo farther than this sheet's own faces
// do (see lm_fader_room). Under the hand the light runs a little hotter, as
// the old lit tube did, and the cap's face a shade lighter, as every face
// here; held, the cap sinks half a point; disabled, the light goes out (the
// fill a dark bar), the face dims toward the disabled face, the line greys
// and the shadows halve. The old fader drew no focus ring; neither does this.
mod.widgets.SliderFader.cap_size = 26.0
mod.widgets.SliderFader.track_inset = 8.0
mod.widgets.SliderFader.draw_bg.track_size = uniform(5.0)
mod.widgets.SliderFader.draw_bg.cap_cross = uniform(0.44)
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
// The material, tunable live: the key light (x right, y down, z toward the
// viewer) and its intensity; the highlight, its roughness and the sheen; the
// rim toward grazing; the occlusion and how far up the walls it reaches; the
// plain sky's reflection and how near the eye is over the cap; metal, spun
// grain and glow (none); the exposure in EV and the highlight roll-off; the
// cast shadow's strength and blur, the contact shadow and the slot's inner
// shadow.
mod.widgets.SliderFader.draw_bg.cap_light = uniform(vec3(-0.22, -0.72, 0.66))
mod.widgets.SliderFader.draw_bg.cap_light_intensity = uniform(0.95)
mod.widgets.SliderFader.draw_bg.cap_specular = uniform(0.12)
mod.widgets.SliderFader.draw_bg.cap_roughness = uniform(0.84)
mod.widgets.SliderFader.draw_bg.cap_gloss = uniform(0.16)
mod.widgets.SliderFader.draw_bg.cap_rim = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_ao = uniform(0.45)
mod.widgets.SliderFader.draw_bg.cap_ao_reach = uniform(1.2)
mod.widgets.SliderFader.draw_bg.cap_reflection = uniform(0.12)
mod.widgets.SliderFader.draw_bg.cap_reflection_perspective = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_metal = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_spun = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_glow = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_exposure = uniform(-0.35)
mod.widgets.SliderFader.draw_bg.cap_rolloff = uniform(0.6)
mod.widgets.SliderFader.draw_bg.cap_shadow = uniform(0.7)
mod.widgets.SliderFader.draw_bg.cap_shadow_blur = uniform(6.0)
mod.widgets.SliderFader.draw_bg.cap_contact = uniform(0.5)
mod.widgets.SliderFader.draw_bg.cap_inner = uniform(0.7)
// His inks: the cap's charcoal body, the white line, the slot's black, the
// orange fill, the light's warm white and the shade's grey. None of them is
// a token of this sheet (its handle and material tokens carry other colours
// and dress other widgets), so they stand here as he chose them. The ground
// is this sheet's window ground; disabled, the sheet's own disabled face,
// mark and value colours.
mod.widgets.SliderFader.draw_bg.ground_color = uniform(theme.color_bg_app)
mod.widgets.SliderFader.draw_bg.handle_color = uniform(#1f1f22)
mod.widgets.SliderFader.draw_bg.handle_color_disabled = uniform(theme.color_outset_disabled)
mod.widgets.SliderFader.draw_bg.mark_color = uniform(#f2f0ea)
mod.widgets.SliderFader.draw_bg.mark_color_disabled = uniform(theme.color_mark_disabled)
mod.widgets.SliderFader.draw_bg.track_color = uniform(#111214)
mod.widgets.SliderFader.draw_bg.fill_color = uniform(#bd5b00)
mod.widgets.SliderFader.draw_bg.fill_color_disabled = uniform(theme.color_val_disabled)
mod.widgets.SliderFader.draw_bg.light_color = uniform(#f4f2ee)
mod.widgets.SliderFader.draw_bg.shadow_color = uniform(#46474c)

// How far the fader's quad reaches past its rect, in points: the throw of
// the cap's cast shadow from its 14 point height along the key light, the
// blur at the shadow's tip (the engine holds it between 0.35 and 1 times the
// height), two points for the contact shadow's tail, and the glow's reach
// when the cap emits. The cap itself stays well inside that: never wider
// than the fader, stopped at the track's ends, its ridge magnified by the
// perspective by at most 16% of its half width. The lit fill's long faint
// halo is cut there (see lm_fader_fade).
let lm_fader_room = fn(lgt: vec3, blur: float, glo: float) -> float {
    let ln = normalize(lgt)
    return 14.0 * 0.7 * length(ln.xy) / max(ln.z, 0.25) + clamp(blur, 4.9, 14.0) + 24.0 * step(0.001, glo) + 2.0
}

// The grown quad fades out over the outer half of its margin, where the
// cap's shadow never reaches, by how far `p` lies outside the rect, rather
// than over the last 4 points of the quad as lm_fade fades the sheet's
// faces: the lit fill's halo still carries a few levels of orange out
// there, and ended by the quad's edge it drew each fader's quad on the
// ground as a faint square box. Faded by the distance from the rect, the
// halo dies out round a rounded outline, as light does.
let lm_fader_fade = fn(p: vec2, size: vec2, m: float) -> float {
    let d = length(max(abs(p - size * 0.5) - size * 0.5, vec2(0.0, 0.0)))
    return 1.0 - smoothstep(m * 0.5, m, d)
}

// The fader laid over the ground without painting it: the share of the
// ground it darkens away and the light it puts back, premultiplied, so bare
// ground comes out clear and the window's own ground (its vignette and
// grain) shows through. Exact for any colour. Cap.on_ground adds only what
// each channel has above the ground and takes the ground away by the
// darkest channel's share, so a colour below the ground in one channel
// loses the ground's own share in the others: the orange fill, which has no
// blue, came out 17 levels short in red and 22 in green on this ground.
let lm_on_ground = fn(col: vec3, gnd: vec3) -> vec4 {
    let dk = max(gnd - col, vec3(0.0, 0.0, 0.0)) / max(gnd, vec3(0.01, 0.01, 0.01))
    let k = clamp(max(dk.x, max(dk.y, dk.z)), 0.0, 1.0)
    return vec4(max(col - gnd * (1.0 - k), vec3(0.0, 0.0, 0.0)), k)
}

// The cove cap's solid at `w` (cap-local points in the fader's frame), his
// curves read as the bench reads them: the along curve symmetric, from its
// centre to one end, mirrored; the across curve over the half width; the
// edge over the edge width, 0.1 of the smaller half, in from the footprint
// `fp`. No ribs and no cut; a painted line leaves the solid as it is.
let lm_cove = fn(w: vec2, hs: vec2, fp: vec3, shape: vec4, mark: vec4, mark_at: vec4) -> vec4 {
    let c_along = Cap.mirror(Cap.curve(abs(w.x) / hs.x, 8.0, vec2(0.0, 1.0), vec2(0.0533, 0.0), vec2(0.0, 0.0), vec2(0.16, 1.0), vec2(0.0, 0.0), vec2(-0.01, 0.0386), vec2(0.19, 0.86), vec2(0.01, -0.0386), vec2(-0.0367, 0.0847), vec2(0.3, 0.46), vec2(0.0367, -0.0847), vec2(-0.06, 0.0557), vec2(0.48, 0.19), vec2(0.06, -0.0557), vec2(-0.0733, 0.0223), vec2(0.72, 0.07), vec2(0.0733, -0.0223), vec2(-0.02, 0.0), vec2(0.94, 0.05), vec2(0.02, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0)), w.x)
    let c_across = Cap.curve(abs(w.y) / hs.y, 3.0, vec2(0.0, 1.0), vec2(0.1567, 0.0), vec2(0.0, 0.0), vec2(0.94, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0))
    let c_edge = Cap.curve(Cap.edge_x(fp.x, hs, 0.1), 3.0, vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(0.06, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0))
    return Cap.field(w, hs, fp, c_along, c_across, c_edge, vec2(1.0, 0.0), shape, vec4(0.0, 0.0, 0.0, 0.0), mark, mark_at, vec4(0.0, 0.0, 0.0, 0.0))
}

mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let m = lm_fader_room(self.cap_light, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let m = lm_fader_room(self.cap_light, self.cap_shadow_blur, self.cap_glow)
    let sz = self.rect_size
    let o = self.rect_pos
    let p = self.pos * (sz + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let vert = self.is_vertical
    let live = 1.0 - self.disabled
    // The fader's frame: `a` along the travel from the value's zero (up the
    // screen when the fader stands), `b` across it.
    let a = mix(p.x, sz.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let ab = vec2(a, b)
    let along = mix(sz.x, sz.y, vert)
    let across = mix(sz.y, sz.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    // The slot's middle and the cap's centre on the device pixel grid, so the
    // slot's two walls antialias alike and the cap keeps one shape as it
    // moves.
    let mid = lm_snap(across * 0.5, mix(o.y, o.x, vert), px)
    let at_free = foot + self.slide_pos * travel
    let sa = Finish.snap(mix(o.x + at_free, o.y + sz.y - at_free, vert), px)
    let at = mix(sa - o.x, o.y + sz.y - sa, vert)
    // The cap's half size: cap_size along the travel, cap_cross of the
    // fader's width across, held to 4 points and to the width as the widget
    // holds it.
    let hs = vec2(self.cap_px * 0.5, min(max(across * self.cap_cross, 4.0), across) * 0.5)
    // The key light on screen, and turned into the fader's frame.
    let l = normalize(self.cap_light)
    let lt = Cap.light(l, vert)
    // Under the hand or held the light runs a little hotter; held, the cap
    // is pressed; disabled, the light goes out.
    let hot = max(self.hover, self.drag) * live
    let press = self.drag * live
    let lit = step(0.5, live)
    let ground = self.ground_color.rgb
    let light_ink = self.light_color.rgb
    let shadow_ink = self.shadow_color.rgb
    let body = self.handle_color.rgb
    let mark_ink = mix(self.mark_color.rgb, self.mark_color_disabled.rgb, self.disabled)
    let fill_ink = mix(self.fill_color.rgb * (1.0 + 0.15 * hot), self.fill_color_disabled.rgb, self.disabled)
    // THE GROUND: his slot, track_size wide, its ends rounded by half its
    // half width, held track_inset off the fader's ends; no well and no
    // scale. The fill runs from the slot's end (or out of the default, when
    // the widget asks) to the value; lit, it glows beside the cap; disabled,
    // it is a dark bar on the slot's floor.
    let tw = self.track_size
    let tlen = max(along - self.inset_px * 2.0, 1.0)
    let tbox = vec4(self.inset_px + tlen * 0.5, mid, tlen * 0.5, tw * 0.5)
    let lo = mix(foot + self.fill_lo * travel, self.inset_px, step(self.fill_lo, 0.0005))
    let hi = mix(foot + self.fill_hi * travel, along - self.inset_px, step(0.9995, self.fill_hi))
    var col = Cap.slot(ground, ab, tbox, tw * 0.25, 1.0 + lit, lo, hi, at, hs.x, lt, px, 0.0, 0.0, self.track_color.rgb, fill_ink, light_ink, shadow_ink, self.cap_inner, self.cap_ao)
    // THE CAP, his cove cap: corner 0.32 of the smaller half, edge 0.1, blend
    // 0.01, 14 points high, its top brought 16% toward the eye; a painted
    // line 1.6 points wide across its middle over 0.9 of its width. His plan
    // curve is flat at 1, which is no plan.
    let q = ab - vec2(at, mid)
    let shape = vec4(0.32, 0.1, 0.01, 14.0)
    let persp = 0.16
    let mark = vec4(1.0, 1.6, 0.35, 0.0)
    let mark_at = vec4(0.0, 0.5, 0.9, 0.0)
    let r = shape.x * min(hs.x, hs.y)
    var cap = body
    var cov = 0.0
    var under = 0.0
    var halo = 0.0
    // Only near the cap: the rest of a long track skips it.
    let far = abs(q) - hs
    if max(far.x, far.y) < m {
        var fp = Cap.sd_cap(q, hs, r, vec2(1.0, 0.0))
        // Where the cap or its magnified top can lie: the solid read three
        // times, each at the point the height read before brings toward the
        // eye. Farther out every read is the plain footprint's.
        if max(far.x - persp * hs.x, far.y - persp * hs.y) < px {
            var w = q / (1.0 + persp)
            fp = Cap.sd_cap(w, hs, r, vec2(1.0, 0.0))
            var f = lm_cove(w, hs, fp, shape, mark, mark_at)
            w = Cap.perspective(q, f.x, fp.x, persp)
            fp = Cap.sd_cap(w, hs, r, vec2(1.0, 0.0))
            f = lm_cove(w, hs, fp, shape, mark, mark_at)
            w = Cap.perspective(q, f.x, fp.x, persp)
            fp = Cap.sd_cap(w, hs, r, vec2(1.0, 0.0))
            f = lm_cove(w, hs, fp, shape, mark, mark_at)
            // The line is painted where the cap's own point lies, as the
            // bench paints it.
            let paint = Cap.mark_line(q, hs, mark, mark_at, px)
            let n = Cap.normal(f.yz, shape.w, vert)
            let v = Cap.view(q, hs, self.cap_reflection_perspective, vert)
            cap = Cap.shade(n, l, v, f.x, body, paint, 0.0, 1.0, self.cap_specular, self.cap_roughness, self.cap_gloss, self.cap_rim, self.cap_ao, self.cap_ao_reach, self.cap_reflection, self.cap_metal, self.cap_light_intensity, mark_ink, light_ink, shadow_ink, ground)
            let grain = Cap.spun(q, hs, lt.xy) * self.cap_spun * (1.0 - paint)
            cap = Cap.in_shadow(Cap.in_light(cap, clamp(grain, 0.0, 1.0) * 0.55, light_ink), clamp(-grain, 0.0, 1.0) * 0.42, shadow_ink)
            cap = Cap.emit(cap, f.x, body, light_ink, self.cap_glow)
            // The lit fill lights the cap's end walls beside it.
            cap = cap + fill_ink * Cap.fill_light(q, hs, f.yz * shape.w, lo, hi, at, tw) * (1.0 - paint) * lit
            // Under the hand the face a shade lighter, as every face here;
            // disabled, it dims toward the disabled face, the line its grey.
            cap = cap + vec3(0.018, 0.02, 0.022) * self.hover * live * (1.0 - press) * (1.0 - paint)
            cap = mix(cap, self.handle_color_disabled.rgb, 0.45 * self.disabled * (1.0 - paint))
            cov = Cap.cover(fp.x, px)
        }
        // Under it the cast shadow, thrown from his top outline and a little
        // shorter while the cap is pressed, and the contact shadow; disabled,
        // both halve, as every face's shadow here does.
        let rise = shape.w - 0.5 * press
        let dim = 1.0 - 0.5 * self.disabled
        let sh = Cap.shadow(q, hs, r, vec3(0.2235, 0.9529, 1.0), lt, rise, self.cap_shadow_blur, self.cap_shadow * dim, px)
        let ct = Cap.contact(fp.x, max(rise * 0.3, 1.0), self.cap_contact * dim)
        under = clamp(sh + ct, 0.0, 1.0)
        halo = Cap.glow(fp.x, hs, self.cap_glow)
    }
    col = mix(col, col * shadow_ink, under * (1.0 - cov))
    col = col + body * halo * 0.9 * (1.0 - cov)
    col = mix(col, cap, cov)
    let ex = pow(2.0, self.cap_exposure)
    let res = lm_on_ground(Cap.tone(col, ex, self.cap_rolloff), Cap.tone(ground, ex, self.cap_rolloff))
    return res * lm_fader_fade(p, sz, m)
}

// ---------------------------------------------------------------- knobs

// A knob: a round bezel with a well punched in it, and in the well a cut
// wing knob, as the knob bench draws it: a short cylindrical cap whose top
// is milled down on both sides, leaving a raised wing -- a band 0.56 of the
// cap's radius wide running the whole diameter -- that turns with the value
// and is the pointer. The cap is flat on top out to 0.82 of its radius,
// where a crisp edge drops into a steep rounded side down to the floor of
// the well. Two cutters take the top away either side of the wing, 0.55 of
// the cap's height deep the whole way along; each cutter's profile is a
// rounded shoulder at the wing's wall, a filleted root a sixth of a radius
// out, then a floor running away a little to the edge. One solid in the
// faders' charcoal: its flat face in their material and light, from the
// cap engine, and every face turned off the flat lit as the bench lights
// it, relative to the flat face as it shows and at the bench's strength --
// the wing's top and the floors keep the flat face's tone, the wall toward
// the light a little over it, the wall away from the light goes to the
// shade, the side ring toward the light brightens and away from it darkens
// as far as the bench's, the edges and the shoulders turned toward the
// light catch it, and a hairline round the outline is lit on the side
// toward the light. The wing throws its shadow across the floor away from
// the light, and, as in the bench, its swept crest throws one on the end
// turned toward the light, a darker notch below the top's lit edge; the
// cap throws its own on the floor of the well. Along the wing the sheet's pale
// line, laid over the lit solid as the bench lays its mark, runs from half
// the radius out to 0.95 of it, over the edge and down the side in the
// flat face's light, whichever way it points. Round the cap the value arc,
// orange with a pale core, its light falling on the floor of the well and
// catching the cap's side, at 1.18 of the cap's radius; on it twelve ticks
// stand outward, eleven steps across the sweep, lit orange where the arc
// is lit and grey past it. Under the hand the light lifts a little and the
// outlines brighten; held or focused, the value runs a little hotter, and
// focus rings the bezel in the sheet's lit line; disabled, the light goes
// out, the solid dims, the line fades and the shadows halve. Angles run
// from straight down, clockwise, the gap at the bottom.

// The cut wing's solid at `q` (points from the cap's centre): its height in
// shares of the cap's height, 1 on top. `rc` the cap's radius, `side` the
// unit vector across the wing, `hpt` the cap's height in points, `kmin` the
// least fillet. The revolve first, flat to 0.82 of the radius and falling
// to the floor at its rim (and on down past it, eight heights a radius);
// then the cutters, their section read by the distance out from the
// wing's wall, taken away by the smooth minimum. The fillet is 0.03 of the
// radius measured along the surface, so its height band shrinks where the
// crossing is steep.
let lm_cw_h = fn(q: vec2, rc: float, side: vec2, hpt: float, kmin: float) -> float {
    let rn = length(q) / rc
    let pr = Cap.curve(rn, 4.0, vec2(0.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(0.82, 1.0), vec2(0.0, 0.0), vec2(-0.026667, 0.148148), vec2(0.9, 0.55), vec2(0.026667, -0.148148), vec2(-0.016667, 0.091667), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0))
    let h = pr.x - max(rn - 1.0, 0.0) * 8.0
    let x = (abs(dot(q, side)) - 0.28 * rc) / rc
    // Inside the wing the cutter's section runs on up at its wall's slope,
    // so the smooth minimum rounds the shoulder over the fillet instead of
    // stepping where the cutter stops.
    var v = 1.0 - 5.125 * x
    var dv = -5.125
    if x < -0.1 {
        return h
    }
    if x >= 0.0 {
        let wp = Cap.curve(min(x, 0.999), 3.0, vec2(0.0, 1.0), vec2(0.026667, -0.136667), vec2(-0.053333, 0.053333), vec2(0.16, 0.18), vec2(0.053333, -0.053333), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0))
        v = wp.x + wp.y * max(x - 1.0, 0.0)
        dv = wp.y
    }
    let hc = 1.0 - 0.55 * (1.0 - v)
    let sc = 0.55 * abs(dv) / rc
    let sb = abs(pr.y) / rc
    let dg = sqrt(sc * sc + sb * sb)
    let k = max(max(0.03 * rc, kmin) * dg / sqrt(1.0 + dg * dg * hpt * hpt), 0.0001)
    let hh = clamp(0.5 - 0.5 * (hc - h) / k, 0.0, 1.0)
    return mix(h, hc, hh) - k * hh * (1.0 - hh)
}

// How far one look along the ray toward the light, `t` points out, finds
// the solid standing over the ray: the overhang in points across, as the
// bench measures it, 0 where the ray clears the solid and 1 once the solid
// stands `pen` over it (a quarter of the cap's height); a ray that clears
// it is never shaded.
let lm_cw_look = fn(q: vec2, t: float, h0: float, ld: vec2, tanel: float, rc: float, side: vec2, hpt: float, kmin: float, pen: float) -> float {
    if t <= 0.0 {
        return 0.0
    }
    let hj = lm_cw_h(q + ld * t, rc, side, hpt, kmin)
    let over = ((hj - h0) * hpt - t * tanel) / max(tanel, 0.05)
    return clamp(over / pen, 0.0, 1.0)
}

// The wing's shadow on the cut and the side's on itself: looks along the
// ray toward the light, as far as the top can throw. Two of them land just
// past where the ray climbs onto the wing's top (the band, and the band
// within the flat of the cap), the crisp edges every shadow here is thrown
// from; three more are spread along the rest.
let lm_cw_self = fn(q: vec2, h0: float, ld: vec2, tanel: float, rc: float, side: vec2, hpt: float, kmin: float, px: float) -> float {
    let tb = (1.0 - h0) * hpt / max(tanel, 0.05)
    if tb < 0.5 * px {
        return 0.0
    }
    let pen = max(0.25 * hpt / max(tanel, 0.05), px)
    let gap = 0.28 * rc
    let s0 = dot(q, side)
    var sv = dot(ld, side)
    if abs(sv) < 0.0001 {
        sv = 0.0001
    }
    let ta = (-gap - s0) / sv
    let tz = (gap - s0) / sv
    let b_in = min(ta, tz)
    let b_out = max(ta, tz)
    let rt = 0.82 * rc
    let bq = dot(q, ld)
    let cq = dot(q, q) - rt * rt
    let disc = bq * bq - cq
    var top_in = -1.0
    if disc > 0.0 {
        let sq = sqrt(disc)
        let t0 = max(b_in, -bq - sq)
        let t1 = min(b_out, -bq + sq)
        if t1 > max(t0, 0.0) {
            top_in = max(t0, 0.0)
        }
    }
    var occ = 0.0
    if b_out > 0.0 && b_in < tb {
        occ = max(occ, lm_cw_look(q, max(b_in, 0.0) + 0.5 * px, h0, ld, tanel, rc, side, hpt, kmin, pen))
    }
    if top_in >= 0.0 && top_in < tb {
        occ = max(occ, lm_cw_look(q, top_in + 0.5 * px, h0, ld, tanel, rc, side, hpt, kmin, pen))
    }
    occ = max(occ, lm_cw_look(q, 0.15 * tb, h0, ld, tanel, rc, side, hpt, kmin, pen))
    occ = max(occ, lm_cw_look(q, 0.45 * tb, h0, ld, tanel, rc, side, hpt, kmin, pen))
    occ = max(occ, lm_cw_look(q, 0.85 * tb, h0, ld, tanel, rc, side, hpt, kmin, pen))
    return occ
}

// The hull of two discs, centres `a` and `b`, radii `ra` and `rb`: in .x
// the signed distance from `p`, in .y where along a to b the nearest point
// lies.
let lm_cw_hull2 = fn(p: vec2, a: vec2, b: vec2, ra: float, rb: float) -> vec2 {
    let ba = b - a
    let l = length(ba)
    let dr = ra - rb
    if l <= abs(dr) + 0.0001 {
        let da = length(p - a) - ra
        let db = length(p - b) - rb
        if da < db {
            return vec2(da, 0.0)
        }
        return vec2(db, 1.0)
    }
    let ax = ba / l
    let pa = p - a
    let y = dot(pa, ax)
    let x = abs(ax.x * pa.y - ax.y * pa.x)
    let sb = dr / l
    let cb = sqrt(1.0 - sb * sb)
    let k = cb * y - sb * x
    if k < 0.0 {
        return vec2(length(pa) - ra, 0.0)
    }
    if k > cb * l {
        return vec2(length(p - b) - rb, 1.0)
    }
    return vec2(x * cb + y * sb - ra, k / (cb * l))
}
let lm_cw_cross = fn(a: vec2, b: vec2, p: vec2) -> float {
    let ea = b - a
    let wa = p - a
    return ea.x * wa.y - ea.y * wa.x
}

// THE WING'S SHADOW ON THE CAP'S OWN TOP, as the bench throws it: the wing
// taken as a swept solid, a disc at each end of it (0.68 of the radius out
// along it) at its crest and one at the height just over the receiver
// `zp`, as wide there as the section is (the crest 0.68 of the base's
// 0.41 radii), each moved down-light by its height over the receiver
// (`sh` points a cap's height); the shadow is the hull of the four. The
// discs at the crest reach past the flat top to 0.96 of the radius, so the
// end of the wing turned to the light, the steep side from 0.82 of the
// radius out, falls under its own crest: a darker notch with the top's
// edge lit above it and the rim lit below. The penumbra is the bench's: a
// 10 point blur on a 56 point cap, halved, never under a pixel and a half.
let lm_cw_hull = fn(q: vec2, zp: float, rc: float, dir: vec2, sh: vec2, px: float) -> float {
    let zb = 0.5838
    let z0 = max(zb, zp + 0.12)
    if z0 + 0.001 > 1.0 {
        return 0.0
    }
    let f = clamp((z0 - zb) / (1.0 - zb), 0.0, 1.0) * 3.0
    var tw = mix(1.0, 0.8767, f)
    if f >= 1.0 {
        tw = mix(0.8767, 0.7818, f - 1.0)
    }
    if f >= 2.0 {
        tw = mix(0.7818, 0.6774, f - 2.0)
    }
    let half = 0.6835 * rc
    let rb = 0.4133 * rc * tw
    let rt = 0.4133 * rc * 0.6774
    let pb0 = -dir * half + sh * (z0 - zp)
    let pb1 = dir * half + sh * (z0 - zp)
    let pt0 = -dir * half + sh * (1.0 - zp)
    let pt1 = dir * half + sh * (1.0 - zp)
    // The nearest of its four edges -- the base, the crest and the two
    // ends -- and the height there.
    let e0 = lm_cw_hull2(q, pb0, pb1, rb, rb)
    var dm = e0.x
    var zm = z0
    let e1 = lm_cw_hull2(q, pt0, pt1, rt, rt)
    if e1.x < dm {
        dm = e1.x
        zm = 1.0
    }
    let e2 = lm_cw_hull2(q, pb0, pt0, rb, rt)
    if e2.x < dm {
        dm = e2.x
        zm = mix(z0, 1.0, e2.y)
    }
    let e3 = lm_cw_hull2(q, pb1, pt1, rb, rt)
    if e3.x < dm {
        dm = e3.x
        zm = mix(z0, 1.0, e3.y)
    }
    let s1 = lm_cw_cross(pb0, pb1, q)
    let s2 = lm_cw_cross(pb1, pt1, q)
    let s3 = lm_cw_cross(pt1, pt0, q)
    let s4 = lm_cw_cross(pt0, pb0, q)
    if (s1 > 0.0 && s2 > 0.0 && s3 > 0.0 && s4 > 0.0) || (s1 < 0.0 && s2 < 0.0 && s3 < 0.0 && s4 < 0.0) {
        dm = min(dm, -rc)
    }
    let blur = 10.0 * rc / 56.0
    let bl = max(0.5 * blur * mix(0.3, 1.0, clamp(zm - zp, 0.0, 1.0)), (zm - zp) * 0.11 * length(sh))
    return 1.0 - smoothstep(-1.0, 1.0, dm / max(max(0.5 * bl, 1.5 * px), 0.001))
}

// The highlight's lobe at `nh` (the normal against the half vector) for a
// roughness `a`, normalised so that 0.5 peaks at the highlight's strength.
let lm_cw_ggx = fn(nh: float, a: float) -> float {
    let a2 = a * a
    let dd = nh * nh * (a2 - 1.0) + 1.0
    return 0.25 * a2 / max(dd * dd, 0.000001)
}
// THE BENCH'S FACE LIGHT, for a face of normal `n` under the light `l` of
// strength `li`: in .x the direct light relative to a flat face (1 flat,
// toward 0 turned away, over 1 turned toward the light), the difference
// eased in on both sides so a face turned only a little keeps the flat
// face's tone; in .y the highlight a flat face would not have, a lobe of
// strength `spec` widened by `rough`, the flat face's own subtracted.
let lm_cw_lit = fn(n: vec3, l: vec3, li: float, spec: float, rough: float) -> vec2 {
    let ndl = dot(n, l)
    let key = (smoothstep(-0.35, 1.0, ndl) - smoothstep(-0.35, 1.0, l.z)) * li * 1.5
    let dl = 1.0 + smoothstep(0.0, 1.0, key) - smoothstep(0.0, 1.0, -key)
    let rk = max(sqrt(rough * rough + 0.01), 0.03)
    let hv = normalize(l + vec3(0.0, 0.0, 1.0))
    let lobe = lm_cw_ggx(max(dot(n, hv), 0.0), rk) - lm_cw_ggx(hv.z, rk)
    return vec2(dl, max(lobe, 0.0) * spec * li * step(0.0, ndl))
}

let lm_knob = fn(p: vec2, c: vec2, rr: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, held: float, focus: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let q = p - c
    let rl = length(q)
    var res = lm_slab(p, c - vec2(rr, rr), c + vec2(rr, rr), rr, px, 1.0, hover * live, dis)
    res = lm_focus(res, p, c - vec2(rr, rr), c + vec2(rr, rr), rr, px, focus * live)
    let rw = rr - clamp(0.08 * rr, 2.0, 3.0)
    // A box too small to hold a well draws the bezel alone.
    if rw < 4.0 {
        return res
    }
    res = Finish.over(res, lm_well(p, c - vec2(rw, rw), c + vec2(rw, rw), rw, px, 1.0, dis))
    // The arc is a thin line (1.2 to 1.6 points) near the well's rim, the
    // floor inside it room for its glow and the knob, and outside it room
    // for the ticks: they run out from the arc's middle 0.14 of the cap's
    // radius (the arc's radius over 1.18), and at least a point past the
    // arc's outer edge, their round ends half a point inside the rim. On a
    // small knob that room is wanting at 0.86 of the well, so the arc, and
    // the cap with it, draw in until the ticks fit.
    let ring_w = clamp(0.07 * rr, 1.2, 1.6)
    let tick_w = max(1.8 * 0.86 * rw / (1.18 * 56.0), 1.0)
    let tick_room = rw - 0.5 - tick_w * 0.5
    let ring_mid = min(0.86 * rw, min(tick_room / (1.0 + 0.14 / 1.18), tick_room - ring_w * 0.5 - 1.0))
    let one = PI / 180.0
    let sweep = 2.0 * PI - gap * one
    let start = gap * one * 0.5
    let ve = start + sweep * slide
    let oe = start + sweep * origin
    let a0 = mix(start, min(oe, ve), arc_origin)
    let a1 = mix(ve, max(oe, ve), arc_origin)
    var ang = atan2(-q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let es = 0.5 / max(ring_mid, 1.0)
    let inside_sweep = smoothstep(start - es, start + es, ang) * (1.0 - smoothstep(start + sweep - es, start + sweep + es, ang))
    // The unlit track: a faint line in the well.
    let tr = Finish.cover(abs(rl - ring_mid) - ring_w * 0.5, px) * inside_sweep
    res = Finish.over(res, vec4(vec3(0.1, 0.11, 0.125) * tr, tr))

    // THE CAP'S PROPORTIONS, the bench's: the arc and the ticks stand at
    // 1.18 of the cap's radius, so the cap is the arc's radius over 1.18
    // (0.73 of the well's, less on a small knob); its height is 0.6 of its
    // radius, the depth the bench gives it in charcoal. The ticks are 1.8
    // points wide on a 56 point cap, never under a point.
    let rc = ring_mid / 1.18
    let hpt = 0.6 * rc
    let kmin = 0.5 * px
    let dir = vec2(-sin(ve), cos(ve))
    let side = vec2(-dir.y, dir.x)
    let tick_r1 = min(ring_mid + max(0.14 * rc, ring_w * 0.5 + 1.0), tick_room)
    // The faders' material: their key light, charcoal, pale line, the
    // light's warm white and the shade's grey, the window's ground for the
    // sky, the highlight, sheen, rim and exposure; the light 1.2 strong for
    // their 0.95 on the flat face, as a knob seen from above turns less of
    // itself to the light than a cove cap's faces do, and three quarters of
    // that, the bench's 0.9, for the faces turned off it. Under the hand it
    // lifts a little.
    let l = normalize(vec3(-0.22, -0.72, 0.66))
    let ld = normalize(l.xy)
    let tanel = l.z / length(l.xy)
    let cap_ink = vec3(0.122, 0.122, 0.133)
    let mark_ink = vec3(0.949, 0.941, 0.918)
    let light_ink = vec3(0.957, 0.949, 0.933)
    let shadow_ink = vec3(0.275, 0.278, 0.298)
    let ex = pow(2.0, -0.35)
    let dim = 1.0 - 0.5 * dis
    let hot = 1.0 + 0.25 * max(held, focus)
    let li = (1.2 + 0.15 * hover * live) * mix(1.0, 0.8, dis)
    let dcap = rl - rc
    let ccap = Finish.cover(dcap, px)

    // THE TICKS, on the floor under everything that falls on it: a capsule
    // from 1.18 of the radius outward at each of the twelve stops. Unlit
    // ones first, a grey a little brighter than the track; the lit ones
    // are laid over the arc below.
    let tstep = sweep / 11.0
    let tk = clamp(floor((ang - start) / tstep + 0.5), 0.0, 11.0)
    let ta = start + tk * tstep
    let tdir = vec2(-sin(ta), cos(ta))
    let td = lm_seg(q, tdir * (1.18 * rc), tdir * tick_r1) - tick_w * 0.5
    let tcov = Finish.cover(td, px)
    let arcon = step(0.004, abs(a1 - a0))
    let tlit = step(a0 - 0.001, ta) * step(ta, a1 + 0.001) * arcon * live
    let tunl = tcov * (1.0 - tlit)
    res = Finish.over(res, vec4(mix(vec3(0.3, 0.318, 0.345), vec3(0.16, 0.17, 0.185), dis) * tunl, tunl))

    // Its shadow on the floor of the well, never past it: the cap's, thrown
    // by the height of the cut's floor, and the wing's, thrown by the full
    // height from a box along it; and a contact shadow hugging its foot.
    let sb = Cap.shadow(q, vec2(rc, rc), rc, vec3(0.9, 0.9, 1.0), l, 0.55 * hpt, 6.0, 0.7 * dim, px)
    let qw = vec2(dot(q, dir), dot(q, side))
    let lw = vec3(dot(l.xy, dir), dot(l.xy, side), l.z)
    let sw = Cap.shadow(qw, vec2(0.9 * rc, 0.42 * rc), 0.4 * rc, vec3(0.91, 0.67, 1.0), lw, hpt, 6.0, 0.6 * dim, px)
    let ct = Cap.contact(dcap, max(hpt * 0.15, 1.0), 0.5 * dim)
    let wfl = Finish.cover(rl - (rw - 0.5 * px), px)
    let fsh = clamp(max(sb, sw) + ct, 0.0, 1.0) * (1.0 - ccap) * wfl
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, fsh * 0.85))

    // The arc, with round ends: the distance to its middle line.
    let e0 = c + ring_mid * vec2(-sin(a0), cos(a0))
    let e1 = c + ring_mid * vec2(-sin(a1), cos(a1))
    let inr = step(a0, ang) * step(ang, a1)
    let ad = mix(min(length(p - e0), length(p - e1)), abs(rl - ring_mid), inr)
    let arc = Finish.cover(ad - ring_w * 0.5, px) * arcon
    // Its light on the dark floor of the well, both sides of the line: a
    // red-orange close to it (#9a2900 at a point), a deep red-brown that
    // reaches the knob and the well's rim.
    // It fades out across the bezel's rim rather than stopping at the well.
    let lit = hot * live * arcon * (1.0 - smoothstep(rw - 0.5, rr, rl)) * (1.0 - arc)
    let odd = max(ad - ring_w * 0.5, 0.0)
    let gf = 1.2 * exp(-odd / 5.0) * lit
    res = Finish.over(res, vec4(vec3(0.42, 0.1, 0.03) * gf, gf * 0.6))
    let gn = 1.2 * exp(-odd / 0.6) * lit
    res = Finish.over(res, vec4(vec3(0.85, 0.22, 0.03) * gn, gn * 0.6))
    // The line: orange at its edges, a pale hot core down its middle.
    let hq = ad / (0.3 * ring_w)
    var acol = mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.75, 0.47), exp(-hq * hq) * (0.85 + 0.15 * max(held, focus)))
    acol = mix(acol, vec3(0.3, 0.28, 0.27), dis)
    res = Finish.over(res, vec4(acol * arc, arc))
    // The lit ticks: the arc's orange, a pale core along each, a little
    // brighter held or focused.
    let tl = tcov * tlit
    let tq = (td + tick_w * 0.5) / max(0.35 * tick_w, 0.3)
    let tcol = mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.75, 0.47), exp(-tq * tq) * 0.8) * (0.9 + 0.1 * hot)
    res = Finish.over(res, vec4(tcol * tl, tl))

    // THE CAP: its height here and a device pixel either way, the normal
    // from their differences, as the bench reads its solid.
    let h0 = lm_cw_h(q, rc, side, hpt, kmin)
    let hx = lm_cw_h(q + vec2(px, 0.0), rc, side, hpt, kmin) - lm_cw_h(q - vec2(px, 0.0), rc, side, hpt, kmin)
    let hy = lm_cw_h(q + vec2(0.0, px), rc, side, hpt, kmin) - lm_cw_h(q - vec2(0.0, px), rc, side, hpt, kmin)
    let n = normalize(vec3(-vec2(hx, hy) * hpt / (2.0 * px), 1.0))
    // The light that reaches it past the wing and the side: the bench's
    // visibility, the shadow taking up to 0.385 of the key light; the
    // solid's own shadow, and the wing's as the bench throws it.
    let selfsh = max(lm_cw_self(q, h0, ld, tanel, rc, side, hpt, kmin, px), lm_cw_hull(q, h0, rc, dir, -ld * (hpt / tanel), px))
    let kvis = 1.0 - 0.385 * selfsh * dim
    // The pale line painted along the wing, square-ended, 2 points wide on
    // a 56 point cap, never under 1.2.
    let pw = max(2.0 * rc / 56.0, 1.2)
    let pal = dot(q, dir)
    let pd2 = vec2(abs(dot(q, side)) - pw * 0.5, max(0.5 * rc - pal, pal - 0.95 * rc))
    let pd = min(max(pd2.x, pd2.y), 0.0) + length(max(pd2, vec2(0.0, 0.0)))
    let paint = Finish.cover(pd, px) * mix(1.0, 0.45, dis)
    // The flat face in the faders' material, as it shows (exposed); then
    // every face lit as the bench lights it, relative to that, at the
    // bench's strength (0.9, three quarters of the sheet's light), so a face
    // turned a little keeps the flat face's tone, one turned to the light
    // brightens as much as the bench's does and one turned away goes to the
    // shade as far.
    let vw = Cap.view(q, vec2(rc, rc), 0.35, 0.0)
    let face = Cap.tone(Cap.shade(vec3(0.0, 0.0, 1.0), l, vw, clamp(h0, 0.0, 1.0), cap_ink, 0.0, 0.0, 1.0, 0.12, 0.84, 0.16, 0.35, 0.45, 1.2, 0.12, 0.0, li, mark_ink, light_ink, shadow_ink, lm_ground()), ex, 0.6)
    let lt = lm_cw_lit(n, l, li * 0.75, 0.12, 0.84)
    // The bench's hairline round the cap's outline, 1.4 points wide on a 56
    // point cap: its light raised where the side faces the light, lowered
    // where it faces away.
    let hband = 1.0 - smoothstep(0.0, max(1.4 * rc / 56.0, px), abs(dcap))
    let dl = lt.x + 0.3 * hband * dot(n.xy / max(length(n.xy), 0.0001), ld)
    var col = Cap.in_light(face * (shadow_ink + (vec3(1.0, 1.0, 1.0) - shadow_ink) * clamp(dl, 0.0, 1.0) * kvis), max(dl - 1.0, 0.0) * kvis, light_ink)
    col = col + light_ink * lt.y * kvis
    // And its rim: the last half point inside the outline lit as it faces
    // the light, 0.32 strong.
    let rimw = max(0.5 * rc / 56.0, 0.5 * px)
    col = Cap.in_light(col, (1.0 - smoothstep(0.0, rimw, -dcap)) * step(dcap, 0.0) * pow(max(dot(n, l), 0.0), 0.8) * 0.32 * dim, light_ink)
    // The arc's light catches the cap's side where it faces out, from the
    // top's edge down; the wing's walls inside stand clear of it.
    let outward = clamp(dot(n.xy, q / max(rl, 0.001)) * 1.4, 0.0, 1.0) * smoothstep(0.78 * rc, 0.9 * rc, rl)
    col = col + vec3(0.85, 0.22, 0.03) * gf * 0.5 * outward * ex
    // Under the hand a shade lighter, as every face here; disabled, dimmed
    // toward the disabled face.
    col = col + vec3(0.018, 0.02, 0.022) * hover * live * ex
    col = mix(col, vec3(0.086, 0.098, 0.114) * ex, 0.45 * dis)
    col = Cap.tone(col, 1.0, 0.6)
    // The line laid over the lit solid, as the bench lays its mark: in the
    // flat face's light the whole length, so it keeps its tone over the
    // edge and down the side whichever way the wing points.
    let line = Cap.tone(Cap.shade(vec3(0.0, 0.0, 1.0), l, vw, 1.0, cap_ink, 1.0, 0.0, 1.0, 0.12, 0.84, 0.16, 0.35, 0.45, 1.2, 0.12, 0.0, li, mark_ink, light_ink, shadow_ink, lm_ground()), ex, 0.6)
    col = mix(col, line, paint)
    return Finish.over(res, vec4(col * ccap, ccap))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    return lm_knob(p, c, dia * 0.5 - 1.0, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled) * lm_fade(self.pos, self.rect_size, m)
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y - 24.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + 22.0 + dia * 0.5, px) - self.rect_pos.y)
    return lm_knob(p, c, dia * 0.5 - 1.0, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled) * lm_fade(self.pos, self.rect_size, m)
}
// The dial's value: a small chip, a well with orange digits.
mod.widgets.Rotary.text_input.min_height = 0.0
mod.widgets.Rotary.text_input.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 2.0 bottom: 2.0}
mod.widgets.Rotary.text_input.draw_text.color = #ff8a3c

// ---------------------------------------------------------------- fields

// A text field: a well punched in its bezel. Focused, the well's frame is
// lit, the light bleeding inward over the floor.
let lm_field = fn(p: vec2, lo: vec2, hi: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, bezel: float) -> vec4 {
    let hh = hi.y - lo.y
    let rim = mix(0.0, clamp(0.12 * hh, 3.0, 3.5), bezel)
    let rb = min(7.0, 0.3 * hh)
    let wlo = vec2(lm_snap(lo.x + rim, o.x, px), lm_snap(lo.y + rim, o.y, px))
    let whi = vec2(lm_snap(hi.x - rim, o.x, px), lm_snap(hi.y - rim, o.y, px))
    let rw = max(rb - rim, 2.0)
    let live = 1.0 - dis
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if bezel > 0.5 {
        res = lm_slab(p, lo, hi, rb, px, 1.0, hover * live, dis)
    }
    res = Finish.over(res, lm_well(p, wlo, whi, rw, px, 1.0 + 0.6 * down * live, dis))
    res = lm_edge(res, p, wlo, whi, rw, px, (0.45 * hover + 0.55 * down) * live * (1.0 - focus))
    return lm_frame(res, p, wlo, whi, rw, px, focus * live)
}

mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(self.rect_size.x, o.x, px), lm_snap(self.rect_size.y, o.y, px))
    // A field lower than a row (the dial's value chip) is a bare well.
    let bezel = step(22.0, hi.y - lo.y)
    return lm_field(p, lo, hi, o, px, self.hover, self.down, self.focus, self.disabled, bezel) * lm_fade(self.pos, self.rect_size, m)
}
mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_cursor.color = #ffc690
mod.widgets.TextInputFlat.draw_text.color = #d0d5db
mod.widgets.TextInputFlat.draw_text.color_empty = #7d8691
mod.widgets.TextInputFlat.draw_text.color_disabled = #5b636d

// The number field: the same well; its stepper two small keys stacked at
// the right, sharing the field's bezel.
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(self.rect_size.x, o.x, px), lm_snap(self.rect_size.y, o.y, px))
    return lm_field(p, lo, hi, o, px, self.hover, 0.0, self.focus, self.disabled, 1.0) * lm_fade(self.pos, self.rect_size, m)
}
mod.widgets.NumberField.spin_width = 18.0
mod.widgets.NumberSpin.width = 18.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let x0 = lm_snap(1.0, o.x, px)
    let x1 = lm_snap(self.rect_size.x - 3.5, o.x, px)
    let y0 = lm_snap(4.0, o.y, px)
    let y1 = lm_snap(self.rect_size.y - 4.0, o.y, px)
    let mid = lm_snap(self.rect_size.y * 0.5, o.y, px)
    let live = 1.0 - self.disabled
    let tu = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), tu) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), tu) * live
    let lo = vec2(x0, mix(mid + px * 0.5, y0, tu))
    let hi = vec2(x1, mix(y1, mid - px * 0.5, tu))
    var res = lm_face(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, 2.0, px, hot, dn, self.disabled, 1.0)
    let cx = (x0 + x1) * 0.5
    let cu = (y0 + mid) * 0.5
    let cd = (mid + y1) * 0.5
    let du = min(lm_seg(p, vec2(cx - 2.5, cu + 1.2), vec2(cx, cu - 1.3)), lm_seg(p, vec2(cx, cu - 1.3), vec2(cx + 2.5, cu + 1.2)))
    let dd = min(lm_seg(p, vec2(cx - 2.5, cd - 1.2), vec2(cx, cd + 1.3)), lm_seg(p, vec2(cx, cd + 1.3), vec2(cx + 2.5, cd - 1.2)))
    let k = Finish.cover(min(du, dd) - 0.6, px) * mix(1.0, 0.4, self.disabled)
    let ink = mix(vec3(0.788, 0.808, 0.831), vec3(1.0, 0.541, 0.235), max(hot, dn))
    return Finish.over(res, vec4(ink * k, k))
}

// The chevron of a drop-down: 8 x 4.5 points in a 1.5 point stroke; grey
// at rest, lit orange with a close halo when open.
let lm_chevron = fn(dst: vec4, p: vec2, cc: vec2, ink: vec3, open: float, dis: float, px: float) -> vec4 {
    let dk = min(lm_seg(p, vec2(cc.x - 4.0, cc.y - 2.0), vec2(cc.x, cc.y + 2.2)), lm_seg(p, vec2(cc.x, cc.y + 2.2), vec2(cc.x + 4.0, cc.y - 2.0))) - 0.75
    let hb = 0.4 * exp(-max(dk, 0.0) / 0.9) * (1.0 - Finish.cover(dk, px)) * open * (1.0 - dis)
    var res = Finish.over(dst, vec4(lm_glowc() * hb, hb * 0.45))
    let col = mix(mix(ink, vec3(1.0, 0.541, 0.235), open), vec3(0.36, 0.39, 0.43), dis)
    let k = Finish.cover(dk, px)
    return Finish.over(res, vec4(col * k, k))
}

// The drop-down: a raised key in its bezel, its chevron in a zone of its
// own at the right behind an engraved joint; open, held and the frame lit.
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 14.0 right: 34.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
let lm_dropdown = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, open: float, dis: float, focus: float) -> vec4 {
    let m = 5.0
    let px = lm_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let rim = lm_rim(hh)
    let flo = vec2(lm_snap(rim, o.x, px), lm_snap(rim, o.y, px))
    let fhi = vec2(lm_snap(size.x - rim, o.x, px), lm_snap(size.y - rim, o.y, px))
    let rb = min(7.0, 0.3 * hh)
    let rf = max(rb - rim + 0.5, 2.0)
    let live = 1.0 - dis
    let held = max(down, open)
    var res = lm_slab(p, lo, hi, rb, px, 1.0, hover * live, dis)
    res = lm_face(res, p, flo, fhi, rf, px, hover, held, dis, 1.0)
    res = lm_under(res, p, flo, fhi, rf, px, 0.28 * hover * live * (1.0 - held), hi.y)
    // The joint before the chevron zone: a dark line and a light one.
    let jx = lm_snap(size.x - rim - 22.0, o.x, px)
    let iny = step(flo.y + 3.0, p.y) * step(p.y, fhi.y - 3.0)
    let jd = step(jx - px, p.x) * step(p.x, jx) * iny
    let jl = step(jx, p.x) * step(p.x, jx + px) * iny
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.8 * jd))
    res = Finish.over(res, vec4(vec3(0.2, 0.22, 0.245) * jl, jl))
    res = lm_frame(res, p, flo, fhi, rf, px, open * live)
    res = lm_focus(res, p, lo, hi, rb, px, focus * live * (1.0 - open))
    // The chevron is a glyph on a lit control when the list is open or the
    // frame is lit by focus: orange.
    res = lm_chevron(res, p, vec2(fhi.x - 11.0, (lo.y + hi.y) * 0.5), vec3(0.788, 0.808, 0.831), max(open, focus), dis, px)
    return res * lm_fade(pos, size, m)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    return lm_dropdown(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.active, self.disabled, self.focus)
}
mod.widgets.DropDownFlat.draw_text.color = #c9ced4
mod.widgets.DropDownFlat.draw_text.color_hover = #e4e8ec
mod.widgets.DropDownFlat.draw_text.color_focus = #e4e8ec
mod.widgets.DropDownFlat.draw_text.color_disabled = #5b636d

