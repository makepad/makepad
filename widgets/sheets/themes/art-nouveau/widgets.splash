    return an_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 0.0)
}

// ---------------------------------------------------------------------------
// RADIOS. A round ivory well in its wire; chosen, a teal enamel disc fills
// it with an ivory pip at its middle.
let md_radio = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, focus: float, active: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let q = p - c
    let d = length(q) - rad
    var fill = Finish.lift(an_well_c(), 0.6 * hover * live)
    fill = mix(fill, mix(an_well_c(), an_parch_c(), 0.6), dis)
    var out = an_well(p, c, vec2(rad, rad), rad, px, fill, 0.30 - 0.12 * hover * live, 1.3, dis)
    let ir = rad - 2.6
    let tcol = an_enamel(p, c, vec2(ir, ir), ir, mix(an_teal(), vec3(0.62, 0.63, 0.55), dis), hover * live, down * live)
    let ta = Finish.cover(length(q) - ir, px) * active
    out = Finish.over(out, vec4(tcol * ta, ta))
    let pa = Finish.cover(length(q) - rad * 0.26, px) * active
    out = Finish.over(out, vec4(mix(an_ivory(), vec3(0.85, 0.82, 0.74), dis) * pa, pa))
    return Finish.over(out, md_focus(d, px, focus * live))
}

