// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point box with rounded corners in its bronze wire: clear,
// a sunk ivory well; set, teal enamel with an ivory check; mixed, teal with
// an ivory dash.
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(14.0)
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let live = 1.0 - self.disabled
    let x0 = mix(1.0, size.x - sz - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - sz) * 0.5, px)) - o
    let h = vec2(sz * 0.5, sz * 0.5)
    let c = lo + h
    let r = mix(3.5, h.y, step(20.0, self.border_radius))
    let d = md_rbox(p, c, h, r)
    let on = max(self.active, self.mixed)
    let press = self.down * live
    var fill = Finish.lift(an_well_c(), 0.6 * self.hover * live)
    fill = mix(fill, mix(an_well_c(), an_parch_c(), 0.6), self.disabled)
    var out = an_well(p, c, h, r, px, fill, 0.30 - 0.12 * self.hover * live, 1.3, self.disabled)
    // the teal enamel when set
    let hf = h - vec2(1.3, 1.3)
    var tcol = an_enamel(p, c, hf, max(r - 1.3, 0.0), mix(an_teal(), vec3(0.62, 0.63, 0.55), self.disabled), self.hover * live, press)
    let ta = Finish.cover(md_rbox(p, c, hf, max(r - 1.3, 0.0)), px) * on
    out = Finish.over(out, vec4(tcol * ta, ta))
    let k = sz / 14.0
    let m0 = lo + vec2(3.6, 7.3) * k
    let m1 = lo + vec2(6.0, 9.8) * k
    let m2 = lo + vec2(10.6, 4.3) * k
    let ck = min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.85 * k
    let d0 = lo + vec2(4.0, 7.0) * k
    let d1 = lo + vec2(10.0, 7.0) * k
    let dash = md_seg(p, d0, d1) - 0.85 * k
    let show_ck = self.active * (1.0 - self.mixed)
    let mk = mix(Finish.cover(ck, px) * show_ck, Finish.cover(dash, px), self.mixed)
    let ink = mix(an_ivory(), vec3(0.85, 0.82, 0.74), self.disabled)
    out = Finish.over(out, vec4(ink * mk, mk))
    let err = Finish.band(d, 0.0, 2.0 * px, px) * self.error
    out = Finish.over(out, vec4(vec3(0.60, 0.20, 0.15) * err, err))
    return Finish.over(out, md_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 38 by 16 point pill sunk in its wire: parchment-sage while off,
// teal enamel while on; riding in it a 12 point ivory disc in a bronze ring,
// a teal jewel at its middle, with its own small shadow.
let an_toggle = fn(pos: vec2, size: vec2, o: vec2, px: float, active: float, drag_pos: float, drag: float, hover: float, down: float, focus: float, dis: float, err: float, at_end: float, metal: float) -> vec4 {
    let m = 4.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let tw = 38.0
    let th = 16.0
    let x0 = mix(1.0, size.x - tw - 1.0, at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - th) * 0.5, px)) - o
    let c = lo + vec2(tw * 0.5, th * 0.5)
    let h = vec2(tw * 0.5, th * 0.5)
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let on = active
    var fill = mix(vec3(0.788, 0.769, 0.639), an_teal(), on)
    fill = Finish.lift(fill, 0.10 * hover * live)
    fill = mix(fill, mix(fill, vec3(0.80, 0.78, 0.70), 0.6), dis)
    var out = an_well(p, c, h, r, px, fill, mix(0.38, 0.45, on), 1.3, dis)
    let ea = Finish.band(d, 0.0, 2.0 * px, px) * err
    out = Finish.over(out, vec4(vec3(0.60, 0.20, 0.15) * ea, ea))
    // the disc
    let kt = clamp(mix(on, drag_pos, drag), 0.0, 1.0)
    let kr = 6.0
    let kx = Finish.snap(o.x + lo.x + 2.0 + kr + kt * (tw - 4.0 - 2.0 * kr), px) - o.x
    let kc = vec2(kx, c.y)
    let press = down * live
    out = Finish.over(out, an_drop(p, kc, vec2(kr, kr), kr, (0.9 - 0.5 * press) * mix(1.0, 0.4, dis)))
    let q = p - kc
    let kd = length(q) - kr
    let kn = q / max(length(q), 0.001)
    // the ivory (or, on the rocker, bronze) face, domed toward the light
    let lit = clamp(0.5 - 0.5 * dot(q / kr, vec2(0.45, 0.85)), 0.0, 1.0)
    var face = mix(mix(vec3(0.80, 0.74, 0.60), an_ivory(), lit), mix(an_bronze_dk(), an_gold_hi(), lit * 0.9), metal)
    face = Finish.lift(face, 0.12 * hover * live * (1.0 - press))
    face = mix(face, face * 0.9, press)
    face = mix(face, mix(face, vec3(0.80, 0.78, 0.72), 0.6), dis)
    let ka = Finish.cover(kd, px)
    out = Finish.over(out, vec4(face * ka, ka))
    out = Finish.over(out, an_wire(kd, kn, 1.3, px, live) * mix(1.0, 0.5, dis))
    // the jewel: teal when on, a dark bead when off
    let jd = length(q) - 2.0
    var jc = mix(vec3(0.20, 0.22, 0.18), vec3(0.30, 0.62, 0.53), on * live)
    jc = mix(jc, an_ivory(), (1.0 - smoothstep(0.0, 1.2, length(q - vec2(-0.6, -0.7)))) * 0.6)
    out = an_lay(out, jd, jc, 0.4, px)
    return Finish.over(out, md_focus(d, px, focus * live))
}
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 14.0
