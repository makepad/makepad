use mod.prelude.widgets_internal.*

// Art nouveau. The ground is aged cream parchment, its fibre and a faint warm
// mottle drawn at the device pixel; the window is held in a frame of deep
// teal enamel bands edged with bronze-gold wire, the panes set in it with
// rounded corners, and the only ornament (lilies, leaves, whiplash stems and
// tendrils, all drawn as curves) grows in the frame's corners and the
// corners of the big surfaces, never behind words or controls.
// A control is an ENAMEL face set in a bronze CLOISON: a raised wire of
// bronze-gold round a flat matte enamel (teal for the working colour, ochre
// for the primary action, terracotta for the one that deletes, ivory or
// parchment for the quiet ones), or a WELL of ivory sunk into the parchment
// behind the same wire. Knobs and thumbs are bronze, lamps are cabochons of
// coloured glass in bronze settings, screens deep teal glass with amber
// figures. The light falls from the upper left.

// A ROW OF FIELDS IS ONE HEIGHT. The box metrics are stated once here and
// handed to each field below, so the search box, the number beside it and
// the drop-down after it stand at one height.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 8.0
// A hairline, for the few stock fields the faces below do not redraw.
let field_border = 0.5

let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that lays its own parts out inside a frame: only the height.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #d8c29c

// Plain views stop clipping, so a shadow or a lip may fall into the gap
// beside its control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// The palette.
let an_ink = fn() -> vec3 {
    return vec3(0.165, 0.129, 0.086)
}
let an_ivory = fn() -> vec3 {
    return vec3(0.953, 0.910, 0.812)
}
let an_parch_c = fn() -> vec3 {
    return vec3(0.847, 0.761, 0.612)
}
let an_well_c = fn() -> vec3 {
    return vec3(0.922, 0.875, 0.769)
}
let an_teal = fn() -> vec3 {
    return vec3(0.275, 0.388, 0.353)
}
let an_teal_dk = fn() -> vec3 {
    return vec3(0.184, 0.282, 0.259)
}
let an_teal_lt = fn() -> vec3 {
    return vec3(0.420, 0.545, 0.490)
}
let an_ochre = fn() -> vec3 {
    return vec3(0.851, 0.659, 0.341)
}
let an_terra = fn() -> vec3 {
    return vec3(0.627, 0.290, 0.212)
}
let an_sage = fn() -> vec3 {
    return vec3(0.776, 0.784, 0.678)
}
let an_bronze_c = fn() -> vec3 {
    return vec3(0.776, 0.608, 0.318)
}
let an_bronze_dk = fn() -> vec3 {
    return vec3(0.380, 0.270, 0.110)
}
let an_gold_hi = fn() -> vec3 {
    return vec3(0.988, 0.894, 0.643)
}
let an_line_c = fn() -> vec3 {
    return vec3(0.690, 0.510, 0.220)
}
let an_shade = fn() -> vec3 {
    return vec3(0.180, 0.120, 0.050)
}
let an_glass_c = fn() -> vec3 {
    return vec3(0.129, 0.208, 0.188)
}

// A rounded box, true radius.
let md_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let md_r4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    return clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
}
let md_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    return md_rbox(p, c, h, md_r4(p, c, h, r4))
}

// The outward normal of a rounded box at `p`.
let an_nrm = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let q0 = p - c
    let sx = mix(-1.0, 1.0, step(0.0, q0.x))
    let sy = mix(-1.0, 1.0, step(0.0, q0.y))
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(rr, rr)
    var n = vec2(0.0, 1.0)
    if q.x > 0.0 && q.y > 0.0 {
        n = q / max(length(q), 0.0001)
    } else {
        if q.x > q.y {
            n = vec2(1.0, 0.0)
        }
    }
    return vec2(n.x * sx, n.y * sy)
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's radius.
let md_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let md_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

let md_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// THE PARCHMENT at a point `w` (points) in the surface's own space: a faint
// warm mottle in two slow octaves (a few per cent, wide and soft, so no
// stain reads as a blotch), sparse short fibres -- a darker and a paler set,
// each the contour of a stretched noise, so they wander -- and a grain of
// one device pixel.
let an_parch = fn(w: vec2, px: float, base: vec3) -> vec3 {
    let m = Finish.noise(w * 0.0065) * 0.6 + Finish.noise(w * 0.019 + vec2(3.1, 7.7)) * 0.4 - 0.5
    var col = base * (1.0 + 0.055 * m) + vec3(0.010, 0.002, -0.012) * m
    let n1 = Finish.noise(vec2(w.x * 0.055 + w.y * 0.012, w.y * 0.42 - w.x * 0.05))
    let k1 = Finish.noise(w * 0.035 + vec2(9.0, 2.0))
    let f1 = (1.0 - smoothstep(0.0, 0.016, abs(n1 - 0.5))) * smoothstep(0.6, 0.8, k1)
    let n2 = Finish.noise(vec2(w.y * 0.06 - w.x * 0.02, w.x * 0.38 + w.y * 0.07) + vec2(17.0, 5.0))
    let k2 = Finish.noise(w * 0.03 + vec2(1.0, 13.0))
    let f2 = (1.0 - smoothstep(0.0, 0.014, abs(n2 - 0.5))) * smoothstep(0.64, 0.82, k2)
    col = mix(col, col * 0.88, f1 * 0.32)
    col = mix(col, min(col * 1.03 + vec3(0.01, 0.01, 0.008), vec3(1.0, 1.0, 1.0)), f2 * 0.22)
    // the tooth of the skin: a fine streaky noise across the grain
    let tooth = Finish.noise(vec2(w.x * 0.9 + w.y * 0.3, w.y * 0.22 - w.x * 0.08)) - 0.5
    col = col * (1.0 + tooth * 0.022)
    return col + g3(Finish.grain(w / px, 0.010))
}

// A RAISED BRONZE WIRE `w` points wide lying just inside an edge: `d` the
// edge's distance (negative inside), `n` its outward normal. Lit from the
// upper left: the half of the wire that faces the light catches a warm
// highlight, the other half falls toward dark bronze; a dark hairline at
// both of its edges keeps it crisp on any ground. Premultiplied.
let an_wire = fn(d: float, n: vec2, w: float, px: float, glint: float) -> vec4 {
    let u = clamp(-d / max(w, 0.01), 0.0, 1.0)
    let k = 1.0 - 2.0 * u
    let bulge = sqrt(max(1.0 - k * k, 0.0))
    let facing = dot(n * k, vec2(-0.42, -0.91))
    var col = mix(an_bronze_dk(), an_bronze_c(), 0.35 + 0.65 * bulge)
    col = col * (0.80 + 0.32 * facing)
    col = mix(col, an_gold_hi(), smoothstep(0.2, 0.85, facing * 0.8 + 0.3 * bulge) * 0.6 * glint)
    let e = Finish.band(d, 0.0, px, px) + Finish.band(d, w - px, w, px)
    col = mix(col, an_bronze_dk() * 0.75, clamp(e, 0.0, 1.0) * 0.5)
    let a = Finish.band(d, 0.0, w, px)
    return vec4(col * a, a)
}

// A fine gold line `lw` wide at `d` = -`at` (inside an edge): the inner line
// of a frame within a frame.
let an_fine = fn(d: float, at: float, lw: float, px: float, amt: float) -> vec4 {
    let a = Finish.band(d, at, at + lw, px) * amt
    let col = mix(an_line_c(), an_gold_hi(), 0.35)
    return vec4(col * a, a)
}

// The soft shadow a raised part throws on the parchment, straight down and
// a little to the right, in warm sepia. Premultiplied.
let an_drop = fn(p: vec2, c: vec2, h: vec2, r: float, amt: float) -> vec4 {
    let t = Finish.drop(p, c, h, r, vec2(0.3, 0.9), 0.6) * 0.30 * amt
    let s = Finish.drop(p, c, h, r, vec2(0.5, 1.7), 1.5) * 0.14 * amt
    let a = t + s * (1.0 - t)
    return vec4(an_shade() * a, a)
}

// The tight contact shadow of a part with no room round it for the soft
// one: gone a point and a half under its edge.
let an_contact = fn(p: vec2, c: vec2, h: vec2, r: float, amt: float) -> vec4 {
    let a = Finish.drop(p, c, h, r, vec2(0.0, 0.45), 0.3) * 0.28 * amt
    return vec4(an_shade() * a, a)
}

// A FLAT MATTE ENAMEL face inside its cloison (`c`, `h`, `r` the enamel's
// own box): a broad soft light across its upper part, a faint unevenness of
// the paint, and the shade the wire throws into it under the top edge.
// Lifted a shade under the pointer; pressed, it sinks: darker, with the
// wire's shade deeper.
let an_enamel = fn(p: vec2, c: vec2, h: vec2, r: float, base: vec3, hover: float, press: float) -> vec3 {
    let t = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = base * (1.05 - 0.10 * t)
    col = mix(col, Finish.lift(col, 0.10), (1.0 - smoothstep(0.05, 0.6, t)) * 0.55 * (1.0 - press))
    let mott = (Finish.noise(p * 0.7 + vec2(5.0, 1.0)) - 0.5) * 0.022 + (Finish.noise(p * 0.09 + vec2(2.0, 8.0)) - 0.5) * 0.012
    col = col * (1.0 + mott)
    col = Finish.lift(col, 0.15 * hover * (1.0 - press))
    col = mix(col, col * 0.82, press)
    let sh = clamp(Finish.inset(p, c, h, r, vec2(0.0, 0.8 + 1.2 * press), 0.8 + 0.6 * press), 0.0, 1.0)
    col = mix(col, an_shade(), sh * (0.24 + 0.26 * press))
    return col
}

// Focus: a teal ring of a device pixel and a half, two points outside.
let md_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 1.5, 1.5 + 1.5 * px, px) * 0.9 * focus
    let c = vec3(0.184, 0.435, 0.384)
    return vec4(c * f, f)
}

// A SUNK IVORY WELL behind its wire: the fill, the shade falling in under
// the top edge, the bronze wire round it and a light lip on the parchment
// under its foot. `fill` its colour; `wire` the wire's width.
let an_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, shade: float, wire: float, dis: float) -> vec4 {
    let d = md_rbox(p, c, h, r)
    let n = an_nrm(p, c, h, r)
    let hi = h - vec2(wire, wire)
    var col = fill
    let sh = clamp(Finish.inset(p, c, hi, max(r - wire, 0.0), vec2(0.0, 1.4), 1.2), 0.0, 1.0)
    col = mix(col, an_shade(), sh * shade)
    let a = Finish.cover(d, px)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, h.y * 0.8, p.y - c.y) * 0.45
    out = Finish.over(out, vec4(vec3(0.98, 0.95, 0.88) * lip, lip))
    out = Finish.over(out, vec4(col * a, a))
    let wv = an_wire(d, n, wire, px, 1.0 - dis)
    return Finish.over(out, wv * mix(1.0, 0.55, dis))
}

// An indicator jewel set in a cap: used where a stock face carries a lamp.
let md_led = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, lit: float, glow: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let k = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(Finish.lift(ink, 0.25), ink * 0.85, smoothstep(0.2, 1.0, k))
    let off = vec3(0.12, 0.13, 0.11)
    var col = mix(off, on, lit)
    col = mix(col, an_bronze_c(), Finish.band(d, 0.0, max(px, 0.6), px))
    let a = Finish.cover(d, px)
    let ha = glow * lit * exp(-max(d, 0.0) / 0.7) * step(0.0, d) * (1.0 - a)
    var out = vec4(ink * ha, ha)
    return Finish.over(out, vec4(col * a, a))
}

// ---------------------------------------------------------------------------
// THE BOTANICAL ORNAMENT. Every part is a curve, drawn at the device pixel.

// A leaf or a petal: a lens `len` long from its base `b` along the unit
// direction `dir`, `wid` wide either side of its midline at its widest, the
// midline bowed by `bend` points. Returns the signed distance, the side
// across it (-1..1) and the way along it (0..1).
let an_leaf = fn(p: vec2, b: vec2, dir: vec2, len: float, wid: float, bend: float) -> vec4 {
    let q = p - b
    let u = dot(q, dir)
    let t = clamp(u / max(len, 0.01), 0.0, 1.0)
    let v = dot(q, vec2(0.0 - dir.y, dir.x)) - bend * 4.0 * t * (1.0 - t)
    let hw = wid * 4.0 * t * (1.0 - t) * (1.15 - 0.3 * t)
    let slope = wid * 4.0 * (1.0 - 2.0 * t) / max(len, 0.01)
    let dv = (abs(v) - hw) / sqrt(1.0 + slope * slope)
    let du = max(0.0 - u, u - len)
    return vec4(max(dv, du), v / max(hw, 0.3), t, 0.0)
}

// The distance to a quadratic curve from `a` through the pull of `b` to `c`
// (.x), and how far along it the nearest point lies (.y, 0..1).
let an_bez = fn(pos: vec2, A: vec2, B: vec2, C: vec2) -> vec2 {
    let a = B - A
    let b = A - 2.0 * B + C
    let c = a * 2.0
    let d = A - pos
    let kk = 1.0 / max(dot(b, b), 0.0001)
    let kx = kk * dot(a, b)
    let ky = kk * (2.0 * dot(a, a) + dot(d, b)) / 3.0
    let kz = kk * dot(d, a)
    let p = ky - kx * kx
    let p3 = p * p * p
    let q = kx * (2.0 * kx * kx - 3.0 * ky) + kz
    var h = q * q + 4.0 * p3
    var res = 0.0
    var tt = 0.0
    if h >= 0.0 {
        h = sqrt(h)
        let x0 = (h - q) * 0.5
        let x1 = (0.0 - h - q) * 0.5
        let u0 = sign(x0) * pow(abs(x0), 1.0 / 3.0)
        let u1 = sign(x1) * pow(abs(x1), 1.0 / 3.0)
        tt = clamp(u0 + u1 - kx, 0.0, 1.0)
        let e = d + (c + b * tt) * tt
        res = dot(e, e)
    } else {
        let z = sqrt(0.0 - p)
        let v = acos(clamp(q / (p * z * 2.0), -1.0, 1.0)) / 3.0
        let m = cos(v)
        let n = sin(v) * 1.732050808
        let t0 = clamp((m + m) * z - kx, 0.0, 1.0)
        let t1 = clamp((0.0 - n - m) * z - kx, 0.0, 1.0)
        let e0 = d + (c + b * t0) * t0
        let e1 = d + (c + b * t1) * t1
        let r0 = dot(e0, e0)
        let r1 = dot(e1, e1)
        res = min(r0, r1)
        tt = mix(t1, t0, step(r0, r1))
    }
    return vec2(sqrt(res), tt)
}

// An open spiral, a tendril's curl: `pitch` points between its turns,
// `turns` of them out from its eye `c`, its outer end at the angle `rot`.
let an_spiral = fn(p: vec2, c: vec2, pitch: float, turns: float, rot: float) -> float {
    let q = p - c
    let r = length(q)
    var th = atan2(q.y, q.x) - rot
    th = (th - floor(th / (2.0 * PI)) * 2.0 * PI) / (2.0 * PI)
    let k = clamp(floor(r / pitch - th + 0.5), 0.0, turns - 1.0)
    return abs(r - pitch * (th + k))
}

// Lays a filled shape of distance `d` over `dst`: its fill, and a
// bronze-gold outline `lw` points wide inside its edge.
let an_lay = fn(dst: vec4, d: float, fill: vec3, lw: float, px: float) -> vec4 {
    let a = Finish.cover(d, px)
    let l = Finish.band(d, 0.0, lw, px)
    let col = mix(fill, an_line_c(), clamp(l / max(a, 0.001), 0.0, 1.0) * 0.9)
    return Finish.over(dst, vec4(col * a, a))
}

// A leaf laid with its two halves in two greens (the half toward the light
// paler), a gold midrib, a gold outline.
let an_lay_leaf = fn(dst: vec4, l: vec4, dark: vec3, light: vec3, lw: float, px: float) -> vec4 {
    var fill = mix(dark, light, smoothstep(-0.15, 0.15, l.y))
    fill = mix(fill, fill * 0.85, smoothstep(0.6, 1.0, l.z) * 0.4)
    let rib = (1.0 - smoothstep(0.05, 0.16, abs(l.y))) * step(l.z, 0.88) * 0.6
    fill = mix(fill, an_line_c(), rib)
    return an_lay(dst, l.x, fill, lw, px)
}

// A petal: from a dusty rose throat to a cream tip.
let an_lay_petal = fn(dst: vec4, l: vec4, root: vec3, tip: vec3, lw: float, px: float) -> vec4 {
    var fill = mix(root, tip, smoothstep(0.1, 0.75, l.z))
    fill = mix(fill, fill * 0.88, smoothstep(0.2, 1.0, abs(l.y)) * 0.35)
    return an_lay(dst, l.x, fill, lw, px)
}

// A stem: a tapering stroke along a curve, green with gold edges.
let an_lay_stem = fn(dst: vec4, b: vec2, w0: float, w1: float, fill: vec3, px: float) -> vec4 {
    let d = b.x - mix(w0, w1, b.y)
    return an_lay(dst, d, fill, min(0.6, mix(w0, w1, b.y) * 0.5), px)
}

let an_dir = fn(a: float) -> vec2 {
    return vec2(cos(a), sin(a))
}

// A LILY seen from the front: three long petals behind, three shorter ones
// before them, curling back at their tips, a throat of `root` and three
// gold stamens. `s` its size; `rose` 0 for cream and ochre petals, 1 for
// dusty rose ones.
let an_lily = fn(dst: vec4, p: vec2, c: vec2, s: float, rot: float, px: float, rose: float) -> vec4 {
    var out = dst
    let root = mix(vec3(0.788, 0.553, 0.478), vec3(0.62, 0.40, 0.44), rose)
    let tip = mix(vec3(0.965, 0.886, 0.690), vec3(0.88, 0.70, 0.68), rose)
    let fr = mix(vec3(0.925, 0.733, 0.420), vec3(0.80, 0.55, 0.54), rose)
    let lw = max(0.45, s * 0.045)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot), s, s * 0.26, s * 0.10), root, tip, lw, px)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot + 2.094), s, s * 0.26, s * 0.10), root, tip, lw, px)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot + 4.189), s, s * 0.26, s * 0.10), root, tip, lw, px)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot + 1.047), s * 0.82, s * 0.24, 0.0 - s * 0.08), root, fr, lw, px)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot + 3.142), s * 0.82, s * 0.24, 0.0 - s * 0.08), root, fr, lw, px)
    out = an_lay_petal(out, an_leaf(p, c, an_dir(rot + 5.236), s * 0.82, s * 0.24, 0.0 - s * 0.08), root, fr, lw, px)
    // the stamens
    var st = 1000.0
    st = min(st, md_seg(p, c, c + an_dir(rot + 0.5) * s * 0.58))
    st = min(st, md_seg(p, c, c + an_dir(rot + 2.6) * s * 0.58))
    st = min(st, md_seg(p, c, c + an_dir(rot + 4.7) * s * 0.58))
    let sa = Finish.cover(st - max(0.3, s * 0.02), px)
    out = Finish.over(out, vec4(an_line_c() * sa, sa))
    var dots = 1000.0
    dots = min(dots, length(p - (c + an_dir(rot + 0.5) * s * 0.58)))
    dots = min(dots, length(p - (c + an_dir(rot + 2.6) * s * 0.58)))
    dots = min(dots, length(p - (c + an_dir(rot + 4.7) * s * 0.58)))
    out = an_lay(out, dots - max(0.6, s * 0.06), vec3(0.50, 0.27, 0.15), 0.0, px)
    out = an_lay(out, length(p - c) - s * 0.11, vec3(0.70, 0.50, 0.22), lw, px)
    return out
}

// A BUD: a closed petal in its two green sepals, on the end of a stem.
let an_bud = fn(dst: vec4, p: vec2, b: vec2, dir: vec2, s: float, px: float) -> vec4 {
    var out = dst
    let lw = max(0.45, s * 0.06)
    out = an_lay_petal(out, an_leaf(p, b, dir, s, s * 0.30, 0.0), vec3(0.80, 0.55, 0.45), vec3(0.95, 0.80, 0.55), lw, px)
    let side = vec2(0.0 - dir.y, dir.x)
    out = an_lay_leaf(out, an_leaf(p, b, normalize(dir + side * 0.35), s * 0.55, s * 0.12, 0.0), vec3(0.24, 0.38, 0.32), vec3(0.42, 0.58, 0.48), lw, px)
    out = an_lay_leaf(out, an_leaf(p, b, normalize(dir - side * 0.35), s * 0.55, s * 0.12, 0.0), vec3(0.24, 0.38, 0.32), vec3(0.42, 0.58, 0.48), lw, px)
    return out
}

// A SPRIG for a surface's corner, in the corner's own frame: `p` in points
// from the corner along its two edges, both into the surface. It is drawn
// the same about the corner's diagonal, so it sits in any of the four: a
// whiplash stem bowed round the corner like a bracket, curling at both of
// its ends, a leaf on each arm, a larger pair at the corner and an ochre bud
// between them. `s` scales it (1 is about 38 points along each edge).
let an_sprig = fn(dst: vec4, p: vec2, s: float, px: float) -> vec4 {
    var out = dst
    let q = p / s
    let pxs = px / s
    let dk = vec3(0.220, 0.357, 0.306)
    let lt = vec3(0.427, 0.580, 0.494)
    let stem = vec3(0.290, 0.420, 0.357)
    // fold onto one side of the diagonal for the mirrored arms
    let m = vec2(min(q.x, q.y), max(q.x, q.y))
    out = an_lay(out, an_spiral(m, vec2(4.6, 33.0), 1.5, 2.0, 0.0 - 1.4) - 0.42, stem, 0.25, pxs)
    out = an_lay_stem(out, an_bez(m, vec2(3.0, 4.0), vec2(1.5, 18.0), vec2(5.1, 30.0)), 1.0, 0.45, stem, pxs)
    out = an_lay_leaf(out, an_leaf(m, vec2(2.6, 15.0), normalize(vec2(1.0, 0.55)), 11.0, 2.4, 1.2), dk, lt, 0.38, pxs)
    out = an_lay_leaf(out, an_leaf(q, vec2(3.0, 3.0), normalize(vec2(1.0, 0.45)), 16.0, 3.2, 2.2), dk, lt, 0.4, pxs)
    out = an_lay_leaf(out, an_leaf(q, vec2(3.0, 3.0), normalize(vec2(0.45, 1.0)), 16.0, 3.2, -2.2), dk, lt, 0.4, pxs)
    out = an_bud(out, q, vec2(3.5, 3.5), normalize(vec2(1.0, 1.0)), 11.0, pxs)
    return out
}

// The sprig set into a box's corner `k` (0 top left, 1 top right, 2 bottom
// right, 3 bottom left), `ins` points in from its edges.
let an_corner = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, k: float, ins: float, s: float, px: float) -> vec4 {
    let right = step(0.5, k) * step(k, 2.5)
    let bottom = step(1.5, k)
    let x = mix(p.x - lo.x, hi.x - p.x, right) - ins
    let y = mix(p.y - lo.y, hi.y - p.y, bottom) - ins
    if x > -2.0 && y > -2.0 && x < 42.0 * s && y < 42.0 * s {
        return an_sprig(dst, vec2(x, y), s, px)
    }
    return dst
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family: an enamel pill in its bronze wire, a
// fine gold line inside the wire on the filled ones, a soft sepia shadow
// under it. `kind`: 0 teal enamel, 1 ochre (primary), 2 a peacock teal
// (secondary), 3 pale sage (tertiary), 4 terracotta (danger), 5 the outline
// (the parchment shows, a bronze wire and a teal line inside it), 6 bare
// until touched (flatter), 7 an ivory pill (the plain button). Pressed, the
// enamel sinks; the quad is grown by `m` for the shadow and the focus ring.
let an_kind_c = fn(kind: float) -> vec3 {
    var c = an_teal()
    c = mix(c, an_ochre(), step(0.5, kind) * step(kind, 1.5))
    c = mix(c, vec3(0.224, 0.400, 0.420), step(1.5, kind) * step(kind, 2.5))
    c = mix(c, an_sage(), step(2.5, kind) * step(kind, 3.5))
    c = mix(c, an_terra(), step(3.5, kind) * step(kind, 4.5))
    c = mix(c, vec3(0.906, 0.851, 0.737), step(4.5, kind))
    return c
}
let an_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, r4: vec4, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = md_r4(p, c, h, r4)
    let d = md_rbox(p, c, h, r)
    let n = an_nrm(p, c, h, r)
    let wire = 1.6
    let outline = step(4.5, kind) * step(kind, 5.5)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let show = mix(1.0, clamp(hover * live * 0.8 + press, 0.0, 1.0), bare)
    var out = an_drop(p, c, h, r, (1.0 - 0.65 * press) * mix(1.0, 0.45, dis) * (1.0 - outline) * show)
    var base = an_kind_c(kind)
    base = mix(base, mix(base, vec3(0.70, 0.69, 0.60), 0.62) * 1.08, dis)
    let hf = h - vec2(wire, wire)
    var face = an_enamel(p, c, hf, max(r - wire, 0.0), base, hover * live, press)
    let fa = Finish.cover(d + wire * 0.5, px) * (1.0 - outline * (1.0 - max(press * 0.5, hover * live * 0.35)))
    out = Finish.over(out, vec4(face * fa, fa) * show)
    // the fine line inside the wire, on the filled enamels
    let filled = 1.0 - step(4.5, kind)
    out = Finish.over(out, an_fine(d, wire + 1.2, max(px, 0.55), px, 0.55 * filled * mix(1.0, 0.4, dis)))
    // the outline's teal line inside the wire
    let tl = Finish.band(d, wire + 0.8, wire + 0.8 + max(px, 0.6), px) * outline * mix(0.85, 0.4, dis)
    out = Finish.over(out, vec4(an_teal_dk() * tl, tl))
    let wv = an_wire(d, n, wire, px, mix(1.0, 0.3, dis) * (1.0 + 0.4 * hover * live))
    out = Finish.over(out, wv * mix(1.0, 0.55, dis) * show)
    out = Finish.over(out, md_focus(d, px, focus * live))
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        sdf.fill(vec4(0.165, 0.129, 0.086, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// Every button template: the plain root (and the sizes, which share its draw
// object) wears the ivory pill; the roles are specialised below.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(an_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 99.0), 7.0, 8.0), 8.0)
}
