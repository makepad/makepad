// ---------------------------------------------------------------------------
// THE WINDOW'S GROUND. Parchment, held in a frame of teal enamel bands edged
// with bronze-gold wire: a band along the top where the window's caption
// stands, with a parchment cartouche under the title and lily sprays in its
// two ends; a header of parchment under it where the catalogue's toolbar
// stands; a band under the header; the panes' parchment; and a band round
// the window's other three edges. Between the panes the splitters draw the
// same band. The heavy detail is all on the bands and in the corners; the
// panes are calm, only the faint mottle and the fibre.

// A lily spray along the top band, in the band's own frame: x along it from
// its anchor, y down from the window's top edge, about 250 points long. A
// whiplash stem in two arcs ending in a tendril's curl; a second stem with a
// bud on it; a short one carrying a small dusty rose lily; leaves along
// them, turned up and down by turns; a large lily at its root.
let an_band_spray = fn(dst: vec4, q: vec2, px: float) -> vec4 {
    var out = dst
    if q.x > 262.0 {
        return out
    }
    let dk = vec3(0.420, 0.580, 0.486)
    let lt = vec3(0.616, 0.737, 0.627)
    let stem = vec3(0.500, 0.650, 0.560)
    // the curl and the two arcs of the whiplash
    out = an_lay(out, an_spiral(q, vec2(246.0, 12.0), 2.2, 2.0, PI) - 0.6, stem, 0.35, px)
    out = an_lay_stem(out, an_bez(q, vec2(2.0, 29.0), vec2(46.0, 0.0), vec2(118.0, 15.0)), 1.7, 1.1, stem, px)
    out = an_lay_stem(out, an_bez(q, vec2(118.0, 15.0), vec2(190.0, 30.0), vec2(241.6, 12.0)), 1.1, 0.6, stem, px)
    // the second stem and its bud; the short stem with the rose lily
    out = an_lay_stem(out, an_bez(q, vec2(58.0, 11.0), vec2(90.0, 31.0), vec2(150.0, 26.0)), 1.0, 0.6, stem, px)
    out = an_lay_stem(out, an_bez(q, vec2(146.0, 21.5), vec2(156.0, 9.0), vec2(174.0, 12.0)), 0.9, 0.6, stem, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(28.0, 15.0), normalize(vec2(1.0, -0.42)), 21.0, 4.0, -1.8), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(66.0, 8.5), normalize(vec2(1.0, 0.45)), 19.0, 3.6, 1.8), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(96.0, 13.0), normalize(vec2(1.0, -0.55)), 16.0, 3.0, -1.4), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(104.0, 25.5), normalize(vec2(1.0, 0.15)), 15.0, 2.8, 1.2), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(136.0, 20.5), normalize(vec2(1.0, 0.42)), 17.0, 3.2, 1.6), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(196.0, 23.5), normalize(vec2(1.0, -0.62)), 16.0, 3.0, -1.4), dk, lt, 0.5, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(214.0, 20.0), normalize(vec2(1.0, 0.5)), 12.0, 2.4, 1.0), dk, lt, 0.45, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(8.0, 23.0), normalize(vec2(0.6, 1.0)), 9.0, 2.6, 1.0), dk, lt, 0.5, px)
    out = an_bud(out, q, vec2(150.0, 26.0), normalize(vec2(1.0, -0.1)), 9.0, px)
    out = an_lily(out, q, vec2(175.0, 12.5), 8.5, 0.7, px, 1.0)
    out = an_lily(out, q, vec2(16.0, 15.5), 13.0, 0.4, px, 0.0)
    return out
}

// The small ornament in a bottom corner of the window, `q` in points from
// the corner along its two edges: a tendril's curl in the spandrel the
// panes' rounded corner leaves, a leaf running out along each edge from it
// and a gold bud on the diagonal. Nothing of it reaches the pane's hole.
let an_foot_corner = fn(dst: vec4, q: vec2, px: float) -> vec4 {
    var out = dst
    let dk = vec3(0.420, 0.580, 0.486)
    let lt = vec3(0.616, 0.737, 0.627)
    let stem = vec3(0.500, 0.650, 0.560)
    out = an_lay_leaf(out, an_leaf(q, vec2(9.0, 3.0), vec2(1.0, 0.0), 30.0, 1.6, -0.5), dk, lt, 0.4, px)
    out = an_lay_leaf(out, an_leaf(q, vec2(3.0, 9.0), vec2(0.0, 1.0), 30.0, 1.6, 0.5), dk, lt, 0.4, px)
    out = an_lay(out, an_spiral(q, vec2(9.6, 9.6), 1.35, 2.0, PI * 1.25) - 0.45, stem, 0.3, px)
    out = an_lay(out, length(q - vec2(4.6, 4.6)) - 1.5, mix(an_bronze_c(), an_gold_hi(), 0.5), 0.35, px)
    return out
}

mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let W = self.rect_size.x
    let H = self.rect_size.y
    var col = an_parch(p, px, an_parch_c())
    // the two holes in the frame: the header and the panes
    let hc = vec2(W * 0.5, 60.0)
    let hh = vec2(W * 0.5 - 6.0, 27.0)
    let pc = vec2(W * 0.5, (95.0 + H - 6.0) * 0.5)
    let ph = vec2(W * 0.5 - 6.0, (H - 6.0 - 95.0) * 0.5)
    let dh = md_rbox(p, hc, hh, 14.0)
    // the panes' outer foot corners are wider arches: in the spandrels
    // they leave the frame carries its foot ornaments
    let pr = md_r4(p, pc, ph, vec4(12.0, 12.0, 26.0, 26.0))
    let dp = md_rbox(p, pc, ph, pr)
    var dhole = dp
    var nh = an_nrm(p, pc, ph, pr)
    if dh < dp {
        dhole = dh
        nh = an_nrm(p, hc, hh, 14.0)
    }
    // the header is a lighter leaf of parchment
    col = mix(col, Finish.lift(col, 0.12), Finish.cover(dh, px))
    // the parchment is aged toward the frame: a warm browning that fades
    // out some thirty points in, never a stain in the middle
    let age = 1.0 - smoothstep(0.0, 34.0, 0.0 - dhole)
    col = mix(col, col * vec3(0.84, 0.77, 0.66), age * age * 0.55)
    // the frame's shade on the parchment along each hole's upper and left
    // edges, three points deep
    let sh = (1.0 - smoothstep(0.0, 3.5, 0.0 - dhole)) * Finish.cover(dhole, px) * (0.5 + 0.5 * clamp(0.0 - nh.y - nh.x * 0.5, 0.0, 1.0))
    col = mix(col, col * 0.80, sh * 0.6)
    // the teal bands
    let band = Finish.cover(0.0 - dhole, px)
    var teal = an_teal() * (1.0 + (Finish.noise(p * 0.11) - 0.5) * 0.05) + g3(Finish.grain(p / px, 0.008))
    teal = mix(teal, teal * 1.12, (1.0 - smoothstep(0.0, 33.0, p.y)) * 0.4)
    col = mix(col, teal, band)
    // the window's outer edge: a darker teal lip and a bronze wire
    let dw = md_rbox(p, vec2(W, H) * 0.5, vec2(W, H) * 0.5, 0.0)
    let nw = an_nrm(p, vec2(W, H) * 0.5, vec2(W, H) * 0.5, 0.0)
    var out = vec4(col, 1.0)
    // THE CARTOUCHE under the title, and its whiplash scrolls
    let cc = vec2(W * 0.5, 16.0)
    let ch = vec2(84.0, 12.5)
    let cd = md_rbox(p, cc, ch, 12.5)
    if abs(p.x - cc.x) < 140.0 && p.y < 35.0 {
        let cw = an_parch(p, px, vec3(0.925, 0.878, 0.776))
        out = an_lay(out, cd, cw, 0.0, px)
        out = Finish.over(out, an_fine(cd, 2.6, max(px, 0.6), px, 0.7))
        out = Finish.over(out, an_wire(cd, an_nrm(p, cc, ch, 12.5), 1.5, px, 1.0))
        let sx = abs(p.x - cc.x)
        let sq = vec2(sx, p.y)
        out = an_lay(out, an_spiral(sq, vec2(ch.x + 22.0, 13.0), 2.0, 2.0, 2.6) - 0.7, mix(an_bronze_c(), an_gold_hi(), 0.3), 0.0, px)
        out = an_lay_stem(out, an_bez(sq, vec2(ch.x - 2.0, 25.0), vec2(ch.x + 14.0, 30.0), vec2(ch.x + 18.6, 15.1)), 1.0, 0.6, mix(an_bronze_c(), an_gold_hi(), 0.3), px)
    }
    // THE SPRAYS in the top band's two ends, kept clear of the cartouche
    if p.y < 35.0 && p.x < min(270.0, W * 0.5 - 122.0) {
        out = an_band_spray(out, vec2(p.x - 6.0, p.y), px)
    }
    if p.y < 35.0 && p.x > max(W - 410.0, W * 0.5 + 122.0) && p.x < W - 138.0 {
        out = an_band_spray(out, vec2(W - 138.0 - p.x, p.y), px)
    }
    // the foot corners
    if p.y > H - 40.0 && (p.x < 40.0 || p.x > W - 40.0) {
        out = an_foot_corner(out, vec2(min(p.x, W - p.x), H - p.y), px)
    }
    // the bronze wire along every hole's edge, on the band's side
    out = Finish.over(out, an_wire(0.0 - dhole, nh * -1.0, 1.5, px, 1.0))
    out = Finish.over(out, an_fine(0.0 - dhole, 2.6, max(px, 0.5), px, 0.35 * step(39.0, p.y)))
    out = Finish.over(out, an_wire(dw, nw, 1.6, px, 1.0))
    return vec4(out.rgb, 1.0)
}

// A splitter is the frame's teal band run down between two panes, ten
// points wide, its bronze wires turning into the header's band above and
// the foot band below with rounded corners, as the panes' corners are.
mod.widgets.Splitter.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 14.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 14.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let v = self.is_vertical
    // work in the bar's own frame: `a` along it, `b` across it
    let a = mix(p.x, p.y, v)
    let b = mix(p.y, p.x, v)
    let along = mix(size.x, size.y, v)
    let thick = mix(size.y, size.x, v)
    let mid = thick * 0.5
    let hw = 5.0
    let r = 12.0
    let a0 = 4.0
    let a1 = along - 6.0
    // the panes either side, as rounded boxes
    let q = vec2(b, a)
    let lc = vec2(mid - hw - 200.0, (a0 + a1) * 0.5)
    let rc = vec2(mid + hw + 200.0, (a0 + a1) * 0.5)
    let ph = vec2(200.0, (a1 - a0) * 0.5)
    let dl = md_rbox(q, lc, ph, r)
    let dr = md_rbox(q, rc, ph, r)
    var dh = dl
    var nh = an_nrm(q, lc, ph, r)
    if dr < dl {
        dh = dr
        nh = an_nrm(q, rc, ph, r)
    }
    // the header above: everything before -4 along the bar
    let dt = a + 4.0
    if dt < dh {
        dh = dt
        nh = vec2(0.0, 1.0)
    }
    let inside = step(-8.0, a) * step(a, along - 1.6) * step(abs(b - mid), hw + r + 0.5)
    let band = Finish.cover(0.0 - dh, px) * inside
    var teal = an_teal() * (1.0 + (Finish.noise((p + self.rect_pos) * 0.11) - 0.5) * 0.05)
    let act = max(max(self.hover, self.drag), self.focus)
    teal = Finish.lift(teal, 0.08 * act)
    var out = vec4(teal * band, band)
    let nn = vec2(mix(nh.y, nh.x, v), mix(nh.x, nh.y, v))
    out = Finish.over(out, an_wire(0.0 - dh, nn * -1.0, 1.5, px, 1.0) * inside)
    // under the hand, a gold line down the middle of the grip
    let inbar = 1.0 - smoothstep(self.bar_size * 0.5 - 2.0, self.bar_size * 0.5, abs(a - along * 0.5))
    let gl = (1.0 - smoothstep(0.5, 0.5 + px, abs(b - mid))) * inbar * act
    out = Finish.over(out, vec4(an_gold_hi() * gl, gl))
    return out
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES are the sheet's own toggle: the rocker carries a bronze disc
// (the metal of a lever), the slide switch the ivory one, both riding in the
// sunk pill, teal when on.
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.draw_bg.size = 14.0
mod.widgets.ToggleSlide.draw_bg.size = 14.0
mod.widgets.ToggleRocker.min_height = 24.0
mod.widgets.ToggleSlide.min_height = 24.0
mod.widgets.ToggleRocker.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleSlide.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleRocker.draw_bg.knob_inset = 7.0
mod.widgets.ToggleSlide.draw_bg.knob_inset = 7.0
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return an_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 1.0)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return an_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 0.0)
}

// THE GLASS of the readouts, the screen and the meter: deep teal glass with
// the faint unevenness of cathedral glass and a soft sheen across its upper
// left, set behind a bronze wire, a dark gap and a fine gold line, its
// corners rounded; the surround's shade falls in under its top edge.
let an_glass = fn(p: vec2, lo: vec2, hi: vec2, r4: vec4, px: float, face: vec3) -> vec4 {
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = md_r4(p, c, h, r4)
    let d = md_rbox(p, c, h, r)
    var out = an_drop(p, c, h, r, 0.8)
    let hf = h - vec2(1.8, 1.8)
    var g = face * (1.0 + (Finish.noise(p * 0.21 + vec2(4.0, 9.0)) - 0.5) * 0.035 + (Finish.noise(p * 0.6) - 0.5) * 0.025)
    let u = (p - lo) / max(hi - lo, vec2(1.0, 1.0))
    let diag = u.x * 0.8 + u.y
    let sheen = smoothstep(0.0, 0.25, diag) * (1.0 - smoothstep(0.35, 0.75, diag)) * 0.06
    g = g + vec3(0.95, 0.92, 0.80) * sheen
    g = mix(g, vec3(0.03, 0.05, 0.04), clamp(Finish.inset(p, c, hf, max(r - 1.8, 0.0), vec2(0.0, 2.2), 2.0), 0.0, 1.0) * 0.55)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(g * a, a))
    out = Finish.over(out, an_fine(d, 3.0, max(px, 0.55), px, 0.5))
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.8, px, 1.0))
}

mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.padding = mod.turtle.Inset{top: 8.0 right: 11.0 bottom: 8.0 left: 11.0}
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    return an_glass(p, lo, hi, vec4(9.0, 9.0, 9.0, 9.0), px, self.color.rgb)
}
mod.widgets.ScreenView.bezel = 3.0
mod.widgets.ScreenView.sheen = 0.02

// THE METER sits in the same glass: its window arched at the top, the scale
// a fine gold arc with gold ticks, the colour band under it running sage to
// ochre to terracotta, the needle an ivory spear and its pivot a bronze boss.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(9.0)
mod.widgets.NeedleMeter.draw_bg.color = uniform(#213530)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#xf3e8cf)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#xd0603f)
mod.widgets.NeedleMeter.draw_bg.color_scale = uniform(#xe6c47e)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let r = min(self.border_radius, min(hi.x - lo.x, hi.y - lo.y) * 0.5)
    let rt = min(34.0, min(hi.x - lo.x, hi.y - lo.y) * 0.45)
    var out = an_glass(p, lo, hi, vec4(rt, rt, r, r), px, an_glass_c())
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let rq = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let inside = Finish.cover(md_rbox4(p, (lo + hi) * 0.5, (hi - lo) * 0.5 - vec2(2.0, 2.0), vec4(rt - 2.0, rt - 2.0, r - 2.0, r - 2.0)), px)
    // the colour band under the scale
    let bandr = Finish.cover(abs(rq - (rr - 2.6)) - 1.6, px) * on_scale
    let ramp = mix(mix(vec3(0.47, 0.66, 0.53), vec3(0.88, 0.68, 0.33), smoothstep(0.35, 0.7, t)), self.color_zone.rgb, step(self.zone, t))
    let ba = bandr * 0.85 * inside
    out = Finish.over(out, vec4(ramp * ba, ba))
    // the scale: a hairline arc and a tick at every division
    let arc = Finish.cover(abs(rq - rr) - px * 0.6, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - rq, rq - rr)
    let tick = Finish.cover(perp - px * mix(0.55, 0.9, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    let sa = max(arc, tick) * inside
    out = Finish.over(out, vec4(self.color_scale.rgb * sa, sa))
    // the needle: a slim spear from under the pivot to just past the scale
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let sp = an_leaf(p, pv - nd * 3.0, nd, rr + 6.0, 1.4, 0.0)
    let nf = mix(self.color_needle.rgb, an_gold_hi(), smoothstep(0.3, 1.0, sp.z) * 0.3)
    out = an_lay(out, sp.x, nf * inside + self.color_needle.rgb * (1.0 - inside), 0.4, px)
    let pd = rq - self.pivot_size - 0.8
    let bl = clamp(0.5 - 0.6 * dot(q / max(self.pivot_size, 1.0), vec2(0.45, 0.85)), 0.0, 1.0)
    out = an_lay(out, pd, mix(an_bronze_dk(), an_gold_hi(), bl), 0.5, px)
    return out * self.color.a * self.opacity
}
mod.widgets.NeedleMeter.draw_label.color = #xe6c47e

// ---------------------------------------------------------------- lamps
// LAMPS: jewels of coloured glass, cabochons in polished bronze settings, as
// the stained glass of the period. The emitter is the light: at full current
// its middle burns toward white and its rim is its most saturated colour; at
// lower current the middle is no longer white, the colour deeper, the glow
// smaller; out, it is dark tinted glass, its colour barely there. Its light
// is added, never painted: a tight hot halo and a short bloom in its own
// hue, gone in about two radii; on the pale parchment its hue is also laid
// round it as a tint that keeps the ground's luminance. A bar is the same
// light drawn out into a short light pipe.
let md_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(0.0 - light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let md_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
let md_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = md_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
let md_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.32 * rt, 0.8, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = md_led_lamp_full(ink)
    let hue = md_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // the setting's shadow on the parchment
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.15, 0.12 * rt + 0.3), 0.10 * rt + 0.5) * 0.32 * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(an_shade() * shd, shd))
    if L > 0.001 {
        // the tint on the pale ground: its hue laid over, never darker
        let h = clamp(0.42 * pw * pow(2.0, 0.0 - x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45)
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // the bronze setting: a polished ring rounded over, lit from the upper
    // left, a dark seat line where it holds the stone
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    var rc = an_bronze_c() * (0.92 + 0.45 * facing)
    rc = mix(rc, an_gold_hi(), smoothstep(0.5, 0.95, facing) * 0.75)
    rc = mix(rc, an_bronze_dk(), Finish.band(ds, 0.0, max(px, 0.45), px) * 0.7)
    rc = mix(rc, an_bronze_dk() * 0.6, Finish.ring_out(d, 0.0, max(px, 0.45), px) * 0.8)
    res = Finish.over(res, vec4(min(rc, white) * a_s, a_s))
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(0.0 - xl / max(0.30 * rt, 0.4)) * 1.5 + exp(0.0 - xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = md_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE STONE: a glossy cabochon of coloured glass, deeper at the top,
    // light pooling low inside; lit, its middle burns toward white at full
    // current and its rim is its most saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(0.0 - (q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(0.0 - t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // out: dark tinted glass, its colour barely there, a catch light along
    // its lower rim
    let offc = mix(vec3(0.075, 0.08, 0.07), b * 0.42, 0.24)
    var off = mix(offc * 0.62, offc * 1.15, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.28, 0.24) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp. A round jewel takes the middle of its
// cell; its halo's room is held in the cell (the library reserves a lens
// thickness either side once a halo is asked for), so the light is never cut
// at its edge and fades within half the gap. A bar is a short light pipe set
// at the left of its cell, six points thick and twice that long, its glow
// held to two and a half points round its setting -- the whole lamp takes
// the first twenty points of its cell and leaves the rest free.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.size = 14.0
mod.widgets.Lamp.halo_reach = 0.3
mod.widgets.LampBar.size = 14.0
mod.widgets.LampBar.halo_reach = 0.3
mod.widgets.Lamp.draw_bg.color_accent = uniform(#xffa83a)
mod.widgets.Lamp.draw_bg.color_success = uniform(#x34c79c)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#xf2c443)
mod.widgets.Lamp.draw_bg.color_error = uniform(#xe5483a)
mod.widgets.Lamp.draw_bg.color_plain = uniform(#xfff3d8)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = min(self.rect_size.y / (1.0 + 2.0 * reach), 14.0)
    let room = (self.rect_size.y - t) * 0.5
    let tb = min(t, 6.0)
    let lb = 14.0
    let c = mix(self.rect_size * 0.5, vec2(1.6 + lb * 0.5, self.rect_size.y * 0.5), self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(lb * 0.5, tb * 0.5), self.bar)
    let glow = mix(max(room - 2.5, 2.0), 2.2, self.bar)
    let res = md_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, an_parch_c(), glow)
    return res * self.opacity
}
true
