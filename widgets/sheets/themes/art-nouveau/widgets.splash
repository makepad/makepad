// ---------------------------------------------------------------------------
// SLIDERS. A fine bronze channel: a 4 point groove behind its wire, dark
// parchment where it is empty and teal enamel where the value fills it. The
// thumb is a bronze coin with a teal leaf on its face, riding with its own
// shadow. Every slider's quad grows six points for the coin, its shadow and
// the focus ring.
let an_coin = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    var out = an_drop(p, c, vec2(rad, rad), rad, (1.0 - 0.5 * press) * mix(1.0, 0.4, dis))
    let q = p - c
    let d = length(q) - rad
    let n = q / max(length(q), 0.001)
    let rr = clamp(length(q) / rad, 0.0, 1.0)
    // the coin's face: a polished dome, light from the upper left
    let lit = clamp(0.5 - 0.6 * dot(q / rad, vec2(0.45, 0.85)), 0.0, 1.0)
    var face = mix(an_bronze_dk(), an_bronze_c(), 0.45 + 0.55 * lit)
    face = mix(face, an_gold_hi(), smoothstep(0.55, 1.0, lit) * 0.55)
    face = Finish.lift(face, 0.14 * hover * live * (1.0 - press))
    face = mix(face, face * 0.88, press)
    face = mix(face, mix(face, vec3(0.75, 0.72, 0.64), 0.55), dis)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    // an engraved ring a little inside the rim
    let ring = Finish.band(d, rad * 0.24, rad * 0.24 + max(px, 0.5), px)
    out = Finish.over(out, vec4(an_bronze_dk() * ring * 0.8, ring * 0.8))
    let ringl = Finish.band(d, rad * 0.24 + max(px, 0.5), rad * 0.24 + 2.0 * max(px, 0.5), px) * 0.6
    out = Finish.over(out, vec4(an_gold_hi() * ringl, ringl))
    // the leaf on its face
    let lf = an_leaf(p, c + vec2(-0.42, 0.42) * rad * 0.62, normalize(vec2(1.0, -1.0)), rad * 1.24, rad * 0.30, rad * 0.10)
    out = an_lay_leaf(out, lf, mix(vec3(0.16, 0.30, 0.25), vec3(0.5, 0.5, 0.45), dis), mix(vec3(0.33, 0.52, 0.44), vec3(0.6, 0.6, 0.55), dis), 0.35, px)
    out = Finish.over(out, an_wire(d, n, max(1.0, rad * 0.16), px, live))
    return out
}

let an_groove = fn(p: vec2, c: vec2, h: vec2, px: float, f0: float, f1: float, dis: float, hover: float) -> vec4 {
    let r = h.y
    let d = md_rbox(p, c, h, r)
    var empty = mix(vec3(0.765, 0.682, 0.541), vec3(0.80, 0.74, 0.62), dis)
    empty = Finish.lift(empty, 0.08 * hover)
    var out = an_well(p, c, h, r, px, empty, 0.4, 1.0, dis)
    let fh = vec2(max((f1 - f0) * 0.5, 0.0), h.y - 1.0)
    let fc = vec2((f0 + f1) * 0.5, c.y)
    let fd = md_rbox(p, fc, fh, fh.y)
    let fcol = an_enamel(p, fc, fh, fh.y, mix(an_teal_lt(), vec3(0.66, 0.67, 0.60), dis), hover, 0.0)
    let fa = Finish.cover(fd, px) * step(0.01, f1 - f0) * Finish.cover(d + 1.0, px)
    return Finish.over(out, vec4(fcol * fa, fa))
}

mod.widgets.SliderFlat.height = 32.0
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 8.0, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let w = x1 - x0
    let span = w - 18.0
    let kx = x0 + 9.0 + self.slide_pos * span
    let ox = x0 + 9.0 + self.origin_pos * span
    let f0 = mix(x0 + 2.0, min(ox, kx), self.arc_origin)
    let f1 = mix(kx, max(ox, kx), self.arc_origin)
    var out = an_groove(p, vec2((x0 + x1) * 0.5, cy), vec2(w * 0.5, 2.5), px, f0, f1, self.disabled, max(self.hover, self.drag) * live)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    out = Finish.over(out, an_coin(p, kc, 7.5, px, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, md_focus(length(p - kc) - 7.5, px, self.focus * live))
}
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}

// The range slider: the same channel, teal between the two ends, a round
// coin on each end, pressed while it is the one held.
mod.widgets.RangeSliderFlat.handle_size = 16.0
mod.widgets.RangeSliderFlat.track_inset = 1.0
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let top = self.label_px
    let cy = Finish.snap(o.y + top + (size.y - top) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let w = x1 - x0
    let span = max(size.x - self.inset_px * 2.0 - self.handle_px, 1.0)
    let sx = self.inset_px + self.handle_px * 0.5 + self.start_pos * span
    let ex = self.inset_px + self.handle_px * 0.5 + self.end_pos * span
    var out = an_groove(p, vec2((x0 + x1) * 0.5, cy), vec2(w * 0.5, 2.5), px, sx, ex, self.disabled, max(self.hover, self.drag) * live)
    let k0 = vec2(Finish.snap(o.x + sx, px) - o.x, cy)
    let k1 = vec2(Finish.snap(o.x + ex, px) - o.x, cy)
    out = Finish.over(out, an_coin(p, k0, 7.0, px, max(self.hot_start, self.focus * 0.5) * live, self.drag * self.hot_start * live, self.disabled))
    out = Finish.over(out, an_coin(p, k1, 7.0, px, max(self.hot_end, self.focus * 0.5) * live, self.drag * self.hot_end * live, self.disabled))
    return out
}

// The minimal slider: a bronze hairline (a dark device pixel over a gold
// one), a teal thread along it to the thumb, and a bronze drop riding on
// it, its point upward, a teal jewel in its round.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 6.0, px) - o.y
    let kr = 5.0
    let kx = kr + self.slide_pos * (size.x - 2.0 * kr)
    let inx = step(0.0, p.x) * step(p.x, size.x)
    let dark = step(cy - px, p.y) * step(p.y, cy) * inx
    let light = step(cy, p.y) * step(p.y, cy + px) * inx
    let thread = step(cy - 2.0 * px, p.y) * step(p.y, cy + px) * step(p.x, kx) * inx
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let la = light * 0.8
    out = Finish.over(out, vec4(an_gold_hi() * la, la))
    let da = dark * 0.85 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(an_bronze_dk() * da, da))
    let tcol = mix(an_teal(), vec3(0.66, 0.67, 0.60), self.disabled)
    out = Finish.over(out, vec4(tcol * thread, thread))
    // the drop: a round body on the line, a point rising from it
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    let q = p - kc
    let body = length(q) - kr
    let ty = q.y + kr * 1.9
    let cone = max((abs(q.x) - ty * 0.618) * 0.851, 0.0 - ty)
    let dd = min(body, max(cone, q.y))
    let press = self.drag * live
    out = Finish.over(out, an_drop(p, kc, vec2(kr, kr), kr, (1.0 - 0.5 * press) * mix(1.0, 0.4, self.disabled)))
    let lit = clamp(0.5 - 0.6 * dot(q / (kr * 1.6), vec2(0.45, 0.85)), 0.0, 1.0)
    var face = mix(an_bronze_dk(), an_bronze_c(), 0.45 + 0.55 * lit)
    face = mix(face, an_gold_hi(), smoothstep(0.55, 1.0, lit) * 0.55)
    face = Finish.lift(face, 0.14 * self.hover * live * (1.0 - press))
    face = mix(face, mix(face, vec3(0.75, 0.72, 0.64), 0.55), self.disabled)
    let a = Finish.cover(dd, px)
    out = Finish.over(out, vec4(face * a, a))
    let e = Finish.band(dd, 0.0, max(px, 0.55), px)
    out = Finish.over(out, vec4(an_bronze_dk() * e * 0.85, e * 0.85))
    let jd = length(q - vec2(0.0, 0.3)) - kr * 0.45
    out = an_lay(out, jd, mix(vec3(0.26, 0.52, 0.45), vec3(0.6, 0.6, 0.55), self.disabled), 0.35, px)
    return Finish.over(out, md_focus(body, px, self.focus * live))
}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}

