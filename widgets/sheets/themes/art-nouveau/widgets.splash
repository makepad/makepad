// The combo box: the ivory well one types into, its chevron behind a fine
// bronze line at the right end.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 10.0 right: 32.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    var out = md_field(p, size, o, px, self.hover, self.focus, self.disabled, 14.0)
    let dx = Finish.snap(o.x + size.x - 24.0, px) - o.x
    let in_y = step(size.y * 0.25, p.y) * step(p.y, size.y * 0.75)
    let dl = step(dx - max(px, 0.6) * 0.5, p.x) * step(p.x, dx + max(px, 0.6) * 0.5) * in_y * mix(0.8, 0.4, self.disabled)
    out = Finish.over(out, vec4(an_line_c() * dl, dl))
    let held = self.down * self.hover * live
    let cc = vec2(Finish.snap(o.x + size.x - 12.5, px) - o.x, size.y * 0.5 + held * px)
    let tri = Finish.cover(an_chev(p, cc, 3.4, 3.2, 1.0) - 0.65, px)
    let ink = mix(an_ink(), vec3(0.6, 0.53, 0.42), self.disabled)
    return Finish.over(out, vec4(ink * tri, tri))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. One ivory pill across the strip in its wire; the chosen
// segment is a teal enamel pill pressed into it, its word ivory.
let md_strip = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = md_rbox(p, c, h, h.y)
    var out = an_drop(p, c, h, h.y, 0.7)
    let hf = h - vec2(1.5, 1.5)
    let face = an_enamel(p, c, hf, hf.y, vec3(0.906, 0.851, 0.737), 0.0, 0.0)
    let fa = Finish.cover(d + 0.75, px)
    out = Finish.over(out, vec4(face * fa, fa))
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, h.y), 1.5, px, 1.0))
}
// The chosen cell of a strip: an enamel pill of `base` inside the cell,
// pressed in, in a wire of its own.
let md_cell = fn(p: vec2, lo: vec2, hi: vec2, px: float, base: vec3) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = md_rbox(p, c, h, h.y)
    let hf = h - vec2(1.2, 1.2)
    let face = an_enamel(p, c, hf, hf.y, base, 0.0, 0.6)
    let a = Finish.cover(d + 0.6, px)
    var out = vec4(face * a, a)
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, h.y), 1.2, px, 1.0))
}

mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_strip(p, self.rect_size, self.rect_pos, px)
}
// The pill is the segment's own box: its quad grows a point each way so the
// chosen pill stands just inside the strip's wire.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(1.0, 1.0), self.rect_size + vec2(2.0, 2.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0, 2.0)) - vec2(1.0, 1.0)
    let lo = vec2(Finish.snap(o.x - 0.5, px), Finish.snap(o.y - 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x + 0.5, px), Finish.snap(o.y + size.y + 0.5, px)) - o
    return md_cell(p, lo, hi, px, an_teal())
}
mod.widgets.SegmentedControlFlat.draw_text.color = #3a2e1f
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #f6eedb
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #f6eedb
mod.widgets.SegmentedControlFlat.draw_text.text_style = mod.theme.font_label{font_size: 10.5}
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_label{font_size: 10.5}

// The tab strip: the same pill; the tab in use an ochre enamel pill pressed
// into it, a hovered tab lifts a little, the quiet ones parted by a fine
// bronze line with a gold dot at its middle.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.tab_min_width = 46.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_strip(p, self.rect_size, self.rect_pos, px)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = self.rect_size * 0.5 - vec2(2.0, 2.5)
    let d = md_rbox(p, self.rect_size * 0.5, h, h.y)
    let a = Finish.cover(d, px) * 0.35
    return vec4(vec3(1.0, 0.98, 0.92) * a, a)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + 1.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 1.0, px), Finish.snap(o.y + size.y - 1.5, px)) - o
    return md_cell(self.pos * size, lo, hi, px, an_ochre())
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = self.rect_size.x * 0.5
    let y = self.rect_size.y * 0.5
    let ln = step(abs(p.x - x), max(px, 0.6) * 0.5) * step(abs(p.y - y), self.rect_size.y * 0.28) * 0.7
    let dot = Finish.cover(length(p - vec2(x, y)) - 1.2, px)
    let a = max(ln, dot)
    return vec4(mix(an_line_c(), an_gold_hi(), dot * 0.4) * a, a)
}
mod.widgets.Tabs.draw_mark.color = #3a2e1f
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // the add mark a plus in the middle of its room; the close mark a small
    // cross tucked into the top right of its room, clear of the word
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(2.0, 3.6, self.plus)
    let cm = mix(vec2(self.rect_size.x - 3.0, 4.5), c, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(0.0 - sin(a), cos(a)) * r
    let dd = min(md_seg(p, cm - u, cm + u), md_seg(p, cm - v, cm + v)) - mix(0.5, 0.6, self.plus)
    let k = Finish.cover(dd, px) * self.color.a
    return vec4(self.color.rgb * k, k)
}
mod.widgets.Tabs.draw_text.color = #3a2e1f
mod.widgets.Tabs.draw_text_active.color = #1f180f
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_label{font_size: 9.0 top_drop: 0.22}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_label{font_size: 9.0 top_drop: 0.22}

// ---------------------------------------------------------------------------
// PROGRESS. A channel of deep teal glass in its bronze wire; the value a
// sage-teal enamel combed with the fine veins of a long feather-like leaf,
// a gold midrib down it. The unknown value is a still run of leaves across
// the whole channel: a face may not run a clock.
mod.widgets.ProgressBarFlat.height = 12.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = uniform(12.0)
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let top = Finish.snap(o.y + (size.y - th) * 0.5, px) - o.y
    let bot = Finish.snap(o.y + (size.y + th) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + size.x * self.end, px) - o.x
    let h = vec2((x1 - x0) * 0.5, (bot - top) * 0.5)
    let c = vec2(x0, top) + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let dis = step(4.5, self.intent)
    var out = an_well(p, c, h, r, px, mix(vec3(0.150, 0.235, 0.212), vec3(0.62, 0.62, 0.56), dis), 0.55, 1.3, dis)
    var v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
    var unknown = 0.0
    if self.value < 0.0 {
        v1 = x1
        unknown = 1.0
    }
    let fh = vec2(max((v1 - x0) * 0.5 - 1.3, 0.0), h.y - 1.3)
    let fc = vec2((x0 + v1) * 0.5, c.y)
    let fd = md_rbox(p, fc, fh, min(fh.y, fh.x + fh.y))
    var base = vec3(0.447, 0.616, 0.537)
    if self.intent > 0.5 {
        base = self.fill_color().rgb
    }
    base = mix(base, vec3(0.70, 0.69, 0.60), dis)
    var fcol = an_enamel(p, fc, fh, fh.y, base, 0.0, 0.0)
    // the veins: fine pale strokes slanting back from the leading edge,
    // wavering a little so no two run alike
    let vy = (p.y - c.y) / max(h.y, 1.0)
    let vx = p.x - abs(vy) * 6.0 + (Finish.noise(vec2(p.x * 0.15, 3.0)) - 0.5) * 2.0
    let fv = abs(fract(vx / 3.6) - 0.5) * 3.6
    let vln = (1.0 - smoothstep(0.3, 0.3 + px * 1.5, fv)) * 0.30
    fcol = mix(fcol, Finish.lift(fcol, 0.45), vln)
    fcol = mix(fcol, fcol * 0.8, smoothstep(0.35, 1.0, abs(vy)) * 0.5)
    // the midrib along the value
    let rib = (1.0 - smoothstep(0.3, 0.3 + px, abs(p.y - c.y))) * 0.35
    fcol = mix(fcol, an_gold_hi(), rib)
    // the unknown value: leaves laid end to end
    if unknown > 0.5 {
        let cell = 12.0
        let lx = p.x - floor(p.x / cell) * cell
        let lf = an_leaf(vec2(lx, p.y), vec2(1.0, c.y + 1.5), normalize(vec2(1.0, -0.25)), cell - 2.0, h.y * 0.55, 0.0)
        let la = Finish.cover(lf.x, px)
        fcol = mix(vec3(0.150, 0.235, 0.212), mix(vec3(0.30, 0.46, 0.40), vec3(0.50, 0.66, 0.57), smoothstep(-0.2, 0.2, lf.y)), la)
        fcol = mix(fcol, an_line_c(), Finish.band(lf.x, 0.0, max(px, 0.45), px))
    }
    let fa = Finish.cover(fd, px) * step(0.01, v1 - x0)
    out = Finish.over(out, vec4(fcol * fa, fa))
    return out * self.track * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A dark teal well of cells four points long with a point
// between: unlit cells the deep teal glass, lit ones a sage green, ochre from
// 70 % and terracotta from 90 %; the hold an ivory line; the over lamp a
// small jewel.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let q = vec2(a, b)
    let th = min(7.0, across)
    let lamp_room = self.lamp * (th + 4.0)
    let bar = max(4.0, along - lamp_room)
    let h = vec2(bar * 0.5, th * 0.5)
    let c = vec2(h.x, across * 0.5)
    let r = 2.0
    let d = md_rbox(q, c, h, r)
    let pad = 1.5
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((a - pad) / span, 0.0, 1.0)
    let pitch = 5.0
    let cell = fract((a - pad) / pitch)
    let in_cell = step(cell, 4.0 / pitch)
    let lit = step(a, pad + span * self.level) * step(pad, a) * in_cell
    let ramp = mix(mix(mix(vec3(0.45, 0.66, 0.52), vec3(0.70, 0.76, 0.44), smoothstep(0.0, 0.7, share)), vec3(0.92, 0.72, 0.34), step(0.7, share)), vec3(0.86, 0.40, 0.27), step(0.9, share))
    let well = vec3(0.12, 0.19, 0.17)
    var fill = mix(well, ramp, lit)
    let cell_row = in_cell * step(pad, a) * step(a, pad + span)
    fill = mix(fill, mix(well, vec3(0.2, 0.3, 0.27), 0.5), (1.0 - lit) * cell_row * step(1.2, abs(b - c.y) + 1.2))
    let bt = b - (c.y - h.y)
    fill = mix(fill, vec3(1.0, 0.97, 0.88), lit * step(1.0, bt) * step(bt, 1.0 + px) * 0.3)
    if self.hold > 0.002 {
        let at = pad + span * self.hold
        let hm = step(abs(a - at), px) * step(abs(b - c.y), h.y)
        fill = mix(fill, an_ivory(), hm)
    }
    let ca = Finish.cover(d, px)
    var out = vec4(fill * ca, ca)
    let e = Finish.band(d, 0.0, max(px, 0.7), px)
    out = Finish.over(out, vec4(an_line_c() * e, e))
    if self.lamp > 0.5 {
        let la = bar + 2.0 + th * 0.5 + 1.0
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, md_led(p, lc, 2.6, px, vec3(0.90, 0.30, 0.20), step(0.5, self.over), 0.3))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A bronze hairline down the length of the view and a slim teal
// enamel pill riding on it in its own wire.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let mid = across * 0.5
    let rail = (1.0 - smoothstep(0.35, 0.35 + px, abs(b - mid))) * 0.55
    var out = vec4(an_line_c() * rail, rail)
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let th = vec2(max(tl * 0.5 - 1.0, 4.0), 3.5)
    let tc = vec2(t0 + tl * 0.5, mid)
    let td = md_rbox(q, tc, th, th.y)
    let hf = th - vec2(1.0, 1.0)
    let face = an_enamel(q, tc, hf, hf.y, Finish.lift(an_teal(), 0.12 * self.hover), 0.0, 0.3 * self.drag)
    let ta = Finish.cover(td, px)
    out = Finish.over(out, vec4(face * ta, ta))
    let e = Finish.band(td, 0.0, 1.0, px)
    out = Finish.over(out, vec4(mix(an_bronze_c(), an_gold_hi(), 0.3) * e, e))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised panel is sage enamel in a bronze wire with a
// fine gold line inside it, a sprig of leaves and a bud in its top right and
// bottom right corners; the sunken one a well of deeper parchment under the
// same wire, sprigs at its bottom corners. The words on both keep the sepia
// ink, at better than 6:1.
let md_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, r)
    let n = an_nrm(p, c, h, r)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let s = clamp(min(size.x, size.y) / 80.0, 0.55, 1.1)
    if sunken > 0.5 {
        var face = an_parch(p, px, vec3(0.545, 0.616, 0.561))
        let sh = clamp(Finish.inset(p, c, h - vec2(1.6, 1.6), r - 1.6, vec2(0.0, 2.0), 2.4), 0.0, 1.0)
        face = mix(face, an_shade(), sh * 0.38)
        let a = Finish.cover(d, px)
        let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, h.y, p.y - c.y) * 0.5
        out = Finish.over(out, vec4(vec3(0.98, 0.95, 0.88) * lip, lip))
        out = Finish.over(out, vec4(face * a, a))
        out = an_corner(out, p, lo, hi, 1.0, 3.5, s * 0.8, px)
        out = an_corner(out, p, lo, hi, 2.0, 3.5, s, px)
        out = Finish.over(out, an_fine(d, 3.4, max(px, 0.6), px, 0.6))
        return Finish.over(out, an_wire(d, n, 1.6, px, 1.0))
    }
    out = an_drop(p, c, h, r, 1.0)
    var face = an_enamel(p, c, h - vec2(1.6, 1.6), r - 1.6, vec3(0.580, 0.663, 0.596), 0.0, 0.0)
    face = face + g3(Finish.grain(p / px, 0.008))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = an_corner(out, p, lo, hi, 1.0, 3.5, s * 0.8, px)
    out = an_corner(out, p, lo, hi, 2.0, 3.5, s, px)
    out = Finish.over(out, an_fine(d, 3.4, max(px, 0.6), px, 0.7))
    return Finish.over(out, an_wire(d, n, 1.6, px, 1.0))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_plate(p, self.rect_size, self.rect_pos, px, 10.0, self.sunken)
}

// The card is an ivory leaf of parchment in a bronze wire and a fine gold
// line, a sprig in its bottom right corner and a smaller one top right. It
// lifts a little under the pointer.
mod.widgets.Card.radius = 10.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 10.0
    let d = md_rbox(p, c, h, r)
    var out = an_drop(p, c, h, r, 1.0 + 0.4 * self.hover)
    var face = an_parch(p, px, vec3(0.925, 0.878, 0.776))
    face = Finish.lift(face, 0.05 * self.hover - 0.0 * self.down)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    let s = clamp(min(size.x, size.y) / 80.0, 0.55, 1.1)
    out = an_corner(out, p, lo, hi, 1.0, 3.5, s * 0.8, px)
    out = an_corner(out, p, lo, hi, 2.0, 3.5, s, px)
    out = Finish.over(out, an_fine(d, 3.4, max(px, 0.6), px, 0.75))
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.6, px, 1.0))
}

// The plain rounded view keeps the colours its caller gives it; the edge is
// a snapped hairline at the true radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, max(self.border_radius * 2.0, 1.0))
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points on the parchment, parted by a faint bronze
// hairline; a hovered row takes a breath of ochre; the chosen row is an
// ochre enamel pill in its bronze wire, ending short of the scroll bar.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 12.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let lay = (self.hover * 0.16 + self.down * 0.10) * live * (1.0 - self.selected)
    let hd = md_rbox(p, (lo + hi) * 0.5 - vec2(3.0, 0.0), (hi - lo) * 0.5 - vec2(5.0, 1.5), 8.0)
    let la = Finish.cover(hd, px) * lay
    var out = vec4(an_ochre() * la, la)
    if self.selected > 0.5 {
        let h = vec2((hi.x - lo.x) * 0.5 - 6.0, (hi.y - lo.y) * 0.5 - 1.5)
        let c = vec2(lo.x + h.x + 2.0, (lo.y + hi.y) * 0.5)
        let r = h.y
        let d = md_rbox(p, c, h, r)
        out = Finish.over(out, an_contact(p, c, h, r, 1.0))
        let face = an_enamel(p, c, h - vec2(1.3, 1.3), r - 1.3, an_ochre(), 0.0, 0.0)
        let a = Finish.cover(d, px)
        out = Finish.over(out, vec4(face * a, a))
        out = Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.3, px, 1.0))
    }
    let yb = hi.y
    let dk = step(yb - max(px, 0.6), p.y) * step(p.y, yb) * step(lo.x + 4.0, p.x) * step(p.x, hi.x - 8.0) * 0.30 * (1.0 - self.selected)
    out = Finish.over(out, vec4(an_line_c() * dk, dk))
    return out
}
mod.widgets.ListItem.draw_text.color = #2a2116

// The open list of a drop-down: an ivory leaf in a bronze wire and a fine
// gold line, with a soft shadow; the row under the pointer an ochre wash,
// the chosen row a teal check.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 10.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 10.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 8.0
    let d = md_rbox(p, c, h, r)
    let sh = Finish.drop(p, c, h, r, vec2(0.5, 2.5), 2.2) * 0.22
    var out = vec4(an_shade() * sh, sh)
    let face = an_parch(p, px, vec3(0.925, 0.878, 0.776))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, an_fine(d, 3.0, max(px, 0.6), px, 0.7))
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.5, px, 1.0))
}
mod.widgets.PopupMenuItem.padding.left = 18.0
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let h = c - vec2(3.0, 0.5)
    let d = md_rbox(p, c, h, h.y)
    let live = 1.0 - self.disabled
    let wa = Finish.cover(d, px) * self.hover * live * 0.45
    var out = vec4(an_ochre() * wa, wa)
    let m0 = vec2(5.0, c.y + 0.2)
    let m1 = vec2(7.2, c.y + 2.4)
    let m2 = vec2(10.6, c.y - 2.6)
    let mk = Finish.cover(min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.75, px) * self.active
    return Finish.over(out, vec4(an_teal_dk() * mk, mk))
}

// The dock's tabs: the bar is the parchment with a bronze line at its foot;
// the tab in use an ivory leaf rounded at the top in its wire, open at the
// foot where it joins the panel below; the others lift under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 8.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 7.0
    let d = md_rbox(p, c, h, r)
    let face = an_parch(p, px, vec3(0.925, 0.878, 0.776))
    let a = Finish.cover(d, px) * self.active
    var out = vec4(face * a, a)
    out = Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.3, px, 1.0) * self.active)
    let lift = Finish.cover(d, px) * 0.18 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(vec3(1.0, 0.97, 0.9) * lift, lift), out)
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = step(yb - 1.3, p.y) * step(p.y, yb) * 0.9
    return vec4(an_line_c() * dk, dk)
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small ivory pill (teal enamel while chosen);
// a badge a small teal enamel pill with ivory figures.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let ch = min(22.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    let has_fill = step(0.05, self.color.a) * step(0.6, Finish.lum(self.ink.rgb))
    let kind = mix(mix(6.0, 5.0, step(0.01, self.border_size)), 0.0, has_fill)
    let kk = mix(7.0, kind, step(0.5, has_fill + step(0.01, self.border_size)))
    return an_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(99.0, 99.0, 99.0, 99.0), kk, m)
}
mod.widgets.ChipFlat.draw_text.text_style = mod.theme.font_label{font_size: 10.0}
mod.widgets.BadgePalette.neutral = #46635a
mod.widgets.BadgePalette.on_neutral = #f3e8cf
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 9.0}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 9.0}
mod.widgets.BadgeFlat.clip_x = false
mod.widgets.BadgeFlat.clip_y = false
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(18.0, self.rect_size.y - 2.0)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x + 1.0, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.0, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    var out = an_contact(p, c, h, r, 1.0)
    let face = an_enamel(p, c, h - vec2(1.2, 1.2), r - 1.2, self.color.rgb, 0.0, 0.0)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.2, px, 1.0))
    return out * self.color.a
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in teal on a faint track.
mod.widgets.SpinnerFlat.draw_bg.color = #46635a
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 2.5
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.25

// Rules between groups: a bronze-gold hairline with a small lozenge at its
// middle.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let ln = (1.0 - smoothstep(0.35, 0.35 + px, abs(p.y - y))) * 0.8
    let lq = abs(p - vec2(self.rect_size.x * 0.5, y))
    let lz = Finish.cover(lq.x * 0.6 + lq.y - 2.0, px)
    let a = max(ln, lz)
    return vec4(an_line_c() * a, a)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let a = (1.0 - smoothstep(0.35, 0.35 + px, abs(p.x - x))) * 0.8
    return vec4(an_line_c() * a, a)
}

// ---------------------------------------------------------------------------
// THE TREE. Its rows stand on the parchment, clear; the open row is an
// ochre enamel pill in its bronze wire, as the chosen row of a list.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = vec2(2.0, 1.5)
    let hi = self.rect_size - vec2(4.0, 1.5)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let face = an_enamel(p, c, h - vec2(1.2, 1.2), r - 1.2, an_ochre(), 0.0, 0.0)
    let a = Finish.cover(d, px)
    var out = vec4(face * a, a)
    out = Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.2, px, 1.0))
    return out * self.active
}

