    let ivory = an_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, 0.0, 0.0, vec4(99.0, 99.0, 99.0, 99.0), 7.0, 6.0)
    let teal = an_button(self.pos, self.rect_size, self.rect_pos, px, self.hover * 0.5, 0.55, self.focus, self.disabled, 0.0, 0.0, vec4(99.0, 99.0, 99.0, 99.0), 0.0, 6.0)
    return mix(ivory, teal, self.active)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #2a2116
