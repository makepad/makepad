mod.widgets.SliderRoundFlat.text_input.width = 30.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let y0 = Finish.snap(o.y + 1.0, px) - o.y
    let x1 = Finish.snap(o.x + size.x - 44.0, px) - o.x
    let y1 = Finish.snap(o.y + size.y - 1.0, px) - o.y
    let h = vec2((x1 - x0) * 0.5, (y1 - y0) * 0.5)
    let c = vec2(x0, y0) + h
    let ins = 2.0
    let kr = h.y - ins + 0.5
    let kx = x0 + ins + kr + self.slide_pos * (2.0 * h.x - 2.0 * ins - 2.0 * kr)
    var out = an_groove(p, c, h, px, x0 + ins, kx, self.disabled, self.hover * live)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, c.y)
    out = Finish.over(out, an_coin(p, kc, kr, px, self.hover, self.drag * live, self.disabled))
    return Finish.over(out, md_focus(md_rbox(p, c, h, h.y), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// FADERS. A deep teal slot four points wide in its bronze wire, bronze ticks
// either side, a gold thread in the slot for the value, and a cap: a teal
// enamel plaque 22 points across in a bronze wire, a gold line across its
// middle and a small bronze lozenge on it.
mod.widgets.SliderFader.cap_size = 13.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = floor(across * 0.5 / px) * px
    // the slot, in screen space
    let sw = 5.0
    let sc = mix(vec2(along * 0.5, mid), vec2(mid, size.y - along * 0.5), vert)
    let sh = mix(vec2(along * 0.5 - self.inset_px, sw * 0.5), vec2(sw * 0.5, along * 0.5 - self.inset_px), vert)
    var out = an_well(p, sc, sh, sw * 0.5, px, mix(an_teal_dk() * 0.8, vec3(0.6, 0.6, 0.55), self.disabled), 0.5, 1.0, self.disabled)
    // the value: a gold thread in the slot, from the origin (or the foot) to
    // the cap
    let va0 = foot + self.fill_lo * travel
    let va1 = foot + self.fill_hi * travel
    let vl = step(va0, a) * step(a, va1) * (1.0 - smoothstep(0.55, 0.55 + px, abs(b - mid))) * live
    out = Finish.over(out, vec4(an_gold_hi() * 0.9 * vl, vl * 0.9))
    // ticks: a long one every quarter of the travel, short ones between
    let nt = 16.0
    let f = (a - foot) / travel * nt
    let fi = floor(f + 0.5)
    let da = abs(a - (foot + fi / nt * travel))
    let major = 1.0 - step(0.1, abs(fi * 0.25 - floor(fi * 0.25 + 0.5)))
    let tl = mix(2.5, 4.5, major)
    let off = abs(b - mid) - sw * 0.5 - 2.5
    let in_rng = step(-0.5, fi) * step(fi, nt + 0.5)
    let tk = (1.0 - smoothstep(px * 0.6, px * 0.6 + 0.01 + px * 0.4, da)) * step(0.0, off) * step(off, tl) * in_rng * 0.8 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(an_line_c() * 0.8 * tk, tk))
    // the cap
    let at = foot + self.slide_pos * travel
    let cw = min(22.0, across)
    let cs = mix(vec2(at, mid), vec2(mid, size.y - at), vert)
    let ch = mix(vec2(self.cap_px * 0.5, cw * 0.5), vec2(cw * 0.5, self.cap_px * 0.5), vert)
    let cc = vec2(Finish.snap(o.x + cs.x, px) - o.x, Finish.snap(o.y + cs.y, px) - o.y)
    let cr = 4.0
    let cd = md_rbox(p, cc, ch, cr)
    let press = self.drag * live
    out = Finish.over(out, an_drop(p, cc, ch, cr, (1.0 - press * 0.5) * mix(1.0, 0.4, self.disabled)))
    let hf = ch - vec2(1.4, 1.4)
    let face = an_enamel(p, cc, hf, cr - 1.4, mix(an_teal(), vec3(0.62, 0.63, 0.55), self.disabled), max(self.hover, self.focus * 0.5) * live, press)
    let fa = Finish.cover(cd, px)
    out = Finish.over(out, vec4(face * fa, fa))
    // the gold line across the cap
    let ln = mix(abs(p.y - cc.y), abs(p.x - cc.x), 1.0 - vert)
    let lin = (1.0 - smoothstep(0.4, 0.4 + px, ln)) * Finish.cover(cd + 2.0, px)
    out = Finish.over(out, vec4(an_gold_hi() * 0.9 * lin, lin * 0.9))
    // the lozenge
    let lq = abs(p - cc)
    let lz = (lq.x + lq.y) - 3.2
    out = an_lay(out, lz, mix(an_bronze_c(), an_gold_hi(), 0.3), 0.5, px)
    out = Finish.over(out, an_wire(cd, an_nrm(p, cc, ch, cr), 1.4, px, live) * mix(1.0, 0.5, self.disabled))
    return Finish.over(out, md_focus(cd, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. A polished bronze disc, lit from the upper left, two rings engraved
// in it (a dark cut with a bright edge under it); in its middle a medallion
// of teal enamel with a spray of three leaves rising from its foot; the
// pointer a gold spear from a bronze boss out to the rim, turning with the
// value. Round it a fine bronze track and the value in gold.
let an_engrave = fn(d: float, at: float, px: float, amt: float) -> vec4 {
    let w = max(px, 0.5)
    let dk = Finish.band(d, at, at + w, px) * 0.75 * amt
    let lt = Finish.band(d, at + w, at + 2.0 * w, px) * 0.6 * amt
    var out = vec4(an_bronze_dk() * 0.7 * dk, dk)
    return Finish.over(out, vec4(an_gold_hi() * lt, lt))
}
let an_knob = fn(p: vec2, c: vec2, rad: float, px: float, ang: float, hover: float, press: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    var out = an_drop(p, c, vec2(rad, rad), rad, (1.0 - 0.4 * press) * mix(1.0, 0.4, dis))
    let q = p - c
    let d = length(q) - rad
    let n = q / max(length(q), 0.001)
    // the bronze disc: a dome, its light pooled on the upper left, a broad
    // soft sheen and a darker foot
    let lit = clamp(0.5 - 0.62 * dot(q / rad, vec2(0.45, 0.85)), 0.0, 1.0)
    var face = mix(an_bronze_dk(), an_bronze_c(), 0.30 + 0.70 * lit)
    face = mix(face, an_gold_hi(), smoothstep(0.62, 1.0, lit) * 0.55)
    face = Finish.lift(face, 0.12 * hover * live * (1.0 - press))
    face = mix(face, face * 0.9, press)
    face = mix(face, mix(face, vec3(0.75, 0.72, 0.64), 0.55), dis)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, an_engrave(d, rad * 0.10, px, live * 0.9 + 0.1))
    // the medallion
    let mr = rad * 0.70
    let md = length(q) - mr
    let mcol = an_enamel(p, c, vec2(mr, mr), mr, mix(an_teal(), vec3(0.62, 0.63, 0.55), dis), hover * live, press * 0.4) * (0.9 + 0.2 * lit)
    let ma = Finish.cover(md, px)
    out = Finish.over(out, vec4(mcol * ma, ma))
    // three leaves rising from the medallion's foot, fixed (the medallion
    // is the knob's face, the pointer turns over it)
    let ldk = mix(vec3(0.235, 0.369, 0.322), vec3(0.56, 0.57, 0.51), dis)
    let llt = mix(vec3(0.459, 0.604, 0.525), vec3(0.67, 0.67, 0.61), dis)
    let lw = max(0.3, rad * 0.02)
    let lb = c + vec2(0.0, mr * 0.80)
    if md < 1.0 {
        out = an_lay_leaf(out, an_leaf(p, lb, normalize(vec2(-0.62, -1.0)), mr * 1.25, mr * 0.20, mr * 0.14), ldk, llt, lw, px)
        out = an_lay_leaf(out, an_leaf(p, lb, normalize(vec2(0.62, -1.0)), mr * 1.25, mr * 0.20, mr * -0.14), ldk, llt, lw, px)
        out = an_lay_leaf(out, an_leaf(p, lb, vec2(0.0, -1.0), mr * 1.45, mr * 0.17, 0.0), ldk, llt, lw, px)
    }
    // the medallion's wire
    out = Finish.over(out, an_wire(md, n, max(0.9, rad * 0.07), px, live) * mix(1.0, 0.55, dis))
    // the spear: a long lozenge from the boss to the rim
    let dir = vec2(0.0 - sin(ang), cos(ang))
    let sl = an_leaf(p, c - dir * rad * 0.10, dir, rad * 1.0, max(0.9, rad * 0.085), 0.0)
    let sfill = mix(mix(an_bronze_c(), an_gold_hi(), smoothstep(-0.3, 0.3, sl.y) * 0.85), vec3(0.8, 0.78, 0.7), dis)
    out = an_lay(out, sl.x, sfill, max(0.35, rad * 0.025), px)
    // the boss
    let br = max(1.6, rad * 0.15)
    let bd = length(q) - br
    let bl = clamp(0.5 - 0.6 * dot(q / br, vec2(0.45, 0.85)), 0.0, 1.0)
    out = an_lay(out, bd, mix(an_bronze_dk(), an_gold_hi(), bl), max(0.35, rad * 0.02), px)
    // the rim
    out = Finish.over(out, an_wire(d, n, max(1.2, rad * 0.08), px, live) * mix(1.0, 0.55, dis))
    return out
}

// The value arc round a knob: `ar` its middle radius, `aw` its width; the
// gap centred at the bottom, the value clockwise from its left end, or from
// the origin when the knob is bipolar. The track a fine bronze line, the
// value gold with a dark edge.
let md_arc = fn(p: vec2, c: vec2, ar: float, aw: float, px: float, v0: float, v1: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    var ang = atan2(0.0 - q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let rd = abs(length(q) - ar) - aw * 0.5
    let rt = abs(length(q) - ar) - max(px, 0.45)
    let in_arc = step(start, ang) * step(ang, start + sweep)
    let e0 = c + vec2(0.0 - sin(start), cos(start)) * ar
    let e1 = c + vec2(0.0 - sin(start + sweep), cos(start + sweep)) * ar
    let track_d = min(mix(1000.0, rt, in_arc), min(length(p - e0), length(p - e1)) - aw * 0.6)
    let a0 = start + sweep * v0
    let a1 = start + sweep * v1
    let l0 = c + vec2(0.0 - sin(a0), cos(a0)) * ar
    let l1 = c + vec2(0.0 - sin(a1), cos(a1)) * ar
    let lit_in = step(a0, ang) * step(ang, a1)
    let lit_d = min(mix(1000.0, rd, lit_in), min(length(p - l0), length(p - l1)) - aw * 0.5)
    let ta = Finish.cover(track_d, px) * 0.7
    var out = vec4(an_line_c() * ta, ta)
    let la = Finish.cover(lit_d, px)
    let ink = mix(mix(an_bronze_c(), an_gold_hi(), 0.55), vec3(0.75, 0.72, 0.64), dis)
    out = Finish.over(out, vec4(ink * la, la))
    let le = Finish.band(lit_d, 0.0, max(px, 0.4), px) * 0.6
    return Finish.over(out, vec4(an_bronze_dk() * le, le))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - dia * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let aw = 1.8
    let ar = floor((rr - aw * 0.5) / px) * px
    let rad = floor((ar - aw * 0.5 - 2.4) / px) * px
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    var out = md_arc(p, c, ar, aw, px, v0, v1, gap, self.disabled)
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, an_knob(p, c, rad, px, ang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, md_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}
// Knob captions are small engraved words in the sepia ink.
mod.widgets.RotaryKnob.draw_text.color = #3a2e1f
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_bold{font_size: 9.0}

// The dial: the knob above set in a deep teal bezel ring between two bronze
// wires, gold pips on the bezel every thirtieth of a turn, the value in gold
// round the bezel.
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let room = vec2(size.x, size.y - 24.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 24.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    // the bezel: a teal ring between two wires
    let q = p - c
    let n = q / max(length(q), 0.001)
    let bw = max(5.0, rr * 0.20)
    let d_out = length(q) - rr
    let d_in = length(q) - (rr - bw)
    var out = an_drop(p, c, vec2(rr, rr), rr, mix(1.0, 0.4, self.disabled))
    let ba = Finish.cover(d_out, px)
    let bcol = an_enamel(p, c, vec2(rr, rr), rr, mix(an_teal_dk(), vec3(0.6, 0.6, 0.55), self.disabled), 0.0, 0.0)
    out = Finish.over(out, vec4(bcol * ba, ba))
    // the value round the bezel
    let ar = rr - bw * 0.5
    out = Finish.over(out, md_arc(p, c, ar, bw * 0.38, px, v0, v1, gap, self.disabled))
    // the pips
    var ang = atan2(0.0 - q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let st = 2.0 * PI / 24.0
    let ai = floor(ang / st + 0.5) * st
    let pc = c + vec2(0.0 - sin(ai), cos(ai)) * ar
    let on_track = step(gap * 0.5 - 0.01, ai) * step(ai, 2.0 * PI - gap * 0.5 + 0.01)
    let pd = length(p - pc) - max(0.7, bw * 0.12)
    let pa = Finish.cover(pd, px) * on_track * 0.85
    out = Finish.over(out, vec4(an_gold_hi() * pa, pa))
    out = Finish.over(out, an_wire(d_out, n, 1.6, px, live) * mix(1.0, 0.55, self.disabled))
    out = Finish.over(out, an_wire(0.0 - d_in - 1.4, n * -1.0, 1.4, px, live) * mix(1.0, 0.55, self.disabled) * Finish.cover(d_out, px))
    let rad = rr - bw - 1.5
    let kang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, an_knob(p, c, rad, px, kang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, md_focus(d_out, px, self.focus * live))
}

// The dial's readout: a small pill of the screens' deep teal glass in its
// bronze wire, amber figures.
let md_lcd = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, 2.0 * px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = an_glass_c() * (1.12 - 0.2 * t)
    col = mix(col, an_shade(), clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.2), 1.0), 0.0, 1.0) * 0.5)
    let a = Finish.cover(d, px)
    var out = an_drop(p, c, h, r, 0.6)
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, an_wire(d, an_nrm(p, c, h, r), 1.3, px, 1.0))
}
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 2.0 bottom: 2.0}
mod.widgets.RotaryFlat.text_input.min_height = 20.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_lcd(self.pos * self.rect_size, self.rect_size, self.rect_pos, px)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #ecc77c
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #f4d692
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #f4d692
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #a89060
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_label{font_size: 10.0}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A sunk ivory well in its bronze wire, its corners rounded
// half way to a pill; focused, a teal line inside the wire and the ivory
// takes a breath of sage. Read only, the well is a deeper parchment.
let md_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    let ins = 1.5
    let lo = vec2(Finish.snap(o.x + ins, px), Finish.snap(o.y + ins, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - ins, px), Finish.snap(o.y + size.y - ins, px)) - o - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let rr = min(r, h.y)
    let d = md_rbox(p, c, h, rr)
    var fill = Finish.lift(an_well_c(), 0.30 * hover * (1.0 - dis))
    fill = mix(fill, vec3(0.855, 0.867, 0.773), focus * 0.6)
    fill = mix(fill, vec3(0.827, 0.749, 0.600), dis)
    var out = an_well(p, c, h, rr, px, fill, mix(0.32, 0.18, dis), 1.3, dis)
    let il = Finish.band(d, 2.0, 2.0 + max(px, 0.5), px) * mix(0.55, 0.25, dis) * (1.0 - focus)
    out = Finish.over(out, vec4(an_teal_dk() * il, il))
    let fl = Finish.band(d, 1.3, 1.3 + 1.2 * max(px, 0.75), px) * focus * (1.0 - dis)
    return Finish.over(out, vec4(vec3(0.184, 0.435, 0.384) * fl, fl))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 14.0)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #6a5940
mod.widgets.TextInputFlat.draw_text.color_disabled = #7a6a50
mod.widgets.TextInputFlat.draw_cursor.color = #2a2116

// NUMBER FIELDS. The ivory well, and on its right a column split by a fine
// bronze line, a small chevron in each half; the half under the pointer
// lifts, the held half darkens.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 14.0)
}
mod.widgets.NumberField.pad_left = 10.0
mod.widgets.NumberSpin.width = 16.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
let an_chev = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    // a chevron hw either side, hh tall, pointing up (dir -1) or down (1)
    let a = c + vec2(0.0 - hw, 0.0 - hh * dir * 0.5)
    let b = c + vec2(0.0, hh * dir * 0.5)
    let e = c + vec2(hw, 0.0 - hh * dir * 0.5)
    return min(md_seg(p, a, b), md_seg(p, b, e))
}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 3.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 3.0, px), Finish.snap(o.y + self.rect_size.y - 3.0, px)) - o
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let inx = step(lo.x, p.x) * step(p.x, hi.x) * step(lo.y, p.y) * step(p.y, hi.y)
    let wash = inx * (0.10 * hot + 0.12 * dn)
    var out = vec4(mix(vec3(1.0, 0.97, 0.9), an_shade(), step(0.01, dn)) * wash, wash)
    // the fine bronze line down its left and across its middle
    let vl = step(lo.x, p.x) * step(p.x, lo.x + max(px, 0.6)) * step(lo.y, p.y) * step(p.y, hi.y) * 0.8
    let hl = step(abs(p.y - mid), max(px, 0.6) * 0.5) * step(lo.x, p.x) * step(p.x, hi.x) * 0.6
    let la = max(vl, hl)
    out = Finish.over(out, vec4(an_line_c() * la, la))
    let cx = (lo.x + hi.x) * 0.5 + 0.5
    let cu = an_chev(p, vec2(cx, (lo.y + mid) * 0.5), 2.8, 2.6, -1.0) - 0.55
    let cd = an_chev(p, vec2(cx, (mid + hi.y) * 0.5), 2.8, 2.6, 1.0) - 0.55
    let ti = Finish.cover(min(cu, cd), px)
    let ink = mix(an_ink(), vec3(0.6, 0.53, 0.42), self.disabled)
    return Finish.over(out, vec4(ink * ti, ti))
}

// The drag-number: the ivory well, its track a pale teal wash behind the
// ink.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = md_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 14.0)
    let d = md_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(3.0, 3.0), 6.0)
    let wx = 3.0 + (self.rect_size.x - 6.0) * max(self.fill, 0.0)
    let wash = step(0.0, self.fill) * step(p.x, wx) * Finish.cover(d, px) * 0.22
    return Finish.over(out, vec4(an_teal_lt() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #2a2116
mod.widgets.ValueInput.draw_text.text_style = mod.theme.font_label{font_size: 10.0 line_spacing: 1.0}
mod.widgets.ValueInput.arrow_color = #5a4a34
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// ---------------------------------------------------------------------------
// DROP-DOWNS. The ivory pill with a chevron on the right, set off by a fine
// bronze line. Open, the pill is held pressed in.
let md_dropdown = fn(pos0: vec2, size0: vec2, o0: vec2, px: float, hover: float, held: float, focus: float, dis: float, ins: float) -> vec4 {
    let m = 6.0
    let p = pos0 * (size0 + vec2(2.0 * m, 2.0 * m)) - vec2(m, m) - vec2(0.0, ins)
    let size = size0 - vec2(0.0, 2.0 * ins)
    let o = o0 + vec2(0.0, ins)
    let pos = (p + vec2(m, m)) / (size + vec2(2.0 * m, 2.0 * m))
    var out = an_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(99.0, 99.0, 99.0, 99.0), 7.0, m)
    let live = 1.0 - dis
    let dx = Finish.snap(o.x + size.x - 24.0, px) - o.x
    let in_y = step(size.y * 0.22, p.y) * step(p.y, size.y * 0.78)
    let dl = step(dx - max(px, 0.6) * 0.5, p.x) * step(p.x, dx + max(px, 0.6) * 0.5) * in_y * mix(0.8, 0.4, dis)
    out = Finish.over(out, vec4(an_line_c() * dl, dl))
    let cc = vec2(Finish.snap(o.x + size.x - 12.5, px) - o.x, size.y * 0.5 + held * live * px)
    let ch = an_chev(p, cc, 3.4, 3.2, 1.0) - 0.65
    let tri = Finish.cover(ch, px)
    let ink = mix(an_ink(), vec3(0.6, 0.53, 0.42), dis)
    return Finish.over(out, vec4(ink * tri, tri))
}

mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 12.0 right: 32.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDown.padding = mod.turtle.Inset{left: 12.0 right: 32.0 top: 4.0 bottom: 4.0}
