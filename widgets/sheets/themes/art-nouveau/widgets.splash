// The icon on a teal button is ivory, whatever colour its caller asked for
// (the catalogue asks for the working ink, which a teal face would swallow).
mod.widgets.Button.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    let k = vec3(0.953, 0.910, 0.812)
    return vec4(k * base.a, base.a) * self.opacity
}
