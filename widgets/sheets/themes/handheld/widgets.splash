mod.widgets.RadioButtonTab.clip_x = false
mod.widgets.RadioButtonTab.clip_y = false

// ---------------------------------------------------------------------------
// SLIDERS. A rail five pixels deep: an ink frame, dark inside with a deep
// row under its top, the value's run lit with a light row along its top,
// and a lit lip under the frame's foot. The thumb is a raised cap eight
// pixels wide with a grip line down its middle; it drops a pixel while
// dragged.
let pa_rail = fn(p: vec2, o: vec2, b: float, sb: vec4, lo: float, hi: float, dis: float) -> vec4 {
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let lip = pa_ring_out(d, 0.0, b) * step(sb.w, pc.y) * (1.0 - dis)
    out = pa_lay(out, pa_light(), lip)
    let top = step(pc.y, sb.y + 2.0 * b)
    let lit = step(lo, pc.x) * step(pc.x, hi)
    var col = mix(pa_dark(), pa_deep(), top)
    col = mix(col, mix(pa_lit(), vec3(0.910, 0.933, 0.839), top), lit)
    col = mix(col, mix(mix(pa_mute(), vec3(0.541, 0.627, 0.494), pa_checker(p, o, b)), pa_light(), lit), dis)
    col = mix(col, mix(pa_ink(), pa_mid(), dis), rim_a)
    return pa_lay(out, col, inside)
}

let pa_thumb = fn(p: vec2, o: vec2, b: float, hx: float, yc: float, w: float, hgt: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let hov = step(0.5, hover) * live
    let dr = step(0.5, drag) * live
    let pc = pa_cell(p, o, b)
    let x0 = pa_snap(hx - w * b * 0.5, o.x, b)
    let y0 = pa_snap(yc - hgt * b * 0.5, o.y, b)
    let sb = vec4(x0, y0 + dr * b, x0 + w * b, y0 + hgt * b)
    let face = mix(mix(mix(pa_light(), pa_lit(), hov), pa_down(), dr), pa_mute(), dis)
    let hl = mix(mix(pa_lit(), pa_mute(), dr), pa_mute(), dis)
    let sh = mix(mix(pa_mute(), pa_down(), dr), pa_mute(), dis)
    var out = pa_cap(pc, b, sb, 1.0, 1.0 - dr, face, hl, sh, mix(pa_deep(), pa_mid(), dis), mix(pa_ink(), pa_mid(), dis), 0.32 * (1.0 - dr) * live)
    // the grip: one ink column down the middle of the face
    let gy = step(sb.y + 3.0 * b, pc.y) * step(pc.y, sb.w - 3.0 * b - (1.0 - dr) * b)
    let ga = step(abs(pc.x - (x0 + w * b * 0.5) + 0.5 * b), 0.51 * b) * gy
    out = pa_lay(out, pa_mid(), ga)
    let kf = pa_focus(pa_dbox(pc, vec4(x0, y0, x0 + w * b, y0 + hgt * b), 1.0, b), p, o, b) * step(0.5, focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}

let pa_slider = fn(p: vec2, o: vec2, size: vec2, px: float, top: float, slide: float, origin: float, arc_origin: float, hover: float, focus: float, drag: float, disabled: float, x0: float, x1: float, thumb: float) -> vec4 {
    let b = 2.0 * px
    let dis = step(0.5, disabled)
    let yc = (top + size.y) * 0.5
    let tw = 8.0
    let lo_t = min(origin, slide) * arc_origin
    let hi_t = mix(slide, max(origin, slide), arc_origin)
    let span0 = x0 + tw * b * 0.5 * thumb
    let span1 = x1 - tw * b * 0.5 * thumb
    let hx = span0 + slide * (span1 - span0)
    let rh = mix(3.0, 5.0, thumb)
    let ry = pa_snap(yc - rh * b * 0.5, o.y, b)
    let sb = vec4(pa_snap(x0, o.x, b), ry, pa_snap(x1, o.x, b), ry + rh * b)
    let lo = mix(sb.x, span0 + lo_t * (span1 - span0), step(0.001, lo_t))
    let hi = span0 + hi_t * (span1 - span0)
    var out = pa_rail(p, o, b, sb, lo, hi, dis)
    if thumb > 0.5 {
        out = pa_over(out, pa_thumb(p, o, b, hx, yc, tw, 11.0, hover, drag, focus, dis))
    } else {
        // the minimal slider: under the pointer or in focus, an ink tick
        // standing at the value
        let pc = pa_cell(p, o, b)
        let tk = step(abs(pc.x - pa_snap(hx, o.x, b) - 0.5 * b), 0.51 * b) * step(sb.y - b, pc.y) * step(pc.y, sb.w + b)
        out = pa_lay(out, pa_ink(), tk * max(step(0.5, hover), max(step(0.5, focus), step(0.5, drag))) * (1.0 - dis))
    }
    return out
}

mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
