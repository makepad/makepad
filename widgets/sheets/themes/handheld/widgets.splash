// The dock's tabs: the tab in use is a light cap with an ink bar along its
// top; the others lay the checker under the pointer.
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let pc = pa_cell(p, o, b)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let da = pa_checker(p, o, b) * step(0.5, self.hover) * (1.0 - step(0.5, self.active))
    out = pa_lay(out, pa_light(), da)
    let act = step(0.5, self.active)
    out = pa_lay(out, pa_face(), act)
    let bar = step(pc.y, sb.y + 2.0 * b) * act
    let side = max(step(pc.x, sb.x + b), step(sb.z - b, pc.x)) * act
    out = pa_lay(out, pa_ink(), max(bar, side))
    return out
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let yb = pa_snap(self.rect_size.y, self.rect_pos.y, b)
    let la = step(yb - b, p.y) * step(p.y, yb)
    return vec4(pa_ink() * la, la)
}

// ---------------------------------------------------------------------------
// PROGRESS. A rail six pixels deep in an ink frame, dark inside, the done
// run lit with a light row along its top. The amount that is not known
// cannot move without a clock, so it stands still: a lit run across the
// middle third.
mod.widgets.ProgressBarFlat.height = 9.33
mod.widgets.ProgressBarFlat.draw_bg.thickness = 8.0
mod.widgets.ProgressBarFlat.draw_bg.border_radius = 0.0
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let hgt = 6.0 * b
    let y0 = pa_snap((size.y - hgt) * 0.5, o.y, b)
    let x0 = size.x * self.start
    let x1 = size.x * self.end
    let sb = vec4(pa_snap(x0, o.x, b), y0, pa_snap(x1, o.x, b), y0 + hgt)
    var lo = sb.x
    var hi = sb.x + clamp((self.value - self.start) / max(self.end - self.start, 0.0001), 0.0, 1.0) * (sb.z - sb.x)
    if self.value < 0.0 {
        lo = sb.x + (sb.z - sb.x) * 0.36
        hi = sb.x + (sb.z - sb.x) * 0.64
    }
    return pa_rail(p, o, b, sb, lo, hi, 0.0) * self.opacity
}

// LEVEL METERS. A dark rail in an ink frame holding segments two pixels
// long and one apart, lit to the level and dark beyond; the held peak a
// segment of ink-framed lit; the over lamp a small cap at the end, lit
// when the level has gone over.
mod.widgets.LevelMeter.height = 9.33
mod.widgets.LevelMeterColumn.width = 9.33
mod.widgets.LevelMeter.draw_bg.lamp_size = uniform(8.0)
mod.widgets.LevelMeter.draw_bg.lamp_gap = uniform(3.0)
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let vert = step(0.5, self.vertical)
    let pc = pa_cell(p, o, b)
    let along = mix(size.x, size.y, vert)
    let lamp_room = self.lamp * (self.lamp_size + self.lamp_gap)
    let bar = max(4.0 * b, along - lamp_room)
    // the rail's box in window space: horizontal runs from the left, a
    // column from the foot
    let sbh = pa_sbox(o, vec2(0.0, 0.0), vec2(bar, size.y), b)
    let sbv = pa_sbox(o, vec2(0.0, size.y - bar), size, b)
    let sb = mix(sbh, sbv, vert)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    // position along from the low end, in pixels from the rail's start
    let s = mix(pc.x - sb.x, sb.w - pc.y, vert)
    let len = mix(sb.z - sb.x, sb.w - sb.y, vert)
    let k = floor((s - b) / (3.0 * b))
    let within = s - b - k * 3.0 * b
    let n = floor((len - 2.0 * b + b) / (3.0 * b))
    let seg = step(within, 2.0 * b) * step(0.0, k) * step(k, n - 1.0) * step(b, s) * step(s, len - b)
    let lit = step((k + 0.5) / max(n, 1.0), self.level + 0.0001) * step(0.0001, self.level)
    let hk = floor(self.hold * n - 0.0001)
    let peak = step(abs(k - hk), 0.5) * step(0.002, self.hold)
    var col = pa_dark()
    col = mix(col, mix(pa_dark2(), pa_lit(), max(lit, peak)), seg)
    col = mix(col, pa_ink(), rim_a)
    var out = vec4(col * inside, inside)
    if self.lamp > 0.5 {
        let ls = floor(self.lamp_size / b + 0.5) * b
        let lh = pa_sbox(o, vec2(bar + self.lamp_gap, (size.y - ls) * 0.5), vec2(bar + self.lamp_gap + ls, (size.y + ls) * 0.5), b)
        let lv = pa_sbox(o, vec2((size.x - ls) * 0.5, size.y - bar - self.lamp_gap - ls), vec2((size.x + ls) * 0.5, size.y - bar - self.lamp_gap), b)
        let lb = mix(lh, lv, vert)
        let on = step(0.5, self.over)
        let lamp = pa_cap(pc, b, lb, 1.0, 0.0, mix(pa_dark2(), pa_lit(), on), mix(pa_dark2(), vec3(0.910, 0.933, 0.839), on), mix(pa_deep(), pa_light(), on), pa_deep(), pa_ink(), 0.0)
        out = pa_over(out, lamp)
    }
    return out * self.opacity
}

// SCROLL BARS. Ten points: a dark trough in an ink frame, the thumb a
// raised light cap a pixel inside it, lifted under the pointer and pushed
// in while dragged.
mod.widgets.ScrollBar.bar_size = 10.67
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.size = 10.67
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let vert = step(0.5, self.is_vertical)
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    var col = mix(pa_dark(), pa_dark2(), pa_quarter(p, o, b))
    col = mix(col, pa_ink(), rim_a)
    var out = vec4(col * inside, inside)
    let len = mix(size.x, size.y, vert)
    let t0 = len * self.norm_scroll
    let t1 = len * (self.norm_scroll + self.norm_handle)
    let th = mix(pa_sbox(o, vec2(t0, 0.0), vec2(t1, size.y), b), pa_sbox(o, vec2(0.0, t0), vec2(size.x, t1), b), vert)
    let tb = vec4(th.x, th.y, th.z, th.w)
    let hov = step(0.5, max(self.hover, self.drag))
    let dr = step(0.5, self.drag)
    let face = mix(mix(pa_light(), pa_lit(), hov), pa_down(), dr)
    let cap = pa_cap(pc, b, tb, 1.0, 0.0, face, mix(pa_lit(), pa_mute(), dr), pa_mute(), pa_deep(), pa_ink(), 0.0)
    out = pa_over(out, cap)
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// PANELS. A raised panel is a large cap: an ink frame with its corners
// stepped off twice, a light row along its top and left, a shade row along
// its right and above its foot, a dark thickness, a shadow a pixel to the
// lower right, and a face dithered in a checker of two mid greens. The
// inset is let in: an ink frame, two deep rows under its top and down its
// left, a light row inside its right and foot, and a lighter face with one
// pixel in four darkened.
let pa_panel = fn(p: vec2, o: vec2, size: vec2, b: float, sunk: float, card: float) -> vec4 {
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if sunk > 0.5 {
        let d = pa_dbox(pc, sb, 2.0, b)
        let inside = step(d, 0.0)
        let rim_a = inside * step(-b, d)
        let lip = pa_ring_out(d, 0.0, b) * max(step(sb.w, pc.y), step(sb.z, pc.x))
        out = pa_lay(out, pa_light(), lip)
        var col = mix(vec3(0.490, 0.576, 0.431), vec3(0.455, 0.537, 0.416), pa_quarter(p, o, b))
        let dt = min(pc.x - sb.x, pc.y - sb.y)
        let db = min(sb.z - pc.x, sb.w - pc.y)
        col = mix(col, pa_mid(), step(dt, 4.0 * b) * step(dt, db))
        col = mix(col, pa_dark2(), step(dt, 3.0 * b) * step(dt, db))
        col = mix(col, pa_deep(), step(dt, 2.0 * b) * step(dt, db))
        col = mix(col, vec3(0.604, 0.690, 0.529), step(db, 2.0 * b) * step(db, dt))
        col = mix(col, pa_ink(), rim_a)
        out = pa_lay(out, col, inside)
    } else {
        let face = mix(vec3(0.561, 0.647, 0.478), vec3(0.620, 0.706, 0.533), card)
        let face2 = mix(vec3(0.518, 0.604, 0.443), vec3(0.588, 0.675, 0.506), card)
        let f = mix(face, face2, pa_checker(p, o, b))
        out = pa_cap(pc, b, sb, 2.0, 1.0, f, pa_light(), pa_mute(), pa_deep(), pa_ink(), 0.32)
        // the checker stays inside the bevel: the bevel rows are solid
    }
    return out
}

mod.widgets.PanelView.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 14.0 bottom: 14.0}
mod.widgets.InsetPanelView.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 14.0 bottom: 14.0}
mod.widgets.Card.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 12.0 bottom: 12.0}
mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return pa_lcd(p, self.rect_pos, self.rect_size, px, 6.0, 2.5)
}

// The card: a screen of its own; the pointer lays the
// light row's checker over it, a press darkens it a step.
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let m = 3.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = pa_lcd(p, self.rect_pos, self.rect_size, px, 4.0, 2.5)
    let pc = pa_cell(p, self.rect_pos, b)
    let sb = pa_sbox(self.rect_pos, vec2(10.0, 10.0), self.rect_size - vec2(10.0, 10.0), b)
    let d = pa_dbox(pc, sb, 2.0, b)
    let inner = step(d, -2.0 * b) * step(pc.y, sb.w - 3.0 * b)
    let la = inner * pa_quarter(p, self.rect_pos, b) * max(step(0.5, self.hover), step(0.5, self.down))
    return pa_lay(out, mix(pa_light(), pa_mute(), step(0.5, self.down)), la)
}

// The plain rounded view keeps the colours its caller gives it; its edge
// is stepped on the grid.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let sb = pa_sbox(o, lo, hi, b)
    let pc = pa_cell(p, o, b)
    let notch = clamp(floor(self.border_radius / 3.0 + 0.5), 0.0, 2.0)
    let d = pa_dbox(pc, sb, notch, b)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let inside = step(d, 0.0)
    var out = vec4(fill.rgb * fill.a * inside, fill.a * inside)
    if self.border_size > 0.0 {
        let la = inside * step(-b, d) * self.border_color.a
        out = pa_over(out, vec4(self.border_color.rgb * la, la))
    }
    return out
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points. The row's words have no chosen ink, so a chosen
// row cannot turn dark: it is a lit bar framed in ink with the pointer of a
// handheld's menu at its head. The pointer's row lays the light checker.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 18.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_text.color = #0d2117
mod.widgets.ListItem.draw_text_2.color = #1e3326
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - step(0.5, self.disabled)
    let sel = step(0.5, self.selected)
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(1.0, 1.0), self.rect_size - vec2(12.0, 1.0), b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ba = inside * pa_checker(p, o, b) * max(step(0.5, self.hover), step(0.5, self.down)) * live * (1.0 - sel)
    out = pa_lay(out, pa_light(), ba)
    // the chosen row
    var col = mix(pa_lit(), pa_light(), step(sb.w - 2.0 * b, pc.y))
    col = mix(col, pa_ink(), step(-b, d))
    out = pa_lay(out, col, inside * sel)
    // the menu pointer: a stepped triangle four pixels deep at the head
    let cy = pa_snap(self.rect_size.y * 0.5, o.y, b)
    let q = floor((pc - vec2(sb.x + 2.0 * b, cy)) / b)
    let tri = step(0.0, q.x) * step(q.x, 3.5) * step(abs(q.y + 0.5), 4.0 - q.x) * sel
    out = pa_lay(out, pa_ink(), tri)
    return out
}

// The open list of a drop-down: a light sheet in an ink frame with its
// corners stepped off; the pointer's row lays the checker, the chosen row
// is dark with lit words.
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let pc = pa_cell(p, o, b)
    return pa_cap(pc, b, sb, 1.0, 0.0, vec3(0.702, 0.773, 0.600), pa_lit(), pa_face(), pa_deep(), pa_ink(), 0.0)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - step(0.5, self.disabled)
    let inrow = step(1.0, p.x) * step(p.x, self.rect_size.x - 1.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ha = pa_checker(p, o, b) * step(0.5, self.hover) * live * (1.0 - step(0.5, self.active)) * inrow
    out = pa_lay(out, pa_light(), ha)
    let ia = step(0.5, self.active) * inrow
    out = pa_lay(out, pa_dark(), ia)
    return out
}
mod.widgets.PopupMenuItem.draw_text.color_active = #d6e0b2

// THE SPINNER. Eight blocks two pixels square round a circle: one in ink,
// the next ones stepping down through the dark and the mid to the mute. A
// sheet may not read the pass clock and the spinner carries no other, so
// it stands still.
mod.widgets.SpinnerFlat.size = 18.67
mod.widgets.SpinnerFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(pa_snap(self.rect_size.x * 0.5, o.x, b), pa_snap(self.rect_size.y * 0.5, o.y, b))
    let pc = pa_cell(p, o, b)
    let v = pc - c
    var th = atan2(v.x, -v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let k = floor(th / (PI * 0.25) + 0.5)
    let ang = k * PI * 0.25
    let rr = floor(min(self.rect_size.x, self.rect_size.y) * 0.5 / b - 1.0) * b
    let bc = c + vec2(sin(ang), -cos(ang)) * (rr - b)
    let q = abs(pc - vec2(pa_snap(bc.x, o.x, b), pa_snap(bc.y, o.y, b)))
    let a = step(max(q.x, q.y), b) * self.alpha
    var col = pa_mid()
    col = mix(col, pa_dark2(), step(abs(k - 6.0), 0.5))
    col = mix(col, pa_dark(), step(abs(k - 7.0), 0.5))
    col = mix(col, pa_ink(), step(abs(k - 8.0), 0.5) + step(k, 0.5))
    return vec4(col * a, a)
}

// Chips: a small raised cap 20 points tall inside the room its size rung
// takes; a chosen chip (light letters) is the dark pushed-in cap.
mod.widgets.ChipFlat.radius = 0.0
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let inset = max((self.rect_size.y - 21.33) * 0.5, 0.0)
    let sb = pa_sbox(o, vec2(0.0, inset), vec2(self.rect_size.x - b, self.rect_size.y - inset), b)
    let pc = pa_cell(p, o, b)
    let chosen = step(0.6, dot(self.ink.rgb, vec3(0.299, 0.587, 0.114)))
    let hov = step(0.5, self.hover)
    let held = step(0.5, self.down)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if chosen > 0.5 {
        out = pa_sunk(pc, b, vec4(sb.x, sb.y + b, sb.z, sb.w), 1.0, mix(pa_dark(), pa_dark2(), hov), pa_ink(), 1.0, 2.0)
    } else {
        let face = mix(mix(pa_face(), pa_hi(), hov), pa_down(), held)
        out = pa_cap(pc, b, vec4(sb.x, sb.y + held * b, sb.z, sb.w), 1.0, 0.0, face, mix(pa_light(), pa_mute(), held), pa_mute(), pa_deep(), pa_ink(), 0.3 * (1.0 - held))
    }
    let d = pa_dbox(pc, sb, 1.0, b)
    let kf = step(-3.0 * b, d) * step(d, -2.0 * b) * self.keyed
    out = pa_lay(out, mix(pa_ink(), pa_lit(), chosen), kf)
    return out
}
// Badges: a small light cell in an ink frame with ink digits.
mod.widgets.BadgePalette.neutral = #c0cf9f
mod.widgets.BadgePalette.on_neutral = #0d2117
mod.widgets.BadgePalette.neutral_container = #93a87e
mod.widgets.BadgePalette.on_neutral_container = #0d2117
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(17.33, self.rect_size.y)
    let sb = pa_sbox(o, vec2(0.0, (self.rect_size.y - bh) * 0.5), vec2(self.rect_size.x, (self.rect_size.y + bh) * 0.5), b)
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    var col = self.color.rgb
    col = mix(col, pa_ink(), step(-b, d))
    let a = inside * self.color.a
    return vec4(col * a, a)
}

// Rules between groups: one big pixel of ink.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let y = pa_snap(self.rect_size.y * 0.5, self.rect_pos.y, b)
    let a = step(y - b, p.y) * (1.0 - step(y, p.y))
    return vec4(pa_ink() * a, a)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let x = pa_snap(self.rect_size.x * 0.5, self.rect_pos.x, b)
    let a = step(x - b, p.x) * (1.0 - step(x, p.x))
    return vec4(pa_ink() * a, a)
}

// ---------------------------------------------------------------------------
// THE SCREEN VIEW keeps the stock face, the readout frame the pixel art
// sheet has: an ink line at the top and the left, the shadow under the
// top edge, the lighter face, the lit lip under the foot.
// THE TOP. The caption bar is the shell's plastic with what the device
// prints on it, in three plates parted by seams cut into the plastic: at
// the left the battery plate with a glossy red lamp and BAT printed dark,
// then the plate with the power legend pressed into it and a groove along
// the middle with a gap for the title the label draws, and at the right
// the keys' plate with the window's controls as the device's keys. The
// lettering is drawn, each letter a few strokes and rings, so it is as
// smooth as print at any size.

// Distance to the segment from a to b.
let pa_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * h)
}

// A bold sans letter drawn in a box one cap height tall with its top left
// at the origin: O N F B A T (0 to 5), a left-pointing triangle (6) and a
// small ring (7). `h` is the cap height in points and `t` half the stroke
// in points; returns the signed distance in points.
let pa_letter = fn(ch: float, p: vec2, h: float, t: float) -> float {
    let q = p / h
    var d = abs(Material.sd_box(q, vec2(0.40, 0.50), vec2(0.30, 0.40), 0.30))
    if ch > 0.5 {
        d = min(pa_seg(q, vec2(0.11, 0.11), vec2(0.11, 0.89)), pa_seg(q, vec2(0.69, 0.11), vec2(0.69, 0.89)))
        d = min(d, pa_seg(q, vec2(0.11, 0.11), vec2(0.69, 0.89)))
    }
    if ch > 1.5 {
        d = min(pa_seg(q, vec2(0.11, 0.11), vec2(0.11, 0.89)), pa_seg(q, vec2(0.11, 0.11), vec2(0.65, 0.11)))
        d = min(d, pa_seg(q, vec2(0.11, 0.50), vec2(0.58, 0.50)))
    }
    if ch > 2.5 {
        d = min(pa_seg(q, vec2(0.11, 0.11), vec2(0.11, 0.89)), pa_seg(q, vec2(0.11, 0.11), vec2(0.40, 0.11)))
        d = min(d, min(pa_seg(q, vec2(0.11, 0.50), vec2(0.40, 0.50)), pa_seg(q, vec2(0.11, 0.89), vec2(0.44, 0.89))))
        d = min(d, max(abs(length(q - vec2(0.40, 0.305)) - 0.195), 0.40 - q.x))
        d = min(d, max(abs(length(q - vec2(0.44, 0.695)) - 0.195), 0.44 - q.x))
    }
    if ch > 3.5 {
        d = min(pa_seg(q, vec2(0.40, 0.11), vec2(0.08, 0.89)), pa_seg(q, vec2(0.40, 0.11), vec2(0.72, 0.89)))
        d = min(d, pa_seg(q, vec2(0.21, 0.62), vec2(0.59, 0.62)))
    }
    if ch > 4.5 {
        d = min(pa_seg(q, vec2(0.08, 0.11), vec2(0.72, 0.11)), pa_seg(q, vec2(0.40, 0.11), vec2(0.40, 0.89)))
    }
    if ch > 5.5 {
        d = min(pa_seg(q, vec2(0.08, 0.50), vec2(0.62, 0.14)), pa_seg(q, vec2(0.62, 0.14), vec2(0.62, 0.86)))
        d = min(d, pa_seg(q, vec2(0.62, 0.86), vec2(0.08, 0.50)))
    }
    if ch > 6.5 {
        d = abs(length(q - vec2(0.30, 0.50)) - 0.17)
    }
    return d * h - t
}

// The word BAT with its top left at `at`, the letters on a pitch of 6.3.
let pa_bat = fn(p: vec2, at: vec2, h: float, t: float) -> float {
    var d = pa_letter(3.0, p - at, h, t)
    d = min(d, pa_letter(4.0, p - at - vec2(6.3, 0.0), h, t))
    d = min(d, pa_letter(5.0, p - at - vec2(12.6, 0.0), h, t))
    return d
}

// The power legend, the triangle, OFF, the ring and ON, with its top at
// `top`; the triangle and the ring in a thinner stroke.
let pa_legend = fn(p: vec2, top: float, h: float, t: float) -> float {
    var d = pa_letter(6.0, p - vec2(63.0, top), h, t * 0.6)
    d = min(d, pa_letter(0.0, p - vec2(77.0, top), h, t))
    d = min(d, pa_letter(2.0, p - vec2(88.0, top), h, t))
    d = min(d, pa_letter(2.0, p - vec2(99.0, top), h, t))
    d = min(d, pa_letter(7.0, p - vec2(112.5, top), h, t * 0.6))
    d = min(d, pa_letter(0.0, p - vec2(124.0, top), h, t))
    d = min(d, pa_letter(1.0, p - vec2(135.0, top), h, t))
    return d
}

// A seam cut into the plastic, lit from the top left: `d` runs across it
// from the wall in shadow at zero, a dark band a point and a half wide,
// then the lit wall from two points in to four and a half, then flat.
// Returns the factor on the plastic.
let pa_seam = fn(d: float, px: float) -> float {
    let dark = smoothstep(0.0 - 0.6 * px, 0.6 * px, d) * (1.0 - smoothstep(1.5 - 0.6 * px, 1.5 + 0.6 * px, d))
    let lit = smoothstep(2.0 - 0.6 * px, 2.0 + 0.6 * px, d) * (1.0 - smoothstep(3.8, 5.0, d))
    return 1.0 - 0.53 * dark + 0.21 * lit
}

// The battery lamp: a glossy red dome in a dark ring, its red deepening
// toward the rim and glowing at the lower right, a pink spark at the upper
// left, a thin shadow under it and a faint red cast on the plastic.
let pa_lamp = fn(p: vec2, c: vec2, r: float, px: float) -> vec4 {
    let d = length(p - c) - r
    let a = Finish.cover(d, px)
    let u = (p - c) / r
    let z = sqrt(max(0.0, 1.0 - dot(u, u)))
    var col = vec3(0.80, 0.10, 0.07)
    col = mix(col, vec3(0.96, 0.16, 0.08), smoothstep(-0.7, 0.9, (u.x + u.y) * 0.7071))
    col = col * (0.70 + 0.35 * z)
    col = col + vec3(0.55, 0.42, 0.44) * (1.0 - smoothstep(0.0, 0.55, length(u - vec2(-0.36, -0.40))))
    col = mix(col, vec3(0.20, 0.03, 0.03), Finish.band(d, 0.0, 0.7, px))
    let sh = (1.0 - smoothstep(0.0, 2.0, length(p - c - vec2(0.5, 0.9)) - r)) * (1.0 - a) * 0.38
    let halo = (1.0 - smoothstep(0.0, 3.0, d)) * (1.0 - a) * 0.10
    var out = vec4(0.0, 0.0, 0.0, sh)
    out = pa_over(out, vec4(vec3(0.9, 0.2, 0.2) * halo, halo))
    out = pa_over(out, vec4(col * a, a))
    return out
}

mod.widgets.Window.caption_bar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let w = p + self.rect_pos
    let gy = self.rect_size.y * 0.5
    let cx = self.rect_size.x * 0.5
    var col = pa_plastic(w, px)
    // the seams: under the top plate as far as the keys' plate, down the
    // keys' plate's edge, and down the battery plate's edge
    let kx = self.rect_size.x - 125.0
    let sy = 22.0
    col = col * mix(1.0, pa_seam(p.y - sy, px), step(p.x, kx))
    col = col * pa_seam(p.x - kx, px)
    col = col * mix(1.0, pa_seam(p.x - 44.0, px), step(p.y, sy))
    // the groove along the middle, from the legend to the keys, parting
    // for the title: a dark line and a lit line under it
    let along = step(150.0, p.x) * step(p.x, self.rect_size.x - 150.0) * step(110.0, abs(p.x - cx))
    col = mix(col, col * 0.70, along * step(abs(p.y - gy), 0.75 * px + 0.001))
    col = mix(col, col * 1.10, along * step(abs(p.y - gy - 1.5 * px), 0.75 * px + 0.001))
    // the power legend pressed into the plastic, centred on its plate: the
    // letter a solid darker grey, the wall it meets at the top left a dark
    // line inside its edge there, and the lit wall at the bottom right a
    // bright line showing just outside its edge
    let sh = vec2(0.8, 0.8)
    let g0 = Finish.cover(pa_legend(p, 6.75, 8.5, 1.25), px)
    let gd = Finish.cover(pa_legend(p - sh, 6.75, 8.5, 1.25), px)
    let gu = Finish.cover(pa_legend(p + sh, 6.75, 8.5, 1.25), px)
    col = mix(col, col * 0.84, g0)
    col = mix(col, col * 0.66, g0 * (1.0 - gd))
    col = mix(col, col * 1.28, (1.0 - g0) * gu)
    // the battery plate: BAT printed dark and bold, and the lamp
    let bat = Finish.cover(pa_bat(p, vec2(19.5, 7.5), 7.0, 0.8), px)
    col = mix(col, vec3(0.23, 0.24, 0.26), bat)
    col = pa_over(vec4(col, 1.0), pa_lamp(p, vec2(10.5, 11.5), 5.5, px)).rgb
    return vec4(col, 1.0)
}

// The countersunk well a key sits in, as a darkening of the plastic
// outside the key: `d` the distance outside the key's edge, `facing` 0
// at the top left where the well's rim faces away from the light and 1
// at the bottom right where the key's own side casts into it. One soft
// gradient from the key's edge outward, no ring: nearly black and short
// at the bottom right, mild and wide at the top left.
let pa_well = fn(d: float, facing: float, px: float) -> float {
    let w = mix(2.8, 1.8, facing)
    let fall = 1.0 - clamp(d / w, 0.0, 1.0)
    return mix(0.55, 0.85, facing) * fall * smoothstep(0.0 - 0.5 * px, 0.5 * px, d)
}

// A round magenta puck key: a flat disc with a rounded corner, lit from
// the top left, so the corner catches the light there and falls into
// shadow at the bottom right, the top a shade lighter toward the light,
// a dark side, sitting in its countersunk well; `mark` is the pale mark
// printed on the top.
let pa_round_key = fn(p: vec2, c: vec2, r: float, px: float, lift: float, mark: float) -> vec4 {
    let d = length(p - c) - r
    let a = Finish.cover(d, px)
    let u = p - c
    let s = max(length(u), 0.0001)
    let dir = u / s
    let toward = clamp((0.0 - (dir.x + dir.y)) * 0.7071, -1.0, 1.0)
    let facing = 0.5 - 0.5 * toward
    let f = 2.4
    let k = clamp((s - (r - f)) / f, 0.0, 1.0)
    let th = k * 1.5708
    let sn = sin(th)
    let cs = cos(th)
    let lam = clamp(sn * toward * 0.71 + cs * 0.70, 0.0, 1.2)
    var col = vec3(0.46, 0.11, 0.31) * (0.35 + 0.95 * lam) * lift
    col = col * (1.0 + 0.10 * (0.0 - (u.x + u.y)) / r)
    col = col + vec3(0.08, 0.05, 0.07) * (1.0 - smoothstep(0.0, 1.1, length(u / r - vec2(-0.30, -0.35))))
    // the corner goes pink where it faces the light, and the side is a
    // dark rim only where the key turns from the light
    col = mix(col, vec3(0.76, 0.44, 0.60), k * sn * max(toward, 0.0) * 0.6)
    col = mix(col, vec3(0.22, 0.04, 0.15), Finish.band(d, 0.0, 0.9, px) * facing)
    col = mix(col, vec3(0.95, 0.72, 0.88), mark)
    let well = pa_well(d, facing, px) * (1.0 - a)
    var out = vec4(0.0, 0.0, 0.0, well)
    out = pa_over(out, vec4(col * a, a))
    return out
}

// The window's keys: the device's, each pressed into the plastic in a
// countersunk well. Minimise is a glossy dark pill like the small keys
// under a handheld's screen, a half-cylinder lit from above with a bright
// rim along its top; maximise and close are magenta puck keys, their
// marks pale and thin: a square outline and a cross.
let DesktopButtonType = mod.widgets.DesktopButtonType
mod.widgets.DesktopButton.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let lift = 1.0 + 0.08 * self.hover - 0.14 * self.down
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    match self.button_type {
        DesktopButtonType.WindowsMin => {
            let hh = 5.0
            let d = Material.sd_box(p, c, vec2(15.0, hh), hh)
            let a = Finish.cover(d, px)
            let v = clamp((p.y - c.y) / hh, -1.0, 1.0)
            let z = sqrt(max(0.0, 1.0 - v * v))
            let lam = clamp((0.0 - v) * 0.55 + z * 0.80, 0.0, 1.2)
            var col = vec3(0.30, 0.30, 0.32) * (0.45 + 0.75 * lam) * lift
            let gx = (v + 0.58) / 0.20
            col = col + vec3(0.42, 0.42, 0.42) * exp(0.0 - gx * gx)
            col = mix(col, vec3(0.14, 0.14, 0.15), Finish.band(d, 0.0, 0.5, px) * step(c.y - hh * 0.55, p.y))
            col = mix(col, vec3(0.90, 0.90, 0.90), Finish.band(d, 0.0, 0.7, px) * step(p.y, c.y - hh * 0.55))
            let q = (p - c) / vec2(15.0, hh)
            let ql = max(length(q), 0.0001)
            let facing = clamp(0.5 + 0.5 * (q.x + q.y) / ql * 0.7071, 0.0, 1.0)
            let well = pa_well(d, facing, px) * (1.0 - a)
            out = vec4(0.0, 0.0, 0.0, well)
            out = pa_over(out, vec4(col * a, a))
            return out
        }
        DesktopButtonType.WindowsClose => {
            let m1 = pa_seg(p, c - vec2(3.0, 3.0), c + vec2(3.0, 3.0))
            let m2 = pa_seg(p, c + vec2(-3.0, 3.0), c + vec2(3.0, -3.0))
            let mark = Finish.cover(min(m1, m2) - 0.55, px)
            return pa_round_key(p, c, 10.0, px, lift, mark)
        }
        _ => {
            let mark = Finish.cover(abs(Material.sd_box(p, c, vec2(3.4, 3.4), 0.5)) - 0.5, px)
            return pa_round_key(p, c, 10.0, px, lift, mark)
        }
    }
    return out
}

// The keys stand thirty points apart on their plate, the close key
// twenty-one from the edge; the pill keeps its wider cell.
mod.widgets.Window.caption_bar.windows_buttons.max.width = 30.0
mod.widgets.Window.caption_bar.windows_buttons.close.width = 30.0
mod.widgets.Window.caption_bar.windows_buttons.margin = mod.turtle.Inset{left: 0.0 right: 6.0 top: 0.0 bottom: 0.0}

// THE GROUND. The window is the handheld's shell, the light grey plastic;
// every pane is a glass panel set into it, with a little plastic of its
// own round it, so the shell runs on between the screens. The bar between
// two panes is the plastic too.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let w = self.pos * self.rect_size + self.rect_pos
    return vec4(pa_plastic(w, px), 1.0)
}
mod.widgets.Splitter.draw_bg.color_bg = #b0b0ae
mod.widgets.Splitter.draw_bg.color = #b0b0ae
mod.widgets.Splitter.draw_bg.color_hover = #9c9c9a
mod.widgets.Splitter.draw_bg.color_drag = #888886
mod.widgets.Splitter.draw_bg.color_focus = #9c9c9a
mod.widgets.Splitter.draw_bg.border_radius = 0.0
mod.widgets.Splitter.draw_bg.splitter_pad = 0.0
// ---------------------------------------------------------------- band

// THE BAND is the sheet's own slider with two thumbs: the same track, the
// same lit value and the same thumb as the Slider, the value lit between
// the two thumbs. The widget's grab geometry is set to the thumbs' own, so
// what is drawn is what is dragged.
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.track_inset = 0.0
mod.widgets.RangeSliderFlat.handle_size = 10.6667
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = pa_slider(p, self.rect_pos, self.rect_size, px, self.label_px, self.end_pos, self.start_pos, 1.0, self.hot_end, self.focus, self.drag * self.hot_end, self.disabled, 0.0, self.rect_size.x, 1.0)
    // The near thumb, as the slider's own thumb is placed.
    let b = 2.0 * px
    let tw = 8.0
    let yc = (self.label_px + self.rect_size.y) * 0.5
    let span0 = tw * b * 0.5
    let span1 = self.rect_size.x - tw * b * 0.5
    let hx = span0 + self.start_pos * (span1 - span0)
    return pa_over(out, pa_thumb(p, self.rect_pos, b, hx, yc, tw, 11.0, self.hot_start, self.drag * self.hot_start, self.focus, step(0.5, self.disabled)))
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES are the sheet's own toggle, in proportion with the
// labels and the controls beside them: the rocker and the slide switch
// take the toggle's face, its size and shape, its quad and its label
// gap (the library's own faces for them are flat boxes sized for
// another face). The rocker turns on a click; the slide switch follows a
// drag, as the toggle does.
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 39.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 39.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 4.0 bottom: 4.0}
mod.widgets.ToggleSlide.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 4.0 bottom: 4.0}
mod.widgets.ToggleRocker.draw_bg.size = uniform(16.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(16.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(2.0)
mod.widgets.ToggleRocker.draw_bg.knob_inset = uniform(1.33)
mod.widgets.ToggleSlide.draw_bg.knob_inset = uniform(1.33)
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel
mod.widgets.ToggleSlide.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_y = false

// THE METER sits in the same window as the readouts and the screen: the
// library's display housing drawn round its face -- the bezel ring, a shade
// of whatever ground it is set in with a device pixel of dark at its edge;
// the face with the surround's shadow falling across it from the top and a
// device pixel of black where the glass meets the bezel; the glass's quiet
// diagonal band and the light line inside its top edge; the lip of light on
// the ground under it -- with the same corner, so the meter and the
// readouts read as one family. The scale, the red zone, the needle and its
// pivot are the library's own.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(theme.corner_radius * 0.5)
mod.widgets.NeedleMeter.draw_bg.color_bezel = uniform(theme.color_d_05)
mod.widgets.NeedleMeter.draw_bg.color_lip = uniform(theme.color_u_15)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.border_radius, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, r_out)
    let b = Finish.snap(2.0, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(r_out - b, 0.0)
    let face_d = Material.sd_box(p, c, hf, rf)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    var face = self.color.rgb
    // The scale: a hairline arc and a tick at every division.
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    face = mix(face, self.color_scale.rgb, max(arc, tick))
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        face = mix(face, self.color_zone.rgb, zone_t * zone_r)
    }
    // The needle, from under the pivot cover to just past the scale.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - px * 0.5, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - max(self.pivot_size - px, 0.0), px)
    face = mix(face, self.color_needle.rgb, needle)
    let pd = r - self.pivot_size
    face = mix(face, mix(self.color_needle.rgb, self.color.rgb, 0.35), Finish.cover(pd, px))
    face = mix(face, face * 0.55, Finish.band(pd, 0.0, px, px))
    // The housing: the surround's shadow across the face from the top, the
    // black device pixel at the glass's edge, and the glass over it all.
    let insh = Finish.inset(p, c, hf, rf, vec2(0.0, 2.0), 1.8)
    face = face * (1.0 - 0.55 * insh)
    face = mix(face, face * 0.4, Finish.band(face_d, 0.0, px, px))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let top = Finish.cover(abs(p.y - (c.y - hf.y) - px * 1.5) - px * 0.5, px) * 0.6
    let ga = clamp(0.03 * (band + top), 0.0, 1.0) * Finish.cover(face_d + px, px)
    face = face * (1.0 - ga) + vec3(ga, ga, ga)
    let bz = self.color_bezel
    var col = vec4(bz.rgb * bz.a, bz.a)
    col = Finish.over(col, vec4(0.0, 0.0, 0.0, 0.45 * Finish.band(outer, 0.0, px, px)))
    col = mix(col, vec4(face, 1.0), Finish.cover(face_d, px))
    col = col * Finish.cover(outer, px)
    let lip = Finish.ring_out(outer, 0.0, px, px) * step(hi.y, p.y)
    let la = self.color_lip.a * lip
    return Finish.over(vec4(self.color_lip.rgb * la, la), col) * self.color.a * self.opacity
}

true
