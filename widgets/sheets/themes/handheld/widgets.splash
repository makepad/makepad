    return pa_tab(self.pos, self.rect_size, self.rect_pos, px, 1.0, 0.0)
}
mod.widgets.Tabs.draw_sep.color = #00000000
mod.widgets.Tabs.draw_mark.color = #0d2117
// The close mark is a stepped x in lit pixels (it stands on the dark tab in
// use), the add mark a plus in ink pixels.
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let is_plus = step(0.5, self.plus)
    let cx0 = mix(self.rect_size.x - 6.0, self.rect_size.x * 0.5, is_plus)
    let c = vec2(pa_snap(cx0, o.x, b), pa_snap(self.rect_size.y * 0.5, o.y, b))
    let pc = pa_cell(p, o, b)
    let q = floor((pc - c) / b)
    let r = mix(2.0, 4.0, is_plus)
    let inbox = step(abs(q.x + 0.5), r + 0.5) * step(abs(q.y + 0.5), r + 0.5)
    let cross = max(step(abs(q.x - q.y), 0.5), step(abs(q.x + q.y + 1.0), 0.5)) * inbox
    let plus = max(step(abs(q.x + 0.5), 1.0), step(abs(q.y + 0.5), 1.0)) * inbox
    let a = mix(cross, plus, is_plus) * self.color.a
    let col = mix(vec3(0.839, 0.878, 0.698), vec3(0.051, 0.129, 0.090), is_plus)
    return vec4(col * a, a)
}
mod.widgets.Tabs.draw_text.color = #0d2117
mod.widgets.Tabs.draw_text_active.color = #d6e0b2
mod.widgets.Tabs.draw_text.ink_centered = true
mod.widgets.Tabs.draw_text_active.ink_centered = true
