mod.widgets.NumberField.input.draw_text.color_focus = #e8eed6
mod.widgets.NumberField.input.draw_text.color_down = #d6e0b2
mod.widgets.NumberField.input.draw_text.color_disabled = #243a2b
mod.widgets.NumberField.input.draw_text.color_empty = #a4b98c
mod.widgets.NumberField.input.draw_text.color_empty_hover = #b0c296
mod.widgets.NumberField.input.draw_text.color_empty_focus = #a4b98c
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let pc = pa_cell(p, o, b)
    // the cap stands two pixels in from the well's frame
    let sb = pa_sbox(o, vec2(b * 0.0, 2.0 * b), vec2(size.x - 2.0 * b, size.y - 2.0 * b), b)
    let mid = pa_snap((sb.y + sb.w) * 0.5, o.y, b)
    let upper = step(pc.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let face = mix(mix(mix(pa_light(), pa_lit(), step(0.5, hot)), pa_down(), step(0.5, dn)), pa_mute(), dis)
    var out = pa_cap(pc, b, sb, 1.0, 0.0, face, mix(pa_lit(), pa_mute(), dis), pa_mute(), pa_deep(), mix(pa_ink(), pa_mid(), dis), 0.0)
    let icol = mix(pa_ink(), pa_mid(), dis)
    // the rule across the middle
    let rule = step(abs(pc.y - mid), 0.51 * b) * step(sb.x, pc.x) * step(pc.x, sb.z)
    out = pa_lay(out, icol, rule)
    // the arrows: stepped triangles, five pixels across
    let cx = pa_snap((sb.x + sb.z) * 0.5, o.x, b)
    let qx = floor((pc.x - cx) / b)
    let yu = pa_snap((sb.y + mid) * 0.5, o.y, b)
    let yd = pa_snap((mid + sb.w) * 0.5, o.y, b)
    let ru = floor((pc.y - yu) / b) + 2.0
    let rd = 1.0 - floor((pc.y - yd) / b)
    let au = step(0.0, ru) * step(ru, 2.5) * step(abs(qx + 0.5), ru + 0.6)
    let ad = step(0.0, rd) * step(rd, 2.5) * step(abs(qx + 0.5), rd + 0.6)
    out = pa_lay(out, icol, max(au, ad))
    return out
}
// The printed arrow glyphs are hidden; the face draws the arrows.
mod.widgets.NumberSpin.draw_text.color = #0d211700
mod.widgets.NumberSpin.draw_text.color_disabled = #0d211700

// DROP-DOWNS. A raised cap with a cell twelve pixels wide split off at its
// right by an ink rule, a pixel chevron in it; open or held, the cap is
// pushed in.
let pa_choice = fn(p: vec2, o: vec2, size: vec2, b: float, hover: float, open: float, focus: float, disabled: float) -> vec4 {
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    var out = pa_button_face(p, o, size, b, 0.0, 0.0, hover, open, focus, disabled)
    let held = step(0.5, open) * live
    let rx = pa_snap(size.x - 16.0, o.x, b)
    let icol = mix(pa_ink(), pa_mid(), dis)
    let rule = step(abs(pc.x - rx - 0.5 * b), 0.51 * b) * step(sb.y + (1.0 + held) * b, pc.y) * step(pc.y, sb.w - 2.0 * b)
    out = pa_lay(out, icol, rule)
    let cxc = pa_snap((rx + sb.z) * 0.5, o.x, b)
    let cyc = pa_snap(size.y * 0.5 - 2.0 * b + held * b, o.y, b)
    let ch = pa_chevron(pc, vec2(cxc + 0.5 * b, cyc + 0.5 * b), b)
    out = pa_lay(out, icol, ch)
    return out
}
