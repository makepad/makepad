// HELD STATES. The stock tracks write the pointer's hover and the press as
// snapped values, and a snapped value never arrives when a state is held
// from the start (a still page, a restored screen). The same states with
// plain values and a snapped entry look and move the same under a live
// pointer, and hold.
let pa_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
pa_held_states(mod.widgets.ButtonFlat)
pa_held_states(mod.widgets.CheckBoxFlat)
pa_held_states(mod.widgets.ToggleFlat)
pa_held_states(mod.widgets.RadioButtonFlat)
pa_held_states(mod.widgets.RadioButtonTabFlat)
pa_held_states(mod.widgets.TextInputFlat)
pa_held_states(mod.widgets.DropDownFlat)

// ---------------------------------------------------------------------------
// CHECK BOXES. A box ten pixels square: an ink frame with its corners
// stepped off, a light well inside with a shade row under its top and down
// its left, and a lit lip under its foot where the cut catches the light.
// On, the well is dark and holds a lit pixel check; mixed, a lit bar.
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 5.0 bottom: 5.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 20.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(13.34)
mod.widgets.CheckBoxFlat.draw_bg.border_size = uniform(0.67)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(0.0)
mod.widgets.CheckBoxFlat.draw_text.color_error = #0d2117

// The mark box of a check box, radio or toggle, on the grid.
let pa_markbox = fn(size: vec2, o: vec2, w: float, hgt: float, at_end: float, b: float) -> vec4 {
    let x = (size.x - w) * at_end
    let y0 = pa_snap(size.y * 0.5 - hgt * 0.5, o.y, b)
    let x0 = pa_snap(x, o.x, b)
    return vec4(x0, y0, x0 + floor(w / b + 0.5) * b, y0 + floor(hgt / b + 0.5) * b)
}

// A segment from a to b: the distance to it.
let pa_seg = fn(p: vec2, a: vec2, c: vec2) -> float {
    let pa = p - a
    let ba = c - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A sunk well of pixels (check boxes, radio wells): its fill, a shade row
// along the top and left inside the frame, a lit lip outside its foot.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let hov = step(0.5, self.hover) * live
    let held = step(0.5, self.down) * live
    let sb = pa_markbox(self.rect_size, o, self.size, self.size, self.mark_at_end, b)
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    let on = step(0.5, self.active) * (1.0 - step(0.5, self.mixed))
    let mixd = step(0.5, self.mixed)
    let dark = max(on, mixd)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the lit lip under the foot and down the right, outside the frame
    let lip = pa_ring_out(d, 0.0, b) * max(step(sb.w, pc.y), step(sb.z, pc.x)) * live
    out = pa_lay(out, pa_light(), lip)
    // the well
    var col = mix(mix(pa_face(), pa_hi(), hov), pa_down(), held)
    col = mix(col, mix(mix(pa_dark(), pa_dark2(), hov), pa_deep(), held), dark)
    let tl = step(min(pc.x - sb.x, pc.y - sb.y), 2.0 * b)
    col = mix(col, mix(mix(pa_mute(), pa_mid(), held), pa_deep(), dark), tl)
    // disabled: a dithered mute
    let dcol = mix(pa_mute(), vec3(0.541, 0.627, 0.494), pa_checker(p, o, b))
    col = mix(col, dcol, dis)
    col = mix(col, mix(pa_ink(), pa_mid(), dis), rim_a)
    out = pa_lay(out, col, inside)
    // the check: a stepped stroke two pixels thick, ten pixels to the box
    let u = (pc - sb.xy) / max(sb.zw - sb.xy, vec2(b, b)) * 10.0
    // the check's pixels, one row mask per line of the ten: rows 2 to 6
    let ci = floor(u.x)
    let cj = floor(u.y)
    var mask = 0.0
    mask = mix(mask, 128.0, step(abs(cj - 2.0), 0.5))
    mask = mix(mask, 192.0, step(abs(cj - 3.0), 0.5))
    mask = mix(mask, 100.0, step(abs(cj - 4.0), 0.5))
    mask = mix(mask, 60.0, step(abs(cj - 5.0), 0.5))
    mask = mix(mask, 24.0, step(abs(cj - 6.0), 0.5))
    let bit = step(0.5, fract(floor(mask / pow(2.0, ci) + 0.001) * 0.5))
    let ck = bit * on * (1.0 - rim_a) * step(0.0, ci) * step(ci, 9.0)
    let bar = step(2.0, u.x) * step(u.x, 8.0) * step(4.0, u.y) * step(u.y, 6.0) * mixd
    let mk = max(ck, bar)
    out = pa_lay(out, mix(mix(pa_lit(), pa_light(), held), pa_mid(), dis), mk)
    // an error doubles the frame
    let er = pa_ring_out(d, 0.0, b) * step(0.5, self.error)
    out = pa_lay(out, pa_ink(), er)
    let kf = pa_focus(d, p, o, b) * step(0.5, self.focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false

// TOGGLES. A dark slot in an ink frame, two cells long; the knob is a
// light cap standing in one cell, and the other cell holds a small lamp,
// lit when the switch is on.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 39.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 4.0 bottom: 4.0}
mod.widgets.ToggleFlat.draw_bg.size = uniform(16.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(2.0)
mod.widgets.ToggleFlat.draw_bg.knob_inset = uniform(1.33)
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let hov = step(0.5, self.hover) * live
    let held = step(0.5, self.down) * live
    let tw = self.size * self.pill_aspect
    let sb = pa_markbox(self.rect_size, o, tw, self.size, self.mark_at_end, b)
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    let t = step(0.5, mix(self.active, self.drag_pos, self.drag))
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the lit lip under the foot
    let lip = pa_ring_out(d, 0.0, b) * step(sb.w, pc.y) * live
    out = pa_lay(out, pa_light(), lip)
    // the slot: dark, a deep row under its top edge; dithered under the
    // pointer
    var col = mix(pa_dark(), pa_deep(), step(pc.y, sb.y + 2.0 * b))
    col = mix(col, pa_dark2(), hov * pa_checker(p, o, b))
    col = mix(col, mix(pa_mute(), pa_mid(), pa_checker(p, o, b)), dis)
    col = mix(col, mix(pa_ink(), pa_mid(), dis), rim_a)
    out = pa_lay(out, col, inside)
    // the knob: a cap in one half, a pixel in from the frame
    let hw = (sb.z - sb.x) * 0.5
    let kx = sb.x + t * hw
    let kb = vec4(kx + b, sb.y + b, kx + hw - b * 0.0 + b * 0.0, sb.w - b)
    let kb2 = vec4(kb.x, kb.y, kx + hw, kb.w)
    let kface = mix(mix(pa_light(), pa_lit(), hov), pa_down(), held)
    let khl = mix(pa_lit(), pa_mute(), held)
    let ksh = mix(pa_mute(), pa_down(), held)
    let kf2 = mix(kface, vec3(0.604, 0.678, 0.541), dis)
    let knob = pa_cap(pc, b, kb2, 1.0, 1.0 - held, kf2, mix(khl, kf2, dis), mix(ksh, pa_mute(), dis), mix(pa_mid(), pa_mute(), dis), mix(pa_ink(), pa_mid(), dis), 0.0)
    out = pa_over(out, knob)
    // the lamp in the free half: two by two pixels, lit when on
    let lx = mix(sb.z - hw * 0.5, sb.x + hw * 0.5, t)
    let lc = vec2(pa_snap(lx, o.x, b), (sb.y + sb.w) * 0.5)
    let lq = abs(pc - lc)
    let la = step(max(lq.x, lq.y), b) * (1.0 - step(0.5, knob.a))
    let lcol = mix(pa_mid(), pa_lit(), t * live)
    out = pa_lay(out, lcol, la)
    let el = pa_ring_out(d, 0.0, b) * step(0.5, self.error)
    out = pa_lay(out, pa_ink(), el)
    let kf = pa_focus(d, p, o, b) * step(0.5, self.focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false

// RADIOS. A pixel circle ten across: an ink ring, a light well with a shade
// arc under its top and left, a lit lip under its foot. Chosen, a dark disc
// in the well with a lit two by two lamp in its middle.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 8.0 top: 5.0 bottom: 5.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 20.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(13.34)
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let hov = step(0.5, self.hover) * live
    let held = step(0.5, self.down) * live
    let sb = pa_markbox(self.rect_size, o, self.size, self.size, 0.0, b)
    let c = (sb.xy + sb.zw) * 0.5
    let rad = (sb.z - sb.x) * 0.5 - 0.15 * b
    let pc = pa_cell(p, o, b)
    let v = pc - c
    let r = length(v)
    let d = r - rad
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    let on = step(0.5, self.active)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let lip = step(rad, r) * step(r, rad + b) * step(0.35 * rad, v.y) * live
    out = pa_lay(out, pa_light(), lip)
    var col = mix(mix(pa_face(), pa_hi(), hov), pa_down(), held)
    // the shade arc: the ring inside the frame, on its upper left half
    let arc = step(-2.0 * b, d) * step(v.x + v.y, 0.0)
    col = mix(col, mix(pa_mute(), pa_mid(), held), arc)
    let dcol = mix(pa_mute(), vec3(0.541, 0.627, 0.494), pa_checker(p, o, b))
    col = mix(col, dcol, dis)
    col = mix(col, mix(pa_ink(), pa_mid(), dis), rim_a)
    out = pa_lay(out, col, inside)
    // the chosen disc and its lamp
    let disc = step(r, rad - 1.9 * b) * on
    out = pa_lay(out, mix(mix(pa_dark(), pa_deep(), held), pa_mid(), dis), disc)
    let lq = abs(v)
    let lamp = step(max(lq.x, lq.y), b) * on
    out = pa_lay(out, mix(pa_lit(), pa_light(), dis), lamp)
    let kf = step(rad + b, r) * step(r, rad + 2.0 * b) * pa_checker(p, o, b) * step(0.5, self.focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false

// A caption cap, the cell of a tab row or a radio tab: raised at rest, the
// light row dithered under the pointer; chosen or held, pushed in and dark
// with its lamp lit.
let pa_caption = fn(p: vec2, o: vec2, sb: vec4, b: float, chosen: float, hover: float, held: float, focus: float, disabled: float, lampw: float) -> vec4 {
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let hov = step(0.5, hover) * live
    let hd = step(0.5, held) * live
    let sel = step(0.5, chosen)
    let pc = pa_cell(p, o, b)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if sel + hd > 0.5 {
        let sbs = vec4(sb.x, sb.y + b, sb.z, sb.w)
        let face = mix(mix(pa_dark(), pa_dark2(), hov), pa_mute(), dis)
        out = pa_sunk(pc, b, sbs, 1.0, face, mix(pa_ink(), pa_mid(), dis), sel * live, lampw)
    } else {
        let face = mix(mix(pa_face(), pa_hi(), hov), pa_mute(), dis)
        let hl = mix(pa_light(), vec3(0.541, 0.627, 0.494), dis)
        let sh = mix(pa_mute(), pa_mute(), dis)
        out = pa_cap(pc, b, sb, 1.0, 1.0, face, hl, sh, mix(pa_deep(), pa_mid(), dis), mix(pa_ink(), pa_mid(), dis), 0.30 * live)
    }
    let kf = pa_focus(pa_dbox(pc, sb, 1.0, b), p, o, b) * step(0.5, focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}

// RADIO TABS: caption caps.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 5.0 bottom: 6.5}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 10.0 right: 10.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.draw_text.color = #0d2117
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #0d2117
mod.widgets.RadioButtonTabFlat.draw_text.color_down = #d6e0b2
mod.widgets.RadioButtonTabFlat.draw_text.color_focus = #0d2117
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #d6e0b2
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #435c42
mod.widgets.RadioButtonTabFlat.draw_text.text_style = mod.theme.font_label{}
