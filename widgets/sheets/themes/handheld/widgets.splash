use mod.prelude.widgets_internal.*

// Pixel art: a pale green dot-matrix glass, every control framed in
// square pixels.
// Everything is drawn on a grid of big pixels, two device pixels square,
// counted in window space so that every control shares one grid: a face
// finds the big pixel a point lies in and tests its shape at that pixel's
// centre, so every edge is a hard stair and no edge is ever soft. Controls
// are caps: a frame of ink with its corners stepped off, a light row along
// the top and left of the face, a shade row along the right and the foot,
// a dark thickness under the face and a one-pixel shadow to the lower
// right. A chosen cap is pushed in, dark, and lit by a small lamp. Wells
// are dark and hold lit words. Panels are dithered.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 4.5}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.spacing = 6.0
mod.widgets.Button.draw_bg.border_radius = 0.0
mod.widgets.Button.draw_bg.border_size = 0.67
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons stand at the same 26.
let field_height = 26.0
let field_pad_v = 3.0
let field_radius = 0.0
let field_border = 0.67

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #b0b0ae

// Plain views stop clipping, so a shadow pixel or a focus ring may fall
// into the gap beside a control. Scroll views keep theirs.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points and `b` one big pixel (two device pixels); `o` the
// quad's origin in the window.

// The palette: ink, the dark of wells and thickness, a second dark, the
// deepest shade, the mid green of shade rows, the mute of a disabled face,
// the glass, a cap's face, its face under the pointer and held, the light
// row of a bevel, and the lit green of lamps and words on dark.
let pa_ink = fn() -> vec3 { return vec3(0.051, 0.129, 0.090) }
let pa_dark = fn() -> vec3 { return vec3(0.184, 0.282, 0.212) }
let pa_dark2 = fn() -> vec3 { return vec3(0.243, 0.341, 0.267) }
let pa_deep = fn() -> vec3 { return vec3(0.118, 0.200, 0.149) }
let pa_mid = fn() -> vec3 { return vec3(0.369, 0.463, 0.341) }
let pa_mute = fn() -> vec3 { return vec3(0.482, 0.569, 0.439) }
let pa_ground = fn() -> vec3 { return vec3(0.478, 0.553, 0.400) }
let pa_face = fn() -> vec3 { return vec3(0.510, 0.592, 0.431) }
let pa_hi = fn() -> vec3 { return vec3(0.733, 0.796, 0.620) }
let pa_down = fn() -> vec3 { return vec3(0.576, 0.659, 0.494) }
let pa_light = fn() -> vec3 { return vec3(0.769, 0.827, 0.639) }
let pa_lit = fn() -> vec3 { return vec3(0.839, 0.878, 0.698) }
let pa_red = fn() -> vec3 { return vec3(0.420, 0.118, 0.094) }
let pa_redd = fn() -> vec3 { return vec3(0.353, 0.110, 0.086) }

let pa_g3 = fn(v: float) -> vec3 { return vec3(v, v, v) }

// Premultiplied source-over, and a colour laid at a coverage.
let pa_over = fn(dst: vec4, src: vec4) -> vec4 {
    return src + dst * (1.0 - src.a)
}
// THE SHELL. The light grey plastic of the handheld's shell: a faint
// speckle and fainter blotches, a little lighter toward the top and
// the left where the light falls. `w` is the point in window space.
let pa_plastic = fn(w: vec2, px: float) -> vec3 {
    let base = vec3(0.690, 0.690, 0.686)
    let fine = Finish.grain(w / px, 0.02)
    let cq = floor(w / 6.0)
    let blot = fract(sin(dot(cq, vec2(12.9898, 78.233))) * 43758.5453) - 0.5
    let band = 0.97 + 0.05 * (1.0 - clamp(w.y / 1000.0, 0.0, 1.0)) + 0.02 * (1.0 - clamp(w.x / 1400.0, 0.0, 1.0))
    return base * band + vec3(fine, fine, fine) + vec3(0.014, 0.014, 0.014) * blot
}

// The glass of a screen at a point in window space: a dark olive, the dot
// matrix (one device pixel row and column of every big pixel a shade
// darker), a grain one device pixel fine; `u` the point on the screen from
// 0 to 1, for the backlight: brighter toward the middle, dimmer in the
// corners (the darkest the ink still reads on, the suite's own bar), and
// a soft glow along the edges where the light enters.
let pa_glass_at = fn(w: vec2, u: vec2, px: float) -> vec3 {
    let q = floor(w / px + vec2(0.01, 0.01))
    let gx = step(0.5, fract(q.x * 0.5))
    let gy = step(0.5, fract(q.y * 0.5))
    let grid = max(gx, gy)
    var col = vec3(0.478, 0.553, 0.400)
    let v = u * 2.0 - vec2(1.0, 1.0)
    let r2 = clamp(dot(v, v) * 0.5, 0.0, 1.0)
    col = col * (1.12 - 0.16 * r2)
    let e = min(min(u.x, 1.0 - u.x), min(u.y, 1.0 - u.y))
    col = col + vec3(0.07, 0.07, 0.03) * (1.0 - smoothstep(0.0, 0.08, e))
    col = col * (1.0 - 0.05 * grid)
    col = col + pa_g3(Finish.grain(w / px, 0.018))
    return col
}

// A screen set into the plastic. From the outside in: `shell` points of
// the shell's plastic inside the box, grooved beside the slot; the slot,
// a thin dark gap where the
// glass panel sits in the plastic; the glass panel's printed border,
// `border` points of flat mid grey, its outer edge catching a line of
// light with a shadow under it only where it faces the light; and
// the LCD window under the glass,
// a black line at its edge and the panel's shadow falling in a few points
// from every side, more from the top, the green brighter toward the middle
// and glowing at the sides where the backlight enters; and a faint sheen
// across the whole panel, border and window alike.
let pa_lcd = fn(p: vec2, o: vec2, size: vec2, px: float, border: float, shell: float) -> vec4 {
    let w = p + o
    let lo = vec2(Finish.snap(o.x + shell, px), Finish.snap(o.y + shell, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - shell, px), Finish.snap(o.y + size.y - shell, px)) - o
    let hb = (hi - lo) * 0.5
    let c = lo + hb
    let fb = Finish.snap(border, px)
    let h = hb - vec2(fb, fb)
    let ro = min(5.0, min(hb.x, hb.y))
    let rg = max(ro - fb, 1.5)
    let qo = abs(p - c) - hb + vec2(ro, ro)
    let df = min(max(qo.x, qo.y), 0.0) + length(max(qo, vec2(0.0, 0.0))) - ro
    let qg = abs(p - c) - h + vec2(rg, rg)
    let dg = min(max(qg.x, qg.y), 0.0) + length(max(qg, vec2(0.0, 0.0))) - rg
    // which way the opening's edge faces here, for the light on the
    // edges
    let e = max(abs(p - c) - hb + vec2(ro, ro), vec2(0.0, 0.0))
    let nrm = sign(p - c) * e / max(length(e), 0.0001)
    let lit = 0.0 - (0.6 * nrm.x + 0.8 * nrm.y)
    // the plastic of the shell inside the box, continuous with the ground,
    // a shade darker in a groove beside the slot, and no line on it
    let slot = 1.5
    let inbox = step(0.0, p.x) * step(p.x, size.x) * step(0.0, p.y) * step(p.y, size.y)
    let pa = inbox * (1.0 - Finish.cover(df - slot, px))
    var col = pa_plastic(w, px)
    col = col * mix(0.86, 1.0, smoothstep(slot, slot + 3.5, df))
    var out = vec4(col * pa, pa)
    // the slot
    let sa = Finish.cover(df - slot, px) * (1.0 - Finish.cover(df, px))
    out = pa_over(out, vec4(vec3(0.21, 0.21, 0.22) * sa, sa))
    // the glass panel's border: the light comes from the top left and
    // from nowhere else, so only where the border's outer edge faces it,
    // along the top and the left, the edge rounds over in a soft bright
    // band two points wide and the border lies in shadow under that band,
    // gone six points in; the
    // foot and the right are the flat border; and the black line at the LCD
    let ba = Finish.cover(df, px) * (1.0 - Finish.cover(dg, px))
    let from = max(lit, 0.0)
    let rim = 1.0 - smoothstep(0.0, 2.0, 0.0 - df)
    let shd = smoothstep(0.5, 2.5, 0.0 - df) * (1.0 - smoothstep(2.5, 6.5, 0.0 - df))
    var bcol = vec3(0.360, 0.368, 0.384) + pa_g3(Finish.grain(w / px, 0.012))
    bcol = bcol * (1.0 - shd * 0.50 * from)
    bcol = bcol + vec3(1.0, 1.0, 1.0) * rim * rim * 0.40 * from
    bcol = mix(bcol, vec3(0.06, 0.06, 0.06), Finish.band(0.0 - dg, 0.0, px, px))
    out = pa_over(out, vec4(bcol * ba, ba))
    // the LCD window: the panel's shadow falling in, more from the top,
    // and the green brighter toward the middle
    let ga = Finish.cover(dg, px)
    let gl = c - h
    let u = (p - gl) / max(2.0 * h, vec2(1.0, 1.0))
    var gcol = pa_glass_at(w, u, px)
    let st = 1.0 - clamp((p.y - gl.y) / 7.0, 0.0, 1.0)
    let sa2 = 1.0 - clamp(-dg / 4.0, 0.0, 1.0)
    let sh = clamp(0.32 * st * st + 0.16 * sa2 * sa2, 0.0, 0.45)
    gcol = gcol * (1.0 - sh)
    out = pa_over(out, vec4(gcol * ga, ga))
    // the glass over border and window alike: a faint sheen from the top
    // left, so the two read as one panel
    let sheen = (1.0 - clamp((u.x + u.y) * 0.5, 0.0, 1.0)) * 0.05 * Finish.cover(df, px)
    out = out + vec4(sheen, sheen, sheen, 0.0)
    return out
}

let pa_lay = fn(dst: vec4, col: vec3, a: float) -> vec4 {
    return pa_over(dst, vec4(col * a, a))
}

let pa_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The big pixel p lies in, counted in the window, and its centre in the
// quad's own points.
let pa_idx = fn(p: vec2, o: vec2, b: float) -> vec2 {
    return floor((p + o) / b + vec2(0.001, 0.001))
}
let pa_cell = fn(p: vec2, o: vec2, b: float) -> vec2 {
    return (pa_idx(p, o, b) + vec2(0.5, 0.5)) * b - o
}
// A local coordinate moved to the nearest line of the grid.
let pa_snap = fn(v: float, o: float, b: float) -> float {
    return floor((o + v) / b + 0.5) * b - o
}
// A box snapped to the grid: .xy the low corner, .zw the high one.
let pa_sbox = fn(o: vec2, lo: vec2, hi: vec2, b: float) -> vec4 {
    return vec4(pa_snap(lo.x, o.x, b), pa_snap(lo.y, o.y, b), pa_snap(hi.x, o.x, b), pa_snap(hi.y, o.y, b))
}
// The distance from a pixel centre to a box with its corners stepped off
// by `notch` big pixels.
let pa_dbox = fn(pc: vec2, sb: vec4, notch: float, b: float) -> float {
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    return Finish.sd_chamfer(pc, c, h, notch * b * 1.2 + 0.001)
}
// Dithers on the big pixels: a checker, one pixel in four, and the ordered
// 2 x 2 threshold (0.125 .. 0.875).
let pa_checker = fn(p: vec2, o: vec2, b: float) -> float {
    let q = pa_idx(p, o, b)
    return step(0.5, fract((q.x + q.y) * 0.5))
}
let pa_quarter = fn(p: vec2, o: vec2, b: float) -> float {
    let q = pa_idx(p, o, b)
    return step(0.5, fract(q.x * 0.5)) * step(0.5, fract(q.y * 0.5))
}
let pa_bayer = fn(p: vec2, o: vec2, b: float) -> float {
    let q = pa_idx(p, o, b)
    let x = step(0.5, fract(q.x * 0.5))
    let y = step(0.5, fract(q.y * 0.5))
    return (mix(mix(0.0, 2.0, x), mix(3.0, 1.0, x), y) + 0.5) * 0.25
}
// A ring of pixels outside a shape: the k-th ring out (0 touches it).
let pa_ring_out = fn(d: float, k: float, b: float) -> float {
    return step(k * b, d) * step(d, (k + 1.0) * b)
}

// A RAISED CAP. `sb` its box on the grid; `notch` the corner step; `th`
// the rows of thickness under its face; `face` its face, `hl` the light row
// along its top and left, `sh` the shade row along its right and above its
// foot, `base` the thickness, `rim` the frame; `shadow` the alpha of the
// shadow one pixel to the lower right. Premultiplied.
let pa_cap = fn(pc: vec2, b: float, sb: vec4, notch: float, th: float, face: vec3, hl: vec3, sh: vec3, base: vec3, rim: vec3, shadow: float) -> vec4 {
    let d = pa_dbox(pc, sb, notch, b)
    let inside = step(d, 0.0)
    let ds = pa_dbox(pc - vec2(b, b), sb, notch, b)
    let sa = step(ds, 0.0) * (1.0 - inside) * shadow
    let out = vec4(pa_ink() * sa, sa)
    let rim_a = inside * step(-b, d)
    let foot = sb.w - (th + 1.0) * b
    let band = inside * (1.0 - rim_a) * step(foot, pc.y)
    let top = step(pc.y, sb.y + 2.0 * b)
    let left = step(pc.x, sb.x + 2.0 * b)
    let right = step(sb.z - 2.0 * b, pc.x)
    let bot = step(foot - b, pc.y)
    let lit = max(top, left)
    let shd = max(right, bot) * (1.0 - lit)
    var col = face
    col = mix(col, hl, lit)
    col = mix(col, sh, shd)
    col = mix(col, base, band)
    col = mix(col, rim, rim_a)
    return pa_over(out, vec4(col * inside, inside))
}

// A PUSHED-IN CAP, the chosen one of a group: sunk a pixel, dark, a deep
// row under its top edge and down its left, and a small lamp lit under its
// word (`lamp` 0 draws it unlit).
let pa_sunk = fn(pc: vec2, b: float, sb: vec4, notch: float, face: vec3, rim: vec3, lamp: float, lampw: float) -> vec4 {
    let d = pa_dbox(pc, sb, notch, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    let top = step(pc.y, sb.y + 2.0 * b)
    let left = step(pc.x, sb.x + 2.0 * b)
    var col = face
    col = mix(col, pa_deep(), max(top, left))
    // the lamp: a row of lit pixels over the bottom rim, the label's width
    // at most
    let cx = (sb.x + sb.z) * 0.5
    let ly = step(sb.w - 3.0 * b, pc.y) * step(pc.y, sb.w - 2.0 * b)
    let la = step(abs(pc.x - cx), lampw * b) * ly * inside
    col = mix(col, mix(pa_dark2(), pa_lit(), lamp), la)
    col = mix(col, rim, rim_a)
    return vec4(col * inside, inside)
}

// The dotted focus ring: every other pixel of the second ring out.
let pa_focus = fn(d: float, p: vec2, o: vec2, b: float) -> float {
    return pa_ring_out(d, 1.0, b) * pa_checker(p, o, b)
}

// A chevron pointing down, in whole pixels: 7 across and 4 deep, its top
// row at `at` (a pixel centre); coverage of the pixel at pc. Rows 0 and 1
// are two arms two pixels thick, row 2 the three middle pixels, row 3 the
// tip.
let pa_chevron = fn(pc: vec2, at: vec2, b: float) -> float {
    let q = floor((pc - at) / b + vec2(0.5, 0.5))
    let row = q.y
    let ax = abs(q.x)
    let arms = step(-0.5, row) * step(row, 1.5) * step(2.0 - row - 0.5, ax) * step(ax, 3.0 - row + 0.5)
    let r2 = step(abs(row - 2.0), 0.5) * step(ax, 1.5)
    let r3 = step(abs(row - 3.0), 0.5) * step(ax, 0.5)
    return max(arms, max(r2, r3))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; the template picks the kind:
// 0 the raised cap (frame 1 adds an ink keyline inside its light row, frame
//   2 dithers its face); 1 the primary, a dark cap in an ink, lit and ink
//   frame with a lamp under its word; 2 the outline, a frame with no cap;
//   3 the flat, bare until the pointer comes; 4 the warning cap, its
//   thickness and its word a dark red.
// The quad is grown 4 points for the shadow and the focus ring.
let pa_button_face = fn(p: vec2, o: vec2, size: vec2, b: float, kind: float, frame: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let hov = step(0.5, hover) * live
    let held = step(0.5, down) * live
    let foc = step(0.5, focus) * live
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    let pc = pa_cell(p, o, b)
    let flat = step(1.5, kind) * step(kind, 3.5)
    let primary = step(0.5, kind) * step(kind, 1.5)
    let danger = step(3.5, kind)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the cap drops a pixel while held
    let sbc = vec4(sb.x, sb.y + held * b * (1.0 - flat), sb.z, sb.w)
    let d = pa_dbox(pc, sbc, 1.0, b)
    if flat < 0.5 {
        let th = 1.0 - held
        var face = mix(mix(pa_face(), pa_hi(), hov), pa_down(), held)
        var hl = mix(pa_light(), pa_mute(), held)
        var sh = mix(pa_mute(), pa_down(), held)
        var base = mix(pa_deep(), pa_redd(), danger)
        face = mix(face, mix(mix(pa_dark(), pa_dark2(), hov), pa_deep(), held), primary)
        hl = mix(hl, mix(pa_lit(), pa_mid(), held), primary)
        sh = mix(sh, mix(pa_lit(), pa_dark(), held), primary)
        face = mix(face, pa_mute(), dis)
        hl = mix(hl, vec3(0.541, 0.627, 0.494), dis)
        sh = mix(sh, pa_mute(), dis)
        base = mix(base, pa_mid(), dis)
        let rim = mix(pa_ink(), pa_mid(), dis)
        out = pa_cap(pc, b, sbc, 1.0, th, face, hl, sh, base, rim, 0.30 * (1.0 - held) * live)
        // the face box: the cap above its thickness
        let foot = sbc.w - (th + 1.0) * b
        let df = pa_dbox(pc, vec4(sbc.x, sbc.y, sbc.z, foot), 1.0, b)
        // a keyline two pixels in: the primary's inner ink, the second
        // action's frame
        let second = step(0.5, frame) * step(frame, 1.5)
        let kl = step(-3.0 * b, df) * step(df, -2.0 * b) * max(primary, second) * step(pc.y, foot)
        out = pa_lay(out, mix(pa_ink(), pa_mid(), dis), kl)
        // the third action: its face dithered with the light row's colour
        let dith = step(1.5, frame) * step(df, -2.0 * b) * pa_checker(p, o, b) * step(pc.y, foot)
        out = pa_lay(out, mix(mix(pa_hi(), pa_light(), hov), pa_face(), held), dith * live)
        // the primary's lamp, in the thickness band under its word
        let cx = (sbc.x + sbc.z) * 0.5
        let ly = step(sbc.w - 2.0 * b, pc.y) * step(pc.y, sbc.w - b)
        let la = step(abs(pc.x - cx), 3.0 * b) * ly * primary
        out = pa_lay(out, mix(mix(pa_lit(), vec3(0.910, 0.933, 0.839), hov), pa_mid(), dis), la)
    } else {
        let bare = step(2.5, kind)
        // the frame: always for the outline, under the pointer or held for
        // the flat
        let show = max(1.0 - bare, max(hov, held))
        let inside = step(d, 0.0)
        let rim_a = inside * step(-b, d) * show
        let inner = inside * step(d, -b)
        let da = inner * pa_checker(p, o, b) * hov * (1.0 - held)
        out = pa_lay(out, pa_light(), da)
        out = pa_lay(out, pa_down(), inner * held)
        let rcol = mix(mix(pa_ink(), pa_mid(), bare * (1.0 - held)), pa_mid(), dis)
        out = pa_lay(out, rcol, rim_a)
        // the outline's light row under its top frame, a hint of a cap
        let hlr = inner * step(pc.y, sbc.y + 2.0 * b) * (1.0 - bare) * (1.0 - held)
        out = pa_lay(out, pa_light(), hlr * 0.0)
    }
    let kf = pa_focus(pa_dbox(pc, sb, 1.0, b), p, o, b) * foc
    out = pa_lay(out, pa_ink(), kf)
    return out
}

// The wait spinner the stock face drew, which this one must draw too: eight
// two-pixel blocks round the middle of the face, the lit one walking on the
// button's own animation clock.
let pa_wait = fn(p: vec2, o: vec2, c: vec2, b: float, anim: float, ink: vec3, ghost: vec3) -> vec4 {
    let pc = pa_cell(p, o, b)
    let v = pc - c
    var th = atan2(v.x, -v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let k = floor(th / (PI * 0.25) + 0.5)
    let ang = k * PI * 0.25
    let dir = vec2(sin(ang), -cos(ang))
    let q = v - dir * 4.0 * b
    let a = step(max(abs(q.x), abs(q.y)), b * 1.01)
    let head = floor(fract(anim) * 8.0)
    let age = fract((head - k) / 8.0 + 1.0)
    let lit = step(age, 0.2)
    let col = mix(ghost, ink, lit)
    return vec4(col * a, a)
}

let pa_button = fn(pos: vec2, size: vec2, o: vec2, px: float, kind: float, frame: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, m: float) -> vec4 {
    let b = 2.0 * px
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = pa_button_face(p, o, size, b, kind, frame, hover, down, focus, disabled)
    if loading > 0.001 {
        let c = vec2(pa_snap(size.x * 0.5, o.x, b), pa_snap(size.y * 0.5 - b, o.y, b))
        let dark = step(0.5, kind) * step(kind, 1.5)
        let ink = mix(pa_ink(), pa_lit(), dark)
        let ghost = mix(pa_mute(), pa_dark2(), dark)
        let w = pa_wait(p, o, c, b, anim, ink, ghost)
        out = pa_over(out, w * loading)
    }
    return out
}

mod.widgets.ButtonFlat.draw_bg.kind = uniform(3.0)
mod.widgets.ButtonFlat.draw_bg.frame = uniform(0.0)
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(pa_button(self.pos, self.rect_size, self.rect_pos, px, self.kind, self.frame, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 4.0), 4.0)
}
