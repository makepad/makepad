use mod.prelude.widgets_internal.*

// Cyberpunk: night-city street tech, after the Amp app's cyberpunk style. The
// window's ground is the hull of a machine: one continuous plate of satin
// polished purple-grey steel where the UI sits, under a cyan and a magenta
// light, framed at the window's edges by a raised band of machinery (THE
// HULL, below). A raised surface is a gunmetal plate cut with hard chamfers
// -- the top-left and bottom-right corners cut deep, the other two clipped --
// and edge-lit by a neon tube that runs cyan at the top into magenta at the
// foot, broken in a few places, with warning tape wrapped round its deep
// bottom-right cut. A button is a key in the same cut: a gunmetal cap with a
// holographic foil sheen and a neon pipe just inside its lip. Fields and
// screens are black glass with a cyan hairline; a screen's bezel carries a
// magenta-to-cyan tube and its glass a static chroma split. Meters are wedge
// ladders of slanted cells, cyan into magenta into warning yellow. Cyan is
// live (rest, hover, focus, a value), magenta is on or held, yellow warns.
// Static: nothing here reads a clock, so an idle window redraws nothing.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let cp_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let cp_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let cp_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// THE CUT. A box centred on `c`, half size `h`, its top-left and bottom-right
// corners cut `big` points along each edge and the other two `small`, both
// held inside the box.
let cp_cut = fn(p: vec2, c: vec2, h: vec2, big: float, small: float) -> float {
    let m = max(min(h.x, h.y) - 0.25, 0.0)
    let kb = min(big, m)
    let ks = min(small, m)
    return Finish.sd_notch(p, c, h, vec4(kb, ks, kb, ks))
}

// The shadow a part in THE CUT throws: its own chamfered outline moved by
// `off` and softened over `blur` either side of its edge, 0..1. A shadow
// cast from a plain box would show dark corners past the cuts.
let cp_cut_shade = fn(p: vec2, c: vec2, h: vec2, big: float, small: float, off: vec2, blur: float) -> float {
    return 1.0 - smoothstep(-blur, blur, cp_cut(p - off, c, h, big, small))
}

// The neon: electric cyan at 0 into hot magenta at 1.
let cp_neon = fn(t: float) -> vec3 {
    return mix(vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), clamp(t, 0.0, 1.0))
}

// A neon line `at` points inside an edge (`d` its distance): a white-hot core
// about `w` wide in its ink, and a halo of the ink falling over `reach`.
// Light, to add to a face.
let cp_tube = fn(d: float, at: float, w: float, reach: float, ink: vec3) -> vec3 {
    let x = abs(d + at)
    let line = 1.0 - smoothstep(w * 0.3, w, x)
    let halo = exp(-x / max(reach, 0.1)) * 0.35
    return mix(ink, vec3(1.0, 1.0, 1.0), line * 0.45) * line * 0.95 + ink * halo
}

// Focus: a cyan hairline one device pixel out from the edge and a short
// breath of it on the ground.
let cp_focus = fn(dst: vec4, d: float, px: float, on: float) -> vec4 {
    let out = 1.0 - Finish.cover(d - px * 2.0, px)
    let ring = Finish.ring_out(d, px, px * 2.0, px) + Finish.glow(d - px * 2.0, 1.2) * 0.4 * out
    return Finish.over(dst, vec4(0.08, 0.94, 1.0, 1.0) * clamp(ring, 0.0, 1.0) * on)
}

// A lit mark (a check, a dash): a white-hot core along the stroke's middle,
// the ink at its edges and a halo of the ink round it. `dk` is the distance
// to the stroke's edge, `w` its half width.
let cp_mark = fn(dst: vec4, dk: float, w: float, px: float, on: float, ink: vec3) -> vec4 {
    let x = max(dk, 0.0)
    let g = (0.35 * exp(-(x * x) / (2.0 * 0.6 * 0.6)) + 0.18 * exp(-(x * x) / (2.0 * 1.6 * 1.6))) * (1.0 - Finish.cover(dk, px))
    let res = Finish.over(dst, vec4(ink, 1.0) * g * on)
    let core = mix(ink, vec3(1.0, 1.0, 1.0), (1.0 - smoothstep(0.1 * w, 0.85 * w, dk + w)) * 0.8)
    return Finish.over(res, vec4(core, 1.0) * Finish.cover(dk, px) * on)
}

// ---------------------------------------------------------------- ground

// THE HULL. The window's ground is one machine's hull: a single continuous
// plate of steel across the middle of the window, where the UI is mounted,
// framed by a raised band of machinery along the top, under the caption,
// and by a thin lip down the sides and along the foot, where an app's panes
// scroll, so no content ever passes over the frame. The plate is satin
// polished steel in a purple-grey tone, sunk 18 points in the frame under
// its shadow, swirled with polishing arcs, and the neon is reflected in it
// as soft blocks of tube lines -- cyan on the left, magenta on the right --
// placed by the window's size, nothing in it repeating (`cp_ground`); just
// under the top band, where nothing scrolls, stand a group of deep slots
// and two small screws (`cp_edge_parts`). The two washes of the sheet's own
// light -- a broad cyan from above the upper left, a magenta from past the
// right edge (`cp_wash`) -- catch in glints on the edges that face them:
// the frame's bevels, the slots' rims, the screw heads and the frame's
// parts. The top band is 34 points deep, widening into chamfered blocks at
// its corners; the lips are 4 points (`cp_band`, `cp_opening`); where the
// plate meets it the frame rises on one clean chamfered lip, its crest lit,
// its facets lit where they face the light, and it lays a soft shadow on
// the plate under its upper and left edges. On the top band: stepped
// sub-plates and seams, vent and grille slots, bolts, octagonal lens ports
// with rings, hazard bars, barcodes and print, traces with 45 degree bends,
// and the sheet's own cyan and magenta in LEDs, the lit edge of the bevel
// round the plate taking the washes in place of a drawn line, with a rare
// red or amber light. It all stays dark, so the controls stay the brightest
// thing. The light comes from the upper left, mostly from above (`cp_lt`).
// Nothing reads the clock.

let cp_lt = fn() -> vec2 {
    return vec2(-0.5, -0.866)
}

// The cyan, the magenta and the two warning lights, picked by `t` 0..1:
// cyan and magenta mostly, red one time in eight, amber one in twelve.
let cp_lamp_ink = fn(t: float) -> vec3 {
    if t < 0.48 {
        return vec3(0.08, 0.94, 1.0)
    }
    if t < 0.835 {
        return vec3(1.0, 0.12, 0.72)
    }
    if t < 0.92 {
        return vec3(1.0, 0.16, 0.10)
    }
    return vec3(1.0, 0.62, 0.10)
}

// A box centred on `c`, half size `h`, its corners rounded by `r`.
let cp_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A part standing on a face of colour `col`, its own face `top`, from its
// distance `d` and the distances `dl` and `ds` a bevel `bw` toward and away
// from the light: the facet toward the light lit, the one away shaded, a
// short shadow on the face round its foot.
let cp_raise = fn(col: vec3, top: vec3, d: float, dl: float, ds: float, bw: float, px: float) -> vec3 {
    let a = Finish.cover(d, px)
    let lit = clamp(dl / bw, 0.0, 1.0)
    let shade = clamp(ds / bw, 0.0, 1.0)
    let cast = clamp(0.5 - dl / bw, 0.0, 1.0)
    let up = top + vec3(0.080, 0.085, 0.097) * lit - top * 0.45 * shade
    return mix(col * (1.0 - 0.42 * cast), up, a)
}

// A hole sunk into a face of colour `col`, the same three distances: its
// floor dark, the face's shadow in under its upper wall, a lit lip along
// its lower wall.
let cp_sink = fn(col: vec3, d: float, dl: float, ds: float, bw: float, px: float) -> vec3 {
    let a = Finish.cover(d, px)
    let sh = clamp(0.5 + dl / bw, 0.0, 1.0)
    let lit = clamp(ds / bw, 0.0, 1.0)
    let bot = col * 0.40 * (1.0 - 0.45 * sh) + vec3(0.045, 0.048, 0.055) * lit
    return mix(col, bot, a)
}

// A row of `n` vent slots from `o` (the block's top left), `len` points
// long and 2.4 wide on a 5 point pitch, standing upright in a row across
// (`across` 1) or lying in a stack down. Only the slot nearest the pixel is
// worked out.
let cp_vents = fn(col: vec3, p: vec2, o: vec2, n: float, len: float, across: float, px: float) -> vec3 {
    let q = p - o
    let u = mix(q.y, q.x, across)
    let i = clamp(floor(u / 5.0), 0.0, n - 1.0)
    let cu = (i + 0.5) * 5.0
    let c = o + mix(vec2(len * 0.5, cu), vec2(cu, len * 0.5), across)
    let h = mix(vec2(len * 0.5, 1.2), vec2(1.2, len * 0.5), across)
    let d = cp_rbox(p, c, h, 1.2)
    let dl = cp_rbox(p + cp_lt() * 1.2, c, h, 1.2)
    let ds = cp_rbox(p - cp_lt() * 1.2, c, h, 1.2)
    return cp_sink(col, d, dl, ds, 1.2, px)
}

// A bolt at `c`: a domed head in a countersink.
let cp_bolt = fn(col: vec3, p: vec2, c: vec2, px: float) -> vec3 {
    let q = p - c
    var res = cp_sink(col, length(q) - 2.7, length(q + cp_lt() * 0.9) - 2.7, length(q - cp_lt() * 0.9) - 2.7, 0.9, px)
    return cp_raise(res, col * 1.2, length(q) - 1.8, length(q + cp_lt() * 1.0) - 1.8, length(q - cp_lt() * 1.0) - 1.8, 1.0, px)
}

// A port at `c` of bore radius `r`: an octagonal collar standing on the
// face, the bore sunk in it with a groove ringed round it, a lens of dark
// glass in its middle with a crisp spark of the light, and with `glow` a
// small lamp of `ink` at the lens's heart.
let cp_port = fn(col: vec3, p: vec2, c: vec2, r: float, ink: vec3, glow: float, px: float) -> vec3 {
    let q = p - c
    let rr = length(q)
    let hc = vec2(r + 5.0, r + 5.0)
    let kc = (r + 5.0) * 0.58
    var res = cp_raise(col, col * 1.08, Finish.sd_chamfer(p, c, hc, kc), Finish.sd_chamfer(p + cp_lt() * 1.4, c, hc, kc), Finish.sd_chamfer(p - cp_lt() * 1.4, c, hc, kc), 1.4, px)
    res = cp_sink(res, rr - r, length(q + cp_lt() * 1.6) - r, length(q - cp_lt() * 1.6) - r, 1.6, px)
    let groove = Finish.cover(abs(rr - r * 0.76) - px * 0.5, px)
    res = mix(res, res * 0.45, groove)
    let rl = r * 0.48
    res = cp_raise(res, vec3(0.030, 0.032, 0.040), rr - rl, length(q + cp_lt() * 1.0) - rl, length(q - cp_lt() * 1.0) - rl, 1.0, px)
    let sp = Finish.cover(length(q + vec2(0.36, 0.44) * rl) - max(rl * 0.13, px * 0.7), px)
    res = res + vec3(0.30, 0.32, 0.36) * sp * 0.55
    return res + ink * (Finish.cover(rr - rl * 0.28, px) * 0.75 + exp(-rr / max(rl * 0.35, 0.5)) * 0.25) * glow
}

// Hazard bars in the box `lo`..`hi`: bars of `ink` 2.5 points wide on a 5
// point pitch, leaning at 45 degrees, on a darker ground.
let cp_hull_bars = fn(col: vec3, p: vec2, lo: vec2, hi: vec2, ink: vec3, px: float) -> vec3 {
    let box = Finish.cover(cp_rbox(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 0.0), px)
    let t = (p.x - p.y) * 0.70710678 / 5.0
    let bar = Finish.cover((abs(fract(t) - 0.5) - 0.25) * 5.0, px)
    return mix(col, mix(col * 0.55, ink, bar), box)
}

// A barcode printed in the box `lo`..`hi`: bars on a 2 point pitch, each
// 0.6 to 1.2 points wide or left out, hashed from its column.
let cp_barcode = fn(col: vec3, p: vec2, lo: vec2, hi: vec2, ink: vec3, px: float) -> vec3 {
    let box = cp_rbox(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 0.0)
    let x = p.x - lo.x
    let ci = floor(x / 2.0)
    let hb = Finish.hash(vec2(ci * 1.37 + lo.y * 0.11, lo.x * 0.29 + 3.0))
    let bw = 0.6 + 0.6 * hb
    let xb = x - ci * 2.0
    let d = max(max(0.4 - xb, xb - 0.4 - bw), box) + step(hb, 0.22) * 10.0
    return mix(col, ink, Finish.cover(d, px))
}

// Print: `rows` lines of tiny glyphs from `o`, on a 3.4 point leading, each
// glyph a dash 1.3 points wide on a 1.9 point pitch, spaces and line ends
// hashed, as small type reads from a little way off.
let cp_print = fn(col: vec3, p: vec2, o: vec2, len: float, rows: float, ink: vec3, px: float) -> vec3 {
    let q = p - o
    let ri = clamp(floor(q.y / 3.4), 0.0, rows - 1.0)
    let gi = floor(q.x / 1.9)
    let line = len * (0.45 + 0.55 * Finish.hash(vec2(ri * 7.1 + o.x * 0.13, o.y * 0.17)))
    let gap = step(Finish.hash(vec2(gi * 1.31 + ri * 17.7, o.x * 0.07 + o.y * 0.03)), 0.2)
    let gx = q.x - gi * 1.9
    let gy = q.y - ri * 3.4
    let d = max(max(max(0.3 - gx, gx - 1.6), max(0.6 - gy, gy - 2.1)), max(-q.x, q.x - line)) + gap * 10.0
    return mix(col, ink, Finish.cover(d, px))
}

// A crosshair at `c`: two arms 7 points across, one device pixel wide on
// the pixel's middle.
let cp_cross = fn(col: vec3, p: vec2, c: vec2, ink: vec3, px: float) -> vec3 {
    let cc = (floor(c / px) + vec2(0.5, 0.5)) * px
    let q = abs(p - cc)
    let d = min(max(q.x - 3.5, q.y - px * 0.5), max(q.y - 3.5, q.x - px * 0.5))
    return mix(col, ink, Finish.cover(d, px))
}

// A trace from `a` along to `b`, across a 45 degree bend to `c` and along
// to `e`: cut into the face as a groove with a lit lower lip, or with `lit`
// a thin line of `ink`, a ring at its start and a pad at its end.
let cp_trace = fn(col: vec3, p: vec2, a: vec2, b: vec2, c: vec2, e: vec2, ink: vec3, lit: float, px: float) -> vec3 {
    let d = min(min(cp_seg(p, a, b), cp_seg(p, b, c)), cp_seg(p, c, e))
    let pl = p + cp_lt() * 0.8
    let ps = p - cp_lt() * 0.8
    let dl = min(min(cp_seg(pl, a, b), cp_seg(pl, b, c)), cp_seg(pl, c, e))
    let ds = min(min(cp_seg(ps, a, b), cp_seg(ps, b, c)), cp_seg(ps, c, e))
    let ring = abs(length(p - a) - 2.2) - 0.6
    let pad = length(p - e) - 1.6
    let groove = cp_sink(col, min(min(d - 0.6, ring), pad), dl - 0.6, ds - 0.6, 0.8, px)
    let core = Finish.cover(min(d - px * 0.5, pad), px)
    let halo = exp(-max(min(d, pad), 0.0) / 1.6) * (1.0 - core)
    return groove + ink * (core * 0.5 + halo * 0.16) * lit
}

// A row of `n` LEDs from `o`, `stride` apart, each a lamp of `ink` in a
// small housing with a halo round it.
let cp_leds = fn(col: vec3, p: vec2, o: vec2, n: float, stride: vec2, ink: vec3, px: float) -> vec3 {
    let i = clamp(floor(dot(p - o, stride) / max(dot(stride, stride), 0.01) + 0.5), 0.0, n - 1.0)
    let c = o + stride * i
    let q = p - c
    let r = length(q)
    let res = cp_sink(col, r - 1.7, length(q + cp_lt() * 0.7) - 1.7, length(q - cp_lt() * 0.7) - 1.7, 0.7, px)
    let lamp = Finish.cover(r - 1.0, px)
    return res + ink * (lamp * 0.8 + exp(-r / 1.5) * 0.3 * (1.0 - lamp))
}

// An engraved line from `a` along to `b`, across a 45 degree jog to `c`
// and along to `e`: a groove a point wide with a lit lower lip.
let cp_groove = fn(col: vec3, p: vec2, a: vec2, b: vec2, c: vec2, e: vec2, px: float) -> vec3 {
    let pl = p + cp_lt() * 0.7
    let ps = p - cp_lt() * 0.7
    let d = min(min(cp_seg(p, a, b), cp_seg(p, b, c)), cp_seg(p, c, e)) - 0.5
    let dl = min(min(cp_seg(pl, a, b), cp_seg(pl, b, c)), cp_seg(pl, c, e)) - 0.5
    let ds = min(min(cp_seg(ps, a, b), cp_seg(ps, b, c)), cp_seg(ps, c, e)) - 0.5
    return cp_sink(col, d, dl, ds, 0.7, px)
}

// THE WASHES: the two lights on the hull in a window of `size`, at `w`.
// The cyan comes broad and soft from above the window's upper left third,
// the magenta from just past its right edge a little below the middle,
// each falling away with distance, hotter close in. .xy the cyan's
// strength and the magenta's.
let cp_wash = fn(w: vec2, size: vec2) -> vec2 {
    let diag = length(size)
    let qc = (w - vec2(size.x * 0.30, -size.y * 0.14)) / (diag * 0.36)
    let qm = (w - vec2(size.x * 1.07, size.y * 0.56)) / (diag * 0.24)
    return vec2(exp(-dot(qc, qc)) + 0.5 * exp(-dot(qc, qc) * 6.0), exp(-dot(qm, qm)) + 0.9 * exp(-dot(qm, qm) * 4.0))
}

// The unit directions from `w` toward the cyan light (.xy) and the
// magenta (.zw).
let cp_wash_dir = fn(w: vec2, size: vec2) -> vec4 {
    let dc = normalize(vec2(size.x * 0.30, -size.y * 0.14) - w)
    let dm = normalize(vec2(size.x * 1.07, size.y * 0.56) - w)
    return vec4(dc.x, dc.y, dm.x, dm.y)
}

// The light a facet of metal `base` takes when it leans the way `n` (a unit
// vector in the window, or zero for flat): the white light from the upper
// left lights it or shades it, with a sharp glint where it faces it full,
// and each wash lights it in its own colour as it leans toward that light,
// a broad glow and a sharp glint (`lw` their strengths, `ld` their
// directions).
let cp_facet = fn(base: vec3, n: vec2, lw: vec2, ld: vec4) -> vec3 {
    let k = dot(n, cp_lt())
    var col = base * (1.0 + 0.55 * max(k, 0.0) - 0.55 * max(-k, 0.0)) + vec3(0.06, 0.064, 0.072) * max(k, 0.0) + vec3(0.16, 0.17, 0.19) * pow(max(k, 0.0), 6.0)
    let kc = max(dot(n, ld.xy), 0.0)
    let km = max(dot(n, ld.zw), 0.0)
    col = col + vec3(0.20, 0.85, 1.0) * min(lw.x, 1.2) * (kc * 0.22 + pow(kc, 6.0) * 0.40)
    return col + vec3(1.0, 0.22, 0.75) * min(lw.y, 1.4) * (km * 0.22 + pow(km, 6.0) * 0.40)
}

// One polishing swirl from the cell `id` (of `cell` points), if it has one:
// a sector of fine concentric scratches round a centre near the cell's
// middle, fading at its ends and edges. Its strength at `p`, 0..1.
let cp_swirl1 = fn(p: vec2, id: vec2, cell: float, salt: float, px: float) -> float {
    let h1 = Finish.hash(id + vec2(salt * 7.7, salt * 3.1))
    if h1 > 0.6 {
        return 0.0
    }
    let c = (id + vec2(0.5, 0.5) + (vec2(Finish.hash(id + vec2(1.3, salt)), Finish.hash(id + vec2(salt, 2.9))) - vec2(0.5, 0.5)) * 0.5) * cell
    let q = p - c
    let r = length(q)
    let r0 = cell * (0.12 + 0.28 * Finish.hash(id + vec2(4.4, salt)))
    let wid = cell * (0.12 + 0.23 * Finish.hash(id + vec2(salt, 6.6)))
    if r < r0 || r > r0 + wid {
        return 0.0
    }
    let a = atan2(q.y, q.x) + 3.14159
    let a0 = Finish.hash(id + vec2(8.8, salt)) * 6.2832
    let span = 0.9 + 1.8 * Finish.hash(id + vec2(salt, 9.9))
    let da = fract((a - a0) / 6.2832) * 6.2832
    if da > span {
        return 0.0
    }
    let fade = sin(da / span * 3.14159) * sin((r - r0) / wid * 3.14159)
    let ri = floor(r / 1.4)
    let li = Finish.hash(vec2(ri * 1.37, h1 * 91.0 + salt))
    let line = Finish.cover(abs(r - (ri + 0.5) * 1.4) - px * 0.4, px) * step(0.45, li)
    return line * fade * (0.4 + 0.6 * li)
}

// The swirls at `p`: from the cell it is in and its eight neighbours, so
// arcs cross cell edges and no cell shows.
let cp_swirls = fn(p: vec2, cell: float, salt: float, px: float) -> float {
    let id = floor(p / cell)
    var m = cp_swirl1(p, id, cell, salt, px)
    m = max(m, cp_swirl1(p, id + vec2(-1.0, -1.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(0.0, -1.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(1.0, -1.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(-1.0, 0.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(1.0, 0.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(-1.0, 1.0), cell, salt, px))
    m = max(m, cp_swirl1(p, id + vec2(0.0, 1.0), cell, salt, px))
    return max(m, cp_swirl1(p, id + vec2(1.0, 1.0), cell, salt, px))
}

// A neon shape reflected in the metal: a soft-edged block round (`cx`,
// `cy`) of half size (`hx`, `hy`) in the window's 0..1 coordinates `uv`,
// made of horizontal tube lines `pitch` points apart, a little broken. 0..1.
let cp_reflection = fn(uv: vec2, p: vec2, cx: float, cy: float, hx: float, hy: float, pitch: float) -> float {
    let qx = (uv.x - cx) / hx
    let qy = (uv.y - cy) / hy
    let soft = exp(-qx * qx * qx * qx - qy * qy * 1.6)
    let line = pow(0.5 + 0.5 * cos(p.y / pitch * 6.2832), 3.0)
    return soft * (0.55 + 0.45 * line) * (0.85 + 0.3 * Finish.noise(p / 23.0))
}

// The plate's metal at window point `w` in a window of `size`, after his
// purple-grey panel: satin polished steel in a purple-grey tone, a step
// darker than his. Cyan light spreads softly over it from the left and
// magenta from the right, and neon shapes are reflected in it as soft
// blocks of horizontal tube lines, placed by the window's size: cyan left
// of the middle, a cyan strip under the top right and a short one low on
// the left; magenta at the right and toward the lower right. Over it all
// swirled polishing marks -- arcs of fine concentric scratches round many
// centres, curving every way -- catch whatever light falls on them; a fine
// speckle and a few grime flecks. Nothing in it runs one way or repeats
// across the window. Also the frame's metal, a shade darker.
let cp_ground = fn(w: vec2, size: vec2, px: float) -> vec3 {
    let uv = w / max(size, vec2(1.0, 1.0))
    var col = vec3(0.300, 0.262, 0.322) * (0.94 + 0.12 * Finish.fbm(w / 160.0))
    // The soft light from the sides.
    let cl = exp(-uv.x / 0.30) * (0.7 + 0.3 * Finish.noise(w / 210.0 + vec2(3.0, 1.0)))
    let cm = exp(-(1.0 - uv.x) / 0.27) * (0.7 + 0.3 * Finish.noise(w / 190.0 + vec2(7.0, 5.0)))
    let lcol = vec3(0.02, 0.30, 0.36) * cl + vec3(0.54, -0.15, 0.35) * cm + vec3(-0.02, -0.04, 0.0) * exp(-(1.0 - uv.x) / 0.45)
    col = col + lcol
    // The reflected neon.
    let rc = cp_reflection(uv, w, 0.235, 0.36, 0.08, 0.075, 9.0) * 0.85 + cp_reflection(uv, w, 0.80, 0.112, 0.12, 0.016, 7.0) * 0.8 + cp_reflection(uv, w, 0.30, 0.905, 0.06, 0.022, 8.0) * 0.6
    let rm = cp_reflection(uv, w, 0.87, 0.60, 0.11, 0.07, 10.0) + cp_reflection(uv, w, 0.73, 0.875, 0.12, 0.028, 8.0) * 0.9
    col = col + vec3(-0.02, 0.62, 0.75) * rc + vec3(0.66, -0.08, 0.47) * rm
    // The swirls catch the light that is on them.
    let sw = max(cp_swirls(w, 150.0, 1.0, px), cp_swirls(w + vec2(41.0, 77.0), 97.0, 2.0, px) * 0.8)
    col = col + (vec3(0.10, 0.095, 0.11) + lcol * 1.2 + vec3(0.0, 0.5, 0.5) * rc + vec3(0.5, 0.22, 0.36) * rm) * sw * 0.55
    // Speckle and a few grime flecks.
    let q = w / px
    let fl = smoothstep(0.72, 0.80, Finish.noise(q * 0.62 + vec2(1.7, 4.1)))
    let fd = smoothstep(0.70, 0.76, Finish.noise(q * 0.55 + vec2(8.3, 0.9))) * smoothstep(0.45, 0.7, Finish.noise(w / 37.0))
    col = col * (1.0 + 0.07 * fl - 0.12 * fd) * 0.58
    let g = Finish.grain(q, 0.006)
    return col + vec3(g, g, g)
}

// The frame's widths round a window of `size`: x left, y top, z right, w
// bottom. Only the top is a band of machinery, under the caption, where
// nothing scrolls; the sides and the foot, where an app's panes run to the
// window's edge and scroll, are a lip of 4 points, so no content ever
// passes over the frame.
let cp_band = fn(size: vec2) -> vec4 {
    let s = clamp(min(size.x / 900.0, size.y / 600.0), 0.4, 1.0)
    return vec4(4.0, 34.0 * s, 4.0, 4.0)
}

// The corner block nearest `p`, from its window corner inward: .xy its
// width and depth, .z the 45 degree cut on its inner corner. Only the top
// corners have one; at the foot it is empty.
let cp_block = fn(p: vec2, size: vec2, s: float) -> vec3 {
    let top = 1.0 - step(size.y * 0.5, p.y)
    return vec3(vec2(150.0, 50.0) * s * top, 16.0 * s * top)
}

// THE OPENING: the plate's signed distance (negative on the plate) at `p`
// in a window of `size`, its frame `band` wide, widened at each corner by
// its block.
let cp_opening = fn(p: vec2, size: vec2, band: vec4, s: float) -> float {
    let lo = band.xy
    let hi = size - band.zw
    let d = Finish.sd_notch(p, (lo + hi) * 0.5, (hi - lo) * 0.5, vec4(0.0, 0.0, 0.0, 0.0))
    let right = step(size.x * 0.5, p.x)
    let down = step(size.y * 0.5, p.y)
    let blk = cp_block(p, size, s)
    let corner = vec2(right * size.x, down * size.y)
    let dir = vec2(1.0 - 2.0 * right, 1.0 - 2.0 * down)
    let far = corner + dir * blk.xy
    let near = corner - dir * 40.0
    let blo = min(near, far)
    let bhi = max(near, far)
    let kv = vec4(right * down, (1.0 - right) * down, (1.0 - right) * (1.0 - down), right * (1.0 - down)) * blk.z
    return max(d, -Finish.sd_notch(p, (blo + bhi) * 0.5, (bhi - blo) * 0.5, kv))
}

// What stands in a top corner block: a stepped sub-plate, and on it vents,
// a barcode with print, a small port and bolts -- or, under the window's
// buttons on the right, only a row of LEDs and print low in the block --
// and a crosshair at its foot. Laid out from the window corner inward and
// mirrored into each top corner.
let cp_corner_parts = fn(col: vec3, p: vec2, size: vec2, s: float, deco: vec3, px: float) -> vec3 {
    let right = step(size.x * 0.5, p.x)
    let corner = vec2(right * size.x, 0.0)
    let dir = vec2(1.0 - 2.0 * right, 1.0)
    let blk = cp_block(p, size, s)
    // The sub-plate, its inner corner cut as the block's is.
    let sq0 = vec2(26.0, 7.0) * s
    let sq1 = blk.xy - vec2(10.0, 9.0) * s
    let sa = corner + dir * sq0
    let sb = corner + dir * sq1
    let sc = (sa + sb) * 0.5
    let sh = abs(sb - sa) * 0.5
    let kv = vec4(0.0, 0.0, 1.0 - right, right) * blk.z * 0.8
    var res = cp_raise(col, col * 1.22, Finish.sd_notch(p, sc, sh, kv), Finish.sd_notch(p + cp_lt() * 1.4, sc, sh, kv), Finish.sd_notch(p - cp_lt() * 1.4, sc, sh, kv), 1.4, px)
    if right > 0.5 {
        res = cp_leds(res, p, corner + dir * vec2(34.0, 36.0) * s, 3.0, vec2(dir.x * 4.5, 0.0), cp_lamp_ink(Finish.hash(vec2(right, 7.7))), px)
        res = cp_print(res, p, corner + vec2(-132.0, 34.0) * s, 76.0 * s, 2.0, deco, px)
    } else {
        let n = 6.0
        let va = corner + dir * vec2(42.0 * s, 12.0 * s)
        let vb = corner + dir * vec2(42.0 * s + n * 5.0, 36.0 * s)
        res = cp_vents(res, p, min(va, vb), n, 24.0 * s, 1.0, px)
        let ba = corner + dir * vec2(80.0, 13.0) * s
        let bb = corner + dir * vec2(112.0, 22.0) * s
        res = cp_barcode(res, p, min(ba, bb), max(ba, bb), deco, px)
        res = cp_print(res, p, min(ba, bb) + vec2(0.0, 12.0 * s), 32.0 * s, 2.0, deco, px)
        res = cp_port(res, p, corner + dir * vec2(125.0, 21.0) * s, 5.5 * s, cp_lamp_ink(Finish.hash(vec2(right, 7.7))), step(0.5, Finish.hash(vec2(right, 8.8))), px)
        res = cp_bolt(res, p, corner + dir * vec2(32.0, 13.0) * s, px)
        res = cp_bolt(res, p, corner + dir * vec2(32.0, 35.0) * s, px)
    }
    return cp_cross(res, p, corner + dir * vec2(10.0 * s, blk.y - 12.0 * s), deco, px)
}

// What stands along the top band between the corner blocks, in cells of
// 120 points, each by its hash: a seam across the band, and a row of vents,
// a stepped sub-plate with a bolt at each end, hazard bars, a trace with a
// 45 degree bend, a barcode with print, a row of LEDs, a pair of bolts,
// grooves jogging together, or nothing; the middle is left plain under the
// window's title.
let cp_strip_parts = fn(col: vec3, p: vec2, size: vec2, band: vec4, s: float, deco: vec3, px: float) -> vec3 {
    // The run between the top corner blocks; the sides and the foot are
    // a bare lip.
    if p.y > band.y + 1.0 {
        return col
    }
    let u = p.x
    let t = band.y
    let ua = 150.0 * s
    let ub = size.x - 150.0 * s
    let pitch = 120.0 * s
    let ci = floor((u - ua) / pitch)
    let u0 = ua + ci * pitch
    if u < ua || u0 + pitch > ub {
        return col
    }
    var h = Finish.hash(vec2(ci * 1.37, 5.0))
    let h2 = Finish.hash(vec2(ci * 0.91, 9.0))
    // The middle of the top is left plain under the window's title.
    if abs(u0 + pitch * 0.5 - size.x * 0.5) < 130.0 * s {
        h = 1.0
    }
    let us = t - 10.0 * s
    let v0 = 4.0 * s
    var res = col
    if h2 < 0.5 {
        res = cp_groove(res, p, vec2(u0, -2.0), vec2(u0, -2.0), vec2(u0, -2.0), vec2(u0, t - 6.0 * s), px)
    }
    if h < 0.18 {
        let n = 8.0
        let len = us * 0.7
        let a = vec2(u0 + 30.0 * s, v0 + us * 0.15)
        let b = vec2(u0 + 30.0 * s + n * 5.0, v0 + us * 0.85)
        return cp_vents(res, p, min(a, b), n, len, 1.0, px)
    }
    if h < 0.32 {
        let a = vec2(u0 + 10.0 * s, v0)
        let b = vec2(u0 + pitch - 10.0 * s, v0 + us)
        let c = (a + b) * 0.5
        let hh = abs(b - a) * 0.5
        let k = min(min(hh.x, hh.y), 6.0 * s)
        let kk = vec4(k, k, k, k)
        res = cp_raise(res, col * 1.22, Finish.sd_notch(p, c, hh, kk), Finish.sd_notch(p + cp_lt() * 1.2, c, hh, kk), Finish.sd_notch(p - cp_lt() * 1.2, c, hh, kk), 1.2, px)
        res = cp_bolt(res, p, vec2(u0 + 22.0 * s, v0 + us * 0.5), px)
        return cp_bolt(res, p, vec2(u0 + pitch - 22.0 * s, v0 + us * 0.5), px)
    }
    if h < 0.44 {
        let a = vec2(u0 + 26.0 * s, v0 + us * 0.5 - min(4.5 * s, us * 0.35))
        let b = vec2(u0 + 70.0 * s, v0 + us * 0.5 + min(4.5 * s, us * 0.35))
        return cp_hull_bars(res, p, min(a, b), max(a, b), mix(deco, vec3(0.36, 0.10, 0.27), step(0.6, h2)), px)
    }
    if h < 0.56 {
        let j = us * 0.5
        let va = v0 + us * 0.25
        let ink = mix(vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), step(0.5, h2))
        let a = vec2(u0 + 12.0 * s, va)
        let b = vec2(u0 + 50.0 * s, va)
        let c = vec2(u0 + 50.0 * s + j, va + j)
        let e = vec2(u0 + pitch - 14.0 * s, va + j)
        return cp_trace(res, p, a, b, c, e, ink, step(0.55, Finish.hash(vec2(ci * 2.3, 1.0))), px)
    }
    let along = vec2(4.5, 0.0)
    if h < 0.68 {
        if us > 16.0 {
            let a = vec2(u0 + 30.0 * s, v0 + us * 0.5 - 6.0 * s)
            let b = vec2(u0 + 66.0 * s, v0 + us * 0.5 + 2.0 * s)
            let lo = min(a, b)
            res = cp_barcode(res, p, lo, max(a, b), deco, px)
            return cp_print(res, p, lo + vec2(0.0, 10.0 * s), 36.0 * s, 1.0, deco, px)
        }
        return cp_leds(res, p, vec2(u0 + 40.0 * s, v0 + us * 0.5), 2.0, along, cp_lamp_ink(h2), px)
    }
    if h < 0.8 {
        return cp_leds(res, p, vec2(u0 + 36.0 * s, v0 + us * 0.5), 3.0, along, cp_lamp_ink(h2), px)
    }
    if h < 0.9 {
        res = cp_bolt(res, p, vec2(u0 + 14.0 * s, v0 + us * 0.5), px)
        return cp_bolt(res, p, vec2(u0 + pitch - 14.0 * s, v0 + us * 0.5), px)
    }
    if h < 0.999 {
        // Two or three grooves side by side along the strip, jogging
        // together at 45 degrees.
        let j = us * 0.35
        let ga = u0 + 10.0 * s
        let gb = u0 + pitch * 0.45
        let ge = u0 + pitch - 10.0 * s
        let gv = v0 + us * 0.15
        let sp = max(2.5 * s, px * 3.0)
        res = cp_groove(res, p, vec2(ga, gv), vec2(gb, gv), vec2(gb + j, gv + j), vec2(ge, gv + j), px)
        res = cp_groove(res, p, vec2(ga, gv + sp), vec2(gb - sp * 0.4142, gv + sp), vec2(gb + j - sp * 0.4142, gv + j + sp), vec2(ge, gv + j + sp), px)
        if h2 > 0.5 && us > 10.0 {
            res = cp_groove(res, p, vec2(ga, gv + sp * 2.0), vec2(gb - sp * 0.8284, gv + sp * 2.0), vec2(gb + j - sp * 0.8284, gv + j + sp * 2.0), vec2(ge, gv + j + sp * 2.0), px)
        }
    }
    return res
}

// DEPTH. A raised part throws a soft shadow down and
// to the right (away from the light at the upper left), its penumbra
// growing with its height, and darkens the floor at its foot; a recess takes
// the rim's shadow on its floor and darkens toward its walls; bevels and
// walls are lit by `cp_facet`, crests catch a glint.

// The glint on a crest facing `n`: a little light always, more where it
// faces the white light or a wash.
let cp_glint = fn(n: vec2, lw: vec2, ld: vec4) -> vec3 {
    let k = max(dot(n, cp_lt()), 0.0)
    let kc = max(dot(n, ld.xy), 0.0)
    let km = max(dot(n, ld.zw), 0.0)
    return vec3(0.040, 0.042, 0.048) + vec3(0.11, 0.115, 0.125) * k + vec3(0.20, 0.85, 1.0) * min(lw.x, 1.2) * (0.04 + 0.30 * kc) + vec3(1.0, 0.22, 0.75) * min(lw.y, 1.4) * (0.04 + 0.30 * km)
}

// A RAISED PART over `under`: its face `top`, `d` its distance (negative
// inside), `n` its outward unit normal, `h` its height, `bw` its bevel, and
// `dsh` its distance at p + cp_lt() * h, where its shadow falls.
let cp_lift = fn(under: vec3, top: vec3, d: float, n: vec2, h: float, bw: float, dsh: float, lw: vec2, ld: vec4, px: float) -> vec3 {
    let pen = 0.45 * h + 0.6
    let shadow = 1.0 - smoothstep(-pen, pen, dsh)
    let ao = exp(-max(d, 0.0) / (0.6 * h + 1.0))
    var col = under * (1.0 - 0.58 * shadow) * (1.0 - 0.30 * ao)
    col = mix(col, cp_facet(top * 0.9, n * 0.85, lw, ld), Finish.cover(d, px))
    col = mix(col, top, Finish.cover(d + bw, px))
    return col + cp_glint(n, lw, ld) * Finish.cover(abs(d + bw) - px * 0.5, px)
}

// A RECESS in a face `face`: its floor `fl`, `d` its distance (negative
// inside), `n` its outward unit normal, `depth`, its wall `bw`, and `dsh`
// its distance at p + cp_lt() * depth: where that lies outside, the rim's
// shadow falls on the floor.
let cp_sunk = fn(face: vec3, fl: vec3, d: float, n: vec2, depth: float, bw: float, dsh: float, lw: vec2, ld: vec4, px: float) -> vec3 {
    let pen = 0.4 * depth + 0.6
    let shadow = smoothstep(-pen, pen, dsh)
    let ao = exp(min(d + bw, 0.0) / (0.45 * depth + 0.8))
    let floor_c = fl * (1.0 - 0.65 * shadow) * (1.0 - 0.45 * ao)
    var col = mix(face, cp_facet(face * 0.62, -n * 0.85, lw, ld), Finish.cover(d, px))
    col = mix(col, floor_c, Finish.cover(d + bw, px))
    return col + cp_glint(-n, lw, ld) * Finish.cover(abs(d) - px * 0.5, px) * 0.6
}

// A group of `n` deep slots from `o` (its top left), each `len` long and
// `wid` wide with round ends, side by side on a `pitch`: upright in a row
// across (`across` 1) or lying in a stack down. Dark inside.
let cp_slots = fn(col: vec3, p: vec2, o: vec2, n: float, len: float, wid: float, pitch: float, across: float, lw: vec2, ld: vec4, px: float) -> vec3 {
    let q = p - o
    let u = mix(q.y, q.x, across)
    let i = clamp(floor(u / pitch + 0.5 - wid * 0.5 / pitch), 0.0, n - 1.0)
    let cu = i * pitch + wid * 0.5
    let c = o + mix(vec2(len * 0.5, cu), vec2(cu, len * 0.5), across)
    let h = mix(vec2(len * 0.5, wid * 0.5), vec2(wid * 0.5, len * 0.5), across)
    let d = cp_rbox(p, c, h, wid * 0.5)
    if d > 3.0 {
        return col
    }
    let gx = cp_rbox(p + vec2(0.25, 0.0), c, h, wid * 0.5) - cp_rbox(p - vec2(0.25, 0.0), c, h, wid * 0.5)
    let gy = cp_rbox(p + vec2(0.0, 0.25), c, h, wid * 0.5) - cp_rbox(p - vec2(0.0, 0.25), c, h, wid * 0.5)
    let nn = normalize(vec2(gx, gy) + vec2(0.00001, 0.0))
    return cp_sunk(col, col * 0.12, d, nn, 5.0, 0.9, cp_rbox(p + cp_lt() * 5.0, c, h, wid * 0.5), lw, ld, px)
}

// A screw head at `c`: a domed head standing in a countersink, throwing a
// small shadow into it, a slot across it at a turn of its own.
let cp_screw = fn(col: vec3, p: vec2, c: vec2, turn: float, lw: vec2, ld: vec4, px: float) -> vec3 {
    let q = p - c
    let r = length(q)
    if r > 7.0 {
        return col
    }
    let nq = q / max(r, 0.001)
    var res = cp_sunk(col, col * 0.4, r - 3.4, nq, 1.6, 0.8, length(q + cp_lt() * 1.6) - 3.4, lw, ld, px)
    let dome = cp_facet(col * 1.15, nq * clamp(r / 2.4, 0.0, 1.0) * 0.9, lw, ld)
    res = cp_lift(res, dome, r - 2.4, nq, 1.6, 0.6, length(q + cp_lt() * 1.6) - 2.4, lw, ld, px)
    let sd = vec2(cos(turn), sin(turn))
    let slot = Finish.cover(abs(dot(q, vec2(-sd.y, sd.x))) - 0.35, px) * Finish.cover(abs(dot(q, sd)) - 1.7, px)
    return mix(res, col * 0.25, slot)
}

// The plate's hardware, placed by the window's size, only in the strip just
// under the top band, where an app's panes do not scroll: a group of three
// short slots and two screws.
let cp_edge_parts = fn(col: vec3, p: vec2, size: vec2, band: vec4, lw: vec2, ld: vec4, px: float) -> vec3 {
    let y = band.y + 11.0
    if abs(p.y - y) > 9.0 {
        return col
    }
    var res = cp_slots(col, p, vec2(floor(size.x * 0.47), y - 1.5), 3.0, 14.0, 3.0, 8.0, 1.0, lw, ld, px)
    res = cp_screw(res, p, vec2(size.x * 0.36, y), 0.4, lw, ld, px)
    return cp_screw(res, p, vec2(size.x * 0.63, y), 1.1, lw, ld, px)
}

// The hull at `p` in a window of `size`, `px` a device pixel in points:
// the plate sunk 18 points in the frame -- the frame's shadow falling in on
// it under the frame's upper and left edges and the plate darkening at the
// frame's foot -- the frame's inner wall rising from a dark crease, lit
// where it faces a light, its crest, then the frame and its machinery.
let cp_hull = fn(p: vec2, size: vec2, px: float) -> vec3 {
    let band = cp_band(size)
    let s = band.y / 34.0
    let d = cp_opening(p, size, band, s)
    let lw = cp_wash(p, size)
    let ld = cp_wash_dir(p, size)
    let depth = 18.0
    let fw = 7.0 * s
    let steel = cp_ground(p, size, px)
    let metal = steel * 0.8
    var col = metal
    if d < fw {
        col = cp_edge_parts(steel, p, size, band, lw, ld, px)
        let pen = 0.4 * depth + 1.0
        let fs = smoothstep(-pen, pen, cp_opening(p + cp_lt() * depth, size, band, s))
        col = col * (1.0 - 0.62 * fs) * (1.0 - 0.38 * exp(min(d, 0.0) / (0.35 * depth)))
    }
    if d < -2.0 {
        return col
    }
    let gx = cp_opening(p + vec2(0.5, 0.0), size, band, s) - cp_opening(p - vec2(0.5, 0.0), size, band, s)
    let gy = cp_opening(p + vec2(0.0, 0.5), size, band, s) - cp_opening(p - vec2(0.0, 0.5), size, band, s)
    let n = normalize(vec2(gx, gy) + vec2(0.00001, 0.0))
    var frame = metal
    let deco = vec3(0.140, 0.149, 0.168)
    let right = step(size.x * 0.5, p.x)
    let down = step(size.y * 0.5, p.y)
    let blk = cp_block(p, size, s)
    let qb = (p - vec2(right * size.x, down * size.y)) * vec2(1.0 - 2.0 * right, 1.0 - 2.0 * down)
    if d > fw - px {
        if qb.x < blk.x && qb.y < blk.y {
            frame = cp_corner_parts(frame, p, size, s, deco, px)
        } else {
            frame = cp_strip_parts(frame, p, size, band, s, deco, px)
        }
    }
    col = mix(col, col * 0.3, Finish.cover(abs(d) - px, px))
    col = mix(col, cp_facet(metal * 0.75, -n * 0.9, lw, ld), Finish.cover(-d, px) * (1.0 - Finish.cover(fw - d, px)))
    col = mix(col, frame, Finish.cover(fw - d, px))
    col = col + cp_glint(-n, lw, ld) * Finish.cover(abs(d - fw) - px * 0.5, px)
    // The frame catches the washes where it catches the light: its lit
    // edges, facets, bolt heads and rims take the colour of the light there.
    let on_frame = Finish.cover(fw - d, px)
    let hl = max(dot(col - metal, vec3(0.3, 0.59, 0.11)), 0.0)
    return col + (vec3(0.08, 0.80, 1.0) * lw.x + vec3(1.0, 0.10, 0.70) * lw.y) * (hl * 2.0 + 0.012) * on_frame
}

// ---------------------------------------------------------------- plates

// A RAISED PLATE: dark gunmetal brushed across, a shade lighter at the top,
// cut on the chamfer and edge-lit -- a hairline of neon on the lip, the tube
// 2.6 points inside it, cyan at the top running into magenta at the foot and
// broken in a few places, and a fainter line of the other ink inside that.
// Warning tape wraps the deep bottom-right cut (`tape` 1) and a row of vent
// slots stands near the top right (`vents` 1). It throws a soft shadow and a
// breath of its neon onto the ground. `o` is the box's window position, so
// neighbouring plates share one brushing. Premultiplied.
let cp_plate = fn(p: vec2, lo: vec2, hi: vec2, big: float, small: float, px: float, o: vec2, hover: float, tape: float, vents: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let m = max(min(h.x, h.y) - 0.25, 0.0)
    let kb = min(big, m)
    let ks = min(small, m)
    let d = Finish.sd_notch(p, c, h, vec4(kb, ks, kb, ks))
    let a = Finish.cover(d, px)
    let w = p + o
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let t = smoothstep(0.15, 0.85, uv.y * 0.8 + uv.x * 0.2)
    let ink = cp_neon(t)
    let ink2 = cp_neon(1.0 - t)
    let gate = step(0.10, fract((p.x - lo.x + (p.y - lo.y) * 1.3) / 170.0))
    // What it throws: a soft shadow under it and the neon's breath round it.
    let sh = (1.0 - smoothstep(-4.0, 4.0, Finish.sd_notch(p - vec2(0.0, 3.0), c, h - vec2(1.0, 1.0), vec4(kb, ks, kb, ks)))) * 0.6
    var res = vec4(0.0, 0.0, 0.0, sh * (1.0 - a))
    res = Finish.over(res, vec4(ink, 1.0) * Finish.glow(d, 2.5) * (0.16 + 0.08 * hover) * gate * (1.0 - a))
    // The face: gunmetal brushed in long streaks, lighter at the top.
    let row = floor(w.y * 1.4)
    let streak = Finish.noise(vec2(w.x * 0.01 + row * 7.13, row * 0.37))
    var col = vec3(0.133, 0.155, 0.212) * (1.0 + (streak - 0.5) * 0.07) * (1.06 - uv.y * 0.12)
    col = col + vec3(0.010, 0.012, 0.016) * hover
    // Warning tape wrapped across the deep bottom-right cut: yellow and
    // black, the black stripes upright in the window, chipped here and there.
    let q = abs(p - c) - h
    let cd = (q.x + q.y + kb) * 0.7071
    let br = step(c.x, p.x) * step(c.y, p.y)
    let t1 = max(kb * 0.33, 5.0)
    let t0 = t1 + 6.5
    let band = smoothstep(-t0 - 0.5, -t0 + 0.5, cd) * (1.0 - smoothstep(-t1 - 0.5, -t1 + 0.5, cd)) * br * tape
    let sx = fract(w.x / 7.0)
    let st = smoothstep(0.46, 0.54, sx) * (1.0 - smoothstep(0.94, 1.0, sx))
    let chip = smoothstep(0.72, 0.8, Finish.noise(w * 0.3))
    let tcol = mix(vec3(0.98, 0.84, 0.05) * (0.92 + 0.1 * Finish.hash(floor(w * 2.0))), vec3(0.04, 0.04, 0.045), st)
    col = mix(col, tcol, band * (1.0 - chip * 0.75))
    // Vent slots near the top right: short dark bars.
    let vx = p.x - (hi.x - 58.0)
    let vy = p.y - (lo.y + 7.0)
    let fv = fract(vx / 5.0)
    let slot = step(0.0, vx) * step(vx, 44.0) * step(0.2, fv) * step(fv, 0.62) * step(0.0, vy) * step(vy, 5.0) * vents
    col = mix(col, vec3(0.01, 0.01, 0.015), slot * 0.9)
    // The neon: the lip, the tube, and the inner line of the other ink.
    col = col + ink * Finish.band(d, 0.0, px * 1.5, px) * 0.40 * gate
    col = col + cp_tube(d, 2.6, 0.85, 2.6, ink) * gate * (0.9 + 0.25 * hover)
    col = col + ink2 * (1.0 - smoothstep(0.2, 0.7, abs(d + 5.2))) * 0.30 * gate
    return Finish.over(res, vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a))
}

// A RECESSED PANEL: a black well in the same cut with a faint HUD grid on a
// 16 point pitch, the surround's shade under its top edge, a hairline of cyan
// round its floor and a device pixel of light on the ground under its foot.
let cp_tray = fn(p: vec2, lo: vec2, hi: vec2, big: float, small: float, px: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = cp_cut(p, c, h, big, small)
    let a = Finish.cover(d, px)
    let f = fract((p - lo) / vec2(16.0, 16.0))
    let g = max(1.0 - smoothstep(0.0, 0.07, f.x), 1.0 - smoothstep(0.0, 0.07, f.y))
    var col = vec3(0.051, 0.059, 0.078) + vec3(0.02, 0.07, 0.09) * g * 0.35
    col = col * (1.0 - 0.45 * (1.0 - smoothstep(0.0, 8.0, p.y - lo.y)))
    col = col + vec3(0.08, 0.94, 1.0) * (1.0 - smoothstep(0.2, 0.8, abs(d + 1.6))) * 0.28
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y, p.y) * 0.22
    let res = vec4(0.40, 0.48, 0.56, 1.0) * lip
    return Finish.over(res, vec4(col * a, a))
}

// BLACK GLASS: a field's or a slot's well in the cut, `fill` lit a little
// under its top edge, a hairline round it in `ink` paled toward white
// (`rim_a` its strength) and, with `glow`, the hairline's light on the glass
// inside.
let cp_glass = fn(p: vec2, lo: vec2, hi: vec2, big: float, small: float, px: float, fill: vec3, ink: vec3, rim_a: float, glow: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = cp_cut(p, c, h, big, small)
    let a = Finish.cover(d, px)
    var col = fill * (1.0 - smoothstep(0.0, 7.0, p.y - lo.y) * 0.25)
    let rim = 1.0 - smoothstep(0.3, 1.0, abs(d + 0.6))
    col = mix(col, mix(ink, vec3(1.0, 1.0, 1.0), 0.28), rim * clamp(rim_a, 0.0, 1.0))
    col = col + ink * exp(min(d, 0.0) / 4.0) * 0.22 * glow
    var res = vec4(ink, 1.0) * Finish.glow(d, 1.6) * 0.22 * glow * (1.0 - a)
    return Finish.over(res, vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a))
}

// ---------------------------------------------------------------- keys

// The holographic foil on a key: thin-film colours that shift with the
// window position `w`, strongest in a diagonal band across the face (`uv`),
// over faint brushing and a fine grating. `amt` scales the band.
let cp_foil = fn(base: vec3, w: vec2, uv: vec2, amt: float) -> vec3 {
    let row = floor(w.y * 1.6)
    let br = Finish.noise(vec2(w.x * 0.02 + row * 7.13, row * 0.37))
    let col = base * (1.0 + (br - 0.5) * 0.10)
    let t = (w.x * 0.8 + w.y) * 0.006 + Finish.noise(w * 0.04) * 0.5 + uv.x * 0.35
    let ha = 0.5 + 0.5 * sin(t * 6.2832)
    let hb = pow(0.5 + 0.5 * sin(t * 10.7 + 1.3), 6.0)
    var film = mix(vec3(0.05, 0.85, 1.0), vec3(0.95, 0.15, 0.85), ha)
    film = mix(film, vec3(1.0, 0.85, 0.35), hb * 0.7)
    let b = uv.x + uv.y * 0.6 - 0.75
    let band = (exp(-(b * b) / 0.03) * 0.55 + 0.07) * amt
    let grating = 0.5 + 0.5 * sin((w.x - w.y) * 2.4)
    return col * (1.0 - band * 0.45) + film * band * (0.18 + 0.36 * grating)
}

// A KEY: a gunmetal cap in the cut wearing the foil, and a neon pipe just
// inside its lip, in the `rest` ink at rest and brighter under the hand. On
// (`lit`) or held (`down`) the pipe takes the `on` ink at full strength, the
// face darkens under a glow from the rim and the ink lights the ground round
// it; held, the key also loses its shadow, pressed home. `charge` lights the
// rest ink the same way without the key being on (a primary's call). `face`
// 0 draws the pipe alone over a breath of black glass (an outline key);
// `foil` scales the sheen; `raise` 0 seats the key on the ground with its
// contact shadow only. Focus rings it in cyan. Premultiplied.
let cp_key = fn(p: vec2, lo: vec2, hi: vec2, big: float, small: float, px: float, o: vec2, hover: float, down: float, lit: float, focus: float, disabled: float, rest: vec3, on: vec3, charge: float, face: float, foil: float, raise: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = cp_cut(p, c, h, big, small)
    let a = Finish.cover(d, px)
    let live = 1.0 - disabled
    let up = (1.0 - down) * live * raise
    let held = clamp(max(down, lit), 0.0, 1.0) * live
    let w = p + o
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let ink = mix(rest, on, held)
    let lift = max(held, charge * live)
    // What the key throws: a contact shadow, and a short drop while it is up.
    let drop = cp_cut_shade(p, c, h - vec2(0.5, 0.5), big, small, vec2(0.0, 2.0), 2.2) * 0.5 * up * face
    let contact = cp_cut_shade(p, c, h, big, small, vec2(0.0, px), px) * 0.6 * face
    var res = vec4(0.0, 0.0, 0.0, (1.0 - (1.0 - drop) * (1.0 - contact)) * (1.0 - a))
    let halo = (0.30 * lift + 0.10 * hover * live) * (1.0 - a)
    res = Finish.over(res, vec4(ink, 1.0) * Finish.glow(d, 2.0) * halo)
    // The face.
    var col = cp_foil(vec3(0.128, 0.140, 0.178), w, uv, foil * live)
    col = col * (1.0 - 0.12 * down * live) + vec3(0.012, 0.014, 0.018) * hover * live
    col = col * (1.0 - 0.25 * lit * live) + on * 0.07 * lit * live + rest * 0.05 * charge * live
    col = mix(col, vec3(0.082, 0.088, 0.104), disabled)
    let fa = a * face
    var top = vec4(col * fa, fa)
    // Without a face, a breath of black glass behind the pipe.
    top = Finish.over(vec4(0.02, 0.025, 0.035, 1.0) * a * 0.55 * (1.0 - face), top)
    // The pipe and the glow it lays on the face.
    let line = (1.0 - smoothstep(0.2, 0.8, abs(d + 1.2))) * step(d, 0.0)
    let rim_glow = exp(min(d, 0.0) / 5.0) * lift * 0.45
    let amt = mix(0.55 + 0.30 * hover, 1.05, lift) * live + 0.20 * disabled
    let pink = mix(ink, vec3(0.30, 0.38, 0.44), disabled)
    let la = clamp(line * amt, 0.0, 1.0) * a
    top = vec4(top.rgb + pink * (line * amt + rim_glow) * a, max(top.a, la))
    res = Finish.over(res, top)
    return cp_focus(res, d, px, focus * live)
}

// Warning marks: four short bars of warning yellow leaning forward, standing
// inside the bottom-left cut, as the Amp app's critical keys carry them.
let cp_hazard = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, small: float, px: float, amt: float) -> vec4 {
    let x0 = lo.x + small + 2.0
    let y1 = hi.y - 2.5
    let y0 = y1 - 3.5
    let s = (p.x - x0) - (y1 - p.y) * 0.55
    let g = fract(s / 2.2)
    let bar = Finish.cover((abs(g - 0.5) - 0.27) * 2.2, px)
    let inside = Finish.cover(max(-s, s - 8.6), px) * Finish.cover(max(y0 - p.y, p.y - y1), px)
    return Finish.over(dst, vec4(0.86, 0.76, 0.10, 1.0) * bar * inside * amt * 0.9)
}

// The three-quarter arc a waiting button turns in place of its label.
let cp_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, 1.5)
    sdf.fill(vec4(0.6, 0.98, 1.0, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is a key, 26 points on a 13 point line. Its shadow and glow
// fall outside the box, so the quad grows and nothing is paid in padding.
// The cut is read off the face's own border_radius (the deep cut is 2.8x
// it), so a use site that rounds a button tighter also cuts it tighter.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(2.5)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(1.0)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The key and its states, shared by every button template; `kind` picks the
// variant: 0 flat (a seated key, its foil quieter), 1 the key, 2 primary (charged cyan, the
// warning marks), 3 secondary (a quiet foil), 4 tertiary (a magenta pipe),
// 5 danger (charged red, the warning marks), 6 outline (the pipe alone),
// 7 flatter (nothing at rest, a seated key under the hand).
let cp_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, br: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float) -> vec4 {
    let m = 8.0
    let px = cp_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(cp_snap(0.0, o.x, px), cp_snap(0.0, o.y, px))
    let hi = vec2(cp_snap(size.x, o.x, px), cp_snap(size.y, o.y, px))
    let big = max(br, 0.0) * 2.8
    let small = max(br, 0.0)
    let cyan = vec3(0.08, 0.94, 1.0)
    let mag = vec3(1.0, 0.12, 0.72)
    var rest = cyan
    var on = mag
    var charge = 0.0
    var face = 1.0
    var foil = 1.0
    var show = 1.0
    var marks = 0.0
    var raise = 1.0
    if kind < 0.5 {
        raise = 0.0
        foil = 0.6
    }
    if kind > 6.5 {
        show = clamp(max(hover, down) + focus, 0.0, 1.0) * 0.8
        raise = 0.0
    }
    if kind > 1.5 && kind < 2.5 {
        charge = 1.0
        marks = 1.0
    }
    if kind > 2.5 && kind < 3.5 {
        foil = 0.35
    }
    if kind > 3.5 && kind < 4.5 {
        rest = mag
        on = cyan
    }
    if kind > 4.5 && kind < 5.5 {
        rest = vec3(1.0, 0.23, 0.36)
        on = vec3(1.0, 0.55, 0.62)
        charge = 0.6
        marks = 1.0
    }
    if kind > 5.5 && kind < 6.5 {
        face = 0.0
    }
    var res = cp_key(p, lo, hi, big, small, px, o, hover, down, 0.0, focus, disabled, rest, on, charge, face, foil, raise) * show
    res = cp_hazard(res, p, lo, hi, small, px, marks * (1.0 - disabled * 0.7))
    if loading > 0.001 {
        let c = (lo + hi) * 0.5
        let rad = max(min(hi.x - lo.x, hi.y - lo.y) * 0.5 - 6.5, 2.0)
        res = cp_spinner(res, p, c, rad, anim, loading)
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0), 8.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0), 8.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0), 8.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0), 8.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0), 8.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0), 8.0)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0), 8.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return self.host_over(cp_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.border_radius, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0), 8.0)
}

// Legends: printed ice-cyan, white under the hand, magenta while held.
mod.widgets.ButtonFlat.draw_text.color = #c8faff
mod.widgets.ButtonFlat.draw_text.color_hover = #ffffff
mod.widgets.ButtonFlat.draw_text.color_down = #ff4fd0
mod.widgets.ButtonFlat.draw_text.color_focus = #e6fbff
mod.widgets.ButtonFlat.draw_text.color_disabled = #4f6272
mod.widgets.ButtonFlat.draw_icon.color = #c8faff
mod.widgets.ButtonFlat.draw_icon_end.color = #c8faff
mod.widgets.Button.draw_text.color = #c8faff
mod.widgets.Button.draw_text.color_hover = #ffffff
mod.widgets.Button.draw_text.color_down = #ff4fd0
mod.widgets.Button.draw_text.color_focus = #e6fbff
mod.widgets.Button.draw_text.color_disabled = #4f6272
mod.widgets.ButtonPrimary.draw_text.color = #ffffff
mod.widgets.ButtonPrimary.draw_text.color_hover = #ffffff
mod.widgets.ButtonPrimary.draw_text.color_down = #ff4fd0
mod.widgets.ButtonPrimary.draw_text.color_focus = #ffffff
mod.widgets.ButtonPrimary.draw_text.color_disabled = #4f6272
mod.widgets.ButtonPrimary.draw_icon.color = #ffffff
mod.widgets.ButtonSecondary.draw_text.color = #c8faff
mod.widgets.ButtonSecondary.draw_text.color_hover = #ffffff
mod.widgets.ButtonSecondary.draw_text.color_down = #ff4fd0
mod.widgets.ButtonSecondary.draw_text.color_focus = #e6fbff
mod.widgets.ButtonSecondary.draw_icon.color = #c8faff
mod.widgets.ButtonTertiary.draw_text.color = #ffd6f4
mod.widgets.ButtonTertiary.draw_text.color_hover = #ffffff
mod.widgets.ButtonTertiary.draw_text.color_down = #c8faff
mod.widgets.ButtonTertiary.draw_text.color_focus = #ffd6f4
mod.widgets.ButtonTertiary.draw_icon.color = #ffd6f4
mod.widgets.ButtonDanger.draw_text.color = #ffffff
mod.widgets.ButtonDanger.draw_text.color_hover = #ffffff
mod.widgets.ButtonDanger.draw_text.color_down = #ffd0d8
mod.widgets.ButtonDanger.draw_text.color_focus = #ffffff
mod.widgets.ButtonDanger.draw_icon.color = #ffffff
mod.widgets.ButtonOutline.draw_text.color = #c8faff
mod.widgets.ButtonOutline.draw_text.color_hover = #ffffff
mod.widgets.ButtonOutline.draw_text.color_down = #ff4fd0
mod.widgets.ButtonOutline.draw_text.color_focus = #e6fbff
mod.widgets.ButtonOutline.draw_text.color_disabled = #4f6272
mod.widgets.ButtonOutline.draw_icon.color = #c8faff

// ---------------------------------------------------------------- selection

// The small controls' quads grow so their glow and focus ring fall outside
// the box.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false

// The check box: a well of black glass in a small cut with a cyan hairline.
// Checked, the hairline and a check mark light magenta, the mark a white-hot
// core in a magenta tube with its halo on the glass; mixed is a dash.
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = cp_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(cp_snap(x0, o.x, px), cp_snap(y0, o.y, px))
    let hi = vec2(cp_snap(x0 + sz, o.x, px), cp_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = max(self.active, self.mixed) * live
    let held = max(self.down, self.pressed) * live
    var ink = mix(vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), max(on, held))
    ink = mix(ink, vec3(1.0, 0.23, 0.36), self.error)
    ink = mix(ink, vec3(0.30, 0.38, 0.44), self.disabled)
    let fill = mix(vec3(0.016, 0.026, 0.068), vec3(0.05, 0.055, 0.065), self.disabled)
    let rim = mix(0.65 + 0.25 * self.hover, 1.0, max(on, held)) * live + 0.25 * self.disabled
    var res = cp_glass(p, lo, hi, sz * 0.32, sz * 0.1, px, fill, ink, rim, on)
    let d = cp_cut(p, c, (hi - lo) * 0.5, sz * 0.32, sz * 0.1)
    let k = sz / 14.0
    let dm = min(cp_seg(p, c + vec2(-3.6, 0.1) * k, c + vec2(-1.1, 2.6) * k), cp_seg(p, c + vec2(-1.1, 2.6) * k, c + vec2(3.7, -2.8) * k))
    let dd = cp_seg(p, c - vec2(3.5 * k, 0.0), c + vec2(3.5 * k, 0.0))
    let dk = mix(dm - 0.9, dd - 0.9, self.mixed)
    res = cp_mark(res, dk, 0.9, px, max(self.active, self.mixed), ink)
    return cp_focus(res, d, px, self.focus * live)
}

// The radio: the same glass cut evenly at all four corners, an octagon.
// Chosen, an octagonal magenta lamp lights in its middle.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = cp_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(cp_snap(0.0, o.x, px), cp_snap(y0, o.y, px))
    let hi = vec2(cp_snap(sz, o.x, px), cp_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active * live
    let held = self.down * live
    var ink = mix(vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), max(on, held))
    ink = mix(ink, vec3(0.30, 0.38, 0.44), self.disabled)
    let fill = mix(vec3(0.016, 0.026, 0.068), vec3(0.05, 0.055, 0.065), self.disabled)
    let rim = mix(0.65 + 0.25 * self.hover, 1.0, max(on, held)) * live + 0.25 * self.disabled
    var res = cp_glass(p, lo, hi, sz * 0.29, sz * 0.29, px, fill, ink, rim, on)
    let d = cp_cut(p, c, (hi - lo) * 0.5, sz * 0.29, sz * 0.29)
    let ls = sz * 0.19
    let dl = cp_cut(p, c, vec2(ls, ls), ls * 0.6, ls * 0.6)
    res = cp_mark(res, dl, ls, px, self.active, ink)
    return cp_focus(res, d, px, self.focus * live)
}

// The toggle: a slot of black glass, and a key half its length riding in it
// with a lamp in its middle. On, the key stands at the far end, its pipe and
// lamp lit magenta and the slot's hairline with them.
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
// One switch: a slot `sz` at the start of the row or at its end, a key in
// it `t` along its travel, lit by `on`. `legend` 1 prints an O on the key
// while off and an I while on (the rocker); 0 leaves a lamp on it.
let cp_switch = fn(p: vec2, size: vec2, o: vec2, px: float, sz: vec2, at_end: float, t: float, hover: float, down: float, focus: float, on: float, disabled: float, legend: float) -> vec4 {
    let o0 = vec2((size.x - sz.x) * at_end, size.y * 0.5 - sz.y * 0.5)
    let lo = vec2(cp_snap(o0.x, o.x, px), cp_snap(o0.y, o.y, px))
    let hi = vec2(cp_snap(o0.x + sz.x, o.x, px), cp_snap(o0.y + sz.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let live = 1.0 - disabled
    let lit = on * live
    var ink = mix(vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), lit)
    ink = mix(ink, vec3(0.30, 0.38, 0.44), disabled)
    let fill = mix(vec3(0.016, 0.026, 0.068), vec3(0.05, 0.055, 0.065), disabled)
    var res = cp_glass(p, lo, hi, sz.y * 0.4, sz.y * 0.12, px, fill, ink, mix(0.60 + 0.25 * hover, 0.95, lit) * live + 0.25 * disabled, lit * 0.6)
    let d = cp_cut(p, c, h, sz.y * 0.4, sz.y * 0.12)
    // The key, two points in from the slot, half its length.
    let kh = sz.y - 4.0
    let kw = max(sz.x * 0.5 - 2.0, kh)
    let kx = lo.x + 2.0 + (sz.x - 4.0 - kw) * t
    let klo = vec2(cp_snap(kx, o.x, px), lo.y + 2.0)
    let khi = vec2(cp_snap(kx + kw, o.x, px), hi.y - 2.0)
    let key = cp_key(p, klo, khi, kh * 0.38, kh * 0.12, px, o, hover, down, on, 0.0, disabled, vec3(0.08, 0.94, 1.0), vec3(1.0, 0.12, 0.72), 0.0, 1.0, 0.8, 1.0)
    res = Finish.over(res, key)
    let kc = (klo + khi) * 0.5
    if legend > 0.5 {
        let ring = Finish.cover(abs(length(p - kc) - kh * 0.22) - 0.55, px) * (1.0 - on)
        let bar = Finish.cover(max(abs(p.x - kc.x) - 0.6, abs(p.y - kc.y) - kh * 0.26), px) * on
        let lc = mix(vec3(0.50, 0.60, 0.68), vec3(1.0, 0.45, 0.85), lit)
        res = Finish.over(res, vec4(lc, 1.0) * (ring + bar) * mix(1.0, 0.4, disabled))
    } else {
        let ld = length(p - kc) - 1.6
        let lamp = Finish.cover(ld, px)
        let lcol = mix(vec3(0.10, 0.06, 0.10), mix(vec3(1.0, 0.12, 0.72), vec3(1.0, 1.0, 1.0), 0.35), lit)
        res = Finish.over(res, vec4(1.0, 0.12, 0.72, 1.0) * exp(-max(ld, 0.0) / 1.6) * 0.5 * lit * (1.0 - lamp))
        res = Finish.over(res, vec4(lcol, 1.0) * lamp)
    }
    return cp_focus(res, d, px, focus * live)
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = cp_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let t = mix(self.active, self.drag_pos, self.drag)
    return cp_switch(p, self.rect_size, self.rect_pos, px, sz, self.mark_at_end, t, self.hover, max(self.pressed, self.down), self.focus, self.active, self.disabled, 0.0)
}
// The rocker and the slide switch are the same slot and key: the rocker's
// key prints the side in force, the slide switch's carries the lamp.
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 6.0
    let px = cp_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    return cp_switch(p, self.rect_size, self.rect_pos, px, sz, self.mark_at_end, self.active, self.hover, self.down, self.focus, self.active, self.disabled, 1.0)
}
