use mod.prelude.widgets_internal.*

// Mecha dark: a mobile-suit cockpit in navy armour.
// Every part is an armour plate with its corners cut at 45 degrees,
// standing on the plating of the hull:
// a bevel all round that catches the light from the upper left, a dark
// outline, a fine step line where the bevel meets the face. Values are lit
// in the suit's colour code -- blue first, red and yellow beside it --
// fields and screens are navy glass in a steel frame, knobs are machined
// steel with a red index in a dark ring. The light and the dark sheet share
// these faces line for line; only the palette differs. Every face is drawn
// in true points (one device pixel is `px`), and every shadow and glow is
// drawn OUTSIDE the layout box: the quad is grown in `vertex`, the
// templates that throw a shadow stop clipping, and no padding is spent on
// relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let mk_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let mk_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let mk_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A hash that does not line up: the library's hash nearly repeats every 97
// cells, so each cell is first sent to a far cell picked by its own hash.
let mk_hash = fn(i: vec2) -> float {
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j)
}
// Value noise on that hash, one unit per cell.
let mk_noise = fn(q: vec2) -> float {
    let i = floor(q)
    let f = q - i
    let u = f * f * (vec2(3.0, 3.0) - f * 2.0)
    let a = mk_hash(i)
    let b = mk_hash(i + vec2(1.0, 0.0))
    let c = mk_hash(i + vec2(0.0, 1.0))
    let d = mk_hash(i + vec2(1.0, 1.0))
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}
// Grain, one value per device pixel.
let mk_grain = fn(q: vec2, px: float, amt: float) -> float {
    let i = floor(q / px)
    return (mk_hash(i) - mk_hash(i + vec2(17.13, 3.71))) * amt
}
// Painted metal: a fine grain over two slow clouds, so no two plates of the
// same paint read alike and nothing repeats.
let mk_paint = fn(q: vec2, px: float, amt: float) -> float {
    let cloud = (mk_noise(q / 70.0) - 0.5) * 0.6 + (mk_noise(q / 13.0 + vec2(7.7, 3.1)) - 0.5) * 0.4
    return cloud * amt * 1.6 + mk_grain(q, px, amt)
}

// THE EIGHT-SIDED SHAPE every part of the suit is built from: a box `c`,
// half size `h`, its corners cut `k` along each edge at 45 degrees. The
// distance is the farthest of its eight edge lines, so inside it is the
// true distance to the outline and outside its contours stay eight-sided:
// a rim, a ring, a glow or a shadow laid on it keeps the crisp cut corner
// instead of rounding off round it.
let mk_oct = fn(p: vec2, c: vec2, h: vec2, k: float) -> float {
    let q = abs(p - c)
    let kk = clamp(k, 0.0, min(h.x, h.y))
    return max(max(q.x - h.x, q.y - h.y), (q.x + q.y - h.x - h.y + kk) * 0.70710678)
}
// The same shape grown (`g` > 0) or shrunk by `g` points on every side,
// its cut moved with it so the new edges stay parallel to the old.
let mk_oct_k = fn(k: float, g: float) -> float {
    return max(k + 0.58578644 * g, 0.0)
}
// What an eight-sided part throws: its own outline moved by `off`, its
// edge softened over `sigma` points, half dark on the outline itself.
let mk_oct_drop = fn(p: vec2, c: vec2, h: vec2, k: float, off: vec2, sigma: float) -> float {
    let d = mk_oct(p - off, c, h, k)
    return 1.0 - smoothstep(-1.5 * sigma, 1.5 * sigma, d)
}
// The shade the surround throws into an eight-sided well, moved by `off`
// toward the side away from the light; the caller clips it to the well.
let mk_oct_inset = fn(p: vec2, c: vec2, h: vec2, k: float, off: vec2, sigma: float) -> float {
    return smoothstep(-1.5 * sigma, 1.5 * sigma, mk_oct(p - off, c, h, k))
}

// The way the outline of a chamfered box faces at `p` (the box `c`, half
// size `h`, corners cut `k` along each edge): the side, or the cut, whose
// edge is nearest.
let mk_cham_n = fn(p: vec2, c: vec2, h: vec2, k: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - h
    let kk = clamp(k, 0.0, min(h.x, h.y))
    let dd = (q.x + q.y + kk) * 0.70710678
    var n = vec2(0.0, 1.0)
    if q.x > q.y {
        n = vec2(1.0, 0.0)
    }
    if dd > max(q.x, q.y) && kk > 0.01 {
        n = vec2(0.70710678, 0.70710678)
    }
    return n * s
}

// How much of the light from the upper left a face turned `n` takes:
// +1 facing it, -1 turned away.
let mk_lit = fn(n: vec2) -> float {
    return dot(n, vec2(-0.55, -0.835))
}

// The three-quarter arc a waiting button turns in place of its label.
let mk_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- the hull

// Which panel of the cockpit's floor a point lies on: rows 560 points
// tall, each cut into panels 680 to 900 points wide with the cuts of every
// row offset. Handed back as the panel's x0, y0, x1, y1 in points.
let mk_floor_cell = fn(w: vec2) -> vec4 {
    let rh = 560.0
    let row = floor(w.y / rh)
    let cw = 680.0 + 220.0 * mk_hash(vec2(row, 3.7))
    let off = mk_hash(vec2(row, 11.3)) * cw
    let col = floor((w.x + off) / cw)
    let x0 = col * cw - off
    return vec4(x0, row * rh, x0 + cw, row * rh + rh)
}

// Coverage of a row of `n` slots slanted forward, cut in a plate: each
// slot 2 points wide and `h` tall, 4 points apart, starting at `o`. `.x`
// the dark inside, `.y` the light on the lower lip.
let mk_vent = fn(w: vec2, o: vec2, n: float, h: float, px: float) -> vec2 {
    let u = w - o
    let sl = u.x + u.y * 0.7
    let f = sl / 4.0
    let inr = step(0.0, f) * step(f, n) * smoothstep(0.0 - px, px, u.y) * smoothstep(0.0 - px, px, h - u.y)
    let fra = fract(f)
    let slot = smoothstep(0.0, px / 4.0, fra) * smoothstep(0.0, px / 4.0, 0.5 - fra) * inr
    let lip = smoothstep(0.5, 0.5 + px / 4.0, fra) * smoothstep(0.0, px / 4.0, 0.5 + px * 1.5 / 4.0 - fra) * inr
    return vec2(slot, lip)
}

// Coverage of a slanted stripe (a parallelogram) `wd` wide and `h` tall
// whose foot starts at `o`.
let mk_slant = fn(w: vec2, o: vec2, wd: float, h: float, px: float) -> float {
    let u = w - o
    let sl = u.x - (h - u.y) * 0.6
    return smoothstep(0.0 - px, px, sl) * smoothstep(0.0 - px, px, wd - sl) * smoothstep(0.0 - px, px, u.y) * smoothstep(0.0 - px, px, h - u.y)
}

// A light strip set in the frame: a pill `hs` either side of `c`, its
// middle burning toward white, its colour at the edge, a short glow.
// Premultiplied over `dst`.
let mk_frame_light = fn(dst: vec4, w: vec2, c: vec2, hs: vec2, px: float, col: vec3) -> vec4 {
    let d = Finish.sd_pill(w, c, hs)
    let x = max(d, 0.0)
    let g = (0.5 * exp(0.0 - (x * x) / (2.0 * 0.9 * 0.9)) + 0.2 * exp(0.0 - (x * x) / (2.0 * 2.2 * 2.2))) * (1.0 - Finish.cover(d, px)) * 1.000
    var o = Finish.over(dst, vec4(col, 1.0) * g)
    let q = (w - c) / max(hs, vec2(0.5, 0.5))
    let qq = q * vec2(0.6, 1.6)
    let core = exp(0.0 - dot(qq, qq))
    let ink = mix(col, mix(col, vec3(1.0, 1.0, 1.0), 0.85), core)
    o = Finish.over(o, vec4(vec3(0.004, 0.020, 0.039), 1.0) * Finish.ring_out(d, 0.0, px, px) * 0.8)
    return Finish.over(o, vec4(ink, 1.0) * Finish.cover(d, px))
}

// A screw head sunk in a plate at `c`, radius `r`: a shadowed socket ring,
// a domed head lit from the upper left, and a hex socket in its middle.
// Premultiplied over `dst`.
let mk_screw = fn(dst: vec4, p: vec2, c: vec2, r: float, px: float) -> vec4 {
    let q = p - c
    let rl = length(q)
    let n = q / max(rl, 0.001)
    let sock = Finish.cover(rl - r - px * 1.5, px) * (1.0 - Finish.cover(rl - r, px))
    var o = Finish.over(dst, vec4(vec3(0.004, 0.020, 0.039), 1.0) * sock * mix(0.85, 0.35, smoothstep(-0.8, 0.8, n.y)))
    o = Finish.over(o, vec4(vec3(0.227, 0.329, 0.463), 1.0) * sock * smoothstep(0.3, 0.9, n.y) * 0.8)
    let t = clamp(mk_lit(n) * smoothstep(0.0, r, rl), -1.0, 1.0)
    var head = mix(vec3(0.298, 0.337, 0.392), vec3(0.886, 0.910, 0.937), smoothstep(-0.9, 0.9, t))
    let hx = abs(q.x) * 0.866 + abs(q.y) * 0.5
    let hex = max(hx, abs(q.y)) - r * 0.42
    head = mix(head, vec3(0.027, 0.043, 0.067), Finish.cover(hex, px) * 0.85)
    head = mix(head, vec3(0.027, 0.043, 0.067), Finish.band(rl - r, 0.0, px, px) * 0.7)
    return Finish.over(o, vec4(head, 1.0) * Finish.cover(rl - r, px))
}

// THE HULL: the window's ground at a window point `w` (points) in a window
// `size` points large. As the cockpit in the pictures, the armour is a
// FRAME round the window, and the floor it holds is calm.
// THE FRAME: a raised band of armour 9 points wide down the sides and along
// the foot, deep along the top (94 points: the window's caption and the
// bar under it stand on it), its inner corners cut at 45 degrees. Its edge
// toward the floor is a bevel lit by the way it faces (shaded along the
// top band's foot and the left band, lit along the foot band and the right
// band), with the frame's shade lying a little way onto the floor. The heavy
// detail lives on it: a raised visor plate in the middle of the top band,
// its lower corners cut; vents of slanted slots either side of it; the
// suit's colour code in slanted stripes at both ends; screws in its
// corners; red light strips set in the side bands, blue ones in the foot.
// THE FLOOR: painted armour, lighter toward the top, its grain and a slow
// cloud in the paint, parted into a few big panels by a faint panel line.
let mk_hull = fn(w: vec2, px: float, size: vec2) -> vec3 {
    let W = size.x
    let H = size.y
    let side = min(9.0, W * 0.02)
    let tb = min(94.0, H * 0.22)
    let ilo = vec2(side, tb)
    let ihi = vec2(W - side, H - side)
    let ic = (ilo + ihi) * 0.5
    let ih = max((ihi - ilo) * 0.5, vec2(1.0, 1.0))
    let ik = 16.0
    let di = mk_oct(w, ic, ih, ik)
    let tx = mk_paint(w, px, 0.010)
    // The floor.
    let t = clamp((w.y - ilo.y) / max(ihi.y - ilo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.039, 0.082, 0.141), vec3(0.024, 0.063, 0.110), 0.1 + 0.8 * t) + vec3(tx, tx, tx * 1.04)
    let r = mk_floor_cell(w - ilo)
    let rc = (r.xy + r.zw) * 0.5 + ilo
    let rh = (r.zw - r.xy) * 0.5
    let id = mk_hash(r.xy * 0.013 + vec2(1.3, 7.1))
    col = col * (1.0 + (id - 0.5) * 0.025)
    let ds = mk_oct(w, rc, rh, 12.0)
    let nf = mk_cham_n(w, rc, rh, 12.0)
    let lf = mk_lit(nf)
    // The faint panel line: a device pixel of shade on the panel's edge, a
    // device pixel of light inside it where it faces the light. It shows
    // where it leaves the frame and fades to a trace a few points in,
    // under the content, so no line runs through words.
    let near = mix(0.1, 1.0, 1.0 - smoothstep(4.0, 14.0, 0.0 - di))
    col = mix(col, vec3(0.004, 0.020, 0.039), Finish.band(ds, 0.0, px, px) * 0.24 * near)
    col = mix(col, vec3(0.227, 0.329, 0.463), Finish.band(ds, px, px * 2.0, px) * smoothstep(0.0, 0.8, lf) * 0.35 * near)
    // The frame's shade on the floor along the top band and the left band.
    let nin = mk_cham_n(w, ic, ih, ik)
    let lin = mk_lit(nin)
    col = mix(col, col * 0.84, (1.0 - smoothstep(0.0, 6.0, 0.0 - di)) * smoothstep(0.0, 0.8, lin))
    // THE FRAME.
    let tf = clamp(w.y / max(H, 1.0), 0.0, 1.0)
    var fr = mix(vec3(0.110, 0.180, 0.275), vec3(0.075, 0.133, 0.220), tf) + vec3(tx, tx, tx * 1.04)
    fr = fr + (vec3(0.110, 0.180, 0.275) - vec3(0.075, 0.133, 0.220)) * (1.0 - smoothstep(0.0, tb, w.y)) * 0.6
    // The visor: a raised plate in the middle of the top band, its lower
    // corners cut.
    let vc = vec2(W * 0.5, tb * 0.17)
    let vh = vec2(min(W * 0.17, 240.0), tb * 0.17 + 2.0)
    let dv = Finish.sd_notch(w, vc, vh, vec4(0.0, 0.0, 14.0, 14.0))
    let nv = mk_cham_n(w, vc, vh, 14.0)
    let lv = mk_lit(nv)
    fr = mix(fr, fr + (vec3(0.110, 0.180, 0.275) - vec3(0.075, 0.133, 0.220)) * 0.8, Finish.cover(dv, px))
    fr = mix(fr, mix(vec3(0.004, 0.020, 0.039), vec3(0.227, 0.329, 0.463), smoothstep(-0.7, 0.7, lv)), Finish.band(dv, 0.0, px * 2.0, px) * 0.8 * step(px * 2.0, w.y))
    // The vents either side of the visor.
    let va = mk_vent(w, vec2(vc.x - vh.x - 60.0, 9.0), 9.0, 12.0, px)
    let vb = mk_vent(w, vec2(vc.x + vh.x + 22.0, 9.0), 9.0, 12.0, px)
    fr = mix(fr, vec3(0.004, 0.020, 0.039) * 0.75, (va.x + vb.x) * 0.9)
    fr = mix(fr, vec3(0.227, 0.329, 0.463), (va.y + vb.y) * 0.7)
    // The colour code at both ends of the top band.
    let s1 = mk_slant(w, vec2(16.0, 9.0), 4.0, 12.0, px)
    let s2 = mk_slant(w, vec2(24.0, 9.0), 4.0, 12.0, px)
    let s3 = mk_slant(w, vec2(32.0, 9.0), 4.0, 12.0, px)
    let s4 = mk_slant(w, vec2(vc.x + vh.x + 76.0, 9.0), 4.0, 12.0, px)
    let s5 = mk_slant(w, vec2(vc.x + vh.x + 84.0, 9.0), 4.0, 12.0, px)
    fr = mix(fr, vec3(0.850, 0.150, 0.170), (s1 + s4) * 0.95)
    fr = mix(fr, vec3(0.110, 0.420, 0.950), (s2 + s5) * 0.95)
    fr = mix(fr, vec3(0.990, 0.780, 0.130), s3 * 0.95)
    // The frame's edge toward the floor: a bevel two points wide, lit by
    // the way it faces, and the dark line where it meets the floor.
    let lb = mk_lit(0.0 - nin)
    fr = mix(fr, mix(vec3(0.004, 0.020, 0.039), vec3(0.227, 0.329, 0.463), smoothstep(-0.7, 0.7, lb)), (1.0 - smoothstep(0.0, 2.2, di)) * 0.85)
    fr = mix(fr, vec3(0.004, 0.020, 0.039), Finish.band(0.0 - di, 0.0, px, px) * 0.9)
    // The window's own edge: lit along its top and left, shaded along its
    // foot and right.
    let de = min(min(w.x, w.y), min(W - w.x, H - w.y))
    let edge = 1.0 - smoothstep(px, px * 2.5, de)
    let lit_edge = clamp(step(w.y, px * 2.5) + step(w.x, px * 2.5), 0.0, 1.0)
    fr = mix(fr, mix(vec3(0.004, 0.020, 0.039), vec3(0.227, 0.329, 0.463), lit_edge), edge * 0.7)
    var fo = vec4(fr, 1.0)
    // Screws in the corners of the frame.
    let sxl = side * 0.5 + 4.0
    fo = mk_screw(fo, w, vec2(sxl, tb - 11.0), 2.4, px)
    fo = mk_screw(fo, w, vec2(W - sxl, tb - 11.0), 2.4, px)
    fo = mk_screw(fo, w, vec2(sxl, 6.0), 2.2, px)
    fo = mk_screw(fo, w, vec2(W - sxl, 6.0), 2.2, px)
    fo = mk_screw(fo, w, vec2(side * 0.5, H - side * 0.5), 2.2, px)
    fo = mk_screw(fo, w, vec2(W - side * 0.5, H - side * 0.5), 2.2, px)
    // The light strips: red in the side bands, blue in the foot band.
    fo = mk_frame_light(fo, w, vec2(side * 0.5, ic.y), vec2(1.2, 34.0), px, vec3(1.0, 0.150, 0.150))
    fo = mk_frame_light(fo, w, vec2(W - side * 0.5, ic.y), vec2(1.2, 34.0), px, vec3(1.0, 0.150, 0.150))
    fo = mk_frame_light(fo, w, vec2(W * 0.28, H - side * 0.5), vec2(40.0, 1.2), px, vec3(0.180, 0.520, 1.0))
    fo = mk_frame_light(fo, w, vec2(W * 0.72, H - side * 0.5), vec2(40.0, 1.2), px, vec3(0.180, 0.520, 1.0))
    let frame = Finish.cover(0.0 - di, px)
    return mix(col, fo.rgb, frame)
}

// ---------------------------------------------------------------- the cap

// AN ARMOUR CAP: a plate with its corners cut `k` points at 45 degrees,
// standing on the hull. Under it what it throws (`lift` 1 a drop shadow
// falling a little down and right, 0 only the contact line); its dark
// outline; a bevel `bw` points wide all round lit by the way it faces --
// near white where it faces the light at the upper left, shaded toward the
// foot and the right -- falling into the face over its width; a fine step
// line where the bevel meets the face; the face falling from `top` to
// `bot`, a sheen over its upper half and the grain of its paint. `rivets` 1
// sets a small screw mark in each corner of the face. Held, the bevel turns
// (lit at the foot, shaded at the top) and the face drops a shade: the cap
// is pushed into the hull. Premultiplied.
let mk_cap = fn(p: vec2, lo: vec2, hi: vec2, k: float, px: float, hover: float, down: float, focus: float, lift: float, top: vec3, bot: vec3, hl: vec3, sh: vec3, ol: vec3, line: vec3, bw: float, rivets: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let d = mk_oct(p, c, h, k)
    let up = 1.0 - down
    // What it throws: a dense shade right under the foot and a soft one
    // carrying on down and a little right; to the sides both stay inside
    // half an 8 point gap.
    let s = min(hh, 26.0)
    let d1 = mk_oct_drop(p, c, h - vec2(0.04 * s, 0.0), mk_oct_k(k, -0.02 * s), vec2(0.02 * s, 0.07 * s), 0.05 * s)
    let d2 = mk_oct_drop(p, c, h - vec2(0.12 * s, 0.03 * s), mk_oct_k(k, -0.075 * s), vec2(0.05 * s, 0.15 * s), 0.13 * s)
    let drop = (1.0 - (1.0 - 0.75 * d1) * (1.0 - 0.6 * d2)) * lift * up * 0.620
    let contact = mk_oct_drop(p, c, h, k, vec2(0.0, px), px * 0.7) * 0.55
    let sha = 1.0 - (1.0 - drop) * (1.0 - contact)
    var res = vec4(vec3(0.000, 0.000, 0.000) * sha, sha)
    // The face.
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var face = mix(top, bot, smoothstep(0.0, 1.0, t))
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    face = face + (hl - face) * Finish.sheen(uv, 0.0, 0.5, 0.25) * 0.18 * up
    let tx = mk_paint(p + lo * 3.1, px, 0.010)
    face = face + vec3(tx, tx, tx * 1.04)
    face = face + vec3(1.0, 1.0, 1.0) * 0.045 * hover * up
    face = mix(face, face * 0.88, down)
    // A rivet in each corner of the face, on a cap big enough to hold them.
    let inner = h - vec2(bw + px * 2.0 + 2.6, bw + px * 2.0 + 2.6)
    let rc = c + vec2(step(c.x, p.x) * 2.0 - 1.0, step(c.y, p.y) * 2.0 - 1.0) * inner
    let rl = length(p - rc)
    let rv = rivets * step(20.0, hh) * step(48.0, hi.x - lo.x)
    face = mix(face, line, Finish.cover(rl - 0.8, px) * rv * 0.8)
    face = mix(face, hl, Finish.cover(length(p - rc - vec2(0.35, 0.35)) - 0.45, px) * rv * 0.7)
    // The bevel: lit by the way it faces; held, turned over.
    let n = mk_cham_n(p, c, h, k)
    var l = mk_lit(n)
    l = mix(l, 0.0 - l * 0.85, down)
    let inb = Finish.band(d, px, px + bw, px)
    let u = clamp((0.0 - d - px) / max(bw, px), 0.0, 1.0)
    var bev = mix(sh, hl, smoothstep(-0.8, 0.75, l))
    bev = mix(bev, mix(bev, face, 0.45), u)
    face = mix(face, bev, inb)
    // The outer row of the bevel catches the most light.
    face = mix(face, hl, Finish.band(d, px, px * 2.0, px) * smoothstep(0.3, 0.95, l) * 0.8)
    // The step into the face, and the outline.
    face = mix(face, line, Finish.band(d, px + bw, px * 2.0 + bw, px) * 0.75)
    face = mix(face, ol, Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    res = Finish.over(res, vec4(face * a, a))
    // Focus: a lit blue ring just outside the outline and a breath of it.
    let ring = Finish.ring_out(d, 0.0, px * 1.5, px) * 0.9 + Finish.glow(d - px * 1.5, 1.0) * 0.35 * (1.0 - a)
    res = Finish.over(res, vec4(0.200, 0.520, 1.0, 1.0) * clamp(ring, 0.0, 1.0) * focus)
    return res
}

// A light strip lying along the foot of a cap's face: a pill `hw` half wide
// and two points tall whose middle burns toward white, its colour at the
// edge, a glow round it on the face. `clip` keeps the glow on the face.
// Premultiplied over `dst`.
let mk_strip = fn(dst: vec4, p: vec2, cx: float, cy: float, hw: float, px: float, col: vec3, lit: float, clip: float) -> vec4 {
    let d = Finish.sd_pill(p, vec2(cx, cy), vec2(hw, 1.0))
    let x = max(d, 0.0)
    let g = (0.55 * exp(-(x * x) / (2.0 * 0.9 * 0.9)) + 0.25 * exp(-(x * x) / (2.0 * 2.6 * 2.6))) * (1.0 - Finish.cover(d, px))
    var o = Finish.over(dst, vec4(col, 1.0) * g * lit * clip)
    let core = 1.0 - smoothstep(0.0, 0.9, abs(p.y - cy + 0.2))
    let ink = mix(col, mix(col, vec3(1.0, 1.0, 1.0), 0.85), core)
    o = Finish.over(o, vec4(mix(col * 0.25, ink, lit), 1.0) * Finish.cover(d, px))
    return o
}

// ---------------------------------------------------------------- buttons

// Every button is the same armour cap: 26 points on a 13 point line, 12
// points either side. Its shadow falls outside the box, so the box is the
// outline and nothing is paid in padding.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
// Glyphs sit at 14 points so an icon never makes a cap taller than the row;
// an icon alone gets a square cap.
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
// The caps that carry a light strip lift their label one device pixel, so
// the strip clears the descenders.
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.3333 bottom: 4.6667}
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.3333 bottom: 4.6667}
// The short rungs keep their own heights under the row minimum.
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonXs.draw_text.text_style.font_size = 7.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(1.0)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.34)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The cap and its states, shared by every button template; `kind` picks the
// variant: 0 the plain cap, 1 the red cap (the default action), 2 primary (a
// blue light strip), 3 secondary, 4 tertiary (seated lower), 5 danger (a
// red light strip), 6 outline, 7 flatter, 8 the navy cap that holds an icon.
// Disabled, every cap turns dark slate with pale words.
let mk_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 12.0
    let px = mk_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mk_snap(0.0, o.x, px), mk_snap(0.0, o.y, px))
    let hi = vec2(mk_snap(size.x, o.x, px), mk_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let k = clamp((hi.y - lo.y) * 0.22, 3.0, 6.5)
    let bw = clamp((hi.y - lo.y) * 0.1, 1.5, 3.0)
    let live = 1.0 - disabled
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 5.5 && kind < 7.5 {
        // Outline: no face, the cap's frame alone -- outline, bevel and
        // step line round the bare hull; under the hand a faint cap shows,
        // held it sinks.
        let d = mk_oct(p, c, h, k)
        let n = mk_cham_n(p, c, h, k)
        let l = mk_lit(n)
        if kind < 6.5 {
            var ring = Finish.band(d, 0.0, px, px)
            var frame = Finish.band(d, px, px + bw, px)
            if dash > 0.0 {
                let dm = step(0.5, fract((p.x + p.y) / (dash * 2.0)))
                ring = ring * dm
                frame = frame * dm
            }
            let bev = mix(vec3(0.165, 0.235, 0.333), vec3(0.651, 0.745, 0.867), smoothstep(-0.8, 0.75, l))
            res = vec4(bev, 1.0) * frame * mix(1.0, 0.6, disabled)
            res = Finish.over(res, vec4(vec3(0.043, 0.082, 0.141), 1.0) * Finish.band(d, px + bw, px * 2.0 + bw, px) * 0.8)
            res = Finish.over(res, vec4(vec3(0.004, 0.012, 0.024), 1.0) * ring * mix(1.0, 0.5, disabled))
        }
        if hover + down > 0.001 {
            let cap = mk_cap(p, lo, hi, k, px, hover, down, focus, 0.4, vec3(0.118, 0.184, 0.275), vec3(0.067, 0.114, 0.188), vec3(0.651, 0.745, 0.867), vec3(0.165, 0.235, 0.333), vec3(0.004, 0.012, 0.024), vec3(0.043, 0.082, 0.141), bw, 0.0)
            res = Finish.over(res, cap * clamp(max(hover, down), 0.0, 1.0) * live)
        }
        let fr = Finish.ring_out(d, 0.0, px * 1.5, px) * 0.9 + Finish.glow(d - px * 1.5, 1.0) * 0.35 * (1.0 - Finish.cover(d, px))
        res = Finish.over(res, vec4(0.200, 0.520, 1.0, 1.0) * clamp(fr, 0.0, 1.0) * focus * live)
    } else {
        var top = vec3(0.118, 0.184, 0.275)
        var bot = vec3(0.067, 0.114, 0.188)
        var hl = vec3(0.651, 0.745, 0.867)
        var sh = vec3(0.165, 0.235, 0.333)
        var ol = vec3(0.004, 0.012, 0.024)
        var line = vec3(0.043, 0.082, 0.141)
        var lift = 1.0
        if kind > 0.5 && kind < 1.5 {
            // The red cap: lacquer red lit from the top, a hot bevel.
            top = vec3(0.835, 0.235, 0.235)
            bot = vec3(0.620, 0.090, 0.098)
            hl = vec3(1.0, 0.640, 0.620)
            sh = vec3(0.330, 0.035, 0.045)
            ol = vec3(0.220, 0.020, 0.030)
            line = vec3(0.470, 0.060, 0.070)
        }
        if kind > 7.5 {
            top = vec3(0.118, 0.184, 0.275)
            bot = vec3(0.067, 0.114, 0.188)
            hl = vec3(0.651, 0.745, 0.867)
            sh = vec3(0.165, 0.235, 0.333)
            ol = vec3(0.004, 0.012, 0.024)
            line = vec3(0.165, 0.235, 0.333)
        }
        if kind > 3.5 && kind < 4.5 {
            lift = 0.55
        }
        top = mix(top, vec3(0.224, 0.263, 0.318), disabled)
        bot = mix(bot, vec3(0.169, 0.204, 0.255), disabled)
        hl = mix(hl, vec3(0.369, 0.416, 0.478), disabled)
        sh = mix(sh, vec3(0.063, 0.082, 0.110), disabled)
        line = mix(line, vec3(0.063, 0.082, 0.110), disabled)
        ol = mix(ol, vec3(0.063, 0.082, 0.110) * 0.8, disabled)
        let fo = focus * live
        if kind > 0.5 && kind < 1.5 {
            // The red cap glows a little onto the hull round it.
            let d = mk_oct(p, c, h, k)
            res = vec4(0.95, 0.20, 0.20, 1.0) * Finish.glow(d, 2.2) * 0.30 * 1.000 * (1.0 - Finish.cover(d, px)) * live * (1.0 - down * 0.5)
        }
        res = Finish.over(res, mk_cap(p, lo, hi, k, px, hover * live, down * live, fo, lift, top, bot, hl, sh, ol, line, bw, 1.0))
        if kind > 1.5 && kind < 2.5 || kind > 4.5 && kind < 5.5 {
            // The light strip along the foot of the face: blue on the
            // primary, red on the danger cap; held, its light halves; out
            // (disabled) it is dark glass.
            var col = vec3(0.180, 0.520, 1.0)
            if kind > 4.5 {
                col = vec3(1.0, 0.210, 0.200)
            }
            let d = mk_oct(p, c, h, k)
            let clip = Finish.cover(d + bw + px * 2.0, px)
            let cy = mk_snap(hi.y - bw - px * 2.0 - 1.0, o.y, px) - px * 0.5
            res = mk_strip(res, p, c.x, cy, min(14.0, h.x * 0.42), px, col, live * (1.0 - down * 0.5), clip)
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 7.0, 2.0)
        res = mk_spinner(res, p, c, rad, anim, loading, 1.5, vec3(0.902, 0.922, 0.949))
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0), 12.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0), 12.0)
}
mod.widgets.ButtonIcon.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 8.0, 0.0), 12.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0, 0.0), 12.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0, 0.0), 12.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0, 0.0), 12.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0, 0.0), 12.0)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0, self.border_dash), 12.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return self.host_over(mk_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0, 0.0), 12.0)
}

