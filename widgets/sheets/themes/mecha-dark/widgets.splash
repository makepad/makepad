// An icon on the red cap or the navy cap is white, whatever ink its caller
// gave it: a dark glyph is lost on either.
mod.widgets.Button.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    return vec4(vec3(1.0, 1.0, 1.0) * base.a, base.a) * self.opacity
}
mod.widgets.ButtonIcon.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    return vec4(vec3(0.902, 0.922, 0.949) * base.a, base.a) * self.opacity
}
