mod.theme = mod.themes.dark

// Mecha dark. The same cockpit in navy armour: deep navy plates with their
// corners cut at 45 degrees and screws in them, each part a plate with a
// steel-blue bevel lit from the upper left. Ink is a pale blue-white.
// Fields, lists and screens are near-black glass in a navy frame. The
// suit's colour code marks what matters: the default action a red cap,
// blue for a value, a mark that is set and the chosen answer, lit from
// within; yellow, green and purple for the other values. Knobs are
// machined steel with a red index in a dark ring. The faces are drawn in
// widgets.splash, line for line the light sheet's; this file holds the
// tokens every face and every stock widget reads.
mod.theme.color_bg_app = #0f1b2d
mod.theme.color_fg_app = #1a2a3f
mod.theme.color_bg_container = #0f1b2d
mod.theme.color_surface_container = #1b2b41
mod.theme.color_surface_container_lowest = #0a1424
mod.theme.color_bg_even = #00000000
mod.theme.color_bg_odd = #ffffff08
mod.theme.color_highlight = #2a7dff
mod.theme.color_bg_highlight = #1a2a3f
mod.theme.color_bg_highlight_inline = #2a7dff50

// Raised faces the sheet does not redraw: a navy plate, its top lighter.
mod.theme.color_outset = #1e2e45
mod.theme.color_outset_1 = #26384f
mod.theme.color_outset_2 = #152338
mod.theme.color_outset_hover = #24354d
mod.theme.color_outset_1_hover = #2c3f58
mod.theme.color_outset_2_hover = #1a283e
mod.theme.color_outset_focus = #1e2e45
mod.theme.color_outset_1_focus = #26384f
mod.theme.color_outset_2_focus = #152338
mod.theme.color_outset_active = #142134
mod.theme.color_outset_1_active = #142134
mod.theme.color_outset_2_active = #142134
mod.theme.color_outset_down = #142134
mod.theme.color_outset_1_down = #142134
mod.theme.color_outset_2_down = #142134
mod.theme.color_outset_drag = #142134
mod.theme.color_outset_1_drag = #142134
mod.theme.color_outset_2_drag = #142134
mod.theme.color_outset_disabled = #1a2433
mod.theme.color_outset_1_disabled = #1a2433
mod.theme.color_outset_2_disabled = #1a2433

// Wells: near-black navy glass.
mod.theme.color_inset = #08131f
mod.theme.color_inset_1 = #06111c
mod.theme.color_inset_2 = #0b1828
mod.theme.color_inset_hover = #0b1828
mod.theme.color_inset_1_hover = #091522
mod.theme.color_inset_2_hover = #0e1c2e
mod.theme.color_inset_focus = #0b1828
mod.theme.color_inset_1_focus = #091522
mod.theme.color_inset_2_focus = #0e1c2e
mod.theme.color_inset_active = #08131f
mod.theme.color_inset_1_active = #06111c
mod.theme.color_inset_2_active = #0b1828
mod.theme.color_inset_down = #06111c
mod.theme.color_inset_1_down = #050e18
mod.theme.color_inset_2_down = #08131f
mod.theme.color_inset_drag = #06111c
mod.theme.color_inset_1_drag = #050e18
mod.theme.color_inset_2_drag = #08131f
mod.theme.color_inset_empty = #08131f
mod.theme.color_inset_1_empty = #06111c
mod.theme.color_inset_2_empty = #0b1828
mod.theme.color_inset_disabled = #0d1520
mod.theme.color_inset_1_disabled = #0d1520
mod.theme.color_inset_2_disabled = #0d1520

// The device pixel edges of a stock face: steel blue on the top of a
// plate, black under it and round it.
mod.theme.beveling = 0.5
mod.theme.color_bevel = #010306
mod.theme.color_bevel_hover = #010306
mod.theme.color_bevel_focus = #2a7dff
mod.theme.color_bevel_active = #010306
mod.theme.color_bevel_empty = #010306
mod.theme.color_bevel_down = #010306
mod.theme.color_bevel_drag = #010306
mod.theme.color_bevel_disabled = #10161e
mod.theme.color_bevel_inset_1 = #010306
mod.theme.color_bevel_inset_2 = #2c4260
mod.theme.color_bevel_outset_1 = #6c88ab
mod.theme.color_bevel_outset_2 = #03070d
mod.theme.color_bevel_inset_1_hover = #010306
mod.theme.color_bevel_inset_2_hover = #2c4260
mod.theme.color_bevel_outset_1_hover = #6c88ab
mod.theme.color_bevel_outset_2_hover = #03070d
mod.theme.color_bevel_inset_1_focus = #2a7dff
mod.theme.color_bevel_inset_2_focus = #2a7dff
mod.theme.color_bevel_outset_1_focus = #2a7dff
mod.theme.color_bevel_outset_2_focus = #2a7dff
mod.theme.color_bevel_inset_1_down = #010306
mod.theme.color_bevel_inset_2_down = #2c4260
mod.theme.color_bevel_outset_1_down = #03070d
mod.theme.color_bevel_outset_2_down = #6c88ab
