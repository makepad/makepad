// Tabs: quiet words on the plate, parted by a short lavender line; the tab
// in use a navy pill 2 points in carrying white words and an indigo-blue
// slit lit in its wall; under the hand a quiet pale pill pressed in.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
let po_tab = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, active: float) -> vec4 {
    let m = 22.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(1.0, o.x, px), po_snap(2.0, o.y, px))
    let hi = vec2(po_snap(size.x - 1.0, o.x, px), po_snap(size.y - 2.0, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if active > 0.5 {
        res = po_cap_r(p, lo, hi, r, px, hover, 0.0, 0.0, 0.0, 0.8, 0.0, 0.0, 40.0, 1.0, 1.0)
        // The indigo-blue slit in its wall, as the primary button carries.
        let tk = clamp(0.135 * (hi.y - lo.y), 1.5, 4.0)
        res = po_led_slit(res, p, (lo.x + hi.x) * 0.5, hi.y + tk * 0.5, clamp(0.11 * (hi.x - lo.x), 2.5, 6.0), min(1.3, tk * 0.5), 0.9, po_led_blue(), px)
    } else {
        if hover > 0.001 {
            res = po_sunk(p, lo, hi, r, px, vec3(0.925, 0.925, 0.957), 0.0, 0.0, 0.0, 0.55) * hover
        }
    }
    return res * po_fade(pos, size, m)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let m = 22.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let m = 22.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let m = 22.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 1.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let span = step(self.rect_size.y * 0.3, p.y) * step(p.y, self.rect_size.y * 0.7)
    let l = step(x, p.x) * step(p.x, x + px) * span
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * span
    return vec4(0.74, 0.74, 0.84, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w * (1.0 - l)
}
mod.widgets.Tabs.draw_mark.color = #b4b6d8
mod.widgets.Tabs.draw_text.color = #4a4d6e
mod.widgets.Tabs.draw_text_active.color = #ffffff
mod.widgets.Tabs.draw_text.text_style.font_size = 9.0
mod.widgets.Tabs.draw_text_active.text_style.font_size = 9.0

// ---------------------------------------------------------------- feedback

// The progress bar: a 6 point navy slot pressed in, the accent's lit rod in
// it, the whole bar standing in an 8 point row.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(6.0, self.rect_size.y)
    let y0 = po_snap((self.rect_size.y - th) * 0.5, o.y, px)
    let x0 = po_snap(self.rect_size.x * self.start, o.x, px)
    let x1 = po_snap(self.rect_size.x * self.end, o.x, px)
    let lo = vec2(x0, y0)
    let hi = vec2(x1, y0 + th)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if self.track > 0.5 {
        res = po_slot(p, lo, hi, th * 0.5, px, 0.0)
    }
    let span = hi.x - lo.x - px * 2.0
    var f0 = lo.x + px
    var f1 = f0 + span * clamp((self.value - self.start) / max(self.end - self.start, 0.001), 0.0, 1.0)
    if self.value < 0.0 {
        // Still: the sweep would need the pass clock, which a sheet may not
        // read, so the unknown is a lit stretch in the middle, ends fading.
        f0 = lo.x + span * 0.3
        f1 = lo.x + span * 0.7
    }
    var fill = po_fill(vec4(0.0, 0.0, 0.0, 0.0), p, vec2(f0, lo.y + px * 1.5), vec2(f1, hi.y - px * 1.5), th * 0.5, px, 0.0, 0.0, 0.0, lo, hi, th * 0.5)
    // An intent other than the plain one tints the light with its colour.
    let ic = self.fill_color()
    let tint = step(0.5, self.intent)
    fill = vec4(mix(fill.rgb, ic.rgb * fill.a, tint * 0.75), fill.a)
    if self.value < 0.0 {
        fill = fill * smoothstep(f0 - 1.0, f0 + span * 0.1, p.x) * smoothstep(f1 + 1.0, f1 - span * 0.1, p.x)
    }
    res = Finish.over(res, fill)
    return res * self.opacity * po_fade(self.pos, self.rect_size, m)
}

// The level meter, a readout of the pictures' displays: cells 3 points long
// with 1.5 point gaps in a navy slot pressed into the plate, lit in their
// display colours -- mint to 70 %, a warm amber to 90 %, coral past it --
// the unlit cells a dim navy, a cell held at the peak, the clip lamp coral.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    let wa = min(across, 8.0)
    let wb0 = (across - wa) * 0.5
    let wlo = mix(vec2(0.0, wb0), vec2(wb0, sz.y - bar), v)
    let whi = mix(vec2(bar, wb0 + wa), vec2(wb0 + wa, sz.y), v)
    let lo = vec2(po_snap(wlo.x, o.x, px), po_snap(wlo.y, o.y, px))
    let hi = vec2(po_snap(whi.x, o.x, px), po_snap(whi.y, o.y, px) - px)
    var res = po_slot(p, lo, hi, 2.0, px, 0.0)
    let pad = 2.0
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.5
    let ca = a - pad
    let cell = Finish.cover(abs(fract(ca / pitch) * pitch - 1.5) - 1.5, px)
    let share = clamp((floor(ca / pitch) * pitch + 1.5) / span, 0.0, 1.0)
    let inb = step(pad, a) * step(a, bar - pad) * step(wb0 + 1.5, b) * step(b, wb0 + wa - 1.5)
    let ha = max(self.hot_at, 0.7)
    var lit = mix(vec3(0.33, 0.78, 0.74), vec3(0.45, 0.92, 0.85), smoothstep(0.0, 1.0, share / ha))
    lit = mix(lit, vec3(0.98, 0.72, 0.36), step(ha, share))
    lit = mix(lit, vec3(0.95, 0.40, 0.46), step(max(self.hot_to, 0.9), share))
    let qm = (b - (wb0 + wa * 0.5)) / max(0.3 * (wa - 3.0), px * 0.8)
    lit = mix(lit, vec3(0.92, 1.0, 0.98), exp(-qm * qm) * 0.35)
    let on = step(share, self.level) * step(0.001, self.level)
    let ghost = vec3(0.155, 0.170, 0.300)
    let col = mix(ghost, lit, on)
    res = Finish.over(res, vec4(col, 1.0) * cell * inb * self.opacity)
    let hold_at = floor((span * self.hold) / pitch) * pitch
    let hc = step(abs(floor(ca / pitch) * pitch - hold_at), 0.1) * step(0.002, self.hold)
    res = Finish.over(res, vec4(vec3(0.90, 0.92, 1.0), 1.0) * hc * cell * inb * 0.9)
    if self.lamp > 0.5 {
        let lc = mix(vec2(bar + 3.0 + across * 0.5, sz.y * 0.5), vec2(sz.x * 0.5, across * 0.5), v)
        let rl = max(across * 0.5 - 2.0, 1.0)
        let ld = Finish.sd_circle(p, lc, rl)
        let over = step(0.5, self.over)
        res = po_lit(res, vec3(0.95, 0.30, 0.40) * (1.2 / (1.0 + (max(ld, 0.0) / 0.9) * (max(ld, 0.0) / 0.9))) * (1.0 - smoothstep(rl, rl + 4.0, max(ld, 0.0))) * over)
        let la = Finish.cover(ld, px)
        let lcol = mix(vec3(0.80, 0.80, 0.88), mix(vec3(0.92, 0.30, 0.40), vec3(1.0, 0.86, 0.88), 1.0 - smoothstep(0.0, rl, length(p - lc))), over)
        res = Finish.over(res, vec4(lcol * la, la))
    }
    return res * self.opacity
}

// The spinner keeps the library's own turning face and takes the violet.
mod.widgets.SpinnerFlat.draw_bg.color = #6a5cc8
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.15

// The rings, the arc and the stock bars keep their own faces; the plain
// intent reads in the accent.
mod.widgets.ProgressRingFlat.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressRing.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressArc.draw_bg.color_primary = #5a4fc0
mod.widgets.ActivityRings.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressBar.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressBarGradientX.draw_bg.color_primary = #5a4fc0
mod.widgets.ProgressBarGradientY.draw_bg.color_primary = #5a4fc0

// Words in the error intent beside a check box or a toggle: a deep red that
// reads on the plate.
mod.widgets.CheckBoxFlat.draw_text.color_error = #a8213a
mod.widgets.ToggleFlat.draw_text.color_error = #a8213a

// ---------------------------------------------------------------- surfaces

// The scroll bar: an 8 point gutter with no fill; the thumb a 5 point
// lavender pill, darker on a white page and lighter on a navy screen,
// stronger under the hand.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 1.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.is_vertical
    let t0 = mix(sz.x * self.norm_scroll, sz.y * self.norm_scroll, v)
    let t1 = t0 + mix(sz.x * self.norm_handle, sz.y * self.norm_handle, v)
    let mid = mix(sz.y * 0.5, sz.x * 0.5, v)
    let tlo = mix(vec2(t0, mid - 2.5), vec2(mid - 2.5, t0), v)
    let thi = mix(vec2(t1, mid + 2.5), vec2(mid + 2.5, t1), v)
    let lo = vec2(po_snap(tlo.x, o.x, px), po_snap(tlo.y, o.y, px))
    let hi = vec2(po_snap(thi.x, o.x, px), po_snap(thi.y, o.y, px))
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 2.5)
    let a = Finish.cover(d, px) * (0.42 + 0.22 * max(self.hover, self.drag))
    return vec4(vec3(0.53, 0.54, 0.74) * a, a) * self.opacity
}

// The fine grain of the glaze: monochrome, one value per two device pixels,
// laid in window space so it never repeats and never swims.
let po_grain = fn(p: vec2, o: vec2, px: float) -> float {
    return Finish.grain((p + o) / (2.0 * px), 0.008)
}

// A raised panel, the pictures' thick white slab: its top face whiter than
// the plate, brightest at the top, a white device pixel and a 3 point
// shoulder of light along its upper edge; under the face its side shows 5
// points thick, a lavender band darkening to the foot, closed by a darker
// device pixel; a corner of 14. It throws a large soft lavender shadow,
// drawn in 6 points from the sides so it stays inside the gap to its
// neighbours, half gone 7 points under the foot and gone by 30, and a close
// contact shadow. `leak` lets the warm light out from under its foot: the
// pictures' backlight, added into its shadow. `lights` 1 gives a panel its
// rivets and its green corner light, 2 a card the lit slit in its foot.
let po_panel = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, hover: float, leak: float, lift: float, lights: float) -> vec4 {
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = po_normal(p, c, h, r)
    let hs = vec2(max(h.x - 6.0, 1.0), h.y)
    let amb = Finish.drop(p, c, hs, min(r, min(hs.x, hs.y)), vec2(0.0, 6.5 + 1.0 * hover), 5.0) * (0.26 + 0.05 * hover) * lift
    let near = Finish.drop(p, c, h - vec2(1.5, 0.0), r, vec2(0.0, 2.0), 1.6) * 0.22 * min(lift + 0.4, 1.0)
    let con = Finish.drop(p, c, h - vec2(0.5, 0.0), r, vec2(0.0, 0.5 + px * 0.5), 0.5 + px * 0.5) * 0.3
    // The broad shadow of a thick slab: held deep for several points under
    // the foot and gone about 30 under it, drawn in 6 points from the sides
    // and narrowing and softening as it falls, so none of it reaches into
    // the gap beside the slab.
    let bdy = max(p.y - hi.y, 0.0)
    let bw = 2.5 + 0.3 * bdy
    let bx = smoothstep(-bw, bw, (h.x - 6.0 - 0.25 * bdy) - abs(p.x - c.x))
    let by = smoothstep(c.y, hi.y - 2.0, p.y) * (1.0 - smoothstep(3.0, 30.0, p.y - hi.y))
    let broad = bx * by * 0.40 * min(lift, 1.0)
    let sc = (1.0 - (1.0 - amb) * (1.0 - near) * (1.0 - con) * (1.0 - broad)) * (1.0 - a)
    var res = vec4(po_shade() * sc, sc)
    if leak > 0.001 {
        res = po_lit(res, po_warm(p, c.x, hi.y - 1.0, clamp(0.08 * size.x, 14.0, 36.0), 14.0, leak) * (1.0 - a))
    }
    let tk = 5.0
    let hf = vec2(h.x, h.y - tk * 0.5)
    let cf = vec2(c.x, c.y - tk * 0.5)
    let df = Material.sd_box(p, cf, hf, min(r, min(hf.x, hf.y)))
    let af = Finish.cover(df, px)
    let t = clamp((p.y - lo.y) / max(hf.y * 2.0, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.985, 0.985, 0.997), vec3(0.952, 0.952, 0.978), t) + vec3(0.008, 0.008, 0.006) * hover
    face = face + vec3(1.0, 1.0, 1.0) * po_grain(p, o, px)
    let x = max(-df, 0.0)
    let upper = smoothstep(0.0, 0.9, -n.y)
    face = mix(face, vec3(1.0, 1.0, 1.0), (1.0 - smoothstep(0.0, 3.0, x)) * upper * 0.8)
    face = mix(face, vec3(0.99, 0.99, 1.0), Finish.band(df, 0.0, px, px) * smoothstep(0.2, 0.8, n.y) * 0.85)
    face = min(face, vec3(1.0, 1.0, 1.0))
    let wk = clamp(df / max(df - d, 0.001), 0.0, 1.0)
    let wall = mix(vec3(0.890, 0.890, 0.935), vec3(0.790, 0.790, 0.862), wk)
    var col = mix(wall, face, af)
    let ring = Finish.band(d, 0.0, px, px)
    var edge = mix(vec3(0.830, 0.830, 0.890), vec3(1.0, 1.0, 1.0), smoothstep(0.3, 0.8, -n.y))
    edge = mix(edge, vec3(0.62, 0.62, 0.74), smoothstep(0.3, 0.85, n.y))
    col = mix(col, edge, ring)
    // Two small rivets pressed into the face at its left edge, as the
    // pictures' panels carry.
    if lights > 0.5 && size.y > 50.0 {
        let rv = min(length(p - vec2(lo.x + 6.0, lo.y + 13.0)), length(p - vec2(lo.x + 6.0, hi.y - tk - 10.0))) - 2.2
        let ra = Finish.cover(rv, px) * af
        col = mix(col, vec3(0.86, 0.86, 0.91), ra)
        col = mix(col, vec3(0.70, 0.70, 0.80), Finish.band(rv, 0.0, px, px) * af * 0.8)
        col = mix(col, vec3(1.0, 1.0, 1.0), Finish.ring_out(rv, 0.0, px, px) * af * 0.7)
    }
    // The slab's side over the light catches a little of it.
    if leak > 0.001 {
        let wl = po_warm(p, c.x, hi.y + 1.0, clamp(0.08 * size.x, 14.0, 36.0), 14.0, 0.45 * leak) * (1.0 - af)
        col = col + (vec3(1.0, 1.0, 1.0) - exp(-wl)) * max(vec3(1.0, 1.0, 1.0) - col, vec3(0.0, 0.0, 0.0))
    }
    res = Finish.over(res, vec4(col * a, a))
    // The lights: on a panel a small green lozenge lit by its top right
    // corner (the pictures' status light); on a raised card an indigo-blue
    // slit lit in its wall at the foot (the pictures' header cards).
    if lights > 0.5 && size.x > 60.0 {
        res = po_led_slit(res, p, hi.x - 16.0, lo.y + 8.0, 3.0, 2.2, 0.9, po_led_green(), px)
    }
    if lights > 1.5 {
        res = po_led_slit(res, p, c.x, hi.y - tk * 0.5, clamp(0.06 * size.x, 4.0, 10.0), 1.6, 0.9 + 0.2 * hover, po_led_blue(), px)
    }
    return res
}
// A tray: the same box pressed into the plate. Its floor a lavender a step
// under the plate round it; the rim shades it from the top over 5 points;
// along its lower inner edge the wall that faces the light is a pale strip;
// a lavender device pixel on its upper rim and a white lip on the plate
// under its foot.
let po_tray = fn(p: vec2, size: vec2, o: vec2, px: float, r: float) -> vec4 {
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let lipa = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(0.2, 0.9, n.y)
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var col = vec3(0.870, 0.870, 0.925) + vec3(1.0, 1.0, 1.0) * po_grain(p, o, px)
    col = mix(col, vec3(0.52, 0.52, 0.68), 0.8 * Finish.inset(p, c, h, r, vec2(0.0, 3.0), 3.2))
    col = mix(col, vec3(0.975, 0.975, 0.992), Finish.band(d, px, 2.4, px) * smoothstep(0.35, 0.9, n.y) * 0.8)
    col = mix(col, vec3(0.62, 0.62, 0.74), Finish.band(d, 0.0, px, px) * (1.0 - smoothstep(-0.9, 0.3, n.y)))
    return Finish.over(res, vec4(col * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 36.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 36.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    if self.sunken > 0.5 {
        return po_tray(p, self.rect_size, self.rect_pos, px, 14.0) * po_fade(self.pos, self.rect_size, m)
    }
    return po_panel(p, self.rect_size, self.rect_pos, px, 14.0, 0.0, 1.0, 1.0, 1.0) * po_fade(self.pos, self.rect_size, m)
}

// The rounded view keeps the colour its caller gives it, with a true
// corner and, when it is opaque, a one device pixel edge.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    var ink = self.border_color
    if self.border_size < 0.01 {
        ink = vec4(0.80, 0.80, 0.87, fill.a)
    }
    let a = Finish.cover(d, px)
    let bd = Finish.band(d, 0.0, max(self.border_size, px), px)
    var col = mix(fill.rgb, ink.rgb, bd * ink.a)
    return vec4(col * a * fill.a, a * fill.a) + vec4(ink.rgb * ink.a, ink.a) * bd * a * (1.0 - fill.a)
}

// The card: its three appearances told apart. Elevated, a thick white slab
// standing well off the plate with the warm light leaking from under its
// foot, more of it under the hand; filled, a slab seated with its contact
// shadow only; outlined, the plate inside one lavender device pixel.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 36.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 36.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let fade = po_fade(self.pos, self.rect_size, m)
    if self.border_size > 0.01 {
        let o = self.rect_pos
        let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
        let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 14.0)
        let n = po_normal(p, c, h, 14.0)
        let ring = Finish.band(d, 0.0, px, px)
        let col = mix(vec3(0.68, 0.68, 0.78), vec3(0.78, 0.78, 0.86), smoothstep(-0.3, 0.9, -n.y))
        let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y)
        let wash = 0.3 * self.hover * Finish.cover(d, px)
        var res = vec4(vec3(1.0, 1.0, 1.0) * wash, wash)
        res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * lip, lip))
        return Finish.over(res, vec4(col * ring, ring)) * fade
    }
    if self.shadow_radius < 0.01 {
        return po_panel(p, self.rect_size, self.rect_pos, px, 14.0, self.hover, 0.0, 0.0, 0.0) * fade
    }
    return po_panel(p, self.rect_size, self.rect_pos, px, 14.0, self.hover, 1.0 + 0.4 * self.hover, 1.4, 2.0) * fade
}

// LISTS ARE SCREENS, the pictures' "Available Presets": the rows stand in a
// navy display well, each row drawing the part of the well it covers, the
// well being the clip the rows are drawn in (the list's own box), so it
// stays put while the rows scroll. Its floor the screens' navy, darker
// under its top edge where the plate shades it, its rim a lavender device
// pixel catching the light at the foot; every other row a faint shade
// lighter; under the hand a row lightens; the chosen row a lit pill of the
// accent with its violet light round it. The words are the screens' pale
// lavender.
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.clip_x = false
mod.widgets.ListItem.clip_y = false
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let tlo = vec2(po_snap(self.draw_clip.x - o.x, o.x, px), po_snap(self.draw_clip.y - o.y, o.y, px))
    let thi = vec2(po_snap(self.draw_clip.z - o.x, o.x, px), po_snap(self.draw_clip.w - o.y, o.y, px))
    let tc = (tlo + thi) * 0.5
    let th = max((thi - tlo) * 0.5, vec2(1.0, 1.0))
    let tr = min(9.0, min(th.x, th.y))
    let d = Material.sd_box(p, tc, th, tr)
    let n = po_normal(p, tc, th, tr)
    let a = Finish.cover(d, px)
    let k = floor((o.y + self.rect_size.y * 0.5) / max(self.rect_size.y, 1.0))
    let odd = k - 2.0 * floor(k * 0.5)
    var col = vec3(0.063, 0.082, 0.169) + vec3(0.012, 0.012, 0.018) * odd
    col = col + vec3(1.0, 1.0, 1.0) * po_grain(p, o, px) * 0.5
    col = mix(col, vec3(0.015, 0.020, 0.055), 0.7 * Finish.inset(p, tc, th, tr, vec2(0.0, 2.5), 3.0))
    col = col + vec3(0.040, 0.042, 0.075) * self.hover * live - vec3(0.02, 0.02, 0.03) * self.down * live
    col = mix(col, vec3(0.16, 0.17, 0.31), Finish.band(d, px, 1.8, px) * smoothstep(0.35, 0.9, n.y) * 0.6)
    let edge = mix(vec3(0.05, 0.055, 0.13), vec3(0.62, 0.62, 0.76), smoothstep(-0.2, 0.9, n.y))
    col = mix(col, edge, Finish.band(d, 0.0, px, px))
    var res = vec4(col * a, a)
    // Each row's light in its right margin, clear of anything the row holds
    // at its end: the screen's dim slate dot while it is not chosen.
    let lc = vec2(po_snap(self.rect_size.x - 6.0, o.x, px), po_snap(self.rect_size.y * 0.5, o.y, px))
    let la = Finish.cover(length(p - lc) - 1.3, px) * a * (1.0 - self.selected)
    res = Finish.over(res, vec4(vec3(0.30, 0.32, 0.50) * la, la))
    if self.selected > 0.001 {
        let lo = vec2(po_snap(4.0, o.x, px), po_snap(3.0, o.y, px))
        let hi = vec2(po_snap(self.rect_size.x - 4.0, o.x, px), po_snap(self.rect_size.y - 3.0, o.y, px))
        let sc = (lo + hi) * 0.5
        let sh = (hi - lo) * 0.5
        let sr = min(7.0, sh.y)
        let sd = Material.sd_box(p, sc, sh, sr)
        let sn = po_normal(p, sc, sh, sr)
        let sa = Finish.cover(sd, px) * self.selected
        let glow = 0.7 / (1.0 + (max(sd, 0.0) / 1.6) * (max(sd, 0.0) / 1.6)) * (1.0 - smoothstep(2.0, 5.0, sd)) * a * self.selected
        res = po_lit(res, vec3(0.36, 0.30, 0.95) * glow)
        let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
        var sel = mix(vec3(0.40, 0.35, 0.80), vec3(0.25, 0.23, 0.60), t)
        sel = mix(sel, vec3(0.62, 0.58, 0.95), Finish.band(sd, 0.0, px, px) * smoothstep(0.2, 0.8, -sn.y))
        sel = mix(sel, vec3(0.16, 0.14, 0.42), Finish.band(sd, 0.0, px, px) * smoothstep(0.2, 0.8, sn.y))
        res = Finish.over(res, vec4(sel * sa, sa))
        res = po_led(res, p, lc, 1.4, self.selected, vec3(0.62, 0.70, 1.0), px)
    }
    return res
}
mod.widgets.ListItem.draw_text.color = #e6e8fa
mod.widgets.ListItem.draw_text_2.color = #a6a9cf

// A chip is a small seated white pill; its label navy whatever its role.
mod.widgets.ChipFlat.draw_text.text_style.font_size = 9.0
mod.widgets.ChipFlat.palette.on_neutral = #191b38
mod.widgets.ChipFlat.palette.on_neutral_container = #191b38
mod.widgets.ChipFlat.palette.neutral = #191b38
mod.widgets.ChipFlat.palette.on_primary = #191b38
mod.widgets.ChipFlat.palette.on_primary_container = #191b38
mod.widgets.ChipFlat.palette.primary = #191b38
mod.widgets.ChipFlat.palette.on_secondary_container = #191b38
mod.widgets.ChipFlat.palette.on_tertiary_container = #191b38
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 22.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 22.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    let spot = 0.35 * self.hover + 0.3 * self.down
    var res = po_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, self.hover, self.down, 0.0, self.keyed, 0.3, 0.0, spot)
    return res * po_fade(self.pos, self.rect_size, m)
}

// A count is a small white pill with navy figures.
mod.widgets.BadgePalette.neutral = #fafafd
mod.widgets.BadgePalette.on_neutral = #191b38
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x - px * 0.49, o.x, px), po_snap(self.rect_size.y - px * 0.49, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(h.x, h.y)
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = self.color.rgb + vec3(0.02, 0.02, 0.02) * (1.0 - t) - vec3(0.035, 0.035, 0.025) * t
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(min(col, vec3(1.0, 1.0, 1.0)), mix(vec3(0.68, 0.68, 0.78), vec3(1.0, 1.0, 1.0), smoothstep(-0.35, 0.35, -n.y)), ring)
    let a = Finish.cover(d, px) * max(self.color.a, ring)
    return vec4(col * a, a)
}

// LAMPS. The Lamp and the bar lamp are the sheet's LED (above), a glossy
// bead in a white porcelain ring that throws its own soft shadow, as on the
// pictures' white control panels; the accent lamp burns the sheet's indigo
// going to violet.
// The Lamp widget and the bar lamp: the lamp above in the sheet's socket.
// The halo's room is held in the lamp's own box (the library reserves a
// lens thickness either side once a halo is asked for), so the light is
// never cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_accent = uniform(#6b5cf2)
mod.widgets.Lamp.draw_bg.color_success = uniform(#34c98e)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#f5a742)
mod.widgets.Lamp.draw_bg.color_error = uniform(#ec4d6a)
mod.widgets.Lamp.draw_bg.color_plain = uniform(#ffe2bd)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    let half_len = max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5)
    // The lens is the lamp's size; its bezel stands round it in the room.
    let hb = vec2(mix(t * 0.5, half_len, self.bar), t * 0.5)
    let res = po_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 0.35 * (1.0 - step(3.5, self.intent)), px, po_ground(), max(room - 0.5, 2.0), vec3(0.975, 0.975, 0.99), 1.0)
    return res * self.opacity
}

// Dividers are engraved: a lavender device pixel with a white one under it,
// and at each end a small warm light lit in the plate, as along the
// pictures' dividers.
mod.widgets.Hr.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Hr.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let span = step(7.0, p.x) * step(p.x, self.rect_size.x - 7.0)
    let l = step(y, p.y) * step(p.y, y + px) * span
    let w = step(y + px, p.y) * step(p.y, y + px * 2.0) * (1.0 - l) * span
    var res = vec4(0.77, 0.77, 0.86, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w
    if self.rect_size.x > 40.0 {
        res = po_led(res, p, vec2(2.5, y + px), 1.3, 1.0, po_led_warm(), px)
        res = po_led(res, p, vec2(self.rect_size.x - 2.5, y + px), 1.3, 1.0, po_led_warm(), px)
    }
    return res * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let l = step(x, p.x) * step(p.x, x + px)
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * (1.0 - l)
    return vec4(0.77, 0.77, 0.86, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w
}

// ---------------------------------------------------------------- screens

// A SCREEN is a navy display let into the plate, the pictures' "Filter
// Envelope" and CPU graph: the face the screens' navy, darkest under its
// top edge where the plate shades it (`recess` points deep), a device pixel
// of near black where the face meets its wall; the wall (`bezel` points) a
// lavender in shadow along the top going to a pale strip that catches the
// light along the foot; a white lip on the plate under it. Figures on it
// are the screens' pale lavender.
let po_screen = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, bezel: float, recess: float, face_ink: vec3) -> vec4 {
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let ro = min(r, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, ro)
    let n = po_normal(p, c, ho, ro)
    let b = Finish.snap(max(bezel, px), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(ro - b, 0.0)
    let fd = Material.sd_box(p, c, hf, rf)
    let lipa = Finish.ring_out(outer, 0.0, px * 1.5, px) * smoothstep(0.1, 0.9, n.y)
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var wall = mix(vec3(0.60, 0.60, 0.73), vec3(0.93, 0.93, 0.97), smoothstep(-0.6, 0.8, n.y))
    wall = mix(wall, vec3(0.50, 0.50, 0.64), Finish.band(outer, 0.0, px, px) * (1.0 - smoothstep(-0.9, 0.3, n.y)))
    var face = face_ink
    if recess > 0.0 {
        let insh = Finish.inset(p, c, hf, rf, vec2(0.0, recess * 0.5), max(recess * 0.45, 0.3))
        face = mix(face, vec3(0.010, 0.014, 0.040), 0.75 * insh)
    }
    face = mix(face, vec3(0.008, 0.010, 0.030), Finish.band(fd, 0.0, px, px) * 0.8)
    let col = mix(wall, face, Finish.cover(fd, px))
    let a = Finish.cover(outer, px)
    return Finish.over(res, vec4(col * a, a))
}
mod.widgets.ScreenView.draw_bg.border_radius = uniform(9.0)
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    var res = po_screen(p, self.rect_size, self.rect_pos, px, self.border_radius, self.bezel, self.recess, self.color.rgb)
    // The screen's status light, lit mint in its top right corner; its
    // light stays on the face.
    let b = max(self.bezel, 1.0)
    let fdist = Material.sd_box(p, self.rect_size * 0.5, max(self.rect_size * 0.5 - vec2(b, b), vec2(0.5, 0.5)), max(self.border_radius - b, 0.0))
    res = mix(res, po_led(res, p, vec2(self.rect_size.x - b - 5.0, b + 5.0), 1.4, 1.0, po_led_green(), px), Finish.cover(fdist + 0.5, px))
    if self.scan > 0.0 {
        let s = Finish.scan(p.y, px, 3.0 * px, self.scan)
        res = vec4(res.rgb * mix(1.0, s, 0.6), res.a)
    }
    return res * self.color.a
}
// The glass: only a faint diagonal band over the face, no line along its
// top.
mod.widgets.ScreenView.sheen = 0.025
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = po_px(self.draw_pass.dpi_factor)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let b = Finish.snap(max(self.bezel, px), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let fd = Material.sd_box(p, c, hf, max(min(self.face_radius, min(ho.x, ho.y)) - b, 0.0))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let a = clamp(self.sheen * band, 0.0, 1.0) * Finish.cover(fd + px, px)
    return vec4(vec3(0.85, 0.85, 1.0) * a, a)
}

// THE NEEDLE METER is a screen: the same navy display, its scale printed on
// it in the screens' pale lavender (a tick at every division, the majors two
// device pixels wide and the minors one and dimmer, a faint arc under
// them), the red zone a coral band just outside the arc, the needle a pale
// lavender line with a soft violet light along it, and its root under a
// small white porcelain dome that throws its own shadow on the face.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(9.0)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#ee6a78)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = po_px(self.draw_pass.dpi_factor)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let res = po_screen(p, self.rect_size, self.rect_pos, px, self.border_radius, 2.0, 4.0, self.color.rgb)
    var col = res.rgb / max(res.a, 0.001)
    let ink = self.color_scale.rgb
    // The scale: a tick at every division over a faint arc.
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, -q.y * cos(ak) + q.x * sin(ak))
    col = mix(col, ink, max(arc * 0.35, tick * mix(0.55, 0.95, major)))
    // The red zone: a coral band just outside the arc from `zone` on.
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        col = mix(col, self.color_zone.rgb, zone_t * zone_r * 0.9)
    }
    // The needle, from under the pivot dome to just past the scale, a soft
    // violet light along it.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let tail = max(self.pivot_size - px, 0.0)
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let span = smoothstep(-1.0, 1.0, rr + 3.0 - along) * smoothstep(-1.0, 1.0, along + tail)
    let halo = 0.35 / (1.0 + (across / 1.2) * (across / 1.2)) * span
    col = col + (vec3(1.0, 1.0, 1.0) - exp(-vec3(0.40, 0.34, 0.95) * halo)) * max(vec3(1.0, 1.0, 1.0) - col, vec3(0.0, 0.0, 0.0))
    let needle = Finish.cover(across - 0.55, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - tail, px)
    col = mix(col, self.color_needle.rgb, needle)
    // The pivot: a white porcelain dome over the needle's root, and its
    // shadow on the face.
    let pr = max(self.pivot_size, 1.0)
    let psh = po_dome_shadow(p, pv, pr, px) * 0.6
    col = col * (1.0 - psh)
    let dome = po_dome(p, pv, pr, px, 0.0, 0.0, 0.0, 0.0)
    col = col * (1.0 - dome.a) + dome.rgb
    return vec4(col * res.a, res.a) * self.opacity
}

// ---------------------------------------------------------------- own faces

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.BurgerButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
// The icon of a face-less icon button stands on the plate: navy.
mod.widgets.ButtonFlatterIcon.draw_icon.color = #191b38
mod.widgets.BurgerButton.draw_bg.bar_color = #272a4c
mod.widgets.BurgerButton.draw_bg.bar_color_hover = #10122b
mod.widgets.BurgerButton.draw_bg.bar_color_disabled = #9c9eb8
mod.widgets.CloseButton.draw_bg.cross_color_hover = #10122b

// ---------------------------------------------------------------- field row

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it.
// Fields and buttons share the one 26 point row.
let field_height = 26.0
let field_pad_v = 4.0
// Stock faces draw the corner doubled: 3 is a 6 point corner.
let field_radius = 3.0
// One device pixel; the faces written above draw their own edges.
let field_border = 0.34

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0

// ---------------------------------------------------------------- ground

// Plain views stop clipping so a shadow or a light can fall past their
// edge; scroll views keep clipping their content.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false
// A row that gives way as it narrows is a plain row of controls too: it
// lets the shadows of what stands in it fall past its foot.
mod.widgets.ConcedingRow.clip_x = false
mod.widgets.ConcedingRow.clip_y = false
mod.widgets.Window.pass.clear_color = #e8e8f2
// The window's own ground, the pictures' lavender-white, lit from above: a
// soft pool of light high in the middle, nearly white at its heart, the
// lavender deepening gently toward the foot and the corners (a vignette of
// a few per cent); the faint unevenness of a glaze (two slow free noises
// turned off the axes, under a percent); and a free grain under it all.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let q = (p - vec2(sz.x * 0.5, sz.y * 0.12)) / vec2(max(sz.x * 0.75, 1.0), max(sz.y * 1.05, 1.0))
    let v = smoothstep(0.0, 1.0, length(q))
    var col = mix(vec3(0.935, 0.935, 0.968), vec3(0.880, 0.880, 0.930), v)
    let pool = exp(-dot(q, q) * 9.0)
    col = mix(col, vec3(0.958, 0.958, 0.982), pool * 0.6)
    let e = abs(self.pos.x - 0.5) * 2.0
    col = col * (1.0 - 0.03 * smoothstep(0.7, 1.0, e))
    let pr = vec2(0.866 * p.x - 0.5 * p.y, 0.5 * p.x + 0.866 * p.y)
    let mott = (Finish.fbm(pr / 260.0) - 0.5) * 0.007 + (Finish.fbm(pr / 70.0 + vec2(7.3, 2.1)) - 0.5) * 0.002
    let g = Finish.grain(p / (2.0 * px), 0.011)
    return vec4(col + vec3(mott + g, mott + g, mott * 1.1 + g), 1.0)
}

// ---------------------------------------------------------------- states

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
true
