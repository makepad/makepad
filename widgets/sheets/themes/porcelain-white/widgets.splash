use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// White porcelain on a lavender-white plate, after the pictures in
// interface/white. Every face is drawn in true points (one device pixel is
// `px`); every shadow, lip and light falls OUTSIDE the layout box: the quad
// is grown in `vertex`, the templates that throw light or shadow stop
// clipping, and no padding is spent on either. Form comes from light: what
// stands is a moulded slab with a visible side under its face (a pill 1 to
// 2.5 points thick, a panel 5), a lit hairline on its upper edge, a darker
// band at its foot and a large soft lavender shadow under it; what is
// pressed in has an inner shade under its upper rim and a pale lower wall.
// Deep navy is the strong second colour: the primary button, what is chosen,
// a switch that is on, every screen. The accent is an indigo going to
// violet: a value, a mark, focus. Warm light is never paint: it leaks from
// under a slab and is added to what is there; small coloured LED slits at
// the foot of a pill throw their own light the same way.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let po_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let po_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let po_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The plate the controls stand on (#e8e8f2), for a face that fades to it.
let po_ground = fn() -> vec3 {
    return vec3(0.910, 0.910, 0.949)
}

// The lavender every shadow is cast in; laid at a coverage, never black.
let po_shade = fn() -> vec3 {
    return vec3(0.23, 0.22, 0.42)
}

// The second colour, the pictures' deep navy (#141634).
let po_navy = fn() -> vec3 {
    return vec3(0.078, 0.086, 0.204)
}

// The accent's two ends, measured on the pictures' knob arcs: an indigo
// (#4a45a8) where a value starts, a violet (#6e5cc4) at its head.
let po_indigo = fn() -> vec3 {
    return vec3(0.290, 0.271, 0.659)
}
let po_violet = fn() -> vec3 {
    return vec3(0.431, 0.361, 0.769)
}

// Which way the outline of a rounded box faces at p: the edge lines follow
// it, so a pill gets arcs where a square cap gets straight lines.
let po_normal = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// Anything drawn in a grown quad fades out over its last points, so a soft
// shadow never ends on a hard edge where the quad stops.
let po_fade = fn(pos: vec2, size: vec2, m: float) -> float {
    let q = pos * (size + vec2(2.0 * m, 2.0 * m))
    let e = min(min(q.x, q.y), min(size.x + 2.0 * m - q.x, size.y + 2.0 * m - q.y))
    return smoothstep(0.0, 4.0, e)
}

// LIGHT. What glows is light, never paint: it is added to whatever is
// drawn there, screened against it (what lies under a point is taken as
// what this face has drawn over the plate) and rolled off as 1 - e^-light,
// so it brightens and warms and never clips or darkens. On the pale plate
// it has little room; in the shadow a slab throws it has more, and that is
// where the pictures' warm glow shows. The alpha is left alone, so the
// light is added over the window too.
let po_lit = fn(res: vec4, light: vec3) -> vec4 {
    let est = res.rgb + po_ground() * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}

// The warm light that leaks from under a slab or a pill along its foot
// `by`, round `cx`: a hot spot about `hw` across where it escapes, warm
// white, and an orange bloom twice as wide spreading `hh` down over the
// plate, gone smoothly by three times `hh`. `s` its strength. Light, for
// po_lit.
let po_warm = fn(p: vec2, cx: float, by: float, hw: float, hh: float, s: float) -> vec3 {
    let dx = p.x - cx
    let dy = max(p.y - by, 0.0)
    let up = max(by - p.y, 0.0)
    let sx = max(hw, 1.0)
    let gc = exp(-(dx * dx) / (2.0 * 0.4 * sx * 0.4 * sx))
    let gx = exp(-(dx * dx) / (2.0 * sx * sx))
    let gw = exp(-(dx * dx) / (2.0 * 2.2 * sx * 2.2 * sx))
    let y1 = dy / max(0.22 * hh, 0.5)
    let y2 = dy / max(0.7 * hh, 0.5)
    let under = exp(-up / max(0.10 * hh, 0.4))
    let win = 1.0 - smoothstep(1.5 * hh, 3.0 * hh, dy)
    let core = gc / (1.0 + y1 * y1)
    let bloom = gx / (1.0 + y2 * y2)
    let wash = gw / (1.0 + y2 * y2 * 0.5)
    return (vec3(1.0, 0.74, 0.45) * 2.6 * core + vec3(1.0, 0.50, 0.18) * 1.5 * bloom + vec3(1.0, 0.58, 0.40) * 0.4 * wash) * s * under * win
}

// A small LED let into the foot of a pill or a card, the pictures' coloured
// slits: `hl` either side of `cx` at `by`. Its face is light itself, white
// hot in the middle in `ink`; what it throws is a tight halo hugging it and
// a coloured wash a few points down over the plate and a point or two up
// over the face it sits in. Light, for po_lit.
let po_slit_light = fn(p: vec2, cx: float, by: float, hl: float, ink: vec3, s: float) -> vec3 {
    let d = po_seg(p, vec2(cx - hl, by), vec2(cx + hl, by))
    let down = step(by, p.y)
    let x = d / 1.4
    let y = d / mix(2.4, 8.5, down)
    let win = 1.0 - smoothstep(2.5 * hl + 6.0, 4.0 * hl + 16.0, d)
    // The light is purer than the face looks: what is lit by it shows its
    // colour over the white it falls on.
    let lo = min(min(ink.x, ink.y), ink.z)
    let hi = max(max(ink.x, ink.y), ink.z)
    let pure = clamp((ink - vec3(lo, lo, lo) * 0.8) / max(hi, 0.01), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
    return (mix(ink, vec3(1.0, 1.0, 1.0), 0.4) * (2.6 / (1.0 + x * x)) + pure * (3.6 / (1.0 + y * y))) * s * win
}
let po_slit = fn(dst: vec4, p: vec2, cx: float, by: float, hl: float, th: float, ink: vec3, s: float, px: float) -> vec4 {
    let d = po_seg(p, vec2(cx - hl, by), vec2(cx + hl, by)) - th * 0.5
    let a = Finish.cover(d, px) * s
    let t = clamp(abs(p.x - cx) / max(hl + th * 0.5, 0.5), 0.0, 1.0)
    let col = mix(mix(vec3(1.0, 1.0, 1.0), ink, 0.18), mix(ink, vec3(1.0, 1.0, 1.0), 0.25), smoothstep(0.35, 1.0, t))
    return Finish.over(dst, vec4(col * a, a))
}
// The LEDs' colours, measured on the pictures' slits: indigo-blue for the
// primary, red for danger, green for success.
let po_led_blue = fn() -> vec3 {
    return vec3(0.24, 0.43, 0.88)
}
let po_led_red = fn() -> vec3 {
    return vec3(0.89, 0.27, 0.45)
}

// TINY LIGHTS, the pictures' indicator dots and slits, are the sheet's LED
// lamp (below) at a small size: a lens in a socket cut into whatever they
// sit in, lit or dark glass. The lights' colours: warm white (the pictures'
// lit dots), and the slits' indigo-blue, red and green.
let po_led_warm = fn() -> vec3 {
    return vec3(1.0, 0.78, 0.50)
}
let po_led_green = fn() -> vec3 {
    return vec3(0.22, 0.85, 0.62)
}

// LAMPS: an LED, as the hardware in his pictures has them. The emitter is
// the light: at full current its middle burns toward white and its rim is
// its most saturated colour; at lower current the middle is no longer
// white, the colour deeper, the glow smaller; out, it is dark tinted glass,
// its colour barely there. Round it a bezel: a raised ring lit from the
// upper left, or a socket cut into the surface, its upper wall in shadow
// and a catch light on its lower rim. Over the lens one crisp highlight of
// a dome. Its light is added, never painted: a tight hot halo and a short
// bloom in its own hue, screened over whatever is there and gone in about
// two radii; on a pale ground, where light can barely brighten, its hue is
// also laid round it as a tint that keeps the ground's luminance (the
// library's halo rule: at most 0.45 one device pixel out, halving every
// 0.4 of its reach, gone at the reach), so it never darkens or greys its
// ground. A bar is the same light drawn out into a light pipe.
let po_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let po_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let po_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = po_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c` (round when the
// two are equal), `lit` its current 0..1, `ink` its colour and `vivid` how
// far its chroma is raised, `ground` what shows through where nothing is
// drawn, `room` how far its light may reach, `bez` and `raised` its bezel
// (raised 0: a recess cut in what is under it; 1: a raised ring of `bez`;
// 2: the same ring polished metal). Premultiplied over `dst`.
let po_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, bez: vec3, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.3 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = po_lamp_full(ink)
    let hue = po_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    // The lens's own frame: `q` in lens radii from its centre line, `t` its
    // distance out, `nrm` the way its outline faces.
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the bead and its bezel throw on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.22 * rt + 0.3), 0.32 * rt + px) * mix(0.18, 0.34, min(raised, 1.0)) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(ground * 0.4 * shd, shd))
    if L > 0.001 && pale > 0.001 {
        // The tint, on a pale ground only: its hue laid over, never darker.
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The bezel: raised, a ring of `bez` rounded over, lit from the upper
    // left; or a socket cut into what is under it, its upper wall in shadow
    // and a catch light on its lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    let metal = clamp(raised - 1.0, 0.0, 1.0)
    var rc = bez * (0.94 + mix(0.12, 0.55, metal) * facing)
    rc = mix(rc, min(bez + vec3(0.30, 0.30, 0.30), white), smoothstep(mix(0.35, 0.55, metal), 0.9, facing) * mix(0.6, 0.85, metal))
    rc = mix(rc, rc * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.0, 0.8, nrm.y) * 0.8)
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = min(mix(sc, rc, min(raised, 1.0)), white)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, gone in
    // about two radii, falling on the bezel too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = po_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass. Its colour deepens toward
    // the top; light pools low inside, where it comes through the dome; lit,
    // its middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass on a dark ground, a grey bead on a pale one,
    // its colour barely there, the same dome, a catch light along its lower
    // rim.
    let offc = mix(mix(vec3(0.085, 0.09, 0.115), ground * 0.62, pale), b * 0.4, 0.12)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl * (1.0 - 0.5 * pale)
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    // One crisp highlight: a white oval across its upper third.
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    // Out, a faint seam where the dome meets its bezel; lit, none: the rim
    // is the colour.
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

let po_led = fn(dst: vec4, p: vec2, c: vec2, rd: float, lit: float, ink: vec3, px: float) -> vec4 {
    return po_lamp(dst, p, c, vec2(rd, rd), lit, ink, 0.6, px, po_ground(), 3.0 * rd + 2.5, vec3(0.0, 0.0, 0.0), 0.0)
}
// A slit, `hl` either side of `cx` at `by`, `th` thick: the same light
// drawn out along a line, a short light pipe.
let po_led_slit = fn(dst: vec4, p: vec2, cx: float, by: float, hl: float, th: float, lit: float, ink: vec3, px: float) -> vec4 {
    return po_lamp(dst, p, vec2(cx, by), vec2(hl + th * 0.5, th * 0.5), lit, ink, 0.6, px, po_ground(), 2.5 * th + 3.0, vec3(0.0, 0.0, 0.0), 0.0)
}

// What a raised slab throws on the plate (`c`, `h` the whole slab, face
// and wall): a deep soft lavender shadow falling down, half gone 5 points
// under the foot and gone by 12, drawn in 3 points from the sides; a broad
// faint one under it, gone by 16; and a close dark contact shadow right
// under the foot. Every quad that draws one holds it whole: the room under
// a 26 point pill is 24 points, its last 4 a fade (blur at most half of
// the room past its offset).
// Sized by the control's height up to a 26 point row and no further. Held,
// the slab sinks and most of it goes. Returns the coverage.
let po_shadow = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, sh_h: float, lift: float, hover: float, down: float, dis: float) -> float {
    let k = sh_h / 26.0
    let sink = 1.0 - 0.75 * down
    let hs = vec2(max(h.x - 3.0 * k, 0.5), h.y)
    let rs = min(r, min(hs.x, hs.y))
    let off = (4.6 + 0.8 * hover) * k * sink
    let sg = (2.9 + 0.3 * hover) * k + px * 0.5
    let amb = Finish.drop(p, c, hs, rs, vec2(0.0, off), sg) * (0.34 + 0.06 * hover) * lift * sink * (1.0 - 0.8 * dis)
    let hw = vec2(max(h.x - 5.0 * k, 0.5), h.y)
    let wide = Finish.drop(p, c, hw, min(r, min(hw.x, hw.y)), vec2(0.0, 6.0 * k * sink), 3.8 * k + px) * 0.15 * lift * sink * (1.0 - 0.8 * dis)
    let con = Finish.drop(p, c, h - vec2(0.6 * k, 0.0), r, vec2(0.0, 0.7 * k + px * 0.5), 0.6 * k + px * 0.5) * mix(0.24, 0.12, down) * (1.0 - 0.6 * dis) * min(lift + 0.5, 1.0)
    return 1.0 - (1.0 - amb) * (1.0 - con) * (1.0 - wide)
}

// The little violet light the focus frame spills outward: a tint one device
// pixel out, gone within 2.5 points. Premultiplied, laid under the face.
let po_leak = fn(d: float, a: float) -> vec4 {
    let s = 1.1
    let g = 0.40 * exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * s * s)) * (1.0 - a)
    return vec4(vec3(0.50, 0.44, 0.90) * g, g)
}

// The lit frame of what has focus: a violet line just inside the rim with a
// paler core, and a lavender tint bleeding inward a few points.
let po_frame = fn(face: vec3, d: float, px: float, fo: float, hh: float) -> vec3 {
    if fo < 0.001 {
        return face
    }
    let x = max(-d, 0.0)
    let k = clamp(0.1 * hh, 1.0, 2.2)
    let bleed = exp(-max(x - 1.4, 0.0) / k) * fo
    var f = mix(face, vec3(0.86, 0.84, 1.0), bleed * 0.3)
    let lw = clamp(0.06 * hh, 1.1, 1.6)
    let line = Finish.band(d, 0.0, lw, px) * fo
    f = mix(f, vec3(0.416, 0.361, 0.784), line * 0.95)
    let core = Finish.band(d, lw * 0.35, lw * 0.7, px) * fo
    return mix(f, vec3(0.64, 0.59, 0.95), core * 0.6)
}
// The same frame laid over what is already drawn (premultiplied `res`,
// coverage `a` of the shape): for a well or an outline.
let po_frame_over = fn(res: vec4, d: float, px: float, fo: float, a: float, hh: float) -> vec4 {
    if fo < 0.001 {
        return res
    }
    let x = max(-d, 0.0)
    let fb = exp(-max(x - 1.6, 0.0) / clamp(0.1 * hh, 1.0, 2.2)) * fo * a * 0.25
    var out = Finish.over(res, vec4(vec3(0.86, 0.84, 1.0) * fb, fb))
    let lw = clamp(0.06 * hh, 1.1, 1.6)
    let fl = Finish.band(d, 0.0, lw, px) * fo * 0.95
    out = Finish.over(out, vec4(vec3(0.416, 0.361, 0.784) * fl, fl))
    let fc = Finish.band(d, lw * 0.35, lw * 0.7, px) * fo * 0.6
    return Finish.over(out, vec4(vec3(0.64, 0.59, 0.95) * fc, fc))
}

// A moulded pill, the pictures' thick slab: white porcelain (`navy` 0) or
// the pictures' deep navy (`navy` 1). Its face is the layout box, so the
// words on it stay centred; its side wall hangs UNDER the box, 1.5 to 4
// points of it (3.5 on a 26 point pill), and its shadow under that. The
// face: a bright band over its upper third, the body #f1f1f8, its lower
// edge rolling away a shade before the bright rim where it turns into the
// wall. The wall: a pale lavender just under that rim going to a deeper
// lavender at the foot, closed by a darker device pixel on the plate. Round
// the face a white hairline across the top and the ground's shade down the
// sides. A navy pill is the same body in navy, its rim a lit navy line.
// Held, it sinks down its wall: the face comes down a point and a half and
// the wall that is left is a quarter of it. `lift` 1 casts the full
// shadow, 0 seats it with its contact shadow only; `tone` 1 a shade cooler
// for the small controls; `spot` the strength of the warm light from under
// it; `room` how far under the box it may reach (a pill standing in a well,
// under 3.5, keeps a short wall and stops at the well); `band` the
// strength of the bright upper band.
let po_cap_r = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, tone: float, spot: float, room: float, band: float, navy: float) -> vec4 {
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let live = 1.0 - dis
    let up = (1.0 - down) * live
    let tight = step(3.5, room) * (1.0 - step(30.0, room))
    let well = 1.0 - step(3.5, room)
    let tk0 = mix(clamp(0.135 * hh, 1.5, 4.0), min(clamp(0.135 * hh, 1.5, 4.0), max(room - 0.6, 0.8)), max(tight, well))
    let tk = tk0 * (1.0 - 0.75 * down)
    let shift = min(tk0 - tk, 1.5)
    let flo = vec2(lo.x, lo.y + shift)
    let fhi = vec2(hi.x, hi.y + shift)
    let cf = (flo + fhi) * 0.5
    let foot = fhi.y + tk
    // The slab's silhouette: the face swept down its wall.
    let cs = vec2(cf.x, (flo.y + foot) * 0.5)
    let hs = vec2(h.x, (foot - flo.y) * 0.5)
    let d = Material.sd_box(p, cs, hs, min(r, min(hs.x, hs.y)))
    let df = Material.sd_box(p, cf, h, r)
    let a = Finish.cover(d, px)
    let af = Finish.cover(df, px)
    let n = po_normal(p, cs, hs, min(r, min(hs.x, hs.y)))
    let nf = po_normal(p, cf, h, r)
    // With little room under it (a field, the combo box, the chosen list
    // row) the shadow is sized to that room and its tail is gone before
    // the room ends; a pill standing in a well stops at the well's edge.
    let fit = mix(1.0, clamp(room / 8.0, 0.4, 1.0), tight)
    let reach = 1.0 - smoothstep(mix(room - 1.5, room * 0.35, tight), room, p.y - hi.y)
    let sc = po_shadow(p, cs, hs, min(r, min(hs.x, hs.y)), px, sh_h * fit, lift * (1.0 + 0.45 * navy), hover, down, dis) * reach
    var res = vec4(po_shade() * sc, sc)
    // The warm light from under it, added into its shadow.
    let lit = spot * live
    if lit > 0.001 {
        res = po_lit(res, po_warm(p, cf.x, foot - 1.0, max(0.32 * h.x, 6.0), 0.35 * sh_h, 1.6 * lit) * reach)
    }
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, po_leak(df, af) * fo)
    }
    // The face: the bright band over its upper third, the body under it,
    // its lower edge rolling away a shade.
    let t = clamp((p.y - flo.y) / max(hh, 1.0), 0.0, 1.0)
    let upper = 1.0 - smoothstep(0.16, 0.48, t)
    let roll = (1.0 - smoothstep(0.0, clamp(0.22 * hh, 1.5, 4.0), -df)) * smoothstep(0.1, 0.9, nf.y)
    let body = mix(vec3(0.950, 0.950, 0.975), vec3(0.932, 0.932, 0.963), tone)
    var face = mix(body, vec3(0.997, 0.997, 1.0), upper * mix(0.92, 0.75, tone) * band * (1.0 - down))
    face = face - vec3(0.030, 0.030, 0.020) * roll * up
    face = face + vec3(0.022, 0.022, 0.018) * hover * up
    var nface = mix(po_navy(), vec3(0.150, 0.160, 0.320), upper * 0.55 * band * (1.0 - down))
    nface = nface - vec3(0.025, 0.025, 0.04) * roll
    nface = nface + vec3(0.035, 0.035, 0.06) * hover * up
    face = mix(face, face - vec3(0.035, 0.035, 0.028), down * live)
    nface = mix(nface, nface * 0.85, down * live)
    face = min(mix(face, nface, navy), vec3(1.0, 1.0, 1.0))
    // The wall, from the rim under the face down to the foot.
    let wk = clamp((p.y - (fhi.y - h.y)) / max(foot - (fhi.y - h.y), 0.5), 0.0, 1.0)
    var wall = mix(vec3(0.905, 0.905, 0.950), vec3(0.770, 0.770, 0.850), smoothstep(0.0, 1.0, wk))
    var nwall = mix(vec3(0.090, 0.095, 0.210), vec3(0.030, 0.032, 0.095), smoothstep(0.0, 1.0, wk))
    wall = mix(wall, nwall, navy)
    var col = mix(wall, face, af)
    // The rim: where the face turns into the wall, a bright line.
    let rim = Finish.band(df, 0.0, max(px, 0.55), px) * smoothstep(0.15, 0.8, nf.y) * (1.0 - 0.6 * down)
    col = mix(col, mix(vec3(1.0, 1.0, 1.0), vec3(0.34, 0.35, 0.56), navy), rim * mix(0.85, 0.7, navy))
    col = mix(col, mix(po_ground(), vec3(0.50, 0.51, 0.66), navy), mix(0.55, 0.6, navy) * dis)
    // The outline: white across the top, the ground's shade down the sides,
    // a darker device pixel under the foot; held, the top greys where the
    // rim of the plate stands over it.
    let ring = Finish.band(d, 0.0, px, px)
    let top = smoothstep(0.3, 0.8, -n.y)
    let low = smoothstep(0.3, 0.85, n.y)
    var edge = mix(vec3(0.820, 0.820, 0.885), mix(vec3(1.0, 1.0, 1.0), vec3(0.74, 0.74, 0.82), down), top)
    edge = mix(edge, mix(vec3(0.62, 0.62, 0.74), vec3(0.58, 0.58, 0.70), tone), low)
    var nedge = mix(vec3(0.10, 0.11, 0.24), mix(vec3(0.40, 0.41, 0.62), vec3(0.10, 0.10, 0.22), down), top)
    nedge = mix(nedge, vec3(0.02, 0.02, 0.06), low)
    edge = mix(mix(edge, nedge, navy), col, 0.7 * dis)
    col = mix(col, edge, ring)
    col = po_frame(col, df, px, fo, hh)
    return Finish.over(res, vec4(col * a, a))
}
let po_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, tone: float, spot: float) -> vec4 {
    return po_cap_r(p, lo, hi, r, px, hover, down, dis, focus, lift, tone, spot, 40.0, 1.0, 0.0)
}

// A shape pressed into the plate: its fill; the rim of the plate shading
// it from the top (and a little from the sides) over a few points; its
// lower wall, which faces the light, a paler strip inside the foot; a
// lavender device pixel on its upper edge and a white lip on the plate
// under its foot. `fill` its colour, `depth` the strength of the inner
// shade. Under the hand the floor lightens and the shade eases; held, it is
// pushed in: the floor a clear step darker and the shade half again as
// deep, which the hand on it does not take back.
let po_sunk = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, fill: vec3, hover: float, down: float, dis: float, depth: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let live = 1.0 - 0.6 * dis
    let lipa = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(0.1, 0.9, n.y) * live
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var col = fill + vec3(0.022, 0.022, 0.016) * hover * (1.0 - down) - vec3(0.056, 0.056, 0.045) * down
    let sg = clamp(0.17 * sh_h, 1.1, 3.6)
    let insh = Finish.inset(p, c, h, r, vec2(0.0, sg * 0.8), sg)
    col = mix(col, vec3(0.52, 0.52, 0.68), clamp(insh * depth * 1.2 * (1.0 - 0.3 * hover * (1.0 - down)) * (1.0 + 0.5 * down) * live, 0.0, 0.9))
    let lw = clamp(0.07 * sh_h, 0.6, 1.4)
    let low = Finish.band(d, px, px + lw, px) * smoothstep(0.35, 0.9, n.y)
    col = mix(col, vec3(0.985, 0.985, 0.996), low * 0.55 * live)
    let ring = Finish.band(d, 0.0, px, px)
    let edge = mix(vec3(0.60, 0.60, 0.72), vec3(0.86, 0.86, 0.92), smoothstep(-0.2, 0.9, n.y))
    col = mix(col, mix(edge, col, 0.5 * dis), ring)
    col = mix(col, po_ground(), 0.4 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// A navy slot pressed into the plate, for a value to run in: the
// pictures' deep navy, darkest under its upper rim where the plate shades
// it, its lower wall catching a little light, a white lip on the plate
// under its foot. Disabled, it fades toward a pale lavender.
let po_slot = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let live = 1.0 - 0.6 * dis
    let lipa = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(0.1, 0.9, n.y) * live
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var col = po_navy()
    let sg = clamp(0.3 * hh, 0.8, 3.0)
    let insh = Finish.inset(p, c, h, r, vec2(0.0, sg * 0.7), sg)
    col = mix(col, vec3(0.02, 0.022, 0.07), clamp(insh * 0.8, 0.0, 0.9))
    let low = Finish.band(d, px, px + clamp(0.18 * hh, 0.6, 1.2), px) * smoothstep(0.35, 0.9, n.y)
    col = mix(col, vec3(0.20, 0.21, 0.38), low * 0.7)
    col = mix(col, vec3(0.05, 0.05, 0.14), Finish.band(d, 0.0, px, px) * (1.0 - smoothstep(-0.9, 0.4, n.y)))
    col = mix(col, vec3(0.80, 0.80, 0.88), 0.75 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// A lit value inside a slot (`wlo`..`whi`, corner `wr`): a slim rod of the
// accent, indigo where the value starts to violet at its head, a pale
// lavender line down its middle so it reads as a lit tube, its edge a shade
// deeper. Its bloom only tints the slot's floor round it. `hot` (the hand
// on it, a drag, focus) whitens the core.
let po_fill = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, dis: float, glow: float, hot: float, wlo: vec2, whi: vec2, wr: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.01, 0.01))
    let d = Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
    let a = Finish.cover(d, px)
    let live = 1.0 - dis
    let dw = Material.sd_box(p, (wlo + whi) * 0.5, (whi - wlo) * 0.5, wr)
    let inw = Finish.cover(dw, px)
    let bl = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * 1.6 * 1.6)) * (1.0 - a) * glow * live * step(0.5, h.x) * inw
    var res = po_lit(dst, vec3(0.45, 0.38, 1.0) * bl * 0.9)
    let across_x = step(hi.y - lo.y, hi.x - lo.x)
    let along = mix(clamp((hi.y - p.y) / max(hi.y - lo.y, 0.5), 0.0, 1.0), clamp((p.x - lo.x) / max(hi.x - lo.x, 0.5), 0.0, 1.0), across_x)
    let hk = max(mix(h.x, h.y, across_x), 0.01)
    let thin = 1.0 - smoothstep(0.9, 1.6, hk)
    let ramp = smoothstep(0.0, 1.0, along)
    var col = mix(po_indigo(), po_violet() * 1.08, ramp)
    col = mix(col, vec3(0.20, 0.18, 0.48), Finish.band(d, 0.0, px, px) * (1.0 - thin) * 0.7)
    let ax = mix(abs(p.x - c.x), abs(p.y - c.y), across_x)
    let q = ax / max(0.40 * hk, px * mix(0.6, 0.85, thin))
    let line = exp(-q * q) * mix(0.35, 0.7, ramp) * (1.0 - 0.4 * thin)
    col = mix(col, mix(vec3(0.70, 0.66, 0.98), vec3(0.88, 0.86, 1.0), hot), line)
    col = mix(col, vec3(0.70, 0.70, 0.80), dis)
    return Finish.over(res, vec4(col * a, a))
}

// The three-quarter arc a waiting button turns in place of its label.
let po_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// A white dome, the pictures' round thumb: the glaze bright at its upper
// left, falling to a lavender shade at its lower right foot; a white device
// pixel on its upper left rim and a lavender one on its lower right.
// Focused, the lit frame at its rim.
let po_dome = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, dis: float, focus: float) -> vec4 {
    let q = (p - c) / max(rad, 0.5)
    let ql = length(q)
    let d = length(p - c) - rad
    let a = Finish.cover(d, px)
    let g = dot(q, vec2(0.53, 0.85))
    var col = mix(vec3(0.950, 0.950, 0.976), vec3(0.835, 0.835, 0.895), smoothstep(-0.3, 1.0, g) * smoothstep(0.0, 1.0, ql))
    col = col - vec3(0.03, 0.03, 0.022) * smoothstep(0.72, 1.0, ql) * smoothstep(-0.4, 0.3, g)
    let hq = q + vec2(0.30, 0.42)
    col = mix(col, vec3(0.997, 0.997, 1.0), exp(-dot(hq, hq) * 2.4) * 0.9 * (1.0 - 0.6 * down))
    col = col + vec3(0.03, 0.03, 0.022) * hover - vec3(0.03, 0.03, 0.024) * down
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, vec3(1.0, 1.0, 1.0), ring * (1.0 - smoothstep(-0.7, 0.0, g)) * 0.9)
    col = mix(col, vec3(0.66, 0.66, 0.77), ring * smoothstep(0.1, 0.8, g))
    col = min(col, vec3(1.0, 1.0, 1.0))
    col = mix(col, po_ground(), 0.55 * dis)
    col = po_frame(col, d, px, focus * (1.0 - dis), 2.0 * rad)
    return vec4(col * a, a)
}
// What a dome throws: down and a little to the right, as soft as it is
// small. Coverage.
let po_dome_shadow = fn(p: vec2, c: vec2, rad: float, px: float) -> float {
    return Finish.drop(p, c, vec2(rad, rad), rad, vec2(0.10 * rad, 0.22 * rad), 0.20 * rad + px)
}

// ---------------------------------------------------------------- buttons

// Every button is a slim moulded pill: 26 points on a 12 point line, 12
// points either side. Its shadow and its light fall outside the box.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
// The size rungs keep heights of their own.
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 30.0
mod.widgets.ButtonXl.min_height = 34.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(6.5)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.34)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 24.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The button and its variants share one face; `kind` picks it: 0 seated
// white pill, 1 raised white pill, 2 primary (a raised navy pill with an
// indigo-blue LED at its foot), 3 pressed-in pill, 4 seated cool pill,
// 5 danger (a raised white pill, red words, a red LED at its foot),
// 6 outline, 7 flatter. A white pill's slit in its wall shows only when it
// is lit: warm white under the hand, burning when held.
let po_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, dis: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 24.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    // Pills; an icon alone gets a square pill with a 0.26H corner.
    var r = min(h.x, h.y)
    if size.x < size.y * 1.35 {
        r = 0.26 * hh
    }
    let live = 1.0 - dis
    let spot = (0.35 * hover + 0.3 * down) * (1.0 - step(0.5, dis))
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    var ink = vec3(0.098, 0.106, 0.220)
    if kind > 5.5 {
        let d = Material.sd_box(p, c, h, r)
        let a = Finish.cover(d, px)
        let n = po_normal(p, c, h, r)
        if focus * live > 0.001 {
            res = Finish.over(res, po_leak(d, a) * focus * live)
        }
        // Under the hand a faint white wash, held a faint lavender one.
        let wash = (0.5 * hover * (1.0 - down)) * live * a
        res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * wash * 0.6, wash * 0.6))
        let press = 0.06 * down * live * a
        res = Finish.over(res, vec4(po_shade() * press, press))
        if kind < 6.5 {
            // Outline: a device pixel of lavender, white under its foot.
            var ring = Finish.band(d, 0.0, px, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let col = mix(vec3(0.58, 0.58, 0.72), vec3(0.70, 0.70, 0.80), smoothstep(-0.35, 0.35, n.y))
            let ra = ring * mix(1.0, 0.45, dis)
            res = Finish.over(res, vec4(col * ra, ra))
            let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * (1.0 - dis)
            res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * lip, lip))
        }
        res = po_frame_over(res, d, px, focus * live, a, hh)
    } else {
        if kind > 2.5 && kind < 3.5 {
            res = po_sunk(p, lo, hi, r, px, vec3(0.950, 0.950, 0.975), hover, down, dis, 0.55)
            let d = Material.sd_box(p, c, h, r)
            res = po_frame_over(res, d, px, focus * live, Finish.cover(d, px), hh)
        } else {
            var lift = 1.0
            if kind < 0.5 || (kind > 3.5 && kind < 4.5) {
                lift = 0.0
            }
            var tone = 0.0
            if kind > 3.5 && kind < 4.5 {
                tone = 1.0
            }
            var navy = 0.0
            if kind > 1.5 && kind < 2.5 {
                navy = 1.0
            }
            res = po_cap_r(p, lo, hi, r, px, hover, down, dis, focus, lift, tone, spot * (1.0 - navy), 40.0, 1.0, navy)
            // The LED slit in the wall under the face: the primary's
            // indigo-blue and danger's red burn at rest, brighter under the
            // hand, dimmer held; a white pill's is a dark bead that lights
            // warm white under the hand and when held. Out disabled.
            var lit = 0.3 * hover + 0.9 * down
            var lc = po_led_warm()
            if navy > 0.5 {
                lit = 0.85 + 0.25 * hover - 0.35 * down
                ink = vec3(1.0, 1.0, 1.0)
                lc = po_led_blue()
            }
            if kind > 4.5 && kind < 5.5 {
                lit = 0.85 + 0.25 * hover - 0.35 * down
                lc = po_led_red()
            }
            let tk0 = clamp(0.135 * hh, 1.5, 4.0)
            let tk = tk0 * (1.0 - 0.75 * down)
            let by = hi.y + min(tk0 - tk, 1.5) + tk * 0.5
            let hl = clamp(0.11 * (hi.x - lo.x), 2.5, 7.0)
            if dis < 0.5 && lit > 0.01 {
                res = po_led_slit(res, p, c.x, by, hl, min(1.4, max(tk * 0.55, 0.8)), min(lit, 1.0), lc, px)
            }
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 5.5, 2.0)
        res = po_spinner(res, p, c, rad, anim, loading, 1.5, ink)
    }
    return res * po_fade(pos, size, m)
}

