// ---------------------------------------------------------------- selection

// The small controls' quads grow by this much, for their shadow and their
// focus leak.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(14.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(2.0)
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0

// The check box: a 14 point well pressed into the plate, a 4 point corner;
// set, the well fills with the accent, violet at its top going to indigo
// at its foot, and a white check stands on it (a dash when mixed).
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(po_snap(x0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(x0 + sz, o.x, px), po_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(self.border_radius * 2.0, sz * 0.5)
    let held = max(self.down, self.pressed)
    let on = max(self.active, self.mixed)
    let live = 1.0 - self.disabled
    var res = po_sunk(p, lo, hi, r, px, vec3(0.925, 0.925, 0.957), self.hover, held, self.disabled, 1.0)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    if on > 0.001 {
        let n = po_normal(p, c, h, r)
        let t = clamp((p.y - lo.y) / max(sz, 1.0), 0.0, 1.0)
        var fc = mix(vec3(0.44, 0.38, 0.82), vec3(0.27, 0.25, 0.62), t)
        fc = fc + vec3(0.03, 0.03, 0.04) * self.hover * live - vec3(0.05, 0.05, 0.08) * held * live
        fc = mix(fc, vec3(0.66, 0.62, 0.97), Finish.band(d, px, px * 2.0, px) * smoothstep(0.2, 0.9, -n.y) * 0.55)
        fc = mix(fc, vec3(0.15, 0.14, 0.40), Finish.band(d, 0.0, px, px) * 0.8)
        fc = mix(fc, vec3(0.80, 0.80, 0.88), 0.7 * self.disabled)
        let fa = a * on
        res = Finish.over(res, vec4(fc * fa, fa))
    }
    res = po_frame_over(res, d, px, self.focus * live, a, sz)
    // The error: the edge turns red.
    res = Finish.over(res, vec4(0.78, 0.16, 0.24, 1.0) * Finish.band(d, 0.0, px, px) * self.error * live)
    // The mark: a check 7 points across in a 1.6 point stroke, or a dash,
    // white on the accent.
    let ink = mix(mix(vec3(1.0, 1.0, 1.0), vec3(1.0, 0.86, 0.88), self.error), vec3(0.96, 0.96, 0.98), self.disabled)
    let dm = min(po_seg(p, vec2(c.x - 3.2, c.y + 0.2), vec2(c.x - 1.0, c.y + 2.4)), po_seg(p, vec2(c.x - 1.0, c.y + 2.4), vec2(c.x + 3.3, c.y - 2.4)))
    let dd = po_seg(p, vec2(c.x - 3.0, c.y), vec2(c.x + 3.0, c.y))
    let dk = mix(dm - 0.8, dd - 0.8, self.mixed)
    let mk = Finish.cover(dk, px) * on
    res = Finish.over(res, vec4(ink * mk, mk))
    return res * po_fade(self.pos, self.rect_size, m)
}

// The toggle, the pictures' toggle pill: a 36 x 20 point moulded pill
// standing on the plate with a round white thumb two points in. Off, the
// pill is white, the thumb at the left and a dark bead at the right; on,
// the pill is deep navy, the thumb at the right and a warm white light lit
// where it stood.
mod.widgets.ToggleFlat.draw_bg.size = uniform(20.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(1.8)
mod.widgets.ToggleFlat.label_walk.margin.left = 36.0
let po_toggle = fn(pos: vec2, size: vec2, o: vec2, dpi: float, th0: float, aspect: float, at_end: float, hover: float, held: float, dis: float, on: float, kt: float, focus: float, error: float) -> vec4 {
    let m = 20.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = th0 * aspect
    let th = th0
    let x0 = (size.x - tw) * at_end
    let y0 = size.y * 0.5 - th * 0.5
    let lo = vec2(po_snap(x0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(x0 + tw, o.x, px), po_snap(y0 + th, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    let live = 1.0 - dis
    let tc = (lo + hi) * 0.5
    // The track is a moulded pill standing on the plate, the pictures'
    // toggle pills: white while off, deep navy while on.
    let off_track = po_cap_r(p, lo, hi, r, px, hover, held, dis, focus, 0.9, 0.0, 0.0, 40.0, 0.8, 0.0)
    let on_track = po_cap_r(p, lo, hi, r, px, hover, held, dis, focus, 0.9, 0.0, 0.0, 40.0, 0.8, 1.0)
    var res = mix(off_track, on_track, on)
    // Held, the face has come down its wall: the thumb and the light with it.
    let tk0 = clamp(0.135 * th, 1.5, 4.0)
    let sy = min(tk0 * 0.75 * held, 1.5)
    // The light in the free end: lit warm white while on, at the left where
    // the thumb stood; a dark bead at the right while off.
    let lc = vec2(mix(hi.x - r, lo.x + r, on), tc.y + sy)
    res = po_led(res, p, lc, max(0.11 * th, 1.4), on * live, po_led_warm(), px)
    // The thumb follows the value, or the pointer while it is dragged: a
    // round white dome two points in, its shadow on the track's face.
    let kr = r - 2.0
    let inset = r - kr
    let kc = vec2(lo.x + inset + kr + (hi.x - lo.x - inset * 2.0 - kr * 2.0) * kt, tc.y + sy)
    let ksh = Finish.drop(p, kc, vec2(kr, kr), kr, vec2(0.10 * kr, 0.26 * kr), 0.24 * kr + px) * mix(0.55, 0.8, on) * (1.0 - 0.8 * dis) * (1.0 - 0.6 * held)
    res = Finish.over(res, vec4(po_shade() * ksh, ksh))
    let kd = po_dome(p, kc, kr, px, hover, held, dis, 0.0)
    res = Finish.over(res, vec4(kd.rgb * (1.0 - 0.05 * held), kd.a))
    // The error: the track's edge turns red.
    let ed = Material.sd_box(p, tc + vec2(0.0, sy), (hi - lo) * 0.5, r)
    res = Finish.over(res, vec4(0.78, 0.16, 0.24, 1.0) * Finish.band(ed, 0.0, px, px) * error * live)
    return res * po_fade(pos, size, m)
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = 20.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleSlide.draw_bg.vertex = fn() {
    let m = 20.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let m = 20.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    return po_toggle(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.size, self.pill_aspect, self.mark_at_end, self.hover, max(self.pressed, self.down), self.disabled, self.active, mix(self.active, self.drag_pos, self.drag), self.focus, self.error)
}

// The slide switch is the toggle: the same thick pill track and round white
// thumb, which follows a drag.
mod.widgets.ToggleSlide.draw_bg.size = uniform(20.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(1.8)
mod.widgets.ToggleSlide.label_walk.margin.left = 36.0
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    return po_toggle(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.size, self.pill_aspect, self.mark_at_end, self.hover, max(self.pressed, self.down), self.disabled, self.active, mix(self.active, self.drag_pos, self.drag), self.focus, self.error)
}

// The rocker: a moulded white pill split at its middle, the pictures'
// two-way pill row. The half in force is pressed in and turned navy, its
// legend white: the O at the left while off, the I at the right while on;
// the raised half carries its legend in navy.
mod.widgets.ToggleRocker.draw_bg.size = uniform(20.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.3)
mod.widgets.ToggleRocker.label_walk.margin.left = 46.0
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 20.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(po_snap(x0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(x0 + tw, o.x, px), po_snap(y0 + th, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active
    let held = max(self.pressed, self.down)
    var res = po_cap_r(p, lo, hi, r, px, self.hover, 0.0, self.disabled, self.focus, 0.8, 0.0, 0.0, 40.0, 1.0, 0.0)
    // The half in force: a navy pill 2 points in, over the left or the
    // right half, pressed a little further while held.
    let hw = (hi.x - lo.x) * 0.5
    let sx = mix(lo.x, c.x, on)
    let slo = vec2(sx + mix(2.0, 0.0, on), lo.y + 2.0)
    let shi = vec2(sx + hw - mix(0.0, 2.0, on), hi.y - 2.0)
    let half = po_cap_r(p, slo, shi, (shi.y - slo.y) * 0.5, px, self.hover, 0.4 + 0.4 * held, self.disabled, 0.0, 0.0, 0.0, 0.0, 2.0, 0.6, 1.0)
    res = Finish.over(res, half)
    // The legends.
    let lc_o = vec2(lo.x + hw * 0.5 + 1.0, c.y)
    let lc_i = vec2(c.x + hw * 0.5 - 1.0, c.y)
    let s = th / 20.0
    let d_o = abs(length((p - lc_o) * vec2(1.25, 1.0)) - 3.6 * s) - 0.6 * s
    let d_i = po_seg(p, lc_i - vec2(0.0, 3.6 * s), lc_i + vec2(0.0, 3.6 * s)) - 0.6 * s
    let white = vec3(1.0, 1.0, 1.0)
    let navy = vec3(0.16, 0.17, 0.32)
    let fade = mix(1.0, 0.45, self.disabled)
    let ao = Finish.cover(d_o, px) * fade
    let ai = Finish.cover(d_i, px) * fade
    res = Finish.over(res, vec4(mix(white, navy, on) * ao, ao))
    res = Finish.over(res, vec4(mix(navy, white, on) * ai, ai))
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    res = Finish.over(res, vec4(0.78, 0.16, 0.24, 1.0) * Finish.band(d, 0.0, px, px) * self.error * live)
    return res * po_fade(self.pos, self.rect_size, m)
}

// The radio: a 14 point round well pressed into the plate; chosen, its rim
// turns to the accent and an accent dot stands in its middle.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(14.0)
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(sz, o.x, px), po_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active
    var res = po_sunk(p, lo, hi, sz * 0.5, px, vec3(0.925, 0.925, 0.957), self.hover, self.down, self.disabled, 1.0)
    let d = Finish.sd_circle(p, c, sz * 0.5)
    let acc = mix(vec3(0.36, 0.33, 0.74), vec3(0.78, 0.78, 0.86), self.disabled)
    let rim = Finish.band(d, 0.0, 1.3, px) * on
    res = Finish.over(res, vec4(acc * rim, rim))
    res = po_frame_over(res, d, px, self.focus * live, Finish.cover(d, px), sz)
    // The dot: violet at its top going to indigo, a glint at its upper left.
    let rd = 3.4
    let dq = (p - c) / rd
    var dc = mix(vec3(0.47, 0.41, 0.86), vec3(0.27, 0.25, 0.62), clamp(dq.y * 0.5 + 0.5, 0.0, 1.0))
    let gq = dq + vec2(0.35, 0.45)
    dc = mix(dc, vec3(0.78, 0.75, 1.0), exp(-dot(gq, gq) * 4.0) * 0.6)
    dc = mix(dc, vec3(0.80, 0.80, 0.88), 0.7 * self.disabled)
    let da = Finish.cover(Finish.sd_circle(p, c, rd), px) * on
    res = Finish.over(res, vec4(dc * da, da))
    return res * po_fade(self.pos, self.rect_size, m)
}

// The radio tab: a cell of a track pressed into the plate; chosen, a navy
// pill stands in it carrying white words.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    let sel = self.active
    let live = 1.0 - self.disabled
    var cell = po_sunk(p, lo, hi, r, px, vec3(0.925, 0.925, 0.957), self.hover, self.down, self.disabled, 0.8)
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, r)
    cell = po_frame_over(cell, d, px, self.focus * live * (1.0 - sel), Finish.cover(d, px), hi.y - lo.y)
    let clo = lo + vec2(2.0, 2.0)
    let chi = hi - vec2(2.0, 2.0)
    let chosen = po_cap_r(p, clo, chi, (chi.y - clo.y) * 0.5, px, self.hover, self.down, self.disabled, self.focus, 0.4, 0.0, 0.0, 2.0, 1.0, 1.0)
    return Finish.over(cell, chosen * sel) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #4a4d6e
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #10122b
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #ffffff
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #9c9eb8

// The chosen tab's white words hold under the hand and while held: the
// state ink is laid before the chosen one, not after it.
mod.widgets.RadioButtonTabFlat.draw_text.get_color = fn() {
    return self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down)
        .mix(self.color_active, self.active)
        .mix(self.color_disabled, self.disabled)
}

// ---------------------------------------------------------------- sliders

// The handle, the pictures' white pill riding a navy slot (their "Monitor
// Level" and "Control Sphere"): a small moulded white pill `hw` either
// side of `c` and `hv` above and below, with its own shadow. Under the hand
// and held, the warm light shows from under it on the navy slot.
let po_handle = fn(dst: vec4, p: vec2, c: vec2, hw: float, hv: float, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let lo = c - vec2(hw, hv)
    let hi = c + vec2(hw, hv)
    let live = 1.0 - dis
    let spot = (0.45 * hover * (1.0 - drag) + 0.8 * drag) * live
    var res = dst
    if spot > 0.001 {
        res = po_lit(res, po_warm(p, c.x, hi.y - 1.0, hw * 1.1, 2.0 * hv, 1.4 * spot))
    }
    return Finish.over(res, po_cap_r(p, lo, hi, hv, px, hover, drag * 0.5, dis, focus, 1.0, 0.0, 0.0, 40.0, 1.0, 0.0))
}

// The bar slider: a 6 point navy slot pressed in under its label row, the
// lit value in it, indigo going to violet, and an 18 x 13 point white pill
// riding it.
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 16.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 8.0
    let cy = po_snap(20.0 + (self.rect_size.y - 20.0) * 0.5, o.y, px)
    let lo = vec2(po_snap(0.0, o.x, px), cy - 3.0)
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), cy + 3.0)
    var res = po_slot(p, lo, hi, 3.0, px, self.disabled)
    let span = self.rect_size.x - rad * 2.0
    let hx = rad + self.slide_pos * span
    let ox = rad + self.origin_pos * span
    let f0 = mix(lo.x + px, min(ox, hx), self.arc_origin)
    let f1 = mix(hx, max(ox, hx), self.arc_origin)
    res = po_fill(res, p, vec2(f0, lo.y + px * 1.5), vec2(f1, hi.y - px * 1.5), 2.0, px, self.disabled, 0.6, max(max(self.hover, self.drag), self.focus), lo, hi, 3.0)
    return po_handle(res, p, vec2(hx, cy), 9.0, 6.5, px, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}

// The minimal slider: a hairline navy slot and the lit value; a slim white
// pill shows under the hand.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let cy = po_snap(self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, o.y, px)
    let lo = vec2(po_snap(0.0, o.x, px), cy - 1.5)
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), cy + 1.5)
    var res = po_slot(p, lo, hi, 1.5, px, self.disabled)
    let lo2 = min(self.origin_pos, self.slide_pos)
    let hi2 = max(self.origin_pos, self.slide_pos)
    let f0 = mix(0.0, lo2, self.arc_origin) * self.rect_size.x
    let f1 = mix(self.slide_pos, hi2, self.arc_origin) * self.rect_size.x
    res = po_fill(res, p, vec2(max(f0, lo.x), lo.y), vec2(min(f1, hi.x), hi.y), 1.5, px, self.disabled, 0.0, max(self.hover, self.drag), lo, hi, 1.5)
    let hx = self.slide_pos * self.rect_size.x
    let show = max(self.hover, self.drag)
    let cap = po_cap(p, vec2(hx - 3.0, cy - 5.0), vec2(hx + 3.0, cy + 5.0), 3.0, px, 0.0, 0.0, self.disabled, 0.0, 0.0, 0.0, 0.0)
    return Finish.over(res, cap * show)
}

// The range slider: the bar slider's navy slot under its label row, the
// value lit between the two ends, and a round white thumb at each end.
mod.widgets.RangeSliderFlat.handle_size = 13.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let m = 16.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let top = self.label_px
    let track_h = self.rect_size.y - top
    let mid = po_snap(top + track_h * 0.5, o.y, px)
    let lo = vec2(po_snap(self.inset_px * 0.5, o.x, px), mid - 3.0)
    let hi = vec2(po_snap(self.rect_size.x - self.inset_px * 0.5, o.x, px), mid + 3.0)
    var res = po_slot(p, lo, hi, 3.0, px, self.disabled)
    let span_x = self.rect_size.x - self.inset_px * 2.0 - self.handle_px
    let s0 = self.inset_px + self.handle_px * 0.5 + self.start_pos * span_x
    let s1 = self.inset_px + self.handle_px * 0.5 + self.end_pos * span_x
    let hot = max(max(self.hover, self.drag), max(self.focus, self.hot_band))
    res = po_fill(res, p, vec2(s0, lo.y + px * 1.5), vec2(s1, hi.y - px * 1.5), 2.0, px, self.disabled, 0.6, hot, lo, hi, 3.0)
    // The band's thumbs are round, white pills as tall as they are wide
    // (the slider's own thumb is a wider pill).
    let hv = clamp(track_h * 0.5 - 1.0, 4.5, 6.5)
    let hw = hv
    res = po_handle(res, p, vec2(s0, mid), hw, hv, px, self.hot_start, self.drag * self.hot_start, self.focus, self.disabled)
    return po_handle(res, p, vec2(s1, mid), hw, hv, px, self.hot_end, self.drag * self.hot_end, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}

// The round slider: a label column, then the bar slider's slot, value and
// pill; the slot ends short of the right edge for the value.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 16.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 7.0
    let cy = po_snap(self.rect_size.y * 0.5, o.y, px)
    let x0 = po_snap(self.label_size, o.x, px)
    let lo = vec2(x0, cy - 3.0)
    let hi = vec2(po_snap(self.rect_size.x - 37.0, o.x, px), cy + 3.0)
    var res = po_slot(p, lo, hi, 3.0, px, self.disabled)
    let span = hi.x - lo.x - rad * 2.0
    let hx = lo.x + rad + self.slide_pos * span
    res = po_fill(res, p, vec2(lo.x + px, lo.y + px * 1.5), vec2(hx, hi.y - px * 1.5), 2.0, px, self.disabled, 0.6, max(max(self.hover, self.drag), self.focus), lo, hi, 3.0)
    return po_handle(res, p, vec2(hx, cy), 8.0, 6.0, px, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}

// The lobe cap's solid at `w`, the slider bench's "Lobe cap, white": a pill
// whose along curve holds a crest across the middle and falls away to both
// ends, its across curve nearly level to the rim, its edge a quarter round
// over 0.8 of the smaller half size. The curves are the bench's, their
// handles resolved by it; the plan curve is level at 1, which is no cut.
// Height 0..1 in .x, the gradient per point in .yz and the footprint's
// distance in .w (the engine's field leaves .w spare), so one call carries
// what the next perspective pass and the coverage read.
let po_lobe = fn(w: vec2, hs: vec2, shape: vec4) -> vec4 {
    let fp = Cap.sd_cap(w, hs, shape.x * min(hs.x, hs.y), vec2(1.0, 0.0))
    let along = Cap.mirror(Cap.curve(abs(w.x) / hs.x, 6.0, vec2(0.0, 1.0), vec2(0.04, 0.0), vec2(0.0, 0.0), vec2(0.12, 1.0), vec2(0.0, 0.0), vec2(-0.0867, 0.1037), vec2(0.38, 0.62), vec2(0.0867, -0.1037), vec2(-0.0733, 0.0635), vec2(0.68, 0.33), vec2(0.0733, -0.0635), vec2(-0.0333, 0.0344), vec2(0.9, 0.17), vec2(0.0333, -0.0344), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0)), w.x)
    let across = Cap.curve(abs(w.y) / hs.y, 4.0, vec2(0.0, 1.0), vec2(0.1167, 0.0), vec2(-0.0733, 0.0159), vec2(0.7, 0.96), vec2(0.0733, -0.0159), vec2(-0.0267, 0.0853), vec2(0.92, 0.8), vec2(0.0267, -0.0853), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0))
    let edge = Cap.curve(Cap.edge_x(fp.x, hs, shape.y), 2.0, vec2(0.0, 0.0), vec2(0.0, 0.5523), vec2(-0.5523, 0.0), vec2(1.0, 1.0), vec2(0.5523, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0))
    // No ribs, no mark, no cut: their packed parameters are all zero, and
    // the tooth reads level.
    let off = vec4(0.0, 0.0, 0.0, 0.0)
    let f = Cap.field(w, hs, fp, along, across, edge, vec2(1.0, 0.0), shape, off, off, off, off)
    return vec4(f.x, f.y, f.z, fp.x)
}

// The fader: the slider bench's white lobe cap, drawn by the cap engine. A
// white pill 22 points long and a quarter of the control across sits on the
// floor of a channel as wide as itself, 5 points deep and pressed into the
// plate; a 4 point navy slot runs down the channel, the value is lit in it
// in the accent, and 24 ticks stand either side, every fifth long. It is laid
// out in the fader's own frame (`ab`: along the track from the value's zero,
// up the screen when it stands; across it), so SliderFaderY is the same
// drawing stood on end.
// A cap seated on a channel's floor runs the channel end to end, so the
// widget's inset is the channel's end: the cap's centre stops half a cap in
// from it and the drag divides by that same travel. The slot is held 6
// points further in, the bench's track inset of 10 against its channel's 4.
mod.widgets.SliderFader.cap_size = 22.0
mod.widgets.SliderFader.track_inset = 4.0
mod.widgets.SliderFader.draw_bg.track_size = uniform(4.0)
mod.widgets.SliderFader.draw_bg.cap_cross = uniform(0.24)
// The material, the bench's porcelain numbers, as uniforms so they tune
// live: the key light on the screen (x right, y down, z toward the eye) and
// its strength, the highlight, the glaze, the rim toward grazing, the height
// as occlusion and how far up it reaches, the plain sky's reflection and how
// close the eye sits over the cap, no metal, no spun grain, no glow, the
// exposure in stops and the highlights' roll-off, the cast and contact
// shadows, and the inner shadow of the channel and the slot.
mod.widgets.SliderFader.draw_bg.cap_light = uniform(vec3(-0.36, -0.6, 0.72))
mod.widgets.SliderFader.draw_bg.cap_light_intensity = uniform(0.95)
mod.widgets.SliderFader.draw_bg.cap_specular = uniform(0.3)
mod.widgets.SliderFader.draw_bg.cap_roughness = uniform(0.22)
mod.widgets.SliderFader.draw_bg.cap_gloss = uniform(0.36)
mod.widgets.SliderFader.draw_bg.cap_rim = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_ao = uniform(0.28)
mod.widgets.SliderFader.draw_bg.cap_ao_reach = uniform(1.2)
mod.widgets.SliderFader.draw_bg.cap_reflection = uniform(0.25)
mod.widgets.SliderFader.draw_bg.cap_reflection_perspective = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_metal = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_spun = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_glow = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_exposure = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_rolloff = uniform(0.6)
mod.widgets.SliderFader.draw_bg.cap_shadow = uniform(0.45)
mod.widgets.SliderFader.draw_bg.cap_shadow_blur = uniform(18.0)
mod.widgets.SliderFader.draw_bg.cap_contact = uniform(0.25)
mod.widgets.SliderFader.draw_bg.cap_inner = uniform(0.6)
// The inks. The glaze is this sheet's pill white, lit white and shaded in a
// cool lavender (the base theme's material shadow is near black, far too
// deep for porcelain); the plate, the channel (a white pressed into it) and
// the slot (the sheet's navy, the pictures' deep slot) are the sheet's; the
// ticks a pale lavender. The value is the widget's own value colour, this
// sheet's indigo (theme.color_val), lifted to violet under the hand and
// grey when disabled.
mod.widgets.SliderFader.draw_bg.cap_color = uniform(theme.color_handle)
mod.widgets.SliderFader.draw_bg.cap_light_color = uniform(theme.color_material_light)
mod.widgets.SliderFader.draw_bg.cap_shadow_color = uniform(#a6a6c0)
mod.widgets.SliderFader.draw_bg.ground_color = uniform(theme.color_bg_app)
mod.widgets.SliderFader.draw_bg.well_color = uniform(theme.color_inset)
mod.widgets.SliderFader.draw_bg.track_color = uniform(#141634)
mod.widgets.SliderFader.draw_bg.tick_color = uniform(#b4b4ca)
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
// The cap and its shadow stay in the channel, inside the layout box. What
// leaves it is the warm light from under a held cap, up to 13 points past a
// standing cap at its lower stop: 14 points hold it, the last 4 fading out.
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let sz = self.rect_size
    let p = self.pos * (sz + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let v = self.is_vertical
    let dis = self.disabled
    let live = 1.0 - dis
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let ab = vec2(mix(p.x, sz.y - p.y, v), mix(p.y, p.x, v))
    let mid = across * 0.5
    // The travel law is the widget's, so what is drawn is what is dragged.
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let at = foot + self.slide_pos * travel
    let cw = min(max(across * self.cap_cross, 4.0), across)
    let hs = vec2(self.cap_px * 0.5, cw * 0.5)
    // The key light on the screen, and turned into the fader's frame for
    // what is laid out in it.
    let l = normalize(self.cap_light)
    let lt = Cap.light(l, v)
    let li = self.cap_light_intensity
    let ground = self.ground_color.rgb
    let body = self.cap_color.rgb
    let lit_ink = self.cap_light_color.rgb
    let dark_ink = self.cap_shadow_color.rgb
    let track_ink = self.track_color.rgb
    let fill4 = mix(mix(self.val_color, self.val_color_hover, max(self.hover, self.drag)), self.val_color_disabled, dis)
    let fill_ink = fill4.rgb

    // The channel: as wide as the cap (the bench's fit), round ended, 5
    // points deep, from the widget's inset to the other.
    let depth = 5.0
    let wlen = max(along - self.inset_px * 2.0, 1.0)
    let wbox = vec4(self.inset_px + wlen * 0.5, mid, wlen * 0.5, cw * 0.5)
    let wr = min(wbox.z, wbox.w)
    let wm = Cap.well_mask(ab, wbox, wr, depth, px)
    var col = Cap.well(ground, ab, wbox, wr, depth, lt, px, self.well_color.rgb, lit_ink, dark_ink, self.cap_inner, self.cap_ao, self.cap_shadow_blur, self.cap_shadow)

    // The slot, round ended, and the value in it: from the stop (or the
    // default) to the cap, the slot's own end standing in for a value at
    // either stop.
    let tin = self.inset_px + 6.0
    let tw = self.track_size
    let tlen = max(along - tin * 2.0, 1.0)
    let tbox = vec4(tin + tlen * 0.5, mid, tlen * 0.5, tw * 0.5)
    let tr = tw * 0.5
    var lo = foot + self.fill_lo * travel
    var hi = foot + self.fill_hi * travel
    if self.fill_lo < 0.0005 {
        lo = tin
    }
    if self.fill_hi > 0.9995 {
        hi = along - tin
    }
    // Lit, the value is its own light: the engine's lit fill, a bright core
    // with the slot's floor glowing round it. That glow is kept to the slot.
    // Beyond it the engine adds the fill's light and holds each channel
    // under the fill's own, which on this white lets only red rise: the
    // channel's walls and the plate beside a lit value turned pink, where
    // this sheet's lamps tint the white warm. Disabled, the lamp goes out:
    // the value becomes a grey bar on the slot's floor, faded in as the
    // disabled state comes on.
    let bare = Cap.slot(col, ab, tbox, tr, 0.0, lo, hi, at, hs.x, lt, px, wm.x, wm.y, track_ink, fill_ink, lit_ink, dark_ink, self.cap_inner, self.cap_ao)
    var filled = Cap.slot(col, ab, tbox, tr, 2.0, lo, hi, at, hs.x, lt, px, wm.x, wm.y, track_ink, fill_ink, lit_ink, dark_ink, self.cap_inner, self.cap_ao)
    if dis > 0.001 {
        filled = mix(filled, Cap.slot(col, ab, tbox, tr, 1.0, lo, hi, at, hs.x, lt, px, wm.x, wm.y, track_ink, fill_ink, lit_ink, dark_ink, self.cap_inner, self.cap_ao), dis)
    }
    let slot_d = Cap.sd_cap(ab - tbox.xy, tbox.zw, tr, vec2(1.0, 0.0))
    col = mix(bare, filled, Cap.cover(slot_d.x, px))
    // Disabled, what is pressed into the plate fades toward it as every well
    // of this sheet does, and the ticks further.
    col = mix(col, ground, 0.4 * dis)
    col = Cap.ticks(col, ab, mid, foot, travel, 24.0, 3.0, 5.0, tw, cw, px, mix(self.tick_color.rgb, ground, 0.6 * dis))

    // The cap, wherever it or its shadow can reach.
    let q = ab - vec2(at, mid)
    let far = abs(q) - hs
    let height = 12.0
    // Held, the cap is pressed half a point lower: its surface stands that
    // much less over the channel's floor and its shadow is that much shorter.
    let sink = 0.5 * self.drag
    var cap = body
    var cov = 0.0
    var sh = 0.0
    var cd = 1000.0
    if max(far.x, far.y) < max(hs.x, hs.y) * (1.0 + 2.2 * self.cap_glow) + height * 1.5 + self.cap_shadow_blur * 1.5 + 6.0 {
        // A pill (corner 1), filleted over 0.8 of the smaller half size, the
        // curves met in a smooth minimum 0.02 wide, 12 points tall.
        let shape = vec4(1.0, 0.8, 0.02, height)
        // The top comes toward the eye by its height: the solid is read
        // three times, at the point the perspective moves it to.
        let persp = 0.06
        var f = po_lobe(Cap.perspective(q, 1.0, -1.0, persp), hs, shape)
        f = po_lobe(Cap.perspective(q, f.x, f.w, persp), hs, shape)
        f = po_lobe(Cap.perspective(q, f.x, f.w, persp), hs, shape)
        cd = f.w
        // The surface's height over the channel's floor, and how much of the
        // sky the channel's walls leave it.
        let z = clamp(f.x, 0.0, 1.0) * height - sink
        let open = 1.0 - clamp((depth - z) / depth, 0.0, 1.0)
        let n = Cap.normal(f.yz, height, v)
        let eye = Cap.view(q, hs, self.cap_reflection_perspective, v)
        // No mark: nothing painted or lit on it, so its ink never shows.
        cap = Cap.shade(n, l, eye, f.x, body, 0.0, 0.0, open, self.cap_specular, self.cap_roughness, self.cap_gloss, self.cap_rim, self.cap_ao, self.cap_ao_reach, self.cap_reflection, self.cap_metal, li, body, lit_ink, dark_ink, ground)
        if self.cap_spun > 0.001 {
            let grain = Cap.spun(q, hs, lt.xy) * self.cap_spun
            cap = Cap.in_shadow(Cap.in_light(cap, clamp(grain, 0.0, 1.0) * 0.55, lit_ink), clamp(-grain, 0.0, 1.0) * 0.42, dark_ink)
        }
        if self.cap_glow > 0.001 {
            cap = Cap.emit(cap, f.x, body, lit_ink, self.cap_glow)
        }
        // Below the channel's lip the cap is in the channel's shade.
        cap = Cap.in_well(cap, ab, z, wbox, wr, depth, lt, self.cap_ao, self.cap_inner, dark_ink)
        // The lit value lights the cap's end walls beside it.
        cap = cap + fill_ink * Cap.fill_light(q, hs, f.yz * height, lo, hi, at, tw) * live
        cov = Cap.cover(cd, px)
        // What it throws: the footprint raised to its top outline (the
        // bench's, for this cap) and cast by the height standing above the
        // plate, and the contact shadow hugging its foot, deeper in a well.
        let rise = height - depth - sink
        sh = Cap.shadow(q, hs, shape.x * min(hs.x, hs.y), vec3(0.302, 0.7522, 1.0), lt, rise, self.cap_shadow_blur, self.cap_shadow, px) * (1.0 - 0.8 * dis)
        sh = sh + Cap.contact(cd, max(max(rise * 0.3, 1.0), depth * 0.45), min(self.cap_contact * 1.6, 1.0)) * (1.0 - 0.6 * dis)
    }
    // A cap seated on the channel's floor keeps its shadow in the channel.
    col = mix(col, col * dark_ink, clamp(sh, 0.0, 1.0) * (1.0 - cov) * wm.x)
    if self.cap_glow > 0.001 {
        col = col + body * Cap.glow(cd, hs, self.cap_glow) * 0.9 * (1.0 - cov)
    }
    // What lies under the cap, toned as the bench tones its output. The
    // channel is painted; the plate never is, only lit and shaded relative
    // to its colour, so the fader lies on whatever ground it is put on.
    // Premultiplied, as every face of this sheet.
    let ex = pow(2.0, self.cap_exposure)
    let low = Cap.tone(col, ex, self.cap_rolloff)
    var res = mix(Cap.on_ground(low, Cap.tone(ground, ex, self.cap_rolloff)), vec4(low, 1.0), wm.x)
    // Under the hand and held, the sheet's warm light shows from under the
    // cap's lower edge on the screen, added to what is there; with focus its
    // frame spills a violet tint just outside the rim. Laid over what is
    // drawn and under the cap, as every pill of this sheet lays them.
    let cs = mix(vec2(at, mid), vec2(mid, sz.y - at), v)
    let chs = mix(hs, vec2(hs.y, hs.x), v)
    let shh = min(chs.y * 2.0, 26.0)
    res = po_lit(res, po_warm(p, cs.x, cs.y + chs.y - 1.0, max(0.4 * chs.x, 4.0), 0.4 * shh, (0.4 * self.hover + 0.9 * self.drag) * live))
    res = Finish.over(res, po_leak(cd, cov) * (self.focus * live))
    // The cap over all, on its toned face: under the hand the glaze is a
    // shade brighter, disabled it fades toward the plate, with focus it
    // carries the sheet's violet frame.
    var face = Cap.tone(cap, ex, self.cap_rolloff)
    face = min(face + vec3(0.025, 0.025, 0.02) * self.hover * live, vec3(1.0, 1.0, 1.0))
    face = mix(face, ground, 0.55 * dis)
    face = po_frame(face, cd, px, self.focus * live, chs.y * 2.0)
    res = Finish.over(res, vec4(face * cov, cov))
    return res * po_fade(self.pos, self.rect_size, m)
}

// ---------------------------------------------------------------- knobs

// A knob: the knob bench's Scalloped preset standing on the plate, and
// round it the pictures' value arc. The cap is a turned body 0.55 of its
// radius high, nearly flat on top (its full height at the middle, 0.97 of
// it at 0.84 of the radius), rolling over there into a steep side, 0.40 of
// its height at 0.92 of the radius, down to the plate at its rim. Round its
// rim eight round scallops, discs 0.17 of the radius across centred 1.04
// radii out, one on the pointer's line, are cut right through it, so the
// outline is notched as well; a scallop's wall rises one cap height in 0.03
// of the radius and every edge of the cut is filleted over 0.05 of it. The
// whole cap turns with the value. It is lit as the bench lights its solid
// in its soft white material: the normal from the height field, the light
// relative to a flat face, so the top keeps the plate's own white and the
// side turned away falls to a cool blue-grey; the revolve's shadow on its
// own side and the shadow the cap throws into its scallops. Round its foot
// the plate darkens a little, a soft wide cool shadow falls down and to the
// right, and on the side toward the light the plate is lit a touch.
// THE ARC stands 0.17 of the cap's radius clear of its rim, plate showing
// between them, and is 0.09 of it thick: over the whole sweep a quiet pale groove, and lit from the start of
// the sweep (or from the origin) to the value a thick band of the accent
// with round ends, the pictures' deep navy where it starts going through
// indigo to violet at its head, paler along its middle where it faces the
// light. The pointer is a short violet line on the cap's top. Under the
// hand the cap is a shade brighter and the arc lifts; held it lifts more;
// focus lays the sheet's lit frame along the cap's rim; disabled, the cap
// fades toward the plate and the arc goes grey. Angles run from straight
// down, clockwise, the gap at the bottom.

// The revolve's section at `rn` (radii from the middle): the bench's
// profile through its four points, its height in shares of the cap's,
// carried on down past the rim eight heights a radius.
let po_sc_rev = fn(rn: float) -> float {
    let pr = Cap.curve(rn, 4.0, vec2(0.0, 1.0), vec2(0.14, -0.005), vec2(-0.026667, 0.017391), vec2(0.84, 0.97), vec2(0.026667, -0.017391), vec2(-0.026667, 0.161667), vec2(0.92, 0.4), vec2(0.026667, -0.161667), vec2(-0.013333, 0.066667), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0))
    return pr.x - max(rn - 1.0, 0.0) * 8.0
}

// The scallops' plan at `q` (points from the centre): the distance from
// the nearest of the eight scallop discs, `spin` the pointer's angle
// clockwise from straight up.
let po_sc_cut = fn(q: vec2, rc: float, spin: float) -> float {
    let st = 0.78539816
    let a = atan2(q.x, 0.0001 - q.y) - spin
    let ai = floor(a / st + 0.5) * st + spin
    return length(q - vec2(sin(ai), -cos(ai)) * (1.04 * rc)) - 0.17 * rc
}

// The cap's outline: its disc with the scallops taken out by the bench's
// smooth subtraction, the notch reached a fillet inside the scallop.
let po_sc_d = fn(q: vec2, rc: float, spin: float, kmin: float) -> float {
    let cd = length(q) - rc
    let kc = max(0.05 * rc, kmin)
    let dc = po_sc_cut(q, rc, spin) + kc
    let hc = clamp(0.5 - 0.5 * (cd + dc) / kc, 0.0, 1.0)
    return mix(cd, -dc, hc) + kc * hc * (1.0 - hc)
}

// THE SOLID at `q`: its height in shares of the cap's. The revolve, and
// the cut's own height field -- its floor at the plate inside a scallop,
// its wall rising one cap height in 0.03 of the radius outside it, the
// wall's foot rounded over the fillet -- taken from it by the bench's
// smooth minimum, its band the fillet along the surface, so it is thin in
// height where the wall is steep. `hpt` the cap's height in points.
let po_sc_h = fn(q: vec2, rc: float, spin: float, hpt: float, kmin: float) -> float {
    let h = po_sc_rev(length(q) / rc)
    let d = po_sc_cut(q, rc, spin)
    let kf = max(0.05 * rc, kmin)
    let wall = 1.0 / max(0.03 * rc, kmin)
    var m = max(d, 0.0)
    if d < kf {
        let t = max(d + kf, 0.0)
        m = t * t / (4.0 * kf)
    }
    let hc = m * wall
    let k = kf * wall / sqrt(1.0 + wall * wall * hpt * hpt)
    let hh = clamp(0.5 - 0.5 * (hc - h) / k, 0.0, 1.0)
    return mix(h, hc, hh) - k * hh * (1.0 - hh)
}

// THE REVOLVE'S SHADOW ON ITSELF, the bench's measure (it bakes it over
// twenty-four steps; six here): how far the revolve stands over the ray
// toward the light, `x` in radii, `kz` the light's rise per radius in
// shares of the cap's height. The top cannot shade itself.
let po_sc_look = fn(x: vec2, t: float, ld: vec2, zp: float, kz: float) -> float {
    return clamp((po_sc_rev(length(x + ld * t)) - zp - t * kz) / 0.25, 0.0, 1.0)
}
let po_sc_self = fn(q: vec2, rc: float, ld: vec2, kz: float) -> float {
    let x = q / rc
    let zp = po_sc_rev(min(length(x), 1.0))
    if zp > 0.96 {
        return 0.0
    }
    let tb = min(max((1.0 - zp) / kz, 0.01), 1.2)
    var occ = po_sc_look(x, tb * 0.02406, ld, zp, kz)
    occ = occ + po_sc_look(x, tb * 0.125, ld, zp, kz)
    occ = occ + po_sc_look(x, tb * 0.26896, ld, zp, kz)
    occ = occ + po_sc_look(x, tb * 0.44553, ld, zp, kz)
    occ = occ + po_sc_look(x, tb * 0.64952, ld, zp, kz)
    occ = occ + po_sc_look(x, tb * 0.87764, ld, zp, kz)
    return clamp(occ / 6.0 / 0.375, 0.0, 1.0)
}

// THE CAP'S SHADOW IN ITS SCALLOPS, the bench's march: where the cut has
// taken the surface `h0` below the revolve, two looks toward the light,
// out to where the light would clear the revolve, find how far the solid
// stands over the ray.
let po_sc_march = fn(q: vec2, h0: float, rc: float, spin: float, hpt: float, kmin: float, ld: vec2, tanel: float) -> float {
    let hr = po_sc_rev(length(q) / rc)
    if h0 >= hr - 0.02 {
        return 0.0
    }
    let tb = (hr - h0) * hpt / tanel
    let t1 = 0.125 * tb
    let t2 = 0.649519 * tb
    let o1 = clamp(((po_sc_h(q + ld * t1, rc, spin, hpt, kmin) - h0) * hpt - t1 * tanel) / (0.25 * hpt), 0.0, 1.0)
    let o2 = clamp(((po_sc_h(q + ld * t2, rc, spin, hpt, kmin) - h0) * hpt - t2 * tanel) / (0.25 * hpt), 0.0, 1.0)
    return clamp((o1 + o2) / 0.75, 0.0, 1.0)
}

// A highlight's lobe at `nh` (the normal against the half vector) for a
// roughness `a`, 0.25 / a^2 at its peak.
let po_ggx = fn(nh: float, a: float) -> float {
    let a2 = a * a
    let dd = nh * nh * (a2 - 1.0) + 1.0
    return 0.25 * a2 / max(dd * dd, 0.000001)
}

// The bench's soft white material: its light from the upper left and its
// shade (what a face turned from the light keeps of the plate).
let po_kn_light = fn() -> vec3 {
    return normalize(vec3(-0.35, -0.55, 0.66))
}
let po_kn_shade = fn() -> vec3 {
    return vec3(0.613, 0.6375, 0.7276)
}

// The hull of two discs, centres `a` and `b`, radii `ra` and `rb`: in .x
// the signed distance from `p`, in .y where along a to b the nearest point
// lies.
let po_kn_hull = fn(p: vec2, a: vec2, b: vec2, ra: float, rb: float) -> vec2 {
    let ba = b - a
    let l = length(ba)
    let dr = ra - rb
    if l <= abs(dr) + 0.0001 {
        return vec2(length(p - a) - ra, 0.0)
    }
    let ax = ba / l
    let pa = p - a
    let y = dot(pa, ax)
    let x = abs(ax.x * pa.y - ax.y * pa.x)
    let sb = dr / l
    let cb = sqrt(1.0 - sb * sb)
    let k = cb * y - sb * x
    if k < 0.0 {
        return vec2(length(pa) - ra, 0.0)
    }
    if k > cb * l {
        return vec2(length(p - b) - rb, 1.0)
    }
    return vec2(x * cb + y * sb - ra, k / (cb * l))
}

// The scalloped cap at `c`, its radius `rc` (a whole number of device
// pixels, the centre on a pixel corner, so the rim lies on pixel edges),
// turned to the angle `ve`; `d` its outline distance. Premultiplied.
let po_scallop = fn(p: vec2, c: vec2, rc: float, px: float, ve: float, d: float, hover: float, dis: float, focus: float) -> vec4 {
    let a = Finish.cover(d, px)
    if a < 0.001 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let q = p - c
    let spin = ve + PI
    let kmin = 0.5 * px
    let hpt = 0.55 * rc
    let l = po_kn_light()
    let ld = normalize(l.xy)
    let tanel = l.z / length(l.xy)
    // THE SOLID: its height here and a device pixel either way, the normal
    // from their differences, and how far it turns across the pixel (a
    // highlight narrower than that is widened by it).
    let h0 = po_sc_h(q, rc, spin, hpt, kmin)
    let hxp = po_sc_h(q + vec2(px, 0.0), rc, spin, hpt, kmin)
    let hxm = po_sc_h(q - vec2(px, 0.0), rc, spin, hpt, kmin)
    let hyp = po_sc_h(q + vec2(0.0, px), rc, spin, hpt, kmin)
    let hym = po_sc_h(q - vec2(0.0, px), rc, spin, hpt, kmin)
    let gu = vec2(hxp - hxm, hyp - hym) / (2.0 * px)
    let n = normalize(vec3(-gu * hpt, 1.0))
    let so = hpt / px
    let turn = min(max(abs(atan2((hxp - h0) * so, 1.0) - atan2((h0 - hxm) * so, 1.0)), abs(atan2((hyp - h0) * so, 1.0) - atan2((h0 - hym) * so, 1.0))), 1.0)
    // The light that reaches it: the revolve's own shadow and the cap's in
    // its scallops.
    let selfsh = max(po_sc_self(q, rc, ld, tanel / 0.55), po_sc_march(q, h0, rc, spin, hpt, kmin, ld, tanel)) * step(d, 0.0)
    let vis = 1.0 - selfsh * 0.6
    // THE FACE LIGHT, the bench's, relative to a flat face: 1 flat, toward
    // 0 turned away, over 1 turned toward the light, eased both ways. The
    // flat face is the plate's white; what gets less of the light falls
    // toward the material's cool shade, what gets more is screened to
    // white; a faint broad highlight where the body turns to the light.
    let li = 0.7
    let ndl = dot(n, l)
    let key = (smoothstep(-0.35, 1.0, ndl) - smoothstep(-0.35, 1.0, l.z)) * li * 1.5
    let dl = 1.0 + smoothstep(0.0, 1.0, key) - smoothstep(0.0, 1.0, -key)
    let white = vec3(1.0, 1.0, 1.0)
    let base = po_ground()
    let shade = po_kn_shade()
    var col = Cap.in_light(base * (shade + (white - shade) * (clamp(dl, 0.0, 1.0) * vis)), max(dl - 1.0, 0.0) * vis, white)
    let rk = sqrt(0.7325 + 0.5 * turn * turn)
    let hv = normalize(l + vec3(0.0, 0.0, 1.0))
    let lobe = max(po_ggx(max(dot(n, hv), 0.0), rk) - po_ggx(hv.z, rk), 0.0) * 0.06 * clamp(rc / (40.0 * px), 0.15, 1.0)
    col = col + white * (lobe * li * vis * step(0.0, ndl))
    // Under the hand the cap is a shade brighter; disabled it fades
    // toward the plate; with focus it carries the sheet's lit frame along
    // its scalloped rim.
    col = min(col + vec3(0.03, 0.03, 0.026) * hover, white)
    col = mix(col, po_ground(), 0.55 * dis)
    col = po_frame(col, d, px, focus * (1.0 - dis), 2.0 * rc)
    return vec4(col * a, a)
}

// The arc's ink at `u` along its lit length (0 where the value starts, 1 at
// its head): the pictures' deep navy (#1b1e4c) going through indigo to
// violet.
let po_arc_ink = fn(u: float) -> vec3 {
    let col = mix(vec3(0.106, 0.118, 0.300), po_indigo(), smoothstep(0.0, 0.55, u))
    return mix(col, po_violet() * 1.06, smoothstep(0.45, 1.0, u))
}

// The distance from `q` (at the angle `aq`) to a band `hw` either side of
// the arc of radius `ra` from the angle `a0` to `a1`, its ends round; in .y
// how far along the arc (0..1) the nearest point lies.
let po_arc_d = fn(q: vec2, aq: float, ra: float, hw: float, a0: float, a1: float) -> vec2 {
    let r = length(q)
    if aq >= a0 && aq <= a1 {
        return vec2(abs(r - ra) - hw, (aq - a0) / max(a1 - a0, 0.0001))
    }
    let d0 = length(q - vec2(-sin(a0), cos(a0)) * ra)
    let d1 = length(q - vec2(-sin(a1), cos(a1)) * ra)
    if d0 < d1 {
        return vec2(d0 - hw, 0.0)
    }
    return vec2(d1 - hw, 1.0)
}

let po_knob = fn(p: vec2, c: vec2, rr: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, held: float, focus: float, dis: float) -> vec4 {
    // The cap is sized from its arc: the arc's outer edge at 1.26 of the
    // cap's radius, just inside the box. The radius on whole device pixels,
    // so the rim lies on them.
    let rc = max(floor((rr - 0.6) / 1.275 / px + 0.5) * px, 2.0 * px)
    let q = p - c
    let ql = length(q)
    let live = 1.0 - dis
    let one = PI / 180.0
    let sweep = 2.0 * PI - gap * one
    let start = gap * one * 0.5
    let ve = start + sweep * slide
    let oe = start + sweep * origin
    let a0 = mix(start, min(oe, ve), arc_origin)
    let a1 = mix(ve, max(oe, ve), arc_origin)
    let d = po_sc_d(q, rc, ve + PI, 0.5 * px)
    var aq = atan2(-q.x, q.y)
    if aq < 0.0 {
        aq = aq + 2.0 * PI
    }
    // THE TRACK: a quiet pale groove in the plate over the whole sweep, a
    // lavender device pixel at its rims, 0.17 of the radius of plate clear
    // of the cap's rim.
    let hw = max(0.045 * rc, 0.8)
    let ra = 1.17 * rc + hw
    let tr = po_arc_d(q, aq, ra, hw, start, start + sweep)
    let ta = Finish.cover(tr.x, px)
    var tcol = vec3(0.852, 0.852, 0.914)
    tcol = mix(tcol, vec3(0.74, 0.74, 0.84), Finish.band(tr.x, 0.0, px, px) * 0.55)
    tcol = mix(tcol, po_ground(), 0.5 * dis)
    var res = vec4(tcol * ta, ta)
    // THE ARC, from the start (or the origin) to the value.
    let ar = po_arc_d(q, aq, ra, hw, a0, a1)
    let aa = Finish.cover(ar.x, px)
    var acol = po_arc_ink(ar.y)
    let rn = clamp((ql - ra) / hw, -1.0, 1.0)
    let facing = smoothstep(-0.6, 0.8, dot(q / max(ql, 0.01), vec2(-0.53, -0.85)))
    let tube = exp(-(rn + 0.1) * (rn + 0.1) * 3.0) * (0.45 + 0.55 * facing)
    acol = mix(acol, vec3(0.80, 0.77, 1.0), tube * 0.28 * smoothstep(0.15, 1.0, ar.y))
    acol = mix(acol, acol * 0.72, Finish.band(ar.x, 0.0, px, px) * 0.6)
    acol = acol + (vec3(0.03, 0.03, 0.05) * hover + vec3(0.05, 0.04, 0.09) * held) * live
    acol = mix(acol, vec3(0.80, 0.80, 0.87), 0.8 * dis)
    res = Finish.over(res, vec4(acol * aa, aa))
    // THE GROUND round the cap, as the bench lights it: the cap's swept
    // shadow (the revolve's foot and its top, 0.55 of the radius up, moved
    // down-light, a hull of the two), its penumbra widening with height; a
    // contact shade hugging the foot; and on the side toward the light the
    // plate lit a touch. The shadow takes the plate, the track and the arc
    // toward the material's cool shade, multiplying what is there.
    let l = po_kn_light()
    let sdir = -normalize(l.xy)
    let tanel = l.z / length(l.xy)
    let outside = smoothstep(-3.0 * px, 0.0, d)
    let castl = 0.55 * rc / tanel
    let hu = po_kn_hull(q, vec2(0.0, 0.0), sdir * (1.03 * castl), rc, 0.84 * rc)
    let bl = mix(0.032, 0.107, hu.y) * rc
    let cast = exp(-max(hu.x / bl + 0.3, 0.0)) * 0.3
    let con = 0.62 * exp(-max(d, 0.0) / (0.035 * rc))
    let dark = clamp(cast + con, 0.0, 1.0) * outside * (1.0 - 0.6 * dis)
    let mul = vec3(1.0, 1.0, 1.0) - (vec3(1.0, 1.0, 1.0) - po_kn_shade()) * dark
    res = vec4(res.rgb * mul + po_ground() * po_kn_shade() * dark * (1.0 - res.a), res.a + (1.0 - res.a) * dark)
    let dlip = po_sc_d(q + sdir * (0.085 * rc), rc, ve + PI, 0.5 * px)
    let lip = (0.3 * exp(-max(dlip, 0.0) / (0.08 * rc)) + 0.25 * exp(-max(d, 0.0) / (0.03 * rc))) * smoothstep(0.0, 0.7, dot(q / max(ql, 0.01), -sdir)) * outside * live * (1.0 - ta)
    res = Finish.over(res, vec4(lip, lip, lip, lip))
    // THE CAP over its ground and the arc.
    res = Finish.over(res, po_scallop(p, c, rc, px, ve, d, hover, dis, focus))
    // THE POINTER: a short violet line on the cap's top, 0.36 to 0.70 of
    // the radius out, round ended, its rim a shade deeper.
    let dirv = vec2(-sin(ve), cos(ve))
    let pw = max(0.045 * rc, 0.7)
    let pd = po_seg(q, dirv * (0.36 * rc), dirv * (0.70 * rc)) - pw
    let pa = Finish.cover(pd, px)
    var pcol = vec3(0.47, 0.37, 0.76)
    pcol = mix(pcol, vec3(0.33, 0.25, 0.60), Finish.band(pd, 0.0, px, px) * 0.6)
    pcol = mix(pcol, vec3(0.80, 0.80, 0.87), 0.8 * dis)
    return Finish.over(res, vec4(pcol * pa, pa))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let m = 30.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 30.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    return po_knob(p, c, dia * 0.5 - 1.0, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}
