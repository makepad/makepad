mod.widgets.Select.face.padding.right = 32.0
mod.widgets.MultiSelect.face.padding.right = 32.0

// The combo box: the lacquer well one types into, and the champagne gold
// block with its chevron at the right end.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 10.0 right: 32.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    var out = md_field(p, size, o, px, self.hover, self.focus, self.disabled, 3.0)
    let held = self.down * self.hover * live
    let lo = vec2(Finish.snap(o.x + size.x - 23.0, px) - o.x, Finish.snap(o.y + 2.8, px) - o.y)
    let hi = vec2(Finish.snap(o.x + size.x - 2.8, px) - o.x, Finish.snap(o.y + size.y - 2.8, px) - o.y - px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = ad_cut(p, c, h, vec4(0.0, 1.6, 1.6, 0.0))
    var face = ad_metal(p, lo, hi, ad_champ(), 0.7, self.hover * live, held)
    face = mix(face, vec3(0.30, 0.26, 0.20), self.disabled)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    let sl = step(lo.x, p.x) * step(p.x, lo.x + max(px, 0.7)) * step(lo.y, p.y) * step(p.y, hi.y)
    out = Finish.over(out, vec4(vec3(0.10, 0.065, 0.025) * sl, sl))
    let cc = vec2(c.x + 0.5, c.y + held * px)
    let tri = Finish.cover(ad_chev(p, cc, 3.2, 3.0, 1.0) - 0.65, px)
    return Finish.over(out, vec4(vec3(0.08, 0.05, 0.02) * tri, tri))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. One black lacquer plaque across the strip in its gold
// rim; the chosen segment a champagne gold plaque pressed into it, its word
// dark.
let md_strip = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let k4 = vec4(3.0, 3.0, 3.0, 3.0)
    let d = ad_cut(p, c, h, k4)
    var out = ad_drop(p, c, h, 2.0, 0.8)
    let face = ad_lacq(p, lo, hi, ad_black(), 1.0)
    let fa = Finish.cover(d + 0.75, px)
    out = Finish.over(out, vec4(face * fa, fa))
    out = Finish.over(out, ad_pin(d, 2.9, max(px, 0.6), px, 0.6))
    return Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.5, px, 1.0))
}
// The chosen cell of a strip: a champagne plaque inside the cell, pressed
// in, in a rim of its own.
let md_cell = fn(p: vec2, lo: vec2, hi: vec2, px: float, base: vec3) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let k4 = vec4(2.0, 2.0, 2.0, 2.0)
    let d = ad_cut(p, c, h, k4)
    var face = ad_metal(p, lo, hi, base, 0.7, 0.0, 0.6)
    let sh = clamp(Finish.inset(p, c, h - vec2(1.2, 1.2), 1.0, vec2(0.0, 1.0), 0.9), 0.0, 1.0)
    face = mix(face, face * 0.45, sh * 0.6)
    let a = Finish.cover(d + 0.6, px)
    var out = vec4(face * a, a)
    return Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.2, px, 1.0))
}

mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_strip(p, self.rect_size, self.rect_pos, px)
}
// The pill is the segment's own box: its quad grows a point each way so the
// chosen plaque stands just inside the strip's rim.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(1.0, 1.0), self.rect_size + vec2(2.0, 2.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0, 2.0)) - vec2(1.0, 1.0)
    let lo = vec2(Finish.snap(o.x - 0.5, px), Finish.snap(o.y - 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x + 0.5, px), Finish.snap(o.y + size.y + 0.5, px)) - o
    return md_cell(p, lo, hi, px, ad_champ())
}
mod.widgets.SegmentedControlFlat.draw_text.color = #ede2c6
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #1c1206
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #1c1206
mod.widgets.SegmentedControlFlat.draw_text.text_style = mod.theme.font_label{font_size: 7.0}
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_label{font_size: 7.0}

// The tab strip: the same plaque; the tab in use a champagne plaque pressed
// into it, a hovered tab takes a faint gold wash, the quiet ones parted by a
// fine gold line with a small gold lozenge at its middle.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.tab_min_width = 46.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_strip(p, self.rect_size, self.rect_pos, px)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = self.rect_size * 0.5 - vec2(2.5, 3.0)
    let d = md_rbox(p, self.rect_size * 0.5, h, 1.5)
    let a = Finish.cover(d, px) * 0.14
    return vec4(ad_gold_lt() * a, a)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + 1.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 1.0, px), Finish.snap(o.y + size.y - 1.5, px)) - o
    return md_cell(self.pos * size, lo, hi, px, ad_champ())
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = self.rect_size.x * 0.5
    let y = self.rect_size.y * 0.5
    let ln = step(abs(p.x - x), max(px, 0.6) * 0.5) * step(abs(p.y - y), self.rect_size.y * 0.30) * 0.75
    let lq = abs(p - vec2(x, y))
    let lz = Finish.cover(lq.x + lq.y * 0.6 - 1.6, px)
    let a = max(ln, lz)
    return vec4(mix(ad_line_c(), ad_gold_lt(), lz * 0.5) * a, a)
}
mod.widgets.Tabs.draw_mark.color = #ede2c6
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // the add mark a plus in the middle of its room; the close mark a small
    // cross tucked into the top right of its room, clear of the word
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(2.0, 3.6, self.plus)
    let cm = mix(vec2(self.rect_size.x - 3.0, 4.5), c, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(0.0 - sin(a), cos(a)) * r
    let dd = min(md_seg(p, cm - u, cm + u), md_seg(p, cm - v, cm + v)) - mix(0.5, 0.6, self.plus)
    let k = Finish.cover(dd, px) * self.color.a
    return vec4(self.color.rgb * k, k)
}
mod.widgets.Tabs.draw_text.color = #ede2c6
mod.widgets.Tabs.draw_text_active.color = #1c1206
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_regular{font_size: 9.0 top_drop: 0.22}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_regular{font_size: 9.0 top_drop: 0.22}

// ---------------------------------------------------------------------------
// PROGRESS. A gold tube with a black slot; the value a string of small LED
// beads down the slot, each burning warm white with a tight glow, a faint
// gold light under the lit run; the beads past the value are dark glass.
// The unknown value is a still scatter of lit beads along the whole slot: a
// face may not run a clock.
mod.widgets.ProgressBarFlat.height = 11.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = uniform(11.0)
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let top = Finish.snap(o.y + (size.y - th) * 0.5, px) - o.y
    let bot = Finish.snap(o.y + (size.y + th) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + size.x * self.end, px) - o.x
    let h = vec2((x1 - x0) * 0.5, (bot - top) * 0.5)
    let c = vec2(x0, top) + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let dis = step(4.5, self.intent)
    var out = ad_well_r(p, c, h, r, px, vec3(0.012, 0.011, 0.010), 0.5, 1.4, dis)
    var v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
    var unknown = 0.0
    if self.value < 0.0 {
        v1 = x1
        unknown = 1.0
    }
    var hue = vec3(1.0, 0.94, 0.80)
    if self.intent > 0.5 {
        hue = mix(self.fill_color().rgb, vec3(1.0, 1.0, 1.0), 0.35)
    }
    hue = mix(hue, vec3(0.40, 0.36, 0.30), dis)
    let inner = Finish.cover(d + 1.6, px)
    let pitch = 4.0
    let bx0 = x0 + r
    let k = floor((p.x - bx0) / pitch + 0.5)
    let bc = vec2(bx0 + k * pitch, c.y)
    let inb = step(bx0 - 0.5, bc.x) * step(bc.x, x1 - r + 0.5)
    var lit = step(bc.x, v1 - 1.0)
    if unknown > 0.5 {
        lit = step(0.62, Finish.hash(vec2(k * 1.37, 4.1)))
    }
    lit = lit * inb * (1.0 - dis * 0.6)
    let bd = length(p - bc) - 1.05
    // the faint gold light under the lit run
    let under = step(x0 + 1.0, p.x) * step(p.x, v1) * inner * 0.10 * (1.0 - unknown)
    out = Finish.over(out, vec4(vec3(1.0, 0.70, 0.30) * under, under))
    let glow = exp(0.0 - max(bd, 0.0) / 0.9) * lit * inner * 0.55
    out = Finish.over(out, vec4(mix(hue, vec3(1.0, 0.75, 0.40), 0.4) * glow, glow))
    let core = Finish.cover(bd, px) * inb * inner
    let bcol = mix(vec3(0.10, 0.085, 0.07), hue, lit)
    out = Finish.over(out, vec4(bcol * core, core))
    return out * self.track * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A black well of cells four points long with a point
// between: unlit cells dark glass, lit ones warm gold, amber from 70 % and
// a red ember from 90 %; the hold a cream line; the over lamp a small LED.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let q = vec2(a, b)
    let th = min(7.0, across)
    let lamp_room = self.lamp * (th + 4.0)
    let bar = max(4.0, along - lamp_room)
    let h = vec2(bar * 0.5, th * 0.5)
    let c = vec2(h.x, across * 0.5)
    let r = 1.0
    let d = md_rbox(q, c, h, r)
    let pad = 1.5
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((a - pad) / span, 0.0, 1.0)
    let pitch = 5.0
    let cell = fract((a - pad) / pitch)
    let in_cell = step(cell, 4.0 / pitch)
    let lit = step(a, pad + span * self.level) * step(pad, a) * in_cell
    let ramp = mix(mix(mix(vec3(0.93, 0.76, 0.38), vec3(1.0, 0.80, 0.42), smoothstep(0.0, 0.7, share)), vec3(1.0, 0.58, 0.20), step(0.7, share)), vec3(0.95, 0.27, 0.15), step(0.9, share))
    let well = vec3(0.012, 0.011, 0.010)
    var fill = mix(well, ramp, lit)
    let cell_row = in_cell * step(pad, a) * step(a, pad + span)
    fill = mix(fill, vec3(0.075, 0.060, 0.045), (1.0 - lit) * cell_row * step(1.2, abs(b - c.y) + 1.2))
    let bt = b - (c.y - h.y)
    fill = mix(fill, vec3(1.0, 0.97, 0.88), lit * step(1.0, bt) * step(bt, 1.0 + px) * 0.35)
    if self.hold > 0.002 {
        let at = pad + span * self.hold
        let hm = step(abs(a - at), px) * step(abs(b - c.y), h.y)
        fill = mix(fill, ad_cream(), hm)
    }
    let ca = Finish.cover(d, px)
    var out = vec4(fill * ca, ca)
    let e = Finish.band(d, 0.0, max(px, 0.7), px)
    out = Finish.over(out, vec4(ad_gold_md() * e, e))
    if self.lamp > 0.5 {
        let la = bar + 2.0 + th * 0.5 + 1.0
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, md_led(p, lc, 2.6, px, vec3(1.0, 0.32, 0.18), step(0.5, self.over), 0.35))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A gold hairline down the length of the view and a slim
// capsule of polished gold riding on it.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let mid = across * 0.5
    let rail = (1.0 - smoothstep(0.35, 0.35 + px, abs(b - mid))) * 0.55
    var out = vec4(ad_line_c() * rail, rail)
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let th = vec2(max(tl * 0.5 - 1.0, 4.0), 3.0)
    let tc = vec2(t0 + tl * 0.5, mid)
    let td = md_rbox(q, tc, th, th.y)
    let tn = ad_nrm(q, tc, th, th.y)
    let tn2 = mix(tn, vec2(tn.y, tn.x), vert)
    let t = clamp((b - (mid - th.y)) / (2.0 * th.y), 0.0, 1.0)
    var col = ad_gold_shape(td, tn2, 1.6, t, 0.12 * self.hover, 0.0)
    col = mix(col, col * 0.85, self.drag)
    col = mix(col, ad_gold_dk() * 0.5, Finish.band(td, 0.0, max(px, 0.45), px) * 0.6)
    let ta = Finish.cover(td, px)
    out = Finish.over(out, vec4(col * ta, ta))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised panel is black lacquer stepped at its corners,
// in a polished gold rim with a pinstripe inside it, a small sunburst fan in
// its top right and bottom right corners and gold studs in the other two;
// the sunken one a deeper black well inside a double gold frame, a stepped
// wedge of mother-of-pearl set into the frame at the middle of its top and
// of its foot. The words on both keep the cream ink.
let ad_wedge = fn(dst: vec4, p: vec2, cx: float, y0: float, dir: float, px: float) -> vec4 {
    // a stepped wedge on the edge at `y0`, growing into the surface (`dir`
    // 1 down, -1 up): a broad low step and a narrow tall one, pearl inside
    // a gold line
    let yy = (p.y - y0) * dir
    let qa = vec2(abs(p.x - cx), yy)
    let s1 = md_rbox(qa, vec2(0.0, 2.2), vec2(13.0, 2.2), 0.0)
    let s2 = md_rbox(qa, vec2(0.0, 3.6), vec2(7.0, 3.6), 0.0)
    let d = min(s1, s2)
    let a = Finish.cover(d, px)
    var out = Finish.over(dst, vec4(ad_pearl(p * 1.3) * a, a))
    let e = Finish.band(d, 0.0, max(px, 0.7), px)
    return Finish.over(out, vec4(ad_gold_md() * e, e))
}
let md_plate = fn(p: vec2, size: vec2, o: vec2, px: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let s = 4.0
    let d = ad_step(p, c, h, s)
    let n = ad_step_n(p, c, h, s)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let k = clamp(30.0 / max(size.y, 1.0), 0.15, 1.0)
    if sunken > 0.5 {
        var face = ad_lacq(p, lo, hi, vec3(0.016, 0.014, 0.013), k * 0.5)
        let sh = clamp(Finish.inset(p, c, h - vec2(1.6, 1.6), 2.0, vec2(0.0, 2.2), 2.4), 0.0, 1.0)
        face = mix(face, vec3(0.0, 0.0, 0.0), sh * 0.6)
        let a = Finish.cover(d, px)
        out = Finish.over(out, vec4(face * a, a))
        out = Finish.over(out, ad_pin(d, 2.7, max(px, 0.6), px, 0.75))
        out = Finish.over(out, ad_rim(d + 4.0, n, 1.2, px, 0.8))
        out = Finish.over(out, ad_rim(d, n, 1.6, px, 1.0))
        out = ad_wedge(out, p, c.x, lo.y + 0.5, 1.0, px)
        out = ad_wedge(out, p, c.x, hi.y - 0.5, -1.0, px)
        return out
    }
    out = ad_drop(p, c, h, 2.0, 1.0)
    var face = ad_lacq(p, lo, hi, ad_black(), k)
    face = face + g3(Finish.grain(p / px, 0.004))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    let fs = clamp(min(size.x, size.y) * 0.32, 14.0, 26.0)
    out = ad_corner_fan(out, p, lo, hi, 1.0, 5.0, fs, px, 1.0)
    out = ad_corner_fan(out, p, lo, hi, 2.0, 5.0, fs, px, 1.0)
    out = ad_dome(out, p, lo + vec2(8.0, 8.0), 2.1, px, ad_gold_base())
    out = ad_dome(out, p, vec2(lo.x + 8.0, hi.y - 8.0), 2.1, px, ad_gold_base())
    out = Finish.over(out, ad_pin(d, 3.4, max(px, 0.6), px, 0.75))
    return Finish.over(out, ad_rim(d, n, 1.6, px, 1.0))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_plate(p, self.rect_size, self.rect_pos, px, self.sunken)
}

// The card is a leaf of macassar ebony laid crosswise, warmer than the
// ground, in a gold rim and pinstripe, a polished stud in each of its four
// corners. It lifts a little under the pointer.
mod.widgets.Card.radius = 2.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(4.0, 4.0, 4.0, 4.0)
    let d = ad_cut(p, c, h, k4)
    var out = ad_drop(p, c, h, 2.0, 1.0 + 0.4 * self.hover)
    var face = ad_ebony(vec2(p.y * 1.0 + 300.0, p.x * 0.6 + 40.0), px)
    face = mix(face, ad_ebony_c(), 0.35) * vec3(1.25, 1.08, 0.95) + vec3(0.018, 0.010, 0.004)
    face = Finish.lift(face, 0.03 * self.hover)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = ad_dome(out, p, lo + vec2(7.0, 7.0), 2.0, px, ad_gold_base())
    out = ad_dome(out, p, vec2(hi.x - 7.0, lo.y + 7.0), 2.0, px, ad_gold_base())
    out = ad_dome(out, p, hi - vec2(7.0, 7.0), 2.0, px, ad_gold_base())
    out = ad_dome(out, p, vec2(lo.x + 7.0, hi.y - 7.0), 2.0, px, ad_gold_base())
    out = Finish.over(out, ad_pin(d, 3.2, max(px, 0.6), px, 0.75))
    return Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.6, px, 1.0))
}

// The plain rounded view keeps the colours its caller gives it; the edge is
// a snapped hairline at the true radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, max(self.border_radius * 2.0, 1.0))
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points on the ebony, parted by a faint gold hairline; a
// hovered row takes a breath of gold; the chosen row is a plaque of dark old
// gold in a polished rim (dark enough that the cream ink keeps its 5:1),
// ending short of the scroll bar.
let ad_row_plate = fn(p: vec2, c: vec2, h: vec2, px: float) -> vec4 {
    let k4 = vec4(2.5, 2.5, 2.5, 2.5)
    let d = ad_cut(p, c, h, k4)
    let t = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = ad_bronze() * (1.25 - 0.45 * t)
    face = face + vec3(0.10, 0.07, 0.03) * exp(0.0 - (t - 0.18) * (t - 0.18) / 0.012) * 0.6
    let br = Finish.brushed(p, vec2(1.0, 0.0), 0.4) - 0.5
    face = face * (1.0 + br * 0.08)
    let a = Finish.cover(d, px)
    var out = vec4(face * a, a)
    return Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.2, px, 1.0))
}
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 12.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let lay = (self.hover * 0.12 + self.down * 0.08) * live * (1.0 - self.selected)
    let hd = md_rbox(p, (lo + hi) * 0.5 - vec2(3.0, 0.0), (hi - lo) * 0.5 - vec2(5.0, 1.5), 1.5)
    let la = Finish.cover(hd, px) * lay
    var out = vec4(ad_gold_md() * la, la)
    if self.selected > 0.5 {
        let h = vec2((hi.x - lo.x) * 0.5 - 6.0, (hi.y - lo.y) * 0.5 - 1.0)
        let c = vec2(lo.x + h.x + 2.0, (lo.y + hi.y) * 0.5)
        out = Finish.over(out, ad_row_plate(p, c, h, px))
    }
    let yb = hi.y
    let dk = step(yb - max(px, 0.6), p.y) * step(p.y, yb) * step(lo.x + 4.0, p.x) * step(p.x, hi.x - 8.0) * 0.25 * (1.0 - self.selected)
    out = Finish.over(out, vec4(ad_line_c() * dk, dk))
    return out
}
mod.widgets.ListItem.draw_text.color = #ede2c6

// The open list of a drop-down: a black lacquer leaf stepped at its corners
// in a gold rim and pinstripe, with a soft shadow; the row under the
// pointer a gold wash, the chosen row a gold check.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 10.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 10.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let s = 3.0
    let d = ad_step(p, c, h, s)
    let sh = Finish.drop(p, c, h, 2.0, vec2(0.5, 2.5), 2.2) * 0.55
    var out = vec4(0.0, 0.0, 0.0, sh)
    let face = ad_lacq(p, lo, hi, ad_black(), clamp(30.0 / max(size.y, 1.0), 0.2, 1.0))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, ad_pin(d, 3.0, max(px, 0.6), px, 0.7))
    return Finish.over(out, ad_rim(d, ad_step_n(p, c, h, s), 1.5, px, 1.0))
}
mod.widgets.PopupMenuItem.padding.left = 18.0
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let h = c - vec2(3.0, 0.5)
    let d = md_rbox(p, c, h, 1.5)
    let live = 1.0 - self.disabled
    let wa = Finish.cover(d, px) * self.hover * live * 0.22
    var out = vec4(ad_gold_md() * wa, wa)
    let m0 = vec2(5.0, c.y + 0.2)
    let m1 = vec2(7.2, c.y + 2.4)
    let m2 = vec2(10.6, c.y - 2.6)
    let mk = Finish.cover(min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.75, px) * self.active
    return Finish.over(out, vec4(ad_gold_lt() * mk, mk))
}

// The dock's tabs: the bar is the ground with a gold line at its foot; the
// tab in use a black lacquer leaf rounded at its top corners in its rim, open at
// the foot where it joins the panel below; the others lift under the
// pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 8.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(3.0, 3.0, 0.0, 0.0)
    let d = ad_cut(p, c, h, k4)
    let face = ad_lacq(p, lo, hi, ad_black(), 1.0)
    let a = Finish.cover(d, px) * self.active
    var out = vec4(face * a, a)
    out = Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.3, px, 1.0) * self.active)
    let lift = Finish.cover(d, px) * 0.12 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(ad_gold_md() * lift, lift), out)
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = step(yb - 1.3, p.y) * step(p.y, yb) * 0.9
    return vec4(ad_gold_md() * dk, dk)
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small lacquer plaque in its rim (the
// outline when it asks for a border); a badge a small lacquer plaque in a
// gold rim with gold figures.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let ch = min(22.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    let has_fill = step(0.05, self.color.a) * step(0.6, Finish.lum(self.ink.rgb))
    let kind = mix(5.0, 8.0, step(0.5, has_fill + 1.0 - step(0.01, self.border_size)))
    let lift = mix(0.0, 0.6, has_fill)
    return ad_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, max(self.hover, lift), self.down, self.keyed, 0.0, 0.0, 0.0, vec4(2.5, 2.5, 2.5, 2.5), kind, m)
}
mod.widgets.ChipFlat.draw_text.text_style = mod.theme.font_label{font_size: 6.5}
mod.widgets.BadgePalette.neutral = #1a1510
mod.widgets.BadgePalette.on_neutral = #e8d4a2
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_label{font_size: 6.5}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_label{font_size: 6.5}
mod.widgets.BadgeFlat.clip_x = false
mod.widgets.BadgeFlat.clip_y = false
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(18.0, self.rect_size.y - 2.0)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x + 1.0, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.0, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(2.0, 2.0, 2.0, 2.0)
    let d = ad_cut(p, c, h, k4)
    let face = ad_lacq(p, lo, hi, self.color.rgb, 1.0)
    let a = Finish.cover(d, px)
    var out = vec4(face * a, a)
    out = Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.2, px, 1.0))
    return out * self.color.a
}

// Bold in running text is the reading serif's own bold: the wide legend
// face is for captions and plaques, and set inside a sentence it would
// shout.
mod.widgets.Markdown.text_style_bold = mod.theme.font_regular{font_size: 9.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/PlayfairDisplay-Variable.ttf") weight: 700.0 asc: 0.0 desc: 0.0}}}
mod.widgets.Html.text_style_bold = mod.theme.font_regular{font_size: 9.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/PlayfairDisplay-Variable.ttf") weight: 700.0 asc: 0.0 desc: 0.0}}}
mod.widgets.TextFlow.text_style_bold = mod.theme.font_regular{font_size: 9.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/PlayfairDisplay-Variable.ttf") weight: 700.0 asc: 0.0 desc: 0.0}}}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in gold on a faint track.
mod.widgets.SpinnerFlat.draw_bg.color = #cdb07a
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 2.5
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.25

// Rules between groups: a gold hairline with a small stepped lozenge at its
// middle.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let ln = (1.0 - smoothstep(0.35, 0.35 + px, abs(p.y - y))) * 0.8
    let lq = abs(p - vec2(self.rect_size.x * 0.5, y))
    let lz = Finish.cover(lq.x * 0.5 + lq.y - 2.0, px)
    let a = max(ln, lz)
    return vec4(ad_line_c() * a, a)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let a = (1.0 - smoothstep(0.35, 0.35 + px, abs(p.x - x))) * 0.8
    return vec4(ad_line_c() * a, a)
}

// ---------------------------------------------------------------------------
// THE TREE. Its rows stand on the ebony, clear; the open row is the dark old
// gold plaque of the list's chosen row.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = vec2(2.0, 1.0)
    let hi = self.rect_size - vec2(4.0, 1.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    return ad_row_plate(p, c, h, px) * self.active
}

