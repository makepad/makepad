// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point well of black lacquer, its corners rounded, in
// its gold rim; set, a plaque of polished gold fills it with a black check;
// mixed, the gold with a black dash.
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(14.0)
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let live = 1.0 - self.disabled
    let x0 = mix(1.0, size.x - sz - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - sz) * 0.5, px)) - o
    let h = vec2(sz * 0.5, sz * 0.5)
    let c = lo + h
    let k = mix(2.5, h.y, step(20.0, self.border_radius))
    let k4 = vec4(k, k, k, k)
    let d = ad_cut(p, c, h, k4)
    let n = ad_cut_n(p, c, h, k4)
    let on = max(self.active, self.mixed)
    let press = self.down * live
    var fill = mix(vec3(0.016, 0.014, 0.013), vec3(0.045, 0.038, 0.030), self.hover * live)
    fill = mix(fill, vec3(0.06, 0.05, 0.04), self.disabled)
    var out = ad_well(p, c, h, k, d, n, px, fill, 0.6, 1.2, self.disabled)
    out = Finish.over(out, ad_pin(d, 1.8, max(px, 0.6), px, 0.55 * self.hover * live * (1.0 - on)))
    // the gold when set
    let hf = h - vec2(1.2, 1.2)
    var gcol = ad_metal(p, c - hf, c + hf, ad_gold_base(), 1.0, self.hover * live, press)
    gcol = mix(gcol, vec3(0.30, 0.26, 0.20), self.disabled)
    let ga = Finish.cover(ad_cut(p, c, hf, k4 - vec4(0.5, 0.5, 0.5, 0.5)), px) * on
    out = Finish.over(out, vec4(gcol * ga, ga))
    let kk = sz / 14.0
    let m0 = lo + vec2(3.6, 7.3) * kk
    let m1 = lo + vec2(6.0, 9.8) * kk
    let m2 = lo + vec2(10.6, 4.3) * kk
    let ck = min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.9 * kk
    let d0 = lo + vec2(4.0, 7.0) * kk
    let d1 = lo + vec2(10.0, 7.0) * kk
    let dash = md_seg(p, d0, d1) - 0.9 * kk
    let show_ck = self.active * (1.0 - self.mixed)
    let mk = mix(Finish.cover(ck, px) * show_ck, Finish.cover(dash, px), self.mixed)
    let ink = mix(vec3(0.07, 0.045, 0.02), vec3(0.15, 0.13, 0.10), self.disabled)
    out = Finish.over(out, vec4(ink * mk, mk))
    let err = Finish.band(d, 0.0, 2.0 * px, px) * self.error
    out = Finish.over(out, vec4(vec3(0.75, 0.20, 0.15) * err, err))
    return Finish.over(out, ad_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 38 by 16 point pill of black lacquer sunk in its gold rim, a
// 12 point ball of polished gold riding in it with its own small shadow;
// while on, the check at its left end burns warm white; while off, a small
// ring is engraved at its right end. The slide switch (below) fills its
// track with gold while on and rides an ivory dome.
let ad_toggle = fn(pos: vec2, size: vec2, o: vec2, px: float, active: float, drag_pos: float, drag: float, hover: float, down: float, focus: float, dis: float, err: float, at_end: float, slide: float) -> vec4 {
    let m = 4.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let tw = 38.0
    let th = 16.0
    let x0 = mix(1.0, size.x - tw - 1.0, at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - th) * 0.5, px)) - o
    let c = lo + vec2(tw * 0.5, th * 0.5)
    let h = vec2(tw * 0.5, th * 0.5)
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let on = active
    var fill = mix(vec3(0.016, 0.014, 0.013), vec3(0.040, 0.034, 0.028), hover * live)
    fill = mix(fill, vec3(0.06, 0.05, 0.04), dis)
    var out = ad_well_r(p, c, h, r, px, fill, 0.6, 1.3, dis)
    out = Finish.over(out, ad_pin(d, 1.9, max(px, 0.6), px, 0.55 * hover * live * (1.0 - on)))
    let inner = Finish.cover(d + 1.3, px)
    let cq = p - (lo + vec2(8.0, 8.0))
    let ck = min(md_seg(cq, vec2(-3.0, 0.2), vec2(-1.0, 2.4)), md_seg(cq, vec2(-1.0, 2.4), vec2(3.2, -2.4))) - 0.75
    if slide > 0.5 {
        // the slide switch: the gold of the lit track, a check cut in it
        let hf = h - vec2(1.3, 1.3)
        var gcol = ad_metal(p, c - hf, c + hf, ad_gold_base(), 1.0, hover * live, 0.0)
        gcol = mix(gcol, vec3(0.30, 0.26, 0.20), dis)
        let ga = Finish.cover(md_rbox(p, c, hf, hf.y), px) * on
        out = Finish.over(out, vec4(gcol * ga, ga))
        let cka = Finish.cover(ck, px) * on * 0.85
        out = Finish.over(out, vec4(vec3(0.10, 0.065, 0.025) * cka, cka))
    } else {
        // the toggle: the track stays black; while on, the check at its
        // left end burns warm white in a short amber glow; while off, a
        // small ring is engraved at its right end
        let lit = on * live
        let cg = exp(0.0 - max(ck, 0.0) / 1.2) * lit * 0.6 * inner
        out = Finish.over(out, vec4(vec3(1.0, 0.68, 0.30) * cg, cg))
        let cka = Finish.cover(ck, px) * on
        let ckc = mix(vec3(0.40, 0.36, 0.30), vec3(1.0, 0.94, 0.78), live)
        out = Finish.over(out, vec4(ckc * cka, cka))
        let rq = p - (lo + vec2(tw - 8.0, 8.0))
        let ring = abs(length(rq) - 2.2) - 0.45
        let ra = Finish.cover(ring, px) * (1.0 - on) * mix(0.75, 0.4, dis)
        out = Finish.over(out, vec4(ad_gold_md() * ra, ra))
    }
    let ea = Finish.band(d, 0.0, 2.0 * px, px) * err
    out = Finish.over(out, vec4(vec3(0.75, 0.20, 0.15) * ea, ea))
    // the ball: polished gold on the toggle, an ivory dome on the slide
    let kt = clamp(mix(on, drag_pos, drag), 0.0, 1.0)
    let kr = 6.0
    let kx = Finish.snap(o.x + lo.x + 2.0 + kr + kt * (tw - 4.0 - 2.0 * kr), px) - o.x
    let kc = vec2(kx, c.y)
    let press = down * live
    out = Finish.over(out, ad_drop(p, kc, vec2(kr, kr), kr, (0.9 - 0.5 * press) * mix(1.0, 0.5, dis)))
    let q = p - kc
    let kd = length(q) - kr
    let kn = q / max(length(q), 0.001)
    let lit2 = clamp(0.5 - 0.55 * dot(q / kr, vec2(0.45, 0.85)), 0.0, 1.0)
    let iv = mix(ad_ivory_dk(), ad_ivory(), 0.3 + 0.7 * lit2)
    let gd = mix(ad_gold_dk(), ad_gold_base(), 0.3 + 0.7 * lit2)
    var face = mix(gd, iv, slide)
    face = mix(face, vec3(1.0, 0.99, 0.95), exp(0.0 - dot(q / kr - vec2(-0.35, -0.42), q / kr - vec2(-0.35, -0.42)) / 0.05) * 0.65)
    face = Finish.lift(face, 0.12 * hover * live * (1.0 - press))
    face = mix(face, face * 0.88, press)
    face = mix(face, mix(face, g3(Finish.lum(face)), 0.7) * 0.5, dis)
    let ka = Finish.cover(kd, px)
    out = Finish.over(out, vec4(face * ka, ka))
    out = Finish.over(out, ad_rim(kd, kn, 1.1, px, live) * mix(1.0, 0.5, dis))
    return Finish.over(out, ad_focus(d, px, focus * live))
}
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 14.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleFlat.draw_bg.knob_inset = 7.0
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return ad_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 0.0)
}

// ---------------------------------------------------------------------------
// RADIOS. A round seat of black lacquer in its gold rim holding a polished
// gold bead; the chosen one is a lamp instead, burning white at its middle
// and warm at its rim, its glow held in the seat.
let ad_radio = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, focus: float, active: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let q = p - c
    let lr = length(q)
    let d = lr - rad
    var fill = mix(vec3(0.016, 0.014, 0.013), vec3(0.045, 0.038, 0.030), hover * live)
    fill = mix(fill, vec3(0.06, 0.05, 0.04), dis)
    var out = ad_well_r(p, c, vec2(rad, rad), rad, px, fill, 0.6, 1.2, dis)
    out = Finish.over(out, ad_pin(d, 1.8, max(px, 0.6), px, 0.45 * hover * live * (1.0 - active)))
    let br = rad * 0.58
    // the glow of the lamp, held inside its seat
    let on = active * live
    let glow = exp(0.0 - max(lr - br, 0.0) / 1.3) * on * Finish.cover(d + 1.2, px) * 0.75
    out = Finish.over(out, vec4(vec3(1.0, 0.70, 0.34) * glow, glow))
    // not chosen: a polished gold bead, a little lower while pressed
    let bead = ad_dome(vec4(0.0, 0.0, 0.0, 0.0), p, c, br, px, mix(ad_gold_lt(), vec3(0.36, 0.31, 0.24), dis))
    out = Finish.over(out, bead * (1.0 - active) * (1.0 - 0.3 * down * live))
    // chosen: the lamp itself, its middle burning white, warm at its rim
    let t = clamp(lr / br, 0.0, 1.0)
    var lc = mix(vec3(1.0, 0.99, 0.95), vec3(1.0, 0.78, 0.46), smoothstep(0.25, 1.0, t))
    lc = mix(lc, vec3(0.46, 0.42, 0.35), dis)
    let la = Finish.cover(lr - br, px) * active
    out = Finish.over(out, vec4(lc * la, la))
    let gq = q / br - vec2(-0.32, -0.38)
    let gl = exp(0.0 - dot(gq, gq) / 0.04) * la * 0.55
    out = Finish.over(out, vec4(vec3(1.0, 1.0, 1.0) * gl, gl))
    return Finish.over(out, ad_focus(d, px, focus * live))
}

