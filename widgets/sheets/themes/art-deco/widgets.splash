use mod.prelude.widgets_internal.*

// Art deco, black and gold. The window is a cabinet of black lacquer: a
// polished gold rim runs round its edge and round every pane, a thin gold
// pinstripe beside each rim makes the double line of the period, and the
// panes are stepped at their corners like a ziggurat. The panes are dark
// macassar ebony, a fine straight figure under one broad lacquer sheen, calm
// under the words. The caption band carries the only large ornament: a
// stepped crest with mother-of-pearl inlays round the title and a gold
// sunburst fanning out to either side; the big surfaces carry small
// sunburst fans, studs and pearl wedges in their corners and on their
// frames, never under their words.
// A control is a PLATE of satin metal with rounded corners (antique brass,
// polished gold, champagne, ivory-cream or copper, dark ink on all of them)
// or of black lacquer in a polished gold rim (cream ink); or a WELL of black
// lacquer sunk behind the same rim. Knobs are ivory with fluted skirts under
// spun gold caps, slider thumbs gold streamline wings, toggles gold balls in
// black pills, the rocker a gold bat-handle lever, the chosen radio a lit
// lamp among gold beads, lamps LEDs in gold bezels, screens black glass in
// gold frames with warm amber figures. The light falls from the upper left;
// polished gold is a mirror: a hot white-gold highlight where it faces the
// light, a warm darker band where it turns away.

// A ROW OF FIELDS IS ONE HEIGHT. The box metrics are stated once here and
// handed to each field below, so the search box, the number beside it and
// the drop-down after it stand at one height.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 3.0
// A hairline, for the few stock fields the faces below do not redraw.
let field_border = 0.5

let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that lays its own parts out inside a frame: only the height.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #1f1810

// Plain views stop clipping, so a shadow or a lip may fall into the gap
// beside its control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// The palette.
let ad_cream = fn() -> vec3 {
    return vec3(0.929, 0.886, 0.776)
}
let ad_black = fn() -> vec3 {
    return vec3(0.034, 0.031, 0.028)
}
let ad_ebony_c = fn() -> vec3 {
    return vec3(0.120, 0.095, 0.060)
}
let ad_gold_dk = fn() -> vec3 {
    return vec3(0.270, 0.190, 0.085)
}
let ad_gold_md = fn() -> vec3 {
    return vec3(0.640, 0.520, 0.310)
}
let ad_gold_lt = fn() -> vec3 {
    return vec3(0.910, 0.830, 0.640)
}
let ad_gold_hi = fn() -> vec3 {
    return vec3(1.000, 0.970, 0.880)
}
let ad_line_c = fn() -> vec3 {
    return vec3(0.780, 0.670, 0.450)
}
let ad_gold_base = fn() -> vec3 {
    return vec3(0.790, 0.660, 0.420)
}
let ad_champ = fn() -> vec3 {
    return vec3(0.850, 0.785, 0.640)
}
let ad_ivory = fn() -> vec3 {
    return vec3(0.925, 0.890, 0.790)
}
let ad_ivory_dk = fn() -> vec3 {
    return vec3(0.640, 0.580, 0.455)
}
let ad_brass = fn() -> vec3 {
    return vec3(0.660, 0.555, 0.370)
}
let ad_copper = fn() -> vec3 {
    return vec3(0.700, 0.480, 0.330)
}
let ad_bronze = fn() -> vec3 {
    return vec3(0.215, 0.140, 0.062)
}

// A rounded box, true radius.
let md_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let md_r4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    return clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
}
let md_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    return md_rbox(p, c, h, md_r4(p, c, h, r4))
}

// The outward normal of a rounded box at `p`.
let ad_nrm = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let q0 = p - c
    let sx = mix(-1.0, 1.0, step(0.0, q0.x))
    let sy = mix(-1.0, 1.0, step(0.0, q0.y))
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(rr, rr)
    var n = vec2(0.0, 1.0)
    if q.x > 0.0 && q.y > 0.0 {
        n = q / max(length(q), 0.0001)
    } else {
        if q.x > q.y {
            n = vec2(1.0, 0.0)
        }
    }
    return vec2(n.x * sx, n.y * sy)
}

// A plate's outline: a box with a radius per corner (tl, tr, br, bl; 0
// leaves it square), and its outward normal.
let ad_cut = fn(p: vec2, c: vec2, h: vec2, k4: vec4) -> float {
    return md_rbox4(p, c, h, k4)
}
let ad_cut_n = fn(p: vec2, c: vec2, h: vec2, k4: vec4) -> vec2 {
    let e = 0.3
    let gx = md_rbox4(p + vec2(e, 0.0), c, h, k4) - md_rbox4(p - vec2(e, 0.0), c, h, k4)
    let gy = md_rbox4(p + vec2(0.0, e), c, h, k4) - md_rbox4(p - vec2(0.0, e), c, h, k4)
    let g = vec2(gx, gy)
    let l = length(g)
    if l < 0.0001 {
        return vec2(0.0, 1.0)
    }
    return g / l
}

// A box STEPPED at its corners like a ziggurat: two steps of `s` points.
let ad_step = fn(p: vec2, c: vec2, h: vec2, s: float) -> float {
    let s1 = min(s, min(h.x, h.y) * 0.25)
    let a = md_rbox(p, c, h - vec2(0.0, 2.0 * s1), 0.0)
    let b = md_rbox(p, c, h - vec2(s1, s1), 0.0)
    let e = md_rbox(p, c, h - vec2(2.0 * s1, 0.0), 0.0)
    return min(a, min(b, e))
}
let ad_step_n = fn(p: vec2, c: vec2, h: vec2, s: float) -> vec2 {
    let e = 0.3
    let gx = ad_step(p + vec2(e, 0.0), c, h, s) - ad_step(p - vec2(e, 0.0), c, h, s)
    let gy = ad_step(p + vec2(0.0, e), c, h, s) - ad_step(p - vec2(0.0, e), c, h, s)
    let g = vec2(gx, gy)
    let l = length(g)
    if l < 0.0001 {
        return vec2(0.0, 1.0)
    }
    return g / l
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's cut.
let md_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let md_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroke tapering from `r0` at `a` to `r1` at `b`: .x its distance, .y the
// way along it.
let ad_taper = fn(p: vec2, a: vec2, b: vec2, r0: float, r1: float) -> vec2 {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return vec2(length(pa - ba * t) - mix(r0, r1, t), t)
}

let md_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// THE EBONY at a point `w` (points): macassar, its figure running straight
// down the panel in streaks of a few points to a few tens, wandering a
// little sideways as a real board does; fine dark pores a device pixel or
// two wide; a grain of one device pixel. Low in contrast, so a word reads
// the same on any streak.
let ad_ebony = fn(w: vec2, px: float) -> vec3 {
    let wx = w.x + (Finish.noise(vec2(w.x * 0.0035, w.y * 0.0021)) - 0.5) * 32.0 + (Finish.noise(vec2(w.x * 0.02, w.y * 0.008) + vec2(3.0, 1.0)) - 0.5) * 5.0
    let s1 = Finish.noise(vec2(wx * 0.055, w.y * 0.0018 + 7.0))
    let s2 = Finish.noise(vec2(wx * 0.21, w.y * 0.006 + 2.0))
    let fig = s1 * 0.65 + s2 * 0.35
    var col = mix(vec3(0.086, 0.068, 0.042), vec3(0.168, 0.122, 0.078), smoothstep(0.38, 0.86, fig))
    let pore = Finish.noise(vec2(wx * 1.1, w.y * 0.03 + 11.0))
    col = col * (1.0 - 0.22 * smoothstep(0.72, 0.9, pore))
    let lift = Finish.noise(vec2(wx * 0.75 + 4.0, w.y * 0.02))
    col = col * (1.0 + 0.10 * smoothstep(0.75, 0.92, lift))
    return col + g3(Finish.grain(w / px, 0.004))
}

// MOTHER-OF-PEARL: a cool white with soft swirling bands of rose and of
// green-blue, as the nacre turns.
let ad_pearl = fn(p: vec2) -> vec3 {
    let n1 = Finish.noise(p * 0.16 + vec2(3.0, 7.0))
    let n2 = Finish.noise(p * 0.45 + vec2(11.0, 2.0))
    let sw = sin((p.x * 0.55 + p.y * 0.9) * 0.8 + n1 * 6.0)
    var col = vec3(0.860, 0.850, 0.820)
    col = mix(col, vec3(0.950, 0.860, 0.880), smoothstep(0.2, 0.9, sw) * 0.5)
    col = mix(col, vec3(0.790, 0.900, 0.880), smoothstep(0.3, 0.9, 0.0 - sw) * 0.4)
    return col * (0.86 + 0.18 * n2)
}

// A POLISHED GOLD RIM `w` points wide just inside an edge: `d` the edge's
// distance (negative inside), `n` its outward normal. Rounded over and lit
// from the upper left as a mirror: the half that faces the light carries a
// hot white-gold highlight, the turn away a warm darker band, the far side
// the deep gold of the floor's reflection; a dark hairline at both of its
// edges keeps it crisp on black. Premultiplied.
let ad_rim = fn(d: float, n: vec2, w: float, px: float, glint: float) -> vec4 {
    let u = clamp(0.0 - d / max(w, 0.01), 0.0, 1.0)
    let k = 1.0 - 2.0 * u
    let bulge = sqrt(max(1.0 - k * k, 0.0))
    let facing = dot(n * k, vec2(-0.45, -0.89))
    let t = clamp(0.5 + 0.55 * facing + 0.15 * bulge, 0.0, 1.0)
    var col = mix(ad_gold_dk(), ad_gold_md(), smoothstep(0.0, 0.45, t))
    col = mix(col, ad_gold_lt(), smoothstep(0.45, 0.78, t))
    col = mix(col, ad_gold_hi(), smoothstep(0.80, 1.0, t) * clamp(glint, 0.0, 1.5))
    col = col * (1.0 - 0.30 * exp(0.0 - (facing + 0.1) * (facing + 0.1) / 0.03) * bulge)
    let e = Finish.band(d, 0.0, px, px) + Finish.band(d, w - px, w, px)
    col = mix(col, ad_gold_dk() * 0.5, clamp(e, 0.0, 1.0) * 0.5)
    let a = Finish.band(d, 0.0, w, px)
    return vec4(col * a, a)
}

// A thin gold pinstripe `lw` wide at `at` points inside an edge.
let ad_pin = fn(d: float, at: float, lw: float, px: float, amt: float) -> vec4 {
    let a = Finish.band(d, at, at + lw, px) * amt
    return vec4(ad_line_c() * a, a)
}

// The shadow a raised part throws on the ground, straight down: tight, gone
// within half the gap to a neighbour. Premultiplied black.
let ad_drop = fn(p: vec2, c: vec2, h: vec2, r: float, amt: float) -> vec4 {
    let t = Finish.drop(p, c, h, r, vec2(0.0, 0.8), 0.6) * 0.55 * amt
    let s = Finish.drop(p, c, h, r, vec2(0.0, 1.6), 1.2) * 0.40 * amt
    let a = t + s * (1.0 - t)
    return vec4(0.0, 0.0, 0.0, a)
}

// Focus: a warm white-gold ring of a device pixel and a half, a point and a
// half outside.
let ad_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 1.5, 1.5 + 1.5 * px, px) * 0.95 * focus
    let c = vec3(1.0, 0.86, 0.52)
    return vec4(c * f, f)
}

// BLACK LACQUER over the box `lo`..`hi`: a mirror. A soft band of the room's
// light across its upper part, the face darkening toward its foot, and a
// warm glow of its own gold rim reflected along the foot. `k` scales the
// sheen (a tall surface takes less, so no band crosses its words).
let ad_lacq = fn(p: vec2, lo: vec2, hi: vec2, base: vec3, k: float) -> vec3 {
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = base * (1.30 - 0.50 * t)
    let band = exp(0.0 - (t - 0.20) * (t - 0.20) / 0.010)
    col = col + vec3(0.075, 0.068, 0.058) * band * 0.65 * k
    col = col + vec3(0.090, 0.060, 0.020) * smoothstep(0.78, 1.0, t) * 0.30
    return col
}

// POLISHED METAL over the box `lo`..`hi`: a mirror gradient, bright along
// the top where it faces the light, a warm darker band below the middle, a
// little light again at the foot from the floor; satin brushing across it.
// `contrast` 1 is polished gold, less is champagne or ivory. Pressed, the
// face is dished: the gradient turns over.
let ad_metal = fn(p: vec2, lo: vec2, hi: vec2, base: vec3, contrast: float, hover: float, press: float) -> vec3 {
    let t0 = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let t = mix(t0, 1.0 - t0, press * 0.8)
    let up = 1.0 - smoothstep(0.0, 0.45, t)
    let dip = exp(0.0 - (t - 0.68) * (t - 0.68) / 0.03)
    let foot = smoothstep(0.85, 1.0, t)
    var col = base * (1.0 + contrast * (0.24 * up - 0.24 * dip + 0.10 * foot))
    col = mix(col, vec3(1.0, 0.97, 0.88), exp(0.0 - t * t / 0.006) * 0.35 * contrast * (1.0 - press))
    let br = Finish.brushed(p, vec2(1.0, 0.0), 0.4) - 0.5
    col = col * (1.0 + br * 0.06)
    col = Finish.lift(col, 0.20 * hover * (1.0 - press))
    col = col * (1.0 - 0.14 * press)
    return min(col, vec3(1.0, 1.0, 1.0))
}

// A shaped piece of polished gold (a thumb, a cap, a stud): `d` its
// distance, `n` its outward normal, `depth` how far in its rounded edge
// runs, `t` 0..1 down it for the mirror gradient.
let ad_gold_shape = fn(d: float, n: vec2, depth: float, t: float, hover: float, dis: float) -> vec3 {
    let ins = clamp(0.0 - d / max(depth, 0.01), 0.0, 1.0)
    let facing = dot(n, vec2(-0.45, -0.89)) * (1.0 - ins)
    var col = ad_gold_base() * (1.06 + 0.22 * (1.0 - smoothstep(0.0, 0.5, t)) - 0.26 * exp(0.0 - (t - 0.72) * (t - 0.72) / 0.03))
    col = mix(col, ad_gold_hi(), smoothstep(0.30, 0.95, facing) * 0.85)
    col = mix(col, ad_gold_dk(), smoothstep(0.15, 0.95, 0.0 - facing) * 0.75)
    col = Finish.lift(col, 0.12 * hover)
    col = mix(col, mix(col, g3(Finish.lum(col)), 0.7) * 0.6, dis)
    return min(col, vec3(1.0, 1.0, 1.0))
}

// A polished gold dome (a stud, a bead): lit on its upper left.
let ad_dome = fn(dst: vec4, p: vec2, c: vec2, r: float, px: float, base: vec3) -> vec4 {
    let q = (p - c) / max(r, 0.01)
    let lit = clamp(0.5 - 0.6 * dot(q, vec2(0.45, 0.85)), 0.0, 1.0)
    var col = mix(ad_gold_dk(), base, 0.25 + 0.75 * lit)
    col = mix(col, ad_gold_hi(), exp(0.0 - dot(q - vec2(-0.35, -0.4), q - vec2(-0.35, -0.4)) / 0.06) * 0.85)
    let d = length(p - c) - r
    col = mix(col, ad_gold_dk() * 0.5, Finish.band(d, 0.0, max(px, 0.4), px) * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(dst, vec4(col * a, a))
}

// A SUNK WELL behind a polished gold rim: the fill, the shade falling in
// under the top edge, the rim, and a faint catch of gold light on the ground
// under its foot. `d`, `n` the well's edge; `c`, `h`, `r` its box for the
// inner shadow.
let ad_well = fn(p: vec2, c: vec2, h: vec2, r: float, d: float, n: vec2, px: float, fill: vec3, shade: float, w: float, dis: float) -> vec4 {
    var col = fill
    let sh = clamp(Finish.inset(p, c, h - vec2(w, w), max(r - w, 0.0), vec2(0.0, 1.4), 1.2), 0.0, 1.0)
    col = mix(col, vec3(0.0, 0.0, 0.0), sh * shade)
    let a = Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px, px) * clamp(n.y, 0.0, 1.0) * 0.30
    var out = vec4(ad_gold_md() * lip, lip)
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, ad_rim(d, n, w, px, 1.0 - 0.7 * dis) * mix(1.0, 0.5, dis))
}
let ad_well_r = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, shade: float, w: float, dis: float) -> vec4 {
    let d = md_rbox(p, c, h, r)
    let n = ad_nrm(p, c, h, r)
    return ad_well(p, c, h, r, d, n, px, fill, shade, w, dis)
}

// A dark plaque's indicator jewel, where a stock face carries a lamp.
let md_led = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, lit: float, glow: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let k = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(Finish.lift(ink, 0.35), ink * 0.9, smoothstep(0.2, 1.0, k))
    let off = vec3(0.10, 0.08, 0.06)
    var col = mix(off, on, lit)
    col = mix(col, ad_gold_md(), Finish.band(d, 0.0, max(px, 0.6), px))
    let a = Finish.cover(d, px)
    let ha = glow * lit * exp(0.0 - max(d, 0.0) / 0.8) * step(0.0, d) * (1.0 - a)
    var out = vec4(ink * ha, ha)
    return Finish.over(out, vec4(col * a, a))
}

// A QUARTER SUNBURST in a corner, in the corner's own frame: `q` in points
// from the corner along its two edges, both into the surface. A small gold
// quarter disc on the corner, nine rays fanning out from it, long and short
// by turns, and a fine arc closing the long ones. `s` its reach in points.
let ad_fan = fn(dst: vec4, q: vec2, s: float, px: float, amt: float) -> vec4 {
    var out = dst
    let r = length(q)
    if r > s + 2.0 || q.x < -1.0 || q.y < -1.0 {
        return out
    }
    let phi = atan2(q.y, q.x)
    let st = 1.5707963 / 8.0
    let k = phi / st
    let kf = floor(k + 0.5)
    let dperp = abs(k - kf) * st * r
    let long = 1.0 - step(0.25, abs(fract(kf * 0.5)))
    let len = mix(s * 0.68, s, long)
    let ray = Finish.cover(dperp - max(px * 0.5, 0.32), px) * Finish.cover(r - len, px) * step(r, len + 1.0) * smoothstep(3.5, 5.0, r)
    let a = ray * amt * 0.9
    out = Finish.over(out, vec4(ad_line_c() * a, a))
    let arc = Finish.cover(abs(r - s * 0.68) - max(px * 0.5, 0.3), px) * amt * 0.7
    out = Finish.over(out, vec4(ad_line_c() * arc, arc))
    out = ad_dome(out, q, vec2(0.0, 0.0), 4.0, px, ad_gold_base())
    return out
}

// The fan set into a box's corner `k` (0 top left, 1 top right, 2 bottom
// right, 3 bottom left), `ins` points in from its edges.
let ad_corner_fan = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, k: float, ins: float, s: float, px: float, amt: float) -> vec4 {
    let right = step(0.5, k) * step(k, 2.5)
    let bottom = step(1.5, k)
    let x = mix(p.x - lo.x, hi.x - p.x, right) - ins
    let y = mix(p.y - lo.y, hi.y - p.y, bottom) - ins
    return ad_fan(dst, vec2(x, y), s, px, amt)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family: a plate of satin metal with rounded
// corners in its own polished rim, its edge bevelled toward the light, a
// tight shadow under it, the legend in dark ink. `kind`: 0 antique brass
// (the plain button), 1 polished gold (primary), 2 champagne (secondary), 3
// ivory-cream (tertiary), 4 copper (the one that deletes, its legend in
// oxblood), 5 the outline (the ground shows inside a double gold line), 6
// bare until touched (flatter), 7 champagne (the flat root and its sizes),
// 8 black lacquer (the quiet plates of a strip: a tab, a closed drop-down).
// Pressed, a plate sinks and its mirror turns over; disabled, it goes flat
// and dull and a small unlit lamp shows at its left end. The quad is grown
// by `m` for the shadow and the focus ring.
let ad_face = fn(p: vec2, lo: vec2, hi: vec2, kind: float, hover: float, press: float) -> vec3 {
    if kind > 7.5 {
        return Finish.lift(ad_lacq(p, lo, hi, ad_black(), 1.0 + 1.6 * hover), 0.04 * hover)
    }
    if kind < 0.5 {
        return ad_metal(p, lo, hi, ad_brass(), 0.8, hover, press)
    }
    if kind < 1.5 {
        return ad_metal(p, lo, hi, ad_gold_base(), 1.0, hover, press)
    }
    if kind < 2.5 {
        return ad_metal(p, lo, hi, ad_champ(), 0.7, hover, press)
    }
    if kind < 3.5 {
        return ad_metal(p, lo, hi, ad_ivory(), 0.35, hover, press)
    }
    if kind < 4.5 {
        return ad_metal(p, lo, hi, ad_copper(), 0.85, hover, press)
    }
    return ad_metal(p, lo, hi, ad_champ(), 0.7, hover, press)
}
let ad_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, k4: vec4, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let hov = hover * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = ad_cut(p, c, h, k4)
    let n = ad_cut_n(p, c, h, k4)
    let outline = step(4.5, kind) * step(kind, 5.5)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let show = mix(1.0, clamp(hov * 0.85 + press, 0.0, 1.0), bare)
    let solid = 1.0 - max(outline, bare)
    var out = ad_drop(p, c, h, 2.0, (1.0 - 0.7 * press) * mix(1.0, 0.5, dis) * solid)
    let w = 1.5
    let lacq = step(7.5, kind)
    var face = ad_face(p, lo + vec2(w, w), hi - vec2(w, w), kind, hov, press)
    // disabled: the metal goes flat and dull, the lacquer greyed
    let tt = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let dull = mix(vec3(0.440, 0.410, 0.350) * (1.06 - 0.12 * tt), mix(face, g3(Finish.lum(face)), 0.65) * 0.55 + vec3(0.025, 0.020, 0.015), lacq)
    face = mix(face, dull, dis)
    // the plate's bevelled shoulder inside the rim, lit from the upper
    // left: light along its top and left, shade along its foot and right
    let bev = Finish.bevel(d + w, n, 1.8, vec2(-0.45, -0.89)) * Finish.cover(d + w, px) * (1.0 - press)
    face = face * (1.0 + 0.22 * max(bev, 0.0) * (1.0 - lacq) + 0.22 * min(bev, 0.0))
    face = face + vec3(0.05, 0.045, 0.04) * max(bev, 0.0) * lacq
    // pressed: the surround's shade falls in under the top edge
    let sh = clamp(Finish.inset(p, c, h - vec2(w, w), 1.5, vec2(0.0, 1.7), 1.2), 0.0, 1.0) * press
    face = mix(face, face * 0.3, sh * 0.85)
    let fa = Finish.cover(d + w * 0.5, px)
    out = Finish.over(out, vec4(face * fa, fa) * solid)
    // the outline and the bare kinds: a faint gold wash under the pointer
    let wash = max(outline, bare) * (0.10 * hov + 0.18 * press) * fa
    out = Finish.over(out, vec4(ad_gold_md() * wash, wash))
    // the pinstripe inside the rim, on the lacquer and the outline
    let pin = max(lacq, outline) * mix(0.85, 0.35, dis)
    out = Finish.over(out, ad_pin(d, w + 1.4, max(px, 0.6), px, pin))
    // disabled, a small lamp at the plate's left end is out: a slot of
    // milky glass in a dark seat
    let slot = dis * solid * (1.0 - lacq) * step(50.0, size.x)
    if slot > 0.5 {
        let sc = vec2(lo.x + w + 4.4, c.y)
        let sd = md_rbox(p, sc, vec2(1.3, 4.6), 1.3)
        let sa = Finish.cover(sd - 0.7, px)
        out = Finish.over(out, vec4(vec3(0.16, 0.13, 0.09) * sa, sa))
        let lt = clamp((p.y - (sc.y - 4.6)) / 9.2, 0.0, 1.0)
        let lc = mix(vec3(0.80, 0.76, 0.66), vec3(0.60, 0.56, 0.47), lt)
        let la = Finish.cover(sd, px)
        out = Finish.over(out, vec4(lc * la, la))
    }
    // the rim: pressed, its light turns over, so the plaque reads sunk in it
    out = Finish.over(out, ad_rim(d, n * (1.0 - 2.0 * press), w, px, mix(1.0, 0.3, dis) * (1.0 + 0.5 * hov)) * mix(1.0, 0.5, dis) * show)
    out = Finish.over(out, ad_focus(d, px, focus * live))
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        sdf.fill(vec4(0.93, 0.79, 0.48, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

