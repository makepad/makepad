// ---------------------------------------------------------------------------
// THE WINDOW'S GROUND. Black lacquer, with two holes cut in it: the header
// where the catalogue's toolbar stands and the panes below it, both stepped
// at their corners, both showing the ebony. A polished gold rim runs round
// each hole on the lacquer's side and a pinstripe beside it, and a rim runs
// round the window's own edge, so every band of lacquer between them is
// drawn with the double gold line. The caption band above the header holds
// the crest round the title and the sunburst; nothing else of the frame is
// ornamented, and the ebony is calm under the words.
let ad_holes = fn(p: vec2, W: float, H: float) -> float {
    let dh = ad_step(p, vec2(W * 0.5, 60.0), vec2(W * 0.5 - 6.0, 27.0), 4.0)
    let dp = ad_step(p, vec2(W * 0.5, (95.0 + H - 6.0) * 0.5), vec2(W * 0.5 - 6.0, (H - 6.0 - 95.0) * 0.5), 5.0)
    return min(dh, dp)
}

// The crest round the title, in the window's middle: `q` is (distance from
// the middle, y), so it is drawn the same on both sides. A plaque of black
// lacquer stepped at its corners in a gold rim and pinstripe, and three
// steps falling away from it either side, the nearest inlaid with
// mother-of-pearl, the two beyond with upright gold pinstripes.
let ad_crest = fn(dst: vec4, q: vec2, px: float) -> vec4 {
    var out = dst
    if q.x > 140.0 {
        return out
    }
    // the steps either side
    let s0 = md_rbox(q, vec2(93.0, 15.5), vec2(8.0, 10.5), 0.0)
    let s1 = md_rbox(q, vec2(110.0, 18.0), vec2(8.0, 8.0), 0.0)
    let s2 = md_rbox(q, vec2(127.0, 20.5), vec2(8.0, 5.5), 0.0)
    let ds = min(s0, min(s1, s2))
    let sa = Finish.cover(ds, px)
    let sl = ad_lacq(q, vec2(0.0, 5.0), vec2(0.0, 26.0), ad_black(), 1.0)
    out = Finish.over(out, vec4(sl * sa, sa))
    // the pearl in the nearest step
    let pd = md_rbox(q, vec2(93.0, 15.5), vec2(5.6, 8.1), 0.0)
    let pa = Finish.cover(pd, px)
    out = Finish.over(out, vec4(ad_pearl(q * 1.2 + vec2(3.0, 0.0)) * pa, pa))
    // upright pinstripes in the two beyond
    let u1 = (1.0 - smoothstep(0.35, 0.35 + px, abs(abs(q.x - 110.0) - 2.5))) * Finish.cover(md_rbox(q, vec2(110.0, 18.0), vec2(6.0, 6.0), 0.0), px)
    let u2 = (1.0 - smoothstep(0.35, 0.35 + px, abs(q.x - 127.0))) * Finish.cover(md_rbox(q, vec2(127.0, 20.5), vec2(6.0, 3.5), 0.0), px)
    let ua = max(u1, u2) * 0.85
    out = Finish.over(out, vec4(ad_line_c() * ua, ua))
    // each step's gold outline
    let e0 = Finish.band(s0, 0.0, 1.0, px)
    let e1 = Finish.band(s1, 0.0, 1.0, px)
    let e2 = Finish.band(s2, 0.0, 1.0, px)
    let ea = clamp(e0 + e1 + e2, 0.0, 1.0)
    out = Finish.over(out, vec4(ad_gold_md() * ea, ea))
    // the plaque
    let pc = vec2(0.0, 15.5)
    let ph = vec2(83.0, 11.5)
    let d = ad_step(q, pc, ph, 3.0)
    let n = ad_step_n(q, pc, ph, 3.0)
    let a = Finish.cover(d, px)
    let face = ad_lacq(q, pc - ph, pc + ph, ad_black(), 1.0)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, ad_pin(d, 2.8, max(px, 0.6), px, 0.8))
    return Finish.over(out, ad_rim(d, n, 1.5, px, 1.0))
}

// The sunburst: gold rays fanning from a point far below the window's
// middle, thick and thin by turns, across the caption band clear of the
// crest; they fade out short of the window's buttons and of its left end.
let ad_burst = fn(dst: vec4, p: vec2, W: float, px: float) -> vec4 {
    let cx = W * 0.5
    let x = abs(p.x - cx)
    if x < 136.0 {
        return dst
    }
    let q = vec2(p.x - cx, 160.0 - p.y)
    let r = length(q)
    let phi = atan2(q.x, q.y)
    let st = 0.03
    let k = phi / st
    let kf = floor(k + 0.5)
    let dperp = abs(k - kf) * st * r
    let thick = mix(0.26, 0.6, step(0.25, abs(fract(kf * 0.5))))
    let ray = Finish.cover(dperp - thick, px)
    let clear = smoothstep(136.0, 150.0, x) * smoothstep(2.0, 5.0, p.y) * (1.0 - smoothstep(26.0, 28.0, p.y))
    let fade_r = 1.0 - smoothstep(W - 300.0, W - 165.0, p.x)
    let fade_l = smoothstep(6.0, 70.0, p.x)
    let ra = ray * clear * fade_r * fade_l * 0.75
    return Finish.over(dst, vec4(mix(ad_line_c(), ad_gold_lt(), 0.25) * ra, ra))
}

mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let W = self.rect_size.x
    let H = self.rect_size.y
    let dhole = ad_holes(p, W, H)
    let e = 0.35
    let gx = ad_holes(p + vec2(e, 0.0), W, H) - ad_holes(p - vec2(e, 0.0), W, H)
    let gy = ad_holes(p + vec2(0.0, e), W, H) - ad_holes(p - vec2(0.0, e), W, H)
    var nh = vec2(0.0, 1.0)
    if length(vec2(gx, gy)) > 0.0001 {
        nh = normalize(vec2(gx, gy))
    }
    // the lacquer of the frame: a band of the room's light high in the
    // caption band, a little lighter toward the top
    var col = vec3(0.026, 0.024, 0.022)
    let lb = exp(0.0 - (p.y - 9.0) * (p.y - 9.0) / 45.0) * 0.032
    col = col + vec3(lb, lb * 0.95, lb * 0.88)
    // the ebony in the holes under one broad diagonal lacquer sheen
    var wood = ad_ebony(p, px)
    let u = (p.x * 0.45 + p.y) / max(H, 1.0)
    let sheen = exp(0.0 - (u - 0.30) * (u - 0.30) / 0.02) * 0.016
    wood = wood + vec3(sheen, sheen * 0.92, sheen * 0.8)
    let inh = Finish.cover(dhole, px)
    col = mix(col, wood, inh)
    // the frame's shade on the wood along each hole's upper and left edges
    let sh = (1.0 - smoothstep(0.0, 5.0, 0.0 - dhole)) * inh * (0.4 + 0.6 * clamp(0.0 - nh.y - nh.x * 0.5, 0.0, 1.0))
    col = mix(col, col * 0.45, sh * 0.7)
    var out = vec4(col, 1.0)
    // the caption band's ornament
    if p.y < 31.0 {
        out = ad_burst(out, p, W, px)
        out = ad_crest(out, vec2(abs(p.x - W * 0.5), p.y), px)
    }
    // the gold rim along every hole on the lacquer's side, the pinstripe
    // beyond it, and the rim round the window's edge
    out = Finish.over(out, ad_rim(0.0 - dhole, nh * -1.0, 2.0, px, 1.0))
    out = Finish.over(out, ad_pin(0.0 - dhole, 3.0, max(px, 0.7), px, 0.85))
    let dw = md_rbox(p, vec2(W, H) * 0.5, vec2(W, H) * 0.5, 0.0)
    let nw = ad_nrm(p, vec2(W, H) * 0.5, vec2(W, H) * 0.5, 0.0)
    out = Finish.over(out, ad_rim(dw, nw, 1.6, px, 1.0))
    return vec4(out.rgb, 1.0)
}

// A splitter is the frame's lacquer band run down between two panes, ten
// points wide, its gold rims stepping into the header's band above and the
// foot band below as the panes' corners step.
let ad_split = fn(q: vec2, mid: float, hw: float, a0: float, a1: float) -> float {
    let ph = vec2(200.0, (a1 - a0) * 0.5)
    let dl = ad_step(q, vec2(mid - hw - 200.0, (a0 + a1) * 0.5), ph, 5.0)
    let dr = ad_step(q, vec2(mid + hw + 200.0, (a0 + a1) * 0.5), ph, 5.0)
    return min(min(dl, dr), q.y + 4.0)
}
mod.widgets.Splitter.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 14.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 14.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let v = self.is_vertical
    // work in the bar's own frame: `a` along it, `b` across it
    let a = mix(p.x, p.y, v)
    let b = mix(p.y, p.x, v)
    let along = mix(size.x, size.y, v)
    let thick = mix(size.y, size.x, v)
    let mid = thick * 0.5
    let hw = 5.0
    let a0 = 4.0
    let a1 = along - 6.0
    let q = vec2(b, a)
    let dh = ad_split(q, mid, hw, a0, a1)
    let e = 0.35
    let gx = ad_split(q + vec2(e, 0.0), mid, hw, a0, a1) - ad_split(q - vec2(e, 0.0), mid, hw, a0, a1)
    let gy = ad_split(q + vec2(0.0, e), mid, hw, a0, a1) - ad_split(q - vec2(0.0, e), mid, hw, a0, a1)
    var nh = vec2(0.0, 1.0)
    if length(vec2(gx, gy)) > 0.0001 {
        nh = normalize(vec2(gx, gy))
    }
    let inside = step(-8.0, a) * step(a, along - 1.6) * step(abs(b - mid), hw + 12.0)
    let band = Finish.cover(0.0 - dh, px) * inside
    let act = max(max(self.hover, self.drag), self.focus)
    var lac = vec3(0.026, 0.024, 0.022)
    lac = Finish.lift(lac, 0.04 * act)
    var out = vec4(lac * band, band)
    let nn = vec2(mix(nh.y, nh.x, v), mix(nh.x, nh.y, v))
    out = Finish.over(out, ad_rim(0.0 - dh, nn * -1.0, 2.0, px, 1.0) * inside)
    out = Finish.over(out, ad_pin(0.0 - dh, 3.0, max(px, 0.7), px, 0.85) * inside)
    // under the hand, a bright gold line down the middle of the grip
    let inbar = 1.0 - smoothstep(self.bar_size * 0.5 - 2.0, self.bar_size * 0.5, abs(a - along * 0.5))
    let gl = (1.0 - smoothstep(0.5, 0.5 + px, abs(b - mid))) * inbar * act
    out = Finish.over(out, vec4(ad_gold_lt() * gl, gl))
    return out
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES. The slide switch is a black pill in its gold rim that fills
// with gold while on, an ivory dome riding in it. The rocker is a lever
// switch: a black lacquer plate in its gold rim, a polished gold collar at
// its middle with a small lamp set in it, and a gold bat-handle lever
// thrown to the left while off and to the right while on, when the lamp in
// the collar burns amber.
let ad_lever_d = fn(p: vec2, cc: vec2, tip: vec2) -> vec4 {
    // the lever's distance (.x) and its outward normal (.yz): a tapered
    // shaft from the collar to the tip, and a ball on the tip
    let ba = tip - cc
    let k = clamp(dot(p - cc, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let ax = p - (cc + ba * k)
    let dl = length(ax) - mix(2.4, 1.6, k)
    let bq = p - tip
    let db = length(bq) - 3.1
    if db < dl {
        let nb = bq / max(length(bq), 0.0001)
        return vec4(db, nb.x, nb.y, 0.0)
    }
    let nl = ax / max(length(ax), 0.0001)
    return vec4(dl, nl.x, nl.y, 0.0)
}
let ad_rocker = fn(pos: vec2, size: vec2, o: vec2, px: float, active: float, hover: float, down: float, focus: float, dis: float, at_end: float) -> vec4 {
    let m = 4.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let tw = 38.0
    let th = 16.0
    let x0 = mix(1.0, size.x - tw - 1.0, at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - th) * 0.5, px)) - o
    let hi = lo + vec2(tw, th)
    let c = (lo + hi) * 0.5
    let h = vec2(tw * 0.5, th * 0.5)
    let d = md_rbox(p, c, h, 3.0)
    let n = ad_nrm(p, c, h, 3.0)
    var out = ad_drop(p, c, h, 3.0, mix(1.0, 0.5, dis))
    let face = mix(ad_lacq(p, lo, hi, ad_black(), 1.0), vec3(0.06, 0.05, 0.04), dis)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, ad_pin(d, 2.6, max(px, 0.6), px, mix(0.6, 0.3, dis)))
    out = Finish.over(out, ad_rim(d, n, 1.3, px, 1.0 - 0.7 * dis) * mix(1.0, 0.5, dis))
    let on = clamp(active, 0.0, 1.0)
    let cc = vec2(Finish.snap(o.x + c.x, px) - o.x, c.y)
    let tip = cc + vec2(mix(-11.0, 11.0, on), 0.3)
    let press = down * live
    // the lever's shadow on the plate, down and to the right
    let sh = ad_lever_d(p - vec2(0.6, 1.5), cc, tip)
    let sa = (1.0 - smoothstep(-0.6, 1.8, sh.x)) * 0.6 * a
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, sa))
    // the lever, polished gold
    let lv = ad_lever_d(p, cc, tip)
    let t = clamp((p.y - (cc.y - 3.0)) / 6.0, 0.0, 1.0)
    var lc = ad_gold_shape(lv.x, vec2(lv.y, lv.z), 1.8, t, hover * live * (1.0 - press), dis)
    lc = mix(lc, lc * 0.85, press)
    lc = mix(lc, ad_gold_dk() * 0.4, Finish.band(lv.x, 0.0, max(px, 0.5), px) * 0.7)
    let lfa = Finish.cover(lv.x, px)
    out = Finish.over(out, vec4(lc * lfa, lfa))
    // the collar over the lever's root, and the lamp in it: amber and
    // burning while on, dark glass while off
    out = Finish.over(out, ad_drop(p, cc, vec2(5.2, 5.2), 5.2, 0.6))
    out = ad_dome(out, p, cc, 5.2, px, mix(ad_gold_base(), vec3(0.36, 0.31, 0.24), dis))
    let jq = p - cc
    let jl = length(jq)
    let seat = Finish.cover(jl - 2.9, px)
    out = Finish.over(out, vec4(vec3(0.05, 0.035, 0.02) * seat, seat))
    let lit = on * live
    let jt = clamp(jl / 2.3, 0.0, 1.0)
    let jon = mix(vec3(1.0, 0.95, 0.80), vec3(1.0, 0.56, 0.16), smoothstep(0.2, 1.0, jt))
    let joff = mix(vec3(0.16, 0.09, 0.04), vec3(0.08, 0.045, 0.02), jt)
    var jc = mix(joff, jon, lit)
    let gq = jq / 2.3 - vec2(-0.3, -0.4)
    jc = mix(jc, vec3(1.0, 1.0, 1.0), exp(0.0 - dot(gq, gq) / 0.05) * mix(0.35, 0.5, lit))
    let ja = Finish.cover(jl - 2.3, px)
    out = Finish.over(out, vec4(jc * ja, ja))
    let jg = exp(0.0 - max(jl - 2.3, 0.0) / 1.0) * lit * (1.0 - ja) * Finish.cover(jl - 2.9, px) * 0.8
    out = Finish.over(out, vec4(vec3(1.0, 0.62, 0.22) * jg, jg))
    return Finish.over(out, ad_focus(d, px, focus * live))
}
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.draw_bg.size = 14.0
mod.widgets.ToggleSlide.draw_bg.size = 14.0
mod.widgets.ToggleRocker.min_height = 24.0
mod.widgets.ToggleSlide.min_height = 24.0
mod.widgets.ToggleRocker.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleSlide.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleRocker.draw_bg.knob_inset = 7.0
mod.widgets.ToggleSlide.draw_bg.knob_inset = 7.0
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return ad_rocker(self.pos, self.rect_size, self.rect_pos, px, self.active, self.hover, self.down, self.focus, self.disabled, self.mark_at_end)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return ad_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 1.0)
}

// THE GLASS of the readouts, the screen and the meter: black glass, a faint
// warm sheen across its upper left and the surround's shade falling in under
// its top edge, set in a polished gold rim with a pinstripe inside it.
let ad_glass = fn(p: vec2, lo: vec2, hi: vec2, r4: vec4, px: float, face: vec3) -> vec4 {
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = md_r4(p, c, h, r4)
    let d = md_rbox(p, c, h, r)
    var out = ad_drop(p, c, h, r, 0.8)
    let hf = h - vec2(1.8, 1.8)
    var g = face
    let uv = (p - lo) / max(hi - lo, vec2(1.0, 1.0))
    let diag = uv.x * 0.7 + uv.y
    let sheen = smoothstep(0.0, 0.25, diag) * (1.0 - smoothstep(0.30, 0.70, diag)) * 0.045
    g = g + vec3(0.95, 0.88, 0.72) * sheen
    g = mix(g, vec3(0.0, 0.0, 0.0), clamp(Finish.inset(p, c, hf, max(r - 1.8, 0.0), vec2(0.0, 2.2), 2.0), 0.0, 1.0) * 0.6)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(g * a, a))
    out = Finish.over(out, ad_pin(d, 3.0, max(px, 0.55), px, 0.55))
    return Finish.over(out, ad_rim(d, ad_nrm(p, c, h, r), 1.8, px, 1.0))
}

mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.padding = mod.turtle.Inset{top: 8.0 right: 11.0 bottom: 8.0 left: 11.0}
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    return ad_glass(p, lo, hi, vec4(3.0, 3.0, 3.0, 3.0), px, self.color.rgb)
}
mod.widgets.ScreenView.bezel = 3.0
mod.widgets.ScreenView.sheen = 0.02

// THE METER sits in the same glass: its window arched at the top, faint gold
// rays fanning up from the pivot behind the scale, the scale a fine gold arc
// with gold ticks, the colour band under it running gold to amber to an
// ember red, the needle a cream spear and its pivot a polished gold boss.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(3.0)
mod.widgets.NeedleMeter.draw_bg.color = uniform(#0b0907)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#xf3e8cf)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#xe0482a)
mod.widgets.NeedleMeter.draw_bg.color_scale = uniform(#xe2cc96)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let r = min(self.border_radius, min(hi.x - lo.x, hi.y - lo.y) * 0.5)
    let rt = min(34.0, min(hi.x - lo.x, hi.y - lo.y) * 0.45)
    var out = ad_glass(p, lo, hi, vec4(rt, rt, r, r), px, vec3(0.043, 0.035, 0.027))
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let rq = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let inside = Finish.cover(md_rbox4(p, (lo + hi) * 0.5, (hi - lo) * 0.5 - vec2(2.5, 2.5), vec4(rt - 2.5, rt - 2.5, r, r)), px)
    // the rays behind the scale
    let st = sweep / 16.0
    let kr = ang / st
    let kd = abs(kr - floor(kr + 0.5)) * st * rq
    let rays = Finish.cover(kd - max(px * 0.5, 0.3), px) * smoothstep(6.0, 10.0, rq) * (1.0 - smoothstep(rr - 7.0, rr - 5.0, rq)) * on_scale * inside * 0.22
    out = Finish.over(out, vec4(ad_line_c() * rays, rays))
    // the colour band under the scale
    let bandr = Finish.cover(abs(rq - (rr - 2.6)) - 1.6, px) * on_scale
    let ramp = mix(mix(vec3(0.86, 0.70, 0.38), vec3(1.0, 0.62, 0.24), smoothstep(0.35, 0.7, t)), self.color_zone.rgb, step(self.zone, t))
    let ba = bandr * 0.85 * inside
    out = Finish.over(out, vec4(ramp * ba, ba))
    // the scale: a hairline arc and a tick at every division
    let arc = Finish.cover(abs(rq - rr) - px * 0.6, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - rq, rq - rr)
    let tick = Finish.cover(perp - px * mix(0.55, 0.9, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    let sa = max(arc, tick) * inside
    out = Finish.over(out, vec4(self.color_scale.rgb * sa, sa))
    // the needle: a slim spear from under the pivot to just past the scale
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let sp = ad_taper(p, pv - nd * 3.0, pv + nd * (rr + 4.0), 1.3, 0.35)
    let nf = mix(self.color_needle.rgb, ad_gold_lt(), smoothstep(0.3, 1.0, sp.y) * 0.25)
    let nk = Finish.cover(sp.x, px)
    out = Finish.over(out, vec4(nf * nk, nk))
    out = ad_dome(out, p, pv, self.pivot_size + 0.8, px, ad_gold_base())
    return out * self.color.a * self.opacity
}
mod.widgets.NeedleMeter.draw_label.color = #xe2cc96

// ---------------------------------------------------------------- lamps
// LAMPS: LEDs in polished gold bezels. The emitter is the light: at full
// current its middle burns toward white and its rim is its most saturated
// colour; at lower current the middle is no longer white, the colour deeper,
// the glow smaller; out, it is dark tinted glass, its colour barely there,
// with a catch light along its lower rim. Its light is added, never
// painted: a tight hot halo and a short bloom in its own hue, gone in about
// two radii. A bar is the same light drawn out into a short light pipe.
let md_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(0.0 - light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let md_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
let md_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = md_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
let md_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.32 * rt, 0.8, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = md_led_lamp_full(ink)
    let hue = md_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // the bezel's shadow on the ground
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.12 * rt + 0.3), 0.10 * rt + 0.5) * 0.5 * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, shd))
    // the polished gold bezel: a ring rounded over, lit from the upper left,
    // a dark seat line where it holds the lens
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    var rc = ad_gold_base() * (0.85 + 0.45 * facing)
    rc = mix(rc, ad_gold_hi(), smoothstep(0.5, 0.95, facing) * 0.8)
    rc = mix(rc, ad_gold_dk() * 0.6, Finish.band(ds, 0.0, max(px, 0.45), px) * 0.6)
    rc = mix(rc, vec3(0.02, 0.015, 0.01), Finish.ring_out(d, 0.0, max(px, 0.45), px) * 0.85)
    res = Finish.over(res, vec4(min(rc, white) * a_s, a_s))
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(0.0 - xl / max(0.30 * rt, 0.4)) * 1.5 + exp(0.0 - xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = md_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE LENS: lit, its middle burns toward white at full current and its
    // rim is its most saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(0.0 - (q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(0.0 - t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // out: dark tinted glass, a catch light along its lower rim
    let offc = mix(vec3(0.06, 0.055, 0.05), b * 0.42, 0.26)
    var off = mix(offc * 0.62, offc * 1.15, top)
    off = mix(off, min(offc + vec3(0.16, 0.16, 0.16), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.26, 0.20) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp. A round LED takes the middle of its
// cell; its halo's room is held in the cell, so the light is never cut at
// its edge and fades within half the gap. A bar is a short light pipe set at
// the left of its cell, six points thick and twice that long, its glow held
// to two and a half points round its bezel -- the whole lamp takes the first
// twenty points of its cell and leaves the rest free.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.size = 14.0
mod.widgets.Lamp.halo_reach = 0.3
mod.widgets.LampBar.size = 14.0
mod.widgets.LampBar.halo_reach = 0.3
mod.widgets.Lamp.draw_bg.color_accent = uniform(#xffa83a)
mod.widgets.Lamp.draw_bg.color_success = uniform(#x3ad98a)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#xf2c443)
mod.widgets.Lamp.draw_bg.color_error = uniform(#xe5483a)
mod.widgets.Lamp.draw_bg.color_plain = uniform(#xfff3d8)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = min(self.rect_size.y / (1.0 + 2.0 * reach), 14.0)
    let room = (self.rect_size.y - t) * 0.5
    let tb = min(t, 6.0)
    let lb = 14.0
    let c = mix(self.rect_size * 0.5, vec2(1.6 + lb * 0.5, self.rect_size.y * 0.5), self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(lb * 0.5, tb * 0.5), self.bar)
    let glow = mix(max(room - 2.5, 2.0), 2.2, self.bar)
    let res = md_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, ad_ebony_c(), glow)
    return res * self.opacity
}
true
