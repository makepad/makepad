mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(14.0)
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let c = lo + vec2(sz * 0.5, sz * 0.5)
    return ad_radio(p, c, sz * 0.5, px, self.hover, self.down, self.focus, self.active, self.disabled)
}
// The flatter radio is its word alone: chosen, the word sits on a small
// lacquer plaque in a gold rim; under the pointer a faint gold wash.
mod.widgets.RadioButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x - 3.0, px), Finish.snap(o.y + 1.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x + 3.0, px), Finish.snap(o.y + self.rect_size.y - 1.0, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(2.5, 2.5, 2.5, 2.5)
    let d = ad_cut(p, c, h, k4)
    let wash = Finish.cover(d, px) * 0.15 * self.hover * live * (1.0 - self.active)
    var out = vec4(ad_gold_md() * wash, wash)
    let face = ad_lacq(p, lo, hi, ad_black(), 1.0)
    let a = Finish.cover(d, px) * self.active
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.2, px, 1.0) * self.active)
    return Finish.over(out, ad_focus(d, px, self.focus * live))
}

// Radio tabs (the catalogue's Docs, Controls, Actions, Theme): lacquer
// plaques in their rims; the chosen one champagne gold pressed in, its word
// dark.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 6.0 bottom: 2.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let k4 = vec4(3.0, 3.0, 3.0, 3.0)
    let dark = ad_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, 0.0, 0.0, k4, 8.0, 6.0)
    let gold = ad_button(self.pos, self.rect_size, self.rect_pos, px, self.hover * 0.5, 0.6, self.focus, self.disabled, 0.0, 0.0, k4, 2.0, 6.0)
    return mix(dark, gold, self.active)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #ede2c6
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #1c1206
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #7a6e5a
mod.widgets.RadioButtonTabFlat.draw_text.text_style = mod.theme.font_label{font_size: 7.0}

// ---------------------------------------------------------------------------
// SLIDERS. A gold tube: a capsule three and a half points high in its
// polished rim, a black slot inside, polished gold filling the slot up to
// the value; fine gold ticks above it. The thumb is a gold streamline wing:
// an upright capsule on the value with three feathers swept back from its
// shoulder, each shorter than the one above it, with its own shadow. Every
// slider's quad grows for the wing, its shadow and the focus ring.
let ad_tube = fn(p: vec2, c: vec2, h: vec2, px: float, f0: float, f1: float, dis: float, hover: float) -> vec4 {
    let r = h.y
    var out = ad_well_r(p, c, h, r, px, vec3(0.012, 0.011, 0.010), 0.5, 1.4, dis)
    let w = 1.4
    let fh = vec2(max((f1 - f0) * 0.5, 0.0), max(h.y - w - 0.5, 0.6))
    let fc = vec2((f0 + f1) * 0.5, c.y)
    let fd = md_rbox(p, fc, fh, fh.y)
    var fcol = ad_metal(p, fc - fh - vec2(0.0, 0.8), fc + fh + vec2(0.0, 0.8), ad_gold_base(), 1.0, hover, 0.0)
    fcol = mix(fcol, vec3(0.30, 0.26, 0.20), dis)
    let fa = Finish.cover(fd, px) * step(0.01, f1 - f0) * Finish.cover(md_rbox(p, c, h, r) + w, px)
    return Finish.over(out, vec4(fcol * fa, fa))
}

// The distance to a quadratic curve from `A` through the pull of `B` to `C`
// (.x), and how far along it the nearest point lies (.y, 0..1).
let ad_bez = fn(pos: vec2, A: vec2, B: vec2, C: vec2) -> vec2 {
    let a = B - A
    let b = A - 2.0 * B + C
    let c = a * 2.0
    let d = A - pos
    let kk = 1.0 / max(dot(b, b), 0.0001)
    let kx = kk * dot(a, b)
    let ky = kk * (2.0 * dot(a, a) + dot(d, b)) / 3.0
    let kz = kk * dot(d, a)
    let p = ky - kx * kx
    let p3 = p * p * p
    let q = kx * (2.0 * kx * kx - 3.0 * ky) + kz
    var h = q * q + 4.0 * p3
    var res = 0.0
    var tt = 0.0
    if h >= 0.0 {
        h = sqrt(h)
        let x0 = (h - q) * 0.5
        let x1 = (0.0 - h - q) * 0.5
        let u0 = sign(x0) * pow(abs(x0), 1.0 / 3.0)
        let u1 = sign(x1) * pow(abs(x1), 1.0 / 3.0)
        tt = clamp(u0 + u1 - kx, 0.0, 1.0)
        let e = d + (c + b * tt) * tt
        res = dot(e, e)
    } else {
        let z = sqrt(0.0 - p)
        let v = acos(clamp(q / (p * z * 2.0), -1.0, 1.0)) / 3.0
        let m = cos(v)
        let n = sin(v) * 1.732050808
        let t0 = clamp((m + m) * z - kx, 0.0, 1.0)
        let t1 = clamp((0.0 - n - m) * z - kx, 0.0, 1.0)
        let e0 = d + (c + b * t0) * t0
        let e1 = d + (c + b * t1) * t1
        let r0 = dot(e0, e0)
        let r1 = dot(e1, e1)
        res = min(r0, r1)
        tt = mix(t1, t0, step(r0, r1))
    }
    return vec2(sqrt(res), tt)
}

// A feather of the wing: a stroke along the curve `A`, `B`, `C`, tapering
// from `r0` at its root to a rounded tip of `r1`, rounded across, lit along
// its top, with a dark groove along its edge where it lies over the next.
let ad_feather = fn(dst: vec4, p: vec2, A: vec2, B: vec2, C: vec2, r0: float, r1: float, t: float, px: float, hover: float, dis: float) -> vec4 {
    let bz = ad_bez(p, A, B, C)
    let u = 1.0 - bz.y
    let q = A * u * u + B * 2.0 * u * bz.y + C * bz.y * bz.y
    let axis = p - q
    let rr = mix(r0, r1, bz.y)
    let d = bz.x - rr
    let n = axis / max(length(axis), 0.0001)
    var col = ad_gold_shape(d, n, rr * 1.2, t, hover, dis)
    col = mix(col, ad_gold_dk() * 0.35, Finish.band(d, 0.0, max(px, 0.55), px) * 0.8)
    let fa = Finish.cover(d, px)
    return Finish.over(dst, vec4(col * fa, fa))
}
let ad_wing = fn(p: vec2, kc: vec2, s: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let bh = vec2(5.0, 8.5) * s
    let bc = kc + vec2(0.0, 0.5 * s)
    var out = ad_drop(p, bc, bh, bh.x, (1.0 - 0.5 * press) * mix(1.0, 0.5, dis))
    out = Finish.over(out, ad_drop(p, kc + vec2(-9.5, -5.0) * s, vec2(9.0, 4.5) * s, 3.0 * s, 0.5 * (1.0 - 0.5 * press)))
    let t = clamp((p.y - (kc.y - 12.0 * s)) / (21.0 * s), 0.0, 1.0)
    let hv = hover * live * (1.0 - press)
    if p.x < kc.x + 3.0 * s && p.y < kc.y + 2.5 * s && p.y > kc.y - 14.5 * s && p.x > kc.x - 22.0 * s {
        out = ad_feather(out, p, kc + vec2(0.0, -1.0) * s, kc + vec2(-6.5, -1.3) * s, kc + vec2(-10.8, -3.4) * s, 2.2 * s, 1.0 * s, t, px, hv, dis)
        out = ad_feather(out, p, kc + vec2(0.0, -4.1) * s, kc + vec2(-8.5, -4.6) * s, kc + vec2(-14.0, -7.0) * s, 2.2 * s, 1.0 * s, t, px, hv, dis)
        out = ad_feather(out, p, kc + vec2(0.0, -7.2) * s, kc + vec2(-10.5, -7.9) * s, kc + vec2(-17.2, -10.3) * s, 2.3 * s, 1.05 * s, t, px, hv, dis)
    }
    // the body, over the roots of the feathers
    let db = md_rbox(p, bc, bh, bh.x)
    let bn = ad_nrm(p, bc, bh, bh.x)
    var bcol = ad_gold_shape(db, bn, 2.4 * s, t, hv, dis)
    bcol = mix(bcol, bcol * 0.88, press)
    bcol = mix(bcol, ad_gold_dk() * 0.4, Finish.band(db, 0.0, max(px, 0.5), px) * 0.75)
    let ba = Finish.cover(db, px)
    return Finish.over(out, vec4(bcol * ba, ba))
}

// Fine gold ticks above a track: one every tenth of the travel, the ends
// and the middle longer.
let ad_ticks = fn(p: vec2, x0: float, span: float, ytop: float, px: float, dis: float) -> vec4 {
    let f = (p.x - x0) / max(span, 1.0) * 10.0
    let fi = floor(f + 0.5)
    let dx = abs(p.x - (x0 + fi / 10.0 * span))
    let major = 1.0 - step(0.1, abs(fi * 0.2 - floor(fi * 0.2 + 0.5)))
    let len = mix(2.0, 3.4, major)
    let inr = step(-0.5, fi) * step(fi, 10.5)
    let tk = Finish.cover(dx - max(px * 0.5, 0.3), px) * step(ytop - len, p.y) * step(p.y, ytop) * inr * mix(0.85, 0.4, dis)
    return vec4(ad_line_c() * tk, tk)
}

