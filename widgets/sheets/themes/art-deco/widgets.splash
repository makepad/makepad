mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 18.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 18.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 9.0, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let w = x1 - x0
    let span = w - 18.0
    let kx = x0 + 9.0 + self.slide_pos * span
    let ox = x0 + 9.0 + self.origin_pos * span
    let f0 = mix(x0 + 2.0, min(ox, kx), self.arc_origin)
    let f1 = mix(kx, max(ox, kx), self.arc_origin)
    var out = ad_ticks(p, x0 + 9.0, span, cy - 6.0, px, self.disabled)
    out = Finish.over(out, ad_tube(p, vec2((x0 + x1) * 0.5, cy), vec2(w * 0.5, 4.5), px, f0, f1, self.disabled, max(self.hover, self.drag) * live))
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    out = Finish.over(out, ad_wing(p, kc, 1.0, px, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, ad_focus(md_rbox(p, kc + vec2(0.0, 0.5), vec2(5.0, 8.5), 5.0), px, self.focus * live))
}
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}

// The range slider: the same tube, gold between the two ends, a round gold
// coin on each end with a ring engraved in it, pressed while it is the one
// held.
let ad_coin = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    var out = ad_drop(p, c, vec2(rad, rad), rad, (1.0 - 0.5 * press) * mix(1.0, 0.5, dis))
    let q = p - c
    let d = length(q) - rad
    let n = q / max(length(q), 0.001)
    let t = clamp((p.y - (c.y - rad)) / (2.0 * rad), 0.0, 1.0)
    var col = ad_gold_shape(d, n, rad * 0.45, t, hover * (1.0 - press), dis)
    col = mix(col, col * 0.88, press)
    col = mix(col, ad_gold_dk() * 0.5, Finish.band(d, 0.0, max(px, 0.45), px) * 0.6)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(col * a, a))
    let ring = Finish.band(d, rad * 0.42, rad * 0.42 + max(px, 0.5), px) * 0.7
    out = Finish.over(out, vec4(ad_gold_dk() * 0.6 * ring, ring))
    let ringl = Finish.band(d, rad * 0.42 + max(px, 0.5), rad * 0.42 + 2.0 * max(px, 0.5), px) * 0.5
    return Finish.over(out, vec4(ad_gold_hi() * ringl, ringl))
}
mod.widgets.RangeSliderFlat.handle_size = 16.0
mod.widgets.RangeSliderFlat.track_inset = 1.0
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let top = self.label_px
    let cy = Finish.snap(o.y + top + (size.y - top) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let w = x1 - x0
    let span = max(size.x - self.inset_px * 2.0 - self.handle_px, 1.0)
    let sx = self.inset_px + self.handle_px * 0.5 + self.start_pos * span
    let ex = self.inset_px + self.handle_px * 0.5 + self.end_pos * span
    var out = ad_tube(p, vec2((x0 + x1) * 0.5, cy), vec2(w * 0.5, 4.5), px, sx, ex, self.disabled, max(self.hover, self.drag) * live)
    let k0 = vec2(Finish.snap(o.x + sx, px) - o.x, cy)
    let k1 = vec2(Finish.snap(o.x + ex, px) - o.x, cy)
    out = Finish.over(out, ad_coin(p, k0, 7.0, px, max(self.hot_start, self.focus * 0.5) * live, self.drag * self.hot_start * live, self.disabled))
    out = Finish.over(out, ad_coin(p, k1, 7.0, px, max(self.hot_end, self.focus * 0.5) * live, self.drag * self.hot_end * live, self.disabled))
    return out
}

// The minimal slider: a gold hairline (a dark device pixel over a bright
// one), a brighter gold thread along it to the thumb, and the wing a size
// smaller riding on it.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 16.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 16.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 6.0, px) - o.y
    let kr = 5.0
    let kx = kr + self.slide_pos * (size.x - 2.0 * kr)
    let inx = step(0.0, p.x) * step(p.x, size.x)
    let dark = step(cy - px, p.y) * step(p.y, cy) * inx
    let light = step(cy, p.y) * step(p.y, cy + px) * inx
    let thread = step(cy - 2.0 * px, p.y) * step(p.y, cy + px) * step(p.x, kx) * inx
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let la = light * 0.75 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(ad_gold_md() * la, la))
    let da = dark * 0.9
    out = Finish.over(out, vec4(vec3(0.0, 0.0, 0.0) * da, da))
    let tcol = mix(ad_gold_lt(), vec3(0.36, 0.31, 0.24), self.disabled)
    out = Finish.over(out, vec4(tcol * thread, thread))
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy - 1.0)
    out = Finish.over(out, ad_wing(p, kc, 0.8, px, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, ad_focus(md_rbox(p, kc + vec2(0.0, 0.4), vec2(4.0, 6.8), 4.0), px, self.focus * live))
}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}

// The round slider: a short gold tube beside its label, gold to the value,
// a gold ball on the end of the gold; the value reads past it.
mod.widgets.SliderRoundFlat.height = 18.0
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderRoundFlat.text_input.margin = mod.turtle.Inset{left: 0.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.width = 30.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let y0 = Finish.snap(o.y + 2.0, px) - o.y
    let x1 = Finish.snap(o.x + size.x - 44.0, px) - o.x
    let y1 = Finish.snap(o.y + size.y - 2.0, px) - o.y
    let h = vec2((x1 - x0) * 0.5, (y1 - y0) * 0.5)
    let c = vec2(x0, y0) + h
    let ins = 1.4
    let kr = h.y - ins + 0.2
    let kx = x0 + ins + kr + self.slide_pos * (2.0 * h.x - 2.0 * ins - 2.0 * kr)
    var out = ad_tube(p, c, h, px, x0 + ins, kx, self.disabled, self.hover * live)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, c.y)
    out = Finish.over(out, ad_coin(p, kc, kr + 1.0, px, self.hover, self.drag * live, self.disabled))
    return Finish.over(out, ad_focus(md_rbox(p, c, h, h.y), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// FADERS. A black slot five points wide in its gold rim, fine gold ticks
// either side, a gold thread in the slot for the value; the cap a polished
// gold block 22 points across with its corners rounded, two grip grooves cut
// across it and a black line with a cream thread through its middle.
mod.widgets.SliderFader.cap_size = 13.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = floor(across * 0.5 / px) * px
    // the slot, in screen space
    let sw = 5.0
    let sc = mix(vec2(along * 0.5, mid), vec2(mid, size.y - along * 0.5), vert)
    let sh = mix(vec2(along * 0.5 - self.inset_px, sw * 0.5), vec2(sw * 0.5, along * 0.5 - self.inset_px), vert)
    var out = ad_well_r(p, sc, sh, sw * 0.5, px, vec3(0.010, 0.009, 0.008), 0.5, 1.0, self.disabled)
    // the value: a gold thread in the slot, from the origin (or the foot)
    let va0 = foot + self.fill_lo * travel
    let va1 = foot + self.fill_hi * travel
    let vl = step(va0, a) * step(a, va1) * (1.0 - smoothstep(0.6, 0.6 + px, abs(b - mid))) * live
    out = Finish.over(out, vec4(ad_gold_lt() * 0.95 * vl, vl * 0.95))
    // ticks: a long one every quarter of the travel, short ones between
    let nt = 16.0
    let f = (a - foot) / travel * nt
    let fi = floor(f + 0.5)
    let da = abs(a - (foot + fi / nt * travel))
    let major = 1.0 - step(0.1, abs(fi * 0.25 - floor(fi * 0.25 + 0.5)))
    let tl = mix(2.5, 4.5, major)
    let off = abs(b - mid) - sw * 0.5 - 2.5
    let in_rng = step(-0.5, fi) * step(fi, nt + 0.5)
    let tk = (1.0 - smoothstep(px * 0.6, px * 0.6 + 0.01 + px * 0.4, da)) * step(0.0, off) * step(off, tl) * in_rng * 0.85 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(ad_line_c() * tk, tk))
    // the cap
    let at = foot + self.slide_pos * travel
    let cw = min(22.0, across)
    let cs = mix(vec2(at, mid), vec2(mid, size.y - at), vert)
    let ch = mix(vec2(self.cap_px * 0.5, cw * 0.5), vec2(cw * 0.5, self.cap_px * 0.5), vert)
    let cc = vec2(Finish.snap(o.x + cs.x, px) - o.x, Finish.snap(o.y + cs.y, px) - o.y)
    let k4 = vec4(2.5, 2.5, 2.5, 2.5)
    let cd = ad_cut(p, cc, ch, k4)
    let press = self.drag * live
    out = Finish.over(out, ad_drop(p, cc, ch, 2.0, (1.0 - press * 0.5) * mix(1.0, 0.5, self.disabled)))
    var face = ad_metal(p, cc - ch, cc + ch, ad_gold_base(), 1.0, max(self.hover, self.focus * 0.5) * live, press)
    face = mix(face, vec3(0.30, 0.26, 0.20), self.disabled)
    let fa = Finish.cover(cd, px)
    out = Finish.over(out, vec4(face * fa, fa))
    // the grooves and the middle line, across the cap
    let ln = mix(abs(p.y - cc.y), abs(p.x - cc.x), 1.0 - vert)
    let inside = Finish.cover(cd + 2.0, px)
    let gr = (1.0 - smoothstep(0.35, 0.35 + px, abs(ln - 3.6))) * inside * 0.55
    out = Finish.over(out, vec4(vec3(0.20, 0.13, 0.05) * gr, gr))
    let bl = (1.0 - smoothstep(0.9, 0.9 + px, ln)) * inside
    out = Finish.over(out, vec4(vec3(0.02, 0.018, 0.016) * bl, bl))
    let cl = (1.0 - smoothstep(0.25, 0.25 + px, ln)) * inside * 0.9
    out = Finish.over(out, vec4(ad_cream() * cl, cl))
    out = Finish.over(out, ad_rim(cd, ad_cut_n(p, cc, ch, k4), 1.2, px, live) * mix(1.0, 0.5, self.disabled))
    return Finish.over(out, ad_focus(cd, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. An ivory knob: a fluted skirt, its flutes running round its side
// and turning with the light from the upper left, under a cap of spun gold
// in a polished collar; the pointer a lit cream slit in the cap. Round it a
// fine gold track and the value in bright gold.
let ad_knob = fn(p: vec2, c: vec2, rad: float, px: float, ang: float, hover: float, press: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    var out = ad_drop(p, c, vec2(rad, rad), rad, (1.0 - 0.4 * press) * mix(1.0, 0.5, dis))
    let q = p - c
    let l = length(q)
    let d = l - rad
    let n = q / max(l, 0.001)
    // the fluted skirt
    let th = atan2(q.y, q.x)
    let nf = max(floor(rad * 1.1), 14.0)
    let fl = cos(th * nf)
    let lit = clamp(0.5 - 0.6 * dot(n, vec2(0.45, 0.85)), 0.0, 1.0)
    var sk = mix(ad_ivory_dk(), ad_ivory(), 0.2 + 0.8 * lit)
    sk = sk * (0.86 + 0.14 * fl)
    sk = mix(sk, sk * 0.72, smoothstep(0.82, 1.0, l / rad) * 0.6)
    sk = Finish.lift(sk, 0.08 * hover * live)
    sk = mix(sk, mix(sk, g3(Finish.lum(sk)), 0.7) * 0.55, dis)
    sk = mix(sk, vec3(0.30, 0.25, 0.18), Finish.band(d, 0.0, max(px, 0.5), px) * 0.6)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(sk * a, a))
    // the spun gold cap in its collar
    let cr = rad * 0.64
    let dc = l - cr
    var cap = ad_gold_base() * Finish.spun(p, c, vec2(-0.45, -0.89))
    cap = mix(cap, ad_gold_hi(), smoothstep(0.55, 1.0, lit) * 0.25)
    cap = Finish.lift(cap, 0.10 * hover * live * (1.0 - press))
    cap = mix(cap, cap * 0.88, press)
    cap = mix(cap, mix(cap, g3(Finish.lum(cap)), 0.7) * 0.55, dis)
    let ca = Finish.cover(dc, px)
    out = Finish.over(out, vec4(min(cap, vec3(1.0, 1.0, 1.0)) * ca, ca))
    out = Finish.over(out, ad_rim(dc, n, max(0.9, rad * 0.07), px, live) * mix(1.0, 0.5, dis))
    // the pointer: a lit cream slit cut in the cap from its middle to its
    // edge, a dark hairline round it
    let dir = vec2(0.0 - sin(ang), cos(ang))
    let lw = max(0.5, rad * 0.04)
    let ld = md_seg(p, c + dir * cr * 0.10, c + dir * (cr - max(1.0, rad * 0.07)))
    let ea = Finish.cover(ld - lw - max(px, 0.45), px) * 0.7
    out = Finish.over(out, vec4(vec3(0.06, 0.04, 0.02) * ea, ea))
    let la = Finish.cover(ld - lw, px)
    let lcol = mix(vec3(1.0, 0.97, 0.88), vec3(0.60, 0.56, 0.48), dis)
    return Finish.over(out, vec4(lcol * la, la))
}

// The value arc round a knob: `ar` its middle radius, `aw` its width; the
// gap centred at the bottom, the value clockwise from its left end, or from
// the origin when the knob is bipolar. The track a fine gold line with a
// tick at either end, the value bright gold.
let md_arc = fn(p: vec2, c: vec2, ar: float, aw: float, px: float, v0: float, v1: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    var ang = atan2(0.0 - q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let rd = abs(length(q) - ar) - aw * 0.5
    let rt = abs(length(q) - ar) - max(px * 0.6, 0.4)
    let in_arc = step(start, ang) * step(ang, start + sweep)
    let e0 = vec2(0.0 - sin(start), cos(start))
    let e1 = vec2(0.0 - sin(start + sweep), cos(start + sweep))
    let t0 = md_seg(p, c + e0 * (ar - aw), c + e0 * (ar + aw * 1.2)) - max(px * 0.6, 0.4)
    let t1 = md_seg(p, c + e1 * (ar - aw), c + e1 * (ar + aw * 1.2)) - max(px * 0.6, 0.4)
    let track_d = min(mix(1000.0, rt, in_arc), min(t0, t1))
    let a0 = start + sweep * v0
    let a1 = start + sweep * v1
    let l0 = c + vec2(0.0 - sin(a0), cos(a0)) * ar
    let l1 = c + vec2(0.0 - sin(a1), cos(a1)) * ar
    let lit_in = step(a0, ang) * step(ang, a1)
    let lit_d = min(mix(1000.0, rd, lit_in), min(length(p - l0), length(p - l1)) - aw * 0.5)
    let ta = Finish.cover(track_d, px) * 0.75
    var out = vec4(ad_line_c() * ta, ta)
    let la = Finish.cover(lit_d, px)
    let ink = mix(ad_gold_lt(), vec3(0.36, 0.31, 0.24), dis)
    return Finish.over(out, vec4(ink * la, la))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - dia * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let aw = 1.6
    let ar = floor((rr - aw * 0.5) / px) * px
    let rad = floor((ar - aw * 0.5 - 2.6) / px) * px
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    var out = md_arc(p, c, ar, aw, px, v0, v1, gap, self.disabled)
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, ad_knob(p, c, rad, px, ang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, ad_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}
// Knob legends are small wide capitals in gold.
mod.widgets.RotaryKnob.draw_text.color = #d8c08c
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_label{font_size: 6.5}

// The dial: the knob above set in a sunburst. A polished gold band round
// the outside steps down to a ring of fan blades, ivory and gold by turns,
// each ivory blade carrying an LED slot that lights warm white up to the
// value; a gold step inside the fan, a black moat, and in it the value as a
// glowing ring round the knob. Where the sweep leaves its gap the fan is
// black lacquer.
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dis = self.disabled
    let room = vec2(size.x, size.y - 24.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 24.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    let q = p - c
    let l = length(q)
    let n = q / max(l, 0.001)
    var ang = atan2(0.0 - q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let d_out = l - rr
    var out = ad_drop(p, c, vec2(rr, rr), rr, mix(1.0, 0.5, dis))
    // the black lacquer disc
    let lac = ad_lacq(p, c - vec2(rr, rr), c + vec2(rr, rr), ad_black(), 0.6)
    let ba = Finish.cover(d_out, px)
    out = Finish.over(out, vec4(lac * ba, ba))
    // the ring of fan blades over the sweep
    let bw = max(2.0, rr * 0.075)
    let fo = rr - bw
    let fw = max(5.0, rr * 0.22)
    let fi = fo - fw
    let nb = max(floor(sweep / (2.0 * PI / 24.0) + 0.5), 4.0)
    let seg = sweep / nb
    let kf = floor((ang - start) / seg)
    let ivory = 1.0 - step(0.25, abs(fract(kf * 0.5)))
    let in_sweep = step(start, ang) * step(ang, start + sweep)
    let ring = Finish.cover(l - fo, px) * Finish.cover(fi - l, px) * in_sweep
    let u = clamp((l - fi) / max(fw, 0.01), 0.0, 1.0)
    let side = fract((ang - start) / seg)
    var blade = mix(ad_gold_base() * (0.85 + 0.35 * (1.0 - side)), ad_ivory() * (0.80 + 0.22 * (1.0 - side)), ivory)
    blade = blade * (0.88 + 0.16 * clamp(0.5 - 0.6 * dot(n, vec2(0.45, 0.85)), 0.0, 1.0))
    blade = mix(blade, mix(blade, g3(Finish.lum(blade)), 0.7) * 0.55, dis)
    // a dark hairline between the blades
    let bdist = min(side, 1.0 - side) * seg * l
    blade = mix(blade, vec3(0.06, 0.04, 0.02), Finish.cover(bdist - max(px * 0.5, 0.3), px) * 0.8)
    out = Finish.over(out, vec4(blade * ring, ring))
    // the LED slot in each ivory blade, lit up to the value
    let bmid = start + (kf + 0.5) * seg
    let bv = (kf + 0.5) / nb
    let led_on = step(v0 - 0.001, bv) * step(bv, v1 + 0.001) * live
    let dir = vec2(0.0 - sin(bmid), cos(bmid))
    let sd = md_seg(p, c + dir * (fi + fw * 0.30), c + dir * (fi + fw * 0.70)) - max(0.75, rr * 0.022)
    let sa = Finish.cover(sd, px) * ivory * in_sweep
    let sglow = exp(0.0 - max(sd, 0.0) / 1.2) * ivory * in_sweep * led_on * step(fi, l) * step(l, fo)
    out = Finish.over(out, vec4(vec3(1.0, 0.70, 0.30) * sglow * 0.55, sglow * 0.55))
    let scol = mix(vec3(0.16, 0.12, 0.08), vec3(1.0, 0.97, 0.88), led_on)
    out = Finish.over(out, vec4(scol * sa, sa))
    // the polished band outside, and the gold step inside the fan
    out = Finish.over(out, ad_rim(d_out, n, bw, px, live) * mix(1.0, 0.5, dis))
    let sw = max(1.4, rr * 0.045)
    let d_step = l - fi
    out = Finish.over(out, ad_rim(d_step, n, sw, px, live) * mix(1.0, 0.5, dis))
    // the moat and the glowing value ring round the knob
    let kr = fi - sw - max(3.0, rr * 0.09)
    let gr = (fi - sw + kr) * 0.5
    let la0 = start + sweep * v0
    let la1 = start + sweep * v1
    let lit_in = step(la0, ang) * step(ang, la1)
    let gd = abs(l - gr) - 0.6
    let core = Finish.cover(gd, px) * lit_in * live
    let halo = exp(0.0 - max(gd, 0.0) / 1.1) * lit_in * live * step(kr, l) * step(l, fi - sw)
    out = Finish.over(out, vec4(vec3(1.0, 0.72, 0.32) * halo * 0.6, halo * 0.6))
    out = Finish.over(out, vec4(vec3(1.0, 0.97, 0.88) * core, core))
    let kang = start + sweep * self.slide_pos
    out = Finish.over(out, ad_knob(p, c, kr, px, kang, max(self.hover, self.focus * 0.5), self.drag * live, dis))
    return Finish.over(out, ad_focus(d_out, px, self.focus * live))
}

// The dial's readout: a small plaque of the screens' black glass in its
// gold rim, amber figures.
let md_lcd = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, 2.0 * px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(2.5, 2.5, 2.5, 2.5)
    let d = ad_cut(p, c, h, k4)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = vec3(0.020, 0.018, 0.016) * (1.6 - 0.8 * t)
    col = mix(col, vec3(0.0, 0.0, 0.0), clamp(Finish.inset(p, c, h, 2.0, vec2(0.0, 1.2), 1.0), 0.0, 1.0) * 0.5)
    let a = Finish.cover(d, px)
    var out = ad_drop(p, c, h, 2.0, 0.6)
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, ad_rim(d, ad_cut_n(p, c, h, k4), 1.3, px, 1.0))
}
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 2.0 bottom: 2.0}
mod.widgets.RotaryFlat.text_input.min_height = 20.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_lcd(self.pos * self.rect_size, self.rect_size, self.rect_pos, px)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #ffb648
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #ffc768
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #ffc768
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #a07a3a
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.5}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A well of black lacquer sunk behind its gold rim, its corners
// cut; focused, a fine bright gold line lights inside the rim. Read only,
// the well is a dull bronze-black and the rim is dimmed.
let md_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, k: float) -> vec4 {
    let ins = 1.5
    let lo = vec2(Finish.snap(o.x + ins, px), Finish.snap(o.y + ins, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - ins, px), Finish.snap(o.y + size.y - ins, px)) - o - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let k4 = vec4(k, k, k, k)
    let d = ad_cut(p, c, h, k4)
    let n = ad_cut_n(p, c, h, k4)
    var fill = mix(vec3(0.016, 0.014, 0.013), vec3(0.032, 0.028, 0.024), hover * (1.0 - dis))
    fill = mix(fill, vec3(0.055, 0.045, 0.035), dis)
    var out = ad_well(p, c, h, k, d, n, px, fill, mix(0.7, 0.3, dis), 1.3, dis)
    out = Finish.over(out, ad_pin(d, 2.3, max(px, 0.6), px, 0.45 * hover * (1.0 - focus) * (1.0 - dis)))
    let fl = Finish.band(d, 2.3, 2.3 + max(px, 0.7), px) * focus * (1.0 - dis)
    return Finish.over(out, vec4(vec3(1.0, 0.88, 0.60) * fl, fl))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 3.0)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #a08f70
mod.widgets.TextInputFlat.draw_text.color_disabled = #8a7c64
mod.widgets.TextInputFlat.draw_cursor.color = #f2d07c

// The well a form's field stands in is the same lacquer well; a caller who
// asks for no box (a clear colour) gets none.
mod.widgets.FieldWell.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 3.0)
}

// NUMBER FIELDS. The lacquer well, and on its right a block of champagne
// gold split by a fine cut, a small black chevron in each half; the half
// under the pointer lifts, the held half sinks.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 3.0)
}
mod.widgets.NumberField.pad_left = 10.0
mod.widgets.NumberSpin.width = 16.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
let ad_chev = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    // a chevron hw either side, hh tall, pointing up (dir -1) or down (1)
    let a = c + vec2(0.0 - hw, 0.0 - hh * dir * 0.5)
    let b = c + vec2(0.0, hh * dir * 0.5)
    let e = c + vec2(hw, 0.0 - hh * dir * 0.5)
    return min(md_seg(p, a, b), md_seg(p, b, e))
}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.8, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 2.8, px), Finish.snap(o.y + self.rect_size.y - 2.8, px)) - o
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let k4 = vec4(0.0, 1.5, 1.5, 0.0)
    let d = ad_cut(p, c, h, k4)
    var face = ad_metal(p, lo, hi, ad_champ(), 0.7, hot, dn)
    face = mix(face, vec3(0.30, 0.26, 0.20), self.disabled)
    let a = Finish.cover(d, px)
    var out = vec4(face * a, a)
    // the cut down its left and across its middle
    let vl = step(lo.x, p.x) * step(p.x, lo.x + max(px, 0.7)) * step(lo.y, p.y) * step(p.y, hi.y) * 0.9
    let hl = step(abs(p.y - mid), max(px, 0.6) * 0.5) * step(lo.x, p.x) * step(p.x, hi.x) * 0.6
    let la = max(vl, hl)
    out = Finish.over(out, vec4(vec3(0.16, 0.10, 0.04) * la, la))
    let cx = (lo.x + hi.x) * 0.5 + 0.5
    let cu = ad_chev(p, vec2(cx, (lo.y + mid) * 0.5), 2.6, 2.4, -1.0) - 0.55
    let cd = ad_chev(p, vec2(cx, (mid + hi.y) * 0.5), 2.6, 2.4, 1.0) - 0.55
    let ti = Finish.cover(min(cu, cd), px)
    return Finish.over(out, vec4(vec3(0.08, 0.05, 0.02) * ti, ti))
}

// The drag-number: the lacquer well, its track a faint gold wash behind the
// ink.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = md_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 3.0)
    let d = md_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(3.0, 3.0), 1.5)
    let wx = 3.0 + (self.rect_size.x - 6.0) * max(self.fill, 0.0)
    let wash = step(0.0, self.fill) * step(p.x, wx) * Finish.cover(d, px) * 0.22
    return Finish.over(out, vec4(ad_gold_md() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #ede2c6
mod.widgets.ValueInput.draw_text.text_style = mod.theme.font_regular{font_size: 9.5 line_spacing: 1.0}
mod.widgets.ValueInput.arrow_color = #d8c08c
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// ---------------------------------------------------------------------------
// DROP-DOWNS. A black lacquer plaque in its gold rim, and at its right end a
// block of champagne gold carrying a black chevron. Open, the plaque is
// held pressed in.
let md_dropdown = fn(pos0: vec2, size0: vec2, o0: vec2, px: float, hover: float, held: float, focus: float, dis: float, ins: float) -> vec4 {
    let m = 6.0
    let p = pos0 * (size0 + vec2(2.0 * m, 2.0 * m)) - vec2(m, m) - vec2(0.0, ins)
    let size = size0 - vec2(0.0, 2.0 * ins)
    let o = o0 + vec2(0.0, ins)
    let pos = (p + vec2(m, m)) / (size + vec2(2.0 * m, 2.0 * m))
    let live = 1.0 - dis
    var out = ad_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(3.0, 3.0, 3.0, 3.0), 8.0, m)
    let lo = vec2(Finish.snap(o.x + size.x - 22.0, px) - o.x, 1.5)
    let hi = vec2(Finish.snap(o.x + size.x - 1.5, px) - o.x, size.y - 1.5)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let k4 = vec4(0.0, 2.0, 2.0, 0.0)
    let d = ad_cut(p, c, h, k4)
    var face = ad_metal(p, lo, hi, ad_champ(), 0.7, hover * live, held * live)
    face = mix(face, vec3(0.30, 0.26, 0.20), dis)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    let sl = step(lo.x, p.x) * step(p.x, lo.x + max(px, 0.7)) * step(lo.y, p.y) * step(p.y, hi.y)
    out = Finish.over(out, vec4(vec3(0.10, 0.065, 0.025) * sl, sl))
    let cc = vec2(c.x + 0.5, size.y * 0.5 + held * live * px)
    let tri = Finish.cover(ad_chev(p, cc, 3.2, 3.0, 1.0) - 0.65, px)
    return Finish.over(out, vec4(vec3(0.08, 0.05, 0.02) * tri, tri))
}

mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 12.0 right: 32.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDown.padding = mod.turtle.Inset{left: 12.0 right: 32.0 top: 4.0 bottom: 4.0}
