// An icon on a plate is in the plate's dark ink, whatever colour its
// caller asked for (the catalogue asks for the working cream, which a
// brass plate would swallow); on the outline and on a bare button, which
// stand on the dark ground, it is gold.
mod.widgets.ButtonFlat.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    let k = vec3(0.110, 0.075, 0.035)
    return vec4(k * base.a, base.a) * self.opacity
}
mod.widgets.Button.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    let k = vec3(0.110, 0.075, 0.035)
