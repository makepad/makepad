// An icon an app inks dark on the drop (the kitchen sink gives its star the
// print ink) is drawn in the light ink, the one that reads on black; a
// light or coloured ink, and the drawing's own colours, stand.
mod.widgets.Button.draw_icon.get_color = fn() {
    let base = self.eval_gradient()
    if self.color.x >= 0.0 {
        let dark = 1.0 - step(0.35, dot(self.color.rgb, vec3(0.3, 0.59, 0.11)))
        let ink = mix(self.color.rgb, vec3(0.961, 0.961, 0.961), dark)
        return vec4(ink * self.color.a * base.a, self.color.a * base.a) * self.opacity
    }
    return base * self.opacity
}
// The drops that do not take the Default's inks from it: the sizes and the
// compound button, handed its face above, and the date picker's opener,
// built from it with a label of its own. Each takes the light legend, the
// Default's icons and the field.
let fe_drop_inks = fn(w) {
    w.draw_text.color = #f5f5f5
    w.draw_text.color_hover = #ffffff
    w.draw_text.color_down = #e6e6e6
    w.draw_text.color_focus = #f5f5f5
    w.draw_text.color_disabled = #cfcdca
    w.draw_icon = mod.widgets.Button.draw_icon{}
    w.draw_icon_end = mod.widgets.Button.draw_icon_end{}
    w.cap_field_reach = 20.0
}
fe_drop_inks(mod.widgets.ButtonXs)
fe_drop_inks(mod.widgets.ButtonSm)
fe_drop_inks(mod.widgets.ButtonLg)
fe_drop_inks(mod.widgets.ButtonXl)
fe_drop_inks(mod.widgets.ButtonCompound)
fe_drop_inks(mod.widgets.DatePickerOpen)
// The compound button's second line, quieter, on the drop.
mod.widgets.ButtonCompound.draw_description.color = #a9a7a4
// The split button's chevron is drawn over its second half, a drop.
mod.widgets.SplitButton.draw_chevron.color = #f5f5f5
// The select's face is built from the Default but drawn as the drop-down's
// key (DROP-DOWNS): it keeps the key's padding and print ink and carries no
// field.
let fk_key_face = fn(w) {
    w.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 5.0}
    w.draw_text.color = #1d1d1d
    w.draw_text.color_hover = #111111
    w.draw_text.color_down = #1d1d1d
    w.draw_text.color_focus = #1d1d1d
    w.draw_text.color_disabled = #a9a7a4
    w.cap_field_reach = 0.0
}
fk_key_face(mod.widgets.Select.face)
fk_key_face(mod.widgets.MultiSelect.face)

// ---------------------------------------------------------------------------
// ENGRAVED PRINT. A label printed on the case carries one device pixel of
// light under each glyph, read from the glyph one pixel above: one more
// sample and nothing else. One literal per template.
mod.widgets.Label.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var s = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.sdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.msdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    let e = s * 0.6 * c.a * (1.0 - step(0.35, Finish.lum(c.rgb)))
    return main + vec4(e, e, e, e) * (1.0 - main.a)
}
// The small heading (a card's title) is engraved like the labels; it was
// built from Label before this sheet ran, so it takes its own literal.
mod.widgets.H4.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var s = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.sdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.msdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    let e = s * 0.6 * c.a * (1.0 - step(0.45, Finish.lum(c.rgb)))
    return main + vec4(e, e, e, e) * (1.0 - main.a)
}
