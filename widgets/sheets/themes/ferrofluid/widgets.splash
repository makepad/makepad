// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point key with a short skirt, three points in from the
// row so its focus ring has room. Set: a flat orange square on the face, an
// indicator rather than a tick; mixed: an orange bar. Error: a red rim.
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 23.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(14.0)
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.align.y = 0.5
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let x0 = mix(3.0, self.rect_size.x - sz - 3.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let h = (hi - lo) * 0.5
    let c = lo + h
    // the round box keeps its round key
    let r = mix(2.0, h.y, step(20.0, self.border_radius))
    let d = fk_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let press = self.down * live
    var out = fk_shade(p, c, h, r, px, 1.0 - press, self.disabled, mix(0.13, 0.19, self.hover * live))
    out = Finish.over(out, fk_cap(p, lo, hi, r, px, 2.0 * px, 0.0, self.hover * live, press, self.disabled, 0.06))
    // the indicator: a 6 point square of orange, its rim a shade deeper
    let fy = press * px - px
    let mc = c + vec2(0.0, fy)
    let sq = fk_rbox(p, mc, vec2(3.0, 3.0), mix(0.5, 3.0, step(20.0, self.border_radius)))
    let bar = fk_rbox(p, mc, vec2(3.5, 1.0), 0.5)
    let show = self.active * (1.0 - self.mixed)
    let md = mix(mix(1000.0, sq, show), bar, self.mixed)
    let lit = mix(vec3(0.933, 0.353, 0.141), vec3(0.83, 0.78, 0.76), self.disabled)
    var mk = mix(lit, lit * 0.85, Finish.band(md, 0.0, px, px))
    let ma = Finish.cover(md, px)
    out = Finish.over(out, vec4(mk * ma, ma))
    // error: the rim of the key turns red
    let er = Finish.band(d, 0.0, px, px) * self.error
    out = Finish.over(out, vec4(0.706 * er, 0.137 * er, 0.094 * er, er))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// RADIOS. A lamp in a collar: the collar a pale dish with a light line on
// its lower inner edge, the lens a flat grey dot off and flat LED orange
// on, its rim a shade deeper. Lit, never glowing.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 23.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(14.0)
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.align.y = 0.5
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 3.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let rad = Finish.snap(sz, px) * 0.5
    let c = lo + vec2(rad, rad)
    let live = 1.0 - self.disabled
    let q = p - c
    let d = length(q) - rad
    // the collar: a shallow dish, shaded under its top, lit on its lower lip
    let v = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var collar = mix(vec3(0.800, 0.800, 0.800), vec3(0.867, 0.867, 0.867), smoothstep(0.1, 0.7, v))
    collar = collar + g3(0.03 * self.hover * live)
    collar = mix(collar, vec3(0.90, 0.894, 0.886), self.disabled * 0.6)
    let low = smoothstep(-0.2, 0.3, q.y / rad)
    collar = mix(collar, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * low * 0.9 * live)
    collar = mix(collar, vec3(0.62, 0.62, 0.62), Finish.band(d, 0.0, px, px) * (1.0 - low) * 0.6)
    let a = Finish.cover(d, px)
    var out = fk_catch(p, c, vec2(rad, rad), rad, px, 0.6)
    out = Finish.over(out, vec4(collar * a, a))
    // the lens, 8 points
    let lr = 4.0
    let ld = length(q) - lr
    let off = vec3(0.478, 0.475, 0.467)
    let lit = vec3(0.992, 0.518, 0.196)
    var lens = mix(off, lit, self.active)
    // hovered, the lens itself brightens (off #8c8b89), not only its collar
    lens = lens + g3(0.07 * self.hover * live * (1.0 - self.down))
    lens = lens - g3(0.08 * self.down * live)
    lens = mix(lens, vec3(0.80, 0.792, 0.780), self.disabled * 0.7)
    lens = mix(lens, lens * 0.84, Finish.band(ld, 0.0, px, px))
    let la = Finish.cover(ld, px)
    out = Finish.over(out, vec4(lens * la, la))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}

// Radio tabs: keys in a row; the chosen one is latched in, its legend in
// the deep signal orange.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 5.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.min_height = 24.0
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 2.0
    let d = fk_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let press = max(self.active, self.down) * live
    var out = fk_shade(p, c, h, r, px, 1.0 - press, self.disabled, mix(0.13, 0.19, self.hover * live))
    out = Finish.over(out, fk_cap(p, lo, hi, r, px, 3.0 * px, 0.0, self.hover * live, press, self.disabled, 0.0))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #1d1d1d
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #b53c0b
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #a9a7a4

// ---------------------------------------------------------------------------
// TEXT FIELDS. A white well cut into the case: a grey hairline mouth, one
// pixel of shade under its top edge, the light catch on the last row of the
// box. Focus: the mouth turns signal orange with a second orange row inside
// it, drawn in the box so an inner field needs no room outside itself.
// The well fills its whole box; the light catch lies one device row BELOW
// it, outside, so a field whose quad is grown down (see `fk_field_vertex`)
// shows it and one that is not simply has none.
let fk_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    // the side rims land on whole pixels INSIDE the box: a rim rounded out
    // past it is cut by the field's own clip
    let lo = vec2(ceil(o.x / px - 0.001) * px, Finish.snap(o.y, px)) - o
    let hi = vec2(floor((o.x + size.x) / px + 0.001) * px, Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = fk_rbox(p, c, h, r)
    var col = mix(vec3(0.992, 0.992, 0.988), vec3(1.0, 1.0, 1.0), hover)
    col = mix(col, vec3(0.945, 0.941, 0.933), dis)
    // cut in: two rows of shade under the top rim, 16 % then 7 %
    let yt = p.y - lo.y
    let sh = fk_run(yt, px, 2.0 * px) * 0.16 + fk_run(yt, 2.0 * px, 3.0 * px) * 0.07
    col = mix(col, vec3(0.0, 0.0, 0.0), sh * mix(1.0, 0.4, dis))
    // the rim: the top edge dark (0.49), the sides and foot the pale edge
    // #a3a2a1, so the field reads as a recess lit from above
    let upper = 1.0 - smoothstep(lo.y + r, lo.y + r + px, p.y)
    let top_rim = mix(vec3(0.49, 0.486, 0.478), vec3(0.40, 0.396, 0.388), hover)
    let low_rim = mix(vec3(0.639, 0.635, 0.631), vec3(0.58, 0.576, 0.57), hover)
    var rim = mix(low_rim, top_rim, max(upper, fk_run(yt, 0.0, px)))
    rim = mix(rim, vec3(0.76, 0.755, 0.745), dis)
    col = mix(col, rim, Finish.band(d, 0.0, px, px))
    let orange = vec3(0.933, 0.353, 0.141)
    col = mix(col, orange, Finish.band(d, 0.0, px, px) * focus)
    col = mix(col, orange, Finish.band(d, px, 2.0 * px, px) * focus * 0.45)
    let a = Finish.cover(d, px)
    // the catch: one row of #fcfbf9 under the foot, outside the box
    let cl = fk_run(p.y, hi.y, hi.y + px) * step(abs(p.x - c.x), h.x - r) * 0.92
    let out = vec4(0.988 * cl, 0.984 * cl, 0.976 * cl, cl)
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
// The field's quad reaches 2 points below its box for the catch; the
// field stops clipping downward only (its text still clips at its sides).
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size + vec2(0.0, 2.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_field(self.pos * (self.rect_size + vec2(0.0, 2.0)), self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 1.5)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #72716f
mod.widgets.TextInputFlat.draw_text.color_disabled = #a9a7a4
mod.widgets.TextInputFlat.draw_cursor.color = #ee5a24

mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size + vec2(0.0, 2.0))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_field(self.pos * (self.rect_size + vec2(0.0, 2.0)), self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 1.5)
}
// The toolbar number: a small white well, the value's share a faint orange
// wash behind the digits, print ink.
mod.widgets.ValueInput.arrow_color = #5c5b59
mod.widgets.ValueInput.draw_text.color = #1d1d1d
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = fk_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 1.5)
    if self.fill >= 0.0 {
        let w = (self.rect_size.x - 2.0) * self.fill
        let f = fk_run(p.x, 1.0, 1.0 + w) * fk_run(p.y, 2.0 * px, self.rect_size.y - 2.0 * px) * 0.14
        out = Finish.over(out, vec4(0.933 * f, 0.353 * f, 0.141 * f, f))
    }
    return out
}

// The stepper: two small white keys stacked in the field's end, split by a
// seam; each half lights or presses on its own.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(px, px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(px, 2.0 * px)
    let live = 1.0 - self.disabled
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot_u = max(0.0, self.hot) * live
    let hot_d = max(0.0, -self.hot) * live
    let dn_u = max(0.0, self.down) * live
    let dn_d = max(0.0, -self.down) * live
    // each half the main key in small: the 3 pixel skirt, the white top line
    var out = Finish.over(vec4(0.0, 0.0, 0.0, 0.0), fk_cap(p, lo, vec2(hi.x, mid - px), 1.0, px, 3.0 * px, 0.0, hot_u, dn_u, self.disabled, 0.08) * upper)
    out = Finish.over(out, fk_cap(p, vec2(lo.x, mid + px), hi, 1.0, px, 3.0 * px, 0.0, hot_d, dn_d, self.disabled, 0.08) * (1.0 - upper))
    // the seam between them
    let seam = fk_run(p.y, mid - px, mid + px) * step(lo.x, p.x) * step(p.x, hi.x) * 0.45
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, seam))
    // the legends, plus above and minus below, 1.5 pixel strokes on the
    // pixel grid, centred on each face (the face sits above its skirt and
    // travels one pixel when pressed)
    let cx = Finish.snap(o.x + (lo.x + hi.x) * 0.5, px) - o.x
    let cu = Finish.snap(o.y + (lo.y + mid - px - 3.0 * px) * 0.5, px) - o.y + dn_u * px
    let cd = Finish.snap(o.y + (mid + px + hi.y - 3.0 * px) * 0.5, px) - o.y + dn_d * px
    let arm = 2.25
    let sw = 0.75 * px
    let hbar_u = step(abs(p.x - cx), arm) * step(abs(p.y - cu), sw)
    let vbar_u = step(abs(p.y - cu), arm) * step(abs(p.x - cx), sw)
    let hbar_d = step(abs(p.x - cx), arm) * step(abs(p.y - cd), sw)
    let g = max(max(hbar_u, vbar_u) * upper, hbar_d * (1.0 - upper))
    let gink = mix(vec3(0.114, 0.114, 0.114), vec3(0.663, 0.655, 0.643), self.disabled)
    out = Finish.over(out, vec4(gink * g, g))
    return out
}
// The stock triangles give way to the drawn plus and minus.
mod.widgets.NumberSpin.draw_text.color = #1d1d1d00
mod.widgets.NumberSpin.draw_text.color_disabled = #a9a7a400

// ---------------------------------------------------------------------------
// SLIDERS. A 3 point dark track with a light catch under it, the orange
// fill in it up to the handle, hairline ticks printed above at a 6 point
// pitch, and for the handle the faders' ferrofluid drop made small: a round
// drop of black liquid 12 points across and 5 tall, lying on the track. It
// moves as the faders' drop moves, dragged, pressed or sent to a value that
// jumps, and when the pointer comes near it raises its spikes on the same
// lattice, marched and lit by the same material: THE FERROFLUID and FADERS
// below hold the drop, the faces here only place it. Each face grows its
// quad for the drop's spikes and cast shadow; the knobs, built on the same
// slider, keep the 6 points they had and carry no drop.
//
// The drop is the widget's cap. Its centre runs where the old handle's ran,
// 5 points in from the box's ends on the minimal face and 6 on the flat and
// round ones, so the longer drop hangs past the ends of its travel: a
// negative inset. The drag divides by that travel, so the drop keeps to the
// finger. It moves at the faders' viscosity. The pointer's field, as on the
// faders: up while the pointer is within this much plus the drop's length
// of its centre, and only on the control nearest the pointer, two while it
// passes from one to the next (the widget library keeps that count).
mod.widgets.SliderMinimal.cap_size = 12.0
mod.widgets.SliderMinimal.track_inset = -2.0
mod.widgets.SliderMinimal.cap_viscosity = 0.5
mod.widgets.SliderMinimal.cap_field_reach = 16.0
mod.widgets.SliderFlat.cap_size = 12.0
mod.widgets.SliderFlat.track_inset = -1.0
mod.widgets.SliderFlat.cap_viscosity = 0.5
mod.widgets.SliderFlat.cap_field_reach = 16.0
mod.widgets.SliderRoundFlat.cap_size = 12.0
mod.widgets.SliderRoundFlat.track_inset = -1.0
mod.widgets.SliderRoundFlat.cap_viscosity = 0.5
mod.widgets.SliderRoundFlat.cap_field_reach = 16.0
// The knobs are built on the minimal slider and draw no fader's drop: they
// take back no field and the 6 points of room every face had. They keep
// the motion, for the drop in their glass: a nominal cap of 40 points, whose
// stretch runs from 0 at rest to 1 as the value's spring trails it by 1.69
// of its radius (33.8 points), so it reads how fast the knob turns; a
// viscosity of 0.9 settles it in about half a second; the inset of -20
// keeps the drag's travel the whole box.
mod.widgets.RotaryFlat.cap_size = 40.0
mod.widgets.RotaryFlat.track_inset = -20.0
mod.widgets.RotaryFlat.cap_viscosity = 0.9
mod.widgets.RotaryFlat.cap_field_reach = 0.0
mod.widgets.RotaryKnob.cap_size = 40.0
mod.widgets.RotaryKnob.track_inset = -20.0
mod.widgets.RotaryKnob.cap_viscosity = 0.9
mod.widgets.RotaryKnob.cap_field_reach = 0.0
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false

// The drop's material and its field's effect, on each face so each tunes
// live on its own: the faders' numbers (FADERS says what each one does),
// the lengths the bench's proportions on this 12 point drop (the height 5,
// the reach 20, the shadow's blur 4), the slide share 12 of the bench's 55
// point view. The spikes keep the fader's size in points, not the drop's
// share of it: the fader's spacing of 3.4 and its base, and nine tenths of
// its length (17.25 points: 1.5 of this drop's heights and 9.75 points,
// where the fader's 1.5 and 6.67 make 19.2 on its 8.33), so this smaller
// drop, less liquid with less room, raises fewer of them. The inks:
// the case; the drop's near black, as ferrofluid is, and the sheet's
// disabled key when disabled, under names of their own because the stock
// slider restates its handle's colours from the theme; the material's
// white light and the bench's grey shade.
