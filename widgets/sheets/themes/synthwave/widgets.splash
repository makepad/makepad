// ---------------------------------------------------------------------------
// MORE LIGHT HELPERS.

// Distance to an arc of radius r about the centre, from angle a0 to a1,
// angles measured from straight down and turning clockwise, with round
// ends. q is the point relative to the centre.
let n_arc = fn(q: vec2, r: float, a0: float, a1: float) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let ring = abs(length(q) - r)
    let e0 = vec2(0.0 - sin(a0), cos(a0)) * r
    let e1 = vec2(0.0 - sin(a1), cos(a1)) * r
    let ends = min(length(q - e0), length(q - e1))
    return mix(ends, ring, step(a0, a) * step(a, a1))
}

// A disc of smoked glass ringed by a tube: a slider's handle. `wash`
// floods the glass with the hue. Premultiplied.
let n_disc = fn(p: vec2, c: vec2, r: float, px: float, hue: vec3, wash: float, lit: float, hot: float, tight: float, wide: float) -> vec4 {
    let d = length(p - c) - r
    let yn = clamp((p.y - c.y + r) / (2.0 * r), 0.0, 1.0)
    return n_tube(d, px, vec4(mix(n_glass(yn), hue, wash), 1.0), hue, lit, hot, tight, wide, 3.0)
}

// A slot of unlit glass: dark violet glass rimmed by a light-line of `hue`
// one device pixel wide that throws a faint glow, and down its middle,
// `hh` points in from the rim, the unlit travel, a thin dim light-line of
// the same hue. The value's tube is laid over it. Premultiplied.
let n_slot = fn(d: float, px: float, hue: vec3, lit: float, hh: float) -> vec4 {
    let a = Finish.cover(d, px)
    var col = vec3(0.028, 0.017, 0.072)
    let k = (d + hh) / px
    col = col + hue * 0.42 * lit * exp(-1.2 * k * k)
    col = mix(col, hue * 0.80 * lit, Finish.band(d, 0.0, px, px))
    let g = n_halo(d, 0.30, 0.10) * lit * (1.0 - a)
    return vec4(col * a, a) + vec4(hue * g, g * 0.15)
}

// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point box in a cyan tube round a dark well; on, the
// well takes the hue at 20 %, the tube burns white-hot with a brighter halo
// and the tick is a white stroke on a dark edge, three device pixels wide
// like every line on the sheet. Mixed is a short bar, error
// turns red.
let n_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, r: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, min(r, sz * 0.5))
    let hue = mix(n_cyan(), n_red(), err)
    let live = 1.0 - disabled
    let on = max(active, mixed)
    let dn = min(down * 4.0, 1.0)
    // Rest burns at 75 % round a dim core; the pointer lights the well,
    // burns the tube white-hot and throws the halo wide.
    let warm = max(max(on, dn), max(hover, focus * 0.7))
    let lit = mix(0.75, 1.0, warm)
    let well = mix(vec3(0.014, 0.010, 0.040), hue, (0.20 * active + 0.12 * mixed + 0.22 * hover + 0.30 * dn) * live)
    let face = mix(vec4(well, 1.0), vec4(0.020, 0.016, 0.045, 1.0), disabled)
    let tight = (0.50 + 0.40 * hover + 0.30 * on + 0.35 * dn) * live + 0.10 * disabled
    let wide = (0.34 + 0.36 * hover + 0.30 * on + 0.40 * dn) * live + 0.04 * disabled
    var f = n_tube(d, px, face, mix(hue, n_dead(), disabled), mix(lit, 0.8, disabled), mix(0.5, 1.0, warm) * live + 0.22 * disabled, tight, wide, 3.0)
    f = Finish.over(f, n_ring(d, px, 3.0, hue, focus * live))
    // The tick, then the mixed bar: white, edged in the well's dark so it
    // stands off the lit glass.
    let q = (p - lo) / sz
    let tick = min(n_seg(q, vec2(0.25, 0.52), vec2(0.43, 0.70)), n_seg(q, vec2(0.43, 0.70), vec2(0.76, 0.31))) * sz
    let by = n_mid(o.y + c.y, px) - o.y
    let bar = n_seg(p, vec2(c.x - 3.0, by), vec2(c.x + 3.0, by))
    let mark = mix(tick, bar, mixed)
    let shown = max(active, mixed)
    f = mix(f, vec4(0.010, 0.008, 0.030, 1.0), Finish.cover(mark - 1.5 * px - 0.85, px) * shown * live)
    let ink = mix(vec3(1.0, 1.0, 1.0), n_dead(), disabled)
    return n_stroke(f, mark, 1.5 * px, px, ink, shown, live, 0.2 * live, 0.0)
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(14.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(2.5)
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    return n_check(p, self.rect_pos, self.rect_size, px, self.size, self.border_radius, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}

// RADIOS. A 14 point ring tube; on, the ring burns white-hot and a 6.5
// point lamp lights at its centre. The ring's centre is a pixel corner and
// its radius a whole number of device pixels, so the tube lies on three
// whole pixels across, its core on the middle one.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(14.0)
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let r = Finish.snap(self.size * 0.5, px)
    let c = vec2(Finish.snap(o.x + r, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    let d = length(p - c) - r
    let hue = n_cyan()
    let live = 1.0 - self.disabled
    let dn = min(self.down * 4.0, 1.0)
    let warm = max(max(self.active, dn), max(self.hover, self.focus * 0.7))
    let lit = mix(0.75, 1.0, warm)
    let face = mix(vec4(mix(vec3(0.014, 0.010, 0.040), hue, (0.22 * self.hover + 0.12 * self.active + 0.32 * dn) * live), 1.0), vec4(0.020, 0.016, 0.045, 1.0), self.disabled)
    let tight = (0.50 + 0.40 * self.hover + 0.30 * self.active + 0.35 * dn) * live + 0.10 * self.disabled
    let wide = (0.34 + 0.36 * self.hover + 0.30 * self.active + 0.40 * dn) * live + 0.04 * self.disabled
    var f = n_tube(d, px, face, mix(hue, n_dead(), self.disabled), mix(lit, 0.8, self.disabled), mix(0.5, 1.0, warm) * live + 0.22 * self.disabled, tight, wide, 3.0)
    f = Finish.over(f, n_ring(d, px, 3.0, hue, self.focus * live))
    return n_lamp(f, p, c, 3.25, px, mix(hue, n_dead(), self.disabled), self.active)
}

// TOGGLES. A capsule 26 by 12 in a tube: off, the tube burns at 80 % with
// its core and a dim dot waits at the left; on, the capsule fills with the
// hue, the tube burns white-hot with its halo and the dot is a lamp at the
// right. An error turns the tube red.
let n_switch = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: vec2, at_end: float, t: float, hover: float, down: float, focus: float, active: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz.x) * at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + rs.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let d = Finish.sd_pill(p, c, (hi - lo) * 0.5)
    let hue = mix(n_cyan(), n_red(), err)
    let live = 1.0 - disabled
    let dn = min(down * 4.0, 1.0)
    let warm = max(max(active, dn), max(hover, focus * 0.7))
    let lit = mix(0.72, 1.0, warm)
    let well = mix(vec3(0.012, 0.008, 0.035), hue, (0.22 * active + 0.22 * hover + 0.28 * dn) * live)
    let face = mix(vec4(well, 1.0), vec4(0.020, 0.016, 0.045, 1.0), disabled)
    let tight = (0.45 + 0.40 * hover + 0.32 * active + 0.35 * dn) * live + 0.10 * disabled
    let wide = (0.30 + 0.36 * hover + 0.32 * active + 0.40 * dn) * live + 0.04 * disabled
    var f = n_tube(d, px, face, mix(hue, n_dead(), disabled), mix(lit, 0.8, disabled), mix(0.45, 1.0, warm) * live + 0.22 * disabled, tight, wide, 3.0)
    f = Finish.over(f, n_ring(d, px, 3.0, hue, focus * live))
    let kr = sz.y * 0.5 - 3.0
    let kc = vec2(mix(lo.x + sz.y * 0.5, hi.x - sz.y * 0.5, t), c.y)
    let dot = mix(hue * 0.45, n_dead(), disabled)
    f = mix(f, vec4(dot, 1.0), Finish.cover(length(p - kc) - kr * 0.8, px) * (1.0 - active * live))
    return n_lamp(f, p, kc, kr, px, hue, active * live)
}
