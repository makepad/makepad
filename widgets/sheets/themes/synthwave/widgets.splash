use mod.prelude.widgets_internal.*

// A grid world at night, and controls drawn in light on it.
// The window's ground is the world itself: an indigo sky with a few stars,
// a striped sun going down behind low wireframe mountains, and a magenta
// grid floor running out to a white-hot horizon. Every control on it is
// dark smoked glass outlined by a neon tube three device pixels wide in
// all, one white-hot pixel between two of its colour, and every tube throws
// a soft halo that starts well under the tube's own light, so a line reads
// as wide as it is drawn. At rest the tubes burn at 85 % round a white-hot
// core and glow a little past the box; hover warms them, a press floods the
// glass with the hue and flashes the halo wide, a focus draws a second,
// finer ring outside the first, and a disabled control is a dead grey tube
// that throws no light.
// The buttons are the exception: pills of coloured light after his
// reference, drawn under BUTTONS.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = uniform(1000.0)
mod.widgets.Button.draw_bg.border_size = uniform(0.5)
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 3.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #08051a

// Light leaves the layout box: plain views stop clipping so a glow can
// fall into the gap beside a control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// THE LIGHT. Every function takes distances in points, negative inside.

// The hues. Cyan is the accent, hot magenta the second voice and the voice
// of input, violet the tonal one, red the danger; a tube that is switched
// off is unlit violet glass.
let n_cyan = fn() -> vec3 { return vec3(0.18, 0.86, 1.0) }
let n_magenta = fn() -> vec3 { return vec3(1.0, 0.22, 0.76) }
let n_violet = fn() -> vec3 { return vec3(0.64, 0.40, 1.0) }
let n_red = fn() -> vec3 { return vec3(1.0, 0.17, 0.32) }
let n_dead = fn() -> vec3 { return vec3(0.27, 0.21, 0.44) }

// The grown quad of a lit control: its box widened by m on every side (18
// points for every control here, the room its halo needs), and
// the clip it is drawn under widened by m on each side where that clip does
// not cut into the control (a scroll view's edge beside it, a group or a
// screen that clips to the control's own box), so the halo falls past it;
// where the clip cuts more than a point into the control it stays cut. Returns the
// clipped point (x, y) and the grown box's origin (z, w).
let n_grow = fn(rp: vec2, rs: vec2, gp: vec2, clip: vec4, shift: vec2, view_clip: vec4, m: float) -> vec4 {
    let o = rp - vec2(m, m)
    let own_lo = step(clip.xy, rp + vec2(1.0, 1.0))
    let own_hi = step(rp + rs - vec2(1.0, 1.0), clip.zw)
    let p = clamp(gp * (rs + vec2(2.0 * m, 2.0 * m)) + o, clip.xy - own_lo * m, clip.zw + own_hi * m)
    return vec4(clamp(p + shift, view_clip.xy, view_clip.zw), o)
}

// The halo of a lit edge, x points out from it: a slim bloom, a gaussian
// of sigma 0.7 points, and a soft glow, a gaussian of sigma 2.7 points over
// a short exponential tail of 5 points, gone 13 points out. The sum runs
// into a soft ceiling at about a third of the hue's light, so a hotter
// state (a press, the hero) throws its glow wider and not brighter beside
// the tube. Both start well under the light of the tube they surround:
// the pixel beside a tube takes about a third of the light of the tube's
// sides at rest and under half while pressed, so the tube reads as the
// three pixels it is and the glow as a glow round it. The whole sheet's
// glow is set here: the bloom by n_glow_tight, the glow and its tail by
// n_glow_wide; the cores and the tubes themselves stay as bright.
let n_glow_tight = fn() -> float { return 0.85 }
let n_glow_wide = fn() -> float { return 0.65 }
let n_halo = fn(x: float, tight: float, wide: float) -> float {
    let t = max(x, 0.0)
    let far = 1.0 - smoothstep(9.0, 13.0, t)
    let g = tight * n_glow_tight() * 0.10 * exp(0.0 - t * t) + wide * n_glow_wide() * 0.85 * (0.30 * exp(-0.07 * t * t) + 0.70 * exp(0.0 - t / 5.0)) * far
    return g / sqrt(1.0 + g * g * 8.0)
}

// A value moved to the middle of the device pixel it falls in: a line of
// an odd number of pixels centred there lies on whole pixels, its core on
// one, and an edge half an odd number of pixels from it falls between two.
let n_mid = fn(v: float, px: float) -> float {
    return (floor(v / max(px, 0.0001)) + 0.5) * px
}

// A neon tube on the edge of the shape d, `w` device pixels wide and lying
// just inside the edge: a body of the hue at `lit`, a core one device pixel
// wide down its middle running to white by `hot`, the glass inside (`face`,
// premultiplied) lit by the tube on the one pixel row along its rim and
// faintly all over, and outside the halo. Every tube on the sheet is 3 wide: with
// its edge on a pixel boundary (every box here is snapped) the body lies on
// three whole pixels and the core on the middle one. Returns premultiplied.
let n_tube = fn(d: float, px: float, face: vec4, hue: vec3, lit: float, hot: float, tight: float, wide: float, w: float) -> vec4 {
    let inside = Finish.cover(d, px)
    let hw = w * 0.5 * px
    let s = abs(d + hw)
    let body = Finish.cover(s - hw, px) * min(lit * 4.0, 1.0)
    let core = Finish.cover(s - 0.5 * px, px) * hot
    let xi = max(0.0 - d - w * px, 0.0) / px
    let spill = hue * ((0.20 * tight + 0.18 * wide) * exp(-4.0 * xi * xi) + 0.03 * wide) * face.a * 0.8
    let base = vec4(face.rgb + spill, face.a) * inside
    let tc = mix(hue * lit, vec3(1.0, 1.0, 1.0) * min(0.5 + 0.6 * lit, 1.0), core)
    let o = mix(base, vec4(tc, 1.0), body)
    let g = n_halo(d, tight, wide) * (1.0 - inside)
    return o + vec4(hue * g, g * 0.15) * (1.0 - o.a)
}

// The focus ring: a fine line one device pixel wide of the hue about `gap`
// points outside the edge, paler than the tube, with a slim halo of its
// own. The gap is taken in whole pixels, so outside a snapped edge the line
// lies on one pixel row. Premultiplied.
let n_ring = fn(d: float, px: float, gap: float, hue: vec3, a: float) -> vec4 {
    let s = abs(d - Finish.snap(gap, px) - 0.5 * px)
    let line = Finish.cover(s - 0.5 * px, px) * a
    let g = n_halo(s - 0.5 * px, 0.45, 0.12) * a
    let col = mix(hue, vec3(1.0, 1.0, 1.0), 0.45)
    return vec4(col * line, line) + vec4(hue * g, g * 0.15) * (1.0 - line)
}

// Distance to a segment.
let n_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.000001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A lit stroke of distance s (to its centre line) and half width w, laid
// over `under`: a body of the hue, a white-hot centre one device pixel wide
// by `hot`, the halo. A line of light is drawn with w = 1.5 * px, three
// device pixels in all; on a straight line centred on a pixel's middle
// (n_mid) the body takes three whole pixels and the core the middle one.
let n_stroke = fn(under: vec4, s: float, w: float, px: float, hue: vec3, lit: float, hot: float, tight: float, wide: float) -> vec4 {
    let body = Finish.cover(s - w, px) * lit
    let core = Finish.cover(s - 0.5 * px, px) * hot
    let g = n_halo(s - w, tight, wide) * lit
    var o = Finish.over(under, vec4(hue * g, g * 0.15))
    o = mix(o, vec4(hue, 1.0), body)
    return mix(o, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.8), 1.0), core * body)
}

// A lamp: a dot white at its centre and the hue at its rim, with its halo.
let n_lamp = fn(under: vec4, p: vec2, c: vec2, r: float, px: float, hue: vec3, lit: float) -> vec4 {
    let d = length(p - c) - r
    let k = clamp(length(p - c) / max(r, 0.5), 0.0, 1.0)
    let col = mix(vec3(1.0, 1.0, 1.0), hue, smoothstep(0.15, 1.0, k))
    let g = n_halo(d, 0.6, 0.35) * lit
    let o = Finish.over(under, vec4(hue * g, g * 0.15))
    return mix(o, vec4(col, 1.0), Finish.cover(d, px) * lit)
}

// Rounded box with a corner per quadrant: (tl, tr, br, bl).
let n_box = fn(p: vec2, c: vec2, h: vec2, rr: vec4) -> float {
    let q = p - c
    var r = rr.x
    if q.x > 0.0 {
        r = rr.y
        if q.y > 0.0 {
            r = rr.z
        }
    } else {
        if q.y > 0.0 {
            r = rr.w
        }
    }
    return Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
}

// The smoked glass of a control: near-black violet, a little lighter at
// its foot. Not premultiplied.
let n_glass = fn(yn: float) -> vec3 {
    return mix(vec3(0.022, 0.014, 0.060), vec3(0.046, 0.030, 0.115), yn)
}

// The wait spinner a replaced face draws itself: a comet turning once a
// second on a ring where the label was, laid over the face. The ring's
// centre is a pixel corner and its radius ends in the middle of a pixel, so
// its line lies on whole pixels, its core on one.
let n_wait = fn(under: vec4, p: vec2, o: vec2, size: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px), Finish.snap(o.y + size.y * 0.5, px)) - o
    let r = n_mid(max(min(size.x, size.y) * 0.5 - 6.0, 3.0), px)
    let q = p - c
    let ring = abs(length(q) - r)
    let a = fract(atan2(q.y, q.x) / 6.2831853 - t)
    let head = a * a
    return n_stroke(under, ring, 1.5 * px, px, n_cyan(), head * loading, head * loading, 0.4, 0.2)
}

// One button: the box snapped to device pixels, smoked glass, the tube at
// its state's heat. `flood` washes the hue into the glass at rest (a filled
// button), `tube` shows the tube at rest (0 on the flattest face), `body`
// shows the glass (0 on an outline), `hero` lights the tube fully at rest
// and gives it the widest bloom. Premultiplied.
let n_button = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, hue: vec3, hover: float, down: float, focus: float, disabled: float, flood: float, tube: float, body: float, hero: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = n_box(p, c, (hi - lo) * 0.5, rr)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    // A press is a flash: it reaches full light at a quarter of the way in.
    let dn = min(down * 4.0, 1.0)
    let warm = max(max(dn, hero), max(hover, focus) * 0.7)
    // Rest 85 % with a white-hot core, hover and focus 96 %, held and the
    // hero 100 %.
    let lit = mix(0.85, 1.0, warm)
    let shown = max(tube, max(max(hover, dn), max(focus, hero)))
    // The glass: the hue washed in under the pointer, flooded evenly while
    // held.
    let wash = (0.12 * hover + 0.42 * dn + flood * mix(0.16, 0.26, yn) + hero * mix(0.10, 0.16, yn)) * live
    let fa = max(body * 0.9, min(wash * 3.0, 0.9))
    var face = vec4(mix(n_glass(yn), hue, wash) * fa, fa)
    face = mix(face, vec4(vec3(0.020, 0.016, 0.045) * 0.9 * body, 0.9 * body), disabled)
    // A switched-off control is an unlit tube: violet glass with a faint
    // core and the least of a glow.
    let tight = (0.60 + 0.30 * hover + 0.45 * dn + 0.25 * hero) * live * shown + 0.10 * disabled
    let wide = (0.40 + 0.22 * hover + 0.50 * dn + 0.25 * hero + 0.06 * flood) * live * shown + 0.04 * disabled
    let h2 = mix(hue, n_dead(), disabled)
    let l2 = mix(lit * shown, 0.8, disabled)
    let hot = mix(0.85, 1.0, warm) * shown * live + 0.22 * disabled
    let f = n_tube(d, px, face, h2, l2, hot, tight, wide, 3.0)
    return Finish.over(f, n_ring(d, px, 3.5, hue, focus * live))
}

// ---------------------------------------------------------------------------
// BUTTONS. Pills of coloured light, after his reference: on near-black glass
// a fill running left to right through three hues at 0.8 (all of it under
// the pointer), a white highlight at the middle of the head and of the foot
// laid on in overlay, a white hairline one device pixel inside the edge over
// a white glow that soaks in from the rim, a fainter white hairline one
// device pixel outside it, and round it all a purple bloom. The reference is
// 56 points high; its soak and its bloom are taken at the button's height
// over 56. The bloom is light past the box: the quad grows by `glow_room`,
// the button stops clipping, and the bloom fades out before the quad's edge.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.icon_walk = Walk{width: 14.0, height: Fit}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(1000.0)
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(28.0)
mod.widgets.ButtonFlat.draw_bg.corners = fn() -> vec4 {
    let r = self.border_radius
    return vec4(
        mix(r, self.border_radius_tl, step(0.0, self.border_radius_tl)),
        mix(r, self.border_radius_tr, step(0.0, self.border_radius_tr)),
        mix(r, self.border_radius_br, step(0.0, self.border_radius_br)),
        mix(r, self.border_radius_bl, step(0.0, self.border_radius_bl))
    )
}
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, m)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(2.0 * m, 2.0 * m))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}

// The share of a gaussian of unit spread that lies below z, near enough (a
// logistic).
let n_phi = fn(z: float) -> float {
    return 1.0 / (1.0 + exp(-1.702 * z))
}

// White at `a` laid over `c` in overlay: each channel toward twice itself,
// capped at white.
let n_overlay = fn(c: vec3, a: float) -> vec3 {
    return c + (min(c * 2.0, vec3(1.0, 1.0, 1.0)) - c) * a
}

// Three hues left to right, the middle one half way.
let n_ramp3 = fn(t: float, c0: vec3, c1: vec3, c2: vec3) -> vec3 {
    let u = clamp(t, 0.0, 1.0) * 2.0
    return mix(mix(c0, c1, clamp(u, 0.0, 1.0)), c2, clamp(u - 1.0, 0.0, 1.0))
}

// The bloom of the pill lo..hi: the pill drawn `spread` points smaller all
// round (its round ends a fifth of their radius shorter, as a stadium is to
// its box) and blurred by a gaussian of `sigma` points, the blurred box
// taken as the product of its two blurred edges. Coverage, 0..1.
let n_bloom = fn(p: vec2, lo: vec2, hi: vec2, spread: float, sigma: float) -> float {
    let hy = max((hi.y - lo.y) * 0.5 - spread, 0.0)
    let a = lo + vec2(spread + 0.215 * hy, spread)
    let b = hi - vec2(spread + 0.215 * hy, spread)
    let sg = max(sigma, 0.001)
    let bx = n_phi((p.x - a.x) / sg) - n_phi((p.x - b.x) / sg)
    let by = n_phi((p.y - a.y) / sg) - n_phi((p.y - b.y) / sg)
    return max(bx, 0.0) * max(by, 0.0)
}

// How far in from the grown quad's edge, faded over its outer 45 %, so the
// bloom is gone before the quad ends.
let n_room_fade = fn(p: vec2, s: vec2, room: float) -> float {
    let e = min(min(p.x + room, s.x + room - p.x), min(p.y + room, s.y + room - p.y))
    return smoothstep(0.0, room * 0.45, e)
}

// One glowing pill. The box is snapped to device pixels, and under the
// pointer it grows a device pixel all round, standing in for the
// reference's 3 % lift. The glass is near-black under the hues c0, c1, c2
// at `fill` (all of it under the pointer, a sixth less while held); `fill`
// 0 leaves the glass out, the rim and the bloom alone. The two highlights
// are white at 0.2 falling to nothing half way to the box's far corner, as
// the reference's radial gradients do. `rim` 1 draws the white hairline
// inside the edge at 0.5 (0.7 under the pointer) over the soak, white at
// 0.5 blurred 7.5 reference points in from it (0.7 and 10 under the
// pointer), and, with the glass, the outer hairline, white at 0.2. The
// bloom is `glow` at `bloom`, the pill 12 reference points smaller blurred
// by 25, outside the box only; under the pointer it is blurred by 35 and a
// third stronger, so it reaches as far as the reference's lifted one, and
// held it is blurred by 20 and a fifth dimmer. Every edge is one device pixel of coverage. Disabled
// drains the hues to a dim grey violet, dims the rim and puts the bloom
// out. Premultiplied.
let n_pill = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, c0: vec3, c1: vec3, c2: vec3, glow: vec3, hover: float, down: float, focus: float, disabled: float, fill: float, rim: float, bloom: float, room: float) -> vec4 {
    let live = 1.0 - disabled
    let hov = hover * live
    let dn = down * live
    let grow = px * hov * (1.0 - dn)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o - vec2(grow, grow)
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o + vec2(grow, grow)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = n_box(p, c, h, rr + vec4(grow, grow, grow, grow))
    let k = s.y / 56.0
    let inside = Finish.cover(d, px)
    let glass = step(0.001, fill)
    // The fill over the glass.
    let hue = n_ramp3((p.x - lo.x) / max(hi.x - lo.x, 1.0), c0, c1, c2)
    let grey = mix(vec3(dot(hue, vec3(0.2126, 0.7152, 0.0722))), hue, 0.25)
    let fo = mix(fill, 1.0, hov) * (1.0 - 0.15 * dn)
    var col = mix(vec3(0.020, 0.012, 0.050), hue, fo)
    col = mix(col, mix(vec3(0.030, 0.026, 0.055), grey, 0.38), disabled)
    // The highlights, at the middle of the head and of the foot.
    let rad = 0.5 * sqrt(h.x * h.x + 4.0 * h.y * h.y)
    let ha = 0.2 * mix(1.0, 0.4, disabled)
    col = n_overlay(col, ha * max(1.0 - length(p - vec2(c.x, lo.y)) / rad, 0.0))
    col = n_overlay(col, ha * max(1.0 - length(p - vec2(c.x, hi.y)) / rad, 0.0))
    var face = vec4(col, 1.0) * glass
    // The soak: white blurred in from the hairline's inner edge, from the
    // near side and the far one.
    let si = max(mix(7.5, 10.0, hov) * k, px)
    let din = d + px
    let soak = mix(0.5, 0.7, hov) * mix(1.0, 0.3, disabled) * rim * min(n_phi(din / si) + n_phi((0.0 - 2.0 * (h.y - px) - din) / si), 1.0)
    face = Finish.over(face, vec4(soak, soak, soak, soak))
    // The hairline, one device pixel inside the edge. The reference's is a
    // point of its own 56, under a device pixel on a smaller pill, so the
    // pixel takes its share.
    let thin = clamp(k / px, 0.0, 1.0)
    let line = clamp(Finish.band(d, 0.0, px, px) / max(inside, 0.0001), 0.0, 1.0) * mix(0.5, 0.7, hov) * mix(1.0, 0.35, disabled) * rim * thin
    face = Finish.over(face, vec4(line, line, line, line)) * inside
    // The outer hairline, with the glass only.
    let ring = Finish.ring_out(d, 0.0, px, px) * mix(0.2, 0.28, hov) * mix(1.0, 0.5, disabled) * rim * glass * thin
    // The bloom, light past the box.
    let sb = min(mix(mix(25.0, 35.0, hov), 20.0, dn) * k, room * 0.55)
    let ga = n_bloom(p, lo, hi, 12.0 * k, sb) * bloom * mix(mix(1.0, 1.35, hov), 0.8, dn) * live * n_room_fade(p, s, room) * (1.0 - inside)
    let lit = Finish.over(vec4(glow * ga, ga * 0.3), vec4(ring, ring, ring, ring))
    return Finish.over(Finish.over(lit, face), n_ring(d, px, 3.5, glow, focus * live))
}

// The flat face: the words alone at rest. Under the pointer a faint bloom
// gathers round and under them, through the box, as there is no glass to
// stop it; held, it tightens.
let n_pill_flat = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, glow: vec3, hover: float, down: float, focus: float, disabled: float, bloom: float, room: float) -> vec4 {
    let live = 1.0 - disabled
    let dn = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let d = n_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, rr)
    let k = s.y / 56.0
    let sb = min(mix(25.0, 20.0, dn) * k, room * 0.55)
    let ga = n_bloom(p, lo, hi, 12.0 * k, sb) * bloom * hover * mix(1.0, 0.8, dn) * live * n_room_fade(p, s, room)
    return Finish.over(vec4(glow * ga, ga * 0.3), n_ring(d, px, 3.5, glow, focus * live))
}

// The hues. The reference's fill is indigo, purple and fuchsia (Tailwind's
// 600s) and its bloom a lighter purple (its 500).
let n_g_indigo = fn() -> vec3 { return vec3(0.310, 0.275, 0.898) }
let n_g_purple = fn() -> vec3 { return vec3(0.576, 0.200, 0.918) }
let n_g_fuchsia = fn() -> vec3 { return vec3(0.753, 0.149, 0.827) }
let n_g_bloom = fn() -> vec3 { return vec3(0.659, 0.333, 0.969) }

// The flat button: the words alone until the pointer comes.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_pill_flat(p, self.rect_pos, self.rect_size, px, self.corners(), n_g_bloom(), self.hover, self.down, self.focus, self.disabled, 0.45, m)
    return self.host_over(n_wait(f, p, self.rect_pos, self.rect_size, px, self.loading, self.anim_time), m)
}
// The standard button: the reference's pill, quieter. The fill at 0.55, so
