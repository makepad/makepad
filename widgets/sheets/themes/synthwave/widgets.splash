// Words on a glowing pill carry a soft dark drop shadow, as the reference's
// label does: the glyph's own field read three quarters of a point higher
// and twelve times softer than its edge, so the shadow lies just under each
// letter and fades over about two device pixels. The quad is grown as the
// label's is; past the ink's box the distance is taken to that box, and the
// shadow fades out inside the quad.
mod.widgets.Button.draw_text.ink_vertex = n_text_base
mod.widgets.Button.draw_text.vertex = mod.widgets.Label.draw_text.vertex
mod.widgets.Button.draw_text.pixel = fn() {
    let rs = max(self.rect_size, vec2(0.0001, 0.0001))
    let q = self.pos * rs
    let inq = step(0.0, q.x) * step(q.x, rs.x) * step(0.0, q.y) * step(q.y, rs.y)
    let main = self.sample_text_pixel() * inq
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    let up = vec2(0.0, 0.75 * (self.t_max.y - self.t_min.y) / rs.y)
    var w = 0.0
    var has = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let p = clamp(self.t.xy - up, self.t_min + half_texel, self.t_max - half_texel)
        w = self.sdf(scale * 12.0, p, vec4(0.5, 0.5, 0.5, 1.0))
        has = 1.0
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let p = clamp(self.t.xy - up, self.t_min + half_texel, self.t_max - half_texel)
        w = self.msdf(scale * 12.0, p, vec4(0.5, 0.5, 0.5, 1.0))
        has = 1.0
    }
    // Device pixels outside the shadow's glyph.
    let dpi = max(self.draw_pass.dpi_factor, 0.5)
    let m = 1.5 / dpi
    let hb = rs * 0.5
    let ob = max(abs(q - vec2(0.0, 0.75) - hb) - max(hb - vec2(m, m), vec2(0.0, 0.0)), vec2(0.0, 0.0)) * dpi
    let out = max(length(ob), (0.5 - w) * 12.0)
    let e = min(min(rs.x + 3.5 - q.x, q.y + 2.0), rs.y + 2.5 - q.y) * dpi
    let keep = smoothstep(0.0, 1.5, e) * smoothstep(0.0, 2.5, q.x * dpi) * has * c.a
    let sh = (1.0 - smoothstep(-1.5, 2.5, out)) * 0.38 * keep
    let shadow = vec4(vec3(0.020, 0.004, 0.050) * sh, sh)
    return main + shadow * (1.0 - main.a)
}
