// ---------------------------------------------------------------- lamps
// LAMPS: an LED drawn in light. Its light is added, never painted, screened
// over whatever is there.
let n_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let n_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let n_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = n_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The same LED where the sheet draws with light alone (a vector display, a
// phosphor screen, a neon tube): no glass and no bezel, only the emitter --
// a white-hot core at full current, its rim the most saturated colour, a
// tight halo in its hue gone in about two radii -- and, out, a dark lens
// rimmed by a faint line of the colour it would light. Premultiplied over
// `dst`.
let n_led_lamp_light = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let L = clamp(lit, 0.0, 1.0)
    let b = n_led_lamp_full(ink)
    let hue = n_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    var res = dst
    let x = max(d, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    if L > 0.001 {
        let halo = exp(-x / max(0.32 * rt, 0.45)) * 1.6 + exp(-x / max(0.7 * rt, 0.8)) * 0.35
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, x)
        res = n_led_lamp_add(res, mix(hue, white, 0.12 * pw) * halo * pw * hwin * win, ground)
    }
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    var on = mix(b, hue, 0.5) * (0.35 + 0.65 * L)
    on = mix(on, vec3(1.0, 0.99, 0.98), exp(-t * t / 0.22) * smoothstep(0.5, 1.0, L) * 0.9)
    on = mix(on, hue * (0.4 + 0.6 * L), smoothstep(0.6, 1.0, t))
    var off = mix(vec3(0.02, 0.02, 0.03), b * 0.2, 0.15)
    off = mix(off, hue * 0.45, Finish.band(d, 0.0, max(px * 1.2, 0.5), px))
    let col = mix(off, min(on, white), smoothstep(0.0, 0.3, L))
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// The Lamp widget and the bar lamp: the light above, a tube of light: no glass and no bezel, the light alone.
// The halo's room is held in the lamp's own box (the library reserves a
// lens thickness either side once a halo is asked for), so the light is
// never cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_success = uniform(#38ff9e)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#ffbc38)
mod.widgets.Lamp.draw_bg.color_error = uniform(#ff2c52)
mod.widgets.Lamp.draw_bg.color_plain = uniform(#e6e0ff)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    let half_len = max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5)
    // The lens is the lamp's size; its socket stands round it in the room.
    let hb = vec2(mix(t * 0.5, half_len, self.bar), t * 0.5)
    let res = n_led_lamp_light(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.035, 0.024, 0.098), max(room - 0.5, 2.0))
    return res * self.opacity
}
true
