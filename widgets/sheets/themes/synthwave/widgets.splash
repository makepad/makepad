// The rail under the strip: the tabs' violet light-line, three device
// pixels on the strip's last three rows with its white-violet core on the
// middle one, its glow rising into the strip. The tabs draw it again over
// their own feet.
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y - 1.5 * px
    let k = abs(p.y - y)
    let rail = Finish.cover(k - 0.5 * px, px)
    let body = Finish.cover(k - 1.5 * px, px) * 0.85
    let g = n_halo(k - 1.5 * px, 0.40, 0.10) * (1.0 - body)
    var f = vec4(n_violet() * g, g * 0.15)
    f = mix(f, vec4(n_violet(), 1.0), body)
    return mix(f, vec4(mix(n_violet(), vec3(1.0, 1.0, 1.0), 0.6), 1.0), rail)
}
// Each tab draws its own outline, so the strip draws no separators.
mod.widgets.Tabs.draw_sep.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
