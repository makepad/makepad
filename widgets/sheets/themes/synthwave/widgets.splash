// SEGMENTED. A dark well in a violet tube with its core and halo; the
// chosen segment is washed with the hue and carries a lit bar under its
// caption, three device pixels tall with a white-hot middle row.
mod.widgets.SegmentedControl.segment_height = 22.0
mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 4.0)
    let yn = clamp(p.y / max(self.rect_size.y, 1.0), 0.0, 1.0)
    return n_tube(d, px, vec4(mix(vec3(0.012, 0.008, 0.035), vec3(0.022, 0.012, 0.055), yn), 1.0), n_violet(), 0.85, 0.6, 0.45, 0.30, 3.0)
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let hue = n_cyan()
    let d = Material.sd_box(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(2.0, 2.0), 2.5)
    let wash = Finish.cover(d, px) * 0.18
    var f = vec4(hue * wash, wash)
    let bw = self.rect_size.x * 0.35
    let by = n_mid(o.y + self.rect_size.y - 4.5, px) - o.y
    let bar = Material.sd_box(p, vec2(self.rect_size.x * 0.5, by), vec2(bw, 1.5 * px), 1.5 * px)
    let g = n_halo(bar, 0.7, 0.35)
    f = Finish.over(f, vec4(hue * g, g * 0.15))
    let core = Finish.cover(abs(p.y - by) - 0.5 * px, px)
    return mix(f, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.85 * core), 1.0), Finish.cover(bar, px))
}
mod.widgets.SegmentedControlFlat.draw_text.color = #c4bcec
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #ffffff

// ---------------------------------------------------------------------------
// THE GROUND: a flat grid, drawn once under everything at the window's
// size: a deep indigo ground, a little lighter in the middle, faint violet
// lines every 24 points and a magenta light-line every fourth, all on whole
// device pixels. It stays quiet so the controls carry the light. Everything
// in it is a function of the point alone.

// A light-line `d` points from its centre: (a core about a device pixel
// wide, a soft halo of sigma 2 points).
let n_lightline = fn(d: float, px: float) -> vec2 {
    let k = d / max(px, 0.3)
    return vec2(exp(0.0 - 1.2 * k * k), exp(0.0 - d * d / 8.0))
}

// The grid's two pitches, in points: 24 points is 36 device pixels at 1.5,
// so a line lands on a whole pixel.
let n_grid_minor = fn() -> float { return 24.0 }
let n_grid_major = fn() -> float { return 96.0 }

// The distance in points from p to the nearest line of a grid of pitch `cell`.
let n_grid_dist = fn(p: vec2, cell: float) -> float {
    let d = abs(fract(p / cell + vec2(0.5, 0.5)) - vec2(0.5, 0.5)) * cell
    return min(d.x, d.y)
}

// THE PALMS: dark silhouettes standing on the bottom edge in front of the
// grid, four toward each side with the middle left open, each a different
// height. A trunk is tall and slender, leaning and curving, a little
// thicker at the foot; its crown is a fountain of fronds, the upper ones
// arching up and over and most falling. They are near-black plum with no
// light of their own: the grid goes dark where they stand, and the controls
// stay the brightest thing. Every palm is placed by the window's size, and
// a point outside a crown's box costs no frond.

// One frond at `q`, the point less the top of its trunk, on the side `side`
// (1 right, -1 left): the path of a point thrown `e` radians above the
// level, `len` points along its first direction, pulled down by `g` (a share
// of `len` by the end), which is the curve y = m0 x + k x^2. A midrib
// thinning toward the tip carries leaflets on both sides, leaning toward
// the tip and tapering to points: short at the crown, longest from a sixth
// to a third of the way out, longer below the rib than above, each as long
// as the place it leaves the rib allows. Solid near the rib, they part
// toward their tips, which gives the feathered edge. The distance in points
// to its outline, or 1000 beyond its two ends or far from it.
let n_frond = fn(q: vec2, side: float, e: float, len: float, g: float) -> float {
    let cx = cos(e)
    let x = q.x * side
    let xe = cx * len
    let wide = len * 0.18
    if x < 0.0 - wide || x > xe + wide {
        return 1000.0
    }
    let m0 = 0.0 - sin(e) / cx
    let k = g / (len * cx * cx)
    let m = m0 + 2.0 * k * x
    let n = sqrt(1.0 + m * m)
    let ev = q.y - (m0 * x + k * x * x)
    if ev > (wide + 2.0) * n || ev < 0.0 - (wide * 0.7 + 2.0) * n {
        return 1000.0
    }
    // Across: points from the rib, positive below it. Along: the arc length
    // from the crown, the parabola's own (m n + asinh m) / 4k.
    let s = ev / n
    let n0 = sqrt(1.0 + m0 * m0)
    let m1 = m0 + 2.0 * k * xe
    let n1 = sqrt(1.0 + m1 * m1)
    let a0 = m0 * n0 + log(m0 + n0)
    let arc = (m * n + log(m + n) - a0) / (4.0 * k)
    let total = (m1 * n1 + log(m1 + n1) - a0) / (4.0 * k)
    let a = clamp(arc / max(total, 0.001), 0.0, 1.0)
    let below = step(0.0, s)
    let t = abs(s)
    // A leaflet's length is set where it leaves the rib, which lies back
    // toward the crown from the point; none leaves before the frond starts.
    let root = arc - t * 1.3
    let ar = clamp(root / max(total, 0.001), 0.0, 1.0)
    let w = wide * mix(0.4, 1.0, smoothstep(0.0, 0.15, ar)) * min(1.0, (1.0 - ar) * 1.6) * mix(0.7, 1.0, below) * smoothstep(0.0, 1.0, root)
    let sp = max(len * 0.075, 4.0)
    let tw = t / max(w, 0.01)
    let ph = (arc - t * 1.3 - t * tw * 0.5) / sp + below * 0.5
    let f = abs(ph - floor(ph + 0.5))
    let hd = 0.5 - 0.5 * smoothstep(0.3, 1.05, tw)
    let leaf = max((f - hd) * sp * 0.61, t - w)
    let rib = max(t - len * mix(0.014, 0.003, a), max(arc - total, 0.0 - arc))
    return min(leaf, rib)
}

// A palm standing at x = `bx` on the bottom edge `by`, `h` points tall: its
// trunk leaves the ground at the slope `lean` (sideways per upward) and
// bends by `bend` toward its top, and `count` fronds of up to `len` points
// crown it; `seed` varies the crown. The distance in points to its outline.
let n_palm = fn(p: vec2, bx: float, by: float, h: float, lean: float, bend: float, len: float, count: float, seed: float) -> float {
    var d = 1000.0
    let v = (by - p.y) / h
    if v > -0.1 && v < 1.0 && abs(p.x - bx) < h * 0.2 {
        let tx = bx + h * (lean * v + bend * v * v)
        let sl = lean + 2.0 * bend * v
        d = abs(p.x - tx) / sqrt(1.0 + sl * sl) - max(h * mix(0.0085, 0.004, v), 1.0)
    }
    let q = p - vec2(bx + h * (lean + bend), by - h)
    if abs(q.x) < len * 1.3 && q.y > 0.0 - len * 0.8 && q.y < len * 1.6 {
        d = min(d, length(q - vec2(0.0, len * 0.01)) - len * 0.07)
        // The fronds take turns left and right, each side's running from
        // the highest down to the lowest, the two sides half a step apart.
        // The fan is tipped a little to one side, so one side's fronds
        // stand higher than the other's.
        let half = count * 0.5
        let tip = (Finish.hash(vec2(seed * 7.7 + 1.9, 3.3)) - 0.5) * 0.5
        var i = 0.0
        for j in 0..12 {
            if i >= count {
                break
            }
            // No frond reaches back past the middle by a quarter of `len`,
            // so a point well to one side skips the other side's fronds.
            let odd = fract(i * 0.5) * 2.0
            let side = 1.0 - 2.0 * odd
            if q.x * side > 0.0 - len * 0.25 {
                let r = Finish.hash(vec2(i * 3.17 + seed * 11.3, seed * 1.31 + 7.0))
                let r2 = Finish.hash(vec2(seed * 5.71 + 2.9, i * 1.93 + 4.4))
                let t = clamp((floor(i * 0.5) + 0.25 + 0.5 * odd + 0.5 * (r - 0.5)) / half, 0.0, 1.0)
                let e = min(mix(1.4, -0.7, t) + tip * side, 1.3)
                let fl = len * mix(1.15, 1.0, smoothstep(0.0, 0.4, t)) * mix(1.0, 0.75, smoothstep(0.5, 1.0, t)) * (0.9 + 0.2 * r2)
                d = min(d, n_frond(q, side, e, fl, 0.6 + 0.1 * sin(3.14159 * t)))
            }
            i = i + 1.0
        }
    }
    return d
}

// The palms of a window of size s: the distance in points to the nearest.
let n_palms = fn(p: vec2, s: vec2) -> float {
    let by = s.y + 4.0
    let u = min(s.y, s.x * 0.7)
    var d = n_palm(p, s.x * 0.035, by, s.y * 0.80, 0.13, -0.11, u * 0.170, 11.0, 1.0)
    d = min(d, n_palm(p, s.x * 0.105, by, s.y * 0.56, -0.10, 0.07, u * 0.130, 9.0, 2.0))
    d = min(d, n_palm(p, s.x * 0.165, by, s.y * 0.70, 0.02, 0.07, u * 0.150, 10.0, 3.0))
    d = min(d, n_palm(p, s.x * 0.215, by, s.y * 0.40, 0.06, -0.08, u * 0.110, 9.0, 4.0))
    d = min(d, n_palm(p, s.x * 0.775, by, s.y * 0.47, -0.02, 0.06, u * 0.115, 9.0, 5.0))
    d = min(d, n_palm(p, s.x * 0.845, by, s.y * 0.84, -0.13, 0.09, u * 0.175, 11.0, 6.0))
    d = min(d, n_palm(p, s.x * 0.905, by, s.y * 0.58, 0.03, -0.09, u * 0.135, 9.0, 7.0))
    d = min(d, n_palm(p, s.x * 0.970, by, s.y * 0.68, -0.03, 0.06, u * 0.150, 10.0, 8.0))
    return d
}

// THE MOUNTAINS: two ranges of low, jagged peaks along the window's foot,
// in front of the sunset glow and the grid and behind the palms. No peak
// rises above a fifth of the window's height. A ridge is a broken line
// through a vertex every `w` points, each vertex's height from a smooth
// noise over a few vertices (the masses of the range) and its own hash
// (the peaks), with a vertex half way between pulled up or down by over a
// quarter of `w` for the jagged edge. The near range stands tallest at the sides,
// behind the palms, and lower across the middle; the far range is lower,
// finer and even. Everything is laid out by the window's size, so the
// ranges keep their shape as it changes and nothing repeats.

// The height in points of a range's `i`-th vertex: at most `hmax`, and
// `lift` of it less across the middle of the window.
let n_peak = fn(i: float, w: float, hmax: float, seed: float, sx: float, lift: float) -> float {
    let u = i * w / max(sx, 1.0)
    let side = 1.0 - lift * (1.0 - smoothstep(0.10, 0.40, abs(u - 0.5)))
    let t = i / 4.5 + seed * 7.1
    let f = fract(t)
    let n = mix(Finish.hash(vec2(floor(t), seed)), Finish.hash(vec2(floor(t) + 1.0, seed)), f * f * (3.0 - 2.0 * f))
    let r = 0.62 * n + 0.38 * Finish.hash(vec2(i * 1.37 + 0.5, seed * 3.1 + 5.0))
    return hmax * side * (0.10 + 0.90 * smoothstep(0.08, 0.92, r))
}

// The height of the ridge's `j`-th vertex at half steps: the even ones are
// the range's own, an odd one lies half way between its two and is pulled
// up or down by up to 0.28 of `w`, never past `hmax`.
let n_ridge_v = fn(j: float, w: float, hmax: float, seed: float, sx: float, lift: float) -> float {
    let i = floor(j * 0.5)
    let a = n_peak(i, w, hmax, seed, sx, lift)
    if j - 2.0 * i < 0.5 {
        return a
    }
    let b = n_peak(i + 1.0, w, hmax, seed, sx, lift)
    let jit = (Finish.hash(vec2(j * 2.71 + 0.5, seed * 1.7 + 9.0)) - 0.5) * w * 0.56
    return clamp(0.5 * (a + b) + jit, 0.0, hmax)
}

// A range at p, its foot on the line `by`: x the signed distance in points
// to its ridge, positive above it, from the three segments round p; z how
// far down from the ridge p lies, as a share of the height there; and with
// `legs` 1, y the distance to the nearest line of its wireframe, which runs
// from each peak (a vertex of the range's own above both its neighbours)
// down to the foot under each neighbour, a few ridge-to-valley lines.
let n_range = fn(p: vec2, by: float, w: float, hmax: float, seed: float, sx: float, lift: float, legs: float) -> vec3 {
    let hw = w * 0.5
    let k = floor(p.x / hw)
    let x1 = k * hw
    let y0 = by - n_ridge_v(k - 1.0, w, hmax, seed, sx, lift)
    let y1 = by - n_ridge_v(k, w, hmax, seed, sx, lift)
    let y2 = by - n_ridge_v(k + 1.0, w, hmax, seed, sx, lift)
    let y3 = by - n_ridge_v(k + 2.0, w, hmax, seed, sx, lift)
    let d = min(min(n_seg(p, vec2(x1 - hw, y0), vec2(x1, y1)), n_seg(p, vec2(x1, y1), vec2(x1 + hw, y2))), n_seg(p, vec2(x1 + hw, y2), vec2(x1 + w, y3)))
    let ry = mix(y1, y2, (p.x - x1) / hw)
    var leg = 1000.0
    if legs > 0.5 {
        let i0 = floor(p.x / w)
        let h0 = n_peak(i0 - 1.0, w, hmax, seed, sx, lift)
        let ha = n_peak(i0, w, hmax, seed, sx, lift)
        let hb = n_peak(i0 + 1.0, w, hmax, seed, sx, lift)
        let h3 = n_peak(i0 + 2.0, w, hmax, seed, sx, lift)
        if ha > h0 && ha > hb {
            leg = n_seg(p, vec2(i0 * w, by - ha), vec2(i0 * w + w, by))
        }
        if hb > ha && hb > h3 {
            leg = min(leg, n_seg(p, vec2(i0 * w + w, by - hb), vec2(i0 * w, by)))
        }
    }
    return vec3(d * (step(p.y, ry) * 2.0 - 1.0), leg, clamp((p.y - ry) / max(by - ry, 1.0), 0.0, 1.0))
}

// The two ranges of a window of size s: the far one a fortieth of the width
// to a vertex and up to 0.14 of the height, the near one a twenty-sixth and
// up to a fifth, 0.55 of that across the middle.
let n_range_far = fn(p: vec2, s: vec2) -> vec3 {
    return n_range(p, s.y, s.x / 40.0, s.y * 0.14, 2.0, s.x, 0.0, 0.0)
}
let n_range_near = fn(p: vec2, s: vec2, legs: float) -> vec3 {
    return n_range(p, s.y, s.x / 26.0, s.y * 0.20, 5.0, s.x, 0.45, legs)
}

// The mountains over `col`, the ground at p with its grid, `gl` the sunset
// light at p. The far range is hazy: plum lit by the glow behind it, its
// ridge a faint violet line a device pixel wide with a soft halo. The near
// range is dark plum, darker than the far one and a shade lighter than the
// palms so they stand out in front of it, a little light caught under its
// ridge; its ridge
// is a magenta light-line, a pixel of core and a soft glow, and its
// wireframe a faint cyan line a pixel wide that fades out toward the foot.
let n_mountains = fn(col: vec3, p: vec2, s: vec2, px: float, gl: vec3) -> vec3 {
    var c = col
    let fr = n_range_far(p, s)
    c = mix(c, vec3(0.050, 0.020, 0.090) + gl * 0.55, Finish.cover(fr.x, px))
    let fl = Finish.cover(abs(fr.x) - 0.5 * px, px)
    c = c + vec3(0.80, 0.36, 1.0) * (fl * 0.26 + exp(0.0 - fr.x * fr.x / 10.0) * 0.05)
    let nr = n_range_near(p, s, 1.0)
    let depth = max(0.0 - nr.x, 0.0)
    var body = mix(vec3(0.085, 0.032, 0.135), vec3(0.036, 0.014, 0.064), smoothstep(0.0, 24.0, depth))
    let fade = 1.0 - smoothstep(0.05, 0.85, nr.z)
    body = body + n_cyan() * (Finish.cover(nr.y - 0.5 * px, px) * 0.20 + exp(0.0 - nr.y * nr.y / 6.0) * 0.035) * fade
    c = mix(c, body, Finish.cover(nr.x, px))
    let nl = Finish.cover(abs(nr.x) - 0.5 * px, px)
    return c + n_magenta() * (nl * 0.55 + exp(0.0 - nr.x * nr.x / 8.0) * 0.09)
}

let n_world = fn(p: vec2, size: vec2, px: float) -> vec3 {
    let s = max(size, vec2(1.0, 1.0))
    // The ground: deep indigo, a shade of violet in the middle of the window.
    let c = (p - s * 0.5) / s
    var col = mix(vec3(0.046, 0.024, 0.112), vec3(0.018, 0.011, 0.055), smoothstep(0.0, 0.8, length(c * vec2(1.2, 1.6))))
    // The glow the palms stand against: a sunset light rising from the
    // window's foot, hot pink there turning violet as it climbs, falling
    // off over 0.38 of the height; strongest behind the palms at the sides and
    // at four tenths of that across the middle, where the controls are.
    let up = clamp((s.y - p.y) / s.y, 0.0, 1.0)
    let side = 0.4 + 0.6 * smoothstep(0.18, 0.40, abs(c.x))
    let glow = mix(vec3(0.95, 0.30, 0.55), vec3(0.45, 0.18, 0.80), smoothstep(0.0, 0.6, up))
    let gl = glow * exp(0.0 - up / 0.38) * side * 0.34
    col = col + gl
    // The minor lines: one device pixel of faint violet, no halo.
    let dm = n_grid_dist(p, n_grid_minor())
    col = col + vec3(0.42, 0.18, 0.72) * Finish.cover(dm - 0.5 * px, px) * 0.15
    // The major lines: a magenta light-line, a pixel of core and a soft halo.
    let dj = n_grid_dist(p, n_grid_major())
    col = col + n_magenta() * (Finish.cover(dj - 0.5 * px, px) * 0.34 + exp(0.0 - dj * dj / 6.0) * 0.08)
    // The mountains, in front of the grid, along the foot.
    if p.y > s.y * 0.78 {
        col = n_mountains(col, p, s, px, gl)
    }
    // The palms, in front of the grid and the mountains.
    col = mix(col, vec3(0.012, 0.005, 0.022), Finish.cover(n_palms(p, s), px))
    let g = Finish.grain(p / px, 2.0 / 255.0)
    return col + vec3(g, g, g)
}
// How bright the ground is at the window point p: 0 between the lines, a
// little on a major line's halo, and on a mountain's lit ridge; nothing
// where a mountain hides the grid. The words that stand on it read it to
// decide on a shadow, which the quiet grid rarely asks for.
let n_ground = fn(p: vec2, s: vec2) -> float {
    let dj = n_grid_dist(p, n_grid_major())
    var g = exp(0.0 - dj * dj / 6.0) * 0.35
    if p.y > s.y * 0.78 {
        let fr = n_range_far(p, s)
        let nr = n_range_near(p, s, 0.0)
        g = g * step(0.0, min(fr.x, nr.x)) + exp(0.0 - nr.x * nr.x / 8.0) * 0.5 + exp(0.0 - fr.x * fr.x / 10.0) * 0.2 * step(0.0, nr.x)
    }
    return g
}
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return vec4(n_world(self.pos * self.rect_size, self.rect_size, px), 1.0)
}

// DIVIDERS are faint violet light-lines, fading out toward both ends.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y + px * 0.5
    let ends = smoothstep(0.0, 24.0, p.x) * smoothstep(0.0, 24.0, self.rect_size.x - p.x)
    let l = n_lightline(p.y - y, px) * ends
    let a = l.x * 0.55 + l.y * 0.12
    return vec4(n_violet() * a + vec3(0.5, 0.45, 0.7) * l.x * 0.15, a * 0.6)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x + px * 0.5
    let ends = smoothstep(0.0, 24.0, p.y) * smoothstep(0.0, 24.0, self.rect_size.y - p.y)
    let l = n_lightline(p.x - x, px) * ends
    let a = l.x * 0.55 + l.y * 0.12
    return vec4(n_violet() * a + vec3(0.5, 0.45, 0.7) * l.x * 0.15, a * 0.6)
}

// SPLITTERS are a gap in the world with a faint violet light-line down
// their length; the pointer lights it cyan.
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let tall = step(self.rect_size.x, self.rect_size.y)
    let along = mix(p.x, p.y, tall)
    let across = mix(p.y - self.rect_size.y * 0.5, p.x - self.rect_size.x * 0.5, tall)
    let len = mix(self.rect_size.x, self.rect_size.y, tall)
    let ends = smoothstep(0.0, 40.0, along) * smoothstep(0.0, 40.0, len - along)
    let warm = max(max(self.hover, self.drag), self.focus)
    let l = n_lightline(across, px) * ends
    let a = l.x * mix(0.30, 0.9, warm) + l.y * mix(0.05, 0.3, warm)
    return vec4(mix(n_violet(), n_cyan(), warm) * a, a * 0.5)
}

// THE NEEDLE METER is a screen too: smoked glass in a cyan tube with its
// core and halo; the scale a cyan light-line with lit ticks, the major ones
// white-hot at the core; the zone a red band that glows; the needle a
// white-hot line in a magenta body with a halo, rooted in a magenta lamp.
mod.widgets.NeedleMeter.draw_bg.color = #05040f
mod.widgets.NeedleMeter.draw_bg.color_scale = #63e4ff
mod.widgets.NeedleMeter.draw_bg.color_needle = #ff5ccf
mod.widgets.NeedleMeter.draw_bg.color_zone = #ff2c52
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let fd = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 3.0)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let face = mix(vec3(0.006, 0.010, 0.026), vec3(0.014, 0.012, 0.040), yn)
    var f = n_tube(fd, px, vec4(face, 1.0), n_cyan(), 0.92, 0.85, 0.55, 0.50, 3.0)
    // The pivot in the middle of a pixel and the scale's radius a whole
    // number of pixels, so a line through the pivot that runs straight up
    // or across (the needle at mid-scale, the middle tick) lies on three
    // whole pixels with its core on one, and the scale and the zone lie on
    // whole pixels where they cross the axes.
    let pv0 = self.pivot()
    let pv = vec2(n_mid(o.x + pv0.x, px), n_mid(o.y + pv0.y, px)) - o
    let rr = Finish.snap(self.scale_radius(), px)
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    // The scale's arc, with round ends.
    let e0 = vec2(sin(0.0 - sweep * 0.5), 0.0 - cos(0.0 - sweep * 0.5)) * rr
    let e1 = vec2(sin(sweep * 0.5), 0.0 - cos(sweep * 0.5)) * rr
    let arc = mix(min(length(q - e0), length(q - e1)), abs(r - rr), on_scale)
    let scale = self.color_scale.rgb
    f = n_stroke(f, arc, 0.45, px, scale, 0.9, 0.0, 0.35, 0.15)
    // The ticks, each a short lit stroke in toward the pivot.
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let dir = vec2(sin(ak), 0.0 - cos(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let tick = n_seg(q, dir * (rr - len), dir * rr)
    // Each point takes the light of its nearest tick only, so the ticks
    // keep a tight halo and no wide one, or the sectors between them show.
    f = n_stroke(f, tick, mix(0.35, 1.5 * px, major), px, scale, 1.0, 0.8 * major, 0.45, 0.0)
    // The zone: a band of light three device pixels wide just outside the
    // arc from `zone` on.
    if self.zone < 0.999 {
        let zt = max((self.zone - t) * sweep * r, (t - 1.0) * sweep * r)
        let zs = max(zt + 1.5 * px, abs(r - rr - Finish.snap(1.5, px)))
        f = n_stroke(f, zs, 1.5 * px, px, self.color_zone.rgb, 0.95, 0.5, 0.5, 0.35)
    }
    // The needle, from under the pivot to just past the scale.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let needle = n_seg(q, nd * (0.0 - max(self.pivot_size - px, 0.0)), nd * (rr + 3.0))
    let nh = self.color_needle.rgb
    f = n_stroke(f, needle, 1.5 * px, px, nh, 1.0, 1.0, 0.6, 0.4)
    // The pivot: a disc of glass in a magenta tube with a lamp at its
    // middle. Its radius ends between two pixels, so the tube lies on whole
    // pixels.
    let pr = n_mid(max(self.pivot_size, 1.5), px)
    f = Finish.over(f, n_tube(r - pr, px, vec4(0.03, 0.02, 0.07, 1.0), nh, 0.9, 0.6, 0.35, 0.2, 3.0))
    f = n_lamp(f, p, pv, pr * 0.45, px, nh, 1.0)
    return f * self.opacity
}

// ---------------------------------------------------------------------------
// SURFACES. A pane is a solid shape of dark violet glass that the world
// does not show through, drawn in light along its edge: a tube three device
// pixels wide with a white core, and a wide soft glow outside it. A panel
// is edged in cyan; an inset panel is a deeper well edged in violet, most
// of its light falling inward, so it reads sunk below the ground.
let n_pane = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hue: vec3, sunken: float, lift: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, r)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let a = mix(0.95, 0.97, sunken)
    var glass = mix(mix(vec3(0.034, 0.020, 0.085), vec3(0.022, 0.013, 0.058), yn), vec3(0.010, 0.006, 0.028), sunken)
    // The well's light falls inward from its rim.
    let inward = max(0.0 - d, 0.0)
    glass = glass + hue * 0.20 * sunken * exp(0.0 - inward / 5.0)
    let lit = mix(0.92, 0.80, sunken) * lift
    return n_tube(d, px, vec4(glass * a, a), hue, lit, mix(0.85, 0.65, sunken) * lift, mix(0.50, 0.35, sunken) * lift, mix(0.45, 0.14, sunken) * lift, 3.0)
}
mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let hue = mix(n_cyan(), n_violet(), self.sunken)
    return n_pane(p, self.rect_pos, self.rect_size, px, 5.0, hue, self.sunken, 1.0)
}

// Cards are the angular panes: two opposite corners cut at 45 degrees, a
// magenta light-line round them with its core and halo, a short bar of
// pale light on the top edge after the cut, laid on the tube's own three
// rows with its core white-hot, and four slanted ticks by the lower
// corner. The pointer brightens the line and washes the glass.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let s = self.rect_size
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, vec4(9.0, 0.0, 9.0, 0.0))
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let hue = n_magenta()
    let layer = self.hover * self.hover_opacity + self.down * self.press_opacity
    // Elevated floats on its wide glow; filled lies flat, its glass denser
    // and tinted; outlined is the light-line alone round clear glass.
    let lift = clamp(self.shadow_radius / 4.0, 0.0, 1.0)
    let outlined = step(0.01, self.border_size) * (1.0 - lift)
    let filled = (1.0 - lift) * (1.0 - outlined)
    let ga = mix(mix(0.95, 0.97, filled), 0.0, outlined)
    let glass = mix(mix(vec3(0.036, 0.018, 0.080), vec3(0.022, 0.010, 0.055), yn), hue, layer * 0.4 + 0.07 * filled)
    let warm = clamp(self.hover + self.down, 0.0, 1.0)
    let wide = (0.28 + 0.20 * lift + 0.2 * warm)
    var f = n_tube(d, px, vec4(glass * max(ga, layer * 0.4), max(ga, layer * 0.4)), hue, mix(mix(0.9, 0.8, filled), 1.0, warm), mix(0.8, 1.0, warm), 0.50 + 0.2 * warm, wide, 3.0)
    // The bar: 3 dpx on the top edge after the cut, 24 points long.
    let bar = Material.sd_box(p, vec2(lo.x + 9.0 + 16.0, lo.y + 1.5 * px), vec2(12.0, 1.5 * px), 0.0)
    let g = n_halo(bar, 0.7, 0.3)
    f = Finish.over(f, vec4(hue * g, g * 0.15))
    let bcore = Finish.cover(abs(p.y - lo.y - 1.5 * px) - 0.5 * px, px)
    f = mix(f, vec4(mix(mix(hue, vec3(1.0, 1.0, 1.0), 0.45), vec3(1.0, 1.0, 1.0), bcore), 1.0), Finish.cover(bar, px))
    // Four slanted ticks by the lower right corner.
    let tq = p - vec2(hi.x - 15.0, hi.y - 5.0)
    let tu = tq.x + tq.y * 0.577
    let ti = floor(tu / 2.5)
    let tk = Finish.cover(abs(tu - ti * 2.5 - 0.75) - 0.75, px) * step(0.0, ti) * step(ti, 3.5) * step(abs(tq.y), 2.0)
    return mix(f, vec4(hue * 0.8, 1.0), tk)
}

// LIST ROWS. 22 points tall, each a band of solid dark violet glass, so a
// list is a dark column that the world does not show through: its sides are
// faint violet light-lines and a brighter violet light-line with a pale
// core runs under each row, 8 points in from both ends, its glow rising
// into the row. The pointer washes the row with the hue, and the chosen row
// is a lit bar: the hue at 22 %, a white-hot tube down its left edge with a
// halo, and its foot lit cyan.
mod.widgets.ListItem.height = 22.0
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let hue = n_cyan()
    let live = 1.0 - self.disabled
    let yn = clamp(p.y / max(self.rect_size.y, 1.0), 0.0, 1.0)
    let wash = (0.10 * self.hover + 0.08 * self.down + 0.22 * self.selected) * live
    var f = vec4(mix(mix(vec3(0.026, 0.016, 0.066), vec3(0.034, 0.020, 0.082), yn), hue, wash) * 0.94, 0.94)
    let xl = Finish.snap(self.rect_pos.x, px) - self.rect_pos.x
    let xr = Finish.snap(self.rect_pos.x + self.rect_size.x, px) - self.rect_pos.x
    let side = max(Finish.cover(abs(p.x - xl - 0.5 * px) - 0.5 * px, px), Finish.cover(abs(p.x - xr + 0.5 * px) - 0.5 * px, px))
    f = mix(f, vec4(n_violet() * 0.40, 1.0), side * 0.8)
    let yb = floor((self.rect_pos.y + self.rect_size.y) / px) * px - self.rect_pos.y
    let inx = step(8.0, p.x) * step(p.x, self.rect_size.x - 8.0) * (1.0 - self.selected)
    let up = max(yb - px * 0.5 - p.y, 0.0)
    let rg = exp(0.0 - up * up / 6.0) * 0.18 * inx
    f = Finish.over(f, vec4(n_violet() * rg, rg * 0.2))
    let rule = step(yb - px, p.y) * step(p.y, yb) * inx
    f = mix(f, vec4(mix(n_violet() * 0.80, vec3(1.0, 1.0, 1.0), 0.25), 1.0), rule * 0.85)
    let foot = step(yb - px, p.y) * step(p.y, yb) * self.selected * live
    let fg = exp(0.0 - up * up / 8.0) * 0.35 * self.selected * live
    f = Finish.over(f, vec4(hue * fg, fg * 0.15))
    f = mix(f, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.3), 1.0), foot)
    let bx = xl
    let bar = Material.sd_box(p, vec2(bx + 1.5 * px, self.rect_size.y * 0.5), vec2(1.5 * px, self.rect_size.y * 0.5), 0.0)
    let g = n_halo(bar, 0.7, 0.4) * self.selected * live
    f = Finish.over(f, vec4(hue * g, g * 0.15))
    let core = Finish.cover(abs(p.x - bx - 1.5 * px) - 0.5 * px, px)
    let bc = mix(mix(hue, vec3(1.0, 1.0, 1.0), 0.8 * core) * live, n_dead(), self.disabled)
    return mix(f, vec4(bc, 1.0), Finish.cover(bar, px) * self.selected)
}
mod.widgets.ListItem.draw_text.color = #ece8ff

// The rounded view keeps its caller's colours; its edge is a true device
// pixel and its fill is dithered. A dark, solid surface with no border of
// its own is taken for a pane on the world: its fill stays solid dark glass
// and a violet tube three device pixels wide with a white core runs round
// its edge, its light falling inward and a halo outward; for such a pane
// alone the quad grows past the box for the halo.
let n_rounded_pane = fn(fill: vec4, border_size: float, h: vec2) -> float {
    let lum = dot(fill.rgb, vec3(0.299, 0.587, 0.114))
    return step(0.99, fill.a) * (1.0 - step(0.08, lum)) * (1.0 - step(0.001, border_size)) * step(12.0, min(h.x, h.y))
}
mod.widgets.RoundedView.draw_bg.vertex = fn() {
    let h = (self.rect_size - vec2(self.border_inset.x + self.border_inset.z, self.border_inset.y + self.border_inset.w)) * 0.5
    let m = 18.0 * n_rounded_pane(self.color, self.border_size, h)
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, m)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(2.0 * m, 2.0 * m))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lower = vec2(self.border_inset.x, self.border_inset.y)
    let upper = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = max((upper - lower) * 0.5, vec2(0.5, 0.5))
    let pane = n_rounded_pane(self.color, self.border_size, h)
    let m = 18.0 * pane
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let u = clamp(p / max(self.rect_size, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let c = (lower + upper) * 0.5
    let d = Material.sd_box(p, c, h, min(2.0 * max(1.0, self.border_radius), min(h.x, h.y)))
    var fill = self.color
    if self.color_2.x > -0.5 {
        let dir = if self.gradient_fill_horizontal > 0.5 u.x else u.y
        fill = mix(self.color, self.color_2, dir)
    }
    var stroke = self.border_color
    if self.border_color_2.x > -0.5 {
        let dir = if self.gradient_border_horizontal > 0.5 u.x else u.y
        stroke = mix(self.border_color, self.border_color_2, dir)
    }
    let g = Finish.grain(p / px, 1.0 / 255.0) * fill.a
    var col = vec4(fill.rgb * fill.a + vec3(g, g, g), fill.a)
    let bw = max(self.border_size, px) * step(0.001, self.border_size)
    let edge = Finish.band(d, 0.0, bw, px) * stroke.a
    col = mix(col, vec4(stroke.rgb, 1.0), edge)
    let lo = vec2(Finish.snap(self.rect_pos.x + lower.x, px), Finish.snap(self.rect_pos.y + lower.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + upper.x, px), Finish.snap(self.rect_pos.y + upper.y, px)) - self.rect_pos
    let ds = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, min(2.0 * max(1.0, self.border_radius), min(h.x, h.y)))
    let inward = max(0.0 - ds, 0.0)
    let glow = n_violet() * 0.10 * exp(0.0 - inward / 4.0)
    let lit = n_tube(ds, px, vec4((fill.rgb + glow) * 0.96, 0.96), n_violet(), 0.85, 0.75, 0.50, 0.32, 3.0)
    return mix(col * Finish.cover(d, px), lit, pane)
}

// SCREENS. A display is a solid pane of near-black glass edged by a cyan
// tube three device pixels wide with a white core and a soft halo past the
// box (the quad grows for it, and the clip the screen opens on its own box
// is widened to match). The bezel is a ring of dark violet glass inside the
// tube, its inner edge a faint violet light-line; none is a face that runs
// to the tube. The face is a little lighter than black so the recess, the
// surround's shadow under its top edge, reads on it; scan lines come only
// when the screen asks for them.
mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r = min(3.0, min(ho.x, ho.y))
    let d = Material.sd_box(p, c, ho, r)
    // The face starts inside the tube and the bezel ring, which is three
    // quarters of the bezel wide.
    let tw = 3.0 * px
    let b = tw + Finish.snap(max(self.bezel, 0.0) * 0.75, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(r - b * 0.5, 0.5)
    let fd = Material.sd_box(p, c, hf, rf)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.026, 0.034, 0.078), vec3(0.036, 0.046, 0.098), yn)
    if self.recess > 0.0 {
        let insh = Finish.inset(p, c, hf, rf, vec2(0.0, self.recess * 0.5), max(self.recess * 0.45, 0.3))
        face = face * (1.0 - 0.85 * insh)
    }
    if self.scan > 0.0 {
        face = face * Finish.scan(p.y - (c.y - hf.y), px, 3.0 * px, self.scan)
    }
    let ring = mix(vec3(0.042, 0.026, 0.096), vec3(0.030, 0.018, 0.070), yn)
    var glass = mix(ring, face, Finish.cover(fd, px))
    let inner = Finish.band(0.0 - fd, 0.0, px, px) * step(tw + 0.5 * px, b)
    glass = mix(glass, n_violet() * 0.40, inner)
    return n_tube(d, px, vec4(glass, 1.0), n_cyan(), 0.92, 0.85, 0.55, 0.50, 3.0)
}
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let d = Material.sd_box(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(2.0 * px, 2.0 * px), 2.0)
    let u = self.pos
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let a = clamp(self.sheen * band, 0.0, 1.0) * Finish.cover(d, px)
    return vec4(vec3(0.6, 0.85, 1.0) * a, 0.0)
}

// THE DIGITS. Every lit segment is a tube of the screen's ink: a pale core
// down its middle and a cyan halo that spills over the glass and past the
// cell; the unlit segments a faint ghost behind. The quad reaches two
// fifths of the digit past the cell for the halo, which is gone before its
// edge.
mod.widgets.Readout.draw_bg.vertex = fn() {
    let m = max(4.0, self.rect_size.y * 0.4)
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, m)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(2.0 * m, 2.0 * m))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.Readout.draw_bg.pixel = fn() {
    let m = max(4.0, self.rect_size.y * 0.4)
    let h = max(self.rect_size.y, 1.0)
    let pp = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let over = (self.rect_size.x - self.span) * 0.5
    let p = (pp - vec2(over, 0.0)) / h
    let q = vec2(p.x + (p.y - 0.5) * self.slant, p.y)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5) / h
    let s = self.stroke
    var lit = 10.0
    var all = 10.0
    if self.colon > 0.5 {
        let cx = self.span / h * 0.5
        let rr = s * 0.62
        let d1 = length(q - vec2(cx, 0.31)) - rr
        let d2 = length(q - vec2(cx, 0.69)) - rr
        all = min(d1, d2)
        lit = all
    } else {
        let x0 = (self.span / h - self.glyph_width) * 0.3
        let dq = q - vec2(x0, 0.0)
        let dd = self.digit(dq)
        let room = self.span / h - x0 - self.glyph_width
        let dp = length(dq - vec2(self.glyph_width + room * 0.45, 1.0 - s * 0.62)) - s * 0.62
        all = min(dd.y, dp)
        lit = min(dd.x, dp + (1.0 - step(0.5, self.dot)) * 10.0)
    }
    let a_lit = Finish.cover(lit, px)
    let a_all = Finish.cover(all, px)
    let ink = self.color.rgb
    let core = Finish.cover(lit + s * 0.28, px)
    let body = mix(ink, vec3(1.0, 1.0, 1.0), core * 0.6)
    // The halo, gone before the edge of the grown quad.
    let x = max(lit, 0.0) * h
    let g = (0.30 * exp(0.0 - 0.3 * x * x) + 0.12 * exp(0.0 - 0.15 * x * x)) * (1.0 - smoothstep(m * 0.35, m * 0.85, x)) * self.opacity * self.color.a
    var f = vec4(n_cyan() * g, g * 0.15)
    let ghost = a_all * clamp(self.ghost, 0.0, 1.0) * (1.0 - a_lit) * self.opacity * self.color.a
    f = Finish.over(f, vec4(ink * ghost, ghost))
    return mix(f, vec4(body, 1.0), a_lit * self.opacity * self.color.a)
}

// READOUTS. The value beside a dial is a small screen a little larger than
// its field: near-black glass in a cyan light-line with its core and halo,
// the number in a monospace pale cyan.
let n_readout = fn(p: vec2, o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5 + vec2(3.0, 2.0), 2.5)
    return n_tube(d, px, vec4(0.010, 0.012, 0.034, 1.0), n_cyan(), 0.88, 0.80, 0.50, 0.40, 3.0)
}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 4.0 right: 4.0 top: 2.0 bottom: 2.0}
mod.widgets.RotaryFlat.text_input.draw_text.color = #b8f4ff
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 8.0}
mod.widgets.RotaryFlat.text_input.draw_selection.color = #0000
mod.widgets.RotaryFlat.text_input.clip_x = false
mod.widgets.RotaryFlat.text_input.clip_y = false
mod.widgets.RotaryFlat.text_input.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    return n_readout(p, self.rect_pos, self.rect_size, px)
}
// The value inside a slider is a bare readout: the field row's height
// must not reach it, or its text drops below the track's line.
mod.widgets.SliderMinimal.text_input.min_height = 0.0
mod.widgets.SliderFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_code{font_size: 8.0}
mod.widgets.SliderMinimal.text_input.draw_text.color = #9fefff
mod.widgets.SliderFlat.text_input.draw_text.color = #9fefff
mod.widgets.ComboBoxFlat.input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 8.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.color = #9fefff
// Where the ground is bright the value sits on a soft dark plate that runs
// out past its box, so its figures read and the clip the field keeps round
// its text leaves no edge: dark under the figures, gone four points out.
mod.widgets.SliderFlat.text_input.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SliderFlat.text_input.draw_bg.pixel = fn() {
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let h = self.rect_size * 0.5
    let d = Material.sd_box(p, h, max(h - vec2(1.0, 1.0), vec2(0.5, 0.5)), min(3.0, min(h.x, h.y)))
    let vp = self.draw_pass.camera_projection * self.draw_pass.camera_view
    let k0 = vp * vec4(0.0, 0.0, 0.0, 1.0)
    let k1 = vp * vec4(100.0, 100.0, 0.0, 1.0)
    let ws = vec2(200.0 / max(abs(k1.x - k0.x), 0.000001), 200.0 / max(abs(k1.y - k0.y), 0.000001))
    // A value sized away to nothing (a fader's) has no plate.
    let shown = step(1.0, min(self.rect_size.x, self.rect_size.y))
    let a = (1.0 - smoothstep(0.5, 4.5, d)) * 0.80 * smoothstep(0.04, 0.30, n_ground(self.world.xy, ws)) * shown
    return vec4(vec3(0.016, 0.008, 0.040) * a, a)
}
mod.widgets.Slider.text_input.draw_bg.vertex = mod.widgets.SliderFlat.text_input.draw_bg.vertex
mod.widgets.Slider.text_input.draw_bg.pixel = mod.widgets.SliderFlat.text_input.draw_bg.pixel
mod.widgets.SliderMinimal.text_input.draw_bg.vertex = mod.widgets.SliderFlat.text_input.draw_bg.vertex
mod.widgets.SliderMinimal.text_input.draw_bg.pixel = mod.widgets.SliderFlat.text_input.draw_bg.pixel
mod.widgets.SliderRoundFlat.text_input.draw_bg.vertex = mod.widgets.SliderFlat.text_input.draw_bg.vertex
mod.widgets.SliderRoundFlat.text_input.draw_bg.pixel = mod.widgets.SliderFlat.text_input.draw_bg.pixel
mod.widgets.SliderRound.text_input.draw_bg.vertex = mod.widgets.SliderFlat.text_input.draw_bg.vertex
mod.widgets.SliderRound.text_input.draw_bg.pixel = mod.widgets.SliderFlat.text_input.draw_bg.pixel

// CHIPS AND BADGES. A chip is a small pill in a cyan tube with its core
// and halo; a badge is a lamp: a pill glowing from its rim inward in its
// intent's colour, a white-hot core in its rim. A badge clips itself to its
// own box, so its light stays inside the pill. Both pills stand on whole
// device pixels, so their tubes lie on three whole pixels.
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x + 0.5, px), Finish.snap(o.y + 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 0.5, px), Finish.snap(o.y + self.rect_size.y - 0.5, px)) - o
    let d = Finish.sd_pill(p, (lo + hi) * 0.5, (hi - lo) * 0.5)
    let yn = clamp(p.y / max(self.rect_size.y, 1.0), 0.0, 1.0)
    let hue = n_cyan()
    let dn = min(self.down * 4.0, 1.0)
    let warm = max(self.hover * 0.7, dn)
    let face = vec4(mix(n_glass(yn), hue, 0.12 * self.hover + 0.36 * dn) * 0.9, 0.9)
    return n_tube(d, px, face, hue, mix(0.85, 1.0, warm), mix(0.65, 1.0, warm), 0.50 + 0.25 * warm, 0.32 + 0.30 * warm, 3.0)
}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x + 0.5, px), Finish.snap(o.y + 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 0.5, px), Finish.snap(o.y + self.rect_size.y - 0.5, px)) - o
    let d = Finish.sd_pill(p, (lo + hi) * 0.5, (hi - lo) * 0.5)
    // The intent's colour at full strength, however dark the palette gave
    // it, so a neutral count still lights.
    let hue = self.color.rgb / max(max(self.color.r, self.color.g), max(self.color.b, 0.05))
    let inward = max(0.0 - d - 1.5, 0.0)
    let face = vec4(hue * (0.22 + 0.30 * exp(0.0 - inward * inward * 0.25)), 1.0)
    return n_tube(d, px, face, hue, 1.0, 0.85, 0.0, 0.0, 3.0) * max(self.color.a, 0.6)
}
mod.widgets.Badge.draw_bg.pixel = mod.widgets.BadgeFlat.draw_bg.pixel
mod.widgets.BadgePalette.neutral = #2a1d66
mod.widgets.BadgePalette.on_neutral = #f2ecff

// THE SPINNER: a ring of violet light-line one device pixel wide with a
// comet of the accent running round it, its tail a line of light three
// device pixels wide with a white-hot core, fading behind a small white-hot
// lamp at its head, the whole of it throwing a soft halo. The ring's centre
// is a pixel corner and its radius ends in a pixel's middle, so the tail
// lies on whole pixels. Dots are lamps of the accent; the bars are lines of
// light three device pixels wide, each on whole pixels.
// The quad grows past the spinner's box for the light, which falls beyond
// the box.
mod.widgets.SpinnerFlat.draw_bg.color = #2edaff
mod.widgets.SpinnerFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SpinnerFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let size = min(self.rect_size.x, self.rect_size.y)
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    let q = p - c
    var ink = self.color.rgb
    if self.status > 0.5 { ink = self.color_success.rgb }
    if self.status > 1.5 { ink = self.color_error.rgb }
    var stroke = self.stroke_width
    if stroke <= 0.0 { stroke = max(1.5, size * 0.10) }
    let r = n_mid(size * 0.5 - stroke * 0.5 - 1.0 - self.contained * size * 0.2, px)
    let t = self.draw_pass.time * self.speed
    let spin = 1.0 - self.morph
    var f = vec4(0.0, 0.0, 0.0, 0.0)
    if self.face < 0.5 || self.face > 2.5 {
        let ring = abs(length(q) - r)
        let sweep = fract(t - atan2(q.y, q.x) / 6.2831853)
        // The tail rises from nothing just ahead of the head, so its halo
        // has no seam where the head passes.
        let tail = pow(1.0 - sweep, 1.2) * smoothstep(0.0, 0.05, sweep)
        f = n_stroke(f, ring, 0.5 * px, px, n_violet(), 0.75, 0.0, 0.35, 0.12)
        f = n_stroke(f, ring, 1.5 * px, px, ink, min(tail * 1.6, 1.0), min(tail * 1.3, 1.0), 0.9 * tail, 0.55 * tail)
        let head = t * 6.2831853
        f = n_lamp(f, p, c + vec2(cos(head), sin(head)) * r, 2.4 * px, px, ink, 1.0)
    } else {
        if self.face < 1.5 {
            let rd = min(self.rect_size.x * 0.10, self.rect_size.y * 0.3)
            let w = t * 5.2
            f = n_lamp(f, p, vec2(self.rect_size.x * 0.2, c.y), rd, px, ink, 0.25 + 0.75 * max(0.0, sin(w)))
            f = n_lamp(f, p, vec2(self.rect_size.x * 0.5, c.y), rd, px, ink, 0.25 + 0.75 * max(0.0, sin(w - 1.1)))
            f = n_lamp(f, p, vec2(self.rect_size.x * 0.8, c.y), rd, px, ink, 0.25 + 0.75 * max(0.0, sin(w - 2.2)))
        } else {
            let bw = self.rect_size.x / 9.0
            let bi = clamp(floor(p.x / (bw * 2.0)), 0.0, 4.0)
            let bh = (self.rect_size.y * 0.5 - 2.0) * self.bar_height(bi, t * 6.0)
            let bx = n_mid(o.x + bw * (2.0 * bi + 0.5), px) - o.x
            let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
            let bl = max(bh - 1.5 * px, 0.0)
            let bar = mix(1000.0, n_seg(p, vec2(bx, c.y - bl), vec2(bx, c.y + bl)), inx)
            f = n_stroke(f, bar, 1.5 * px, px, ink, 1.0, 0.8, 0.5, 0.2)
        }
    }
    return f * spin * self.alpha
}

// INK. Words on the bright parts of the world carry a dark violet shadow
// about three device pixels round every glyph, so over the sun, a grid
// line, a ridge or the horizon a word keeps its edge; the shadow follows
// how bright the world is under the word (the ground's own geometry, read
// at the glyph's place in the window), so on the night sky none is drawn.
// The distance is read from the glyph's own field sampled twelve times
// softer than its edge. A glyph's quad is grown for the shadow, three and a
// half points to the right, two above and two and a half below, so the
// shadow fades out inside it, and the shadow of one letter runs on under
// the next and across the space after it, so a line of words sits on one
// dark band. Nothing grows to the left: the letter before is already drawn
// there, and a shadow laid over it would eat its edge. A glyph drawn from
// the curve atlas keeps the platform's own quad. Small labels come from the
// grayscale atlas, large ones from the multi-channel one; both carry it.
let n_text_base = mod.draw.DrawText.vertex
mod.widgets.Label.draw_text.ink_vertex = n_text_base
mod.widgets.Label.draw_text.vertex = fn() {
    self.ink_vertex()
    if self.texture_index < 2.5 {
        let lo = self.rect_pos - vec2(0.0, 2.0)
        let hi = self.rect_pos + self.rect_size + vec2(3.5, 2.5)
        let p = mix(lo, hi, self.geom.pos)
        let pc = clamp(clamp(p, self.draw_clip.xy, self.draw_clip.zw) + self.draw_list.view_shift, self.draw_list.view_clip.xy, self.draw_list.view_clip.zw)
        let pn = (pc - self.draw_list.view_shift - self.rect_pos) / max(self.rect_size, vec2(0.0001, 0.0001))
        self.pos = pn
        self.t = mix(self.t_min, self.t_max, pn)
        self.world = self.draw_list.view_transform * vec4(pc.x, pc.y, self.glyph_depth + self.draw_call.zbias, 1.0)
        self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
    }
}
mod.widgets.Label.draw_text.pixel = fn() {
    let rs = max(self.rect_size, vec2(0.0001, 0.0001))
    let q = self.pos * rs
    let inq = step(0.0, q.x) * step(q.x, rs.x) * step(0.0, q.y) * step(q.y, rs.y)
    let main = self.sample_text_pixel() * inq
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var w = 0.0
    var has = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let p = clamp(self.t.xy, self.t_min + half_texel, self.t_max - half_texel)
        w = self.sdf(scale * 12.0, p, vec4(0.5, 0.5, 0.5, 1.0))
        has = 1.0
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let p = clamp(self.t.xy, self.t_min + half_texel, self.t_max - half_texel)
        w = self.msdf(scale * 12.0, p, vec4(0.5, 0.5, 0.5, 1.0))
        has = 1.0
    }
    // Device pixels outside the glyph. Inside the ink's own box (the quad
    // less the pixel and a half it keeps round its ink) the glyph's field
    // says; at the quad's rim the field runs out, so from there on the
    // distance is taken to the ink's box, with the distance above counted
    // half again so the shadow keeps close over the line and does not
    // reach the line before it.
    let dpi = max(self.draw_pass.dpi_factor, 0.5)
    let m = 1.5 / dpi
    let hb = rs * 0.5
    let ob = max(abs(q - hb) - max(hb - vec2(m, m), vec2(0.0, 0.0)), vec2(0.0, 0.0)) * dpi
    let up = step(q.y, hb.y)
    let ol = length(vec2(ob.x, ob.y * mix(1.0, 1.5, up)))
    let out = max(ol, min(max((0.5 - w) * 12.0, 0.0), mix(3.0, 1.5, smoothstep(0.0, 0.5, ol))))
    // Device pixels in from the grown quad's edge; the left edge is the
    // glyph's own, so the shadow fades a little longer there.
    let e = min(min(rs.x + 3.5 - q.x, q.y + 2.0), rs.y + 2.5 - q.y) * dpi
    let keep = smoothstep(0.0, 1.5, e) * smoothstep(0.0, 2.5, q.x * dpi) * has * c.a
    // The shadow falls only where the ground under the word is bright, so
    // on the night sky and on dark glass no shape is drawn round a word.
    let vp = self.draw_pass.camera_projection * self.draw_pass.camera_view
    let k0 = vp * vec4(0.0, 0.0, 0.0, 1.0)
    let k1 = vp * vec4(100.0, 100.0, 0.0, 1.0)
    let ws = vec2(200.0 / max(abs(k1.x - k0.x), 0.000001), 200.0 / max(abs(k1.y - k0.y), 0.000001))
    let lift = smoothstep(0.04, 0.30, n_ground(self.world.xy, ws))
    let sh = (1.0 - smoothstep(1.0, 5.5, out)) * 0.88 * keep * lift
    let shadow = vec4(vec3(0.016, 0.008, 0.040) * sh, sh)
    return main + shadow * (1.0 - main.a)
}

