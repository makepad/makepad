    let r = self.border_radius
    let f = n_button(p, self.rect_pos, self.rect_size, px, vec4(r, r, r, r), n_cyan(), self.hover, self.down * self.hover, self.focus, self.disabled, 0.0, 1.0, 1.0, 0.0)
    return n_chevron(f, p, self.rect_size, px, self.hover, 1.0 - self.disabled)
}

// MENUS. A popup is a solid pane of dark violet glass, so nothing under it
// shows through its rows, in a cyan light-line with a white core; the row
// under the hand is washed with the hue and carries a lit bar at its left,
// three device pixels wide with a white-hot pixel down its middle.
let n_menu = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let d = Material.sd_box(p, size * 0.5, size * 0.5, 3.0)
    let yn = clamp(p.y / max(size.y, 1.0), 0.0, 1.0)
    let glass = vec4(mix(vec3(0.030, 0.018, 0.075), vec3(0.020, 0.012, 0.055), yn), 1.0)
    return n_tube(d, px, glass, n_cyan(), 0.9, 0.85, 0.45, 0.0, 3.0)
}
let n_row = fn(p: vec2, o: vec2, size: vec2, px: float, hover: float, active: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let hue = n_cyan()
    let on = max(hover, active) * live
    let wash = (0.12 * hover + 0.18 * active) * live
    var f = vec4(hue * wash, wash)
    let bx = n_mid(o.x + 4.0, px) - o.x
    let bar = Material.sd_box(p, vec2(bx, size.y * 0.5), vec2(1.5 * px, size.y * 0.5 - 4.0), 1.5 * px)
    let g = n_halo(bar, 0.5, 0.2) * on
    f = Finish.over(f, vec4(hue * g, g * 0.15))
    let core = Finish.cover(abs(p.x - bx) - 0.5 * px, px)
    return mix(f, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.85 * core), 1.0), Finish.cover(bar, px) * on)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return n_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return n_row(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, self.hover, self.active, self.disabled)
}
mod.widgets.PopupMenuItem.draw_text.color_active = #ffffff
mod.widgets.ComboBoxFlat.draw_popup_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return n_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.ComboBoxFlat.draw_item.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return n_row(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, self.hover, self.active, 0.0)
}

// ---------------------------------------------------------------------------
// PROGRESS. A dark slot in a light-line; the fill is a lit tube of the
// intent's hue with a white-hot line down its middle and a halo. The
// unknown amount is short slanted dashes of light along the whole track,
// each with its white-hot core and its halo, like the lane marks of a road
// at night, held still (a face may not read the pass clock, so it does not
// sweep).
let n_sun = fn() -> vec3 { return vec3(1.0, 0.74, 0.22) }
let n_mint = fn() -> vec3 { return vec3(0.22, 1.0, 0.62) }
let n_hues = fn(i: float) -> vec3 {
    var h = n_cyan()
    if i > 0.5 { h = n_mint() }
    if i > 1.5 { h = n_sun() }
    if i > 2.5 { h = n_red() }
    if i > 3.5 { h = vec3(0.30, 0.45, 1.0) }
    if i > 4.5 { h = n_dead() }
    return h
}
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let hue = n_hues(self.intent)
    let th = min(self.thickness, self.rect_size.y)
    let y0 = Finish.snap(o.y + (self.rect_size.y - th) * 0.5, px) - o.y
    let y1 = y0 + Finish.snap(th, px)
    let x0 = Finish.snap(o.x + self.rect_size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + self.rect_size.x * self.end, px) - o.x
    let c = vec2((x0 + x1) * 0.5, (y0 + y1) * 0.5)
    let h = vec2((x1 - x0) * 0.5, (y1 - y0) * 0.5)
    let d = Material.sd_box(p, c, h, 2.0)
    var f = n_slot(d, px, n_violet(), self.track, h.y) * self.track
    // The fill, one pixel in from the rim, its white-hot line one device
    // pixel on a whole row.
    let fi = d + px
    let core = Finish.cover(abs(p.y - (n_mid(o.y + c.y, px) - o.y)) - 0.5 * px, px)
    if self.value >= 0.0 {
        let xv = mix(x0, x1, clamp((self.value - self.start) / max(self.end - self.start, 0.0001), 0.0, 1.0))
        let fd = max(fi, p.x - xv)
        let on = step(x0 + 0.5, xv)
        let fa = Finish.cover(fd, px) * on
        let g = n_halo(fd, 0.6, 0.4) * on
        f = Finish.over(f, vec4(hue * g, g * 0.15))
        f = mix(f, vec4(mix(hue * 0.9, mix(hue, vec3(1.0, 1.0, 1.0), 0.8), core), 1.0), fa)
    } else {
        let fh = y1 - y0 - 2.0 * px
        let u = p.x + (p.y - y0) * 0.5
        let pitch = max(fh * 3.0, 9.0)
        let cell = (fract(u / pitch) - 0.5) * pitch
        let sd = max(fi, abs(cell) - pitch * 0.12)
        let inx = step(x0, p.x) * step(p.x, x1)
        let g = n_halo(sd, 0.30, 0.0) * inx
        f = Finish.over(f, vec4(hue * g, g * 0.15))
        let seg = Finish.cover(sd, px) * inx
        f = mix(f, vec4(mix(hue * 0.9, mix(hue, vec3(1.0, 1.0, 1.0), 0.75), core), 1.0), seg)
    }
    return f * self.opacity
}

// LEVEL METERS. A ladder of 2 point cells with a 1 point gap in a dark
// well rimmed by a violet light-line that glows past the well: cyan up to
// 70 %, sun yellow to 90 %, red above; an unlit cell keeps a seventh of its
// light; the lit cells glow into the well and their middles burn pale; the
// held peak burns white-hot; the over lamp beside the ladder lights red
// with its halo.
mod.widgets.LevelMeter.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.vertical)
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.vertical), mix(p0.y, p0.x, self.vertical))
    let lamp_room = self.lamp * (self.lamp_size + self.lamp_gap)
    let bar = max(4.0, along - lamp_room)
    let d = Material.sd_box(p, vec2(bar * 0.5, across * 0.5), vec2(bar * 0.5, across * 0.5), 1.5)
    var col = vec3(0.010, 0.006, 0.030)
    col = mix(col, n_violet() * 0.55, Finish.band(d, 0.0, px, px))
    let wa = Finish.cover(d, px)
    let pad = 2.0
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 3.0
    let ci = floor((p.x - pad) / pitch)
    let cx0 = pad + ci * pitch
    let share = clamp((cx0 + 1.0) / span, 0.0, 1.0)
    var hue = n_cyan()
    if share > 0.7 {
        hue = n_sun()
    }
    if share > 0.9 {
        hue = n_red()
    }
    let cell = Material.sd_box(p, vec2(cx0 + 1.0, across * 0.5), vec2(1.0, across * 0.5 - pad), 0.0)
    let inbar = step(0.0, ci) * step(cx0 + 2.0, bar - pad + 0.01)
    let lit = step(cx0 + 1.0, pad + span * self.level)
    let held = step(abs(cx0 + 1.0 - (pad + span * self.hold)), 1.5) * step(0.002, self.hold)
    let k = max(lit, held)
    // The well glows behind lit cells.
    let gl = n_halo(cell, 0.5, 0.0) * k * inbar
    col = col + hue * gl * step(0.0, 0.0 - d - px)
    let ca = Finish.cover(cell, px) * inbar
    let mid = 1.0 - smoothstep(0.0, across * 0.5 - pad, abs(p.y - across * 0.5))
    let lc = mix(hue, vec3(1.0, 1.0, 1.0), 0.35 * mid)
    col = mix(col, mix(mix(hue * 0.14, lc, k), vec3(1.0, 1.0, 1.0), 0.6 * held), ca)
    var f = vec4(col * wa, wa)
    // The well's light-line throws a violet halo, the lit run a halo of its
    // own hue past the well.
    let run = max(d, p.x - (pad + span * self.level))
    let gr = n_halo(run, 0.0, 0.35) * step(0.002, self.level) * (1.0 - wa)
    let gw = n_halo(d, 0.30, 0.10) * (1.0 - wa)
    f = f + vec4(n_cyan() * gr + n_violet() * gw, (gr + gw) * 0.15)
    if self.lamp > 0.5 {
        let lc2 = vec2(bar + self.lamp_gap + self.lamp_size * 0.5, across * 0.5)
        let ld = Material.sd_box(p, lc2, vec2(self.lamp_size * 0.5, across * 0.5), 1.5)
        let on = step(0.5, self.over)
        var lcol = mix(vec3(0.05, 0.01, 0.03), mix(n_red(), vec3(1.0, 1.0, 1.0), 0.3), on)
        lcol = mix(lcol, n_red() * 0.45, Finish.band(ld, 0.0, px, px) * (1.0 - on))
        let lg = n_halo(ld, 0.6, 0.4) * on
        f = Finish.over(f, vec4(n_red() * lg, lg * 0.15))
        f = mix(f, vec4(lcol, 1.0), Finish.cover(ld, px))
    }
    return f * self.opacity
}

// SCROLL BARS. A hairline violet light-line; the thumb a capsule in a cyan
// tube three device pixels wide with its core at rest, lit under the hand,
// burning while dragged. The capsule is seven pixels across, so its two
// long sides are two lines of light with a dark pixel of glass between
// them. The quad grows past the bar so the thumb's halo falls round it.
mod.widgets.ScrollBar.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    let p = vec2(mix(p0.x, p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let oa = mix(self.rect_pos.y, self.rect_pos.x, self.is_vertical)
    let mid = n_mid(oa + across * 0.5, px) - oa
    let hue = n_cyan()
    let inr = step(0.0, p.x) * step(p.x, along)
    let rail = Finish.cover(abs(p.y - mid) - px * 0.5, px) * 0.7 * inr
    var f = vec4(n_violet() * 0.55 * rail, rail)
    let a = along * self.norm_scroll
    let b = a + along * self.norm_handle
    let d = Finish.sd_pill(p, vec2((a + b) * 0.5, mid), vec2(max((b - a) * 0.5 - 1.0, 3.5 * px), 3.5 * px))
    let warm = max(self.hover, self.drag)
    let lit = mix(0.85, 1.0, warm)
    let glass = mix(vec3(0.022, 0.014, 0.060), hue, 0.25 * self.drag)
    f = Finish.over(f, n_tube(d, px, vec4(glass, 1.0), hue, lit, mix(0.6, 1.0, warm), 0.6 + 0.3 * warm, 0.40 + 0.3 * warm, 3.0))
    return f * self.opacity
}

// ---------------------------------------------------------------------------
// TABS. Every tab is a solid pane of dark violet glass, so the world does
// not show through it, outlined along its top and down its sides by a
// light-line that is brightest along the top and fades toward the foot,
// and every tab stands on the strip's rail, a violet light-line carried
// across the gaps between the tabs. A quiet tab's line is a dim violet
// round a faint core; the pointer warms it to a pink violet and lights its
// core; the tab in use is a cyan tube with a white-hot core and a wide
// halo over glass washed cyan from the top, open at its foot where the
// rail stops under it; a press floods the glass magenta; the focus draws a
// second ring. The rail is a light-line three device pixels wide on the
// strip's last three rows, a white-violet core between two violet rows.
let n_tab = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, active: float) -> vec4 {
    // A device pixel in from each side, so two tabs side by side keep a dark
    // gap of two between their walls.
    let lo = vec2(Finish.snap(o.x, px) + px, Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px) - px, Finish.snap(o.y + s.y, px)) - o
    let c = vec2((lo.x + hi.x) * 0.5, hi.y)
    let h = vec2((hi.x - lo.x) * 0.5, hi.y - lo.y)
    let d = Material.sd_box(p, c, h, 3.0)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let dn = min(down * 4.0, 1.0)
    let quiet = 1.0 - active
    let hv = max(hover, dn) * quiet
    var hue = mix(n_violet(), mix(n_violet(), n_magenta(), 0.45), hv)
    hue = mix(hue, n_magenta(), dn * quiet)
    hue = mix(hue, n_cyan(), active)
    let top = 1.0 - smoothstep(2.0, 6.0, p.y - lo.y)
    let fall = mix(1.0 - 0.45 * yn, 1.0, top)
    let lit = fall * mix(mix(0.55, 0.95, hv), 1.0, active)
    let hot = mix(mix(0.30, 0.85, hv), 1.0, active) * mix(0.55, 1.0, top)
    let wash = 0.07 * hv + 0.30 * dn * quiet + active * mix(0.20, 0.05, yn)
    let face = vec4(mix(n_glass(1.0 - yn), hue, wash) * 0.95, 0.95)
    let tight = (0.30 + 0.30 * hv + 0.30 * dn + 0.45 * active) * fall
    let wide = (0.16 + 0.22 * hv + 0.40 * dn + 0.50 * active) * fall
    var f = n_tube(d, px, face, hue, lit, hot, tight, wide, 3.0) * step(p.y, hi.y)
    // The rail along the foot: a white-violet core on the tab's second row
    // from the foot between two violet rows, running on past each side and
    // fading out two to three points beyond it, so it carries across the
    // gap to the next tab.
    let ry = abs(p.y - hi.y + 1.5 * px)
    let reach = smoothstep(lo.x - 3.0, lo.x - 1.0, p.x) * (1.0 - smoothstep(hi.x + 1.0, hi.x + 3.0, p.x))
    let open = active * step(lo.x + 1.0, p.x) * step(p.x, hi.x - 1.0)
    let rail = Finish.cover(ry - 0.5 * px, px) * reach * (1.0 - open)
    let body = Finish.cover(ry - 1.5 * px, px) * reach * (1.0 - open) * 0.85
    let rg = n_halo(ry - 1.5 * px, 0.40, 0.10) * reach * (1.0 - open) * (1.0 - body)
    f = Finish.over(vec4(n_violet() * rg, rg * 0.15), f)
    f = mix(f, vec4(n_violet(), 1.0), body)
    f = mix(f, vec4(mix(n_violet(), vec3(1.0, 1.0, 1.0), 0.6), 1.0), rail)
    return Finish.over(f, n_ring(d, px, 2.5, hue, focus) * step(p.y, hi.y))
}
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    return n_tab(p, self.rect_pos, self.rect_size, px, 0.0, 0.0, 0.0, 1.0)
}
