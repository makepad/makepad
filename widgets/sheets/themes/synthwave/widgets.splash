// The marks: a magenta light-line cross with a white core and a halo. The
// close mark stands on a disc of dark glass rimmed in violet, so it reads
// even where a long label runs under it; the add mark stands on the rail
// alone.
mod.widgets.Tabs.draw_mark.color = #ff5ccf
mod.widgets.Tabs.draw_mark.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px)) - self.rect_pos + vec2(0.5 * px, 0.5 * px)
    let sz = min(self.rect_size.x, self.rect_size.y)
    let r = sz * mix(0.20, 0.24, self.plus)
    let a = mix(0.7853981634, 0.0, self.plus)
    let ax = cos(a) * r
    let ay = sin(a) * r
    let s1 = n_seg(p, c - vec2(ax, ay), c + vec2(ax, ay))
    let s2 = n_seg(p, c + vec2(ay, 0.0 - ax), c - vec2(ay, 0.0 - ax))
    let close = 1.0 - self.plus
    let disc = length(p - c) - sz * 0.42
    let da = Finish.cover(disc, px) * close
    var f = vec4(vec3(0.024, 0.015, 0.060) * da, da)
    f = mix(f, vec4(n_violet() * 0.55, 1.0), Finish.band(disc, 0.0, px, px) * close)
    return n_stroke(f, min(s1, s2), 1.5 * px, px, n_magenta(), 1.0, 0.85, 0.55, mix(0.20, 0.40, self.plus))
}

