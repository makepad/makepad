mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let t = mix(self.active, self.drag_pos, self.drag)
    return n_switch(p, self.rect_pos, self.rect_size, px, sz, self.mark_at_end, t, self.hover, self.down, self.focus, self.active, self.error, self.disabled)
}

// The rocker and the slide switch share a square-cornered box in a tube.
// The key inside it has a tube of its own, kept off the frame's by a dark
// gap one device pixel wide on a switch under 15 points (the stock 14) and
// two on a larger one, so the two read as two lines: n_key_in is how far in
// from the box's edge the key's edge lies, in whole device pixels.
let n_key_in = fn(hy: float, px: float) -> float {
    return (3.0 + mix(1.0, 2.0, step(15.0, hy * 2.0))) * px
}
let n_switch_box = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: vec2, at_end: float) -> vec4 {
    let x0 = (rs.x - sz.x) * at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + rs.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    return vec4(lo, hi)
}
let n_switch_frame = fn(d: float, px: float, hue: vec3, hover: float, dn: float, focus: float, active: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let warm = max(max(active, dn), max(hover, focus) * 0.7)
    let face = mix(vec4(0.012, 0.008, 0.035, 1.0), vec4(0.020, 0.016, 0.045, 1.0), disabled)
    let tight = (0.45 + 0.22 * hover + 0.25 * active + 0.35 * dn) * live
    let wide = (0.28 + 0.16 * hover + 0.28 * active + 0.40 * dn) * live
    let f = n_tube(d, px, face, mix(hue, n_dead(), disabled), mix(mix(0.8, 1.0, warm), 0.8, disabled), mix(0.6, 1.0, warm) * live, tight, wide, 3.0)
    return Finish.over(f, n_ring(d, px, 3.0, hue, focus * live))
}

// The rocker: the box split at its pivot. The half in force is a key in a
// tube of its own, washed with the hue while on; on, its "I" burns white-hot,
// off, the "O" glows a dim violet; the other half's legend is a dead grey.
// It flips and never travels.
let n_rocker = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: vec2, at_end: float, hover: float, down: float, focus: float, active: float, err: float, disabled: float) -> vec4 {
    let b = n_switch_box(p, o, rs, px, sz, at_end)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 2.5)
    let hue = mix(n_cyan(), n_red(), err)
    let live = 1.0 - disabled
    let dn = min(down * 4.0, 1.0)
    var f = n_switch_frame(d, px, hue, hover, dn, focus, active, disabled)
    // The pivot: a faint violet light-line one device pixel wide down the
    // middle.
    let pc = n_mid(o.x + c.x, px) - o.x
    let pv = Finish.cover(abs(p.x - pc) - 0.5 * px, px) * step(abs(p.y - c.y), h.y - 2.0)
    f = mix(f, vec4(mix(n_violet(), n_dead(), disabled) * 0.45, 1.0), pv)
    // The two halves a key can fill: the gap from the frame's tube, and as
    // wide a gap from the pivot. The legends stand in their middles, sized
    // to the key's glass so they keep a dark pixel round them.
    let ki = n_key_in(h.y, px)
    let kgap = ki - 3.0 * px
    let lx0 = b.x + ki
    let lx1 = pc - 0.5 * px - kgap
    let rx0 = pc + 0.5 * px + kgap
    let rx1 = b.z - ki
    let kc = vec2(mix((lx0 + lx1) * 0.5, (rx0 + rx1) * 0.5, active), c.y)
    let kd = Material.sd_box(p, kc, vec2(mix(lx1 - lx0, rx1 - rx0, active) * 0.5, h.y - ki), 1.5)
    let kg = vec4(mix(vec3(0.030, 0.020, 0.075), hue, (0.24 * active + 0.10 * hover + 0.28 * dn) * live), 1.0)
    let kh = mix(mix(n_violet(), hue, active), n_dead(), disabled)
    f = Finish.over(f, n_tube(kd, px, kg, kh, mix(0.65, 1.0, active), active * live, 0.0, 0.0, 3.0))
    let ih = h.y - ki - 3.0 * px
    let at_o = vec2((lx0 + lx1) * 0.5, c.y)
    let at_i = vec2(n_mid(o.x + (rx0 + rx1) * 0.5, px) - o.x, c.y)
    let ring = abs(length(p - at_o) - max(ih - 1.5 * px, 1.5 * px))
    let ink_o = mix(mix(n_violet(), n_dead(), active), n_dead(), disabled)
    f = n_stroke(f, ring, 0.5 * px, px, ink_o, mix(0.85, 0.6, active), 0.0, 0.3 * (1.0 - active) * live, 0.0)
    let il = max(ih - 2.5 * px, 0.5 * px)
    let bar = n_seg(p, at_i - vec2(0.0, il), at_i + vec2(0.0, il))
    let ink_i = mix(mix(n_dead(), mix(hue, vec3(1.0, 1.0, 1.0), 0.5), active), n_dead(), disabled)
    return n_stroke(f, bar, 1.5 * px, px, ink_i, mix(0.6, 1.0, active), active * live, 0.5 * active * live, 0.25 * active * live)
}

// The slide switch: a key with three grip light-lines across it travels the
// box; the end it left carries a lamp while on and an open ring of dim
// violet light while off.
let n_slide = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: vec2, at_end: float, t: float, hover: float, down: float, focus: float, active: float, err: float, disabled: float) -> vec4 {
    let b = n_switch_box(p, o, rs, px, sz, at_end)
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, 2.5)
    let hue = mix(n_cyan(), n_red(), err)
    let live = 1.0 - disabled
    let dn = min(down * 4.0, 1.0)
    let warm = max(max(active, dn), max(hover, focus) * 0.7)
    var f = n_switch_frame(d, px, hue, hover, dn, focus, active, disabled)
    // The key: a square the gap in from the frame's tube, its edges on
    // whole pixels wherever it travels.
    let ki = n_key_in(h.y, px)
    let ks = h.y - ki
    let kx = Finish.snap(o.x + lo.x + ki + t * (hi.x - lo.x - 2.0 * ki - 2.0 * ks), px) - o.x
    let kc = vec2(kx + ks, c.y)
    let kd = Material.sd_box(p, kc, vec2(ks, ks), 1.5)
    let yn = clamp((p.y - kc.y + ks) / (2.0 * ks), 0.0, 1.0)
    let kg = vec4(mix(n_glass(yn), hue, (0.10 * hover + 0.28 * dn + 0.08 * active) * live), 1.0)
    let kh = mix(hue, n_dead(), disabled)
    f = Finish.over(f, n_tube(kd, px, kg, kh, mix(0.85, 1.0, warm), mix(0.5, 1.0, warm) * live, 0.0, 0.0, 3.0))
    // The grip: up to three light-lines one device pixel wide, a dark pixel
    // or more between them, on whole pixels in the key's glass with a dark
    // pixel between them and the key's tube on every side. A line with no
    // room for that is left out, so a small key keeps one line.
    let gs = max(Finish.snap(1.4, px), 2.0 * px)
    let gm = n_mid(o.x + kc.x, px) - o.x
    let gq = p.x - gm
    let gk = clamp(floor(gq / gs + 0.5), -1.0, 1.0)
    let room = step(abs(gm + gk * gs - kc.x) + px, ks - 3.0 * px)
    let grip = Finish.cover(abs(gq - gk * gs) - 0.5 * px, px) * step(abs(p.y - kc.y), ks - 4.0 * px) * room
    f = mix(f, vec4(mix(kh, vec3(1.0, 1.0, 1.0), 0.4 * live) * mix(0.75, 1.0, warm), 1.0), grip)
    let free = vec2(mix(hi.x - h.y, lo.x + h.y, t), c.y)
    let mr = h.y * 0.34
    f = n_stroke(f, abs(length(p - free) - mr), 0.5, px, mix(n_violet(), n_dead(), disabled), 0.8 * (1.0 - active), 0.0, 0.3 * (1.0 - active) * live, 0.0)
    return n_lamp(f, p, free, mr, px, hue, active * live)
}
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleRocker.draw_bg.size = uniform(14.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.0)
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    return n_rocker(p, self.rect_pos, self.rect_size, px, sz, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.error, self.disabled)
}
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleSlide.draw_bg.size = uniform(14.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(2.0)
mod.widgets.ToggleSlide.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let t = mix(self.active, self.drag_pos, self.drag)
    return n_slide(p, self.rect_pos, self.rect_size, px, sz, self.mark_at_end, t, self.hover, self.down, self.focus, self.active, self.error, self.disabled)
}

// ---------------------------------------------------------------------------
// SLIDERS. A dark slot with a light-line rim; the value is a lit line three
// device pixels wide down the slot's middle row, a white-hot core between
// two pixels of the hue, with a halo; the handle a glass disc in a tube with its
// core at rest, centred on a pixel's middle with a radius ending between two
// pixels, so its tube lies on whole pixels across and down. Hover lights the tube and a small lamp at the handle's
// centre; a drag floods the glass with the hue, burns the tube white and
// throws the halo wide with a larger lamp; focus draws the second ring round
// the handle.
let n_handle = fn(under: vec4, p: vec2, hc: vec2, r: float, px: float, hue: vec3, hover: float, focus: float, drag: float, live: float) -> vec4 {
    let hv = hover * live
    let dg = drag * live
    let warm = max(hv, dg)
    let k = n_disc(p, hc, r, px, hue, 0.10 * hv + 0.34 * dg, mix(0.85, 1.0, warm), mix(0.65, 1.0, warm) * live, (0.50 + 0.20 * hv + 0.40 * dg) * live, (0.32 + 0.15 * hv + 0.45 * dg) * live)
    var f = Finish.over(under, k)
    f = n_lamp(f, p, hc, mix(1.6, 2.6, dg), px, hue, max(hv * 0.8, dg))
    return Finish.over(f, n_ring(length(p - hc) - r, px, 2.5, hue, focus * live))
}
let n_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, pad: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let hue = mix(n_cyan(), n_dead(), disabled)
    let live = 1.0 - disabled
    // The slot's middle row is a whole pixel and its rims fall between rows.
    let y = n_mid(o.y + cy, px) - o.y
    let hh = n_mid(2.5, px)
    let x0 = Finish.snap(o.x + pad, px) - o.x
    let x1 = Finish.snap(o.x + rs.x - pad, px) - o.x
    let slot = Finish.sd_pill(p, vec2((x0 + x1) * 0.5, y), vec2((x1 - x0) * 0.5 + hh, hh))
    var f = n_slot(slot, px, mix(n_violet(), n_dead(), disabled), 1.0, hh)
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    let fill = n_seg(p, vec2(min(xf, xv), y), vec2(max(xf, xv), y))
    f = n_stroke(f, fill, 1.5 * px, px, hue, 1.0, 0.9 * live, (0.60 + 0.20 * hover + 0.30 * drag) * live, (0.38 + 0.15 * hover + 0.35 * drag) * live)
    return n_handle(f, p, vec2(n_mid(o.x + xv, px) - o.x, y), n_mid(6.5, px), px, hue, hover, focus, drag, live)
}

mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
// The minimal slider: a hairline light-line and the lit value; its handle
// only comes with the pointer or the focus.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let hue = mix(n_cyan(), n_dead(), self.disabled)
    let live = 1.0 - self.disabled
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y
    // The rail: a violet light-line one device pixel wide on a dark bed
    // three wide, so it reads as light on any ground.
    let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
    let ry = abs(p.y - y - 0.5 * px)
    let bed = Finish.cover(ry - px * 1.5, px) * inx * 0.85
    let ra = Finish.cover(ry - px * 0.5, px) * inx
    let rg = n_halo(ry - px * 0.5, 0.25, 0.0) * inx * (1.0 - bed)
    var f = vec4(vec3(0.020, 0.012, 0.050) * bed, bed)
    f = mix(f, vec4(mix(n_violet(), n_dead(), self.disabled) * 0.85, 1.0), ra)
    f = f + vec4(n_violet() * rg, rg * 0.15) * live
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(0.0, lo, self.arc_origin) * self.rect_size.x
    let b = mix(self.slide_pos, hi, self.arc_origin) * self.rect_size.x
    // The value lies on the rail's bed, its core on the rail's own row.
    let ym = y + 0.5 * px
    f = n_stroke(f, n_seg(p, vec2(a, ym), vec2(b, ym)), 1.5 * px, px, hue, 1.0, 0.9 * live, (0.60 + 0.20 * self.hover + 0.30 * self.drag) * live, (0.36 + 0.15 * self.hover + 0.35 * self.drag) * live)
    let hc = vec2(n_mid(o.x + self.slide_pos * self.rect_size.x, px) - o.x, ym)
    let shown = max(max(self.hover, self.drag), self.focus) * live
    let k = n_handle(vec4(0.0, 0.0, 0.0, 0.0), p, hc, n_mid(5.0, px), px, hue, self.hover, self.focus, self.drag, live)
    return Finish.over(f, k * shown)
}
// The bar slider: label and value above, the slot below.
mod.widgets.SliderFlat.height = 34.0
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let cy = 18.0 + (self.rect_size.y - 18.0) * 0.5
    return n_slider(p, self.rect_pos, self.rect_size, px, cy, 7.0, to, from, self.hover, self.focus, self.drag, self.disabled)
}
// The round slider: a capsule well beside its label in a tube, filled with
// the lit value as a capsule of its own.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let hue = mix(n_cyan(), n_dead(), self.disabled)
    let live = 1.0 - self.disabled
    let hv = self.hover * live
    let dg = self.drag * live
    // The well stops short of the value, which stands on its own to the
    // right of it.
    let lo = vec2(Finish.snap(o.x + self.label_size, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 34.0, px), Finish.snap(o.y + self.rect_size.y - 2.0, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let well = Finish.sd_pill(p, c, h)
    var f = n_tube(well, px, vec4(0.010, 0.006, 0.030, 1.0), hue, mix(0.65, 0.9, max(hv, dg)), 0.4 * live, (0.30 + 0.15 * hv) * live, (0.12 + 0.12 * hv) * live, 3.0)
    let ins = 3.5
    let fh = h.y - ins
    let xv = mix(lo.x + ins + fh, hi.x - ins - fh, self.slide_pos)
    let fill = Finish.sd_pill(p, vec2((lo.x + ins + xv + fh) * 0.5, c.y), vec2((xv + fh - lo.x - ins) * 0.5, fh))
    let fa = Finish.cover(fill, px)
    // The fill's white-hot line is one device pixel on a whole row.
    let core = Finish.cover(abs(p.y - (n_mid(o.y + c.y, px) - o.y)) - 0.5 * px, px)
    let g = n_halo(fill, (0.55 + 0.20 * hv + 0.30 * dg) * live, (0.30 + 0.15 * hv + 0.35 * dg) * live)
    f = Finish.over(f, vec4(hue * g, g * 0.15))
    f = mix(f, vec4(mix(hue * 0.9, mix(hue, vec3(1.0, 1.0, 1.0), 0.8), core * live), 1.0), fa)
    f = n_lamp(f, p, vec2(xv, c.y), mix(2.0, 2.8, dg), px, vec3(1.0, 1.0, 1.0), max(hv * 0.8, dg))
    return Finish.over(f, n_ring(well, px, 2.5, hue, self.focus * live))
}

// The range slider: the bar slider's slot, the value lit between the two
// ends, a glass disc on each end; the end under the pointer burns bright.
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let o = self.rect_pos
    let hue = mix(n_cyan(), n_dead(), self.disabled)
    let live = 1.0 - self.disabled
    let rad = self.handle_px * 0.5
    let y = n_mid(o.y + self.label_px + (self.rect_size.y - self.label_px) * 0.5, px) - o.y
    let hh = n_mid(2.5, px)
    let x0 = self.inset_px + rad
    let x1 = self.rect_size.x - self.inset_px - rad
    let slot = Finish.sd_pill(p, vec2((x0 + x1) * 0.5, y), vec2((x1 - x0) * 0.5 + hh, hh))
    var f = n_slot(slot, px, mix(n_violet(), n_dead(), self.disabled), 1.0, hh)
    let span = self.rect_size.x - self.inset_px * 2.0 - self.handle_px
    let sx = self.inset_px + rad + self.start_pos * span
    let ex = self.inset_px + rad + self.end_pos * span
    f = n_stroke(f, n_seg(p, vec2(sx, y), vec2(ex, y)), 1.5 * px, px, hue, 1.0, 0.9 * live, (0.60 + 0.20 * self.hover + 0.30 * self.drag) * live, (0.38 + 0.15 * self.hover + 0.35 * self.drag) * live)
    let hs = clamp(self.hover * self.hot_start, 0.0, 1.0)
    let he = clamp(self.hover * self.hot_end, 0.0, 1.0)
    let ds = clamp(self.drag * (self.hot_start + self.hot_band), 0.0, 1.0)
    let de = clamp(self.drag * (self.hot_end + self.hot_band), 0.0, 1.0)
    let hr = n_mid(min(rad, 6.0), px)
    f = n_handle(f, p, vec2(n_mid(o.x + sx, px) - o.x, y), hr, px, hue, hs, 0.0, ds, live)
    return n_handle(f, p, vec2(n_mid(o.x + ex, px) - o.x, y), hr, px, hue, he, 0.0, de, live)
}

// FADERS. The same slot stood on end, violet light-line ticks either side
// of it, and a glass cap in a tube with a white-hot line across its middle.
// A drag floods the cap and throws its halo wide; focus rings it.
mod.widgets.SliderFader.cap_size = 10.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    // Track space: a runs from the value's zero, b across.
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let hue = mix(n_cyan(), n_dead(), self.disabled)
    let live = 1.0 - self.disabled
    let hv = self.hover * live
    let dg = self.drag * live
    let warm = max(hv, dg)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    // The window's position of the across axis and of the track's start,
    // and the way the track runs in the window, so its lines can be laid
    // on whole pixels: the slot's middle on a pixel row, its rims and the
    // cap's edges between rows.
    let oa = mix(self.rect_pos.y, self.rect_pos.x, self.is_vertical)
    let ob = mix(self.rect_pos.x, self.rect_pos.y + self.rect_size.y, self.is_vertical)
    let sg = mix(1.0, -1.0, self.is_vertical)
    let mid = n_mid(oa + across * 0.5, px) - oa
    let hh = n_mid(2.5, px)
    let slot = Finish.sd_pill(p, vec2(along * 0.5, mid), vec2(along * 0.5 - self.inset_px + hh, hh))
    var f = n_slot(slot, px, mix(n_violet(), n_dead(), self.disabled), 1.0, hh)
    // Ticks of violet light either side: long at the ends and the middle,
    // short between.
    let tq = (p.x - foot) / travel * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * travel / 10.0
    let major = min(step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti), 1.0)
    let tl = mix(3.0, 6.0, major)
    let tb = abs(abs(p.y - mid) - 5.5 - tl * 0.5) - tl * 0.5
    let inside = step(-0.5, ti) * step(ti, 10.5)
    let tick = Finish.cover(tb, px) * Finish.cover(tx - px * 0.5, px) * inside
    f = Finish.over(f, vec4(mix(n_violet(), n_dead(), self.disabled) * mix(0.55, 0.9, major), 1.0) * tick)
    let a = foot + self.fill_lo * travel
    let b = foot + self.fill_hi * travel
    f = n_stroke(f, n_seg(p, vec2(a, mid), vec2(b, mid)), 1.5 * px, px, hue, 1.0, 0.9 * live, (0.60 + 0.45 * hv + 0.30 * dg) * live, (0.38 + 0.40 * hv + 0.35 * dg) * live)
    // The cap, its edges on whole pixels and its line on the pixel at its
    // middle. Hover washes its glass and widens its halo.
    let at = foot + self.slide_pos * travel
    let ca0 = sg * (Finish.snap(ob + sg * (at - self.cap_px * 0.5), px) - ob)
    let ca1 = sg * (Finish.snap(ob + sg * (at + self.cap_px * 0.5), px) - ob)
    let ch = n_mid(9.0, px)
    let cap = Material.sd_box(p, vec2((ca0 + ca1) * 0.5, mid), vec2(abs(ca1 - ca0) * 0.5, ch), 2.0)
    let yn = clamp((p.y - mid + ch) / (2.0 * ch), 0.0, 1.0)
    let glass = mix(n_glass(yn), hue, 0.30 * hv + 0.34 * dg)
    var cf = n_tube(cap, px, vec4(glass, 1.0), hue, mix(0.85, 1.0, warm), mix(0.65, 1.0, warm) * live, (0.50 + 0.60 * hv + 0.40 * dg) * live, (0.32 + 0.55 * hv + 0.45 * dg) * live, 3.0)
    let lx = sg * (n_mid(ob + sg * (ca0 + ca1) * 0.5, px) - ob)
    let line = n_seg(p, vec2(lx, mid - 5.5), vec2(lx, mid + 5.5))
    cf = n_stroke(cf, line, 1.5 * px, px, mix(hue, vec3(1.0, 1.0, 1.0), 0.5), 1.0, live, (0.4 + 0.3 * dg) * live, 0.0)
    cf = Finish.over(cf, n_ring(cap, px, 2.5, hue, self.focus * live))
    return Finish.over(f, cf)
}

// ROTARIES. A neon ring round a setting sun: the whole travel a thin dim
// violet light-line, the value a lit arc three device pixels wide with a
// white-hot core and a halo,
// both laid on a body of dark glass; inside the ring, past a dark rim that
// keeps the arc readable, the face is a striped sun going down, and it
// stands upright whatever the value. The sun's glow lies behind it and on
// the rim: its cuts open on the glow and run out into it, and it is gone
// before the arc, as the arc's light is gone before the sun. The pointer is
// a pin that never crosses the sun: a white bead on the ring at the value
// and a tick from it across the rim toward the sun. Hover warms the glow, a
// drag burns the pin and throws the arc's halo wide, focus rings the dial,
// and a disabled knob is a dim ghost of the sun in a dead ring.

// The sun's colour from its crown (v 0) to its foot (v 1): pale yellow
// through orange and coral to hot pink and magenta.
let n_sun_ramp = fn(v: float) -> vec3 {
    var s = mix(vec3(1.0, 0.96, 0.62), vec3(1.0, 0.84, 0.28), smoothstep(0.0, 0.22, v))
    s = mix(s, vec3(1.0, 0.56, 0.22), smoothstep(0.18, 0.42, v))
    s = mix(s, vec3(1.0, 0.34, 0.36), smoothstep(0.38, 0.58, v))
    s = mix(s, vec3(1.0, 0.20, 0.56), smoothstep(0.55, 0.76, v))
    return mix(s, vec3(0.90, 0.10, 0.74), smoothstep(0.74, 0.96, v))
}

// The sun's glow at its full strength by height on the disc: a dusky pink
// where the cuts begin and a violet magenta haze at the foot. By the pale
// crown it is a coral corona on a big knob, `big` 1, and faint on a small
// one, whose rim is too narrow to let it fall off, so its crown stays clean
// on the dark.
let n_sun_glow = fn(v: float, big: float) -> vec3 {
    let crown = mix(vec3(0.16, 0.07, 0.09), vec3(0.44, 0.20, 0.19), big)
    let g = mix(crown, vec3(0.46, 0.17, 0.32), smoothstep(0.06, 0.34, v))
    return mix(g, vec3(0.42, 0.08, 0.42), smoothstep(0.40, 0.95, v))
}

// The sun's disc, q points from its centre and rs points in radius: the ramp
// with a white heat at its crown, its lower part cut by horizontal gaps that
// begin about a quarter of the way down and widen toward the foot while the
// bands of sun between them thin. A gap shows `sky`, the glass and the glow
// behind the sun. There are n cuts, chosen by the knob from its size in
// points, so a knob has as many cuts at every pixel density; they are laid
// out in whole device pixels from a centre in the middle of a pixel, the
// disc's radius ending between two pixels, so every edge falls between two
// pixel rows and stays crisp. A disabled sun is a dim
// ghost of the ramp, lavender at the crown and plum at the foot, with glass
// in the cuts. Returns the colour in rgb (not premultiplied) and the disc's
// cover in a.
let n_sun_face = fn(q: vec2, rs: float, n: float, px: float, sky: vec3, glass: vec3, disabled: float) -> vec4 {
    let r = floor(rs / px + 0.5)
    let yq = q.y / px
    let v = clamp((yq + r - 0.5) / (2.0 * r - 1.0), 0.0, 1.0)
    let ramp = n_sun_ramp(v)
    let col = mix(ramp, vec3(1.0, 1.0, 0.92), 0.6 * exp(0.0 - v * v * 45.0))
    // The n cuts have a period of t pixels, the last ending at the foot;
    // each period opens with its gap, a fifth of the period at the top and
    // three quarters at the foot, less where there are only two or three
    // cuts so the foot keeps a lip of sun.
    let t = floor(1.46 * r / n + 0.5)
    let y = yq - (r - 0.5 - n * t)
    let k = clamp(floor(y / t), 0.0, n - 1.0)
    let fu = y - k * t
    let f1 = mix(0.45, 0.78, clamp((n - 2.0) * 0.5, 0.0, 1.0))
    let g = floor(t * mix(0.22, f1, k / max(n - 1.0, 1.0)) + 0.5)
    let cut = clamp(min(fu, g - fu) + 0.5, 0.0, 1.0) * step(0.0, y)
    let ghost = mix(mix(vec3(0.21, 0.18, 0.28), vec3(0.22, 0.08, 0.25), smoothstep(0.15, 0.95, v)), glass, cut)
    return vec4(mix(mix(col, sky, cut), ghost, disabled), Finish.cover(length(q) - (r - 0.5) * px, px))
}

let n_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let hue = mix(n_cyan(), n_dead(), disabled)
    let live = 1.0 - disabled
    let hv = hover * live
    let dg = drag * live
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let q = p - c
    let len = length(q)
    let w = clamp(rad * 0.045, 0.9, 1.8)
    // The centre is the middle of a pixel and the ring's radius a whole
    // number of pixels, so the arc and its core lie on whole pixels where it
    // runs across and down, and so does the pin when it points straight up
    // or across.
    let ra = Finish.snap(rad - w - 1.0, px)
    // The body: dark glass out to the middle of the ring.
    let yn = clamp((q.y + ra) / (2.0 * ra), 0.0, 1.0)
    let glass = n_glass(yn) * 0.75
    let ba = Finish.cover(len - ra, px)
    var f = vec4(glass * ba, ba)
    // The sun's radius leaves a dark rim inside the ring. The glow is light
    // added on the glass: at its full strength behind the sun, where its cuts
    // show it, and from the sun's edge falling off across the rim, a close
    // glow and a softer one, gone by the ring. Hover warms and brightens it,
    // still well under the sun's own colour.
    let ru = ra - w - max(rad * 0.13, 2.0)
    let rs = Finish.snap(ru, px)
    let rim = max(ra - w - rs, 1.0)
    let out = max(len - rs, 0.0)
    let vs = clamp((q.y + rs) / (2.0 * rs), 0.0, 1.0)
    let glow = (n_sun_glow(vs, smoothstep(3.0, 8.0, rim)) + vec3(0.04, 0.025, 0.0) * hv) * (1.0 + 0.18 * hv) * live
    let fall = (0.55 * exp(0.0 - out / max(rim * 0.30, px)) + 0.45 * exp(0.0 - out / max(rim * 0.85, px))) * (1.0 - smoothstep(rim * 0.55, rim, out))
    f = vec4(f.rgb + glow * fall * ba, f.a)
    // The ring, its light kept off the rim: inside the ring its halo falls
    // away to nothing by the sun's edge, so the rim stays dark and the arc
    // reads against it.
    // The pointer over the knob lights the whole travel and widens the arc's
    // halo.
    let rail = n_arc(q, ra, a0, a0 + span)
    let vio = mix(n_violet(), n_dead(), disabled)
    var lr = n_stroke(vec4(0.0, 0.0, 0.0, 0.0), rail, 0.5 * px, px, mix(vio, mix(n_violet(), n_magenta(), 0.45), hv), mix(0.6, 1.0, hv), 0.0, (0.25 + 0.45 * hv) * live, 0.0)
    lr = n_stroke(lr, n_arc(q, ra, s0, s1), 1.5 * px, px, hue, 1.0, 0.95 * live, (0.60 + 0.70 * hv + 0.30 * dg) * live, (0.40 + 0.60 * hv + 0.35 * dg) * live)
    f = Finish.over(f, lr * smoothstep(rs, ra - w, len))
    // The travel ends: two short ticks of violet light.
    let e0 = vec2(0.0 - sin(a0), cos(a0))
    let e1 = vec2(0.0 - sin(a0 + span), cos(a0 + span))
    let t0 = n_seg(q, e0 * (ra + w + 1.0), e0 * (ra + w + 3.0))
    let t1 = n_seg(q, e1 * (ra + w + 1.0), e1 * (ra + w + 3.0))
    f = mix(f, vec4(vio * 0.9, 1.0), Finish.cover(min(t0, t1) - px * 0.5, px))
    // The pointer, a pin at the value: a white-hot tick across the rim and a
    // bead on the ring, white at its heart and pale cyan at its edge in a
    // cyan halo, so it stands clear of the arc's end and reads where the arc
    // is empty. The pin fades as it nears the sun, so no light of it falls
    // on the disc. The tick is a line of light three device pixels wide; a
    // drag burns it brighter.
    let dir = vec2(0.0 - sin(av), cos(av))
    let pw = 1.5 * px
    let ink = mix(mix(hue, vec3(1.0, 1.0, 1.0), 0.45), n_dead(), disabled)
    var pin = n_stroke(vec4(0.0, 0.0, 0.0, 0.0), n_seg(q, dir * rs, dir * ra), pw, px, ink, 1.0, live * (0.75 + 0.25 * dg), (0.40 + 0.30 * dg) * live, (0.10 + 0.25 * dg) * live)
    let br = max(w * 1.7, 1.7) * (1.0 + 0.15 * max(dg, hv))
    let bq = length(q - dir * ra)
    let bg = n_halo(bq - br, 0.30 + 0.50 * hv + 0.30 * dg, 0.08 + 0.40 * hv + 0.22 * dg) * live
    pin = Finish.over(pin, vec4(hue * bg, bg * 0.15))
    let bc = mix(vec3(1.0, 1.0, 1.0), mix(hue, vec3(1.0, 1.0, 1.0), 0.65), smoothstep(0.40, 1.0, bq / br))
    pin = mix(pin, vec4(mix(bc, n_dead(), disabled), 1.0), Finish.cover(bq - br, px))
    f = Finish.over(f, pin * smoothstep(rs, rs + rim * 0.5, len))
    // The sun, over the glass and its glow, with a cut for every 5.7 points
    // of its radius: two on the smallest knobs, three on a panel knob, up to
    // seven on a big one.
    let sf = n_sun_face(q, rs, clamp(floor(ru / 5.667 + 0.5), 2.0, 7.0), px, glass + glow, glass, disabled)
    f = mix(f, vec4(sf.rgb, 1.0), sf.a)
    return Finish.over(f, n_ring(len - ra - 1.5 * px, px, 3.0, hue, focus * live))
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let c = vec2(n_mid(self.rect_pos.x + self.rect_size.x * 0.5, px), n_mid(self.rect_pos.y + 22.0 + dia * 0.5, px)) - self.rect_pos
    return n_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(n_mid(self.rect_pos.x + self.rect_size.x * 0.5, px), n_mid(self.rect_pos.y + self.rect_size.y - dia * 0.5, px)) - self.rect_pos
    return n_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A dark well edge-lit by a magenta tube: the second voice is
// the voice of input. Hover warms the tube, focus burns it white-hot with
// its halo and the second ring. A field whose frame is switched off (the
// value inside a slider) draws nothing.
let n_field = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let hue = n_magenta()
    let live = 1.0 - disabled
    let dn = min(down * 4.0, 1.0)
    let on = max(focus, dn)
    let warm = max(on, hover * 0.7)
    let lit = mix(0.85, 1.0, warm)
    // The well: a little lighter at its foot, washed with the hue while
    // the pointer is held in it.
    let well = mix(mix(vec3(0.010, 0.006, 0.032), vec3(0.022, 0.012, 0.055), yn), hue, (0.06 * hover + 0.16 * dn) * live)
    let face = mix(vec4(well, 1.0), vec4(0.020, 0.016, 0.045, 1.0), disabled)
    let tight = (0.50 + 0.22 * hover + 0.30 * focus + 0.35 * dn) * live + 0.10 * disabled
    let wide = (0.32 + 0.16 * hover + 0.30 * focus + 0.40 * dn) * live + 0.04 * disabled
    let f = n_tube(d, px, face, mix(hue, n_dead(), disabled), mix(lit, 0.8, disabled), mix(0.65, 1.0, warm) * live + 0.22 * disabled, tight, wide, 3.0)
    return Finish.over(f, n_ring(d, px, 3.5, hue, focus * live))
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.border_size < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    return n_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.down, self.focus, self.disabled)
}
mod.widgets.TextInputFlat.draw_text.color = #f4ecff
mod.widgets.TextInputFlat.draw_text.color_hover = #ffffff
mod.widgets.TextInputFlat.draw_text.color_focus = #ffffff
mod.widgets.TextInputFlat.draw_text.color_disabled = #57537a
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    return n_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, 0.0, self.focus, self.disabled)
}
// The stepper: two halves split by a magenta light-line, the held half
// washed with the hue, and a magenta glow under each arrow so the arrows
// read as lit.
mod.widgets.NumberSpin.draw_text.color = #ff8fe0
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let mid = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let upper = step(p.y, mid)
    let live = 1.0 - self.disabled
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let down = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let wash = 0.10 * hot + 0.28 * down
    var f = vec4(n_magenta() * wash, wash)
    let groove = Finish.cover(abs(p.y - mid) - px * 0.5, px) * step(3.0, p.x) * step(p.x, self.rect_size.x - 3.0)
    let side = Finish.cover(abs(p.x - px * 0.5) - px * 0.5, px) * step(4.0, p.y) * step(p.y, self.rect_size.y - 4.0)
    let g = max(groove, side) * 0.5 * live
    f = Finish.over(f, vec4(n_magenta() * g, g))
    let ac = vec2(self.rect_size.x * 0.5, mix(self.rect_size.y * 0.75, self.rect_size.y * 0.25, upper))
    let ag = n_halo(length(p - ac) - 2.0, 0.40, 0.06) * live * (0.8 + 0.5 * max(hot, down))
    return Finish.over(f, vec4(n_magenta() * ag, ag * 0.15))
}

// DROP-DOWNS. The button's glass and tube with a lit chevron 11 points in
// from the right; open, the tube burns fully.
let n_chevron = fn(under: vec4, p: vec2, s: vec2, px: float, lit: float, live: float) -> vec4 {
    let c = vec2(s.x - 11.0, s.y * 0.5)
    let ch = min(n_seg(p, c + vec2(-3.0, -1.5), c + vec2(0.0, 1.5)), n_seg(p, c + vec2(0.0, 1.5), c + vec2(3.0, -1.5)))
    let hue = mix(n_dead(), mix(n_cyan(), vec3(1.0, 1.0, 1.0), 0.5), live)
    return n_stroke(under, ch, 1.5 * px, px, hue, 1.0, 0.0, (0.25 + 0.3 * lit) * live, 0.0)
}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(36.0, 36.0)) - vec2(18.0, 18.0)
    let r = self.border_radius
    let f = n_button(p, self.rect_pos, self.rect_size, px, vec4(r, r, r, r), n_cyan(), self.hover, self.down * self.hover, max(self.focus, self.active), self.disabled, 0.0, 1.0, 1.0, 0.0)
    return n_chevron(f, p, self.rect_size, px, max(self.hover, self.active), 1.0 - self.disabled)
}
mod.widgets.DropDownFlat.draw_text.color = #e9fbff
mod.widgets.DropDownFlat.draw_text.color_hover = #ffffff
mod.widgets.DropDownFlat.draw_text.color_focus = #ffffff
mod.widgets.DropDownFlat.draw_text.color_disabled = #57537a
mod.widgets.ComboBoxFlat.clip_x = false
mod.widgets.ComboBoxFlat.clip_y = false
mod.widgets.ComboBoxFlat.draw_bg.vertex = fn() {
    let v = n_grow(self.rect_pos, self.rect_size, self.geom.pos, self.draw_clip, self.draw_list.view_shift, self.draw_list.view_clip, 18.0)
    self.pos = (v.xy - v.zw) / (self.rect_size + vec2(36.0, 36.0))
    self.world = self.draw_list.view_transform * vec4(v.x, v.y, self.draw_depth + self.draw_call.zbias, 1.0)
    self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
}
mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
