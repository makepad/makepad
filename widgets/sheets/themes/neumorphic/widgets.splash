// The primary is the one filled face: the accent all over, raised and lit
// as the page's faces are, with a white label. The rest of its family keep
// the page's face and speak through their labels alone, the destructive one
// in red.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 1.0, 0.0, 0.0, vec4(0.220, 0.376, 0.839, 1.0)), m)
}
