// INSTRUMENTS. The displays, lamps and hardware switches are the same pale
// material as the controls round them: a display is a window pressed into
// the page, a lamp a small raised dome on it, and a switch a pill well with
// a raised round key in it. None of them draws a line: every edge is light
// or shade on a shoulder.

// The well an instrument is cut into, a step under the page and a hair
// cooler: the shade of a screen's face (`theme.color_screen`) and of a
// switch's slot.
let nm_well_shade_g = fn() -> vec3 {
    return vec3(0.886, 0.902, 0.925)
}

// A window pressed into the page, `base` its face: the page's shadow falls
// in from the top left and light gathers at the bottom right, as deep as
// the sheet's wells go and held to the window's own scale up to 40 points,
// so a tall screen does not take a panel's shadow. `depth` 1 is the stock
// recess of 4 points, 0 a face flush with the page.
let nm_window_g = fn(base: vec3, p: vec2, c: vec2, h: vec2, r: float, d: float, px: float, depth: float) -> vec3 {
    let s = clamp(2.0 * min(h.x, h.y), 16.0, 40.0)
    return nm_well(base, p, c, h, r, d, px, s, 1.15 * clamp(depth, 0.0, 1.5))
}

// An accent fill lying in a well: the page's shadow still falls in across
// its top left and light still gathers at its bottom right, in the fill's
// own colour, so a lit well sits as deep as an unlit one. `s` is the well's
// own height.
let nm_fill_well_g = fn(fill: vec3, p: vec2, c: vec2, h: vec2, r: float, s: float) -> vec3 {
    let dk = Finish.inset(p, c, h, r, vec2(0.04 * s, 0.06 * s), max(0.075 * s, 0.9))
    let lt = Finish.inset(p, c, h, r, vec2(-0.03 * s, -0.05 * s), max(0.07 * s, 0.8))
    let o = fill * (1.0 - 0.28 * dk)
    return mix(o, min(fill * 1.16, vec3(1.0, 1.0, 1.0)), lt * 0.45)
}

// A small dome of colour `face` over the box centred on `c` with half size
// `h` and round ends: lighter toward the top left where the light falls,
// deeper toward the bottom right, its shoulder rolling into light on the
// one side and into shade on the other. Soft all over: no rim, no glint.
let nm_dome_g = fn(face: vec3, p: vec2, c: vec2, h: vec2) -> vec3 {
    let ex = max(h.x - h.y, 0.0)
    let dx = p.x - c.x
    let q = vec2(dx - clamp(dx, 0.0 - ex, ex), p.y - c.y) / max(h.y, 0.5)
    // -1 at the top left, toward the light, to 1 at the bottom right.
    let g = clamp((q.x + q.y) * 0.7071, -1.0, 1.0)
    let shoulder = smoothstep(0.4, 1.0, length(q))
    var col = min(face * (1.0 - 0.07 * g), vec3(1.0, 1.0, 1.0))
    col = mix(col, face * 0.82, shoulder * smoothstep(-0.2, 0.9, g) * 0.6)
    col = mix(col, min(face + vec3(0.12, 0.12, 0.12), vec3(1.0, 1.0, 1.0)), shoulder * (1.0 - smoothstep(-0.9, 0.2, g)) * 0.5)
    return col
}

// SCREENS. A display is a window let into the page, not a pane of glass in
// a bezel: no ring, no frame and no lip, only the well itself, its face the
// screen's shade and its corner 10 points, and what it holds sits in it in
// slate. `recess` still sets how deep it lies, and scan lines still draw.
mod.widgets.ScreenView.draw_bg.border_radius = uniform(10.0)
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + self.rect_size.x, px), Finish.snap(org.y + self.rect_size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(self.border_radius, min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    var face = self.color.rgb
    if self.scan > 0.0 {
        face = face * Finish.scan(p.y - (c.y - h.y), px, 3.0 * px, self.scan)
    }
    var col = nm_window_g(face, p, c, h, r, d, px, self.recess / 4.0)
    col = col + vec3(nm_grain(org + p, px))
    let a = Finish.cover(d, px) * self.color.a
    return vec4(col * a, a)
}
// The glass keeps only its soft diagonal band, at the strength a page asks
// for and none by default; the light line the stock laid inside its top
// edge goes with the frame.
mod.widgets.ScreenView.sheen = 0.0
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, min(self.face_radius, min(c.x, c.y)))
    let u = p / max(self.rect_size, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let a = clamp(self.sheen * band, 0.0, 1.0) * Finish.cover(d + px, px)
    return vec4(a, a, a, a)
}

// THE NEEDLE METER. Its face is a window like a screen's, with a 10 point
// corner and the scale printed on it in slate: a tick at every division,
// the majors two device pixels wide and the minors one and paler, a faint
// arc under them, and the red zone a band just outside the arc. The needle
// is slate, a point wide, with a soft shadow on the face under it, and its
// root stands under a small raised dome of the page that throws the
// sheet's two shadows. No rim and no sheen.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(10.0)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + self.rect_size.x, px), Finish.snap(org.y + self.rect_size.y, px)) - org
    let c = (lo + hi) * 0.5
    let hc = (hi - lo) * 0.5
    let fr = min(self.border_radius, min(hc.x, hc.y))
    let face_d = Material.sd_box(p, c, hc, fr)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    var col = self.color.rgb
    // The scale: a tick at every division over a faint arc.
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, -q.y * cos(ak) + q.x * sin(ak))
    col = mix(col, self.color_scale.rgb, max(arc * 0.4, tick * mix(0.6, 1.0, major)))
    // The red zone: a band just outside the arc from `zone` on.
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        col = mix(col, self.color_zone.rgb, zone_t * zone_r * 0.85)
    }
    // The window over the printed face.
    col = nm_window_g(col, p, c, hc, fr, face_d, px, 1.0)
    // The needle, from under the pivot dome to just past the scale, and its
    // soft shadow a point down and to the right of it.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let tail = max(self.pivot_size - px, 0.0)
    let sq = q - vec2(0.8, 1.2)
    let s_along = dot(sq, nd)
    let s_across = abs(sq.x * nd.y - sq.y * nd.x)
    let shade = (1.0 - smoothstep(0.0, 1.6, s_across)) * smoothstep(-1.0, 1.0, rr + 3.0 - s_along) * smoothstep(-1.0, 1.0, s_along + tail)
    col = col * (1.0 - 0.12 * shade)
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - 0.5, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - tail, px)
    col = mix(col, self.color_needle.rgb, needle)
    // The pivot: a dome of the page over the needle's root, and its shadows.
    let pr = max(self.pivot_size, 1.0)
    let ph = vec2(pr, pr)
    let thrown = nm_cast(p, pv, ph, pr, max(2.0 * pr + 2.0, 8.0), 1.0)
    col = col * (1.0 - thrown.a) + thrown.rgb
    let pd = r - pr
    col = mix(col, nm_dome_g(nm_ground() + vec3(0.01, 0.01, 0.01), p, pv, ph), Finish.cover(pd, px))
    col = col + vec3(nm_grain(org + p, px))
    let a = Finish.cover(face_d, px) * self.color.a
    return vec4(col * a, a) * self.opacity
}

// LAMPS. A lamp is a small raised dome on the page: out, a dome of the page
// itself with the faintest trace of the colour it would light; lit, the
// same dome filled with its intent's colour; half lit, half way between. A
// bar is the dome drawn out into a pill. Either throws the sheet's two
// shadows, so the quad grows 6 points round the lens and the lamp keeps 3
// of them inside its own box as padding: two lamps set edge to edge stand
// 6 points apart, and each one's shadow is gone before the other's dome. A
// halo a page asks for is drawn as the stock draws it, in the room the lamp
// then takes for it.
mod.widgets.Lamp.padding = mod.turtle.Inset{left: 3.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.Lamp.draw_bg.bar_radius = uniform(16.0)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    // The lens in the middle of the lamp's box, its thickness read back
    // from the room the box holds for a halo, as the stock reads it.
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    let half_len = max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5)
    let hb = vec2(mix(t * 0.5, half_len, self.bar), t * 0.5)
    let corner = mix(t * 0.5, min(self.bar_radius, t * 0.5), self.bar)
    let d = Material.sd_box(pq, c, hb, corner)
    let lit = clamp(self.lit, 0.0, 1.0)
    let tone = self.intent_color()
    let ink = tone.rgb
    let glow = max(self.halo_at(d, t, px, self.halo * lit, reach), 0.0)
    var acc = self.halo_light(ink, glow)
    acc = Finish.over(acc, nm_cast(pq, c, hb, corner, max(1.25 * t, 6.0), 1.0))
    let unlit = mix(nm_ground(), ink, self.lens_tint * 0.3)
    var col = nm_dome_g(mix(unlit, ink, lit), pq, c, hb)
    col = col + vec3(nm_grain(self.rect_pos + pq, px))
    let a = Finish.cover(d, px)
    acc = Finish.over(acc, vec4(col * a, a))
    return acc * self.opacity
}

// SWITCHES. Both hardware switches are a pill well the switch's height with
// a raised round key in it, the key's shadows kept inside the well; on, the
// well fills with the accent as a toggle's does. The rocker's key carries
// the side in force, a slate O at the left while off and the I in the
// accent ink at the right while on, and crosses on a click with the state's
// own short ease; it is never dragged. The slide switch's key follows a
// drag, and the end of the slot it has left holds a small mark: a quiet
// slate dot while off, a white one on the fill while on. The quad grows 6
// points for the focus mark, and the label stands 8 points clear of the
// well, as it does beside a toggle.

// One switch: the pill `sz` at the start of the row, or at its end, its key
// `inset` points in from the well's edge and `t` along its travel. `slide`
// is 1 for the slide switch's mark in the slot, 0 for the rocker's legend
// on the key.
let nm_switch_g = fn(pq: vec2, size: vec2, org: vec2, px: float, sz: vec2, at_end: float, inset: float, t: float, hover: float, down: float, focus: float, active: float, disabled: float, error: float, slide: float) -> vec4 {
    let o0 = vec2((size.x - sz.x) * at_end, size.y * 0.5 - sz.y * 0.5)
    let lo = vec2(Finish.snap(org.x + o0.x, px), Finish.snap(org.y + o0.y, px)) - org
    let hi = vec2(Finish.snap(org.x + o0.x + sz.x, px), Finish.snap(org.y + o0.y + sz.y, px)) - org
    let tc = (lo + hi) * 0.5
    let th = (hi - lo) * 0.5
    let td = Material.sd_box(pq, tc, th, th.y)
    let ta = Finish.cover(td, px)
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.35, disabled)
    // The well, the accent coming into it as the switch turns on.
    var col = nm_well(nm_well_shade_g(), pq, tc, th, th.y, td, px, 2.0 * th.y, (1.1 + 0.3 * hover) * dis)
    let fillc = mix(mix(vec3(0.290, 0.486, 0.965), vec3(0.741, 0.227, 0.192), error), vec3(0.725, 0.776, 0.902), disabled)
    col = mix(col, nm_fill_well_g(fillc, pq, tc, th, th.y, 2.0 * th.y), active)
    // The slide's mark, in the end of the slot the key has left.
    let free = vec2(mix(lo.x + 2.0 * th.x - th.y, lo.x + th.y, t), tc.y)
    let mark = Finish.cover(length(pq - free) - sz.y * 0.15, px) * slide * mix(0.3, 0.92, active) * dis
    col = mix(col, mix(vec3(0.388, 0.416, 0.478), vec3(1.0, 1.0, 1.0), active), mark)
    col = col + vec3(nm_grain(org + pq, px))
    var acc = vec4(col * ta, ta)
    // The key, and what it throws on the well.
    let kr = max(th.y - inset, 2.0)
    let kc = vec2(lo.x + th.y + 2.0 * (th.x - th.y) * t, tc.y)
    let kh = vec2(kr, kr)
    let kd = length(pq - kc) - kr
    acc = Finish.over(acc, nm_cast(pq, kc, kh, kr, 2.0 * kr, (1.0 + 0.3 * hover) * dis) * ta)
    var kcol = nm_face(pq, kc, kh, kd, px, 0.018 * hover * en - 0.01 * down * en, en)
    // The rocker's legend on the key: the O fading out as the I comes in.
    let lq = pq - kc
    let ring = Finish.cover(abs(length(lq) - kr * 0.34) - 0.55, px) * (1.0 - active)
    let bar = Finish.cover(max(abs(lq.x) - 0.55, abs(lq.y) - kr * 0.38), px) * active
    let ink = mix(mix(vec3(0.388, 0.416, 0.478), vec3(0.220, 0.376, 0.839), active), vec3(0.725, 0.776, 0.902), disabled)
    kcol = mix(kcol, ink, (ring + bar) * (1.0 - slide))
    kcol = kcol + vec3(nm_grain(org + pq, px))
    let ka = Finish.cover(kd, px)
    acc = Finish.over(acc, vec4(kcol * ka, ka))
    return Finish.over(acc, nm_focus(td, px, focus * en))
}
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    return nm_switch_g(pq, self.rect_size, self.rect_pos, px, sz, self.mark_at_end, self.border_size + self.knob_inset, self.active, self.hover, self.down, self.focus, self.active, self.disabled, self.error, 0.0)
}
mod.widgets.ToggleRocker.label_walk.margin.left = 44.0
mod.widgets.ToggleSlide.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let t = mix(self.active, self.drag_pos, self.drag)
    return nm_switch_g(pq, self.rect_size, self.rect_pos, px, sz, self.mark_at_end, self.border_size + self.knob_inset, t, self.hover, self.down, self.focus, self.active, self.disabled, self.error, 1.0)
}
mod.widgets.ToggleSlide.label_walk.margin.left = 44.0

// THE PAGE. The window's own ground: the slate-white, a long gradient a
// quarter as strong as a studio shot's, and the shared grain.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let t = (self.pos.x + self.pos.y) * 0.5
    let g = 0.008 - 0.016 * t
    return vec4(nm_ground() + vec3(g, g, g) + vec3(nm_grain(self.rect_pos + p, px)), 1.0)
}

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it.
// Twenty-six, the same row the buttons stand in.
let field_height = 26.0
let field_pad_v = 5.0
let field_radius = 6.0
// No borders: the relief draws the edge.
let field_border = 0.0

// The room a Fit field takes. A minimum height rather than a height,
// because a line of text is shorter than a row, and the padding with it:
// where a field is Fit, the padding IS its height, and two fields padded
// differently part company again the moment the type grows.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box, and because writing a corner onto a
// draw struct that has no corner would add a slot its shader never reads.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: a number
// with a stepper, a date, a time. The height is all these take. A padding
// here would NOT hold the line off the box -- each of them measures its
// parts against the turtle's whole rect and draws them from the content
// origin, so the padding displaces the line instead of insetting it, and the
// number came out sitting on the bottom edge with its arrows split around it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
// The number's box strokes its own hairline and declares no border size.
mod.widgets.NumberField.draw_bg.border_radius = field_radius
// The drag-number's corner is written into its own shader, so it takes the
// room and keeps the box it draws.
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
// A picker is a date field in an anchor: the field inside fills the frame.
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own. It is
// a TextInput, so it inherits the minimum above, and a minimum as tall as the
// whole field, applied inside a well already that tall, pushed the line out
// through the bottom of the box.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #e9edf0
// ---------------------------------------------------------------- band

// THE BAND is the sheet's own slider with two thumbs: the same track, the
// same lit value and the same thumb as the Slider, the value lit between
// the two thumbs, its quad grown as the slider's is so the thumbs keep
// their shape. The widget's grab geometry is set to the thumbs' own, so
// what is drawn is what is dragged.
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.track_inset = 1.0
mod.widgets.RangeSliderFlat.handle_size = 16.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let dis = mix(1.0, 0.35, self.disabled)
    let gr = vec3(nm_grain(org + pq, px))
    let top = self.label_px
    let cy = Finish.snap(org.y + top + (self.rect_size.y - top) * 0.5, px) - org.y
    let hr = 8.0
    let x0 = hr + 1.0
    let x1 = self.rect_size.x - hr - 1.0
    let gc = vec2(self.rect_size.x * 0.5, cy)
    let gh = vec2(self.rect_size.x * 0.5 - 1.0, 4.0)
    let ga = Finish.cover(Material.sd_box(pq, gc, gh, 4.0), px)
    let col = nm_groove(vec3(0.878, 0.898, 0.925), pq, gc, gh, px, dis) + gr
    let ink = mix(vec3(0.290, 0.486, 0.965), vec3(0.725, 0.776, 0.902), self.disabled)
    let fcol = nm_fill_e(ink, pq, gc, gh, 4.0, 8.0, dis) + gr
    let fa = nm_span_e(pq, gc, gh, x0, x1, self.end_pos, self.start_pos, 1.0, px)
    let far = nm_disc_e(vec4(col * ga, ga), vec4(fcol * fa, fa), pq, org, vec2(mix(x0, x1, self.end_pos), cy), hr, 2.5 * hr, 1.0, px, self.hot_end, self.drag * self.hot_end, self.focus, self.disabled)
    return nm_disc_e(far, vec4(0.0, 0.0, 0.0, 0.0), pq, org, vec2(mix(x0, x1, self.start_pos), cy), hr, 2.5 * hr, 1.0, px, self.hot_start, self.drag * self.hot_start, self.focus, self.disabled)
}

true
