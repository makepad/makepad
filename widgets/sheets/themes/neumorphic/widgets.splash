use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// THE MATERIAL. One pale ground, pushed up into raised parts or pressed into
// wells. Every face below is built from the same few pieces, written once
// here and handed what each template knows about itself. Light comes from
// the top left: dark falls down-right, light up-left. No edge is a drawn
// line: an edge is light or shade on a shoulder, and the shadows either side
// of it. Distances are points, and a face's shadows are drawn OUTSIDE its
// layout box, in a quad grown in `vertex`, so they cost no padding.

// The page, and the grain every surface shares, so a face and the ground
// round it read as one material: one value per device pixel, about one
// level of 255, taken in window space.
let nm_grain = fn(q: vec2, px: float) -> float {
    return Finish.grain(q / px, 2.4 / 255.0)
}

let nm_ground = fn() -> vec3 {
    return vec3(0.914, 0.929, 0.941)
}

// The slate every shadow on this material is cast in: the page's cool white
// taken down to about two thirds of its light, toward blue.
let nm_slate_a = fn() -> vec3 {
    return vec3(0.541, 0.596, 0.690)
}

// What a raised part throws round itself, premultiplied: a slate shadow down
// and right, deepest at the foot of the edge (about 0.7 of the page there),
// a tight contact shadow under the edge, and up and left a halo of light.
// The halo is light, not paint: it lifts what it falls on, the page to white,
// and covers nothing, so an accent fill beside a knob keeps its colour. `s`
// is the part's own height and `k` their strength. The shadows keep the
// part's proportions, gone about three tenths of its height out, and stop
// growing at a 40 point part: a quad grown by three tenths of its part's
// height, or by twelve points, holds the whole cast.
let nm_cast = fn(p: vec2, c: vec2, h: vec2, r: float, s: float, k: float) -> vec4 {
    let t = min(s, 40.0)
    let amb = Finish.drop(p, c, h, r, vec2(0.09, 0.11) * t, max(0.1 * t, 0.9)) * 0.9 * k
    let con = Finish.drop(p, c, h, r, vec2(0.012, 0.03) * t, max(0.025 * t, 0.5)) * 0.28 * k
    // Held at white, so a hovered part cannot push the page past it.
    let lit = min(Finish.drop(p, c, h, r, vec2(-0.08, -0.1) * t, max(0.09 * t, 0.8)) * k, 1.0)
    var acc = vec4(nm_slate_a() * amb, amb)
    acc = Finish.over(acc, vec4(vec3(0.478, 0.525, 0.608) * con, con))
    return acc + vec4((vec3(1.0, 1.0, 1.0) - nm_ground()) * lit, 0.0)
}

// The light on a face's shoulder, signed: up to 1 where the edge faces the
// top left, down to -1 where it faces the bottom right, fading from the edge
// to nothing `w` points in. The edge is taken to turn as if the face's
// corners were rounded by `m`: exact on a disc or a pill given its half
// height, and round the tighter corners of a box the light turns a little
// more gently than the outline does.
let nm_shoulder_a = fn(p: vec2, c: vec2, h: vec2, m: float, d: float, w: float) -> float {
    let e = max(abs(p - c) - h + vec2(m, m), vec2(0.0, 0.0))
    let n = sign(p - c) * e / max(length(e), 0.0001)
    return dot(n, vec2(-0.6, -0.8)) * (1.0 - smoothstep(0.0, w, -d))
}

// A raised face: the page a little lighter toward the top left and a little
// darker toward the bottom right, corner to corner, and on its shoulder, the
// outer two and a half points (never under three device pixels), the light
// the edge catches where it faces the top left and the shade where it faces
// away, both fading in from the edge. No line is drawn on it. `rim` is how
// much light and shade the shoulder takes.
let nm_face = fn(p: vec2, c: vec2, h: vec2, d: float, px: float, lift: float, rim: float) -> vec3 {
    let u = clamp(((p.x - c.x) / max(h.x, 1.0) + (p.y - c.y) / max(h.y, 1.0)) * 0.25 + 0.5, 0.0, 1.0)
    let g = mix(0.028, -0.024, u) + lift
    var col = nm_ground() + vec3(g, g, g)
    let sh = nm_shoulder_a(p, c, h, min(h.x, h.y), d, max(2.5, 3.0 * px)) * rim
    col = mix(col, vec3(0.984, 0.988, 1.0), max(sh, 0.0) * 0.85)
    col = mix(col, vec3(0.745, 0.776, 0.831), max(-sh, 0.0) * 0.55)
    return col
}

// A well: the surround's shadow falls in deep from the top left and light
// collects along the bottom right, both soft, deep enough to read as a hole,
// and no line is drawn on the rim. `k` is its depth (a well asked for more
// than full depth holds at the slate and at white), `s` the well's own
// height.
let nm_well = fn(col: vec3, p: vec2, c: vec2, h: vec2, r: float, d: float, px: float, s: float, k: float) -> vec3 {
    let dk = Finish.inset(p, c, h, r, vec2(0.08 * s, 0.12 * s), max(0.13 * s, 1.0))
    let lt = Finish.inset(p, c, h, r, vec2(-0.05 * s, -0.07 * s), max(0.1 * s, 0.8))
    let o = mix(col, nm_slate_a(), clamp(dk * 1.0 * k, 0.0, 1.0))
    return mix(o, vec3(1.0, 1.0, 1.0), clamp(lt * 0.9 * k, 0.0, 1.0))
}

// The focus mark: a one-pixel accent ring two points outside the face, and a
// short soft fall-off either side of it.
let nm_focus = fn(d: float, px: float, f: float) -> vec4 {
    let ring = Finish.ring_out(d, 2.0, 2.0 + px, px) * 0.6
    let soft = (1.0 - smoothstep(0.0, 2.0, abs(d - 2.0))) * 0.15 * step(0.0, d)
    let a = max(ring, soft) * f
    return vec4(vec3(0.290, 0.486, 0.965) * a, a)
}

// The distance to an arc of radius R about c, running clockwise from a0 to
// a1 measured from straight down, with round ends, w wide. Written here
// because the stock arc gives up on any sweep past half a turn.
let nm_arc = fn(p: vec2, c: vec2, R: float, a0: float, a1: float, w: float) -> float {
    let q = p - c
    var ap = atan2(-q.x, q.y)
    if ap < 0.0 {
        ap = ap + 2.0 * PI
    }
    let rel = ap - a0 - floor((ap - a0) / (2.0 * PI)) * 2.0 * PI
    let on = step(rel, a1 - a0)
    let band = abs(length(q) - R) - 0.5 * w
    let e0 = length(q - vec2(-sin(a0), cos(a0)) * R) - 0.5 * w
    let e1 = length(q - vec2(-sin(a1), cos(a1)) * R) - 0.5 * w
    return mix(min(e0, e1), band, on)
}

// BUTTONS. No line is drawn round a face: every edge is light on a
// shoulder, and a raised face throws its two shadows into a quad grown by
// 8 points. The last quarter of that room fades whatever reaches it, along
// a box rounded like the face, so a cast never ends on the quad's edge.
let nm_room_b = fn(pq: vec2, size: vec2, r: float, m: float) -> float {
    let qc = size * 0.5
    let edge = -Material.sd_box(pq, qc, qc + vec2(m, m), r + m)
    return smoothstep(0.0, 0.25 * m, edge)
}

// A button face. `rest` is how raised it stands at rest (1 raised, 0 flat
// on the page), `ghost` how far a flat face rises under the pointer (0
// halfway, 1 the whole way), `hollow` shows nothing until the pointer asks,
// and `fill` is the colour the face is filled with, its alpha how far: the
// face keeps its gradient, its shoulders and its shadows, and only its
// colour moves. Held, any of them is the same shape pressed into a well.
let nm_button = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, ink: vec4, rest: float, ghost: float, hollow: float, fill: vec4) -> vec4 {
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + size.x, px), Finish.snap(org.y + size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = min(size.y, 28.0)
    // Round and generous: a 10 point corner on a row of 26, growing with a
    // taller face to 16, and a full pill on a face too short for 10.
    let r = min(clamp(0.36 * size.y, 10.0, 16.0), min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let press = down * en
    // How far the face stands up: raised faces lift a little under the
    // hand, flat ones rise halfway or the whole way, hollow ones stay down.
    let up = mix(mix(mix(0.6, 1.0, ghost) * hover, rest * (1.0 + 0.3 * hover), step(0.5, rest)), 0.0, hollow) * (1.0 - press)
    let k = up * mix(1.0, 0.35, disabled)
    var acc = nm_cast(pq, c, h, r, hh, k) * nm_room_b(pq, size, r, 8.0)
    let a = Finish.cover(d, px)
    // The shoulders stand up with the face and fade with it when disabled.
    var col = nm_face(pq, c, h, d, px, 0.018 * hover * en, min(up, 1.0) * mix(1.0, 0.35, disabled))
    // A flat face is the page itself until it rises.
    let flatness = (1.0 - step(0.5, rest)) * (1.0 - min(up * 1.8, 1.0))
    col = mix(col, nm_ground(), flatness)
    // Pressed, or the faint well a hollow face shows under the pointer.
    let sink = max(press, hollow * hover * 0.4 * en)
    col = mix(col, nm_well(col - vec3(0.013, 0.013, 0.013) * press, pq, c, h, r, d, px, hh, 1.0), sink)
    // The fill moves the whole face from the page's colour to its own, so
    // the light on it, its shoulders and its well move along; disabled, it
    // is the page's face again.
    col = clamp(col + (fill.rgb - nm_ground()) * fill.a * en, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
    col = col + vec3(nm_grain(org + pq, px))
    acc = Finish.over(acc, vec4(col * a, a))
    acc = Finish.over(acc, nm_focus(d, px, focus * en))
    // The wait spinner is drawn by the face, so a face that replaces the
    // stock one has to draw it again; on a filled face it is white, as the
    // label it stands in for.
    let rr = max(min(h.x, h.y) - 5.0, 2.0)
    let a0 = anim * 2.0 * PI
    let sa = Finish.cover(nm_arc(pq, c, rr, a0, a0 + 1.5 * PI, 1.5), px) * ink.a * loading
    let si = mix(ink.rgb, vec3(1.0, 1.0, 1.0), fill.a * en)
    return Finish.over(acc, vec4(si * sa, sa))
}

// The room round every button for its shadows and its focus ring.
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
// A view lets what it holds draw past its edge; scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// The flat button: the page until the pointer raises it.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0)), m)
}
// The standard, sized and compound buttons stand up off the page.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 1.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0)), m)
}
