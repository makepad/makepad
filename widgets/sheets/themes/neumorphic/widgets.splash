// The outlined button is the page with an accent label and nothing drawn
// round it; under the pointer it rises the whole way, as far as a standard
// button stands.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
