use mod.prelude.widgets_internal.*

// Colourful plasticine under a soft light: a big sky from above and a key
// light from the upper left, wrapped far round, so a shade is the clay's own
// colour a little deeper and richer, never grey. Every part is a lump of
// modelling clay pressed onto a pink clay board: a pill, a snake, a ball, a tile.
// Each lump is matte with a broad soft sheen, its edge rolled thick and
// rounded, its outline a little uneven, its face puffed, with the lumps,
// smudges, fingerprints, air pits and tool marks of the hands that made it,
// different on every part. A lump throws a soft crease all round its foot
// and a soft, light shadow down and to the right in the ground's own pink,
// gone within half the gap to its neighbour. Pressed, a lump is squashed into the slab: its shadow goes and
// the slab's edge shades its top. A chosen part is a pocket pressed into the
// clay, its word lit. Every kind of control has its colour, as the hands
// that made the reference picked one plasticine per kind.

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own, so the box metrics are stated ONCE here
// and handed to each field below; a field added to the library later joins
// the row by being named here. A field clips its own text, so it draws its
// slab and the slab's shadow inside its own box: the box is 28 and the slab
// in it 25, the height of a button's lump with its shadow.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 7.0
// A hairline, for the few stock fields the faces below do not redraw.
let field_border = 0.34

let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that lays its own parts out inside its frame takes the height
// alone: a padding there displaces the line instead of insetting it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds imposes no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #ffabe1

// Plain views stop clipping, so a lump's shadow may fall into the gap
// beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// GEOMETRY. Distances in points, negative inside, y down; `px` is one device
// pixel in points. Every texture is laid in the part's own points, never the
// window's, so nothing moves on a part as its page scrolls.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

let cl_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let cl_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    let r = clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(r, r)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's radius.
let cl_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let cl_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

let cl_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// A triangle hw wide either side, 2 hh tall, apex up (dir -1) or down (1).
let cl_tri = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    let y = (p.y - c.y) * dir
    let e = (abs(p.x - c.x) * 2.0 * hh + hw * (y - hh)) / sqrt(4.0 * hh * hh + hw * hw)
    return max(-hh - y, e)
}

// Which way a rounded box's outline faces at `p`, for the roll of its edge.
// Taken with a radius at least as wide as the roll, so the roll turns round
// a corner without a mitre.
let cl_grad = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let s = vec2(mix(-1.0, 1.0, step(c.x, p.x)), mix(-1.0, 1.0, step(c.y, p.y)))
    let q = abs(p - c) - h + vec2(rr, rr)
    if q.x > 0.0 && q.y > 0.0 {
        return normalize(q) * s
    }
    if q.x > q.y {
        return vec2(s.x, 0.0)
    }
    return vec2(0.0, s.y)
}

// ---------------------------------------------------------------------------
// THE CLAY.

// The outline a hand leaves: the edge wanders in and out by up to `amp`
// points, slowly, with a finer wobble over it.
let cl_wob = fn(q: vec2, seed: float, amp: float) -> float {
    let o = vec2(seed * 13.17, seed * 7.31)
    return ((Finish.noise(q * 0.075 + o) - 0.5) * 1.6 + (Finish.noise(q * 0.21 + o * 1.9 + vec2(3.1, 5.7)) - 0.5) * 0.7) * amp
}

// The lumps in a face: the slope of a soft height field, as a tilt of the
// face's normal. A broad unevenness about twenty points across, and the
// long soft strokes a thumb or a spatula leaves when it smooths the clay,
// running one way across the part.
let cl_bump = fn(q: vec2, seed: float) -> vec2 {
    let o = vec2(seed * 13.7, seed * 29.1)
    let e = 0.8
    let f1 = 0.05
    let a0 = Finish.noise(q * f1 + o)
    let ax = Finish.noise((q + vec2(e, 0.0)) * f1 + o)
    let ay = Finish.noise((q + vec2(0.0, e)) * f1 + o)
    let ang = seed * 6.2831853
    let cs = cos(ang)
    let sn = sin(ang)
    let f2 = vec2(0.035, 0.17)
    let o2 = o * 1.73 + vec2(4.1, 7.9)
    let u0 = vec2(q.x * cs + q.y * sn, q.y * cs - q.x * sn)
    let ux = u0 + vec2(cs, -sn) * e
    let uy = u0 + vec2(sn, cs) * e
    let b0 = Finish.noise(u0 * f2 + o2)
    let bx = Finish.noise(ux * f2 + o2)
    let by = Finish.noise(uy * f2 + o2)
    // and the fine tooth of the clay itself, a point and a half across
    let f3 = 0.65
    let o3 = o * 0.71 + vec2(1.3, 2.9)
    let qt = vec2(q.x * 0.866 + q.y * 0.5, q.y * 0.866 - q.x * 0.5)
    let c0 = Finish.noise(qt * f3 + o3)
    let cx = Finish.noise((qt + vec2(0.866, -0.5) * 0.4) * f3 + o3)
    let cy = Finish.noise((qt + vec2(0.5, 0.866) * 0.4) * f3 + o3)
    // and soft dents a thumb-tip across, where the clay was pushed into shape
    let f4 = 0.15
    let o4 = o * 0.37 + vec2(8.3, 1.7)
    let qd = vec2(q.x * 0.6 - q.y * 0.8, q.y * 0.6 + q.x * 0.8)
    let d0 = Finish.noise(qd * f4 + o4)
    let dx = Finish.noise((qd + vec2(0.6, 0.8) * e) * f4 + o4)
    let dy = Finish.noise((qd + vec2(-0.8, 0.6) * e) * f4 + o4)
    return (vec2(ax - a0, ay - a0) * 1.35 + vec2(bx - b0, by - b0) * 0.30 + vec2(dx - d0, dy - d0) * 0.55) / e + vec2(cx - c0, cy - c0) * 0.022 / 0.4
}

// A fingerprint: whorled ridges a point and a half apart in an oval `sz`
// across round `fc`, turned by `ang`, fading at its edge and broken up so
// only part of it took. Each ridge is lit on the flank that faces the light.
// Returns the shading it adds, -1..1.
let cl_print = fn(q: vec2, fc: vec2, sz: float, ang: float, seed: float) -> float {
    let dq = q - fc
    let cs = cos(ang)
    let sn = sin(ang)
    let u = vec2(dq.x * cs + dq.y * sn, dq.y * cs - dq.x * sn) / max(sz, 1.0)
    let e = vec2(u.x * 1.1, u.y)
    let rad = length(e)
    if rad > 1.0 {
        return 0.0
    }
    let o = vec2(seed * 5.3, seed * 9.1)
    let warp = (Finish.noise(u * 3.5 + o) - 0.5) * 0.22
    let ph = (rad + warp) * sz / 2.2 + atan2(e.y, e.x) * 0.0795
    let env = (1.0 - smoothstep(0.5, 1.0, rad)) * smoothstep(0.2, 0.6, Finish.noise(u * 1.8 + o * 1.7 + vec2(2.3, 0.7)))
    let nd = dq / max(length(dq), 0.001)
    let side = dot(nd, vec2(-0.47, -0.88))
    return (sin(ph * 6.2831853) * side + cos(ph * 6.2831853) * 0.3) * env
}

// The same print pressed with ridges `pitch` points apart, softer and more
// broken: for a part wide and curved enough that the fine ridges would beat
// against its own shading.
let cl_print_c = fn(q: vec2, fc: vec2, sz: float, ang: float, seed: float, pitch: float) -> float {
    let dq = q - fc
    let cs = cos(ang)
    let sn = sin(ang)
    let u = vec2(dq.x * cs + dq.y * sn, dq.y * cs - dq.x * sn) / max(sz, 1.0)
    let e = vec2(u.x * 1.1, u.y)
    let rad = length(e)
    if rad > 1.0 {
        return 0.0
    }
    let o = vec2(seed * 5.3, seed * 9.1)
    let warp = (Finish.noise(u * 2.2 + o) - 0.5) * 0.30
    let ph = (rad + warp) * sz / pitch + atan2(e.y, e.x) * 0.0795
    let env = (1.0 - smoothstep(0.35, 1.0, rad)) * smoothstep(0.25, 0.7, Finish.noise(u * 1.4 + o * 1.7 + vec2(2.3, 0.7)))
    let nd = dq / max(length(dq), 0.001)
    let side = dot(nd, vec2(-0.47, -0.88))
    return (sin(ph * 6.2831853) * side * 0.8 + cos(ph * 6.2831853) * 0.2) * env
}

// The marks on a part `ext` either side of its middle: one fingerprint,
// partly taken; an air pit here and there, its upper wall in shade; and on
// about half the parts one short score of a modelling tool. All of it is
// placed by `seed`, so no two parts of different size carry the same marks.
let cl_marks = fn(q: vec2, ext: vec2, seed: float, pw: float) -> float {
    let hs = vec2(Finish.hash(vec2(seed * 91.3, 3.7)), Finish.hash(vec2(seed * 47.9, 11.3)))
    let fc = (hs - vec2(0.5, 0.5)) * ext * 1.2
    let sz = clamp(min(ext.x, ext.y) * 1.7, 8.0, 24.0)
    var s = cl_print(q, fc, sz, hs.x * 6.2831853, seed) * 0.06 * pw
    let sc = 2.8
    let og = vec2(seed * 7.13, seed * 3.71)
    let gq = q / sc + og
    let cell = floor(gq)
    let f = gq - cell
    let pc = vec2(0.25, 0.25) + vec2(Finish.hash(cell + vec2(5.1, 1.3)), Finish.hash(cell + vec2(2.7, 8.4))) * 0.5
    let dv = (f - pc) * sc
    let dist = length(dv)
    let pr = 0.35 + 0.30 * Finish.hash(cell + vec2(9.7, 4.4))
    let bowl = (1.0 - smoothstep(pr * 0.3, pr, dist)) * step(0.92, Finish.hash(cell))
    s = s - dot(dv / max(dist, 0.001), vec2(-0.47, -0.88)) * bowl * 0.14 - bowl * 0.03
    let hk = Finish.hash(vec2(seed * 17.9, 23.1))
    if hk > 0.35 {
        let a0 = (vec2(Finish.hash(vec2(seed * 5.3, 1.9)), Finish.hash(vec2(seed * 8.1, 4.2))) - vec2(0.5, 0.5)) * ext * 1.4
        let ang = hk * 12.0
        let len = clamp(min(ext.x, ext.y) * 1.3, 5.0, 26.0)
        let ba = vec2(cos(ang), sin(ang)) * len
        let k = clamp(dot(q - a0, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
        let off = q - a0 - ba * k
        let d2 = length(off)
        let prof = (1.0 - smoothstep(0.15, 0.75, d2)) * smoothstep(0.0, 0.25, k) * (1.0 - smoothstep(0.7, 1.0, k))
        s = s - dot(off / max(d2, 0.001), vec2(-0.47, -0.88)) * prof * 0.13
    }
    return s
}

// THE LIGHT ON CLAY, as soft as a big sky over a key light from the upper
// left. A shade is the clay's own colour, deeper and a little richer (a pink
// shades to rose, a blue to ultramarine), never toward grey or black, and at
// its darkest only about a fifth to a third darker than the lit side.
let cl_deep = fn(col: vec3) -> vec3 {
    let cc = max(col, vec3(0.0001, 0.0001, 0.0001))
    return pow(cc, vec3(1.3, 1.3, 1.3)) * 0.84
}
// The form lit at normal `n`: the key light wrapped far round, so the side
// away from it stays light; a sky from above, so tops are full and a touch
// paler; past full light a little paler still; and a faint lighter rim where
// the form turns away from the eye.
let cl_light = fn(n: vec3, col: vec3) -> vec3 {
    let key = clamp((dot(n, vec3(-0.30, -0.57, 0.77)) + 0.55) / 1.55, 0.0, 1.0)
    let sky = clamp(n.z, 0.0, 1.0)
    let f = (key * 0.7 + (0.5 + 0.5 * sky) * 0.3 - 0.15) / 0.745
    var c = mix(cl_deep(col), col, clamp(f, 0.0, 1.0))
    c = c + (mix(col, vec3(1.0, 1.0, 1.0), 0.6) - c) * clamp((f - 1.0) * 3.0, 0.0, 0.45)
    let rim = pow(1.0 - sky, 2.5) * 0.12
    return mix(c, mix(col, vec3(1.0, 1.0, 1.0), 0.35), rim)
}
// Fine detail on a lit colour `c`: lumps, dents, prints and strokes, `d` the
// change in light they make (as a fraction). Lighter toward a paler colour;
// darker toward the colour's own deep shade, never toward black.
let cl_detail = fn(c: vec3, d: float) -> vec3 {
    if d >= 0.0 {
        return c * (1.0 + d * 0.8) + (vec3(1.0, 1.0, 1.0) - c) * (d * 0.2)
    }
    let dc = cl_deep(c)
    let k = max(1.0 - Finish.lum(dc) / max(Finish.lum(c), 0.001), 0.05)
    return mix(c, dc, clamp(-d / k, 0.0, 1.5))
}
// A shadow, premultiplied: the ground's pink deeper and richer, laid at `a`.
let cl_sh = fn(a: float) -> vec4 {
    return vec4(0.58 * a, 0.28 * a, 0.46 * a, a)
}

// THE SKIN of a lump, premultiplied: `d` its outline's distance, `g` the way
// its outline faces, `w` how wide the rolled edge is, `q` the point in the
// part's own points (its texture), `tilt` the puff of its face, `col` the
// clay, `ext` its half size (where its marks go), `detail` how much of the
// texture shows. Lit from the upper left: a broad shoulder catching the
// light, the far rim dark and a deeper, richer colour, a soft wide sheen,
// the mottle of a hand-mixed colour and one device pixel of grain.
let cl_skin = fn(d: float, g: vec2, w: float, q: vec2, tilt: vec2, col: vec3, seed: float, px: float, detail: float, ext: vec2) -> vec4 {
    let a = Finish.cover(d, px)
    if a < 0.002 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let ww = max(w, 0.5)
    let u = clamp((ww + d) / ww, 0.0, 1.0)
    let z = sqrt(max(1.0 - u * u, 0.02))
    let bump = cl_bump(q, seed) * detail
    let nf = normalize(vec3(g.x * u + tilt.x * z, g.y * u + tilt.y * z, z))
    let n = normalize(vec3(g.x * u + (tilt.x + bump.x) * z, g.y * u + (tilt.y + bump.y) * z, z))
    let lk = vec3(-0.30, -0.57, 0.77)
    let o = vec2(seed * 31.7, seed * 17.3)
    let base = col * (1.0 + (Finish.fbm(q * 0.05 + o) - 0.5) * 0.12 * detail)
    // the form in the soft light; the lumps, dents and marks over it
    var c3 = cl_light(nf, base)
    c3 = cl_detail(c3, (dot(n, lk) - dot(nf, lk)) * 0.53 + cl_marks(q, ext, seed, 1.0) * detail)
    // a soft matte bloom on the shoulder, not a shine
    let sp = pow(max(dot(n, vec3(-0.159, -0.303, 0.940)), 0.0), 3.0) * 0.025
    c3 = c3 + mix(vec3(1.0, 1.0, 1.0), base, 0.55) * sp
    c3 = c3 + g3(Finish.grain(q / px, 0.010))
    return vec4(clamp(c3, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)) * a, a)
}

// A lump: the rounded box (c, h, r), its outline wandering by `wob` points,
// its edge rolled over `w`, its face puffed by `puff`.
let cl_lump = fn(p: vec2, c: vec2, h: vec2, r: float, w: float, wob: float, puff: float, col: vec3, seed: float, px: float, detail: float) -> vec4 {
    let q = p - c
    let d = cl_rbox(p, c, h, r) + cl_wob(q, seed, wob)
    let g = cl_grad(p, c, h, max(r, w))
    let tilt = vec2(q.x / max(h.x, 1.0), q.y / max(h.y, 1.0)) * puff
    return cl_skin(d, g, w, q, tilt, col, seed, px, detail, h)
}

// The same with a corner per side, for the joins of a button group.
let cl_lump4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4, w: float, wob: float, puff: float, col: vec3, seed: float, px: float, detail: float) -> vec4 {
    let q = p - c
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    let d = cl_rbox4(p, c, h, r4) + cl_wob(q, seed, wob)
    let g = cl_grad(p, c, h, max(r, w))
    let tilt = vec2(q.x / max(h.x, 1.0), q.y / max(h.y, 1.0)) * puff
    return cl_skin(d, g, w, q, tilt, col, seed, px, detail, h)
}

// A ball of clay pressed down a little: round, its top flattened by `flat`
// (1 a full dome, less a wider plateau).
let cl_ball = fn(p: vec2, c: vec2, rad: float, flat: float, col: vec3, seed: float, px: float, detail: float, wob: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad + cl_wob(q, seed, wob)
    let g = q / max(length(q), 0.0001)
    return cl_skin(d, g, rad * flat, q, q / max(rad, 1.0) * 0.08, col, seed, px, detail, vec2(rad, rad))
}

// A snake rolled between the palms from `a` to `b`, `rad` thick, its girth
// swelling and thinning a little along it.
let cl_snake = fn(p: vec2, a: vec2, b: vec2, rad: float, col: vec3, seed: float, px: float, detail: float) -> vec4 {
    let pa = p - a
    let ba = b - a
    let bl = max(length(ba), 0.0001)
    let k = clamp(dot(pa, ba) / (bl * bl), 0.0, 1.0)
    let off = pa - ba * k
    let dist = length(off)
    let along = k * bl
    let girth = rad * (1.0 + (Finish.noise(vec2(along * 0.12 + seed * 11.0, seed * 3.0)) - 0.5) * 0.16)
    let q = vec2(along, dot(off, vec2(-ba.y, ba.x) / bl))
    return cl_skin(dist - girth, off / max(dist, 0.0001), girth, q, vec2(0.0, 0.0), col, seed, px, detail, vec2(bl * 0.5 + rad, rad))
}

// A snake bent once: from `a` to `b` to `e` (a check mark, a chevron).
let cl_hook = fn(p: vec2, a: vec2, b: vec2, e: vec2, rad: float, col: vec3, seed: float, px: float) -> vec4 {
    let pa = p - a
    let ba = b - a
    let k1 = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let o1 = pa - ba * k1
    let pb = p - b
    let eb = e - b
    let k2 = clamp(dot(pb, eb) / max(dot(eb, eb), 0.0001), 0.0, 1.0)
    let o2 = pb - eb * k2
    let off = mix(o1, o2, step(length(o2), length(o1)))
    let dist = length(off)
    let so = vec2(0.4, 0.75)
    let sd = min(cl_seg(p - so, a, b), cl_seg(p - so, b, e)) - rad
    let sa = (1.0 - smoothstep(-0.5, 1.3, sd)) * 0.30
    var out = cl_sh(sa)
    return Finish.over(out, cl_skin(dist - rad, off / max(dist, 0.0001), rad, p - b, vec2(0.0, 0.0), col, seed, px, 0.4, vec2(rad * 3.0, rad * 3.0)))
}

// A coil laid in a ring of radius `rr`, `t` thick.
let cl_ring = fn(p: vec2, c: vec2, rr: float, t: float, col: vec3, seed: float, px: float) -> vec4 {
    let q = p - c
    let l = length(q)
    let d = abs(l - rr) - t
    let g = q / max(l, 0.0001) * mix(-1.0, 1.0, step(rr, l))
    let sd = abs(length(q - vec2(0.35, 0.7)) - rr) - t
    let sa = (1.0 - smoothstep(-0.4, 1.2, sd)) * 0.28
    var out = cl_sh(sa)
    return Finish.over(out, cl_skin(d, g, t, q, vec2(0.0, 0.0), col, seed, px, 0.4, vec2(rr, rr)))
}

// What a lump throws on what is under it: a dark crease all round its foot
// and a soft shadow down and to the right, `lift` raising it, `amt` its
// strength; gone within about four points.
let cl_drop = fn(p: vec2, c: vec2, h: vec2, r: float, amt: float, lift: float) -> vec4 {
    let crease = Finish.drop(p, c, h, r, vec2(0.1, 0.4), 0.9) * 0.24
    let soft = Finish.drop(p, c, h, r, vec2(0.55, 1.5) * lift, 1.8 * lift) * 0.26
    let a = clamp((crease + soft * (1.0 - crease)) * amt, 0.0, 1.0)
    return cl_sh(a)
}

// The same under a snake from `a` to `b`.
let cl_snake_drop = fn(p: vec2, a: vec2, b: vec2, rad: float, amt: float) -> vec4 {
    let d0 = cl_seg(p - vec2(0.0, 0.2), a, b) - rad
    let d1 = cl_seg(p - vec2(0.5, 1.0), a, b) - rad
    let crease = (1.0 - smoothstep(-0.6, 1.4, d0)) * 0.22
    let soft = (1.0 - smoothstep(-rad * 0.7, 3.0, d1)) * 0.22
    let al = clamp((crease + soft * (1.0 - crease)) * amt, 0.0, 1.0)
    return cl_sh(al)
}

// A pocket pressed into the clay: its floor `col`, the slab's edge shading
// its upper part, its lower wall facing the light.
let cl_pocket = fn(p: vec2, c: vec2, h: vec2, r: float, col: vec3, seed: float, px: float) -> vec4 {
    let q = p - c
    let d = cl_rbox(p, c, h, r) + cl_wob(q, seed, 0.3)
    let a = Finish.cover(d, px)
    if a < 0.002 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let sh = clamp(Finish.inset(p, c, h, r, vec2(0.7, 1.3), 1.3), 0.0, 1.0)
    var k = col * (1.0 + (Finish.fbm(q * 0.06 + vec2(seed * 9.0, 2.0)) - 0.5) * 0.08)
    k = mix(k, cl_deep(k), clamp(sh * 1.6, 0.0, 1.3))
    let g = cl_grad(p, c, h, r)
    let wall = Finish.band(d, 0.0, 1.4, px) * clamp(dot(g, vec2(0.47, 0.88)), 0.0, 1.0)
    k = mix(k, Finish.lift(col, 0.28), wall * 0.6)
    k = k + g3(cl_marks(q, h, seed, 1.0) * 0.6 + Finish.grain(q / px, 0.008))
    return vec4(clamp(k, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)) * a, a)
}

// A clay's colour in a state: lighter under the pointer, a shade deeper
// squashed, a dull grey with a hint of its colour when it is off.
let cl_tone = fn(col: vec3, hover: float, press: float, dis: float) -> vec3 {
    var c = Finish.lift(col, 0.09 * hover)
    c = c * (1.0 - 0.12 * press)
    return mix(c, vec3(0.792, 0.773, 0.780), 0.85 * clamp(dis, 0.0, 1.0))
}

// Focus: a thread of sky-blue clay laid two points outside the edge.
let cl_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.cover(abs(d - 2.75) - 0.85, px) * 0.9 * focus
    let lit = 1.0 - 0.25 * smoothstep(-0.85, 0.85, d - 2.75)
    return vec4(0.310 * lit * f, 0.498 * lit * f, 0.847 * lit * f, f)
}

// An indicator lamp set into a part (the over lamp of a level meter): a
// small glossy bead in a socket, dark glass until it is lit.
let cl_led = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, lit: float, glow: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let k = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let v = clamp(q.y / max(rad, 0.001) * 0.5 + 0.5, 0.0, 1.0)
    let on = mix(min(ink + vec3(0.45, 0.45, 0.45), vec3(1.0, 1.0, 1.0)), ink * 0.85, smoothstep(0.2, 1.0, k))
    let off = mix(vec3(0.16, 0.14, 0.15), vec3(0.28, 0.25, 0.26), v)
    var col = mix(off, on, lit)
    let hl = 1.0 - smoothstep(0.2, 0.5, length(q / max(rad, 0.001) - vec2(-0.3, -0.4)))
    col = mix(col, vec3(1.0, 1.0, 1.0), hl * 0.55)
    let a = Finish.cover(d, px)
    let ha = glow * lit * exp(-max(d, 0.0) / 0.9) * (1.0 - a)
    var out = vec4(ink * ha, ha)
    let rim = Finish.ring_out(d, 0.0, 0.9, px) * 0.35
    out = Finish.over(out, cl_sh(rim))
    return Finish.over(out, vec4(col * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family, a pill of clay in the role's colour;
// `kind` picks the dressing: 0 the pill, 5 a coil of navy laid round the
// label (outline), 6 bare until touched (flatter). The quad is grown by `m`
// for the shadow and the focus thread.
let cl_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, r4: vec4, kind: float, m: float, col: vec3) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rr = max(max(r4.x, r4.y), max(r4.z, r4.w))
    let seed = fract(size.x * 0.0731 + size.y * 0.1913 + kind * 0.377)
    let w = min(h.y * 0.62, 7.0)
    let ink = cl_tone(col, hover * live, press, dis)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let d = cl_rbox4(p, c, h, r4)
    if kind < 4.5 {
        out = cl_drop(p, c, h, rr, mix(1.0, 0.25, press) * mix(1.0, 0.55, dis), 1.0 + 0.18 * hover * live - 0.5 * press)
        var face = cl_lump4(p, c, h, r4, w, 0.35, mix(0.10, 0.03, press), ink, seed, px, 1.0)
        // squashed in, the slab's edge shades its top
        let sh = clamp(Finish.inset(p, c, h, rr, vec2(0.6, 1.8), 1.8), 0.0, 1.0) * 0.45 * press
        let fc = face.rgb / max(face.a, 0.001)
        face = vec4(mix(fc, cl_deep(fc), clamp(sh / 0.28, 0.0, 1.3)) * face.a, face.a)
        out = Finish.over(out, face)
    } else {
        if kind < 5.5 {
            // a coil of clay laid round the label; the slab shows inside it,
            // lifting a shade under the pointer and pressed in when held
            let t = 1.6
            let dc = abs(cl_rbox(p, c, h - vec2(t, t), max(rr - t, 1.0))) - t
            let g = cl_grad(p, c, h - vec2(t, t), max(rr - t, t)) * mix(-1.0, 1.0, step(0.0, cl_rbox(p, c, h - vec2(t, t), max(rr - t, 1.0))))
            let inner = Finish.cover(d + t, px)
            let dent = clamp(Finish.inset(p, c, h - vec2(t, t), max(rr - t, 1.0), vec2(0.4, 1.0), 1.2), 0.0, 1.0)
            let la = inner * (0.10 * hover * live)
            out = vec4(la, la, la, la)
            let pa = inner * dent * 0.22 * press
            out = Finish.over(out, cl_sh(pa))
            let sd = abs(cl_rbox(p - vec2(0.4, 0.8), c, h - vec2(t, t), max(rr - t, 1.0))) - t
            let sa = (1.0 - smoothstep(-0.5, 1.6, sd)) * 0.30 * mix(1.0, 0.4, press)
            out = Finish.over(out, cl_sh(sa))
            out = Finish.over(out, cl_skin(dc + cl_wob(p - c, seed, 0.25), g, t, p - c, vec2(0.0, 0.0), ink, seed, px, 0.5, h))
        } else {
            let show = clamp(hover * live * 0.8 + press, 0.0, 1.0)
            out = cl_drop(p, c, h, rr, mix(1.0, 0.25, press), 1.0) * show
            out = Finish.over(out, cl_lump4(p, c, h, r4, w, 0.35, 0.08, ink, seed, px, 1.0) * show)
        }
    }
    out = Finish.over(out, cl_focus(d, px, focus * live))
    // The wait spinner, which the stock face drew and this one must too.
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rl = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rl, a0, a0 + 1.5 * PI, 1.4)
        sdf.fill(vec4(0.165, 0.129, 0.110, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The radius of a button's pill: a rounded slab, not a full capsule.
let cl_br = fn(sy: float) -> float {
    return min(sy * 0.38, 10.0)
}

// The flat button's clay by its rung: the small rung pink, the large rung
// cornflower, the rest a bright blue clay. The sizes share the flat button's draw,
// so its height is what tells them apart.
let cl_flat_col = fn(sy: float) -> vec3 {
    let small = 1.0 - step(23.5, sy)
    let large = step(29.0, sy)
    return mix(mix(vec3(0.345, 0.541, 1.0), vec3(0.925, 0.537, 0.757), small), vec3(0.443, 0.627, 0.871), large)
}

mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, 6.0, cl_flat_col(self.rect_size.y)), 6.0)
}
// Default: a sunny yellow clay, a touch lighter than the card's.
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, 6.0, vec3(0.992, 0.855, 0.420)), 6.0)
}
// Primary: navy, a thread of yellow clay laid under its word.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    var out = cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, m, vec3(0.278, 0.333, 0.565))
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let ty = self.rect_size.y - max(self.rect_size.y * 0.15, 3.4) + self.down * 0.5
    let half = max(self.rect_size.x * 0.5 - 17.0, 4.0)
    let a = vec2(self.rect_size.x * 0.5 - half, ty + 0.3)
    let b = vec2(self.rect_size.x * 0.5 + half, ty - 0.3)
    let tc = mix(vec3(0.992, 0.855, 0.420), vec3(0.82, 0.80, 0.81), self.disabled)
    let show = 1.0 - self.loading
    out = Finish.over(out, cl_snake_drop(p, a, b, 1.05, 0.6) * show)
    out = Finish.over(out, cl_snake(p, a, b, 1.05, tc, 0.29, px, 0.3) * show)
    return self.host_over(out, m)
}
// Secondary: leaf green.
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, 6.0, vec3(0.408, 0.718, 0.553)), 6.0)
}
// Tertiary: tangerine.
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, 6.0, vec3(0.945, 0.561, 0.341)), 6.0)
}
// Danger: a strawberry red.
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 0.0, 6.0, vec3(0.918, 0.392, 0.427)), 6.0)
}
// Outline: a coil of navy round the word.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 5.0, 6.0, vec3(0.278, 0.333, 0.565)), 6.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(cl_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cl_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, cl_br(self.rect_size.y)), 6.0, 6.0, vec3(0.992, 0.855, 0.420)), 6.0)
}

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
