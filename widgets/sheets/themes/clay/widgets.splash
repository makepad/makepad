}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 25.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(17.0)
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let c = lo + vec2(sz * 0.5, sz * 0.5)
    return cl_radio(p, c, sz * 0.5, px, self.hover, self.down, self.focus, self.active, self.disabled)
}
// The flatter radio is its word alone: chosen, the word sits in a pocket of
// lavender pressed into the slab; under the pointer the slab lifts behind it.
mod.widgets.RadioButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x - 3.0, px), Finish.snap(o.y + 1.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x + 3.0, px), Finish.snap(o.y + self.rect_size.y - 1.0, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cl_rbox(p, c, h, 6.0)
    let lift = Finish.cover(d, px) * 0.16 * self.hover * live * (1.0 - self.active)
    var out = vec4(lift, lift, lift, lift)
    out = Finish.over(out, cl_pocket(p, c, h, 6.0, vec3(0.765, 0.706, 0.882), 0.77, px) * self.active)
    return Finish.over(out, cl_focus(d, px, self.focus * live))
}

// Radio tabs: each a pill of yellow clay; the chosen one is a pocket of
// charcoal pressed into the slab, its word lit cream.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 6.0 bottom: 2.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = cl_br(size.y)
    let held = clamp(max(self.active, self.down * live), 0.0, 1.0)
    let seed = fract(size.x * 0.0731 + 0.29)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if held > 0.5 {
        let rim = Finish.ring_out(cl_rbox(p, c, h, r), 0.0, 1.2, px) * 0.35
        out = vec4(rim, rim, rim, rim)
        // chosen, a charcoal pocket; held before it is chosen, the yellow
        // clay pressed in, so its dark word still reads
        let pk = mix(vec3(0.930, 0.784, 0.380), vec3(0.314, 0.290, 0.298), self.active)
        out = Finish.over(out, cl_pocket(p, c, h, r, cl_tone(pk, self.hover * live, 0.0, self.disabled), seed, px))
    } else {
        out = cl_drop(p, c, h, r, mix(1.0, 0.5, self.disabled), 1.0 + 0.3 * self.hover * live)
        out = Finish.over(out, cl_lump(p, c, h, r, min(h.y * 0.62, 7.0), 0.35, 0.10, cl_tone(vec3(0.992, 0.855, 0.420), self.hover * live, 0.0, self.disabled), seed, px, 1.0))
    }
    return Finish.over(out, cl_focus(cl_rbox(p, c, h, r), px, self.focus * live))
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #2a211c
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #fbf1dc
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #8f8279

// ---------------------------------------------------------------------------
// SLIDERS. A snake of coloured clay, a yellow pebble riding on it. The snake
// is whole up to the pebble; past it the snake is rolled thinner and paler,
// so the value reads. Each slider kind is its own clay: the slider
// cornflower, the minimal one violet, the round one teal, the band pink.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}

// The riding pebble: a yellow lump a little taller than wide, lifting under
// the pointer and squashed while it is held.
let cl_thumb = fn(p: vec2, c: vec2, h: vec2, px: float, hover: float, press: float, dis: float, seed: float) -> vec4 {
    let live = 1.0 - dis
    let r = min(h.x, h.y) * 0.95
    var out = cl_drop(p, c, h, r, (1.0 - 0.6 * press) * mix(1.0, 0.5, dis), 1.0 + 0.3 * hover * live)
    let col = cl_tone(vec3(0.992, 0.855, 0.420), hover * live, press, dis)
    return Finish.over(out, cl_lump(p, c, h, r, min(h.x, h.y) * 0.85, 0.25, 0.10, col, seed, px, 0.7))
}

// The snake from `x0` to `x1` at height `cy`, `rad` thick, whole between
// `f0` and `f1` and thinner and paler elsewhere.
let cl_track = fn(p: vec2, x0: float, x1: float, cy: float, rad: float, f0: float, f1: float, col: vec3, dis: float, seed: float, px: float) -> vec4 {
    let k = cl_tone(col, 0.0, 0.0, dis)
    let pale = mix(k, cl_ground_col(), 0.45)
    let thin = rad * 0.72
    var out = cl_snake_drop(p, vec2(x0 + thin, cy), vec2(x1 - thin, cy), thin, 0.8)
    out = Finish.over(out, cl_snake(p, vec2(x0 + thin, cy), vec2(x1 - thin, cy), thin, pale, seed + 0.4, px, 0.5))
    if f1 - f0 > 0.5 {
        let a = vec2(max(f0, x0 + rad), cy)
        let b = vec2(max(min(f1, x1 - rad), a.x), cy)
        out = Finish.over(out, cl_snake_drop(p, a, b, rad, 1.0))
        out = Finish.over(out, cl_snake(p, a, b, rad, k, seed, px, 0.6))
    }
    return out
}

mod.widgets.SliderFlat.height = 32.0
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 8.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let span = x1 - x0 - 18.0
    let kx = x0 + 9.0 + self.slide_pos * span
    let ox = x0 + 9.0 + self.origin_pos * span
    let f0 = mix(x0, min(ox, kx), self.arc_origin)
    let f1 = mix(kx, max(ox, kx), self.arc_origin)
    let seed = fract(size.x * 0.0517 + 0.11)
    var out = cl_track(p, x0, x1, cy, 3.7, f0, f1, Finish.lift(vec3(0.290, 0.451, 0.788), 0.08 * max(self.hover, self.drag) * live), self.disabled, seed, px)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    let kh = vec2(8.0, 9.0)
    out = Finish.over(out, cl_thumb(p, kc, kh, px, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled, 0.53 + self.slide_pos * 0.3))
    return Finish.over(out, cl_focus(cl_rbox(p, kc, kh, 7.0), px, self.focus * live))
}
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 8.0}

// The range slider: a pink snake, whole between the two ends and thin
// outside them, a round yellow ball on each end, squashed while it is held.
mod.widgets.RangeSliderFlat.handle_size = 18.0
mod.widgets.RangeSliderFlat.track_inset = 1.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let top = self.label_px
    let cy = Finish.snap(o.y + top + (size.y - top) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let span = max(size.x - self.inset_px * 2.0 - self.handle_px, 1.0)
    let sx = self.inset_px + self.handle_px * 0.5 + self.start_pos * span
    let ex = self.inset_px + self.handle_px * 0.5 + self.end_pos * span
    var out = cl_track(p, x0, x1, cy, 3.7, sx, ex, Finish.lift(vec3(0.878, 0.478, 0.627), 0.08 * max(self.hover, self.drag) * live), self.disabled, 0.37, px)
    let kr = 8.0
    let k0 = vec2(Finish.snap(o.x + sx, px) - o.x, cy)
    let k1 = vec2(Finish.snap(o.x + ex, px) - o.x, cy)
    out = Finish.over(out, cl_thumb(p, k0, vec2(kr, kr), px, max(self.hot_start, self.focus * 0.5) * live, self.drag * self.hot_start * live, self.disabled, 0.21))
    out = Finish.over(out, cl_thumb(p, k1, vec2(kr, kr), px, max(self.hot_end, self.focus * 0.5) * live, self.drag * self.hot_end * live, self.disabled, 0.67))
    return out
}

// The minimal slider: a thin violet snake and a small yellow ball.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 3.5, px) - o.y
    let kr = 5.5
    let kx = kr + self.slide_pos * (size.x - 2.0 * kr)
    var out = cl_track(p, 0.0, size.x, cy, 2.6, 0.0, kx, Finish.lift(vec3(0.478, 0.333, 0.722), 0.08 * max(self.hover, self.drag) * live), self.disabled, 0.83, px)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    out = Finish.over(out, cl_thumb(p, kc, vec2(kr, kr), px, self.hover, self.drag * live, self.disabled, 0.19))
    return Finish.over(out, cl_focus(length(p - kc) - kr, px, self.focus * live))
}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 8.0}

// The round slider: a teal snake beside its word, the value reading after
