mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 8.0}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size + 4.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 44.0, px) - o.x
    let cy = Finish.snap(o.y + size.y * 0.5, px) - o.y
    let kr = 7.0
    let kx = x0 + kr + self.slide_pos * (x1 - x0 - 2.0 * kr)
    var out = cl_track(p, x0, x1, cy, 3.5, x0, kx, Finish.lift(vec3(0.184, 0.647, 0.604), 0.08 * self.hover * live), self.disabled, 0.47, px)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    out = Finish.over(out, cl_thumb(p, kc, vec2(kr, kr), px, self.hover, self.drag * live, self.disabled, 0.61))
    return Finish.over(out, cl_focus(length(p - kc) - kr, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// FADERS. A charcoal snake for the slot, a row of small clay dots either
// side for the scale (a bigger one at each quarter), and a yellow cap 22
// points across and 12 along the travel, a groove pressed across its middle.
mod.widgets.SliderFader.cap_size = 12.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = floor(across * 0.5 / px) * px
    // screen point of a place `a` along the travel, `b` across it
    let a_lo = self.inset_px + 2.5
    let a_hi = along - self.inset_px - 2.5
    let s0 = mix(vec2(a_lo, mid), vec2(mid, size.y - a_lo), vert)
    let s1 = mix(vec2(a_hi, mid), vec2(mid, size.y - a_hi), vert)
    let slot = mix(vec3(0.290, 0.263, 0.271), vec3(0.690, 0.667, 0.675), self.disabled * 0.8)
    var out = cl_snake_drop(p, s0, s1, 2.6, 0.9)
    out = Finish.over(out, cl_snake(p, s0, s1, 2.6, slot, 0.91, px, 0.5))
    // the scale: dots either side of the slot
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let nt = 8.0
    let fi = clamp(floor((a - foot) / travel * nt + 0.5), 0.0, nt)
    let ta = foot + fi / nt * travel
    let major = 1.0 - step(0.1, abs(fi * 0.5 - floor(fi * 0.5 + 0.5)))
    let dr = mix(0.85, 1.25, major)
    let side = mix(-1.0, 1.0, step(mid, b))
    let tb = mid + side * 7.5
    let dq = vec2(a - ta, b - tb)
    let ds = length(dq) - dr
    let dsh = length(dq - mix(vec2(-0.8, 0.4), vec2(0.4, 0.8), 1.0 - vert)) - dr
    let sha = (1.0 - smoothstep(-0.3, 1.0, dsh)) * 0.25
    out = Finish.over(out, cl_sh(sha))
    let dcol = mix(vec3(0.290, 0.263, 0.271), vec3(0.690, 0.667, 0.675), self.disabled * 0.8)
    let dl = 1.0 - 0.35 * smoothstep(-dr, dr, mix(dq.y, -dq.x, vert))
    let da = Finish.cover(ds, px)
    out = Finish.over(out, vec4(dcol * dl * da, da))
    // the cap, drawn in screen space so its light stays on the upper left
    let at = foot + self.slide_pos * travel
    let cw = min(22.0, across)
    let cs = mix(vec2(at, mid), vec2(mid, size.y - at), vert)
    let ch = mix(vec2(self.cap_px * 0.5, cw * 0.5), vec2(cw * 0.5, self.cap_px * 0.5), vert)
    let cc = vec2(Finish.snap(o.x + cs.x, px) - o.x, Finish.snap(o.y + cs.y, px) - o.y)
    let press = self.drag * live
    let r = 3.5
    out = Finish.over(out, cl_drop(p, cc, ch, r, (1.0 - press * 0.6) * mix(1.0, 0.5, self.disabled), 1.0 + 0.3 * self.hover * live))
    let col = cl_tone(vec3(0.992, 0.855, 0.420), max(self.hover, self.focus * 0.5) * live, press, self.disabled)
    out = Finish.over(out, cl_lump(p, cc, ch, r, 3.5, 0.2, 0.08, col, 0.27 + self.slide_pos * 0.4, px, 0.6))
    // the groove across the cap
    let gq = p - cc
    let gl = mix(gq.x, gq.y, vert)
    let gx = mix(gq.y, gq.x, vert)
    let groove = (1.0 - smoothstep(0.3, 0.8, abs(gl))) * step(abs(gx), mix(ch.y, ch.x, vert) - 3.0)
    let gd = groove * (0.45 - 0.25 * step(0.0, gl))
    out = Finish.over(out, cl_sh(gd))
    return Finish.over(out, cl_focus(cl_rbox(p, cc, ch, r), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. A fat disc of clay, its top flattened, turned with its value (its
// lumps and marks turn with it), a short white snake pressed on for the
// pointer. Round the small knobs a ring of charcoal ticks, up to the value
// laid on in clay and past it only pressed in; round the big knobs a
// charcoal snake bent round the scale up to the value, the rest of the
// scale a groove.
let cl_knob = fn(p: vec2, c: vec2, rad: float, px: float, ang: float, hover: float, press: float, dis: float, col: vec3) -> vec4 {
    let live = 1.0 - dis
    var out = cl_drop(p, c, vec2(rad, rad), rad, (1.0 - 0.5 * press) * mix(1.0, 0.5, dis), 1.0 + rad * 0.025 + 0.3 * hover * live)
    let k = cl_tone(col, hover * live, press, dis)
    let cs = cos(ang)
    let sn = sin(ang)
    let q = p - c
    let qr = vec2(q.x * cs + q.y * sn, q.y * cs - q.x * sn)
    let d = length(q) - rad + cl_wob(qr, 0.61, clamp(rad * 0.025, 0.2, 0.7))
    let g = q / max(length(q), 0.0001)
    out = Finish.over(out, cl_skin(d, g, rad * 0.5, qr, q / max(rad, 1.0) * 0.10, k, 0.61, px, 1.6, vec2(rad, rad)))
    let dir = vec2(-sin(ang), cos(ang))
    let a0 = c + dir * rad * 0.16
    let a1 = c + dir * rad * 0.66
    let pr = max(rad * 0.085, 1.2)
    let wcol = mix(vec3(0.992, 0.855, 0.420), vec3(0.85, 0.83, 0.84), dis)
    out = Finish.over(out, cl_snake_drop(p, a0, a1, pr, 0.7))
    return Finish.over(out, cl_snake(p, a0, a1, pr, wcol, 0.23, px, 0.3))
}

// The angle of a point round `c`, 0 at the bottom, clockwise, 0..2 pi.
let cl_ang = fn(q: vec2) -> float {
    var ang = atan2(-q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    return ang
}

// The ticks of a small knob: `n` of them over the sweep, from `r0` to `r1`.
let cl_ticks = fn(p: vec2, c: vec2, r0: float, r1: float, px: float, v: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    let ang = cl_ang(q)
    let n = 10.0
    let fi = clamp(floor((ang - start) / sweep * n + 0.5), 0.0, n)
    let ta = start + fi / n * sweep
    let dir = vec2(-sin(ta), cos(ta))
    let e0 = c + dir * r0
    let e1 = c + dir * r1
    let td = cl_seg(p, e0, e1) - 0.75
    let on = step(fi / n, v + 0.001)
    let ink = mix(vec3(0.231, 0.208, 0.216), vec3(0.690, 0.667, 0.675), dis * 0.8)
    let sd = cl_seg(p - vec2(0.3, 0.6), e0, e1) - 0.75
    let sa = (1.0 - smoothstep(-0.3, 0.9, sd)) * 0.28 * on
    var out = cl_sh(sa)
    let tq = clamp(dot(p - e0, e1 - e0) / max(dot(e1 - e0, e1 - e0), 0.0001), 0.0, 1.0)
    let lit = 1.0 - 0.3 * smoothstep(-0.75, 0.75, dot(p - (e0 + (e1 - e0) * tq), vec2(0.47, 0.88)))
    let ta2 = Finish.cover(td, px)
    out = Finish.over(out, vec4(ink * lit * ta2 * on, ta2 * on))
    // past the value, the tick is only pressed into the slab
    let dent = ta2 * (1.0 - on) * 0.16
    return Finish.over(out, cl_sh(dent))
}

// The value of a big knob: a charcoal snake bent round the scale from its
// start (or its origin) to the value, the rest of the scale a groove.
let cl_arc = fn(p: vec2, c: vec2, ar: float, aw: float, px: float, v0: float, v1: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    let ang = cl_ang(q)
    let rd = abs(length(q) - ar)
    let in_arc = step(start, ang) * step(ang, start + sweep)
    let e0 = c + vec2(-sin(start), cos(start)) * ar
    let e1 = c + vec2(-sin(start + sweep), cos(start + sweep)) * ar
    let track_d = min(mix(1000.0, rd, in_arc), min(length(p - e0), length(p - e1))) - aw * 0.35
    let gr = Finish.cover(track_d, px)
    let lip = Finish.ring_out(track_d, 0.0, px * 1.5, px) * step(0.0, dot(q, vec2(0.47, 0.88))) * 0.45
    var out = vec4(lip, lip, lip, lip)
    let ga = gr * 0.20
    out = Finish.over(out, cl_sh(ga))
    // the snake
    let a0 = start + sweep * v0
    let a1 = start + sweep * max(v1, v0 + 0.002)
    let am = clamp(ang, a0, a1)
    let l0 = c + vec2(-sin(a0), cos(a0)) * ar
    let l1 = c + vec2(-sin(a1), cos(a1)) * ar
    let inside = step(a0, ang) * step(ang, a1)
    let np = mix(mix(l0, l1, step(length(p - l1), length(p - l0))), c + q / max(length(q), 0.0001) * ar, inside)
    let off = p - np
    let dist = length(off)
    let rad = aw * 0.5
    let ink = mix(vec3(0.255, 0.231, 0.239), vec3(0.690, 0.667, 0.675), dis * 0.8)
    let sq = p - vec2(0.4, 0.8) - c
    let sang = cl_ang(sq)
    let sin_arc = step(a0, sang) * step(sang, a1)
    let sdist = min(mix(1000.0, abs(length(sq) - ar), sin_arc), min(length(p - vec2(0.4, 0.8) - l0), length(p - vec2(0.4, 0.8) - l1)))
    let sa = (1.0 - smoothstep(rad - 0.5, rad + 1.6, sdist)) * 0.28 * step(0.002, v1 - v0)
    out = Finish.over(out, cl_sh(sa))
    let body = cl_skin(dist - rad, off / max(dist, 0.0001), rad, vec2(am * ar, length(q) - ar), vec2(0.0, 0.0), ink, 0.87, px, 0.4, vec2(ar, rad))
    return Finish.over(out, body * step(0.002, v1 - v0))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
// The small knobs: sunny yellow-orange clay.
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - dia * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let rad = floor(rr / 1.24 / px) * px
    var out = cl_ticks(p, c, rad + 2.0, rr + 0.5, px, self.slide_pos, gap, self.disabled)
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, cl_knob(p, c, rad, px, ang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled, vec3(0.953, 0.659, 0.278)))
    return Finish.over(out, cl_focus(length(p - c) - rad, px, self.focus * live))
}
// Knob captions are letters pressed into the slab: small semibold words.
mod.widgets.RotaryKnob.draw_text.color = #3b302a
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_bold{font_size: 7.75}

// The big knobs: a thick snake of bright blue plasticine rolled up by hand
// into a coil inside its scale, as such coils come out: the tube about a
// fifth of the coil across, so a little over two turns; each turn pressed
// tight against the next, so their sections meet in a narrow crease. Every
// turn sits a little off the middle by the same sway, so the outline, which
// a spiral grows by a whole tube width round the coil, lies close to one
// circle and steps only at the tail's tip. The tube is pressed flat on top:
// a broad soft top, its sides rounding down into the crease. A fine ripple
// runs along its length. The inner end a fat blob in the middle; the outer
// end tapering a little and tucking in against the turn inside it in a
// rounded tip. Lit from the upper left: a broad soft light across each
// turn's top, its far side shading down into the crease, a little light
// bounced up from the slab. Its skin carries the marks every part of the
// sheet has: soft lumps and thumb dents, fingerprints, an air pit, a few
// smoothing strokes along the tube, the mottle of the mix and a fine grain,
// all turning with it. The whole coil turns with the value and its tip is
// the pointer.

// How far along the tube the angle `th` lies, in points.
let cl_coil_s = fn(th: float, r0: float, b: float) -> float {
    return r0 * th + 0.5 * b * th * th
}
// The coil's centre line at angle `th`: an Archimedean spiral, `pitch` a
// turn; every turn swayed off the middle by `kap` times the sway that rounds
// the last turn's outline into a circle round the coil's middle; the tail
// tucking in over its last quarter turn; a fine sideways ripple every tube
// width and a half or so, as a snake rolled by hand comes out, growing in
// over the first turn so the middle stays closed. With the radius's rate of
// change.
let cl_coil_r = fn(th: float, r0: float, b: float, pitch: float, t0: float, tmax: float, kap: float) -> float {
    let gr = smoothstep(0.0, 6.2831853, th)
    let s = cl_coil_s(th, r0, b) / (2.0 * t0)
    let ty = clamp((th - tmax + 1.5707963) / 1.5707963, 0.0, 1.0)
    let tuck = 0.30 * pitch * ty * ty * (3.0 - 2.0 * ty)
    return r0 + b * th + 2.0 * b * kap * sin(th - tmax) - tuck + pitch * gr * (0.0175 * sin(s * 4.2 + 0.7) + 0.0125 * sin(s * 5.3 + 2.1))
}
let cl_coil_dr = fn(th: float, r0: float, b: float, pitch: float, t0: float, tmax: float, kap: float) -> float {
    let gr = smoothstep(0.0, 6.2831853, th)
    let s = cl_coil_s(th, r0, b) / (2.0 * t0)
    let ds = (r0 + b * th) / (2.0 * t0)
    let ty = clamp((th - tmax + 1.5707963) / 1.5707963, 0.0, 1.0)
    let dtuck = 0.30 * pitch * 6.0 * ty * (1.0 - ty) / 1.5707963
    return b + 2.0 * b * kap * cos(th - tmax) - dtuck + pitch * gr * (0.0175 * 4.2 * cos(s * 4.2 + 0.7) + 0.0125 * 5.3 * cos(s * 5.3 + 2.1)) * ds
}
// The tube's girth at `th`: a fine ripple of swells and pinches of about a
// twentieth, one every tube width or so; the inner end a fatter blob, the
// tail tapering a little toward its tip.
let cl_coil_t = fn(th: float, r0: float, b: float, t0: float, tmax: float) -> float {
    let s = cl_coil_s(th, r0, b) / (2.0 * t0)
    let sw = 1.0 + 0.05 * (0.6 * sin(s * 4.0 + 1.1) + 0.4 * sin(s * 5.6 + 0.3))
    let inner = 1.0 + 0.30 * exp(-th / 1.8)
    let tail = 1.0 - 0.14 * smoothstep(tmax - 1.6, tmax, th)
    return t0 * sw * inner * tail
}
// One candidate turn for the point `q`: the point of the centre line
// nearest `q` on the turn that crosses its ray at angle `th`, found by two
// Gauss-Newton steps from there along the line (clamped to the coil's ends,
// where the nearest point is the end itself and the tube a rounded tip).
// Returns the distance to the tube's surface (.x, negative inside), the way
// out from the centre line (.yz) and the angle of that nearest point (.w).
let cl_coil_c = fn(q: vec2, th: float, r0: float, b: float, pitch: float, t0: float, tmax: float, kap: float) -> vec4 {
    var a = clamp(th, 0.0, tmax)
    let r1 = cl_coil_r(a, r0, b, pitch, t0, tmax, kap)
    let d1 = cl_coil_dr(a, r0, b, pitch, t0, tmax, kap)
    let u1 = vec2(cos(a), sin(a))
    let v1 = u1 * d1 + vec2(-u1.y, u1.x) * r1
    a = clamp(a + clamp(dot(q - u1 * r1, v1) / max(dot(v1, v1), 0.0001), -1.0, 1.0), 0.0, tmax)
    let r2 = cl_coil_r(a, r0, b, pitch, t0, tmax, kap)
    let d2 = cl_coil_dr(a, r0, b, pitch, t0, tmax, kap)
    let u2 = vec2(cos(a), sin(a))
    let v2 = u2 * d2 + vec2(-u2.y, u2.x) * r2
    a = clamp(a + clamp(dot(q - u2 * r2, v2) / max(dot(v2, v2), 0.0001), -1.0, 1.0), 0.0, tmax)
    let rr = cl_coil_r(a, r0, b, pitch, t0, tmax, kap)
    let tt = cl_coil_t(a, r0, b, t0, tmax)
    let pc = vec2(cos(a), sin(a)) * rr
    let lp = length(q - pc)
    let gg = (q - pc) / max(lp, 0.0001)
    return vec4(lp - tt, gg.x, gg.y, a)
}
// The turn of the coil nearest `q`, as `cl_coil_c` gives it, among the
// four turns that can lie along its ray.
let cl_coil = fn(q: vec2, r0: float, b: float, pitch: float, t0: float, tmax: float, kap: float) -> vec4 {
    let tau = 6.2831853
    var ph = atan2(q.y, q.x)
    if ph < 0.0 {
        ph = ph + tau
    }
    let k0 = floor(((length(q) - r0) / b - ph) / tau)
    let c0 = cl_coil_c(q, ph + tau * (k0 - 1.0), r0, b, pitch, t0, tmax, kap)
    let c1 = cl_coil_c(q, ph + tau * k0, r0, b, pitch, t0, tmax, kap)
    let c2 = cl_coil_c(q, ph + tau * (k0 + 1.0), r0, b, pitch, t0, tmax, kap)
    let c3 = cl_coil_c(q, ph + tau * (k0 + 2.0), r0, b, pitch, t0, tmax, kap)
    var best = c0
    if c1.x < best.x {
        best = c1
    }
    if c2.x < best.x {
        best = c2
    }
    if c3.x < best.x {
        best = c3
    }
    return best
}
// How far beyond the nearest turn the next one lies: where the two meet,
// the crease. A turn less than half a turn along the tube from the nearest
// (an end and the run it closes) is the same surface and does not count.
let cl_coil_gap = fn(q: vec2, r0: float, b: float, pitch: float, t0: float, tmax: float, kap: float, best: vec4) -> float {
    let tau = 6.2831853
    var ph = atan2(q.y, q.x)
    if ph < 0.0 {
        ph = ph + tau
    }
    let k0 = floor(((length(q) - r0) / b - ph) / tau)
    let c0 = cl_coil_c(q, ph + tau * (k0 - 1.0), r0, b, pitch, t0, tmax, kap)
    let c1 = cl_coil_c(q, ph + tau * k0, r0, b, pitch, t0, tmax, kap)
    let c2 = cl_coil_c(q, ph + tau * (k0 + 1.0), r0, b, pitch, t0, tmax, kap)
    let c3 = cl_coil_c(q, ph + tau * (k0 + 2.0), r0, b, pitch, t0, tmax, kap)
    var sec = 1000.0
    if abs(c0.w - best.w) > 3.1415927 {
        sec = min(sec, c0.x)
    }
    if abs(c1.w - best.w) > 3.1415927 {
        sec = min(sec, c1.x)
    }
    if abs(c2.w - best.w) > 3.1415927 {
        sec = min(sec, c2.x)
    }
    if abs(c3.w - best.w) > 3.1415927 {
        sec = min(sec, c3.x)
    }
    return sec - best.x
}

mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let room = vec2(size.x, size.y - 24.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 24.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let aw = 3.6
    let ar = floor((rr - aw * 0.5) / px) * px
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    var out = cl_arc(p, c, ar, aw, px, v0, v1, gap, self.disabled)
    // the coil: 2.3 turns of a tube `t0` in radius, its turns a little
    // closer than its girth so each presses into the next; the outline's
    // circle centred in the scale, its side, the ripple and the tail's tip
    // inside it
    let avail = ar - aw * 0.5 - 2.5
    let turns = 2.3
    let tau = 6.2831853
    let tmax = tau * turns
    let kap = 1.0
    let pitch = avail / 2.83
    let b = pitch / tau
    let t0 = 0.56 * pitch
    let r0 = 0.32 * pitch
    // the point it turns about: its centre of mass, the centroid of its
    // filled area, in its own frame; measured once from that area (every
    // length of the coil is a multiple of the pitch, so it scales with it)
    let co = vec2(-0.0341, -0.0564) * pitch
    // turned so the tip points at the value
    let rce = cl_coil_r(tmax, r0, b, pitch, t0, tmax, kap)
    let dre = cl_coil_dr(tmax, r0, b, pitch, t0, tmax, kap)
    let tg = normalize(vec2(cos(tmax), sin(tmax)) * dre + vec2(-sin(tmax), cos(tmax)) * rce)
    let tip0 = vec2(cos(tmax), sin(tmax)) * rce + tg * cl_coil_t(tmax, r0, b, t0, tmax)
    let tip = tip0 - co
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    let al = atan2(cos(ang), -sin(ang)) - atan2(tip.y, tip.x)
    let cs = cos(al)
    let sn = sin(al)
    let press = self.drag * live
    let hover = max(self.hover, self.focus * 0.5) * live
    // what it throws on the slab: a soft contact shadow down and to the
    // right, from the coil's own outline
    let lift = 1.0 + t0 * 0.07 + 0.3 * hover
    let ps = p - c - vec2(0.7, 1.45) * lift
    let qs = vec2(ps.x * cs + ps.y * sn, ps.y * cs - ps.x * sn) + co
    let sds = cl_coil(qs, r0, b, pitch, t0, tmax, kap).x
    let pt = p - c - vec2(0.15, 0.35)
    let qt = vec2(pt.x * cs + pt.y * sn, pt.y * cs - pt.x * sn) + co
    let sdt = cl_coil(qt, r0, b, pitch, t0, tmax, kap).x
    let tight = (1.0 - smoothstep(-0.8, 1.4, sdt)) * 0.16
    let soft = (1.0 - smoothstep(-1.8 * lift, 3.0 * lift, sds)) * 0.26
    let sa = clamp((tight + soft * (1.0 - tight)) * (1.0 - 0.5 * press) * mix(1.0, 0.5, self.disabled), 0.0, 1.0)
    out = Finish.over(out, cl_sh(sa))
    // the tube
    let dp = p - c
    let q = vec2(dp.x * cs + dp.y * sn, dp.y * cs - dp.x * sn) + co
    let cl = cl_coil(q, r0, b, pitch, t0, tmax, kap)
    let a = Finish.cover(cl.x, px)
    if a > 0.001 {
        let tt = cl_coil_t(cl.w, r0, b, t0, tmax)
        // its section: pressed flat on top, a broad soft top and sides
        // rounding down into the crease, flatter still at the fat inner end;
        // the slope across it, turned back to the screen
        let flat = exp(-cl.w / 1.5)
        let s = clamp((cl.x + tt) / tt, 0.0, 1.0)
        let sl = pow(s, mix(1.7, 2.3, flat))
        let zz = sqrt(max(1.0 - sl * sl, 0.0))
        let gs = vec2(cl.y * cs - cl.z * sn, cl.y * sn + cl.z * cs)
        // the hands' marks on its skin, laid in the coil's own frame so they
        // turn with it: the lumps and shallow thumb dents every part of the
        // sheet has, tilting the skin a little, strongest on the tops
        let bq = cl_bump(q, 0.61)
        let bs = vec2(bq.x * cs - bq.y * sn, bq.x * sn + bq.y * cs) * (0.4 + 0.6 * zz)
        let nf = normalize(vec3(gs * sl, zz))
        let n = normalize(vec3(gs * sl + bs * zz, zz))
        let lk = vec3(-0.30, -0.57, 0.77)
        // where it meets the next turn: the crease, a soft wide groove in
        // the turns' own deeper colour, no dark line
        let cg = cl_coil_gap(q, r0, b, pitch, t0, tmax, kap, cl)
        let cw = 1.0 - smoothstep(0.0, 0.85 * tt, cg)
        // light bounced up from the slab onto its lower outer side
        let bounce = clamp(dot(gs, vec2(0.47, 0.88)), 0.0, 1.0) * smoothstep(0.55, 1.0, s) * (1.0 - cw)
        let ao = cw * pow(1.0 - zz, 1.5) * 0.42 + (1.0 - smoothstep(0.0, 2.5 * px, cg)) * 0.12
        // each turn's own round form, a little more than the soft light
        // alone gives it: its lit flank paler, its far flank deeper
        let form = clamp((dot(nf, lk) - 0.77) * 0.40, -0.12, 0.10)
        var shade = (dot(n, lk) - dot(nf, lk)) * 0.74 - ao + form
        // a faint smudge or two where a thumb rubbed it
        let sm1 = exp(-dot((q - vec2(0.35, -0.25) * rce) * vec2(1.0, 2.2), (q - vec2(0.35, -0.25) * rce) * vec2(1.0, 2.2)) / (0.10 * rce * rce))
        let sm2 = exp(-dot((q - vec2(-0.30, 0.40) * rce) * vec2(2.0, 1.0), (q - vec2(-0.30, 0.40) * rce) * vec2(2.0, 1.0)) / (0.07 * rce * rce))
        shade = shade - 0.05 * sm1 + 0.04 * sm2
        // the odd air pit and a tool mark, as on every part; two soft
        // fingerprints pressed into the tops at other angles, their ridges
        // as coarse as the ground's so they never beat against the coil's
        // own shading; and a few smoothing strokes along the tube, where a
        // finger ran down it. All of it on the tops, gone toward the crease.
        let top = smoothstep(0.15, 0.6, zz)
        var mk = cl_marks(q, vec2(rce, rce) * 0.7, 0.61, 0.0)
        let fsz = clamp(rce * 0.5, 10.0, 24.0)
        mk = mk + cl_print_c(q, vec2(cos(2.9), sin(2.9)) * rce * 0.55, fsz, 2.2, 0.37, 2.2) * 0.045
        mk = mk + cl_print_c(q, vec2(cos(5.1), sin(5.1)) * rce * 0.8, fsz * 0.9, 4.4, 0.83, 2.3) * 0.045
        let across = (cl.x + tt) / tt
        let along = cl.w * (r0 + b * cl.w)
        let stroke = sin(across * 9.4 + (Finish.noise(vec2(along * 0.06, 3.7)) - 0.5) * 4.0) * smoothstep(0.45, 0.8, Finish.noise(vec2(along * 0.035 + 1.3, 8.1)))
        shade = shade + (mk + 0.022 * stroke) * top
        // the mottle of a hand-mixed colour
        let base = cl_tone(vec3(0.165, 0.400, 0.800), hover, press, self.disabled) * (1.0 + (Finish.fbm(q * 0.05 + vec2(19.3, 10.6)) - 0.5) * 0.12)
        var col = cl_detail(cl_light(nf, base), shade)
        col = mix(col, mix(base, vec3(1.0, 1.0, 1.0), 0.3), bounce * 0.10)
        // a broad satin sheen along the crest
        let sp = pow(max(dot(n, vec3(-0.159, -0.303, 0.940)), 0.0), 5.0) * 0.05 * (1.0 - cw)
        col = col + mix(vec3(1.0, 1.0, 1.0), base, 0.35) * sp
        col = col + g3(Finish.grain(dp / px, 0.010))
        col = clamp(col, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
        out = Finish.over(out, vec4(col * a, a))
    }
    return Finish.over(out, cl_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// SCREENS. The readouts, the screen, the dial's readout and the needle
// meter share one housing: a frame of charcoal clay rolled round a pane of
// dark glass, the slab's edge shading the pane under its top, a quiet
// diagonal sheen across the glass. `b` is the frame's width.
let cl_screen = fn(p: vec2, lo: vec2, hi: vec2, r: float, b: float, px: float, face: vec3, seed: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rr = min(r, min(h.x, h.y))
    var out = cl_drop(p, c, h, rr, 1.0, 1.0)
    out = Finish.over(out, cl_lump(p, c, h, rr, b + 1.0, 0.25, 0.04, vec3(0.333, 0.306, 0.314), seed, px, 0.6))
    let hf = max(h - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(rr - b, 1.5)
    let fd = cl_rbox(p, c, hf, rf)
    let insh = clamp(Finish.inset(p, c, hf, rf, vec2(0.6, 1.6), 1.6), 0.0, 1.0)
    var col = face * (1.0 - 0.55 * insh)
    col = mix(col, col * 0.5, Finish.band(fd, 0.0, px, px))
    let fa = Finish.cover(fd, px)
    return Finish.over(out, vec4(col * fa, fa))
}
// The glass over the pane: a straight diagonal band from the upper left and
// a lighter line just inside the top edge.
let cl_glass = fn(p: vec2, lo: vec2, hi: vec2, r: float, b: float, px: float, sheen: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hf = max(h - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(min(r, min(h.x, h.y)) - b, 1.5)
    let fd = cl_rbox(p, c, hf, rf)
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let top = Finish.cover(abs(p.y - (c.y - hf.y) - px * 1.5) - px * 0.5, px) * 0.8
    let a = clamp(sheen * (band + top), 0.0, 1.0) * Finish.cover(fd + px, px)
    return vec4(a, a, a, a)
}

mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.padding = mod.turtle.Inset{top: 8.0 right: 10.0 bottom: 8.0 left: 10.0}
mod.widgets.ScreenView.bezel = 3.5
mod.widgets.ScreenView.sheen = 0.06
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 5.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    var res = cl_screen(p, lo, hi, 7.0, max(self.bezel, 3.0), px, self.color.rgb, fract(self.rect_size.x * 0.031))
    if self.scan > 0.0 {
        let s = Finish.scan(p.y, px, 3.0 * px, self.scan)
        res = vec4(res.rgb * mix(1.0, s, 0.6), res.a)
    }
    return res * self.color.a
}
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px)) - self.rect_pos
    return cl_glass(p, lo, hi, 7.0, max(self.bezel, 3.0), px, self.sheen)
}

// The dial's readout is the same housing, small.
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 3.0 bottom: 3.0}
mod.widgets.RotaryFlat.text_input.min_height = 22.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(1.5, 2.0)
    var out = cl_screen(p, lo, hi, 6.0, 2.5, px, vec3(0.173, 0.153, 0.161), fract(self.rect_size.x * 0.043))
    return Finish.over(out, cl_glass(p, lo, hi, 6.0, 2.5, px, 0.06))
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #f6ead2
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #fff6e4
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #fff6e4
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #b5a998
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_label{font_size: 9.0}

// THE NEEDLE METER sits in the same housing: its scale printed on the dark
// glass in the screen's cream, the red zone a coral band along the arc, the
// needle coral, its root under a yellow clay bead.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#f06a5c)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#f2836f)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let b = 3.5
    var res = cl_screen(p, lo, hi, 7.0, b, px, self.color.rgb, 0.83)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hf = max(h - vec2(b, b), vec2(0.5, 0.5))
    let fd = cl_rbox(p, c, hf, 3.5)
    let inface = Finish.cover(fd + px, px)
    var col = res.rgb / max(res.a, 0.001)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let ink = self.color_scale.rgb
    let arc = Finish.cover(abs(r - rr) - px * 0.6, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.6, 1.1, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    col = mix(col, ink, max(arc, tick) * 0.9 * inface)
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        col = mix(col, self.color_zone.rgb, zone_t * zone_r * inface)
    }
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - px * 0.75, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along, px)
    col = mix(col, self.color_needle.rgb, needle * inface)
    // the bead over the needle's root
    let br = max(self.pivot_size, 3.0)
    let bead = cl_ball(p, pv, br, 1.0, vec3(0.992, 0.855, 0.420), 0.47, px, 0.3, 0.1)
    col = col * (1.0 - bead.a * inface) + bead.rgb * inface
    res = vec4(col * res.a, res.a)
    res = Finish.over(res, cl_glass(p, lo, hi, 7.0, b, px, 0.06))
    return res * self.color.a * self.opacity
}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A slab of white clay inside the field's box, its shadow in
// the room left under it; words sit on the clay. Off, the slab is grey;
// with the focus a sky-blue thread lies along its rim.
let cl_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float, col: vec3) -> vec4 {
    let lo = vec2(Finish.snap(o.x + 0.5, px), Finish.snap(o.y + 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 2.0, px), Finish.snap(o.y + size.y - 2.5, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let rr = min(r, h.y)
    let k = cl_tone(col, hover, 0.0, dis)
    var out = cl_drop(p, c, h, rr, mix(0.9, 0.5, dis), 0.75)
    out = Finish.over(out, cl_lump(p, c, h, rr, min(h.y * 0.55, 6.0), 0.3, 0.05, k, fract(size.x * 0.0371 + size.y * 0.13), px, 0.9))
    let d = cl_rbox(p, c, h, rr)
    let f = Finish.cover(abs(d + 1.2) - 0.75, px) * focus * (1.0 - dis)
    let lit = 1.0 - 0.3 * smoothstep(-1.0, 1.0, dot(p - c, vec2(0.47, 0.88)) / max(h.y, 1.0))
    return Finish.over(out, vec4(vec3(0.310, 0.498, 0.847) * lit * f, f))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cl_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 7.0, vec3(0.969, 0.957, 0.945))
}
mod.widgets.TextInputFlat.draw_text.color_empty = #43365a
mod.widgets.TextInputFlat.draw_text.color_disabled = #847872
mod.widgets.TextInputFlat.draw_cursor.color = #2a211c

// NUMBER FIELDS. The white slab, and on its right a stepper: a greyer
// white lump split by a pressed groove, a charcoal chevron on each half;
// the half under the pointer lifts, the held half is squashed.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cl_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 7.0, vec3(0.969, 0.957, 0.945))
}
mod.widgets.NumberField.pad_left = 9.0
mod.widgets.NumberSpin.width = 16.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 1.5, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 3.0, px), Finish.snap(o.y + self.rect_size.y - 4.0, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let mid = Finish.snap(o.y + c.y, px) - o.y
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let col = cl_tone(vec3(0.902, 0.890, 0.878), hot, dn, self.disabled)
    var out = cl_drop(p, c, h, 4.0, 0.6, 0.6)
    out = Finish.over(out, cl_lump(p, c, h, 4.0, 3.0, 0.15, 0.06, col, 0.39, px, 0.5))
    // the groove between the halves
    let gy = abs(p.y - mid)
    let gr = (1.0 - smoothstep(0.3, 0.8, gy)) * step(abs(p.x - c.x), h.x - 2.5) * 0.35
    out = Finish.over(out, cl_sh(gr))
    let ink = mix(vec3(0.200, 0.180, 0.188), vec3(0.560, 0.540, 0.550), self.disabled)
    let cu = vec2(c.x, (lo.y + mid) * 0.5 + 0.4)
    let cd = vec2(c.x, (mid + hi.y) * 0.5 - 0.4)
    out = Finish.over(out, cl_hook(p, cu + vec2(-2.6, 1.3), cu + vec2(0.0, -1.3), cu + vec2(2.6, 1.3), 0.75, ink, 0.17, px))
    return Finish.over(out, cl_hook(p, cd + vec2(-2.6, -1.3), cd + vec2(0.0, 1.3), cd + vec2(2.6, -1.3), 0.75, ink, 0.29, px))
}

// The drag-number: the white slab, its value a deeper wash on the clay.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = cl_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 7.0, vec3(0.969, 0.957, 0.945))
    let d = cl_rbox(p, self.rect_size * 0.5 - vec2(0.75, 1.0), self.rect_size * 0.5 - vec2(2.5, 2.75), 5.0)
    let wx = 2.0 + (self.rect_size.x - 4.0) * max(self.fill, 0.0)
    let wash = step(0.0, self.fill) * step(p.x, wx) * Finish.cover(d, px) * 0.12
    return Finish.over(out, vec4(0.188 * wash, 0.122 * wash, 0.200 * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #2a211c
mod.widgets.ValueInput.draw_text.text_style = mod.theme.font_label{font_size: 8.5 line_spacing: 1.0}
mod.widgets.ValueInput.arrow_color = #3b302a
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// ---------------------------------------------------------------------------
// DROP-DOWNS. A mint pill with a charcoal snake bent into a chevron at its
// right end. Open, it is held squashed.
// `ins` 1: the drop-down stands in the field row, whose box is two points
// taller than a pill; its pill takes the field slab's rows.
let cl_dropdown = fn(pos0: vec2, size0: vec2, o0: vec2, px: float, hover: float, held: float, focus: float, dis: float, ins: float) -> vec4 {
    let m = 5.0
    let p = pos0 * (size0 + vec2(2.0 * m, 2.0 * m)) - vec2(m, m) - vec2(0.0, 0.5 * ins)
    let size = size0 - vec2(1.5 * ins, 3.0 * ins)
    let o = o0 + vec2(0.0, 0.5 * ins)
    let pos = (p + vec2(m, m)) / (size + vec2(2.0 * m, 2.0 * m))
    var out = cl_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(8.0, 8.0, 8.0, 8.0), 0.0, m, vec3(0.224, 0.820, 0.455))
    let live = 1.0 - dis
    let dn = held * live * 0.5
    let cc = vec2(Finish.snap(o.x + size.x - 13.0, px) - o.x, size.y * 0.5 + dn)
    let ink = mix(vec3(0.200, 0.180, 0.188), vec3(0.560, 0.540, 0.550), dis)
    return Finish.over(out, cl_hook(p, cc + vec2(-3.4, -1.7), cc + vec2(0.0, 1.7), cc + vec2(3.4, -1.7), 0.95, ink, 0.51, px))
}

mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 10.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDown.padding = mod.turtle.Inset{left: 10.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cl_dropdown(self.pos, self.rect_size, self.rect_pos, px, self.hover, max(self.down, self.active), self.focus, self.disabled, 1.0)
}

// The select wears a button of its own, built before this sheet: it is given
// the drop-down's face, its grown quad, and no clip, here by name.
mod.widgets.Select.clip_x = false
mod.widgets.Select.clip_y = false
mod.widgets.MultiSelect.clip_x = false
mod.widgets.MultiSelect.clip_y = false
mod.widgets.Select.face.clip_x = false
mod.widgets.Select.face.clip_y = false
mod.widgets.MultiSelect.face.clip_x = false
mod.widgets.MultiSelect.face.clip_y = false
mod.widgets.Select.face.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.MultiSelect.face.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Select.face.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cl_dropdown(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, 0.0)
}
mod.widgets.MultiSelect.face.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cl_dropdown(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, 0.0)
}
mod.widgets.Select.face.padding.right = 30.0
mod.widgets.MultiSelect.face.padding.right = 30.0

// The combo box: a mint slab one types on, with the chevron at its end.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 10.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let held = self.down * self.hover * live
    var out = cl_field(p, size, o, px, self.hover, self.focus, self.disabled, 8.0, vec3(0.224, 0.820, 0.455))
    let cc = vec2(Finish.snap(o.x + size.x - 14.5, px) - o.x, (size.y - 2.0) * 0.5 + held * 0.5)
    let ink = mix(vec3(0.200, 0.180, 0.188), vec3(0.560, 0.540, 0.550), self.disabled)
    return Finish.over(out, cl_hook(p, cc + vec2(-3.4, -1.7), cc + vec2(0.0, 1.7), cc + vec2(3.4, -1.7), 0.95, ink, 0.51, px))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. One slab across the strip; the chosen segment is a
// pocket of charcoal pressed into it, its word lit cream.
let cl_strip = fn(p: vec2, size: vec2, o: vec2, px: float, col: vec3) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = cl_br(size.y)
    var out = cl_drop(p, c, h, r, 1.0, 1.0)
    return Finish.over(out, cl_lump(p, c, h, r, min(h.y * 0.6, 7.0), 0.4, 0.08, col, fract(size.x * 0.0293 + 0.71), px, 1.0))
}

mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cl_strip(p, self.rect_size, self.rect_pos, px, vec3(0.992, 0.855, 0.420))
}
// The pill is the segment's own box, two points in from the strip; the
// pocket is pressed in that box, a point in at its sides.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(2.0, 2.0), self.rect_size + vec2(4.0, 4.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(4.0, 4.0)) - vec2(2.0, 2.0)
    let lo = vec2(Finish.snap(o.x + 0.5, px), Finish.snap(o.y - 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 0.5, px), Finish.snap(o.y + size.y + 0.5, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rim = Finish.ring_out(cl_rbox(p, c, h, 7.0), 0.0, 1.2, px) * 0.30
    var out = vec4(rim, rim, rim, rim)
    return Finish.over(out, cl_pocket(p, c, h, 7.0, vec3(0.314, 0.290, 0.298), fract(size.x * 0.047), px))
}
mod.widgets.SegmentedControlFlat.draw_text.color = #2a211c
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #fbf1dc
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #fbf1dc
mod.widgets.SegmentedControl.palette.on_neutral_container = #fbf1dc

// The tab strip: a periwinkle slab; the tab in use a charcoal pocket, a
// hovered tab a pale dent, the quiet ones split by short pressed grooves.
// The tabs share the strip down to 40 points each, so three of them and the
// add mark stand inside a narrow column; their words are the round face
// rolled narrower (its width axis at 75), and the close mark is a small
// cross at the right of its cell, clear of the word.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.tab_min_width = 40.0
mod.widgets.Tabs.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cl_strip(p, self.rect_size, self.rect_pos, px, vec3(0.392, 0.792, 0.996))
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = self.rect_size * 0.5 - vec2(2.5, 3.0)
    let d = cl_rbox(p, self.rect_size * 0.5, h, 6.0)
    let sh = clamp(Finish.inset(p, self.rect_size * 0.5, h, 6.0, vec2(0.5, 1.0), 1.2), 0.0, 1.0) * 0.18
    let a = Finish.cover(d, px)
    let l = a * 0.14
    return Finish.over(vec4(l, l, l, l), cl_sh(sh * a))
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * size
    let lo = vec2(Finish.snap(o.x + 2.5, px), Finish.snap(o.y + 2.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 2.5, px), Finish.snap(o.y + size.y - 2.5, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    return cl_pocket(p, c, h, 7.0, vec3(0.314, 0.290, 0.298), fract(size.x * 0.047 + 0.3), px)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y0 = self.rect_size.y * 0.28
    let y1 = self.rect_size.y * 0.72
    let iny = smoothstep(y0, y0 + 1.5, p.y) * (1.0 - smoothstep(y1 - 1.5, y1, p.y))
    let dk = step(p.x, px) * iny * 0.30
    let lt = step(px, p.x) * step(p.x, 2.0 * px) * iny * 0.40
    return Finish.over(cl_sh(dk), vec4(lt, lt, lt, lt))
}
mod.widgets.Tabs.draw_mark.color = #f3e6cf
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    // the close cross keeps to the right of its cell, the plus to its middle
    let cxo = mix(self.rect_size.x * 0.5 + 3.6, self.rect_size.x * 0.5, self.plus)
    let c = vec2(Finish.snap(o.x + cxo, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // two short snakes crossed: an x, or turned upright, a plus
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(2.7, 4.0, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(-sin(a), cos(a)) * r
    let col = mix(self.color.rgb, vec3(0.231, 0.208, 0.216), self.plus)
    var out = cl_snake_drop(p, c - u, c + u, 0.95, 0.7)
    out = Finish.over(out, cl_snake_drop(p, c - v, c + v, 0.95, 0.7))
    out = Finish.over(out, cl_snake(p, c - u, c + u, 0.95, col, 0.33, px, 0.3))
    out = Finish.over(out, cl_snake(p, c - v, c + v, 0.95, col, 0.37, px, 0.3))
    return out * self.color.a
}
mod.widgets.Tabs.draw_text.color = #2a211c
mod.widgets.Tabs.draw_text_active.color = #fbf1dc
// The strip centres a 14 point line box, which leaves the capitals high in
// a 26 point slab: they are dropped to its middle.
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_regular{font_size: 7.25 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Fredoka-Variable.ttf") weight: 520.0 axes: "wdth 75" asc: 0.0 desc: 0.0}}}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_regular{font_size: 7.25 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Fredoka-Variable.ttf") weight: 540.0 axes: "wdth 75" asc: 0.0 desc: 0.0}}}
mod.widgets.Tabs.draw_text.text_style.top_drop = 0.22
mod.widgets.Tabs.draw_text_active.text_style.top_drop = 0.22

// ---------------------------------------------------------------------------
// PROGRESS. A thin groove pressed into the slab its whole length, and the
// value a violet snake laid in it, as thick as the bar. The unknown value is
// a rope twisted from a pink and a violet snake, still: a face may not run a
// clock.
mod.widgets.ProgressBarFlat.height = 10.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = uniform(10.0)
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let cy = Finish.snap(o.y + size.y * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + size.x * self.end, px) - o.x
    let rad = th * 0.5
    let dis = step(4.5, self.intent)
    // the groove
    let gd = abs(p.y - cy) - 1.1
    let gx = step(x0 + 1.0, p.x) * step(p.x, x1 - 1.0)
    let ga = Finish.cover(gd, px) * gx * 0.22 * self.track
    var out = cl_sh(ga)
    let gl = Finish.cover(abs(p.y - cy - 1.1 - px * 0.5) - px * 0.5, px) * gx * 0.45 * self.track
    out = Finish.over(out, vec4(gl, gl, gl, gl))
    // the snake
    var v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
    var col = vec3(0.541, 0.384, 0.788)
    if self.intent > 0.5 {
        col = self.fill_color().rgb
    }
    col = mix(col, vec3(0.792, 0.773, 0.780), dis * 0.85)
    if self.value < 0.0 {
        v1 = x1
        let tw = fract((p.x - (p.y - cy) * 1.3) / 8.0)
        let pink = smoothstep(0.42, 0.5, tw) * (1.0 - smoothstep(0.92, 1.0, tw))
        col = mix(vec3(0.541, 0.384, 0.788), vec3(0.902, 0.522, 0.659), pink)
    }
    if v1 - x0 > 0.5 {
        let a = vec2(x0 + rad, cy)
        let b = vec2(max(v1 - rad, x0 + rad), cy)
        out = Finish.over(out, cl_snake_drop(p, a, b, rad, 1.0))
        var body = cl_snake(p, a, b, rad, col, fract(size.x * 0.019 + self.value * 0.37), px, 0.6)
        if self.value < 0.0 {
            // the twist: a crease where the two snakes meet
            let tw2 = fract((p.x - (p.y - cy) * 1.3) / 8.0)
            let crease = (1.0 - smoothstep(0.0, 0.07, abs(tw2 - 0.46))) + (1.0 - smoothstep(0.0, 0.07, abs(tw2 - 0.96)))
            body = vec4(body.rgb * (1.0 - 0.28 * clamp(crease, 0.0, 1.0)), body.a)
        }
        out = Finish.over(out, body)
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A row of clay pellets, four points long with a point
// between: lit ones green, then tangerine from 70 % and red from 90 %; the
// rest charcoal. The hold is a yellow pellet; the over lamp a small bead.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 12.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let th = min(6.0, across - 1.5 - 4.0 * vert)
    let lamp_room = self.lamp * (th + 4.0)
    let bar = max(4.0, along - lamp_room)
    let pad = 0.5
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 5.0
    let ci = floor((a - pad) / pitch)
    let cnt = floor(span / pitch)
    let ca = pad + (ci + 0.5) * pitch - 0.5
    let share = clamp((ca - pad) / span, 0.0, 1.0)
    let in_row = step(0.0, ci) * step(ci, cnt - 1.0)
    let lit = step(ca, pad + span * self.level)
    let ramp = mix(mix(vec3(0.388, 0.749, 0.478), vec3(0.957, 0.588, 0.290), step(0.7, share)), vec3(0.906, 0.333, 0.341), step(0.9, share))
    var col = mix(mix(vec3(0.314, 0.290, 0.298), vec3(0.180, 0.165, 0.173), vert), ramp, lit)
    if self.hold > 0.002 {
        let hi_cell = floor((pad + span * self.hold - pad) / pitch)
        col = mix(col, vec3(0.992, 0.855, 0.420), step(abs(ci - hi_cell), 0.5) * (1.0 - lit))
    }
    let pc = mix(vec2(ca, across * 0.5), vec2(across * 0.5, self.rect_size.y - ca), vert)
    let ph = mix(vec2(1.9, th * 0.5), vec2(th * 0.5, 1.9), vert)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if vert > 0.5 {
        // standing, the pellets are set in a strip of charcoal clay
        let sc = vec2(across * 0.5, self.rect_size.y - (pad + span * 0.5))
        let sh = vec2(th * 0.5 + 2.0, span * 0.5 + 2.0)
        out = cl_drop(p, sc, sh, 3.0, 1.0, 0.8)
        out = Finish.over(out, cl_lump(p, sc, sh, 3.0, 2.5, 0.2, 0.03, vec3(0.255, 0.235, 0.243), 0.61, px, 0.5))
    }
    out = Finish.over(out, cl_drop(p, pc, ph, 1.6, 0.7 * in_row, 0.55))
    out = Finish.over(out, cl_lump(p, pc, ph, 1.6, 1.6, 0.1, 0.05, col, fract(ci * 0.137 + 0.21), px, 0.4) * in_row)
    if self.lamp > 0.5 {
        let la = bar + 2.0 + th * 0.5 + 1.0
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, cl_led(p, lc, 2.6, px, vec3(0.910, 0.200, 0.180), step(0.5, self.over), 0.35))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A shallow groove the length of the view and a yellow snake
// riding in it.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let sh = vec2(along * 0.5 - 1.0, across * 0.5 - 2.0)
    let sc = vec2(along * 0.5, across * 0.5)
    let sd = cl_rbox(q, sc, sh, sh.y)
    let ins = clamp(Finish.inset(p, mix(sc, sc.yx, vert), mix(sh, sh.yx, vert), sh.y, vec2(0.4, 0.8), 0.9), 0.0, 1.0)
    let ga = Finish.cover(sd, px) * (0.07 + 0.20 * ins)
    var out = cl_sh(ga)
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let rad = 3.4
    let ta = vec2(t0 + rad + 1.0, sc.y)
    let tb = vec2(max(t0 + tl - rad - 1.0, ta.x), sc.y)
    let sa = mix(ta, ta.yx, vert)
    let sb = mix(tb, tb.yx, vert)
    let col = cl_tone(vec3(0.992, 0.855, 0.420), self.hover, self.drag, 0.0)
    out = Finish.over(out, cl_snake_drop(p, sa, sb, rad, 0.8))
    out = Finish.over(out, cl_snake(p, sa, sb, rad, col, 0.41, px, 0.5))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A panel is a slab of violet clay with a thick rolled
// edge; the sunken panel is a slab of sky blue pressed into the ground, the
// ground's edge shading its upper side; the card a sunny yellow slab.
let cl_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, col: vec3, seed: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    var out = cl_drop(p, c, h, r, 1.1, 1.15)
    return Finish.over(out, cl_lump(p, c, h, r, min(min(h.x, h.y) * 0.4, 8.0), 0.7, 0.04, col, seed, px, 1.0))
}
let cl_sunk = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, col: vec3, seed: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cl_rbox(p, c, h, r)
    // the ground pushed up round the pocket: a soft light lip below, a
    // shade above
    let up = smoothstep(-h.y * 0.2, h.y * 0.9, p.y - c.y)
    let lip = Finish.ring_out(d, 0.0, 2.0, px) * (0.55 * up) * (1.0 - smoothstep(0.0, 2.0, d))
    var out = vec4(lip, lip, lip, lip)
    let sh = Finish.ring_out(d, 0.0, 1.5, px) * 0.20 * (1.0 - up)
    out = Finish.over(out, cl_sh(sh))
    return Finish.over(out, cl_pocket(p, c, h, r, col, seed, px))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let seed = fract(self.rect_size.x * 0.0193 + self.rect_size.y * 0.0711)
    if self.sunken > 0.5 {
        return cl_sunk(p, self.rect_size, self.rect_pos, px, 10.0, vec3(0.310, 0.816, 0.941), fract(seed + 0.37))
    }
    return cl_plate(p, self.rect_size, self.rect_pos, px, 11.0, vec3(0.667, 0.643, 1.0), seed)
}

// The card is a yellow slab; its palette and shadow numbers from Rust are
// not read. It lifts a little under the pointer.
mod.widgets.Card.radius = 10.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 6.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let col = cl_tone(vec3(0.957, 0.780, 0.384), self.hover, self.down, 0.0)
    return cl_plate(p, self.rect_size, self.rect_pos, px, 11.0, col, fract(self.rect_size.x * 0.0173 + 0.5))
}

// The plain rounded view keeps the colour its caller gives it, as a slab of
// that clay with a soft rolled edge.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = max(self.border_radius, 1.0)
    let d = cl_rbox(p, c, h, r)
    if fill.a > 0.98 && min(h.x, h.y) > 6.0 {
        var out = cl_lump(p, c, h - vec2(0.5, 1.0), r, min(min(h.x, h.y) * 0.35, 6.0), 0.4, 0.03, fill.rgb, fract(self.rect_size.x * 0.023 + self.rect_size.y * 0.051), px, 0.8)
        if self.border_size > 0.0 {
            let bc = self.border_color
            let ba = Finish.band(d, 0.0, max(self.border_size, px), px) * bc.a
            out = Finish.over(out, vec4(bc.rgb * ba, ba))
        }
        return out
    }
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points on the slab; a hovered row a pale dent; the
// chosen row a pill of lavender clay with a charcoal clay triangle at its
// left, as a cue in a player.
mod.widgets.ListItemOne.height = 23.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 24.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let h = vec2((hi.x - lo.x) * 0.5 - 5.0, (hi.y - lo.y) * 0.5 - 2.0)
    let c = vec2(lo.x + h.x + 1.5, (lo.y + hi.y) * 0.5)
    let r = h.y
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.selected > 0.5 {
        out = cl_drop(p, c, h, r, 0.9, 0.8)
        out = Finish.over(out, cl_lump(p, c, h, r, min(h.y * 0.6, 5.0), 0.3, 0.06, cl_tone(vec3(0.667, 0.639, 0.996), self.hover * live, self.down * live, 0.0), fract(self.rect_size.x * 0.031 + 0.17), px, 0.8))
        // the triangle
        let tc = vec2(lo.x + 13.0, c.y)
        let tg = normalize(vec2(max(p.x - tc.x, -1.0), (p.y - tc.y) * 1.6) + vec2(0.0001, 0.0))
        let tsh = Finish.cover(max(cl_tri((p - vec2(0.4, 0.7)).yx, tc.yx, 4.2, 2.8, 1.0), 0.0) - 0.9 - 0.8, px) * 0.28
        out = Finish.over(out, cl_sh(tsh))
        out = Finish.over(out, cl_skin(cl_tri(p.yx, tc.yx, 4.2, 2.8, 1.0), tg, 1.6, p - tc, vec2(0.0, 0.0), vec3(0.231, 0.208, 0.216), 0.63, px, 0.3, vec2(3.0, 3.0)))
    } else {
        let d = cl_rbox(p, c, h, r)
        let sh = clamp(Finish.inset(p, c, h, r, vec2(0.4, 0.9), 1.1), 0.0, 1.0) * 0.18 + 0.05
        let a = Finish.cover(d, px) * (self.hover * 0.8 + self.down) * live
        out = cl_sh(sh * a)
    }
    return out
}
mod.widgets.ListItem.draw_text.color = #2a211c

// The open list of a drop-down: a slab of yellow clay thrown a little
// higher than the parts round it; the row under the pointer is a lavender
// pill, the chosen row carries a charcoal check.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 7.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 7.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    var out = cl_drop(p, c, h, 8.0, 1.2, 1.8)
    return Finish.over(out, cl_lump(p, c, h, 8.0, 5.0, 0.5, 0.03, vec3(0.992, 0.855, 0.420), fract(size.y * 0.019 + 0.3), px, 0.8))
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let h = c - vec2(3.0, 1.5)
    let live = 1.0 - self.disabled
    var out = cl_drop(p, c, h, h.y, 0.7, 0.6) * self.hover * live
    out = Finish.over(out, cl_lump(p, c, h, h.y, min(h.y * 0.6, 5.0), 0.25, 0.05, vec3(0.765, 0.706, 0.882), fract(self.rect_size.x * 0.03 + 0.4), px, 0.6) * self.hover * live)
    if self.active > 0.5 {
        let ink = vec3(0.200, 0.180, 0.188)
        out = Finish.over(out, cl_hook(p, vec2(3.2, c.y + 0.4), vec2(5.4, c.y + 2.6), vec2(9.4, c.y - 2.8), 0.85, ink, 0.31, px))
    }
    return out
}

// The dock's tabs: the bar is the slab with a pressed groove at its foot;
// the tab in use a yellow clay slab rounded at the top and open at its foot,
// where it joins the panel below; the others lift a little under the
// pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.0, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 8.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let face = cl_lump(p, c, h, 7.0, 4.0, 0.3, 0.03, vec3(0.992, 0.855, 0.420), fract(self.rect_size.x * 0.03), px, 0.7)
    let lift = Finish.cover(cl_rbox(p, c, h, 7.0), px) * 0.14 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(lift, lift, lift, lift), face * self.active)
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = (1.0 - smoothstep(0.3, 0.9, abs(p.y - (yb - 1.5)))) * 0.28
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.5
    var out = cl_sh(dk)
    return Finish.over(out, vec4(lt, lt, lt, lt))
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small pill of bubblegum pink (a filled one
// takes its role's clay), squashed while chosen; a badge is a small pill of
// its palette's clay with semibold figures.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let ch = min(24.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    let light_ink = step(0.6, Finish.lum(self.ink.rgb))
    let has_fill = step(0.05, self.color.a) * light_ink
    let col = mix(vec3(0.910, 0.537, 0.639), self.color.rgb, has_fill)
    return cl_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(9.0, 9.0, 9.0, 9.0), 0.0, m, col)
}
mod.widgets.ChipFlat.draw_text.color = #1f1915
mod.widgets.BadgePalette.neutral = #8cb3e6
mod.widgets.BadgePalette.on_neutral = #1f1915
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 7.5}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 7.5}
mod.widgets.BadgeFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let bh = min(18.0, self.rect_size.y)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = min(h.y * 0.8, 7.0)
    var out = cl_drop(p, c, h, r, 0.9, 0.8)
    out = Finish.over(out, cl_lump(p, c, h, r, min(h.y * 0.6, 5.0), 0.2, 0.08, self.color.rgb, fract(self.rect_size.x * 0.07 + 0.13), px, 0.6))
    return out * self.color.a
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in charcoal with a visible track ring.
mod.widgets.SpinnerFlat.draw_bg.color = #3b3537
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 3.0
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.22

// Rules between groups: a groove pressed into the slab with a stick, its
// upper wall in shade and its lower one lit.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let dk = (1.0 - smoothstep(0.2, 0.8, abs(p.y - y + 0.3))) * 0.20
    let lt = (1.0 - smoothstep(0.2, 0.7, abs(p.y - y - 0.9))) * 0.45
    return Finish.over(cl_sh(dk), vec4(lt, lt, lt, lt))
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let dk = (1.0 - smoothstep(0.2, 0.8, abs(p.x - x + 0.3))) * 0.20
    let lt = (1.0 - smoothstep(0.2, 0.7, abs(p.x - x - 0.9))) * 0.45
    return Finish.over(cl_sh(dk), vec4(lt, lt, lt, lt))
}

// The rows of a tree stand on the slab, clear; the open row is a lavender
// pill of clay.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let base = mix(self.color_1, self.color_2, self.is_even)
    var res = vec4(base.rgb * base.a, base.a)
    let c = self.rect_size * 0.5
    let h = vec2(self.rect_size.x * 0.5 - 3.0, self.rect_size.y * 0.5 - 1.5)
    let r = h.y
    if self.active > 0.5 {
        res = Finish.over(res, cl_drop(p, c, h, r, 0.8, 0.6))
        res = Finish.over(res, cl_lump(p, c, h, r, min(h.y * 0.6, 5.0), 0.3, 0.05, vec3(0.435, 0.616, 0.973), fract(self.rect_size.x * 0.031 + 0.17), px, 0.7))
    }
    return res
}
mod.widgets.FileTreeNode.draw_text.color_active = #0b1a44
mod.widgets.FileTreeNode.draw_icon.color_active = #0b1a44

// ---------------------------------------------------------------------------
// PRESSED WORDS. A word on clay is pressed into it: the ink with a light
// line one device pixel under every glyph, where the lower wall of each
// letter's groove catches the light; it costs one more sample.
mod.widgets.ButtonFlat.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let c = self.get_color()
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.30 * c.a
        return main + vec4(s, s, s, s) * (1.0 - main.a)
    }
    return main
}
mod.widgets.DropDownFlat.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let c = self.get_color()
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.30 * c.a
        return main + vec4(s, s, s, s) * (1.0 - main.a)
    }
    return main
}

// ---------------------------------------------------------------------------
// STATES. Every held state is written as a plain value that cuts in at once:
// the library writes some as snap() values, which a state held as a default
// (the states page) never applies. Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.on.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.ToggleFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ToggleFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ToggleFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ToggleFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.on.from = {all: Snap}
