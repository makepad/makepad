// ---------------------------------------------------------------------------
// CHECK BOXES. A 16 point tile of clay ringed with a thin coil: yellow with a
// charcoal coil while clear; set, a green tile with a darker green coil and
// a charcoal snake bent into a check that runs out past its top corner, as
// a quick hand lays one. The quad grows five points for the check, the
// shadow and the focus thread.
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 25.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(16.0)
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let live = 1.0 - self.disabled
    let x0 = mix(1.0, size.x - sz - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - sz) * 0.5, px)) - o
    let h = vec2(sz * 0.5, sz * 0.5)
    let c = lo + h
    let r = mix(4.0, h.y, step(20.0, self.border_radius))
    let on = max(self.active, self.mixed)
    let press = self.down * live
    var tile = mix(vec3(0.992, 0.855, 0.420), vec3(0.408, 0.718, 0.553), on)
    tile = cl_tone(tile, self.hover * live, press, self.disabled)
    var coil = mix(vec3(0.290, 0.263, 0.271), vec3(0.247, 0.471, 0.353), on)
    coil = mix(coil, vec3(0.839, 0.255, 0.255), self.error)
    coil = mix(coil, vec3(0.690, 0.667, 0.675), self.disabled * 0.8)
    let seed = 0.13 + on * 0.29
    var out = cl_drop(p, c, h, r, mix(1.0, 0.3, press) * mix(1.0, 0.5, self.disabled), 0.9)
    out = Finish.over(out, cl_lump(p, c, h, r, 4.0, 0.25, 0.08, tile, seed, px, 0.7))
    // the coil round the tile's edge
    let t = 1.05
    let dc = abs(cl_rbox(p, c, h - vec2(t, t), max(r - t, 0.5))) - t
    let g = cl_grad(p, c, h - vec2(t, t), max(r - t, t)) * mix(-1.0, 1.0, step(0.0, cl_rbox(p, c, h - vec2(t, t), max(r - t, 0.5))))
    out = Finish.over(out, cl_skin(dc, g, t, p - c, vec2(0.0, 0.0), coil, seed + 0.5, px, 0.4, h))
    // the check, or the mixed dash
    let k = sz / 16.0
    let ink = mix(vec3(0.200, 0.180, 0.188), vec3(0.620, 0.600, 0.610), self.disabled)
    if self.mixed > 0.5 {
        out = Finish.over(out, cl_snake_drop(p, lo + vec2(4.5, 8.0) * k, lo + vec2(11.5, 8.0) * k, 1.35 * k, 0.8))
        out = Finish.over(out, cl_snake(p, lo + vec2(4.5, 8.0) * k, lo + vec2(11.5, 8.0) * k, 1.35 * k, ink, 0.71, px, 0.3))
    } else {
        if self.active > 0.5 {
            out = Finish.over(out, cl_hook(p, lo + vec2(3.6, 8.2) * k, lo + vec2(7.0, 12.0) * k, lo + vec2(16.5, -1.5) * k, 1.45 * k, ink, 0.71, px))
        }
    }
    return Finish.over(out, cl_focus(cl_rbox(p, c, h, r), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 38 by 20 point pill of clay, charcoal while off and green while
// on, with a yellow ball riding in it, which throws its own shadow on the
// pill. The switches below wear the same face.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 48.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 14.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleFlat.draw_bg.knob_inset = 7.0
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let g = cl_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let tw = 38.0
    let th = 20.0
    let x0 = mix(1.0, size.x - tw - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - th) * 0.5, px)) - o
    let h = vec2(tw * 0.5, th * 0.5)
    let c = lo + h
    let on = self.active
    var col = mix(vec3(0.329, 0.306, 0.314), vec3(0.408, 0.718, 0.553), on)
    col = mix(col, vec3(0.839, 0.255, 0.255), self.error * 0.8)
    col = cl_tone(col, self.hover * live, 0.0, self.disabled)
    let seed = 0.31 + on * 0.17
    var out = cl_drop(p, c, h, h.y, mix(1.0, 0.5, self.disabled), 1.0)
    out = Finish.over(out, cl_lump(p, c, h, h.y, 6.0, 0.3, 0.08, col, seed, px, 0.8))
    // the ball
    let kt = clamp(mix(on, self.drag_pos, self.drag), 0.0, 1.0)
    let kr = 7.4
    let kc = vec2(lo.x + 10.0 + kt * (tw - 20.0), c.y)
    let press = self.down * live
    out = Finish.over(out, cl_drop(p, kc, vec2(kr, kr), kr, (1.0 - 0.5 * press) * mix(1.0, 0.5, self.disabled), 0.8 + 0.3 * self.hover * live))
    let kcol = cl_tone(vec3(0.992, 0.855, 0.420), self.hover * live, press, self.disabled)
    out = Finish.over(out, cl_ball(p, kc, kr, 0.85, kcol, 0.57 + kt * 0.2, px, 0.6, 0.2))
    return Finish.over(out, cl_focus(cl_rbox(p, c, h, h.y), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// RADIOS. A ball of clay with a thin coil laid round its middle: yellow with
// a charcoal coil while not chosen; chosen, green with a pale green coil and
// a charcoal bead in the middle.
let cl_radio = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, focus: float, active: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let press = down * live
    var col = mix(vec3(0.992, 0.855, 0.420), vec3(0.408, 0.718, 0.553), active)
    col = cl_tone(col, hover * live, press, dis)
    let seed = 0.43 + active * 0.21
    var out = cl_drop(p, c, vec2(rad, rad), rad, mix(1.0, 0.3, press) * mix(1.0, 0.5, dis), 0.9)
    out = Finish.over(out, cl_ball(p, c, rad, 0.7, col, seed, px, 0.6, 0.25))
    var coil = mix(vec3(0.290, 0.263, 0.271), vec3(0.792, 0.910, 0.835), active)
    coil = mix(coil, vec3(0.690, 0.667, 0.675), dis * 0.8)
    out = Finish.over(out, cl_ring(p, c, rad * 0.56, max(rad * 0.13, 0.8), coil, seed + 0.3, px))
    if active > 0.5 {
        let bc = mix(vec3(0.200, 0.180, 0.188), vec3(0.620, 0.600, 0.610), dis)
        let br = rad * 0.27
        out = Finish.over(out, cl_drop(p, c, vec2(br, br), br, 0.7, 0.5))
        out = Finish.over(out, cl_ball(p, c, br, 1.0, bc, seed + 0.6, px, 0.3, 0.1))
    }
    return Finish.over(out, cl_focus(length(p - c) - rad, px, focus * live))
}

