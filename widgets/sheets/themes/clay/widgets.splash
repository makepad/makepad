// ---------------------------------------------------------------------------
// THE BOARD under everything: the window's own ground, a flat of modelling
// clay smeared on by thumb and rolled thick, lumpy and uneven at the
// window's edge. Its floor is a relief of overlapping dabs and smears in
// every direction: a dab a soft pressed hollow with a rounded rim, a smear
// a soft swell that ends in a crisp little lip where the thumb lifted off,
// some with the fine striations of the fingertip's drag. Each lies over or
// under its neighbours, and where one ends over another the step between
// them is a crisp ledge: lit along its top where it faces the light, a thin
// crease under it where it faces away. The colour is one flat clay; only
// the relief varies it. All of it is laid in the window's points, which do
// not scroll.

// The board's clay: a bright bubblegum pink.
let cl_ground_col = fn() -> vec3 {
    return vec3(1.0, 0.671, 0.882)
}

// One patch of the relief, laid from the cell `cell` of a scatter `sc`
// points apart: `kind` 0 a dab, 1 a smear. Its slope is worked out with its
// height, so the relief is laid once a pixel and lit from its exact slope.
// Its weight in the stack (its cover, raised by its place in the stack) is
// `w`; this returns w, w times its height in points, and the slope of that
// product. Its shape: a dab a soft swell, a little hollow in the middle,
// rising to a lip; a smear a longer swell rising along the drag to a crisp
// lip where the thumb lifted off, some with the fingertip's striations; and
// in many of them a fingerprint pressed in.
let cl_patch = fn(p: vec2, cell: vec2, sc: float, kind: float, px: float) -> vec4 {
    let s1 = Finish.hash(cell + vec2(kind * 17.3 + 1.7, 3.1))
    let s2 = Finish.hash(cell + vec2(5.9, kind * 11.1 + 8.3))
    let s3 = Finish.hash(cell + vec2(kind * 7.7 + 2.2, 9.4))
    let s4 = Finish.hash(cell + vec2(4.4, kind * 5.3 + 6.6))
    let ctr = (cell + vec2(0.15, 0.15) + vec2(s1, s2) * 0.7) * sc
    let ang = s3 * 6.2831853
    let dir = vec2(cos(ang), sin(ang))
    let pv = vec2(-dir.y, dir.x)
    let hl = mix(mix(9.0, 15.0, s4), mix(17.0, 23.0, s4), kind)
    let hw = mix(mix(7.0, 11.0, fract(s4 * 7.13)), mix(10.0, 14.0, fract(s4 * 7.13)), kind)
    let dq = p - ctr
    let un = dot(dq, dir) / hl
    let vn = dot(dq, pv) / hw
    // an outline a thumb leaves: never a true oval
    let wob = 1.0 + 0.08 * sin(un * 4.1 + s1 * 6.3) * cos(vn * 3.3 + s2 * 6.3) + 0.05 * sin(vn * 5.7 + s3 * 9.1)
    let ln = length(vec2(un, vn))
    let e = ln * wob
    if e > 1.25 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let gun = dir / hl
    let gvn = pv / hw
    let ge = (gun * un + gvn * vn) * (wob / max(ln, 0.0001))
    // its edge: crisp at the far end, where the thumb lifted off, soft at
    // the near end, where it ran in from the clay already there; never
    // sharper than a device pixel and a half
    let soft = mix(0.30, 1.7 * px / hw, smoothstep(-0.2, 0.6, un))
    let f1t = clamp((e - 1.05) / 0.2, 0.0, 1.0)
    let f1 = 1.0 - f1t * f1t * (3.0 - 2.0 * f1t)
    let f1d = -6.0 * f1t * (1.0 - f1t) / 0.2
    let xs = (e - 1.0) / soft
    let f2 = 1.0 / (1.0 + exp(min(xs, 30.0)))
    let f2d = -f2 * (1.0 - f2) / soft
    let pr = Finish.hash(cell + vec2(kind * 3.3 + 0.7, 0.3))
    let kw = exp(3.0 * (pr - 1.0)) * mix(1.0, step(0.6, fract(s3 * 3.71)), kind)
    let wt = f1 * f2 * kw
    let gw = ge * ((f1d * f2 + f1 * f2d) * kw)
    let dep = mix(0.9, 1.4, kind)
    let base = (fract(s4 * 13.7) - 0.5) * dep * 0.3
    // the swell and its lip
    let st = clamp((un + 0.1) / 0.7, 0.0, 1.0)
    let ss = st * st * (3.0 - 2.0 * st)
    let ssd = 6.0 * st * (1.0 - st) / 0.7
    // the lip: never narrower than a device pixel and a half, so it reads
    // as one clean ledge and not as a row of dots
    let lw = max(0.05, 1.5 * px / hw)
    let lg = exp(-(e - 0.92) * (e - 0.92) / (2.0 * lw * lw))
    let lip = lg * ss
    let lipe = lg * (-(e - 0.92) / (lw * lw)) * ss
    let lipu = lg * ssd
    let ex4 = exp(-e * e * 4.0)
    let hd = 0.25 * (1.0 - e * e) - 0.10 * ex4 + 0.15 * un + 0.45 * lip
    let hde = -0.5 * e + 0.8 * e * ex4 + 0.45 * lipe
    let hdu = 0.15 + 0.45 * lipu
    let hs = 0.30 * (1.0 - e * e) + 0.22 * un + 0.50 * lip
    let hse = -0.6 * e + 0.5 * lipe
    let hsu = 0.22 + 0.5 * lipu
    var h = mix(hd, hs, kind)
    var gh = ge * mix(hde, hse, kind) + gun * mix(hdu, hsu, kind)
    // the fingertip's striations in about half of the smears
    let sfl = step(0.5, fract(s2 * 5.17)) * kind
    let sk = 2.0 + 0.7 * s4
    let swv = un * 2.3 + s2 * 4.0
    let phi = vn * hw * sk + s1 * 6.3 + sin(swv) * 1.5
    let gphi = pv * sk + gun * (3.45 * cos(swv))
    let sfa = max(1.0 - e, 0.0)
    h = h + 0.035 * sin(phi) * sfa * sfl
    gh = gh + (gphi * (cos(phi) * sfa) - ge * (sin(phi) * step(e, 1.0))) * (0.035 * sfl)
    h = h * dep + base
    gh = gh * dep
    // a fingerprint pressed into many of the dabs and some of the smears:
    // fine ridges in a loop (a hairpin opening one way) or a whorl (rings
    // twisted into a spiral), bent a little as skin is, over part of the
    // patch, fading out at its edges and often cut off on one side where
    // the finger lifted; each ridge lit on the side that faces the light
    let fk = Finish.hash(cell + vec2(kind * 9.1 + 4.7, 2.9))
    if fk > mix(0.25, 0.55, kind) {
        let fr = clamp(min(hl, hw) * mix(0.8, 1.1, fract(fk * 5.3)), 5.5, 12.5)
        let fo = (vec2(fract(fk * 13.1), fract(fk * 7.7)) - vec2(0.5, 0.5)) * vec2(hl, hw) * 0.6
        let fa = fk * 37.7
        let fc = vec2(cos(fa), sin(fa))
        let lq = vec2(un * hl, vn * hw) - fo
        let fq = vec2(lq.x * fc.x + lq.y * fc.y, lq.y * fc.x - lq.x * fc.y)
        let ex = dir * fc.x + pv * fc.y
        let ey = pv * fc.x - dir * fc.y
        let loopk = step(0.35, fract(fk * 3.3))
        let yy = fq.y - max(fq.y, 0.0) * loopk
        let yd = 1.0 - loopk * step(0.0, fq.y)
        let fd = length(vec2(fq.x * 1.1, yy))
        let gfd = (ex * (1.21 * fq.x) + ey * (yy * yd)) / max(fd, 0.0001)
        let twist = atan2(fq.y, fq.x) / 6.2831853 * (1.0 - loopk)
        let gtw = (ey * fq.x - ex * fq.y) / max(dot(fq, fq), 1.0) / 6.2831853 * (1.0 - loopk)
        let aw = 0.23 * fq.x + 0.11 * fq.y + fk * 9.0
        let bw = 0.19 * fq.y - 0.07 * fq.x + fk * 4.0
        let warp = sin(aw) * 0.7 + sin(bw) * 0.6
        let gwp = (ex * 0.23 + ey * 0.11) * (0.7 * cos(aw)) + (ey * 0.19 - ex * 0.07) * (0.6 * cos(bw))
        let sp = 0.98 + 0.06 * fract(fk * 11.3)
        let fph = fd / sp + twist + warp
        let gph = gfd / sp + gtw + gwp
        let fpr = vec2(cos(fk * 21.0), sin(fk * 21.0))
        let part = smoothstep(-0.25, 0.25, dot(fq / fr, fpr) + mix(0.2, 1.3, fract(fk * 17.9)))
        // the ridges stop short of the patch's own edge, and give way where
        // they would come closer than the device pixels can hold
        let rpx = 1.0 / max(length(gfd / sp + gtw) * px, 0.0001)
        let env = (1.0 - smoothstep(fr * 0.45, fr, length(vec2(fq.x * 1.25, fq.y - fr * 0.3 * loopk)))) * part * (1.0 - smoothstep(0.72, 0.92, e)) * smoothstep(2.6, 3.0, rpx)
        h = h - 0.065 * (0.5 + 0.5 * cos(fph * 6.2831853)) * env
        gh = gh + gph * (0.065 * 3.1415927 * sin(fph * 6.2831853) * env)
    }
    return vec4(wt, wt * h, gw * h + gh * wt)
}

// The slope of a patch's weight alone, for the blend's own slope.
let cl_patch_dw = fn(p: vec2, cell: vec2, sc: float, kind: float, px: float) -> vec2 {
    let s1 = Finish.hash(cell + vec2(kind * 17.3 + 1.7, 3.1))
    let s2 = Finish.hash(cell + vec2(5.9, kind * 11.1 + 8.3))
    let s3 = Finish.hash(cell + vec2(kind * 7.7 + 2.2, 9.4))
    let s4 = Finish.hash(cell + vec2(4.4, kind * 5.3 + 6.6))
    let ctr = (cell + vec2(0.15, 0.15) + vec2(s1, s2) * 0.7) * sc
    let ang = s3 * 6.2831853
    let dir = vec2(cos(ang), sin(ang))
    let pv = vec2(-dir.y, dir.x)
    let hl = mix(mix(9.0, 15.0, s4), mix(17.0, 23.0, s4), kind)
    let hw = mix(mix(7.0, 11.0, fract(s4 * 7.13)), mix(10.0, 14.0, fract(s4 * 7.13)), kind)
    let dq = p - ctr
    let un = dot(dq, dir) / hl
    let vn = dot(dq, pv) / hw
    let wob = 1.0 + 0.08 * sin(un * 4.1 + s1 * 6.3) * cos(vn * 3.3 + s2 * 6.3) + 0.05 * sin(vn * 5.7 + s3 * 9.1)
    let ln = length(vec2(un, vn))
    let e = ln * wob
    if e > 1.25 {
        return vec2(0.0, 0.0)
    }
    let ge = (dir * (un / hl) + pv * (vn / hw)) * (wob / max(ln, 0.0001))
    let soft = mix(0.30, 1.7 * px / hw, smoothstep(-0.2, 0.6, un))
    let f1t = clamp((e - 1.05) / 0.2, 0.0, 1.0)
    let f1 = 1.0 - f1t * f1t * (3.0 - 2.0 * f1t)
    let f1d = -6.0 * f1t * (1.0 - f1t) / 0.2
    let xs = (e - 1.0) / soft
    let f2 = 1.0 / (1.0 + exp(min(xs, 30.0)))
    let f2d = -f2 * (1.0 - f2) / soft
    let pr = Finish.hash(cell + vec2(kind * 3.3 + 0.7, 0.3))
    let kw = exp(3.0 * (pr - 1.0)) * mix(1.0, step(0.6, fract(s3 * 3.71)), kind)
    return ge * ((f1d * f2 + f1 * f2d) * kw)
}

// The relief at `p`: the dabs on a scatter 18 points apart, the odd longer
// smear on one 48 apart, blended by their place in the stack. Returns its
// height (.x) and its slope (.yz).
let cl_relief = fn(p: vec2, px: float) -> vec3 {
    let sa = 18.0
    let ca = floor(p / sa)
    // the flat clay under every patch, a weight of its own so the gaps
    // between patches stay calm
    var acc = vec4(0.01, 0.0, 0.0, 0.0)
    var gw = vec2(0.0, 0.0)
    acc = acc + cl_patch(p, ca + vec2(-1.0, -1.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(0.0, -1.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(1.0, -1.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(-1.0, 0.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca, sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(1.0, 0.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(-1.0, 1.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(0.0, 1.0), sa, 0.0, px)
    acc = acc + cl_patch(p, ca + vec2(1.0, 1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(-1.0, -1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(0.0, -1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(1.0, -1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(-1.0, 0.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca, sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(1.0, 0.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(-1.0, 1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(0.0, 1.0), sa, 0.0, px)
    gw = gw + cl_patch_dw(p, ca + vec2(1.0, 1.0), sa, 0.0, px)
    let sb = 48.0
    let cb = floor(p / sb - vec2(0.5, 0.5))
    acc = acc + cl_patch(p, cb, sb, 1.0, px)
    acc = acc + cl_patch(p, cb + vec2(1.0, 0.0), sb, 1.0, px)
    acc = acc + cl_patch(p, cb + vec2(0.0, 1.0), sb, 1.0, px)
    acc = acc + cl_patch(p, cb + vec2(1.0, 1.0), sb, 1.0, px)
    gw = gw + cl_patch_dw(p, cb, sb, 1.0, px)
    gw = gw + cl_patch_dw(p, cb + vec2(1.0, 0.0), sb, 1.0, px)
    gw = gw + cl_patch_dw(p, cb + vec2(0.0, 1.0), sb, 1.0, px)
    gw = gw + cl_patch_dw(p, cb + vec2(1.0, 1.0), sb, 1.0, px)
    let hh = acc.y / acc.x
    return vec3(hh, (vec2(acc.z, acc.w) - gw * hh) / acc.x)
}

mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let c = size * 0.5
    let h = size * 0.5 - vec2(4.0, 4.0)
    let r = 16.0
    let gcol = cl_ground_col()
    // the table under the board
    var board = gcol * 0.62 * (1.0 + (Finish.noise(p * vec2(0.6, 0.05)) - 0.5) * 0.10)
    // the board's edge: thick, lumpy and uneven, as a slab pressed out by
    // hand
    let ew = (Finish.noise(p * 0.03 + vec2(1.3, 8.1)) - 0.5) * 3.2 + (Finish.noise(p * 0.09 + vec2(5.7, 2.2)) - 0.5) * 1.1
    let d = cl_rbox(p, c, h, r) + ew
    let cast = Finish.drop(p, c, h, r, vec2(0.8, 1.6), 2.2) * 0.45
    board = board * (1.0 - cast)
    // the rolled rim
    let w = 10.0
    let u = clamp((w + d) / w, 0.0, 1.0)
    let z = sqrt(max(1.0 - u * u, 0.02))
    let g = cl_grad(p, c, h, max(r, w))
    // the relief and its slope, laid two and a quarter times as large as its
    // patches are written (its heights grow with it, so its slopes are the
    // same; its prints' ridges are written finer, so they lie 2 points apart)
    let rl = cl_relief(p / 2.25, px / 2.25)
    let h0 = rl.x
    var tilt = vec2(-rl.y, -rl.z)
    // a steep step is a ledge, not a cliff: the slope is eased toward a
    // ceiling so no single pixel goes darker than the crease beside it
    let tl = length(tilt)
    tilt = tilt / (1.0 + tl / 1.1)
    // near the edge the clay was pushed up by thumbs: the rim's lumps
    let rim = smoothstep(-22.0, -5.0, d)
    let rb = cl_bump(p * 0.45, 0.73) * (1.6 * rim)
    // the board's form (its rolled rim) in the soft light; the relief over
    // it, gentle: its dabs, lips, striations and prints shade softly
    let nf = normalize(vec3(g.x * u + rb.x * z, g.y * u + rb.y * z, z))
    let n = normalize(vec3(g.x * u + (tilt.x * 0.5 + rb.x) * z, g.y * u + (tilt.y * 0.5 + rb.y) * z, z))
    let lk = vec3(-0.30, -0.57, 0.77)
    // a crease in the deepest corners where two dabs meet
    // (a bright clay with a channel near full cannot lighten in it, so the
    // relief is laid a quarter stronger to read the same)
    let dd = clamp((dot(n, lk) - dot(nf, lk)) * 0.65, -0.3, 0.3) - 0.075 * smoothstep(0.25, 0.9, -h0)
    var col = cl_detail(cl_light(nf, gcol), dd)
    // a soft satin sheen
    let sp = pow(max(dot(n, vec3(-0.159, -0.303, 0.940)), 0.0), 6.0) * 0.035
    col = col + mix(vec3(1.0, 1.0, 1.0), gcol, 0.5) * sp
    col = col + g3(Finish.grain(p / px, 0.005))
    let a = Finish.cover(d, px)
    return vec4(mix(board, col, a), 1.0)
}

// THE SPLITTER between the panes: a faint groove pressed down the slab with
// a stick; under the pointer a short lavender snake to take hold of.
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let v = self.is_vertical
    let across = mix(p.y, p.x, v)
    let along = mix(p.x, p.y, v)
    let thick = mix(self.rect_size.y, self.rect_size.x, v)
    let span = mix(self.rect_size.x, self.rect_size.y, v)
    let m = thick * 0.5
    let fade = smoothstep(0.0, 24.0, along) * (1.0 - smoothstep(span - 24.0, span, along))
    let gd = (1.0 - smoothstep(0.2, 0.7, abs(across - m + 0.3))) * 0.13 * fade
    let gl = (1.0 - smoothstep(0.2, 0.6, abs(across - m - 0.8))) * 0.32 * fade
    var res = Finish.over(cl_sh(gd), vec4(gl, gl, gl, gl))
    let act = max(max(self.hover, self.drag), self.focus)
    if act > 0.001 {
        let a = mix(vec2(span * 0.5 - 16.0, m), vec2(m, span * 0.5 - 16.0), v)
        let b = mix(vec2(span * 0.5 + 16.0, m), vec2(m, span * 0.5 + 16.0), v)
        res = Finish.over(res, cl_snake(p, a, b, 2.2, vec3(0.745, 0.671, 0.886), 0.19, px, 0.4) * act)
    }
    return res
}

// ---------------------------------------------------------------- switches

// THE SWITCHES are the sheet's own toggle: the rocker and the slide switch
// take the toggle's face, its size and shape, its quad and its label gap.
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 48.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 48.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.draw_bg.size = 14.0
mod.widgets.ToggleSlide.draw_bg.size = 14.0
mod.widgets.ToggleRocker.min_height = 24.0
mod.widgets.ToggleSlide.min_height = 24.0
mod.widgets.ToggleRocker.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleSlide.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleRocker.draw_bg.knob_inset = 7.0
mod.widgets.ToggleSlide.draw_bg.knob_inset = 7.0
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel
mod.widgets.ToggleSlide.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel

// ---------------------------------------------------------------- lamps
// LAMPS: an LED, a glossy bead of coloured glass pressed into the clay. The
// emitter is the light: at full current its middle burns toward white and
// its rim is its most saturated colour; at lower current the middle is no
// longer white, the colour deeper, the glow smaller; out, it is dark tinted
// glass, its colour barely there. Round it the socket the bead was pressed
// into: its upper wall in shadow and a catch light on its lower rim. Over
// the lens one crisp highlight of a dome. Its light is added, never
// painted: a tight hot halo and a short bloom in its own hue, gone in about
// two radii; on a pale ground its hue is also laid round it as a tint that
// keeps the ground's luminance. A bar is the same light drawn out into a
// short light pipe.
let cl_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let cl_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
let cl_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = cl_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c`, `lit` its
// current 0..1, `ink` its colour and `vivid` how far its chroma is raised,
// `ground` what shows through where nothing is drawn, `room` how far its
// light may reach. Premultiplied over `dst`.
let cl_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.32 * rt, 0.8, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = cl_led_lamp_full(ink)
    let hue = cl_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // the clay pushed up round the socket: a soft rolled lip
    let lipd = Material.sd_box(p, c, hb + vec2(bw + 1.3, bw + 1.3), rt + bw + 1.3)
    let lipa = Finish.cover(lipd, px) * (1.0 - Finish.cover(ds, px))
    let lu = clamp(-lipd / 1.3, 0.0, 1.0)
    let lfac = dot(nrm, vec2(-0.47, -0.88)) * (1.0 - lu)
    let lipc = ground * (1.0 + 0.16 * lfac)
    res = Finish.over(res, vec4(lipc * lipa, lipa))
    if L > 0.001 && pale > 0.001 {
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // the socket: its upper wall in shadow, a catch light on its lower rim
    let a_s = Finish.cover(ds, px)
    let under = ground
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.50, 0.90, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.25, 0.25, 0.25), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    res = Finish.over(res, vec4(min(sc, white) * a_s, a_s))
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = cl_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass, its colour barely there, a catch light along
    // its lower rim.
    let offc = mix(vec3(0.085, 0.08, 0.09), b * 0.4, 0.14)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp: the bead above, pressed into the cream
// slab. The halo's room is held in the lamp's own box. The bar is a short
// pipe at the left of its cell, so its light stays clear of the switches
// beside the column.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let tb = min(t, 6.0)
    let lb = tb * 1.9
    let c = mix(self.rect_size * 0.5, vec2(3.5 + lb * 0.5, self.rect_size.y * 0.5), self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(lb * 0.5, tb * 0.5), self.bar)
    let glow = mix(max(room - 0.5, 2.0), 2.2, self.bar)
    let res = cl_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, cl_ground_col(), glow)
    return res * self.opacity
}
true
