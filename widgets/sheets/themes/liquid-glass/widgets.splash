// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Twenty-six, the row the buttons stand in; a
// capsule corner, half of it.
let field_height = 26.0
let field_pad_v = 6.0
let field_radius = 13.0
let field_border = 0.67

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0

// The standing pills clip what they hold to themselves, so their label
// knows where in the glass it lies (its `draw_clip` is the pill). Their own
// quad grows 20 points for the shadow, which fades out before the quad's
// edge: wherever the clip is only the pill's own edge it reaches past it by
// that much; where a container clips into the pill, it keeps to that clip.
let lq_pill_room = fn(w) {
    w.clip_x = true
    w.clip_y = true
    w.draw_bg.vertex = fn() {
        let m = 20.0
        let lo = self.rect_pos - vec2(m, m)
        let sz = self.rect_size + vec2(2.0 * m, 2.0 * m)
        let hi = self.rect_pos + self.rect_size
        let own0 = vec2(step(abs(self.draw_clip.x - self.rect_pos.x), 0.01), step(abs(self.draw_clip.y - self.rect_pos.y), 0.01))
        let own1 = vec2(step(abs(self.draw_clip.z - hi.x), 0.01), step(abs(self.draw_clip.w - hi.y), 0.01))
        let c0 = self.draw_clip.xy - own0 * m
        let c1 = self.draw_clip.zw + own1 * m
        let p = self.geom.pos * sz + lo
        let pc = clamp(clamp(p, c0, c1) + self.draw_list.view_shift, self.draw_list.view_clip.xy, self.draw_list.view_clip.zw)
        self.pos = (pc - self.draw_list.view_shift - lo) / sz
        self.world = self.draw_list.view_transform * vec4(pc.x, pc.y, self.draw_depth + self.draw_call.zbias, 1.0)
        self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
    }
}
// THE LABEL INSIDE THE GLASS. The label reads as printed on the glass's
// back face, under its surface: the glass's upper sheen passes over the
// letters and lightens them where it crosses (0.22 of the way to white at
// the top of the pill, gone by six tenths of its height, a little more
// toward the left where the light is); the ink is softened toward the glass
// (0.06); a soft shadow of the letters lies on the body 0.7 points under
// them (0.16; on coloured glass 0.40, in a deeper shade of its colour); and a
// white label on coloured glass takes the colour at its edges (0.55). The
// glass's colour is the label's `material_glow_ink`, which this sheet's
// label colour does not otherwise read. Out of use the label is plain.
// The press's ring bends the letters as it passes under them: the same
// ring the glass draws (lq_pill: its centre, reach, front and life, from
// the same `down` and press clock), its swell (the push the glass's lens
// takes, widened to 0.40 of the reach) moving the letters out along its radius
// as it passes, 15.0 points at a 44 point button times the swell, so they bulge
// and sway with it and stand exactly as they were once it has gone. The
// swell is wide so the push can be large and still change by no more than
// about six tenths of a point a point, past which the letters fold over
// themselves; it eases to nothing within some fifteen points of the pill's
// middle, so the letters there do not tear.
// The glyph's quad grows 5.0 points every way so a letter pushed out of its
// cell is still drawn; its shadow keeps to the room it had (a point to the
// sides, two below). A glyph from the curve atlas keeps the platform's own
// quad and is drawn plain.
let lq_text_base = mod.draw.DrawText.vertex
let lq_label_inside = fn(w) {
    w.draw_text.lq_clock = instance(0.0)
    w.draw_text.ink_vertex = lq_text_base
    w.draw_text.vertex = fn() {
        self.ink_vertex()
        if self.texture_index < 2.5 {
            let lo = self.rect_pos - vec2(5.0, 5.0)
            let hi = self.rect_pos + self.rect_size + vec2(5.0, 5.0)
            let p = mix(lo, hi, self.geom.pos)
            let pc = clamp(clamp(p, self.draw_clip.xy, self.draw_clip.zw) + self.draw_list.view_shift, self.draw_list.view_clip.xy, self.draw_list.view_clip.zw)
            let pn = (pc - self.draw_list.view_shift - self.rect_pos) / max(self.rect_size, vec2(0.0001, 0.0001))
            self.pos = pn
            self.t = mix(self.t_min, self.t_max, pn)
            self.world = self.draw_list.view_transform * vec4(pc.x, pc.y, self.glyph_depth + self.draw_call.zbias, 1.0)
            self.vertex_pos = self.draw_pass.camera_projection * (self.draw_pass.camera_view * self.world)
        }
    }
    w.draw_text.pixel = fn() {
        // A glyph from the curve atlas (3) or one not yet in an atlas (-1)
        // is drawn plain, by the platform's own sampling.
        if self.texture_index > 2.5 || self.texture_index < -0.5 {
            return self.sample_text_pixel()
        }
        let rs = max(self.rect_size, vec2(0.0001, 0.0001))
        let q = self.pos * rs
        let c = self.get_color()
        let dpi = max(self.draw_pass.dpi_factor, 0.5)
        let en = 1.0 - self.disabled
        // Where in the pill this pixel lies.
        let b0 = self.draw_clip.xy
        let b1 = self.draw_clip.zw
        let pp = self.rect_pos + q
        // The press's ring, as the glass draws it (lq_pill).
        let held = step(0.999, self.down)
        let still = step(self.down + 0.001, self.lq_clock)
        let going = (1.0 - held) * (1.0 - still) * step(0.0005, self.down)
        let tpr = clamp(self.lq_clock * 1.6 / 1.17, 0.0, 1.0)
        let fp = tpr * tpr * (3.0 - 2.0 * tpr)
        let age = mix(mix(1000.0, (1.0 - self.down) * 1.6, going), self.lq_clock * 1.6, held)
        let strength = clamp(1.0 - age / 1.6, 0.0, 1.0) * mix(0.9, 1.0 - 0.1 * fp, held) * en
        let pc = (b0 + b1) * 0.5
        let ph = max((b1 - b0) * 0.5, vec2(1.0, 1.0))
        let kk = min(ph.x, ph.y) / 22.0
        let lp = (pp - pc) / (ph + vec2(19.4 * kk, 19.4 * kk))
        let dist = length(lp)
        let wt = clamp(age / 1.32, 0.0, 1.0)
        let centre = 1.25 * wt * wt * (3.0 - 2.0 * wt)
        let delta = dist - centre
        let life = clamp(1.0 - age / 1.6, 0.0, 1.0)
        let wave = exp(-(delta * delta) / (0.40 * 0.40)) * life * life * strength * smoothstep(0.0, 0.10, age) * (1.0 - smoothstep(1.16, 1.44, dist))
        let rq = pp - pc
        let rdir = rq / sqrt(dot(rq, rq) + 256.0)
        let bend = rdir * (wave * 15.0 * kk)
        // The letters, read from where the ring pushes them.
        let qs = q - bend
        let inq = step(0.0, qs.x) * step(qs.x, rs.x) * step(0.0, qs.y) * step(qs.y, rs.y)
        let dtx = dFdx(self.t)
        let dty = dFdy(self.t)
        let dxt = length(dtx)
        let dyt = length(dty)
        let tofs = (dtx * bend.x + dty * bend.y) * dpi
        let off = 0.7 * dpi
        var main = vec4(0.0, 0.0, 0.0, 0.0)
        var w = 0.0
        var has = 0.0
        if self.texture_index < 0.5 {
            let tex_size = self.grayscale_texture.size()
            let scale = (dxt + dyt) * tex_size.x * 0.5
            let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
            let pm = clamp(self.t.xy - tofs, self.t_min + half_texel, self.t_max - half_texel)
            main = self.sdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
            let ps = clamp(self.t.xy - tofs - dty * off, self.t_min + half_texel, self.t_max - half_texel)
            w = self.sdf(scale * 5.0, ps, vec4(0.5, 0.5, 0.5, 1.0))
            has = 1.0
        } else if self.texture_index < 1.5 {
            let tex_size = self.color_texture.size()
            let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
            let pm = clamp(self.t.xy - tofs, self.t_min + half_texel, self.t_max - half_texel)
            let cs = self.color_texture.sample(pm)
            main = vec4(cs.rgb * cs.a, cs.a)
        } else {
            let tex_size = self.msdf_texture.size()
            let scale = (dxt + dyt) * tex_size.x * 0.5
            let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
            let pm = clamp(self.t.xy - tofs, self.t_min + half_texel, self.t_max - half_texel)
            main = self.msdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
            if self.texture_index < 2.5 {
                let ps = clamp(self.t.xy - tofs - dty * off, self.t_min + half_texel, self.t_max - half_texel)
                w = self.msdf(scale * 5.0, ps, vec4(0.5, 0.5, 0.5, 1.0))
                has = 1.0
            }
        }
        main = main * inq
        // The shadow keeps to the room it had: a point to the sides, half a
        // point above and two below the letter's cell.
        let room = step(-1.0, qs.x) * step(qs.x, rs.x + 1.0) * step(-0.5, qs.y) * step(qs.y, rs.y + 2.0)
        w = w * room
        let v = clamp((pp.y - b0.y) / max(b1.y - b0.y, 1.0), 0.0, 1.0)
        let u = clamp((pp.x - b0.x) / max(b1.x - b0.x, 1.0), 0.0, 1.0)
        let light = step(0.5, dot(c.rgb, vec3(0.299, 0.587, 0.114)))
        let glass = self.material_glow_ink.rgb
        // The ink: softened toward the glass, its edge in the glass's colour
        // on coloured glass, lightened where the upper sheen crosses it.
        let a = clamp(main.a / max(c.a, 0.0001), 0.0, 1.0)
        var ink = mix(c.rgb, vec3(0.80, 0.81, 0.84), 0.06 * (1.0 - light) * en)
        ink = mix(ink, mix(ink, glass, 0.55), (1.0 - smoothstep(0.3, 0.95, a)) * light * en)
        let sheen = 0.22 * (1.0 - smoothstep(0.28, 0.6, v)) * (1.0 - 0.35 * u) * (1.0 - light) * en
        ink = mix(ink, vec3(0.97, 0.975, 0.985), sheen)
        let body = vec4(ink * main.a, main.a)
        // The shadow on the back face.
        let shc = mix(vec3(0.10, 0.11, 0.14), glass * 0.40, light)
        let sh = w * mix(0.16, 0.40, light) * has * c.a * en
        return body + vec4(shc * sh, sh) * (1.0 - body.a)
    }
}
// The label is bold, in the sheet's near-black ink (white on coloured
// glass), 0.7 of its alpha while held, back at once when let go; out of
// use, the disabled ink.
let lq_pill_label = fn(w, size) {
    w.draw_text.text_style = mod.theme.font_bold{font_size: size}
    w.draw_text.get_color = fn() {
        let held = step(0.999, self.down)
        let k = mix(mix(1.0, 1.0, self.hover), 0.7, held)
        let ink = self.color.mix(self.color_disabled, self.disabled)
        return vec4(ink.rgb, ink.a * mix(k, 1.0, self.disabled) * (1.0 - self.loading))
    }
}
// The press as the pill reads it (THE GLASS PILL), and its label (THE LABEL
// INSIDE THE GLASS, on its own `lq_clock`): held, `down` is 1 at
// once and the clock (cap_time) runs to 1 over 1.6 seconds; let go, over
// the button or off it, both fall to 0 over 1.6 seconds, so the release's
// ring has its clock; the hover alone moves neither, and cuts in over a
// tenth of a second. Every value a held state needs is written plain, so a
// state held from the start (the states page) shows.
let lq_pill_states = fn(w) {
    w.animator.hover.off.from = {all: Forward {duration: 0.1} down: Forward {duration: 1.6}}
    w.animator.hover.off.apply = {draw_bg: {down: 0.0 hover: 0.0 cap_time: 0.0} draw_text: {down: 0.0 hover: 0.0 lq_clock: 0.0}}
    w.animator.hover.on.from = {all: Forward {duration: 0.1} down: Forward {duration: 1.6}}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0 cap_time: 0.0} draw_text: {down: 0.0 hover: 1.0 lq_clock: 0.0}}
    w.animator.hover.down.from = {all: Forward {duration: 1.6}}
    w.animator.hover.down.apply = {draw_bg: {down: timeline(0.0, 1.0, 1.0, 1.0) hover: 1.0 cap_time: 1.0} draw_text: {down: timeline(0.0, 1.0, 1.0, 1.0) hover: 1.0 lq_clock: 1.0}}
}
// A click takes no key focus, so a mouse press shows no focus ring; the
// keyboard's focus still does.
let lq_pill_dress = fn(w, size) {
    lq_pill_room(w)
    w.grab_key_focus = false
    lq_pill_label(w, size)
    lq_label_inside(w)
    lq_pill_states(w)
}
lq_pill_dress(mod.widgets.Button, 9.0)
lq_pill_dress(mod.widgets.ButtonCompound, 9.0)
lq_pill_dress(mod.widgets.ButtonPrimary, 9.0)
lq_pill_dress(mod.widgets.ButtonXs, 8.5)
lq_pill_dress(mod.widgets.ButtonSm, 8.5)
lq_pill_dress(mod.widgets.ButtonLg, 11.0)
lq_pill_dress(mod.widgets.ButtonXl, 13.0)


// ---------------------------------------------------------------- switches and meter

// THE METER sits in the same window as the readouts and the screen: the
// library's display housing drawn round its face -- the bezel ring, a shade
// of whatever ground it is set in with a device pixel of dark at its edge;
// the face with the surround's shadow falling across it from the top and a
// device pixel of black where the glass meets the bezel; the glass's quiet
// diagonal band and the light line inside its top edge; the lip of light on
// the ground under it -- with the same corner, so the meter and the
// readouts read as one family. The scale, the red zone, the needle and its
// pivot are the library's own.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(theme.corner_radius * 0.5)
mod.widgets.NeedleMeter.draw_bg.color_bezel = uniform(theme.color_d_05)
mod.widgets.NeedleMeter.draw_bg.color_lip = uniform(theme.color_u_15)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.border_radius, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, r_out)
    let b = Finish.snap(2.0, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(r_out - b, 0.0)
    let face_d = Material.sd_box(p, c, hf, rf)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    // No face: the pane's glass shows through, and on it, the surround's
    // shadow falling across from the top, the scale, the red zone, the
    // needle and its pivot.
    let insh = Finish.inset(p, c, hf, rf, vec2(0.0, 2.0), 1.8) * 0.3
    var acc = vec4(0.0, 0.0, 0.0, insh)
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    let sc = max(arc, tick)
    acc = Finish.over(acc, vec4(self.color_scale.rgb * sc, sc))
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        let za = zone_t * zone_r
        acc = Finish.over(acc, vec4(self.color_zone.rgb * za, za))
    }
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - px * 0.5, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - max(self.pivot_size - px, 0.0), px)
    acc = Finish.over(acc, vec4(self.color_needle.rgb * needle, needle))
    let pd = r - self.pivot_size
    let pc = Finish.cover(pd, px)
    acc = Finish.over(acc, vec4(mix(self.color_needle.rgb, vec3(0.85, 0.86, 0.88), 0.35) * pc, pc))
    let prim = Finish.band(pd, 0.0, px, px) * 0.45
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, prim))
    // The black device pixel where the glass meets the bezel, and the
    // glass's quiet band and the light line inside its top edge.
    let edge = Finish.band(face_d, 0.0, px, px) * 0.6
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, edge))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let top = Finish.cover(abs(p.y - (c.y - hf.y) - px * 1.5) - px * 0.5, px) * 0.6
    let ga = clamp(0.03 * (band + top), 0.0, 1.0) * Finish.cover(face_d + px, px)
    acc = Finish.over(acc, vec4(ga, ga, ga, ga))
    acc = acc * Finish.cover(face_d, px)
    // The bezel ring, a shade of what it is set in, a device pixel of dark
    // at its outer edge, and the lip of light under it.
    let bz = self.color_bezel
    var ring = vec4(bz.rgb * bz.a, bz.a)
    ring = Finish.over(ring, vec4(0.0, 0.0, 0.0, 0.45 * Finish.band(outer, 0.0, px, px)))
    ring = ring * Finish.cover(outer, px) * (1.0 - Finish.cover(face_d, px))
    var col = Finish.over(ring, acc)
    let lip = Finish.ring_out(outer, 0.0, px, px) * step(hi.y, p.y)
    let la = self.color_lip.a * lip
    return Finish.over(vec4(self.color_lip.rgb * la, la), col) * self.color.a * self.opacity
}

// ---------------------------------------------------------------- water on the screens
// WATER UNDER THE POINTER, on his word ('can we give the liquid effect vu
// and readouts screen a mouse move water ripple effect'), and stronger on
// his second ('the distortion effect on the screens/vu can be much
// stronger'): the glass of the readouts, the screen and the meter is a
// water surface. Moving the pointer across it drops ripples (the widgets'
// trail, eight drops at the most, one per 6 points moved, each alive
// 1.6 s); each drop sends a ring out at 60 points a second, 20 points from
// crest to crest, landing over its first 0.16 s and weaker as it ages and
// as it grows. Where the rings pass, the glass bends what lies under it,
// the digits, the needle and the scale, read from the window displaced by
// up to about 4 points each way at a fresh crest, 8 from flank to flank.
// The bend never folds the picture over itself, so a digit can swell, lean
// and squeeze but never breaks into pieces: the rings are trochoids, a
// broad smooth crest that magnifies (about four times at a fresh crest)
// and a narrower trough that squeezes (about three times at most), each
// ring's own magnification is bounded, and where rings can meet, the
// newest takes its share of one magnification budget first and the older
// rings share what it leaves (shares that are the same over the whole
// glass, so they add no bend of their own). The flank of a crest facing the light lifts toward
// white and the other takes the cool shade of the sheet's glass, on every
// ring at full strength. The ripple dies out over the last 12 points
// before the bezel, the bezel stays still, and what the glass reads never
// comes from past the face. Nothing moves while the pointer is still or
// away: the screens are then drawn exactly as before.

// A drop's strength: its full height a little after it lands, fading
// with what is left of its life and as its ring grows. `d` is the drop
// (place, age; age -1 for none).
let lq_ripple_amp = fn(d: vec3, life: float) -> float {
    if d.z < 0.0 {
        return 0.0
    }
    let left = clamp(1.0 - d.z / max(life, 0.01), 0.0, 1.0)
    return 1.575 * left * sqrt(left) * smoothstep(0.0, 0.16, d.z) / (1.0 + d.z * 0.6667)
}

// One drop's ring at `p`, as a displacement of what the glass reads, for a
// drop of strength `a`: a packet two crests deep around the front, the
// phase run through the trochoid (Kepler's equation, solved in three
// Newton steps) so the crests are broad and the troughs a little narrower
// (never squeezing what lies under them more than about three times), and
// nothing at the drop's own centre.
let lq_ripple_ring = fn(p: vec2, d: vec3, a: float) -> vec2 {
    if a <= 0.0 {
        return vec2(0.0, 0.0)
    }
    let q = p - d.xy
    let r = max(length(q), 0.001)
    let u = r - d.z * 60.0
    let phi = u * 0.3141593
    var t = phi + 0.35 * sin(phi)
    t = t - (t - 0.35 * sin(t) - phi) / (1.0 - 0.35 * cos(t))
    t = t - (t - 0.35 * sin(t) - phi) / (1.0 - 0.35 * cos(t))
    t = t - (t - 0.35 * sin(t) - phi) / (1.0 - 0.35 * cos(t))
    let env = exp(0.0 - u * u / 196.0) * (1.0 - exp(0.0 - r * r / 36.0))
    let disp = a * env * sin(t) * 3.183099
    return q * (disp / r)
}

// 1 where the fields of two drops' rings can meet (their packets reach
// 31 points either side of the fronts), falling to 0 over 6 points apart.
let lq_ripple_meet = fn(da: vec3, db: vec3) -> float {
    let dist = length(da.xy - db.xy)
    let fa = max(da.z, 0.0) * 60.0
    let fb = max(db.z, 0.0) * 60.0
    let lo_a = max(fa - 30.8, 0.0)
    let lo_b = max(fb - 30.8, 0.0)
    let gap = max(dist - (fa + fb + 61.6), max(lo_a - fb - 30.8, lo_b - fa - 30.8) - dist)
    return 1.0 - smoothstep(0.0, 6.0, gap)
}

// A drop's share of the magnification budget (0.88: the picture is never
// magnified more than about eight times), newest first: what the newer
// drops it can meet have left, over its own need `n` (0.612 per unit of
// strength, the most a ring magnifies).
let lq_ripple_share = fn(used: float, n: float) -> float {
    return clamp((0.88 - used) / max(n, 0.00001), 0.0, 1.0)
}

// The water at `p`: `xy` the displacement of what the glass reads (shared,
// and still at the bezel), `zw` the slope the light catches (every ring at
// full strength), the face's edge `face_d` away (negative inside).
let lq_ripple_sum = fn(p: vec2, face_d: float, life: float, d0: vec3, d1: vec3, d2: vec3, d3: vec3, d4: vec3, d5: vec3, d6: vec3, d7: vec3) -> vec4 {
    let a0 = lq_ripple_amp(d0, life)
    let a1 = lq_ripple_amp(d1, life)
    let a2 = lq_ripple_amp(d2, life)
    let a3 = lq_ripple_amp(d3, life)
    let a4 = lq_ripple_amp(d4, life)
    let a5 = lq_ripple_amp(d5, life)
    let a6 = lq_ripple_amp(d6, life)
    let a7 = lq_ripple_amp(d7, life)
    let n0 = a0 * 0.612
    let n1 = a1 * 0.612
    let n2 = a2 * 0.612
    let n3 = a3 * 0.612
    let n4 = a4 * 0.612
    let n5 = a5 * 0.612
    let n6 = a6 * 0.612
    let n7 = a7 * 0.612
    let s0 = lq_ripple_share(0.0, n0)
    let t0 = s0 * n0
    let s1 = lq_ripple_share(lq_ripple_meet(d1, d0) * t0, n1)
    let t1 = s1 * n1
    let s2 = lq_ripple_share(lq_ripple_meet(d2, d0) * t0 + lq_ripple_meet(d2, d1) * t1, n2)
    let t2 = s2 * n2
    let s3 = lq_ripple_share(lq_ripple_meet(d3, d0) * t0 + lq_ripple_meet(d3, d1) * t1 + lq_ripple_meet(d3, d2) * t2, n3)
    let t3 = s3 * n3
    let s4 = lq_ripple_share(lq_ripple_meet(d4, d0) * t0 + lq_ripple_meet(d4, d1) * t1 + lq_ripple_meet(d4, d2) * t2 + lq_ripple_meet(d4, d3) * t3, n4)
    let t4 = s4 * n4
    let s5 = lq_ripple_share(lq_ripple_meet(d5, d0) * t0 + lq_ripple_meet(d5, d1) * t1 + lq_ripple_meet(d5, d2) * t2 + lq_ripple_meet(d5, d3) * t3 + lq_ripple_meet(d5, d4) * t4, n5)
    let t5 = s5 * n5
    let s6 = lq_ripple_share(lq_ripple_meet(d6, d0) * t0 + lq_ripple_meet(d6, d1) * t1 + lq_ripple_meet(d6, d2) * t2 + lq_ripple_meet(d6, d3) * t3 + lq_ripple_meet(d6, d4) * t4 + lq_ripple_meet(d6, d5) * t5, n6)
    let t6 = s6 * n6
    let s7 = lq_ripple_share(lq_ripple_meet(d7, d0) * t0 + lq_ripple_meet(d7, d1) * t1 + lq_ripple_meet(d7, d2) * t2 + lq_ripple_meet(d7, d3) * t3 + lq_ripple_meet(d7, d4) * t4 + lq_ripple_meet(d7, d5) * t5 + lq_ripple_meet(d7, d6) * t6, n7)
    let w0 = lq_ripple_ring(p, d0, a0)
    let w1 = lq_ripple_ring(p, d1, a1)
    let w2 = lq_ripple_ring(p, d2, a2)
    let w3 = lq_ripple_ring(p, d3, a3)
    let w4 = lq_ripple_ring(p, d4, a4)
    let w5 = lq_ripple_ring(p, d5, a5)
    let w6 = lq_ripple_ring(p, d6, a6)
    let w7 = lq_ripple_ring(p, d7, a7)
    let disp = w0 * s0 + w1 * s1 + w2 * s2 + w3 * s3 + w4 * s4 + w5 * s5 + w6 * s6 + w7 * s7
    let slope = w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7
    let keep = smoothstep(0.0, 12.0, 0.0 - face_d)
    return vec4(disp * keep, slope * keep)
}

// The glass over the water. `under` is what lies under it read along the
// displacement (when `seen` is 1; then the glass is opaque over the face,
// which it redraws), `glass` the sheet's own glass over it (premultiplied),
// `slope` the water's slope in points of displacement (about 4 at a fresh
// crest). The light comes from the upper left: the flank facing it lifts
// toward white, the other takes the cool glass shade.
let lq_ripple_lay = fn(under: vec3, seen: float, glass: vec4, slope: vec2, cov: float) -> vec4 {
    let lit = dot(slope, vec2(-0.55, -0.83)) * 0.25
    let light_a = clamp(lit * 0.95, 0.0, 0.7)
    let shade_a = clamp((0.0 - lit) * 0.55, 0.0, 0.45)
    let shade = vec3(0.286, 0.322, 0.408)
    if seen > 0.5 {
        var col = under * (1.0 - glass.a) + glass.rgb
        col = mix(col, vec3(1.0, 1.0, 1.0), light_a)
        col = mix(col, col * shade * 1.6, shade_a)
        return vec4(col * cov, cov)
    }
    var out = glass
    out = Finish.over(out, vec4(light_a, light_a, light_a, light_a))
    out = Finish.over(out, vec4(shade * shade_a * 0.6, shade_a))
    return out * cov
}

// The screen's glass: the library's quiet band and top line over the
// water. While the pointer's trail is alive the widget lifts it over the
// face and binds the window's scene of the frame (`glass_backdrop`).
mod.widgets.ScreenView.field_reach = 2.0
mod.widgets.ScreenView.trail_life = 1.6
mod.widgets.ScreenView.glass_backdrop = true
mod.widgets.ScreenView.draw_glass.trail_0 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_1 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_2 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_3 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_4 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_5 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_6 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_7 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.ScreenView.draw_glass.trail_life = uniform(1.6)
mod.widgets.ScreenView.draw_glass.scene_texture = texture_2d(float)
mod.widgets.ScreenView.draw_glass.has_gauss = uniform(0.0)
mod.widgets.ScreenView.draw_glass.source_size = uniform(vec2(1.0, 1.0))
mod.widgets.ScreenView.draw_glass.source_y_flip = uniform(0.0)
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.face_radius, min(ho.x, ho.y))
    let b = Finish.snap(max(self.bezel, 0.0), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let face_d = Material.sd_box(p, c, hf, max(r_out - b, 0.0))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let top = Finish.cover(abs(p.y - (c.y - hf.y) - px * 1.5) - px * 0.5, px) * 0.6
    let a = clamp(self.sheen * (band + top), 0.0, 1.0)
    let cov = Finish.cover(face_d + px, px)
    let w = lq_ripple_sum(p, face_d, self.trail_life, self.trail_0, self.trail_1, self.trail_2, self.trail_3, self.trail_4, self.trail_5, self.trail_6, self.trail_7)
    var under = vec3(0.0, 0.0, 0.0)
    if self.has_gauss > 0.5 {
        let ps = clamp(p + w.xy, c - hf, c + hf)
        let sq = (self.rect_pos + ps) / max(self.source_size, vec2(1.0, 1.0))
        under = self.scene_texture.sample(vec2(sq.x, mix(sq.y, 1.0 - sq.y, self.source_y_flip))).rgb
    }
    return lq_ripple_lay(under, self.has_gauss, vec4(a, a, a, a), w.zw, cov)
}

// The screen's face, on his word ('remove bg from the cards, meters,
// screens, readouts etc'): the library's bezel and inner shadow and the
// black device pixel where the glass meets the bezel, with no fill, so the
// pane's glass and its pools show through and the digits lie on it.
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.border_radius, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, r_out)
    let b = Finish.snap(max(self.bezel, 0.0), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let face_d = Material.sd_box(p, c, hf, max(r_out - b, 0.0))
    var acc = vec4(0.0, 0.0, 0.0, 0.0)
    if self.recess > 0.0 {
        let insh = Finish.inset(p, c, hf, max(r_out - b, 0.0), vec2(0.0, self.recess * 0.5), max(self.recess * 0.45, 0.3))
        acc = vec4(0.0, 0.0, 0.0, 0.3 * insh)
    }
    if self.scan > 0.0 {
        let sl = 1.0 - Finish.scan(p.y - (c.y - hf.y), px, 3.0 * px, self.scan)
        acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, sl))
    }
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, 0.6 * Finish.band(face_d, 0.0, px, px)))
    acc = acc * Finish.cover(face_d, px)
    let bz = self.color_bezel
    var ring = vec4(bz.rgb * bz.a, bz.a)
    ring = Finish.over(ring, vec4(0.0, 0.0, 0.0, 0.45 * Finish.band(outer, 0.0, px, px)))
    ring = ring * Finish.cover(outer, px) * (1.0 - Finish.cover(face_d, px))
    let col = Finish.over(ring, acc)
    let lip = Finish.ring_out(outer, 0.0, px, px) * step(hi.y, p.y)
    let la = self.color_lip.a * lip
    return Finish.over(vec4(self.color_lip.rgb * la, la), col)
}

// The meter's glass, over its face inside the housing's 2 point bezel; its
// own quiet glass is part of the face it reads.
mod.widgets.NeedleMeter.field_reach = 2.0
mod.widgets.NeedleMeter.trail_life = 1.6
mod.widgets.NeedleMeter.glass_backdrop = true
mod.widgets.NeedleMeter.draw_glass.trail_0 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_1 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_2 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_3 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_4 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_5 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_6 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_7 = instance(vec3(0.0, 0.0, -1.0))
mod.widgets.NeedleMeter.draw_glass.trail_life = uniform(1.6)
mod.widgets.NeedleMeter.draw_glass.scene_texture = texture_2d(float)
mod.widgets.NeedleMeter.draw_glass.has_gauss = uniform(0.0)
mod.widgets.NeedleMeter.draw_glass.source_size = uniform(vec2(1.0, 1.0))
mod.widgets.NeedleMeter.draw_glass.source_y_flip = uniform(0.0)
mod.widgets.NeedleMeter.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.face_radius, min(ho.x, ho.y))
    let b = Finish.snap(2.0, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let face_d = Material.sd_box(p, c, hf, max(r_out - b, 0.0))
    let cov = Finish.cover(face_d + px, px)
    let w = lq_ripple_sum(p, face_d, self.trail_life, self.trail_0, self.trail_1, self.trail_2, self.trail_3, self.trail_4, self.trail_5, self.trail_6, self.trail_7)
    var under = vec3(0.0, 0.0, 0.0)
    if self.has_gauss > 0.5 {
        let ps = clamp(p + w.xy, c - hf, c + hf)
        let sq = (self.rect_pos + ps) / max(self.source_size, vec2(1.0, 1.0))
        under = self.scene_texture.sample(vec2(sq.x, mix(sq.y, 1.0 - sq.y, self.source_y_flip))).rgb
    }
    return lq_ripple_lay(under, self.has_gauss, vec4(0.0, 0.0, 0.0, 0.0), w.zw, cov)
}

// ---------------------------------------------------------------- lamps
// LAMPS: an LED, as the hardware in his pictures has them. The emitter is
// the light: at full current its middle burns toward white and its rim is
// its most saturated colour; at lower current the middle is no longer
// white, the colour deeper, the glow smaller; out, it is dark tinted glass,
// its colour barely there. Round it a bezel: a raised ring lit from the
// upper left, or a socket cut into the surface, its upper wall in shadow
// and a catch light on its lower rim. Over the lens one crisp highlight of
// a dome. Its light is added, never painted: a tight hot halo and a short
// bloom in its own hue, screened over whatever is there and gone in about
// two radii; on a pale ground, where light can barely brighten, its hue is
// also laid round it as a tint that keeps the ground's luminance (the
// library's halo rule: at most 0.45 one device pixel out, halving every
// 0.4 of its reach, gone at the reach), so it never darkens or greys its
// ground. A bar is the same light drawn out into a light pipe.
let lq_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let lq_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let lq_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = lq_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c` (round when the
// two are equal), `lit` its current 0..1, `ink` its colour and `vivid` how
// far its chroma is raised, `ground` what shows through where nothing is
// drawn, `room` how far its light may reach, `bez` and `raised` its bezel
// (raised 0: a recess cut in what is under it; 1: a raised ring of `bez`;
// 2: the same ring polished metal). Premultiplied over `dst`.
let lq_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, bez: vec3, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.3 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = lq_led_lamp_full(ink)
    let hue = lq_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    // The lens's own frame: `q` in lens radii from its centre line, `t` its
    // distance out, `nrm` the way its outline faces.
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the bead and its bezel throw on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.22 * rt + 0.3), 0.32 * rt + px) * mix(0.18, 0.34, min(raised, 1.0)) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(ground * 0.4 * shd, shd))
    if L > 0.001 && pale > 0.001 {
        // The tint, on a pale ground only: its hue laid over, never darker.
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The bezel: raised, a ring of `bez` rounded over, lit from the upper
    // left; or a socket cut into what is under it, its upper wall in shadow
    // and a catch light on its lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    let metal = clamp(raised - 1.0, 0.0, 1.0)
    var rc = bez * (0.94 + mix(0.12, 0.55, metal) * facing)
    rc = mix(rc, min(bez + vec3(0.30, 0.30, 0.30), white), smoothstep(mix(0.35, 0.55, metal), 0.9, facing) * mix(0.6, 0.85, metal))
    rc = mix(rc, rc * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.0, 0.8, nrm.y) * 0.8)
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = min(mix(sc, rc, min(raised, 1.0)), white)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, gone in
    // about two radii, falling on the bezel too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = lq_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass. Its colour deepens toward
    // the top; light pools low inside, where it comes through the dome; lit,
    // its middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass on a dark ground, a grey bead on a pale one,
    // its colour barely there, the same dome, a catch light along its lower
    // rim.
    let offc = mix(mix(vec3(0.085, 0.09, 0.115), ground * 0.62, pale), b * 0.4, 0.12)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl * (1.0 - 0.5 * pale)
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    // One crisp highlight: a white oval across its upper third.
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    // Out, a faint seam where the dome meets its bezel; lit, none: the rim
    // is the colour.
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp: the lamp above, here in a ring of clear glass, as its lens buttons are: a crisp white seal on its upper edge and a soft shadow.
// The halo's room is held in the lamp's own box (the library reserves a
// lens thickness either side once a halo is asked for), so the light is
// never cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    let half_len = max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5)
    // The lens is the lamp's size; its socket stands round it in the room.
    let hb = vec2(mix(t * 0.5, half_len, self.bar), t * 0.5)
    let lo = lq_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.812, 0.816, 0.831), max(room - 0.5, 2.0), vec3(0.0, 0.0, 0.0), 1.0)
    let up = lq_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.812, 0.816, 0.831), max(room - 0.5, 2.0), vec3(1.0, 1.0, 1.0), 1.0)
    return lq_unfill(lo, up, 0.08) * self.opacity
}
true
