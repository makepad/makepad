mod.widgets.SliderRoundFlat.draw_bg.cap_rim = uniform(1.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_ao = uniform(0.46)
mod.widgets.SliderRoundFlat.draw_bg.cap_reflection = uniform(0.46)
mod.widgets.SliderRoundFlat.draw_bg.cap_reflection_perspective = uniform(0.51)
mod.widgets.SliderRoundFlat.draw_bg.cap_glow = uniform(0.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_exposure = uniform(0.05)
mod.widgets.SliderRoundFlat.draw_bg.cap_rolloff = uniform(0.88)
mod.widgets.SliderRoundFlat.draw_bg.cap_shadow = uniform(0.5)
mod.widgets.SliderRoundFlat.draw_bg.cap_shadow_blur = uniform(10.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_contact = uniform(0.35)
mod.widgets.SliderRoundFlat.draw_bg.cap_inner = uniform(0.5)
mod.widgets.SliderRoundFlat.draw_bg.cap_edge_width = uniform(1.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_blend = uniform(0.02)
mod.widgets.SliderRoundFlat.draw_bg.cap_edge_out0 = uniform(vec2(0.0, 0.5523))
mod.widgets.SliderRoundFlat.draw_bg.cap_edge_in1 = uniform(vec2(-0.5523, 0.0))
mod.widgets.SliderRoundFlat.draw_bg.cap_edge_out1 = uniform(vec2(0.5523, 0.0))
mod.widgets.SliderRoundFlat.draw_bg.cap_height = uniform(6.5)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_depth = uniform(4.4)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_magnify = uniform(0.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_tint = uniform(0.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_chroma = uniform(0.05)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_caustic = uniform(0.6)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_outer = uniform(1.0)
mod.widgets.SliderRoundFlat.draw_bg.cap_glass_inner = uniform(0.6)
mod.widgets.SliderRoundFlat.draw_bg.cap_ground = uniform(theme.color_bg_app)
mod.widgets.SliderRoundFlat.draw_bg.cap_fill_ink = uniform(theme.color_val)
mod.widgets.SliderRoundFlat.draw_bg.cap_fill_disabled = uniform(theme.color_mark_disabled)
mod.widgets.SliderRoundFlat.draw_bg.cap_body = uniform(#ffffff)
mod.widgets.SliderRoundFlat.draw_bg.cap_light_ink = uniform(theme.color_material_light)
mod.widgets.SliderRoundFlat.draw_bg.cap_shadow_ink = uniform(#2a3140)
// The room the drop and its shadow need past the box, the same in vertex
// and pixel.
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.rect_size.y, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The bar slider: a 6 point well under the label row, the accent fill from
// the stop (or from the default) to the handle, and the liquid glass drop
// (18 points, with the widget's liquid motion) through which the well and
// its fill show bent and magnified.
mod.widgets.SliderFlat.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dis = mix(1.0, 0.35, self.disabled)
    let fcol = mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled)
    let acc = lq_bar_track(ab, tbox.xy, tbox.zw, px, f.x, f.y, fcol, dis)
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.rect_size.y, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let top = 20.0
    let cy = Finish.snap(org.y + top + (self.rect_size.y - top) * 0.5, px) - org.y
    // The drop's centre runs from half a cap in to half a cap from the end,
    // as the widget's travel has it.
    let r = self.cap_px * 0.5
    let x0 = self.inset_px + r
    let x1 = self.rect_size.x - self.inset_px - r
    let hx = mix(x0, x1, self.slide_pos)
    let gc = vec2(self.rect_size.x * 0.5, cy)
    let gh = vec2(self.rect_size.x * 0.5, 3.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, hi, self.arc_origin)
    let f0 = mix(gc.x - gh.x, mix(x0, x1, from), step(0.0001, from))
    let f1 = mix(x0, x1, to)
    let kc = vec2(Finish.snap(org.x + hx, px) - org.x, cy)
    return self.lq_drop(pq, kc, vec4(gc, gh), vec4(0.0, 0.0, 0.0, 0.0), vec2(f0, f1), px, m, 1.0, 1.0, 0.0)
}

// The minimal slider: an engraved line, dark over light, a 2 point fill
// and the liquid glass drop (14 points, with the widget's liquid motion).
mod.widgets.SliderMinimal.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dis = mix(1.0, 0.35, self.disabled)
    let fcol = mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled)
    let acc = lq_line_track(ab, tbox.z * 2.0, tbox.y, px, f.x, f.y, fcol, dis)
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.rect_size.y, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let top = self.offset_y
    let cy = Finish.snap(org.y + top + (self.rect_size.y - top) * 0.5, px) - org.y
    let r = self.cap_px * 0.5
    let x0 = self.inset_px + r
    let x1 = self.rect_size.x - self.inset_px - r
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, hi, self.arc_origin)
    let fx0 = mix(x0, x1, from)
    let fx1 = mix(x0, x1, to)
    let hx = mix(x0, x1, self.slide_pos)
    let kc = vec2(Finish.snap(org.x + hx, px) - org.x, cy)
    return self.lq_drop(pq, kc, vec4(self.rect_size.x * 0.5, cy, self.rect_size.x * 0.5, 1.0), vec4(0.0, 0.0, 0.0, 0.0), vec2(fx0, fx1), px, m, 1.0, 1.0, 0.0)
}

// The round slider is the readout slider: a glass capsule beside its label
// holding a 6 point well, the fill up to the liquid glass drop (16 points,
// with the widget's liquid motion) riding the capsule.
mod.widgets.SliderRoundFlat.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let sc = cap.xy
    let sh = cap.zw
    let hgt = sh.y * 2.0
    var acc = lq_cast(ab, sc, sh, sh.y, px, hgt, 0.26 * dis, 1.0, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.3 * en)
    acc = Finish.over(acc, lq_glass_body(ab, sc, sh, sh.y, px, hgt, vec3(0.0, 0.0, 0.0), 0.0, 0.02 * self.hover, 1.0, 0.88, mix(1.0, 0.5, self.disabled), 1.0, 0.06 * hgt + px, 1.5, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988)))
    acc = Finish.over(acc, lq_well(ab, tbox.xy, tbox.zw, 3.0, px, vec3(0.737, 0.749, 0.773), dis))
    acc = lq_fill(acc, ab, tbox.xy, tbox.zw, px, f.x, f.y, mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled), 0.8)
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.rect_size.y, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let sx0 = self.label_size
    let sx1 = self.rect_size.x - 40.0
    let hgt = min(self.rect_size.y, 18.0)
    let b = lq_snap(org, vec2(sx0, self.rect_size.y * 0.5 - hgt * 0.5), vec2(sx1, self.rect_size.y * 0.5 + hgt * 0.5), px)
    let sc = (b.xy + b.zw) * 0.5
    let sh = (b.zw - b.xy) * 0.5
    let wc = vec2(sc.x, sc.y)
    let wh = vec2(sh.x - 6.0, 3.0)
    let x0 = wc.x - wh.x + 2.0
    let x1 = wc.x + wh.x - 2.0
    let hx = mix(x0, x1, self.slide_pos)
    let kc = vec2(Finish.snap(org.x + hx, px) - org.x, sc.y)
    return self.lq_drop(pq, kc, vec4(wc, wh), vec4(sc, sh), vec2(wc.x - wh.x, hx), px, m, 1.0, 1.0, 0.0)
}

// THE TOGGLE'S DROP. The knob is the sliders' liquid glass drop: the
// material under the same names as on the faders, the motion's five values
// as uniforms the widget writes, the knob's followed position beside them,
// and the drop pipeline itself handed over from the minimal face, drawn
// with the settling outline (THE SETTLING DROP) so the knob lands without
// a swell. The
// rocker and the slide switch carry the same drop (SWITCHES below), so the
// material is laid on each one's draw from here.
let lq_toggle_drop = fn(d) {
    d.cap_px = uniform(22.0)
    d.cap_stretch = uniform(0.0)
    d.cap_dir = uniform(1.0)
    d.cap_press = uniform(0.0)
    d.cap_squash_along = uniform(1.0)
    d.cap_squash_across = uniform(1.0)
    d.knob_t = uniform(0.0)
    d.knob_follow = uniform(0.0)
    d.cap_light = uniform(vec3(-0.3, -0.6, 0.74))
    d.cap_light_intensity = uniform(1.25)
    d.cap_specular = uniform(1.0)
    d.cap_roughness = uniform(0.02)
    d.cap_gloss = uniform(0.0)
    d.cap_rim = uniform(1.0)
    d.cap_ao = uniform(0.46)
    d.cap_reflection = uniform(0.94)
    d.cap_reflection_perspective = uniform(0.61)
    d.cap_glow = uniform(0.0)
    d.cap_exposure = uniform(0.2)
    d.cap_rolloff = uniform(0.88)
    d.cap_shadow = uniform(0.5)
    d.cap_shadow_blur = uniform(10.0)
    d.cap_contact = uniform(0.35)
    d.cap_inner = uniform(0.5)
    d.cap_edge_width = uniform(0.74)
    d.cap_blend = uniform(0.175)
    d.cap_edge_out0 = uniform(vec2(0.0062, -0.0167))
    d.cap_edge_in1 = uniform(vec2(-0.9938, 0.0))
    d.cap_edge_out1 = uniform(vec2(0.9938, 0.0))
    d.cap_height = uniform(4.8)
    d.cap_glass_depth = uniform(2.75)
    d.cap_glass_magnify = uniform(0.0)
    d.cap_glass_tint = uniform(0.0)
    d.cap_glass_chroma = uniform(0.32)
    d.cap_glass_caustic = uniform(0.0)
    d.cap_glass_outer = uniform(1.0)
    d.cap_glass_inner = uniform(0.6)
    d.cap_ground = uniform(theme.color_bg_app)
    d.cap_fill_ink = uniform(theme.color_val)
    d.cap_fill_disabled = uniform(theme.color_mark_disabled)
    d.cap_body = uniform(#ffffff)
    d.cap_light_ink = uniform(theme.color_material_light)
    d.cap_shadow_ink = uniform(#2a3140)
}
mod.widgets.ToggleFlat.cap_viscosity = 0.66
lq_toggle_drop(mod.widgets.ToggleFlat.draw_bg)
mod.widgets.ToggleFlat.draw_bg.lq_drop = mod.widgets.SliderMinimal.draw_bg.lq_drop
// What lies under the knob: the track, a channel cut into the ground
// (the sheet's well), filled with the accent as far as it is on, red in
// error, lifted a little under the pointer. `cap` is the track's box
// (centre, half size).
mod.widgets.ToggleFlat.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let hov = self.hover * en * 0.04
    var acc = lq_well(ab, cap.xy, cap.zw, cap.w, px, vec3(0.737, 0.749, 0.773) + vec3(hov, hov, hov), dis)
    let fcol = mix(mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled), lq_red(), self.error)
    acc = lq_fill(acc, ab, cap.xy, cap.zw, px, cap.x - cap.z, cap.x + cap.z, fcol, 0.8 * self.active)
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let th = self.size
    let keep = 0.0 * (self.border_size + self.knob_inset)
    let t = mix(mix(self.active, self.drag_pos, self.drag), self.knob_t, self.knob_follow) + keep
    let w = th * self.pill_aspect
    let x0 = (self.rect_size.x - w) * self.mark_at_end
    let b = lq_snap(org, vec2(x0, self.rect_size.y * 0.5 - th * 0.5), vec2(x0 + w, self.rect_size.y * 0.5 + th * 0.5), px)
    let out = lq_air_switch(pq, b.xy, b.zw, px, t, self.hover * (1.0 - self.disabled), self.disabled, self.error, self.cap_ground.rgb)
    let tc = (b.xy + b.zw) * 0.5
    let thh = (b.zw - b.xy) * 0.5
    let td = Material.sd_box(pq, tc, thh, thh.y)
    return Finish.over(out, lq_focus(td, px, self.focus * (1.0 - self.disabled)))
}

// SWITCHES. The rocker and the slide switch are the toggle with its liquid
// glass drop for their moving part, riding the toggle's channel (the
// sheet's well, as long and as tall as the toggle's, filled with the
// accent as far as they are on, red in error): the rocker's drop runs
// between an "O" in the off end and an "I" in the on end, the slide's
// leaves its lamp in the end it has left, a white dot while on and an open
// ring while off. What lies under the drop is seen through it, bent, as on
// the toggle; the legends are dark on the bare channel and white on the
// fill. The rocker flips on a click and does not drag; the slide follows a
// drag. Both move with the toggle's viscosity.
mod.widgets.ToggleRocker.cap_viscosity = 0.66
mod.widgets.ToggleSlide.cap_viscosity = 0.66
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
lq_toggle_drop(mod.widgets.ToggleRocker.draw_bg)
lq_toggle_drop(mod.widgets.ToggleSlide.draw_bg)
mod.widgets.ToggleRocker.draw_bg.lq_drop = mod.widgets.SliderMinimal.draw_bg.lq_drop
mod.widgets.ToggleSlide.draw_bg.lq_drop = mod.widgets.SliderMinimal.draw_bg.lq_drop
// The toggle's channel and the toggle's room round it, so the label
// stands as far from the drop; the rocker's border and knob inset the
// toggle's, so the widget's travel is the drawn one.
mod.widgets.ToggleRocker.draw_bg.size = uniform(20.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.06)
mod.widgets.ToggleRocker.draw_bg.border_size = uniform(1.0)
mod.widgets.ToggleRocker.draw_bg.knob_inset = uniform(1.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(20.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(2.06)
mod.widgets.ToggleRocker.padding = mod.turtle.Inset{left: 20.0 right: 20.0 top: 6.0 bottom: 6.0}
mod.widgets.ToggleSlide.padding = mod.turtle.Inset{left: 20.0 right: 20.0 top: 6.0 bottom: 6.0}
mod.widgets.ToggleRocker.label_walk.margin.left = 26.0
mod.widgets.ToggleSlide.label_walk.margin.left = 26.0
// The rocker's channel: the toggle's, and in it the legends, each in the
// middle of the place the drop rests at that end: an "O" ring in the off
// end, an "I" bar in the on end. `cap` is the channel's box (centre, half
// size).
mod.widgets.ToggleRocker.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let hov = self.hover * en * 0.04
    var acc = lq_well(ab, cap.xy, cap.zw, cap.w, px, vec3(0.737, 0.749, 0.773) + vec3(hov, hov, hov), dis)
    let fcol = mix(mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled), lq_red(), self.error)
    acc = lq_fill(acc, ab, cap.xy, cap.zw, px, cap.x - cap.z, cap.x + cap.z, fcol, 0.8 * self.active)
    let at_o = vec2(cap.x - cap.z + cap.w + 1.0, cap.y)
    let at_i = vec2(cap.x + cap.z - cap.w - 1.0, cap.y)
    let ring = Finish.cover(abs(length(ab - at_o) - cap.w * 0.34) - 0.55, px)
    let bar = Finish.cover(max(abs(ab.x - at_i.x) - 0.55, abs(ab.y - at_i.y) - cap.w * 0.4), px)
    let la = clamp(ring + bar, 0.0, 1.0) * mix(0.8, 0.95, self.active) * dis
    let ink = mix(vec3(0.290, 0.306, 0.337), vec3(0.965, 0.973, 0.988), self.active)
    acc = Finish.over(acc, vec4(ink * la, la))
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The rocker drawn as the toggle is: the drop at its side or where the
// liquid motion has it, half the channel plus a point in, travelling the
// channel less its height and two points (the widget's own travel, from
// the border and the knob inset it reads back).
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let th = self.size
    let keep = 0.0 * (self.border_size + self.knob_inset)
    let t = mix(mix(self.active, self.drag_pos, self.drag), self.knob_t, self.knob_follow) + keep
    let w = th * self.pill_aspect
    let x0 = (self.rect_size.x - w) * self.mark_at_end
    let b = lq_snap(org, vec2(x0, self.rect_size.y * 0.5 - th * 0.5), vec2(x0 + w, self.rect_size.y * 0.5 + th * 0.5), px)
    let out = lq_air_switch(pq, b.xy, b.zw, px, t, self.hover * (1.0 - self.disabled), self.disabled, self.error, self.cap_ground.rgb)
    let tc = (b.xy + b.zw) * 0.5
    let thh = (b.zw - b.xy) * 0.5
    let td = Material.sd_box(pq, tc, thh, thh.y)
    return Finish.over(out, lq_focus(td, px, self.focus * (1.0 - self.disabled)))
}
// The slide's channel: the toggle's, and in it the lamp in the end the
// drop has left, moving with the drop as the library's mark does.
mod.widgets.ToggleSlide.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let hov = self.hover * en * 0.04
    var acc = lq_well(ab, cap.xy, cap.zw, cap.w, px, vec3(0.737, 0.749, 0.773) + vec3(hov, hov, hov), dis)
    let fcol = mix(mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled), lq_red(), self.error)
    acc = lq_fill(acc, ab, cap.xy, cap.zw, px, cap.x - cap.z, cap.x + cap.z, fcol, 0.8 * self.active)
    let t = mix(mix(self.active, self.drag_pos, self.drag), self.knob_t, self.knob_follow)
    let free = vec2(mix(cap.x + cap.z - cap.w, cap.x - cap.z + cap.w, t), cap.y)
    let mr = cap.w * 0.3
    let dot = Finish.cover(length(ab - free) - mr, px)
    let ring = Finish.cover(abs(length(ab - free) - mr) - 0.5, px)
    let la = mix(ring, dot, self.active) * mix(0.8, 0.95, self.active) * dis
    let ink = mix(vec3(0.290, 0.306, 0.337), vec3(0.965, 0.973, 0.988), self.active)
    acc = Finish.over(acc, vec4(ink * la, la))
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.ToggleSlide.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The slide drawn as the toggle is, its drop travelling the channel less
// its height (the widget's `knob_centred` travel, which its drag reads).
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.size, self.cap_px, 0.0, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let th = self.size
    let keep = 0.0 * (self.border_size + self.knob_inset + self.knob_centred)
    let t = mix(mix(self.active, self.drag_pos, self.drag), self.knob_t, self.knob_follow) + keep
    let w = th * self.pill_aspect
    let x0 = (self.rect_size.x - w) * self.mark_at_end
    let b = lq_snap(org, vec2(x0, self.rect_size.y * 0.5 - th * 0.5), vec2(x0 + w, self.rect_size.y * 0.5 + th * 0.5), px)
    let out = lq_air_switch(pq, b.xy, b.zw, px, t, self.hover * (1.0 - self.disabled), self.disabled, self.error, self.cap_ground.rgb)
    let tc = (b.xy + b.zw) * 0.5
    let thh = (b.zw - b.xy) * 0.5
    let td = Material.sd_box(pq, tc, thh, thh.y)
    return Finish.over(out, lq_focus(td, px, self.focus * (1.0 - self.disabled)))
}

// RANGE SLIDER. A 6 point well the track's length, the accent span between
// the two ends, and a liquid glass drop (16 points) on each end, the well
// and the span seen bent through them. The two drops are the sliders'
// drop drawn twice; every pixel takes the nearer drop's rendering, so each
// drop refracts the well and the span but not the other drop.
mod.widgets.RangeSliderFlat.handle_size = 16.0
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.draw_bg.cap_px = uniform(16.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_stretch = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_dir = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_press = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_squash_along = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_squash_across = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_light = uniform(vec3(-0.3, -0.6, 0.74))
mod.widgets.RangeSliderFlat.draw_bg.cap_light_intensity = uniform(0.95)
mod.widgets.RangeSliderFlat.draw_bg.cap_specular = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_roughness = uniform(0.02)
mod.widgets.RangeSliderFlat.draw_bg.cap_gloss = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_rim = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_ao = uniform(0.46)
mod.widgets.RangeSliderFlat.draw_bg.cap_reflection = uniform(0.46)
mod.widgets.RangeSliderFlat.draw_bg.cap_reflection_perspective = uniform(0.51)
mod.widgets.RangeSliderFlat.draw_bg.cap_glow = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_exposure = uniform(0.05)
mod.widgets.RangeSliderFlat.draw_bg.cap_rolloff = uniform(0.88)
mod.widgets.RangeSliderFlat.draw_bg.cap_shadow = uniform(0.5)
mod.widgets.RangeSliderFlat.draw_bg.cap_shadow_blur = uniform(10.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_contact = uniform(0.35)
mod.widgets.RangeSliderFlat.draw_bg.cap_inner = uniform(0.5)
mod.widgets.RangeSliderFlat.draw_bg.cap_edge_width = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_blend = uniform(0.02)
mod.widgets.RangeSliderFlat.draw_bg.cap_edge_out0 = uniform(vec2(0.0, 0.5523))
mod.widgets.RangeSliderFlat.draw_bg.cap_edge_in1 = uniform(vec2(-0.5523, 0.0))
mod.widgets.RangeSliderFlat.draw_bg.cap_edge_out1 = uniform(vec2(0.5523, 0.0))
mod.widgets.RangeSliderFlat.draw_bg.cap_height = uniform(6.5)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_depth = uniform(4.4)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_magnify = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_tint = uniform(0.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_chroma = uniform(0.05)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_caustic = uniform(0.6)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_outer = uniform(1.0)
mod.widgets.RangeSliderFlat.draw_bg.cap_glass_inner = uniform(0.6)
mod.widgets.RangeSliderFlat.draw_bg.cap_ground = uniform(theme.color_bg_app)
mod.widgets.RangeSliderFlat.draw_bg.cap_fill_ink = uniform(theme.color_val)
mod.widgets.RangeSliderFlat.draw_bg.cap_fill_disabled = uniform(theme.color_mark_disabled)
mod.widgets.RangeSliderFlat.draw_bg.cap_body = uniform(#ffffff)
mod.widgets.RangeSliderFlat.draw_bg.cap_light_ink = uniform(theme.color_material_light)
mod.widgets.RangeSliderFlat.draw_bg.cap_shadow_ink = uniform(#2a3140)
mod.widgets.RangeSliderFlat.draw_bg.lq_drop = mod.widgets.SliderMinimal.draw_bg.lq_drop
// What lies under the drops: the well and the span from `f.x` to `f.y`,
// over the ground.
mod.widgets.RangeSliderFlat.draw_bg.lq_under = fn(ab: vec2, tbox: vec4, cap: vec4, f: vec2) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dis = mix(1.0, 0.35, self.disabled)
    let fcol = mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled)
    var acc = lq_well(ab, tbox.xy, tbox.zw, tbox.w, px, vec3(0.737, 0.749, 0.773), dis)
    acc = lq_fill(acc, ab, tbox.xy, tbox.zw, px, f.x, f.y, fcol, 0.8 + 0.1 * self.hot_band)
    return Finish.over(vec4(self.cap_ground.rgb, 1.0), acc).rgb
}
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.rect_size.y - self.label_px, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = lq_fader_room(self.rect_size.y - self.label_px, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let org = self.rect_pos
    let top = self.label_px
    let track_h = self.rect_size.y - top
    let cy = Finish.snap(org.y + top + track_h * 0.5, px) - org.y
    // Both centres come out of the travel the hit test uses, so what is
    // drawn is what is grabbable.
    let span_x = self.rect_size.x - self.inset_px * 2.0 - self.cap_px
    let sc = self.inset_px + self.cap_px * 0.5 + self.start_pos * span_x
    let ec = self.inset_px + self.cap_px * 0.5 + self.end_pos * span_x
    let gc = vec2(self.rect_size.x * 0.5, cy)
    let gh = vec2(self.rect_size.x * 0.5, 3.0)
    let kc0 = vec2(Finish.snap(org.x + sc, px) - org.x, cy)
    let kc1 = vec2(Finish.snap(org.x + ec, px) - org.x, cy)
    let a = self.lq_drop(pq, kc0, vec4(gc, gh), vec4(0.0, 0.0, 0.0, 0.0), vec2(sc, ec), px, m, 1.0, self.hot_start, 0.0)
    let b = self.lq_drop(pq, kc1, vec4(gc, gh), vec4(0.0, 0.0, 0.0, 0.0), vec2(sc, ec), px, m, 1.0, self.hot_end, 0.0)
    return mix(a, b, step(length(pq - kc1), length(pq - kc0)))
}

// KNOBS. A clear glass disc with the rim of every other part, a black
// pointer line, and round it a dark ring with the value laid into it as an
// accent core, the glass family's value arc: ink, not light.
let lq_arc = fn(p: vec2, c: vec2, rr: float, a0: float, a1: float, w: float) -> float {
    let q = p - c
    var ap = atan2(-q.x, q.y)
    if ap < 0.0 {
        ap = ap + 2.0 * PI
    }
    let rel = ap - a0 - floor((ap - a0) / (2.0 * PI)) * 2.0 * PI
    let on = step(rel, a1 - a0)
    let band = abs(length(q) - rr) - 0.5 * w
    let e0 = length(q - vec2(-sin(a0), cos(a0)) * rr) - 0.5 * w
    let e1 = length(q - vec2(-sin(a1), cos(a1)) * rr) - 0.5 * w
    return mix(min(e0, e1), band, on)
}

// The ring, a little outside the cap: a pale hairline, then the dark band
// with the value's accent core laid into it. Premultiplied.
let lq_knob_ring = fn(p: vec2, c: vec2, r: float, px: float, start: float, sweep: float, a0: float, a1: float, disabled: float) -> vec4 {
    let dis = mix(1.0, 0.35, disabled)
    let gap = clamp(0.1 * r, 1.5, 3.0)
    let rr = r + gap
    let pale = Finish.cover(lq_arc(p, c, rr + gap * 0.5 + 1.0, start, start + sweep, px), px) * 0.45 * dis
    var acc = vec4(pale, pale, pale, pale)
    let ta = Finish.cover(lq_arc(p, c, rr, start, start + sweep, 2.0), px) * 0.85 * dis
    acc = Finish.over(acc, vec4(vec3(0.196, 0.271, 0.400) * ta, ta))
    let va = Finish.cover(lq_arc(p, c, rr, a0, max(a1, a0 + 0.001), 1.1), px) * step(0.0005, a1 - a0) * dis
    return Finish.over(acc, vec4(mix(vec3(0.439, 0.620, 0.949), vec3(0.643, 0.651, 0.671), disabled) * va, va))
}

// How far the glass reaches: its rest radius `r`, and pressed (`grow` 1, a
// little past it as the press springs) three points past the ring's pale
// hairline, so the whole ring lies under it and clear of the solid lines
// along the glass's rim.
let lq_knob_reach = fn(r: float, grow: float) -> float {
    let gap = clamp(0.1 * r, 1.5, 3.0)
    let out = r + gap * 1.5 + 4.0
    return r + (out - r) * grow
}

// THE DROP IN MOTION. The knob is a flat drop of water lying on its ring,
// and it moves as water does, not as jelly: slowly, damped, flowing.
// Pressed, it spreads out over the ring like poured water, fast at first
// and arriving softly (1 - e^(-t / 0.11)), while soft lobes rise on its
// outline and travel round it, each at its own speed and some the other
// way, so its shape melts from one blob into the next; they die away over
// about a second and it rests spread and round. Let go, it eases in (a
// damped return, 0.8 of critical: it starts slowly, overshoots once by a
// point or two and settles), drawing in a little past rest into a smaller,
// taller dome that eases back, while new lobes rise and circle round it and
// melt away; it is round again within 1.2 seconds. The lobes it had while
// held do not stop at the release but carry on fading, so nothing snaps.
// The lobes are the drop's two-, three- and four-lobed modes (the
// three-lobed strongest) with their angles moving: convex lobes joined by
// soft waists, never a point, and never a lobe bouncing in place. They keep
// the drop's mean radius and its scale is taken down by what they add, so
// its area holds; drawn in smaller it reads taller: lit harder, its lines
// tighter, a small glint high on its left. While it moves the glass reads
// thick: a bright band inside its rim, strongest on its lit side, a glint
// where the rim faces the light, and a soft colour fringe along the rim,
// blue and violet on the left and pink and peach on the right. At rest it
// is drawn as it always was; a hover moves nothing.
//
// No two need be the same. Each set of lobes takes its own angles, mix of
// the modes (the three-lobed's weight 0.85 to 1.15, the others' 0.65 to
// 1.35 and 0.6 to 1.4), speeds and way round, and its own decay (within
// 0.15), and the dome a size within a fifth either way. A release draws
// them from a hash of how long the knob was held (the press clock, to the
// frame), its value and its place on the window (`seat`); a press from the
// place alone, since the hold is not known yet and the value moves under a
// turn: turned, the pointer turns and the drop does not.
//
// The clocks: the drag (1 held, falling to 0 over 1.2 seconds when let
// go, so the time since the release is (1 - drag) * 1.2) and the press
// clock (0 to 1 over 8 seconds from the press, held, and falling with the
// drag when let go, so the clock over the drag is how long it was held,
// over 8, all through the release; their animator, below). From these the
// face knows the time since the press throughout, and the spread it had
// when let go.

// A share of the drop's radius in the direction `u`: two sets of lobes,
// the press's and the release's, each `a` (.xyz) the swings of its two-,
// three- and four-lobed modes and `f` (.xyz) their angles; `a.w` the
// drop's scale.
let lq_drop_form = fn(u: vec2, a: vec4, f: vec4, b: vec4, g: vec4) -> float {
    let th = atan2(u.y, u.x)
    let pl = a.x * cos(2.0 * (th - f.x)) + a.y * cos(3.0 * (th - f.y)) + a.z * cos(4.0 * (th - f.z))
    let rl = b.x * cos(2.0 * (th - g.x)) + b.y * cos(3.0 * (th - g.y)) + b.z * cos(4.0 * (th - g.z))
    return a.w * max(1.0 + pl + rl, 0.3)
}

// The pointer: a black line 1.5 points wide, a fifth of the disc long, set
// in from the rim. Premultiplied.
let lq_knob_pointer = fn(p: vec2, c: vec2, r: float, px: float, val: float, disabled: float) -> vec4 {
    let dir = vec2(-sin(val), cos(val))
    let pd = lq_seg(p, c + dir * (r - 2.5 - 0.4 * r), c + dir * (r - 2.5)) - 0.75
    let pa = Finish.cover(pd, px) * mix(1.0, 0.35, disabled)
    return vec4(vec3(0.110, 0.118, 0.133) * pa, pa)
}

// The knob: the drop's glass in its shape over the ring, and the pointer
// carried by the drop's shape as the glass is (THE DROP IN MOTION). Where
// the drop lies past its rest disc, over the ring, the ring is seen through
// it as it is, under a face thinned to a third, nothing bent; the glass's
// rim lines are solid, and where they pass over the ring the ring still
// shows through them at seven tenths.
let lq_knob = fn(p: vec2, c: vec2, r: float, px: float, start: float, sweep: float, a0: float, a1: float, val: float, hover: float, drag: float, clock: float, focus: float, disabled: float, seat: float) -> vec4 {
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.35, disabled)
    let dd = 2.0 * r
    let tw = 2.0 * PI
    // The motion.
    let held = step(0.9995, drag)
    let tr = (1.0 - clamp(drag, 0.0, 1.0)) * 1.2
    // How long it was held (and held, how long since the press), seconds.
    let hold = clamp(clock / max(drag, 0.0001), 0.0, 1.0) * 8.0
    let tp = hold + tr
    let fade = 1.0 - smoothstep(0.85, 1.2, tr) * (1.0 - held)
    // The press's lobes: from the place alone, never the value, so turning
    // the knob turns its pointer and leaves the drop be.
    let sv = seat * tw
    let kp1 = sin(sv * 1.7 + 0.4)
    let kp2 = sin(sv * 1.3 + 2.1)
    let kp3 = sin(sv * 2.3 + 4.4)
    let kp4 = sin(sv * 1.1 + 1.2)
    let kp5 = sin(sv * 1.9 + 3.3)
    let kp6 = sin(sv * 2.9 + 5.1)
    let pe = smoothstep(0.0, 0.12, tp) * exp(-tp / (0.32 * (1.0 + 0.15 * kp5))) * fade
    let pw2 = mix(-1.0, 1.0, step(0.0, kp4))
    let pa = vec4(0.10 * (1.0 + 0.35 * kp1) * pe, 0.18 * (1.0 + 0.15 * kp2) * pe, 0.06 * (1.0 + 0.40 * kp3) * pe, 0.0)
    let pf = vec4(PI * kp4 + pw2 * 1.9 * (1.0 + 0.2 * kp6) * tp, 0.5 + PI * kp5 - pw2 * 1.3 * (1.0 + 0.2 * kp1) * tp, 1.9 + PI * kp6 + pw2 * 1.0 * (1.0 + 0.2 * kp2) * tp, 0.0)
    // The release's lobes: hashed from the hold, the value and the place.
    // The hold is read back as the clock over the drag, which wanders in
    // its last bits from frame to frame; the hash turns any change into
    // other lobes, so it is taken to the whole frame first (else the drop
    // jumps between shapes as it settles).
    let hs = vec2(floor(hold * 60.0 + 0.5) * 4.9979 + seat * 97.0, val * 517.0 + seat * 311.0)
    let kr1 = Finish.hash(hs) * 2.0 - 1.0
    let kr2 = Finish.hash(hs + vec2(13.7, 71.3)) * 2.0 - 1.0
    let kr3 = Finish.hash(hs + vec2(41.9, 7.1)) * 2.0 - 1.0
    let kr4 = Finish.hash(hs + vec2(5.3, 29.9)) * 2.0 - 1.0
    let kr5 = Finish.hash(hs + vec2(88.1, 52.7)) * 2.0 - 1.0
    let kr6 = Finish.hash(hs + vec2(23.3, 91.1)) * 2.0 - 1.0
    let re = smoothstep(0.0, 0.18, tr) * exp(-tr / (0.38 * (1.0 + 0.15 * kr5))) * (1.0 - held) * fade
    let rw2 = mix(-1.0, 1.0, step(0.0, kr4))
    let ra = vec4(0.10 * (1.0 + 0.35 * kr1) * re, 0.17 * (1.0 + 0.15 * kr2) * re, 0.05 * (1.0 + 0.40 * kr3) * re, 0.0)
    let rf = vec4(val + PI * kr4 + rw2 * 1.9 * (1.0 + 0.2 * kr6) * tr, val + 0.5 + PI * kr5 - rw2 * 1.3 * (1.0 + 0.2 * kr1) * tr, val + 1.9 + PI * kr6 + rw2 * 1.0 * (1.0 + 0.2 * kr2) * tr, 0.0)
    // The dome: drawn in a little past rest after the release, once,
    // easing back.
    let du = tr / 0.28
    let dome = -0.11 * (1.0 + 0.2 * kr6) * du * exp(1.0 - du) * (1.0 - held) * fade
    let ss = pa.x * pa.x + pa.y * pa.y + pa.z * pa.z + ra.x * ra.x + ra.y * ra.y + ra.z * ra.z
    let a = vec4(pa.xyz * en, mix(1.0, (1.0 + dome) / sqrt(1.0 + 0.5 * ss), en))
    let ar = vec4(ra.xyz * en, 0.0)
    let defo = clamp((pa.x + pa.y + pa.z + ra.x + ra.y + ra.z) * 5.0 + abs(dome) * 4.0, 0.0, 1.0) * en
    // The spread: poured out while held; let go, a damped return from the
    // spread it had.
    let spread = 1.0 - exp(-tp / 0.11)
    let g0 = 1.0 - exp(-hold / 0.11)
    let zw = 0.8 * 7.5
    let wd = 7.5 * sqrt(1.0 - 0.8 * 0.8)
    let back = exp(-zw * tr) * (cos(wd * tr) + (zw / wd) * sin(wd * tr))
    let grow = mix(g0 * back * fade, spread, held)
    // The glass.
    let hov = hover * en * (1.0 - held)
    let gw = grow * en
    let rg = lq_knob_reach(r, gw)
    var acc = lq_knob_ring(p, c, r, px, start, sweep, a0, a1, disabled)
    let q = p - c
    let rho = length(q)
    let e = lq_drop_form(q / max(rho, 0.0001), a, pf, ar, rf)
    let pw = c + q / e
    let rw = length(pw - c)
    var seen = vec4(0.0, 0.0, 0.0, 0.0)
    var under = 0.0
    if rho > r - 1.0 && rw < rg + px {
        under = Finish.cover(rw - rg, px)
        seen = acc
    }
    let h = vec2(rg, rg)
    let kap = clamp(r * r / max(rg * rg * a.w * a.w, 1.0), 0.6, 1.8)
    acc = Finish.over(acc, lq_cast(pw, c, h, rg, px, dd, 0.3 * dis * mix(1.0, kap, 0.5), 1.0 - 0.4 * held, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.32 * en * (1.0 - 0.5 * held)))
    // Clear glass, no grey base (lq_glass_body): the pane shows through it
    // under a breath of white, a little more under the pointer, a little
    // less held.
    let lift = 0.015 * hov - 0.01 * held
    let thin = smoothstep(r + 0.25, r + 1.25, max(rw, rho))
    let hl = mix(0.95, 1.0, hov) * mix(1.0, 0.5, disabled) * clamp(mix(1.0, kap, 0.8), 0.7, 1.5)
    let fo = (0.06 * dd + px) / pow(kap, 1.2)
    acc = Finish.over(acc, lq_glass_body(pw, c, h, rg, px, dd, vec3(0.0, 0.0, 0.0), 0.0, lift, 1.0, mix(0.9, 0.3, thin), hl, 1.0, fo, 1.5, vec4(0.620, 0.631, 0.659, 0.9), vec3(0.965, 0.973, 0.988)))
    // Thick glass in motion: the band inside the rim, its glint and its
    // fringe, in the drop's own frame so they follow the outline.
    let inside = Finish.cover(rw - rg, px)
    let n = (pw - c) / max(rw, 0.0001)
    let lt = max(dot(n, normalize(vec2(-0.45, -0.89))), 0.0)
    let din = rg - rw
    let bw = 0.30 * r
    let band = smoothstep(0.0, 0.35 * bw, din) * (1.0 - smoothstep(0.45 * bw, bw, din))
    let ba = band * (0.25 + 0.75 * lt) * 0.50 * defo * inside
    acc = Finish.over(acc, vec4(ba, ba, ba, ba))
    let gx = (din - 0.12 * r) / max(0.07 * r, 0.5)
    let ga = exp(-gx * gx) * pow(lt, 10.0) * 1.0 * defo * inside
    acc = Finish.over(acc, vec4(ga, ga, ga, ga))
    let cool = mix(vec3(0.560, 0.640, 1.000), vec3(0.720, 0.600, 0.980), smoothstep(-1.0, 1.0, n.y))
    let warm = mix(vec3(1.000, 0.800, 0.660), vec3(1.000, 0.660, 0.790), smoothstep(-1.0, 1.0, n.y))
    let fc = mix(cool, warm, smoothstep(-0.6, 0.6, n.x))
    let fa = smoothstep(0.0, 1.5 * px, din) * (1.0 - smoothstep(0.04 * r, 0.11 * r, din)) * 0.55 * defo * inside
    acc = Finish.over(acc, vec4(fc * fa, fa))
    // The glint of a taller dome.
    let gc = c + vec2(-0.30, -0.36) * rg
    let gq = (pw - gc) / max(0.20 * r / kap, 0.5)
    let da = exp(-dot(gq, gq)) * clamp((kap - 1.0) * 2.5, 0.0, 0.85) * inside * en
    acc = Finish.over(acc, vec4(da, da, da, da))
    acc = Finish.over(acc, seen * (Finish.band(rw - rg, 0.0, 3.0 * px, px) * under * 0.7))
    acc = Finish.over(acc, lq_focus(rho - rg, px, focus * en))
    return Finish.over(acc, lq_knob_pointer(pw, c, r, px, val, disabled))
}

// The knobs' press spring at all but the engine's most viscous (at exactly
// 1 the knobs stopped drawing), though the drop's spread now runs on the
// clocks below. The drag state still cuts to 1 on the press; let go, it
// falls in a straight line over 1.2 seconds, the release's clock. The press clock runs 0 to 1 over
// 8 seconds from the press and falls with the drag; it rides on
// `label_size`, which a vertical slider does not read (a further value of
// its own would take the face past the 32 inputs a vertex shader may
// have). The animator only animates a value it has set once, and the
// pointer comes over the knob before it presses, so the hover sets it.
mod.widgets.RotaryKnob.cap_viscosity = 0.99
mod.widgets.RotaryFlat.cap_viscosity = 0.99
mod.widgets.RotaryKnob.animator.drag.on.from = {all: Forward {duration: 8.0}}
mod.widgets.RotaryKnob.animator.drag.on.apply = {draw_bg: {drag: snap(1.0) label_size: 1.0} draw_text: {drag: snap(1.0)}}
mod.widgets.RotaryKnob.animator.drag.off.from = {all: Forward {duration: 1.2}}
mod.widgets.RotaryKnob.animator.drag.off.apply = {draw_bg: {drag: 0.0 label_size: 0.0} draw_text: {drag: 0.0}}
mod.widgets.RotaryKnob.animator.hover.on.apply = {draw_bg: {hover: 1.0 label_size: 0.0} draw_text: {hover: 1.0}}
mod.widgets.RotaryFlat.animator.drag.on.from = {all: Forward {duration: 8.0}}
mod.widgets.RotaryFlat.animator.drag.on.apply = {draw_bg: {drag: snap(1.0) label_size: 1.0} draw_text: {drag: snap(1.0)}}
mod.widgets.RotaryFlat.animator.drag.off.from = {all: Forward {duration: 1.2}}
mod.widgets.RotaryFlat.animator.drag.off.apply = {draw_bg: {drag: 0.0 label_size: 0.0} draw_text: {drag: 0.0}}
mod.widgets.RotaryFlat.animator.hover.on.apply = {draw_bg: {hover: 1.0 label_size: 0.0} draw_text: {hover: 1.0}}

// The panel knob: the disc in the biggest circle the box holds, pinned to
// the bottom under its legend, its ring round it. Held, the glass spreads
// over the ring on the press.
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    let r = dia * 0.5 - clamp(0.15 * dia, 3.5, 6.5)
    let one = PI / 180.0
    let sweep = 2.0 * PI - self.gap * one
    let start = self.gap * one * 0.5
    let val = start + sweep * self.slide_pos
    let org_a = start + sweep * self.origin_pos
    let a0 = mix(start, min(org_a, val), self.arc_origin)
    let a1 = mix(val, max(org_a, val), self.arc_origin)
    let seat = Finish.hash(floor(self.rect_pos) * 0.731 + vec2(3.7, 1.3))
    return lq_knob(pq, c, r, px, start, sweep, a0, a1, val, self.hover, self.drag, self.label_size, self.focus, self.disabled, seat)
}
mod.widgets.RotaryKnob.width = 44.0
mod.widgets.RotaryKnob.height = 60.0
// The legend over a knob is a small caption in the dim ink.
mod.widgets.RotaryKnob.draw_text.color = #4a4e56
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}
mod.widgets.RotaryFlat.text_input.draw_bg.color = #00000000
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding.top = 0.0
mod.widgets.RotaryFlat.text_input.padding.bottom = 0.0
mod.widgets.Rotary.text_input.min_height = 0.0
mod.widgets.Rotary.text_input.padding.top = 0.0
mod.widgets.Rotary.text_input.padding.bottom = 0.0
mod.widgets.RotaryFlat.label_walk.margin.top = 4.0
// The value a bar slider carries beside its label sits on the label's
// line: its field takes no row height of its own (its padding is nil).
mod.widgets.SliderFlat.text_input.min_height = 0.0
mod.widgets.Slider.text_input.min_height = 0.0
mod.widgets.SliderMinimal.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
