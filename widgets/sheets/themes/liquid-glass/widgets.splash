use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// THE GLASS. Thick clear glass lying on a plain grey ground. A face is
// nearly the ground's own colour, so a part is drawn by its edges: one
// device pixel of outline, a white hairline inside it along the top, a
// darker line under that, a bright exit line along the bottom where the
// light leaves the slab, and a dark contact line under the bottom edge.
// Under a standing part the ground carries a cool shadow with the light
// that passed through the glass pooled in its middle. Light comes from
// above, a little from the left. Distances are points; every shadow, pool
// and focus ring is drawn OUTSIDE the layout box, in a quad grown in
// `vertex`, so none of it costs padding.

// The ground, #cfd0d4.
let lq_ground = fn() -> vec3 {
    return vec3(0.812, 0.816, 0.831)
}

// A clear face in the middle of its height, #cfd2d8.
let lq_clear = fn() -> vec3 {
    return vec3(0.812, 0.824, 0.847)
}

// Blue glass in the middle of its height, #94acc8.
let lq_blue = fn() -> vec3 {
    return vec3(0.580, 0.675, 0.784)
}

// Red glass, for the one destructive action, at the blue's strength.
let lq_red = fn() -> vec3 {
    return vec3(0.800, 0.620, 0.620)
}

// The accent itself, #4f7fd1, for fills and marks.
let lq_accent = fn() -> vec3 {
    return vec3(0.310, 0.498, 0.820)
}

// A dither, one value per device pixel in window space, about one level
// of 255: there only to keep the long gradients from banding.
let lq_grain = fn(q: vec2, px: float) -> float {
    return Finish.grain(q / px, 2.0 / 255.0)
}

// A box snapped to whole device pixels in window space, as lo.xy, hi.zw in
// the quad's own points, so every hairline lands on one pixel row.
let lq_snap = fn(org: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    return vec4(Finish.snap(org.x + lo.x, px) - org.x, Finish.snap(org.y + lo.y, px) - org.y, Finish.snap(org.x + hi.x, px) - org.x, Finish.snap(org.y + hi.y, px) - org.y)
}

// Which way the edge of a rounded box nearest p faces.
let lq_norm = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let q = p - c
    let sx = step(0.0, q.x) * 2.0 - 1.0
    let sy = step(0.0, q.y) * 2.0 - 1.0
    let e = max(abs(q) - (h - vec2(r, r)), vec2(0.0, 0.0))
    let l = length(e)
    let side = step(h.x - abs(q.x), h.y - abs(q.y))
    let flat = vec2(sx * side, sy * (1.0 - side))
    let bent = vec2(sx * e.x, sy * e.y) / max(l, 0.0001)
    return mix(flat, bent, step(0.0001, l))
}

// What is left of a drawing when its face is taken away, on his word
// ('remove bg from the cards, meters, screens, readouts etc'): `dark` is
// the drawing over a black face and `light` the same over a white one
// (premultiplied). Their difference is the share of the face; the rest,
// its outline, rim, bevel and shade lines, stays, and the pane's glass
// shows where the face was, under a breath of white (`veil`).
let lq_unfill = fn(dark: vec4, light: vec4, veil: float) -> vec4 {
    let k = clamp((light.x + light.y + light.z - dark.x - dark.y - dark.z) / 3.0, 0.0, 1.0)
    return vec4(dark.xyz + vec3(veil * k, veil * k, veil * k), max(dark.w - k + veil * k, 0.0))
}

// A body of clear glass: `lq_body` with no grey base, its glass only as
// tinted as `tint` at its share `on` (a chosen tile's blue stays), its rim,
// highlights and shade lines kept; `lift` (the pointer's) brightens the
// breath of white over it, a press dims it.
let lq_glass_body = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, s: float, tint: vec3, on: float, lift: float, span: float, alpha: float, hl: float, sh: float, fo: float, ex: float, rim: vec4, hi: vec3) -> vec4 {
    let lo = lq_body(p, c, h, r, px, s, tint * on, span, alpha, hl, sh, fo, ex, rim, hi)
    let up = lq_body(p, c, h, r, px, s, mix(vec3(1.0, 1.0, 1.0), tint, on), span, alpha, hl, sh, fo, ex, rim, hi)
    return lq_unfill(lo, up, clamp(0.07 + lift * 2.0, 0.0, 0.3))
}

// A distance to a segment, for the few strokes drawn by hand.
let lq_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The body of a glass part, inside its edge only, premultiplied. `face` is
// the colour at the middle of the face; `span` scales the fall from a
// lighter top to a darker bottom (1 for clear glass). The face is `alpha`
// opaque, the lines are solid. `hl` scales the light lines, `sh` the shaded
// ones, `fo` is how deep the top hairline's glow falls, `ex` the exit
// line's width in device pixels, `rim` the outline and `hi` the hairline.
let lq_body = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, s: float, face: vec3, span: float, alpha: float, hl: float, sh: float, fo: float, ex: float, rim: vec4, hi: vec3) -> vec4 {
    let d = Material.sd_box(p, c, h, r)
    let n = lq_norm(p, c, h, r)
    let t = -d
    let v = clamp((p.y - c.y + h.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let g = (mix(0.04, 0.0, smoothstep(0.0, 0.5, v)) + mix(0.0, -0.065, smoothstep(0.5, 1.0, v))) * span
    var col = face + vec3(g, g, g)
    let lit = dot(n, vec2(-0.259, -0.966))
    let up = smoothstep(0.15, 0.85, -n.y)
    let low = smoothstep(0.3, 0.9, n.y)
    let right = clamp(n.x, 0.0, 1.0)
    let left = clamp(-n.x, 0.0, 1.0)
    let xf = clamp((p.x - c.x + h.x) / max(2.0 * h.x, 1.0), 0.0, 1.0)
    // The refraction band: a cool shade just inside the rim, heaviest on
    // the side away from the light.
    let rb = (1.0 - smoothstep(0.0, 0.06 * s + px, t)) * 0.13 * mix(0.6, 1.6, clamp(0.5 - 0.5 * lit, 0.0, 1.0)) * sh
    col = mix(col, vec3(0.165, 0.192, 0.251), rb * (1.0 - up * 0.7))
    // The light gathering inside the foot of the slab before it leaves.
    let foot = (1.0 - smoothstep(px, 0.12 * s + px, t)) * low * 0.2 * hl
    col = mix(col, vec3(0.945, 0.957, 0.980), foot)
    // How the top light runs from left to right: full over the left third,
    // seven tenths at the right end.
    let run = smoothstep(0.33, 1.0, xf)
    // The hairline's falloff into the face: two device pixels under it,
    // three over the left third (and a pixel more under the pointer),
    // falling from about 0.55 of the way to white to nothing.
    let fl = max((fo - px) / px, 1.0) * mix(1.25, 0.85, run)
    let fall = (1.0 - clamp((t - 2.0 * px) / (fl * px), 0.0, 1.0)) * step(2.0 * px, t) * up * 0.72 * mix(1.0, 0.8, run) * hl
    col = mix(col, vec3(0.965, 0.973, 0.988), fall)
    // The darker inner edge: along the top it lies just under the falloff,
    // two or three device pixels in from the hairline, and gentle; down the right side,
    // where the slab turns away from the light, it sits right inside.
    let dk0 = (2.0 + floor(fl + 0.5)) * px
    let de_top = Finish.band(d, dk0, dk0 + px, px) * up * 0.36
    let de_side = Finish.band(d, 2.0 * px, 3.0 * px, px) * right * 0.6 * (1.0 - low) * (1.0 - up)
    col = mix(col, vec3(0.560, 0.584, 0.635), max(de_top, de_side) * sh)
    // The exit line: the light leaving the thick glass along the bottom,
    // fading out toward the ends of the arc.
    let exl = Finish.band(d, px, (1.0 + ex) * px, px) * low * 0.9 * hl
    col = mix(col, vec3(0.945, 0.957, 0.980), exl)
    // The top hairline, brightest over the left third, running on thinly
    // down the lit side.
    let hw = max(up * mix(1.0, 0.7, run), left * 0.5 * (1.0 - low))
    let hc = mix(hi, vec3(1.0, 1.0, 1.0), (1.0 - run) * 0.8)
    col = mix(col, hc, Finish.band(d, px, 2.0 * px, px) * hw * hl)
    col = mix(col, rim.rgb, Finish.band(d, 0.0, px, px) * rim.a)
    let a = Finish.cover(d, px)
    let fa = a * mix(alpha, 1.0, Finish.band(d, 0.0, 3.0 * px, px))
    return vec4(col * fa, fa)
}

// What a standing glass part throws on the ground, premultiplied, outside
// its edge only: a broad cool shadow a little right of and below it, a
// tight contact shadow under its bottom edge, and the caustic -- light that
// came through the glass, pooled in the middle of the shadow. `s` is the
// part's height, `k` the shadow's strength, `lift` 1 standing and 0
// pressed flat, `pool` the caustic's colour and `pk` its strength.
let lq_cast = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, s: float, k: float, lift: float, ink: vec3, pool: vec3, pk: float) -> vec4 {
    let d = Material.sd_box(p, c, h, r)
    let out = 1.0 - Finish.cover(d, px)
    // One soft cool shadow: at a 26 point part it lies half a point right
    // and three and a half down with a five point blur, so it
    // is gone by half the part's height below it. Its box is drawn in a little at the sides,
    // so it does not reach a neighbour standing a gap away.
    let oy = mix(0.05, 0.135, lift) * s
    let sg = max(mix(0.08, 0.19, lift) * s, 0.6)
    let hs = max(h - vec2(0.09 * s, 0.0), vec2(0.5, 0.5))
    let rs = min(r, min(hs.x, hs.y))
    let sh = Finish.drop(p, c + vec2(0.02 * s, 0.0), hs, rs, vec2(0.0, oy), sg) * k * 0.5 * mix(0.6, 1.0, lift)
    var acc = vec4(ink * sh, sh)
    // The contact line: one device pixel of black under the foot, where
    // the glass meets the ground (about -0.19 against the bare ground).
    let n = lq_norm(p, c, h, r)
    let ct = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.3, 0.9, n.y) * 0.15 * min(k * 5.0, 1.0)
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, ct))
    // The caustic: light that came through the glass, pooled in the middle
    // of the shadow, an ellipse 0.45 of the width and 0.3 of the height.
    let pc = vec2(c.x, c.y + h.y + 0.16 * s)
    let e = (p - pc) / vec2(max(0.45 * h.x, 2.0), max(0.15 * s, 1.0))
    let pa = exp(-dot(e, e)) * pk
    acc = Finish.over(acc, vec4(pool * pa, pa))
    return acc * out
}

// The focus mark: a solid accent ring two device pixels wide, a point and
// a half outside the edge. Not a glow.
let lq_focus = fn(d: float, px: float, f: float) -> vec4 {
    let a = Finish.ring_out(d, 1.5, 1.5 + 2.0 * px, px) * 0.55 * f
    return vec4(lq_accent() * a, a)
}

// A well cut into the ground: seven hundredths down, a dark line along its
// top inside edge and a soft shade under it, a white lip along its bottom
// outside edge. Premultiplied.
let lq_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, col: vec3, k: float) -> vec4 {
    let d = Material.sd_box(p, c, h, r)
    let n = lq_norm(p, c, h, r)
    let top = smoothstep(0.1, 0.8, -n.y)
    let low = smoothstep(0.1, 0.8, n.y)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 0.9), 1.1)
    // No face: a breath of shade over the glass (and of white where `col`
    // is lifted by the pointer), the shade falling in under its top edge
    // and the dark line along it.
    let veil = clamp((col.y - 0.749) * 2.0, 0.0, 0.2) * k
    var acc = vec4(0.0, 0.0, 0.0, 0.07 * k)
    acc = Finish.over(acc, vec4(veil, veil, veil, veil))
    let sh = ins * 0.28 * k
    acc = Finish.over(acc, vec4(vec3(0.165, 0.192, 0.251) * sh, sh))
    let ln = Finish.band(d, 0.0, px, px) * top * 0.6 * k
    acc = Finish.over(acc, vec4(vec3(0.427, 0.443, 0.478) * ln, ln))
    acc = acc * Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px, px) * low * 0.8 * k
    return Finish.over(acc, vec4(lip, lip, lip, lip))
}

// A clear lens of radius kr at kc, over what is already drawn in `acc`:
// its shadows, a body that lifts what lies under it, a warm and a cool
// fringe just inside the rim, and the rim itself, bright toward the light.
// `tint` colours the glass.
// `under` is what lies under the lens seen through it: the caller draws its
// track a second time about the lens centre scaled down by 1.12, so the
// track's lines run on through the glass, magnified.
let lq_mag = fn(p: vec2, kc: vec2, m: float) -> vec2 {
    return kc + (p - kc) / m
}
let lq_lens = fn(acc: vec4, under: vec4, p: vec2, kc: vec2, r0: float, px: float, k: float, hover: float, down: float, tint: vec4) -> vec4 {
    // Held, the lens swells a point, as a drop of glass pressed flat. The
    // radius is a whole number of device pixels, so the rim lines land on
    // pixel rows where the centre does.
    let kr = floor((r0 + down) / px + 0.5) * px
    let dd = 2.0 * kr
    let kd = length(p - kc) - kr
    let a = Finish.cover(kd, px)
    let out = 1.0 - a
    let en = mix(0.5, 1.0, min(k, 1.0))
    let ink = vec3(0.165, 0.192, 0.251)
    let cs = Finish.drop(p, kc + vec2(0.02 * dd, 0.0), vec2(kr, kr) * 0.9, kr * 0.9, vec2(0.0, mix(0.10, 0.03, down) * dd), max(mix(0.12, 0.06, down) * dd, 0.6)) * mix(0.2, 0.12, down) * (1.0 + 0.3 * hover) * k * out
    var o = Finish.over(acc, vec4(ink * cs, cs))
    let ct = Finish.ring_out(kd, 0.0, px, px) * smoothstep(0.2, 0.8, (p.y - kc.y) / kr) * 0.2 * k
    o = Finish.over(o, vec4(0.0, 0.0, 0.0, ct))
    // Inside the rim the eye sees what lies under the glass, magnified.
    o = o * out + under * a
    let q = p - kc
    let n = q / max(length(q), 0.0001)
    let v = clamp(q.y / kr * 0.5 + 0.5, 0.0, 1.0)
    // The body: clear glass at a third, lighter toward the top, so what is
    // under it keeps about half its contrast and lifts a little.
    var col = mix(vec3(0.985, 0.990, 1.0), vec3(0.900, 0.910, 0.930), v)
    col = col + vec3(0.03, 0.03, 0.03) * hover - vec3(0.08, 0.08, 0.075) * down
    col = mix(col, tint.rgb, tint.a)
    let ba = a * (0.35 + 0.12 * hover + 0.1 * down) * en
    o = Finish.over(o, vec4(col * ba, ba))
    // The fringe: two device pixels a tenth of the lens in from the rim,
    // warm on the lower left, cool on the upper right, faint.
    let fr = Finish.band(kd, 0.1 * dd - px, 0.1 * dd + px, px) * 0.25 * en
    let w = dot(n, vec2(-0.707, 0.707))
    let fw = fr * max(w, 0.0)
    let fc = fr * max(-w, 0.0)
    o = Finish.over(o, vec4(vec3(0.769, 0.647, 0.549) * fw, fw))
    o = Finish.over(o, vec4(vec3(0.549, 0.659, 0.769) * fc, fc))
    // The rim: a bright hairline all round, strongest toward the light, a
    // dark pixel just inside the lower right arc, and the outline.
    let lit = dot(n, vec2(-0.259, -0.966)) * 0.5 + 0.5
    let hla = Finish.band(kd, px, 2.0 * px, px) * mix(0.55, 1.0, lit) * mix(0.9, 1.0, hover) * en
    o = Finish.over(o, vec4(vec3(0.975, 0.980, 0.992) * hla, hla))
    let dka = Finish.band(kd, 2.0 * px, 3.0 * px, px) * clamp(dot(n, vec2(0.5, 0.866)), 0.0, 1.0) * 0.35 * en
    o = Finish.over(o, vec4(ink * dka, dka))
    let ola = Finish.band(kd, 0.0, px, px) * 0.85 * en
    return Finish.over(o, vec4(vec3(0.604, 0.616, 0.651) * ola, ola))
}

// BUTTONS. `stand` 1 is glass standing off the ground with its shadow and
// caustic, 0 glass lying on it (the pointer lifts it); `frame` draws the
// rim alone; `hollow` shows nothing until the pointer asks. `tint` is the
// glass colour and how much of it. Pressed, the glass settles: the shadow
// draws in and pales, the pool nearly goes, the hairline dims.
let lq_button = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, ink: vec4, tint: vec4, stand: float, frame: float, hollow: float) -> vec4 {
    let b = lq_snap(org, vec2(0.0, 0.0), size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let s = min(size.y, 32.0)
    let r = min(h.x, h.y)
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let press = down * en
    let hov = hover * en * (1.0 - press)
    let up = max(stand, hov * 0.8) * (1.0 - hollow * (1.0 - hov))
    let vis = mix(1.0, max(hov, press), hollow)
    let dis = mix(1.0, 0.3, disabled)
    let shade = mix(vec3(0.165, 0.192, 0.251), vec3(0.204, 0.282, 0.431), tint.a)
    let pool = mix(vec3(1.0, 1.0, 1.0), vec3(0.663, 0.769, 0.949), step(0.01, tint.a) * step(0.5, tint.b - tint.r))
    let pk = mix(mix(0.36, 0.5, hov), 0.14, press) * mix(1.0, 1.25, tint.a) * up * en
    var acc = lq_cast(pq, c, h, r, px, s, 0.46 * up * dis, 1.0 - press, shade, pool, pk)
    let lift = 0.03 * hov - 0.04 * press
    let alpha = mix(0.88, 0.0, frame * (1.0 - hov * 0.6)) * mix(1.0, 0.55, disabled)
    let hl = mix(0.95, 1.0, hov) * mix(1.0, 0.62, press) * mix(1.0, 0.5, disabled)
    let fo = mix(0.06, 0.085, hov) * s + px
    let hi = mix(vec3(0.965, 0.973, 0.988), vec3(0.957, 0.969, 1.0), tint.a)
    let rim = vec4(mix(vec3(0.682, 0.690, 0.714), vec3(0.478, 0.561, 0.690), tint.a * 0.6), mix(0.9, 0.5, disabled))
    let body = lq_glass_body(pq, c, h, r, px, s, tint.rgb, tint.a, lift, mix(1.0, 2.2, tint.a), alpha, hl, mix(1.0, 1.5, press), fo, 1.5, rim, hi)
    acc = Finish.over(acc, body * vis)
    acc = Finish.over(acc, lq_focus(d, px, focus * en))
    // The wait spinner is drawn by the face, so a face that replaces the
    // stock one draws it again: a 270 degree arc in the label's ink.
    let rr = max(min(h.x, h.y) - 5.0, 2.0)
    let q = pq - c
    let a0 = anim * 2.0 * PI
    var ap = atan2(q.x, -q.y) - a0
    ap = ap - floor(ap / (2.0 * PI)) * 2.0 * PI
    let arc = step(ap, 1.5 * PI) * Finish.cover(abs(length(q) - rr) - 0.75, px) * loading
    return Finish.over(acc, vec4(ink.rgb * arc * ink.a, arc * ink.a))
}

// THE GLASS PILL. The buttons are clear glass pills as his references
// draw them on a light ground: a slab with a rounded rim lying a little
// above the ground, lit from above a little from the left.
// Distances are taken at the button's height `s`.
// - The edge: no dark outline; a bright line on the edge's inner pixel,
//   strongest where the rim is lit (0.85), with the crescents and the
//   shadow under the slab, draws it.
// - The rim band, 0.11 of the height along the sides, swelling to twice
//   that in two crescents: the upper left end, where the edge faces the
//   light, and the lower right, where the light leaves the slab. The
//   ground seen through it is lifted toward white (0.10, 0.65 more in the
//   crescents, 0.22 more along the foot, where the light leaves).
// - The face: clear glass, no base of its own (on his word, 'no grey base
//   or bg for any glass ui element at all'): the pane shows through it, a
//   soft glow along the rim (0.14) and a breath of white under the pointer;
//   it lets the shadow under it through at half.
// - The light: a specular band in the upper crescent running on thinly
//   along the top (0.80), a hot glint where the crescent turns (1.0), and a
//   softer band in the lower crescent (0.45).
// - Under it: a faint contact shadow (on his word, 'the buttons should
//   cast a lot less shadow': a third of what it was, 0.10, its offset and
//   spread a third, widening a third as much under the pointer), and the
//   light that came through the glass pooled under its lower right (0.12).
// Coloured glass (`tint` past a half) is the colour itself, translucent
// (the blue at 0.82, the red at 0.84: the pane faintly through it, deep
// enough that its white label reads over 4.5:1), a little lighter toward
// its top, with the same rim and light; it is thick, so a
// soft inner shadow in a deeper shade of its colour lies along its top
// inner edge (2.9 points deep at a 26 point button, blurred 2.1) and a
// little round its sides, fading toward the middle, under the rim's light;
// its shadow and pool take the colour, and its label is white. `look`: .x 1 for a body,
// 0 for the rim alone (the outline); .y 1 standing off the ground, 0
// lying on it (the flat button, lifted by the pointer); .z 1 shows
// nothing until the pointer asks (the flatter button). Under the pointer
// the glass lifts: the light on it brightens and the shadow widens.
//
// The press: held, the slab settles toward the ground (the shadow draws
// in, the light on it dims); let go, it lifts back a little past rest. On
// the standing buttons (`timed` 1) this is the lens button's press, timed
// by the animator (below), half again as slow: held, the glass settles
// over 1.17 seconds behind a ring that crosses it in 1.32 and fades over
// 1.6, its light gone gently over the last of that; let go, it springs
// back from as far as it got behind a second ring 0.9 as strong. The lit
// crest is 0.15 of the reach wide.
// `down` is 1 held and falls to 0 over 1.6 seconds when let go (the
// release's clock); `clock` (cap_time) runs 0 to 1 over 1.6 seconds while
// held and falls with `down`, so `clock / down` is how far the press got.
// A face held from the start (a states page) has the clock without
// `down` and is drawn settled with no ring. The ring is lit as a ridge of
// water: its crest and the flank facing the light lifted toward white, the
// far flank shaded a little, its colour split warm ahead and cool behind.
let lq_pill = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, clock: float, timed: float, focus: float, disabled: float, loading: float, anim: float, ink: vec4, tint: vec4, look: vec4) -> vec4 {
    let b = lq_snap(org, vec2(0.0, 0.0), size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let r = min(h.x, h.y)
    let s = 2.0 * h.y
    let k = min(size.x, size.y) / 44.0
    let d = Material.sd_box(pq, c, h, r)
    let n = lq_norm(pq, c, h, r)
    let t = max(-d, 0.0)
    let en = 1.0 - disabled
    let hov = hover * en
    // The press: timed (held, let go, or held from the start), or plain.
    let held = step(0.999, down)
    let still = step(down + 0.001, clock) * timed
    let going = (1.0 - held) * (1.0 - still) * step(0.0005, down) * timed
    let tp = clamp(clock * 1.6 / 1.17, 0.0, 1.0)
    let fp = tp * tp * (3.0 - 2.0 * tp)
    let tr = clamp(clock / max(down, 0.001) * 1.6 / 1.17, 0.0, 1.0)
    let fr = tr * tr * (3.0 - 2.0 * tr)
    let age = mix(mix(1000.0, (1.0 - down) * 1.6, going), clock * 1.6, held * timed)
    let press = mix(down, max(fp * held, still), timed) * en
    let restore = fr * going * en
    let strength = clamp(1.0 - age / 1.6, 0.0, 1.0) * mix(0.9, 1.0 - 0.1 * fp, held) * en
    let lp = (pq - c) / (h + vec2(19.4 * k, 19.4 * k))
    let dist = length(lp)
    let wt = clamp(age / 1.32, 0.0, 1.0)
    let centre = 1.25 * wt * wt * (3.0 - 2.0 * wt)
    let delta = dist - centre
    let life = clamp(1.0 - age / 1.6, 0.0, 1.0)
    let wfl = mix(1.0, smoothstep(dist - 0.14, dist + 0.26, centre), timed)
    let flat = clamp(press * wfl + restore * (1.0 - wfl), 0.0, 1.0)
    let lift = restore * wfl * (1.0 - wt) * 0.45
    // How the glass stands: hollow faces show only under the pointer or the
    // finger, a face lying on the ground rises under the pointer.
    let vis = mix(1.0, max(hov, press), look.z)
    let stand = max(look.y, hov * 0.6) * en
    let e = stand * (1.0 - 0.7 * flat + 0.6 * lift) + 0.15 * hov * look.y * en
    let col_glass = step(0.5, tint.a)
    // Under the glass: the shadow, and the pool of light in it.
    let oy = (0.03 + 0.08 * e) * s
    let sg = (0.05 + 0.05 * e) * s
    let hs = vec2(max(h.x - 0.06 * s, 1.0), h.y)
    let quad = smoothstep(0.0, 3.0, 20.0 - max(abs(pq.x - c.x) - h.x, abs(pq.y - c.y) - h.y))
    let inside = Finish.cover(d, px)
    let sh = Finish.drop(pq, c, hs, min(r, min(hs.x, hs.y)), vec2(0.0, oy), sg) * 0.10 * e * quad * mix(1.0, 0.5, inside) * look.x
    let sink = mix(vec3(0.150, 0.170, 0.230), tint.rgb * 0.55, col_glass * 0.6)
    var acc = vec4(sink * sh, sh)
    let pc = vec2(c.x + 0.45 * h.x, c.y + h.y + 0.04 * s)
    let pe = (pq - pc) / vec2(max(0.32 * h.x, 2.0), max(0.05 * s, 1.0))
    let pa = exp(-dot(pe, pe)) * 0.12 * e * (1.0 - inside) * quad * look.x
    let pool = mix(vec3(1.0, 0.975, 0.940), mix(tint.rgb, vec3(1.0, 1.0, 1.0), 0.35), col_glass)
    acc = Finish.over(acc, vec4(pool * pa, pa))
    // The face.
    let w = clamp(0.11 * s, 2.0, 5.0)
    // The two crescents where the rim is lit: the upper left end, where its
    // edge faces the light, and the lower right, where the light leaves.
    let L = normalize(vec2(-0.85, -0.53))
    let cres_a = pow(max(dot(n, L), 0.0), 3.0)
    let cres_b = pow(max(dot(n, -L), 0.0), 3.0) * 0.8
    let cres = max(cres_a, cres_b)
    let vy = clamp((pq.y - c.y) / max(h.y, 1.0) * 0.5 + 0.5, 0.0, 1.0)
    let glow = exp(-t / max(0.14 * s, 0.5))
    let lit = (1.0 + 0.15 * hov) * (1.0 - 0.3 * flat + 0.3 * lift)
    // Clear glass: no base, the soft glow along its rim and a breath of
    // white under the pointer; coloured glass: the colour, a little lighter
    // toward its top and along the rim.
    let veil = 0.03 * hov * look.x + 0.14 * glow * lit * look.x
    var body = vec4(veil, veil, veil, veil)
    let ct = mix(tint.rgb, vec3(1.0, 1.0, 1.0), 0.08 * (1.0 - vy) + 0.10 * glow) * (1.0 - 0.08 * flat)
    let ca = tint.a * look.x
    let cbody = vec4(ct * ca, ca)
    body = mix(body, Finish.over(cbody, body * 0.25), step(0.001, tint.a))
    // Thick coloured glass: its inner shadow, in a deeper shade of the
    // colour, along the top inner edge and a little round the sides; it
    // leaves the edge's first two device pixels to the rim's light, so it
    // draws no dark outline.
    let ist = Finish.inset(pq, c, h, r, vec2(0.0, 0.11 * s), 0.08 * s)
    let iss = Finish.inset(pq, c, h, r, vec2(0.0, 0.0), 0.05 * s)
    let isa = clamp(ist * 0.75 + iss * 0.30, 0.0, 1.0) * smoothstep(0.0, 2.0 * px, t) * col_glass * look.x * (1.0 - 0.3 * flat)
    body = Finish.over(body, vec4(tint.rgb * 0.40 * isa, isa))
    // The rim band: thin along the sides, swelling into the crescents, the
    // ground seen through it lifted toward white.
    let wr = w * (0.55 + 1.1 * cres)
    let u = clamp(1.0 - t / wr, 0.0, 1.0)
    let foot = smoothstep(0.3, 0.95, n.y)
    let ra = smoothstep(0.0, 0.7, u) * (0.10 + 0.65 * cres + 0.22 * foot) * lit
    body = Finish.over(body, vec4(ra, ra, ra, ra))
    // The specular glint in the upper crescent, running on thinly along the
    // top, and a softer one in the lower.
    let ls = normalize(vec2(-0.75, -0.66))
    let gd = 0.75 * w
    let band = exp(-((t - gd) * (t - gd)) / max(0.18 * w * w, 0.01))
    let xf = clamp((pq.x - c.x + h.x) / max(2.0 * h.x, 1.0), 0.0, 1.0)
    let top = pow(max(-n.y, 0.0), 4.0) * (1.0 - 0.8 * xf) * 0.35
    let spa = band * (pow(max(dot(n, ls), 0.0), 8.0) + top) * 0.80 * lit
    let spb = band * pow(max(dot(n, -ls), 0.0), 8.0) * 0.45 * lit
    // The glint: a small hot spot where the upper crescent turns.
    let gl = exp(-((t - 0.6 * w) * (t - 0.6 * w)) / max(0.10 * w * w, 0.01)) * pow(max(dot(n, normalize(vec2(-0.55, -0.83))), 0.0), 16.0) * 1.0 * lit
    let sp = clamp(spa + spb + gl, 0.0, 1.0)
    body = Finish.over(body, vec4(sp, sp, sp, sp))
    // The ring of the press, lit on the glass.
    let crest = exp(-(delta * delta) / (0.15 * 0.15)) * life * life * strength * smoothstep(0.0, 0.10, age) * (1.0 - smoothstep(1.16, 1.44, dist)) * timed
    let flank = (-delta / 0.15) * crest
    let rdir = (pq - c) / max(length(pq - c), 0.001)
    let tilt = dot(rdir, vec2(-0.26, -0.97)) * flank
    let rwa = clamp(crest * 0.7 + max(tilt, 0.0) * 0.7, 0.0, 1.0)
    body = Finish.over(body, vec4(rwa, rwa, rwa, rwa))
    let rsa = clamp(-tilt * 0.4, 0.0, 1.0)
    body = Finish.over(body, vec4(vec3(0.200, 0.235, 0.310) * rsa, rsa))
    let split = clamp(-flank * 0.10, -0.12, 0.12)
    body = body + vec4(0.9 * split, 0.1 * split, -0.9 * split, 0.0) * step(0.001, crest)
    // Out of use: a pane laid on the ground, a faint edge, no light on it.
    body = mix(body, vec4(0.03, 0.03, 0.03, 0.03), disabled)
    body = body * inside
    // The edge: a bright line on its inner pixel, no dark outline; out of
    // use, the pane's faint edge.
    let el = Finish.band(d, px, 2.0 * px, px) * 0.85 * (0.55 + (1.0 - 0.55) * cres) * lit * en
    body = Finish.over(body, vec4(el, el, el, el))
    let ed = Finish.band(d, 0.0, px, px) * 0.30 * disabled
    body = Finish.over(body, vec4(vec3(0.420, 0.435, 0.475) * ed, ed))
    acc = Finish.over(acc, body)
    acc = acc * vis
    acc = Finish.over(acc, lq_focus(d, px, focus * en))
    let rr = max(r - 5.0, 2.0)
    let q = pq - c
    var ap = atan2(q.x, -q.y) - anim * 2.0 * PI
    ap = ap - floor(ap / (2.0 * PI)) * 2.0 * PI
    let arc = step(ap, 1.5 * PI) * Finish.cover(abs(length(q) - rr) - 0.75, px) * loading
    return Finish.over(acc, vec4(ink.rgb * arc * ink.a, arc * ink.a))
}

// The room round every button for its shadow, its pool and its ring.
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
// A view lets what it holds draw past its edge; scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// The flat button: a pill lying on the ground, lifted by the pointer.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(lq_pill(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.cap_time, 0.0, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, vec4(0.0, 0.0, 0.0, 0.0), vec4(1.0, 0.0, 0.0, 0.0)), m)
}
// The standard, sized and compound buttons are clear pills standing off the
// ground (THE GLASS PILL).
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = 20.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return self.host_over(lq_pill(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.cap_time, 1.0, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, vec4(0.0, 0.0, 0.0, 0.0), vec4(1.0, 1.0, 0.0, 0.0)), m)
}
