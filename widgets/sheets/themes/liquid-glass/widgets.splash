// THE GROUND, on his word ('take the blobgenerator ... and use different
// seeds to generate a new picture every time as background image for liquid
// glass'): soft coloured blobs on a white backdrop, in his "blobs"
// settings, laid out anew from a seed each time the sheet is applied (at
// start and at every switch to it; the same seed is the same picture). `mod.blobs.compose` (the sheets crate's port of the composer)
// lays the balls out; the ground's shader reads them as uniforms, no texture:
// per depth layer, back to front, the soft shadow the layer throws on what is
// behind it, then the layer itself, a metaball surface shaded matte as a
// sphere, a cool shade on its dark side and the backdrop's light bounced into
// its rim, a soft glow inside its edge, faded toward the backdrop with depth;
// then a still grain. A layer is skipped wherever it cannot reach (a box round
// its balls), so most of the window reads a few balls, not sixteen. The
// composition is made for 16:9 and stretched to the window as the composer
// stretches it (places with the width, sizes with the root of the aspect).
let lq_blobs = mod.blobs.compose(mod.std.random_u32())

// OKLab to sRGB.
let lq_blob_srgb = fn(c: vec3) -> vec3 {
    let l = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z
    let m = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z
    let s = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z
    let l3 = l * l * l
    let m3 = m * m * m
    let s3 = s * s * s
    let lin = vec3(4.0767416621 * l3 - 3.3077115913 * m3 + 0.2309699292 * s3, -1.2684380046 * l3 + 2.6097574011 * m3 - 0.3413193965 * s3, -0.0041960863 * l3 - 0.7034186147 * m3 + 1.7076147010 * s3)
    return pow(max(lin, vec3(0.0, 0.0, 0.0)), vec3(0.4545454, 0.4545454, 0.4545454))
}

// The white backdrop: a soft fall from the upper left, darkening a touch
// toward the corners.
let lq_blob_bg = fn(uv: vec2, top: vec3, bottom: vec3) -> vec3 {
    let c = mix(bottom, top, smoothstep(-0.7, 0.7, uv.y - uv.x * 0.25))
    return c * (1.0 - 0.05 * dot(uv, uv))
}

// One ball's share of the field at `p` (and its gradient): `bp` the ball
// (place and radius, for the design frame), `sx` the stretch of its place to
// the window, `kr` of its radius, `k2` the reach squared. Round alone, liquid
// beside its neighbours.
let lq_blob_f = fn(p: vec2, bp: vec4, sx: float, kr: float, k2: float) -> vec3 {
    let d = p - vec2(bp.x * sx, bp.y)
    let r = bp.z * kr
    let r2 = max(k2 * r * r, 0.0000001)
    let q = max(1.0 - dot(d, d) / r2, 0.0) * step(0.0001, r)
    let q2 = q * q
    let gs = 6.0 * q2 / r2
    return vec3(q2 * q, 0.0 - d.x * gs, 0.0 - d.y * gs)
}

// The same ball's colour, weighted toward the nearest ball: its two OKLab
// colours along its gradient (`ba.w`, `bb.w` the gradient's direction) times
// the weight, and the weight.
let lq_blob_c = fn(p: vec2, bp: vec4, ba: vec4, bb: vec4, sx: float, kr: float, k2: float) -> vec4 {
    let d = p - vec2(bp.x * sx, bp.y)
    let r = bp.z * kr
    let r2 = max(k2 * r * r, 0.0000001)
    let q = max(1.0 - dot(d, d) / r2, 0.0) * step(0.0001, r)
    let v = q * q * q
    let wt = v * v * v * v
    let t = dot(d / max(r, 0.0001), vec2(ba.w, bb.w)) * 0.5 + 0.5
    return vec4(mix(ba.xyz, bb.xyz, smoothstep(0.0, 1.0, t)) * wt, wt)
}

// The same weight times the ball's radius, for the local radius.
let lq_blob_rw = fn(p: vec2, bp: vec4, sx: float, kr: float, k2: float) -> float {
    let d = p - vec2(bp.x * sx, bp.y)
    let r = bp.z * kr
    let r2 = max(k2 * r * r, 0.0000001)
    let q = max(1.0 - dot(d, d) / r2, 0.0) * step(0.0001, r)
    let v = q * q * q
    return v * v * v * v * r
}

// 1 where a layer can reach `p`: inside the box round its balls' centres
// (`bd`: x min, x max, y min, y max), grown by its largest ball's reach and
// its shadow's throw.
let lq_blob_near = fn(p: vec2, bd: vec4, reach: float, throw: float, sx: float, kr: float) -> float {
    let m = reach * kr + 0.035 * throw * kr + 0.01
    let inx = step(bd.x * sx - m, p.x) * step(p.x, bd.y * sx + m)
    let iny = step(bd.z - m, p.y) * step(p.y, bd.w + m)
    return inx * iny * step(0.00001, reach)
}

// The surface's colour: matte, lit from the upper left, its dark side
// leaning cool and violet, the backdrop's light bounced into its rim; the
// hue turned a little by a slow swirl.
let lq_blob_shade = fn(lab_in: vec3, n: vec3, uv: vec2, cs: float, swirl: float, seed_s: float) -> vec3 {
    let p = uv / cs
    let sw = swirl * 0.85 * (sin(p.x * 3.7 + 1.4 * sin(p.y * 2.9) + seed_s) + sin(p.y * 5.3 - p.x * 2.1 + seed_s * 1.7))
    let ca = cos(sw)
    let sa = sin(sw)
    let lab = vec3(lab_in.x, ca * lab_in.y - sa * lab_in.z, sa * lab_in.y + ca * lab_in.z)
    let dif = clamp(dot(n, vec3(-0.4975, 0.6169, 0.6965)) * 0.5 + 0.5, 0.0, 1.0)
    let lit = vec3(min(1.0, lab.x + 0.08), lab.y, lab.z)
    let chroma = length(lab.yz)
    let dyz = mix(lab.yz, vec2(0.45, -0.89) * max(chroma, 0.06), 0.32)
    let drk = vec3(lab.x - 0.16, dyz.x, dyz.y)
    let c = mix(drk, lit, smoothstep(0.05, 0.95, dif))
    let fres = pow(1.0 - clamp(n.z, 0.0, 1.0), 2.5)
    let bounce = fres * clamp(dot(n.xy, vec2(0.55, -0.83)) * 0.5 + 0.5, 0.0, 1.0)
    let cl = mix(c.x, 0.97, bounce * 0.35)
    let cab = c.yz * (1.0 - bounce * 0.35)
    return lq_blob_srgb(vec3(cl, cab.x, cab.y))
}

// One layer laid over what is behind it: `fs` its field where its shadow is
// thrown from, `fc` its field here, `ac` its weighted colour and `rw` its
// weighted radius; `la` blur, fade, shadow strength, shadow distance; `lb`
// the shadow's tint.
let lq_blob_layer = fn(col: vec3, bg: vec3, uv: vec2, aa: float, iso: float, fs: vec3, fc: vec3, ac: vec4, rw: float, la: vec4, lb: vec4, kr: float, cs: float, swirl: float, seed_s: float, refl: vec4) -> vec3 {
    let sds = (fs.x - iso) / max(length(fs.yz), 0.0001)
    let sb = 0.05 * la.w * kr + la.x
    let sa = smoothstep(0.0 - sb, sb * 0.4, sds) * la.z
    let under = col * mix(vec3(1.0, 1.0, 1.0), lb.xyz, sa)
    if fc.x < 0.0000001 {
        return under
    }
    let inv = 1.0 / max(ac.w, 0.0000000001)
    let lab = ac.xyz * inv
    let rb = max(rw * inv, 0.0001)
    let gn = max(length(fc.yz), 0.00001)
    let gd = fc.yz / gn
    let sd = (fc.x - iso) / gn
    let a = smoothstep(0.0 - la.x - aa, la.x + aa, sd)
    let dc = clamp(rb - sd * 0.85, 0.0, rb)
    let n = normalize(vec3(0.0 - gd.x * dc, 0.0 - gd.y * dc, sqrt(max(rb * rb - dc * dc, 0.0)) + 0.0001))
    var c = lq_blob_shade(lab, n, uv, cs, swirl, seed_s)
    // The glow: a Fresnel falloff inside the edge, brighter facing the light.
    let facing = dot(vec2(0.0 - gd.x, 0.0 - gd.y), vec2(-0.63, 0.78))
    let e = clamp(sd * 0.85 / (rb * (0.12 + refl.y * 3.0)), 0.0, 1.0)
    let glow = pow(1.0 - sqrt(e * (2.0 - e)), mix(7.0, 1.2, clamp(refl.z * 5.0, 0.0, 1.0))) * (0.7 + 0.3 * facing)
    let r = clamp(glow * refl.x, 0.0, 1.0)
    let gc = mix(vec3(0.97, 0.97, 0.97), lq_blob_srgb(vec3(0.93, lab.y * 1.4, lab.z * 1.4)), refl.w)
    c = vec3(1.0, 1.0, 1.0) - (vec3(1.0, 1.0, 1.0) - c) * (vec3(1.0, 1.0, 1.0) - gc * r)
    c = mix(c, bg, la.y)
    return mix(under, c, a)
}

// The composition's uniforms on a draw: the balls, the layers, the look.
let lq_blob_uniforms = fn(d) {
    d.blob_p0 = uniform(lq_blobs.p0)
    d.blob_a0 = uniform(lq_blobs.a0)
    d.blob_b0 = uniform(lq_blobs.b0)
    d.blob_p1 = uniform(lq_blobs.p1)
    d.blob_a1 = uniform(lq_blobs.a1)
    d.blob_b1 = uniform(lq_blobs.b1)
    d.blob_p2 = uniform(lq_blobs.p2)
    d.blob_a2 = uniform(lq_blobs.a2)
    d.blob_b2 = uniform(lq_blobs.b2)
    d.blob_p3 = uniform(lq_blobs.p3)
    d.blob_a3 = uniform(lq_blobs.a3)
    d.blob_b3 = uniform(lq_blobs.b3)
    d.blob_p4 = uniform(lq_blobs.p4)
    d.blob_a4 = uniform(lq_blobs.a4)
    d.blob_b4 = uniform(lq_blobs.b4)
    d.blob_p5 = uniform(lq_blobs.p5)
    d.blob_a5 = uniform(lq_blobs.a5)
    d.blob_b5 = uniform(lq_blobs.b5)
    d.blob_p6 = uniform(lq_blobs.p6)
    d.blob_a6 = uniform(lq_blobs.a6)
    d.blob_b6 = uniform(lq_blobs.b6)
    d.blob_p7 = uniform(lq_blobs.p7)
    d.blob_a7 = uniform(lq_blobs.a7)
    d.blob_b7 = uniform(lq_blobs.b7)
    d.blob_p8 = uniform(lq_blobs.p8)
    d.blob_a8 = uniform(lq_blobs.a8)
    d.blob_b8 = uniform(lq_blobs.b8)
    d.blob_p9 = uniform(lq_blobs.p9)
    d.blob_a9 = uniform(lq_blobs.a9)
    d.blob_b9 = uniform(lq_blobs.b9)
    d.blob_p10 = uniform(lq_blobs.p10)
    d.blob_a10 = uniform(lq_blobs.a10)
    d.blob_b10 = uniform(lq_blobs.b10)
    d.blob_p11 = uniform(lq_blobs.p11)
    d.blob_a11 = uniform(lq_blobs.a11)
    d.blob_b11 = uniform(lq_blobs.b11)
    d.blob_p12 = uniform(lq_blobs.p12)
    d.blob_a12 = uniform(lq_blobs.a12)
    d.blob_b12 = uniform(lq_blobs.b12)
    d.blob_p13 = uniform(lq_blobs.p13)
    d.blob_a13 = uniform(lq_blobs.a13)
    d.blob_b13 = uniform(lq_blobs.b13)
    d.blob_p14 = uniform(lq_blobs.p14)
    d.blob_a14 = uniform(lq_blobs.a14)
    d.blob_b14 = uniform(lq_blobs.b14)
    d.blob_p15 = uniform(lq_blobs.p15)
    d.blob_a15 = uniform(lq_blobs.a15)
    d.blob_b15 = uniform(lq_blobs.b15)
    d.blob_la0 = uniform(lq_blobs.la0)
    d.blob_lb0 = uniform(lq_blobs.lb0)
    d.blob_bd0 = uniform(lq_blobs.bd0)
    d.blob_la1 = uniform(lq_blobs.la1)
    d.blob_lb1 = uniform(lq_blobs.lb1)
    d.blob_bd1 = uniform(lq_blobs.bd1)
    d.blob_la2 = uniform(lq_blobs.la2)
    d.blob_lb2 = uniform(lq_blobs.lb2)
    d.blob_bd2 = uniform(lq_blobs.bd2)
    d.blob_la3 = uniform(lq_blobs.la3)
    d.blob_lb3 = uniform(lq_blobs.lb3)
    d.blob_bd3 = uniform(lq_blobs.bd3)
    d.blob_la4 = uniform(lq_blobs.la4)
    d.blob_lb4 = uniform(lq_blobs.lb4)
    d.blob_bd4 = uniform(lq_blobs.bd4)
    d.blob_glob = uniform(lq_blobs.glob)
    d.blob_look = uniform(lq_blobs.look)
    d.blob_refl = uniform(lq_blobs.refl)
    d.blob_bg_top = uniform(lq_blobs.bg_top)
    d.blob_bg_bottom = uniform(lq_blobs.bg_bottom)
}
// What a pane of glass needs of it: the balls' places and softened colours.
let lq_blob_soft_uniforms = fn(d) {
    d.blob_p0 = uniform(lq_blobs.p0)
    d.blob_s0 = uniform(lq_blobs.s0)
    d.blob_p1 = uniform(lq_blobs.p1)
    d.blob_s1 = uniform(lq_blobs.s1)
    d.blob_p2 = uniform(lq_blobs.p2)
    d.blob_s2 = uniform(lq_blobs.s2)
    d.blob_p3 = uniform(lq_blobs.p3)
    d.blob_s3 = uniform(lq_blobs.s3)
    d.blob_p4 = uniform(lq_blobs.p4)
    d.blob_s4 = uniform(lq_blobs.s4)
    d.blob_p5 = uniform(lq_blobs.p5)
    d.blob_s5 = uniform(lq_blobs.s5)
    d.blob_p6 = uniform(lq_blobs.p6)
    d.blob_s6 = uniform(lq_blobs.s6)
    d.blob_p7 = uniform(lq_blobs.p7)
    d.blob_s7 = uniform(lq_blobs.s7)
    d.blob_p8 = uniform(lq_blobs.p8)
    d.blob_s8 = uniform(lq_blobs.s8)
    d.blob_p9 = uniform(lq_blobs.p9)
    d.blob_s9 = uniform(lq_blobs.s9)
    d.blob_p10 = uniform(lq_blobs.p10)
    d.blob_s10 = uniform(lq_blobs.s10)
    d.blob_p11 = uniform(lq_blobs.p11)
    d.blob_s11 = uniform(lq_blobs.s11)
    d.blob_p12 = uniform(lq_blobs.p12)
    d.blob_s12 = uniform(lq_blobs.s12)
    d.blob_p13 = uniform(lq_blobs.p13)
    d.blob_s13 = uniform(lq_blobs.s13)
    d.blob_p14 = uniform(lq_blobs.p14)
    d.blob_s14 = uniform(lq_blobs.s14)
    d.blob_p15 = uniform(lq_blobs.p15)
    d.blob_s15 = uniform(lq_blobs.s15)
    d.blob_glob = uniform(lq_blobs.glob)
    d.blob_bg_top = uniform(lq_blobs.bg_top)
    d.blob_bg_bottom = uniform(lq_blobs.bg_bottom)
}

mod.widgets.Window.show_bg = true
lq_blob_uniforms(mod.widgets.Window.draw_bg)
mod.widgets.Window.draw_bg.pixel = fn() {
    let size = max(self.rect_size, vec2(1.0, 1.0))
    let pq = self.pos * size
    let uv = vec2(pq.x - 0.5 * size.x, 0.5 * size.y - pq.y) / size.y
    let asp = size.x / size.y
    let cs = clamp(sqrt(asp), 0.6, 1.6)
    let sx = asp / 1.7777778
    let kr = cs / 1.3333333
    let aa = 1.2 / size.y
    let iso = self.blob_glob.y
    let k2 = self.blob_glob.x * self.blob_glob.x
    let bg = lq_blob_bg(uv, self.blob_bg_top.xyz, self.blob_bg_bottom.xyz)
    var col = bg
    // the back layer's edge blobs
    if lq_blob_near(uv, self.blob_bd0, self.blob_lb0.w, self.blob_la0.w, sx, kr) > 0.5 {
        let so = uv - vec2(0.016, -0.028) * (self.blob_la0.w * kr)
        let fs = lq_blob_f(so, self.blob_p0, sx, kr, k2) + lq_blob_f(so, self.blob_p1, sx, kr, k2) + lq_blob_f(so, self.blob_p2, sx, kr, k2) + lq_blob_f(so, self.blob_p3, sx, kr, k2)
        let fc = lq_blob_f(uv, self.blob_p0, sx, kr, k2) + lq_blob_f(uv, self.blob_p1, sx, kr, k2) + lq_blob_f(uv, self.blob_p2, sx, kr, k2) + lq_blob_f(uv, self.blob_p3, sx, kr, k2)
        let ac = lq_blob_c(uv, self.blob_p0, self.blob_a0, self.blob_b0, sx, kr, k2) + lq_blob_c(uv, self.blob_p1, self.blob_a1, self.blob_b1, sx, kr, k2) + lq_blob_c(uv, self.blob_p2, self.blob_a2, self.blob_b2, sx, kr, k2) + lq_blob_c(uv, self.blob_p3, self.blob_a3, self.blob_b3, sx, kr, k2)
        let rw = lq_blob_rw(uv, self.blob_p0, sx, kr, k2) + lq_blob_rw(uv, self.blob_p1, sx, kr, k2) + lq_blob_rw(uv, self.blob_p2, sx, kr, k2) + lq_blob_rw(uv, self.blob_p3, sx, kr, k2)
        col = lq_blob_layer(col, bg, uv, aa, iso, fs, fc, ac, rw, self.blob_la0, self.blob_lb0, kr, cs, self.blob_glob.z, self.blob_look.x, self.blob_refl)
    }
    // the middle layer's edge blobs
    if lq_blob_near(uv, self.blob_bd1, self.blob_lb1.w, self.blob_la1.w, sx, kr) > 0.5 {
        let so = uv - vec2(0.016, -0.028) * (self.blob_la1.w * kr)
        let fs = lq_blob_f(so, self.blob_p4, sx, kr, k2) + lq_blob_f(so, self.blob_p5, sx, kr, k2)
        let fc = lq_blob_f(uv, self.blob_p4, sx, kr, k2) + lq_blob_f(uv, self.blob_p5, sx, kr, k2)
        let ac = lq_blob_c(uv, self.blob_p4, self.blob_a4, self.blob_b4, sx, kr, k2) + lq_blob_c(uv, self.blob_p5, self.blob_a5, self.blob_b5, sx, kr, k2)
        let rw = lq_blob_rw(uv, self.blob_p4, sx, kr, k2) + lq_blob_rw(uv, self.blob_p5, sx, kr, k2)
        col = lq_blob_layer(col, bg, uv, aa, iso, fs, fc, ac, rw, self.blob_la1, self.blob_lb1, kr, cs, self.blob_glob.z, self.blob_look.x, self.blob_refl)
    }
    // the second mass
    if lq_blob_near(uv, self.blob_bd2, self.blob_lb2.w, self.blob_la2.w, sx, kr) > 0.5 {
        let so = uv - vec2(0.016, -0.028) * (self.blob_la2.w * kr)
        let fs = lq_blob_f(so, self.blob_p6, sx, kr, k2) + lq_blob_f(so, self.blob_p7, sx, kr, k2) + lq_blob_f(so, self.blob_p8, sx, kr, k2)
        let fc = lq_blob_f(uv, self.blob_p6, sx, kr, k2) + lq_blob_f(uv, self.blob_p7, sx, kr, k2) + lq_blob_f(uv, self.blob_p8, sx, kr, k2)
        let ac = lq_blob_c(uv, self.blob_p6, self.blob_a6, self.blob_b6, sx, kr, k2) + lq_blob_c(uv, self.blob_p7, self.blob_a7, self.blob_b7, sx, kr, k2) + lq_blob_c(uv, self.blob_p8, self.blob_a8, self.blob_b8, sx, kr, k2)
        let rw = lq_blob_rw(uv, self.blob_p6, sx, kr, k2) + lq_blob_rw(uv, self.blob_p7, sx, kr, k2) + lq_blob_rw(uv, self.blob_p8, sx, kr, k2)
        col = lq_blob_layer(col, bg, uv, aa, iso, fs, fc, ac, rw, self.blob_la2, self.blob_lb2, kr, cs, self.blob_glob.z, self.blob_look.x, self.blob_refl)
    }
    // the first mass and the floating spheres
    if lq_blob_near(uv, self.blob_bd3, self.blob_lb3.w, self.blob_la3.w, sx, kr) > 0.5 {
        let so = uv - vec2(0.016, -0.028) * (self.blob_la3.w * kr)
        let fs = lq_blob_f(so, self.blob_p9, sx, kr, k2) + lq_blob_f(so, self.blob_p10, sx, kr, k2) + lq_blob_f(so, self.blob_p11, sx, kr, k2) + lq_blob_f(so, self.blob_p12, sx, kr, k2) + lq_blob_f(so, self.blob_p13, sx, kr, k2)
        let fc = lq_blob_f(uv, self.blob_p9, sx, kr, k2) + lq_blob_f(uv, self.blob_p10, sx, kr, k2) + lq_blob_f(uv, self.blob_p11, sx, kr, k2) + lq_blob_f(uv, self.blob_p12, sx, kr, k2) + lq_blob_f(uv, self.blob_p13, sx, kr, k2)
        let ac = lq_blob_c(uv, self.blob_p9, self.blob_a9, self.blob_b9, sx, kr, k2) + lq_blob_c(uv, self.blob_p10, self.blob_a10, self.blob_b10, sx, kr, k2) + lq_blob_c(uv, self.blob_p11, self.blob_a11, self.blob_b11, sx, kr, k2) + lq_blob_c(uv, self.blob_p12, self.blob_a12, self.blob_b12, sx, kr, k2) + lq_blob_c(uv, self.blob_p13, self.blob_a13, self.blob_b13, sx, kr, k2)
        let rw = lq_blob_rw(uv, self.blob_p9, sx, kr, k2) + lq_blob_rw(uv, self.blob_p10, sx, kr, k2) + lq_blob_rw(uv, self.blob_p11, sx, kr, k2) + lq_blob_rw(uv, self.blob_p12, sx, kr, k2) + lq_blob_rw(uv, self.blob_p13, sx, kr, k2)
        col = lq_blob_layer(col, bg, uv, aa, iso, fs, fc, ac, rw, self.blob_la3, self.blob_lb3, kr, cs, self.blob_glob.z, self.blob_look.x, self.blob_refl)
    }
    // the corner blobs in front
    if lq_blob_near(uv, self.blob_bd4, self.blob_lb4.w, self.blob_la4.w, sx, kr) > 0.5 {
        let so = uv - vec2(0.016, -0.028) * (self.blob_la4.w * kr)
        let fs = lq_blob_f(so, self.blob_p14, sx, kr, k2) + lq_blob_f(so, self.blob_p15, sx, kr, k2)
        let fc = lq_blob_f(uv, self.blob_p14, sx, kr, k2) + lq_blob_f(uv, self.blob_p15, sx, kr, k2)
        let ac = lq_blob_c(uv, self.blob_p14, self.blob_a14, self.blob_b14, sx, kr, k2) + lq_blob_c(uv, self.blob_p15, self.blob_a15, self.blob_b15, sx, kr, k2)
        let rw = lq_blob_rw(uv, self.blob_p14, sx, kr, k2) + lq_blob_rw(uv, self.blob_p15, sx, kr, k2)
        col = lq_blob_layer(col, bg, uv, aa, iso, fs, fc, ac, rw, self.blob_la4, self.blob_lb4, kr, cs, self.blob_glob.z, self.blob_look.x, self.blob_refl)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let gq = fract((self.rect_pos + pq) / px * vec2(0.1234, 0.4567))
    let gh = gq + vec2(dot(gq, gq + vec2(45.32, 45.32)), dot(gq, gq + vec2(45.32, 45.32)))
    let grain = fract(gh.x * gh.y) - 0.5
    col = col + vec3(grain, grain, grain) * self.blob_glob.w
    return vec4(clamp(col, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0)), 1.0)
}
mod.widgets.Window.pass.clear_color = #ececf1

// THE PANES, on his word ('the ui will be on transparent panels on top of
// the background just like frost glass, only the glass is not dark this
// time'): a panel is a pane of light glass. Through it the ground's colours
// show softly (the pools above, not a capture of the window: the pane stays
// in the window's body, so what is drawn on it is in the window's scene for
// the screens' water to bend), lightened without greying (lq_glass_tint)
// and lifted further only where it would still be too dark for the ink
// (lq_ink_floor); its edge bends the view
// outward over the last ten points; a soft white glow inside its edge; one
// device pixel of bright rim, whitest
// at the top left, a faint cool line outside it and a soft cool shadow under
// it so it holds its edge over the white backdrop; radius 12. Between the
// panes the ground shows sharp. An inset panel is the tray's lines alone,
// the glass showing through it.
//
// The glass keeps its colour and lightens it only as far as the ink needs: a
// colour below `floor` (relative luminance) is first brightened as it is,
// its hue kept, until a channel is full, and only the rest is milk. At 0.35
// the ink reads on the darkest glass as it did under the old thick milk.
let lq_ink_floor = fn(c: vec3, floor: float) -> vec3 {
    let lin = pow(max(c, vec3(0.0001, 0.0001, 0.0001)), vec3(2.2, 2.2, 2.2))
    let y = max(dot(lin, vec3(0.2126, 0.7152, 0.0722)), 0.0001)
    let k = clamp(floor / y, 1.0, 1.0 / max(max(lin.x, max(lin.y, lin.z)), 0.0001))
    let t = max(floor - y * k, 0.0) / max(1.0 - y * k, 0.0001)
    return pow(mix(lin * k, vec3(1.0, 1.0, 1.0), t), vec3(0.4545454, 0.4545454, 0.4545454))
}
// sRGB to OKLab (the inverse of lq_blob_srgb).
let lq_blob_oklab = fn(c: vec3) -> vec3 {
    let lin = pow(max(c, vec3(0.0, 0.0, 0.0)), vec3(2.2, 2.2, 2.2))
    let l = pow(max(0.4122214708 * lin.x + 0.5363325363 * lin.y + 0.0514459929 * lin.z, 0.0), 0.3333333)
    let m = pow(max(0.2119034982 * lin.x + 0.6806995451 * lin.y + 0.1073969566 * lin.z, 0.0), 0.3333333)
    let s = pow(max(0.0883024619 * lin.x + 0.2817188376 * lin.y + 0.6299787005 * lin.z, 0.0), 0.3333333)
    return vec3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s, 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s)
}
// What the glass makes of the colour behind it: lighter, as a milk would
// make it, but in OKLab, so it lightens without greying: its lightness goes
// 0.45 of the way to white and its colour keeps 0.85 of its strength.
let lq_glass_tint = fn(c: vec3) -> vec3 {
    let lab = lq_blob_oklab(c)
    return clamp(lq_blob_srgb(vec3(mix(lab.x, 1.0, 0.45), lab.y * 0.85, lab.z * 0.85)), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
}
lq_blob_soft_uniforms(mod.widgets.PanelView.draw_bg)
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 16.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    if self.sunken > 0.5 {
        return lq_unfill(lq_panel(pq, self.rect_size, self.rect_pos, px, 10.0, 0.0, 1.0, 0.0, 0.0, vec3(0.0, 0.0, 0.0)), lq_panel(pq, self.rect_size, self.rect_pos, px, 10.0, 0.0, 1.0, 0.0, 0.0, vec3(1.0, 1.0, 1.0)), 0.06)
    }
    let b = lq_snap(self.rect_pos, vec2(0.0, 0.0), self.rect_size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let rr = min(12.0, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    let n = lq_norm(pq, c, h, rr)
    // The window's size, from the pass's projection (two over each side).
    let pr = self.draw_pass.camera_projection * vec4(1.0, -1.0, 0.0, 0.0)
    let ws = vec2(2.0 / max(abs(pr.x), 0.000001), 2.0 / max(abs(pr.y), 0.000001))
    let bevel = 1.0 - clamp(max(0.0 - d, 0.0) / 10.0, 0.0, 1.0)
    let wp = self.rect_pos + pq + n * (5.0 * bevel * bevel)
    // The ground as the glass shows it: the backdrop and every layer's
    // blobs, their shapes kept and their edges softened over about five
    // hundredths of the window's height either side, flat in each ball's
    // mean colour, layer over layer, each paler with depth, at the point of
    // the window behind the pane.
    let wsz = max(ws, vec2(1.0, 1.0))
    let uv = vec2(wp.x - 0.5 * wsz.x, 0.5 * wsz.y - wp.y) / wsz.y
    let asp = wsz.x / wsz.y
    let cs = clamp(sqrt(asp), 0.6, 1.6)
    let sx = asp / 1.7777778
    let kr = cs / 1.3333333
    let k2 = self.blob_glob.x * self.blob_glob.x
    let iso = self.blob_glob.y
    var soft = lq_blob_bg(uv, self.blob_bg_top.xyz, self.blob_bg_bottom.xyz)
    let g0 = lq_blob_f(uv, self.blob_p0, sx, kr, k2)
    let g1 = lq_blob_f(uv, self.blob_p1, sx, kr, k2)
    let g2 = lq_blob_f(uv, self.blob_p2, sx, kr, k2)
    let g3 = lq_blob_f(uv, self.blob_p3, sx, kr, k2)
    let f0 = g0 + g1 + g2 + g3
    let e0 = (f0.x - iso) / max(length(f0.yz), 0.0001)
    soft = mix(soft, (self.blob_s0.xyz * g0.x + self.blob_s1.xyz * g1.x + self.blob_s2.xyz * g2.x + self.blob_s3.xyz * g3.x) / max(f0.x, 0.0000001), smoothstep(-0.05, 0.05, e0) * step(0.0000001, f0.x) * (1.0 - 0.8 * self.blob_s0.w))
    let g4 = lq_blob_f(uv, self.blob_p4, sx, kr, k2)
    let g5 = lq_blob_f(uv, self.blob_p5, sx, kr, k2)
    let f1 = g4 + g5
    let e1 = (f1.x - iso) / max(length(f1.yz), 0.0001)
    soft = mix(soft, (self.blob_s4.xyz * g4.x + self.blob_s5.xyz * g5.x) / max(f1.x, 0.0000001), smoothstep(-0.05, 0.05, e1) * step(0.0000001, f1.x) * (1.0 - 0.8 * self.blob_s4.w))
    let g6 = lq_blob_f(uv, self.blob_p6, sx, kr, k2)
    let g7 = lq_blob_f(uv, self.blob_p7, sx, kr, k2)
    let g8 = lq_blob_f(uv, self.blob_p8, sx, kr, k2)
    let f2 = g6 + g7 + g8
    let e2 = (f2.x - iso) / max(length(f2.yz), 0.0001)
    soft = mix(soft, (self.blob_s6.xyz * g6.x + self.blob_s7.xyz * g7.x + self.blob_s8.xyz * g8.x) / max(f2.x, 0.0000001), smoothstep(-0.05, 0.05, e2) * step(0.0000001, f2.x) * (1.0 - 0.8 * self.blob_s6.w))
    let g9 = lq_blob_f(uv, self.blob_p9, sx, kr, k2)
    let g10 = lq_blob_f(uv, self.blob_p10, sx, kr, k2)
    let g11 = lq_blob_f(uv, self.blob_p11, sx, kr, k2)
    let g12 = lq_blob_f(uv, self.blob_p12, sx, kr, k2)
    let g13 = lq_blob_f(uv, self.blob_p13, sx, kr, k2)
    let f3 = g9 + g10 + g11 + g12 + g13
    let e3 = (f3.x - iso) / max(length(f3.yz), 0.0001)
    soft = mix(soft, (self.blob_s9.xyz * g9.x + self.blob_s10.xyz * g10.x + self.blob_s11.xyz * g11.x + self.blob_s12.xyz * g12.x + self.blob_s13.xyz * g13.x) / max(f3.x, 0.0000001), smoothstep(-0.05, 0.05, e3) * step(0.0000001, f3.x) * (1.0 - 0.8 * self.blob_s9.w))
    let g14 = lq_blob_f(uv, self.blob_p14, sx, kr, k2)
    let g15 = lq_blob_f(uv, self.blob_p15, sx, kr, k2)
    let f4 = g14 + g15
    let e4 = (f4.x - iso) / max(length(f4.yz), 0.0001)
    soft = mix(soft, (self.blob_s14.xyz * g14.x + self.blob_s15.xyz * g15.x) / max(f4.x, 0.0000001), smoothstep(-0.05, 0.05, e4) * step(0.0000001, f4.x) * (1.0 - 0.8 * self.blob_s14.w))
    var col = lq_ink_floor(lq_glass_tint(soft), 0.35) + vec3(0.012, 0.012, 0.016)
    col = col + vec3(lq_grain(self.rect_pos + pq, px))
    let tl = normalize(vec2(-1.0, -1.0))
    let lit = 0.45 + 0.55 * pow(max(dot(n, tl), 0.0), 2.0) + 0.3 * pow(max(dot(n, vec2(0.0, 0.0) - tl), 0.0), 2.0)
    // The inner glow: light caught in the glass along its edge, a white that
    // fades inward, most of it within seven points and a breath of it over
    // twenty-four, brightest where the rim is.
    let din = max(0.0 - d, 0.0)
    col = mix(col, vec3(1.0, 1.0, 1.0), (0.45 * exp(0.0 - din / 7.0) + 0.18 * exp(0.0 - din / 24.0)) * (0.6 + 0.4 * min(lit, 1.0)))
    // The rim: one device pixel, whitest at the top left, then the bottom
    // right, softer between.
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, 0.0, px, px) * min(lit, 1.0))
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * 0.25 * max(dot(n, tl), 0.0))
    // Under it, a soft cool shadow; outside it, a faint cool line.
    let sh = Finish.drop(pq, c, h - vec2(1.0, 1.0), max(rr - 1.0, 0.0), vec2(0.0, 3.0), 5.0) * 0.10 * (1.0 - Finish.cover(d, px))
    var acc = vec4(vec3(0.165, 0.192, 0.251) * sh, sh)
    let line = Finish.ring_out(d, 0.0, px, px) * 0.16
    acc = Finish.over(acc, vec4(vec3(0.20, 0.22, 0.30) * line, line))
    let a = Finish.cover(d, px)
    return Finish.over(acc, vec4(col * a, a))
}
// The panes and the faders are drawn in place, never on an overlay of their
// own (`backdrop`): the screens' and the meter's water lifts itself over
// what lies under it, to bend it, only outside an overlay. Said here, not
// left to the default, because a switch from a sheet that turns it on
// (frosted) leaves its value on the parts already built.
mod.widgets.PanelView.backdrop = false
mod.widgets.SliderFader.backdrop = false
// The gutter a splitter keeps between two panes is a gap where the ground
// shows.
mod.widgets.Splitter.draw_bg.color_bg = #0000
// The rows of a tree lie on the glass: clear, every other one a breath of
// white; the open row is blue glass at a quarter.
mod.widgets.FileTreeNode.draw_bg.color_1 = instance(#ffffff00)
mod.widgets.FileTreeNode.draw_bg.color_2 = instance(#ffffff1a)
mod.widgets.FileTreeNode.draw_bg.color_active = instance(#4f7fd140)

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
