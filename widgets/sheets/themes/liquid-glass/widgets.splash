// SLIDERS. Every slider face draws its handle and its shadows past its own
// box, so the family's root grows the quad and stops clipping. The handle
// on the three horizontal faces is the fader's liquid glass drop (FADER
// below) with the widget's liquid motion: a press spreads it, a drag pulls
// a tail behind it, a jump sends it travelling.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false

// A value fill laid in a well: the accent at three quarters over the well,
// with the well's own dark line kept along its top.
let lq_fill = fn(acc: vec4, p: vec2, c: vec2, h: vec2, px: float, x0: float, x1: float, col: vec3, k: float) -> vec4 {
    let r = min(h.x, h.y)
    let fc = vec2((x0 + x1) * 0.5, c.y)
    let fh = vec2(max((x1 - x0) * 0.5, 0.0), h.y)
    let fd = Material.sd_box(p, fc, fh, min(r, fh.x))
    let wd = Material.sd_box(p, c, h, r)
    let top = step(p.y, c.y - h.y + px) * 0.35
    let fcol = mix(col, vec3(0.165, 0.192, 0.251), top)
    let a = Finish.cover(fd, px) * Finish.cover(wd, px) * k * step(0.01, x1 - x0)
    return Finish.over(acc, vec4(fcol * a, a))
}

// The bar slider's well and fill, drawn once where they lie and once more
// as the lens shows them, magnified.
let lq_bar_track = fn(p: vec2, gc: vec2, gh: vec2, px: float, f0: float, f1: float, fcol: vec3, dis: float) -> vec4 {
    let acc = lq_well(p, gc, gh, gh.y, px, vec3(0.737, 0.749, 0.773), dis)
    return lq_fill(acc, p, gc, gh, px, f0, f1, fcol, 0.8)
}

// The minimal slider's line and fill, drawn where they lie and as the lens
// shows them.
let lq_line_track = fn(pq: vec2, w: float, cy: float, px: float, fx0: float, fx1: float, fcol: vec3, dis: float) -> vec4 {
    let inx = step(0.0, pq.x) * step(pq.x, w)
    let dk = step(cy - px, pq.y) * step(pq.y, cy) * inx * 0.5 * dis
    let lt = step(cy, pq.y) * step(pq.y, cy + px) * inx * 0.8 * dis
    var acc = vec4(vec3(0.427, 0.443, 0.478) * dk, dk)
    acc = Finish.over(acc, vec4(lt, lt, lt, lt))
    let fd = Material.sd_box(pq, vec2((fx0 + fx1) * 0.5, cy), vec2((fx1 - fx0) * 0.5 + 1.0, 1.0), 1.0)
    let fa = Finish.cover(fd, px) * 0.85
    return Finish.over(acc, vec4(fcol * fa, fa))
}

// THE SETTLING DROP, the toggles' and the switches' knob: the engine's drop
// (round at rest, spread 8% by `press`, stretched by `s` toward `dir` with
// a tail merged on smoothly, squashed along by `sqa` and widened across by
// `sqx`) brought to rest without a swell. The engine merges its tail on
// above a stretch of 0.002, and two all but equal circles merged smoothly
// stand 0.175 of the radius proud of either, so its drop stands that much
// larger at the smallest stretch and falls back to its rest size in one
// frame as the tail catches up. Here the merged drop is blended in from the
// plain round drop at a stretch of 0.002 to the whole of it at 0.44, in
// step with the head narrowing as it stretches, so the drop keeps its rest
// size within a fiftieth of a point along and a fifteenth across while the
// tail catches up, and from 0.44 on is the engine's drop. The squash the
// motion hands over is read past its last 0.0065 (the 0.05 points of
// overshoot a motion may stop on, at the toggles' radius of 8), so a drop
// coming to rest does not squash and spring back once its motion stops.
let lq_smin = fn(a: float, b: float, k: float) -> vec2 {
    let h = clamp(0.5 + 0.5 * (b - a) / max(k, 0.0001), 0.0, 1.0)
    return vec2(mix(b, a, h) - k * h * (1.0 - h), h)
}
// A capsule from the origin to `pb`, radius `ra` at the origin and `rb` at
// `pb`: the drop's tail.
let lq_uneven = fn(p: vec2, pb: vec2, ra: float, rb: float) -> float {
    let h = max(dot(pb, pb), 0.0001)
    let q0 = vec2(dot(p, vec2(pb.y, -pb.x)), dot(p, pb)) / h
    let q = vec2(abs(q0.x), q0.y)
    let b = ra - rb
    let c = vec2(sqrt(max(h - b * b, 0.0)), b)
    let k = c.x * q.y - c.y * q.x
    let m = dot(c, q)
    let n = dot(q, q)
    if k < 0.0 {
        return sqrt(h * n) - ra
    }
    if k > c.x {
        return sqrt(h * (n + 1.0 - 2.0 * q.y)) - rb
    }
    return m - ra
}
let lq_settle_drop = fn(q: vec2, radius: float, s: float, dir: vec2, press: float, sqa: float, sqx: float) -> vec3 {
    let big = radius * (1.0 + 0.08 * press)
    let m = clamp(s, 0.0, 1.0)
    let v = vec2(-dir.y, dir.x)
    let rh = big * (1.0 - 0.26 * m)
    let sa = max(1.0 - sqa - 0.0065, 0.0)
    let sx = max(sqx - 1.0 - 0.36 * 0.0065, 0.0)
    let ax = vec2(rh * max(1.0 - sa, 0.3), rh * (1.0 + sx))
    let qe = vec2(dot(q, dir), dot(q, v)) / ax
    let le = max(length(qe), 0.0001)
    var d = (le - 1.0) * min(ax.x, ax.y)
    let ge = qe / (ax * le)
    var g = normalize(dir * (ge.x + 0.000001) + v * ge.y)
    if m > 0.002 {
        let rt = big * (1.0 - 0.73 * m)
        let ct = -dir * (1.69 * big * m)
        let dt = lq_uneven(q, ct, 0.85 * rh, rt)
        let cp = ct * clamp(dot(q, ct) / max(dot(ct, ct), 0.0001), 0.0, 1.0)
        let gt = normalize(q - cp + vec2(0.0001, 0.0))
        let sm = lq_smin(d, dt, 0.7 * big)
        let w = clamp((m - 0.002) / 0.438, 0.0, 1.0)
        d = mix(d, sm.x, w)
        g = normalize(mix(g, normalize(mix(gt, g, sm.y)), w))
    }
    return vec3(d, g.x, g.y)
}

// The fader: the bench's liquid glass drop ("Liquid glass drop"). A round
// drop of clear glass as long as the cap, 9 points tall, its dome a quarter
// round in from the outline, rides a 5 point slot cut into the ground, the
// accent lit along it from the stop (or from the origin) to the value.
// Through the glass the slot and its fill are seen bent and magnified,
// split a little into their colours toward the rim; the glass takes the
// plain sky's Fresnel reflection outside and off its back, a highlight and
// a soft lens spot, and throws a cool shadow down and to the right with a
// caustic just inside it. The shape, its curve and the material numbers are
// the bench's; the ground, the slot, the accent and the shadow ink are this
// sheet's. Lying down or standing up (`is_vertical`); the light stays above.
mod.widgets.SliderFader.cap_size = 22.0
mod.widgets.SliderFader.track_inset = 8.0
// The cap is a liquid: its tail follows the head on a viscous spring, a press spreads it, a jump sends it travelling.
mod.widgets.SliderFader.cap_viscosity = 0.66
mod.widgets.SliderFader.draw_bg.track_size = uniform(5.0)
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
// The material, the bench's numbers, as uniforms so they tune live: the key
// light on the screen (x right, y down, z toward the eye) and its strength;
// the highlight, the roughness (which also frosts the glass), the broad
// sheen and the rim toward grazing; the occlusion in the slot; the plain
// sky's reflection and how close the eye sits over the drop; a glow, off;
// the exposure in stops and the highlights' roll-off; the cast shadow's
// strength (a glass cap lays it at 0.45 of this) and its softest edge, the
// contact shadow and the slot's inner shadow; the drop's height. Metal,
// turned grain and the occlusion's reach up the height are left out: the
// glass shade reads none of them, in the bench as here.
mod.widgets.SliderFader.draw_bg.cap_light = uniform(vec3(-0.3, -0.6, 0.74))
mod.widgets.SliderFader.draw_bg.cap_light_intensity = uniform(0.95)
mod.widgets.SliderFader.draw_bg.cap_specular = uniform(1.0)
mod.widgets.SliderFader.draw_bg.cap_roughness = uniform(0.02)
mod.widgets.SliderFader.draw_bg.cap_gloss = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_rim = uniform(1.0)
mod.widgets.SliderFader.draw_bg.cap_ao = uniform(0.46)
mod.widgets.SliderFader.draw_bg.cap_reflection = uniform(0.46)
mod.widgets.SliderFader.draw_bg.cap_reflection_perspective = uniform(0.51)
mod.widgets.SliderFader.draw_bg.cap_glow = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_exposure = uniform(0.05)
mod.widgets.SliderFader.draw_bg.cap_rolloff = uniform(0.88)
mod.widgets.SliderFader.draw_bg.cap_shadow = uniform(0.5)
mod.widgets.SliderFader.draw_bg.cap_shadow_blur = uniform(10.0)
mod.widgets.SliderFader.draw_bg.cap_contact = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_inner = uniform(0.5)
mod.widgets.SliderFader.draw_bg.cap_height = uniform(9.0)
// The glass: how far (points) its surface bends the view of what lies
// under it and how much it magnifies, its white tint, the share of the bend
// split into the colours, the strength of the lens spot and the caustic,
// and the sky reflected off its outside and off its back. Clear glass, his
// bench spec: no tint, no sheen, no magnifying, a sharp highlight, the rim
// full toward the light, the sky at 0.46.
mod.widgets.SliderFader.draw_bg.cap_glass_depth = uniform(6.0)
mod.widgets.SliderFader.draw_bg.cap_glass_magnify = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_glass_tint = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_glass_chroma = uniform(0.05)
mod.widgets.SliderFader.draw_bg.cap_glass_caustic = uniform(0.6)
mod.widgets.SliderFader.draw_bg.cap_glass_outer = uniform(1.0)
mod.widgets.SliderFader.draw_bg.cap_glass_inner = uniform(0.6)
// The inks. The ground, the slot (the sheet's well, the ground seven
// hundredths down) and the accent are this sheet's, the fill grey when
// disabled as the sheet's fills turn; the glass is tinted and lit white, as
// the bench's; the shadow ink is the sheet's cool shadow, which darkens the
// ground under the drop about as the bench's ink darkens its own.
mod.widgets.SliderFader.draw_bg.cap_ground = uniform(theme.color_bg_app)
mod.widgets.SliderFader.draw_bg.cap_track_ink = uniform(theme.color_inset_1)
mod.widgets.SliderFader.draw_bg.cap_fill_ink = uniform(theme.color_val)
mod.widgets.SliderFader.draw_bg.cap_fill_disabled = uniform(theme.color_mark_disabled)
mod.widgets.SliderFader.draw_bg.cap_body = uniform(#ffffff)
mod.widgets.SliderFader.draw_bg.cap_light_ink = uniform(theme.color_material_light)
mod.widgets.SliderFader.draw_bg.cap_shadow_ink = uniform(#2a3140)

// The room the fader draws in outside its box, in points, worked out alike
// in `vertex` and `pixel`: the drop past the box (spread 8% under the
// finger; nothing on a fader wider than the drop), the throw of its cast
// shadow along the key light, the blur at the shadow's tip (the engine holds
// it between 0.35 and 1 times the height), a glow's reach when the glass
// emits, and three points for the focus ring and the contact shadow's tail.
let lq_fader_room = fn(across: float, cap: float, inset: float, lgt: vec3, height: float, blur: float, glo: float) -> float {
    let ln = normalize(lgt)
    let over = max(cap * 0.54 - min(across * 0.5, inset + cap * 0.5), 0.0)
    let thrown = height * 0.7 * length(ln.xy) / max(ln.z, 0.25)
    let tip = clamp(blur, max(height * 0.35, 1.0), max(height, 1.0))
    return over + thrown + tip + cap * 1.6 * step(0.001, glo) + 3.0
}

// The fader laid over the sheet's ground without painting the ground:
// premultiplied, the share of the ground it darkens away (the most any
// channel loses) and the colour put back over what is left. Exact for any
// colour, so the accent keeps its blue where a light-or-dark split would
// turn it grey; the bare ground comes out clear.
let lq_on_ground = fn(col: vec3, gnd: vec3) -> vec4 {
    let dk = max(gnd - col, vec3(0.0, 0.0, 0.0)) / max(gnd, vec3(0.01, 0.01, 0.01))
    let k = clamp(max(dk.x, max(dk.y, dk.z)), 0.0, 1.0)
    return vec4(max(col - gnd * (1.0 - k), vec3(0.0, 0.0, 0.0)), k)
}

// The ground under the fader at `ab`, in the fader's frame: the sheet's
// ground with the slot cut into it and the lit fill from `lo` to `hi`, its
// halo only beside the drop at `at` (half length `hx`). The glass draws it
// again through itself, bent. `dim` scales the slot's shade.
mod.widgets.SliderFader.draw_bg.fader_ground = fn(ab: vec2, tbox: vec4, lo: float, hi: float, at: float, hx: float, lt: vec3, px: float, fill_ink: vec3, dim: float) -> vec3 {
    return Cap.slot(self.cap_ground.rgb, ab, tbox, tbox.w, 2.0, lo, hi, at, hx, lt, px, 0.0, 0.0, self.cap_track_ink.rgb, fill_ink, self.cap_light_ink.rgb, self.cap_shadow_ink.rgb, self.cap_inner * dim, self.cap_ao * dim)
}

mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    let m = lq_fader_room(across, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let sz = self.rect_size
    let v = self.is_vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let m = lq_fader_room(across, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    let p = self.pos * (sz + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    // The fader's frame: `ab.x` along the track from the value's zero (up
    // the screen when the fader stands), `ab.y` across it. The track's
    // middle lands on a device pixel.
    let ab = vec2(mix(p.x, sz.y - p.y, v), mix(p.y, p.x, v))
    let ob = mix(self.rect_pos.y, self.rect_pos.x, v)
    let mid = Finish.snap(ob + across * 0.5, px) - ob
    let inset = self.inset_px
    let travel = max(along - inset * 2.0 - self.cap_px, 1.0)
    let foot = inset + self.cap_px * 0.5
    let at = foot + self.slide_pos * travel
    let en = 1.0 - self.disabled
    // Disabled, the shadows and the slot's shade drop to 0.35 and the
    // glass's light to half, as this sheet dims its disabled parts.
    let dim = mix(1.0, 0.35, self.disabled)
    let hl = mix(1.0, 0.5, self.disabled)
    // Held, the drop spreads 8% under the finger and settles 14% lower, as
    // the bench presses it; the pointer over it lifts the glass a little.
    let press = self.drag * en
    let hov = self.hover * en * (1.0 - self.drag)
    let ground = self.cap_ground.rgb
    let light_ink = self.cap_light_ink.rgb
    let body = self.cap_body.rgb
    // The key light on the screen for the glass, and turned into the
    // fader's frame for everything laid out along the track.
    let l = normalize(self.cap_light)
    let lt = Cap.light(self.cap_light, v)
    let li = self.cap_light_intensity
    // The lit fill draws its core at 1.2 times the ink it is handed; handed
    // the accent over 1.2 it shows the accent itself. Disabled, the sheet's
    // grey.
    let fill_ink = mix(self.cap_fill_ink.rgb, self.cap_fill_disabled.rgb, self.disabled) / 1.2

    // The slot, the track's whole length with round ends, and the fill from
    // the stop (the track's end) or the origin to the value. Under the glass
    // the fill runs on 0.42 of the cap past the drop's centre, so it is seen
    // ending inside the drop rather than cut off at its middle, as the bench
    // draws it.
    let tw = min(self.track_size, across)
    let tlen = max(along - inset * 2.0, 1.0)
    let tbox = vec4(inset + tlen * 0.5, mid, tlen * 0.5, tw * 0.5)
    var lo = foot + self.fill_lo * travel
    var hi = foot + self.fill_hi * travel
    if self.fill_lo < 0.0005 {
        lo = inset
    }
    if self.fill_hi > 0.9995 {
        hi = along - inset
    }
    var glo = lo
    var ghi = hi
    if abs(hi - at) < 0.5 {
        ghi = hi + self.cap_px * 0.42
    }
    if abs(lo - at) < 0.5 {
        glo = lo - self.cap_px * 0.42
    }

    // The drop: a circle the cap's length across, spread by the press. Its
    // height is the edge curve's quarter round, from the outline in over the
    // rest radius. The bench's along and across curves are flat at 1, so
    // their reading is (1, 0) everywhere and goes in as it is.
    let r = self.cap_px * 0.5
    let hs = vec2(r, r)
    let rp = r * (1.0 + 0.08 * press)
    let height = self.cap_height * (1.0 - 0.14 * press)
    let q = ab - vec2(at, mid)
    let fp = Cap.sd_drop(q, r, self.cap_stretch, vec2(self.cap_dir, 0.0), press, self.cap_squash_along, self.cap_squash_across)
    let cov = Cap.cover(fp.x, px)
    var fg = vec2(0.0, 0.0)
    var disp = vec2(0.0, 0.0)
    if fp.x < px {
        let edge_c = Cap.curve(Cap.edge_x(fp.x, hs, 1.0), 2.0, vec2(0.0, 0.0), vec2(0.0, 0.5523), vec2(-0.5523, 0.0), vec2(1.0, 1.0), vec2(0.5523, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0))
        let flat_c = vec2(1.0, 0.0)
        // Shape: corner and edge width the whole radius, blend 0.02, the
        // height. No ribs, no mark, no cut.
        let f = Cap.field(q, hs, fp, flat_c, flat_c, edge_c, flat_c, vec4(1.0, 1.0, 0.02, height), vec4(0.0, 0.0, 0.0, 1.0), vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.5, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0))
        fg = f.yz
        // What lies under the glass is seen where its surface bends the
        // view, read in the fader's frame.
        disp = Cap.glass_disp(q, Cap.normal(fg, height, 0.0), self.cap_glass_depth, self.cap_glass_magnify, cov)
    }
    var col = self.fader_ground(ab + disp, tbox, glo, ghi, at, r, lt, px, fill_ink, dim)
    if cov > 0.001 {
        // Its red and its blue are read a little apart along the bend, and
        // frosted by the roughness.
        let split = Cap.glass_split(disp, hs, self.cap_glass_chroma, self.cap_roughness, cov)
        let red = self.fader_ground(ab + split.xy, tbox, glo, ghi, at, r, lt, px, fill_ink, dim)
        let blue = self.fader_ground(ab + split.zw, tbox, glo, ghi, at, r, lt, px, fill_ink, dim)
        col = Cap.glass_mix(red, col, blue, self.cap_glass_chroma, self.cap_roughness)
    }

    // The glass and what it throws, worked out only where the drop or its
    // shadow can reach.
    var cap = col
    var shd = 0.0
    var caus = vec3(0.0, 0.0, 0.0)
    var halo = 0.0
    if length(q) - rp < m {
        let rise = height
        let n = Cap.normal(fg, height, v)
        let eye = Cap.view(q, hs, self.cap_reflection_perspective, v)
        let spot = Cap.lens(q, hs, lt, rise, self.cap_glass_depth, li, self.cap_glass_caustic) * hl
        cap = Cap.glass_shade(n, l, eye, col, body, self.cap_glass_tint, self.cap_specular * hl, self.cap_roughness, self.cap_gloss * hl, self.cap_rim * hl, li, self.cap_reflection, self.cap_glass_outer, self.cap_glass_inner, spot, 0.0, 0.0, light_ink, light_ink, ground)
        // The lit fill still showing beside the drop lights the side that
        // faces it; the pointer lifts the glass as it lifts every glass face
        // on this sheet.
        cap = cap + fill_ink * Cap.fill_light(q, hs, fg * height, lo, hi, at, tw) * en
        cap = cap + vec3(0.03, 0.03, 0.03) * hov
        // Under it: the cast shadow, thrown from the top outline the bench
        // gives for this drop (a glass one at 0.45 of the shadow), the
        // contact shadow round its foot, the caustic just inside the shadow
        // on the side away from the light, and the glow if the glass emits.
        // The cast shadow, the caustic and the lens keep the rest size, as
        // the bench throws them: held, the spread drop covers the shadow's
        // foot and the lower rise draws it in, while the contact shadow
        // hugs the spread outline.
        let top = vec3(0.6902, 0.6902, 1.0)
        let thrown = Cap.shadow(q, hs, r, top, lt, rise, self.cap_shadow_blur, self.cap_shadow * 0.45 * dim, px)
        let touch = Cap.contact(fp.x, max(rise * 0.3, 1.0), self.cap_contact * dim)
        shd = clamp(thrown + touch, 0.0, 1.0)
        caus = light_ink * Cap.caustic(q, hs, r, top, lt, rise, self.cap_shadow_blur, px, self.cap_glass_chroma, self.cap_glass_depth, self.cap_roughness, li, self.cap_glass_caustic) * dim
        halo = Cap.glow(fp.x, hs, self.cap_glow)
    }
    let outside = 1.0 - cov
    col = mix(col, col * self.cap_shadow_ink.rgb, shd * outside)
    col = col + caus * outside + body * halo * 0.9 * outside
    col = mix(col, cap, cov)
    // Toned, then laid over the ground without painting it, with the
    // sheet's focus ring a point and a half outside the drop.
    let ev = pow(2.0, self.cap_exposure)
    let res = lq_on_ground(Cap.tone(col, ev, self.cap_rolloff), Cap.tone(ground, ev, self.cap_rolloff))
    return Finish.over(res, lq_focus(fp.x, px, self.focus * en))
}

// THE DROP on a horizontal face: the fader's liquid glass drop (FADER
// below), its material read from the face's own uniforms, laid over the
// face's track seen through the glass. `ab` is the point in the face's
// frame (x along the track, y down), `c` the drop's centre, `tbox` the
// track's box (centre, half size) for the slot and the fill's light, `cap`
// the face's own extra geometry handed on to `lq_under`, `f` the lit fill
// from `f.x` to `f.y` along the track, `m` the room past the box, `ring`
// 1 to put the sheet's focus ring round the drop and 0 to leave the focus
// to the face, `hot` the share of the press that spreads this drop (1 on a
// face with one drop), `settle` 1 for the settling drop the toggles and the
// switches carry (THE SETTLING DROP above) and 0 for the engine's drop the
// sliders carry. What lies under the glass is read through
// `self.lq_under`, which every face defines for its own track; the whole
// is laid over the ground without painting it.
mod.widgets.SliderMinimal.draw_bg.lq_drop = fn(ab: vec2, c: vec2, tbox: vec4, cap: vec4, f: vec2, px: float, m: float, ring: float, hot: float, settle: float) -> vec4 {
    let en = 1.0 - self.disabled
    let dim = mix(1.0, 0.35, self.disabled)
    let hl = mix(1.0, 0.5, self.disabled)
    let press = max(self.drag, self.cap_press) * en * hot
    let hov = self.hover * en * (1.0 - self.drag)
    let ground = self.cap_ground.rgb
    let light_ink = self.cap_light_ink.rgb
    let body = self.cap_body.rgb
    let l = normalize(self.cap_light)
    let lt = Cap.light(self.cap_light, 0.0)
    let li = self.cap_light_intensity
    let fill_ink = mix(self.cap_fill_ink.rgb, self.cap_fill_disabled.rgb, self.disabled) * 0.5
    let at = c.x
    let tw = tbox.w * 2.0
    // Under the glass the fill runs on 0.42 of the cap past the drop's
    // centre, so it is seen ending inside the drop and not cut at its middle.
    var glo = f.x
    var ghi = f.y
    if abs(f.y - at) < 0.5 {
        ghi = f.y + self.cap_px * 0.42
    }
    if abs(f.x - at) < 0.5 {
        glo = f.x - self.cap_px * 0.42
    }
    let r = self.cap_px * 0.5
    let hs = vec2(r, r)
    let rp = r * (1.0 + 0.08 * press)
    let height = self.cap_height * (1.0 - 0.14 * press)
    let q = ab - c
    var fp = Cap.sd_drop(q, r, self.cap_stretch, vec2(self.cap_dir, 0.0), press, self.cap_squash_along, self.cap_squash_across)
    if settle > 0.5 {
        fp = lq_settle_drop(q, r, self.cap_stretch, vec2(self.cap_dir, 0.0), press, self.cap_squash_along, self.cap_squash_across)
    }
    let cov = Cap.cover(fp.x, px)
    var fg = vec2(0.0, 0.0)
    var disp = vec2(0.0, 0.0)
    if fp.x < px {
        // the edge: its curve from the rim in over `cap_edge_width` of the
        // radius (the three handles the bench exports), blended by
        // `cap_blend`
        let edge_c = Cap.curve(Cap.edge_x(fp.x, hs, self.cap_edge_width), 2.0, vec2(0.0, 0.0), self.cap_edge_out0, self.cap_edge_in1, vec2(1.0, 1.0), self.cap_edge_out1, vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0), vec2(0.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 1.0))
        let flat_c = vec2(1.0, 0.0)
        let fld = Cap.field(q, hs, fp, flat_c, flat_c, edge_c, flat_c, vec4(1.0, self.cap_edge_width, self.cap_blend, height), vec4(0.0, 0.0, 0.0, 1.0), vec4(0.0, 0.0, 0.0, 0.0), vec4(0.0, 0.5, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0))
        fg = fld.yz
        disp = Cap.glass_disp(q, Cap.normal(fg, height, 0.0), self.cap_glass_depth, self.cap_glass_magnify, cov)
    }
    var col = self.lq_under(ab + disp, tbox, cap, vec2(glo, ghi))
    if cov > 0.001 {
        let split = Cap.glass_split(disp, hs, self.cap_glass_chroma, self.cap_roughness, cov)
        let red = self.lq_under(ab + split.xy, tbox, cap, vec2(glo, ghi))
        let blue = self.lq_under(ab + split.zw, tbox, cap, vec2(glo, ghi))
        col = Cap.glass_mix(red, col, blue, self.cap_glass_chroma, self.cap_roughness)
    }
    var capc = col
    var shd = 0.0
    var caus = vec3(0.0, 0.0, 0.0)
    var halo = 0.0
    if length(q) - rp < m {
        let rise = height
        let n = Cap.normal(fg, height, 0.0)
        let eye = Cap.view(q, hs, self.cap_reflection_perspective, 0.0)
        let spot = Cap.lens(q, hs, lt, rise, self.cap_glass_depth, li, self.cap_glass_caustic) * hl
        capc = Cap.glass_shade(n, l, eye, col, body, self.cap_glass_tint, self.cap_specular * hl, self.cap_roughness, self.cap_gloss * hl, self.cap_rim * hl, li, self.cap_reflection, self.cap_glass_outer, self.cap_glass_inner, spot, 0.0, 0.0, light_ink, light_ink, ground)
        capc = capc + fill_ink * Cap.fill_light(q, hs, fg * height, f.x, f.y, at, tw) * en
        capc = capc + vec3(0.03, 0.03, 0.03) * hov
        let top = vec3(0.6902, 0.6902, 1.0)
        let thrown = Cap.shadow(q, hs, r, top, lt, rise, self.cap_shadow_blur, self.cap_shadow * 0.45 * dim, px)
        let touch = Cap.contact(fp.x, max(rise * 0.3, 1.0), self.cap_contact * dim)
        shd = clamp(thrown + touch, 0.0, 1.0)
        caus = light_ink * Cap.caustic(q, hs, r, top, lt, rise, self.cap_shadow_blur, px, self.cap_glass_chroma, self.cap_glass_depth, self.cap_roughness, li, self.cap_glass_caustic) * dim
        halo = Cap.glow(fp.x, hs, self.cap_glow)
    }
    let outside = 1.0 - cov
    col = mix(col, col * self.cap_shadow_ink.rgb, shd * outside)
    col = col + caus * outside + body * halo * 0.9 * outside
    col = mix(col, capc, cov)
    let ev = pow(2.0, self.cap_exposure)
    let res = lq_on_ground(Cap.tone(col, ev, self.cap_rolloff), Cap.tone(ground, ev, self.cap_rolloff))
    return Finish.over(res, lq_focus(fp.x, px, self.focus * en * ring))
}

// The material and the inks of the liquid glass drop on this face: the
// fader's numbers (FADER below says what each does), the drop's height
// and its size by the face.
mod.widgets.SliderMinimal.cap_size = 14.0
mod.widgets.SliderMinimal.track_inset = 0.0
mod.widgets.SliderMinimal.cap_viscosity = 0.66
mod.widgets.SliderMinimal.draw_bg.cap_light = uniform(vec3(-0.3, -0.6, 0.74))
mod.widgets.SliderMinimal.draw_bg.cap_light_intensity = uniform(0.95)
mod.widgets.SliderMinimal.draw_bg.cap_specular = uniform(1.0)
mod.widgets.SliderMinimal.draw_bg.cap_roughness = uniform(0.02)
mod.widgets.SliderMinimal.draw_bg.cap_gloss = uniform(0.0)
mod.widgets.SliderMinimal.draw_bg.cap_rim = uniform(1.0)
mod.widgets.SliderMinimal.draw_bg.cap_ao = uniform(0.46)
mod.widgets.SliderMinimal.draw_bg.cap_reflection = uniform(0.46)
mod.widgets.SliderMinimal.draw_bg.cap_reflection_perspective = uniform(0.51)
mod.widgets.SliderMinimal.draw_bg.cap_glow = uniform(0.0)
mod.widgets.SliderMinimal.draw_bg.cap_exposure = uniform(0.05)
mod.widgets.SliderMinimal.draw_bg.cap_rolloff = uniform(0.88)
mod.widgets.SliderMinimal.draw_bg.cap_shadow = uniform(0.5)
mod.widgets.SliderMinimal.draw_bg.cap_shadow_blur = uniform(10.0)
mod.widgets.SliderMinimal.draw_bg.cap_contact = uniform(0.35)
mod.widgets.SliderMinimal.draw_bg.cap_inner = uniform(0.5)
mod.widgets.SliderMinimal.draw_bg.cap_edge_width = uniform(1.0)
mod.widgets.SliderMinimal.draw_bg.cap_blend = uniform(0.02)
mod.widgets.SliderMinimal.draw_bg.cap_edge_out0 = uniform(vec2(0.0, 0.5523))
mod.widgets.SliderMinimal.draw_bg.cap_edge_in1 = uniform(vec2(-0.5523, 0.0))
mod.widgets.SliderMinimal.draw_bg.cap_edge_out1 = uniform(vec2(0.5523, 0.0))
mod.widgets.SliderMinimal.draw_bg.cap_height = uniform(5.7)
mod.widgets.SliderMinimal.draw_bg.cap_glass_depth = uniform(3.8)
mod.widgets.SliderMinimal.draw_bg.cap_glass_magnify = uniform(0.0)
mod.widgets.SliderMinimal.draw_bg.cap_glass_tint = uniform(0.0)
mod.widgets.SliderMinimal.draw_bg.cap_glass_chroma = uniform(0.05)
mod.widgets.SliderMinimal.draw_bg.cap_glass_caustic = uniform(0.6)
mod.widgets.SliderMinimal.draw_bg.cap_glass_outer = uniform(1.0)
mod.widgets.SliderMinimal.draw_bg.cap_glass_inner = uniform(0.6)
mod.widgets.SliderMinimal.draw_bg.cap_ground = uniform(theme.color_bg_app)
mod.widgets.SliderMinimal.draw_bg.cap_fill_ink = uniform(theme.color_val)
mod.widgets.SliderMinimal.draw_bg.cap_fill_disabled = uniform(theme.color_mark_disabled)
mod.widgets.SliderMinimal.draw_bg.cap_body = uniform(#ffffff)
mod.widgets.SliderMinimal.draw_bg.cap_light_ink = uniform(theme.color_material_light)
mod.widgets.SliderMinimal.draw_bg.cap_shadow_ink = uniform(#2a3140)
// The room the drop and its shadow need past the box, the same in vertex
// and pixel.
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let m = lq_fader_room(self.rect_size.y, self.cap_px, self.inset_px, self.cap_light, self.cap_height, self.cap_shadow_blur, self.cap_glow)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
