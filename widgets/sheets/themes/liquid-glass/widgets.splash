// CHECK BOX. A 16 point glass tile with a 5 point corner, sitting close to
// the ground: no pool under a part this small. Checked, the tile turns
// blue glass and carries a black mark, 1.75 points, round capped.
let lq_check = fn(pq: vec2, size: vec2, org: vec2, px: float, box: float, hover: float, down: float, focus: float, active: float, disabled: float, mixed: float, error: float, round: float, at_end: float) -> vec4 {
    let x0 = (size.x - box) * at_end
    let y0 = size.y * 0.5 - box * 0.5
    let b = lq_snap(org, vec2(x0, y0), vec2(x0 + box, y0 + box), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let r = mix(5.0, h.x, round)
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let press = down * en
    let hov = hover * en * (1.0 - press)
    let on = max(active, mixed)
    let dis = mix(1.0, 0.3, disabled)
    var acc = lq_cast(pq, c, h, r, px, box, 0.24 * dis * mix(1.0, 0.4, press) * (1.0 + 0.5 * hov), 1.0 - press, mix(vec3(0.165, 0.192, 0.251), vec3(0.204, 0.282, 0.431), on), vec3(1.0, 1.0, 1.0), 0.0)
    let lift = 0.05 * hov - 0.07 * press
    let rim = vec4(mix(mix(vec3(0.620, 0.631, 0.659), vec3(0.478, 0.561, 0.690), on * 0.6), vec3(0.753, 0.278, 0.243), error), mix(0.95, 0.5, disabled))
    let hl = mix(0.95, 1.0, hov) * mix(1.0, 0.62, press) * mix(1.0, 0.5, disabled)
    let body = lq_glass_body(pq, c, h, r, px, box, lq_blue(), on, lift, mix(1.0, 2.0, on), 0.9 * mix(1.0, 0.55, disabled), hl, 1.0 + 0.5 * press, mix(0.08 * box, 3.0 * px, hov) + px, 1.0, rim, vec3(0.965, 0.973, 0.988))
    acc = Finish.over(acc, body)
    let ink = mix(mix(vec3(0.051, 0.059, 0.078), vec3(0.620, 0.157, 0.125), error), vec3(0.643, 0.651, 0.671), disabled)
    let k0 = vec2(c.x - box * 0.24, c.y + box * 0.01)
    let k1 = vec2(c.x - box * 0.07, c.y + box * 0.18)
    let k2 = vec2(c.x + box * 0.24, c.y - box * 0.17)
    let ck = Finish.cover(min(lq_seg(pq, k0, k1), lq_seg(pq, k1, k2)) - 0.875, px) * active * (1.0 - mixed)
    let dash = Finish.cover(lq_seg(pq, vec2(c.x - box * 0.2, c.y), vec2(c.x + box * 0.2, c.y)) - 0.875, px) * mixed
    let mk = max(ck, dash)
    acc = Finish.over(acc, vec4(ink * mk, mk))
    return Finish.over(acc, lq_focus(d, px, focus * en))
}
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_check(pq, self.rect_size, self.rect_pos, px, 16.0, self.hover, self.down, self.focus, self.active, self.disabled, self.mixed, self.error, 0.0, self.mark_at_end)
}
mod.widgets.CheckBoxCircle.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_check(pq, self.rect_size, self.rect_pos, px, 16.0, self.hover, self.down, self.focus, self.active, self.disabled, self.mixed, self.error, 1.0, self.mark_at_end)
}
mod.widgets.CheckBoxFlat.draw_bg.size = 16.0
// The box stands in the padding and the label's margin, so a box with no
// label still has the room it draws in.
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 6.0 bottom: 6.0}
mod.widgets.CheckBoxFlat.label_walk.margin.left = 16.0

// THE AIR SWITCH. The toggles and both switches are drawn as the glass
// family's switch (glass.GlassRadio, the "Air" switch on Glass > Controls):
// a short capsule track two thirds of the switch's height, grey off and
// green on (red in error), a white nub riding it with a soft shadow, and
// over the nub a larger lens of clear glass the switch's full height. The
// lens magnifies what lies under it by a fifth and bends the track in
// toward its rim, red and blue a little apart there, frosted a little more
// toward the top, with a bright crescent on the rim facing up and to the
// right and a faint seal round it. Crossing, it stretches like a drop,
// longest at the middle, round at the ends. Its numbers are the glass
// switch's (70 by 34), scaled to this switch's height.
// The switch as the lens sees it at `q` (the switch's points): the ground,
// the track and the nub, no shadow.
let lq_air_slot = fn(q: vec2, tcen: vec2, thalf: vec2, kc: vec2, khalf: vec2, kr: float, tcol: vec3, ta: float, ground: vec3, h: float) -> vec3 {
    let dt = Material.sd_box(q, tcen, thalf, thalf.y)
    var col = mix(ground, tcol, smoothstep(0.5, -0.5, dt) * ta)
    let dk = Material.sd_box(q, kc, khalf, kr)
    let kcol = mix(vec3(1.0, 1.0, 1.0), vec3(0.90, 0.91, 0.94), clamp(q.y / max(h, 1.0), 0.0, 1.0) * 0.28)
    return mix(col, kcol, smoothstep(0.5, -0.5, dk))
}
// The switch in the box `b0`..`b1`, the knob at `t` (0 off, 1 on).
// Premultiplied.
let lq_air_switch = fn(pq: vec2, b0: vec2, b1: vec2, px: float, t: float, hover: float, disabled: float, error: float, ground: vec3) -> vec4 {
    let w = b1.x - b0.x
    let h = b1.y - b0.y
    let p = pq - b0
    let s = h / 34.0
    let k = clamp(t, 0.0, 1.0)
    let on_col = mix(mix(vec3(0.27, 0.80, 0.33), vec3(0.643, 0.651, 0.671), disabled), lq_red(), error)
    let off_col = mix(vec3(0.46, 0.48, 0.51), vec3(0.70, 0.71, 0.73), disabled)
    let tcol = mix(off_col, on_col, k)
    // Off, the track is a breath of shade on the glass; on, its colour.
    let ta = mix(0.3, 1.0, k)
    let track_h = h * 0.66
    let kpad = 3.0 * s
    let knob_h = track_h - 4.0 * s
    let travel_w = (h - kpad * 2.0) * 1.35
    let knob_w = travel_w + 6.0 * s - h + knob_h
    let track_xpad = kpad + (travel_w - knob_w) * 0.5
    let tcen = vec2(w * 0.5, h * 0.5)
    let thalf = vec2((w - track_xpad * 2.0) * 0.5, track_h * 0.5)
    let kc = vec2(mix(kpad + travel_w * 0.5, w - kpad - travel_w * 0.5, k), h * 0.5)
    let khalf = vec2(knob_w * 0.5, knob_h * 0.5)
    let kr = min(knob_h * 0.44, khalf.x)
    // The slot: the track, the nub's shadow, the nub.
    let dt = Material.sd_box(p, tcen, thalf, thalf.y)
    var acc = vec4(tcol * ta, ta) * Finish.cover(dt, px)
    let trl = Finish.band(dt, 0.0, px, px) * 0.35 * (1.0 - k)
    acc = Finish.over(acc, vec4(vec3(0.20, 0.22, 0.27) * trl, trl))
    let ds = Material.sd_box(p, kc + vec2(-0.5 * s, 1.5 * s), khalf + vec2(0.5 * s, 0.5 * s), kr)
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, 0.18) * smoothstep(1.0, -1.0, ds))
    let dk = Material.sd_box(p, kc, khalf, kr)
    let kcol = mix(vec3(1.0, 1.0, 1.0), vec3(0.90, 0.91, 0.94), clamp(p.y / max(h, 1.0), 0.0, 1.0) * 0.28)
    acc = Finish.over(acc, vec4(kcol, 1.0) * Finish.cover(dk, px))
    // The lens over the nub, stretched as it crosses.
    let klh = h - kpad * 2.0
    let klw = klh * 1.35
    let gloop = sin(k * PI)
    let lh = klh + 6.0 * s - gloop * 2.0 * s
    let lw = klw + 6.0 * s + gloop * klw * 0.55
    let lc = vec2(mix(kpad + klw * 0.5, w - kpad - klw * 0.5, k), h * 0.5)
    let lhalf = vec2(lw * 0.5, lh * 0.5)
    let lr = lhalf.y
    let shape = Material.sd_box(p, lc, lhalf, lr)
    let la = Finish.cover(shape, px)
    if la > 0.001 {
        let e = 0.25
        let gx = Material.sd_box(p + vec2(e, 0.0), lc, lhalf, lr) - Material.sd_box(p - vec2(e, 0.0), lc, lhalf, lr)
        let gy = Material.sd_box(p + vec2(0.0, e), lc, lhalf, lr) - Material.sd_box(p - vec2(0.0, e), lc, lhalf, lr)
        let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
        let rim = clamp(1.0 - abs(shape) / (9.0 * s), 0.0, 1.0)
        let bend = rim * rim
        let warped = p + (lc - p) * (0.20 * (1.0 - bend)) + n * (bend * 9.0 * s)
        let chroma = n * (bend * 3.0 * s)
        // What the lens shows, over a black ground and over a white one:
        // where it shows the ground, it is clear glass (lq_unfill).
        let cr0 = lq_air_slot(warped + chroma, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(0.0, 0.0, 0.0), h)
        let cg0 = lq_air_slot(warped, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(0.0, 0.0, 0.0), h)
        let cb0 = lq_air_slot(warped - chroma, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(0.0, 0.0, 0.0), h)
        let cr1 = lq_air_slot(warped + chroma, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(1.0, 1.0, 1.0), h)
        let cg1 = lq_air_slot(warped, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(1.0, 1.0, 1.0), h)
        let cb1 = lq_air_slot(warped - chroma, tcen, thalf, kc, khalf, kr, tcol, ta, vec3(1.0, 1.0, 1.0), h)
        let seen0 = vec3(cr0.x, cg0.y, cb0.z)
        let seen1 = vec3(cr1.x, cg1.y, cb1.z)
        let kg = clamp((seen1.x + seen1.y + seen1.z - seen0.x - seen0.y - seen0.z) / 3.0, 0.0, 1.0)
        var lens = vec4(seen0, 1.0 - kg)
        let top = smoothstep(0.0, 1.0, 1.0 - p.y / max(h, 1.0))
        let w1 = 0.12 + top * 0.10
        lens = Finish.over(lens, vec4(w1, w1, w1, w1))
        let facing = clamp(dot(n, normalize(vec2(0.50, -0.86))), 0.0, 1.0)
        let edge = clamp(1.0 - abs(shape) / (2.6 * s), 0.0, 1.0)
        let w2 = facing * edge * (0.45 + hover * 0.10)
        lens = Finish.over(lens, vec4(w2, w2, w2, w2))
        let w3 = 0.16 * Finish.cover(abs(shape) - 0.4 * s, px)
        lens = Finish.over(lens, vec4(w3, w3, w3, w3))
        acc = Finish.over(acc, lens * la)
    }
    return acc * mix(1.0, 0.55, disabled)
}

// TOGGLE. A 36 by 16 channel cut into the ground (the toggle's `size` by
// `pill_aspect`), filled with the accent when on. The knob is a flat disc
// of liquid glass, 22 points, his bench spec, with the widget's liquid
// motion; the channel runs on through it, bent. The face is drawn after
// the sliders, whose drop it borrows (THE TOGGLE'S DROP below).
let lq_toggle_track = fn(pq: vec2, tc: vec2, thh: vec2, px: float, th: float, hov: float, on: float, blue: vec3, disabled: float, dis: float, en: float) -> vec4 {
    let tr = thh.y
    var acc = lq_cast(pq, tc, thh, tr, px, th, 0.28 * dis * (1.0 + 0.3 * hov), 1.0, mix(vec3(0.165, 0.192, 0.251), vec3(0.204, 0.282, 0.431), on), mix(vec3(1.0, 1.0, 1.0), vec3(0.663, 0.769, 0.949), on), mix(0.3, 0.45, on) * mix(1.0, 1.3, hov) * en)
    let lift = 0.05 * hov
    let rim = vec4(mix(vec3(0.682, 0.690, 0.714), vec3(0.478, 0.561, 0.690), on * 0.6), mix(0.9, 0.5, disabled))
    let body = lq_glass_body(pq, tc, thh, tr, px, th, blue, on, lift, mix(1.0, 2.0, on), 0.88 * mix(1.0, 0.55, disabled), mix(0.95, 1.0, hov) * mix(1.0, 0.5, disabled), 1.0, mix(0.07 * th, 3.0 * px, hov) + px, 1.5, rim, vec3(0.965, 0.973, 0.988))
    return Finish.over(acc, body)
}
mod.widgets.ToggleFlat.draw_bg.size = uniform(20.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(2.06)
// The toggle places a knob's marks and measures a drag from these two:
// with a point of border and a point of inset its knob centre is the one
// the face draws (half the track and a point in, travelling w - size).
mod.widgets.ToggleFlat.draw_bg.border_size = uniform(1.0)
mod.widgets.ToggleFlat.draw_bg.knob_inset = uniform(1.0)
mod.widgets.Toggle.draw_bg.border_size = 1.0
mod.widgets.Toggle.draw_bg.knob_inset = 1.0
// A mark on the knob: ten points on a 22 point lens, in the ink at 0.7,
// whatever colour the page hands it.
mod.widgets.ToggleFlat.knob_icon_size = 0.5
mod.widgets.Toggle.knob_icon_size = 0.5
mod.widgets.ToggleFlat.draw_icon_on.get_color = fn() {
    let base = self.eval_gradient()
    let a = base.a * 0.7 * self.opacity
    return vec4(vec3(0.110, 0.118, 0.133) * a, a)
}
mod.widgets.ToggleFlat.draw_icon_off.get_color = fn() {
    let base = self.eval_gradient()
    let a = base.a * 0.7 * self.opacity
    return vec4(vec3(0.110, 0.118, 0.133) * a, a)
}
mod.widgets.Toggle.draw_icon_off.get_color = fn() {
    let base = self.eval_gradient()
    let a = base.a * 0.7 * self.opacity
    return vec4(vec3(0.110, 0.118, 0.133) * a, a)
}
mod.widgets.Toggle.draw_icon_on.get_color = fn() {
    let base = self.eval_gradient()
    let a = base.a * 0.7 * self.opacity
    return vec4(vec3(0.110, 0.118, 0.133) * a, a)
}
mod.widgets.ToggleFlat.padding = mod.turtle.Inset{left: 20.0 right: 20.0 top: 6.0 bottom: 6.0}
mod.widgets.ToggleFlat.label_walk.margin.left = 26.0

// RADIO. A 16 point glass disc; chosen, a 6 point blue glass dot in it with
// its own hairline on top.
let lq_radio = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, active: float, disabled: float) -> vec4 {
    let b = lq_snap(org, vec2(0.0, size.y * 0.5 - 8.0), vec2(16.0, size.y * 0.5 + 8.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let r = h.x
    let d = length(pq - c) - r
    let en = 1.0 - disabled
    let press = down * en
    let hov = hover * en * (1.0 - press)
    let dis = mix(1.0, 0.3, disabled)
    var acc = lq_cast(pq, c, h, r, px, 16.0, 0.24 * dis * mix(1.0, 0.4, press) * (1.0 + 0.5 * hov), 1.0 - press, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.0)
    let lift = 0.05 * hov - 0.07 * press
    let rim = vec4(0.620, 0.631, 0.659, mix(0.95, 0.5, disabled))
    let body = lq_glass_body(pq, c, h, r, px, 16.0, vec3(0.0, 0.0, 0.0), 0.0, lift, 1.0, 0.9 * mix(1.0, 0.55, disabled), mix(0.95, 1.0, hov) * mix(1.0, 0.62, press) * mix(1.0, 0.5, disabled), 1.0 + 0.5 * press, mix(1.3, 3.0 * px, hov) + px, 1.0, rim, vec3(0.965, 0.973, 0.988))
    acc = Finish.over(acc, body)
    // The dot: blue glass, darker at its foot, a pale hairline on its crown.
    let dd = length(pq - c) - 3.0
    let v = clamp((pq.y - c.y) / 3.0 * 0.5 + 0.5, 0.0, 1.0)
    var dc = mix(mix(vec3(0.439, 0.588, 0.855), vec3(0.259, 0.431, 0.741), v), vec3(0.690, 0.710, 0.745), disabled)
    dc = mix(dc, vec3(0.839, 0.886, 0.980), Finish.band(dd, 0.0, px, px) * smoothstep(0.2, -0.6, (pq.y - c.y) / 3.0))
    let da = Finish.cover(dd, px) * active
    acc = Finish.over(acc, vec4(dc * da, da))
    return Finish.over(acc, lq_focus(d, px, focus * en))
}
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_radio(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.active, self.disabled)
}
mod.widgets.RadioButtonFlat.draw_bg.size = 16.0
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 6.0 bottom: 6.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 16.0

// An 8 by 4 point chevron, 1.5 point round-capped stroke, pointing down.
let lq_chevron = fn(p: vec2, cx: float, cy: float, px: float) -> float {
    let d = min(lq_seg(p, vec2(cx - 4.0, cy - 2.0), vec2(cx, cy + 2.0)), lq_seg(p, vec2(cx, cy + 2.0), vec2(cx + 4.0, cy - 2.0)))
    return Finish.cover(d - 0.75, px)
}

// TEXT FIELDS. The glass capsule lying flat: a field sits, it does not
// float, so no shadow and no pool, only the contact line under it. The
// face is the ground itself behind the glass; the hairline and the dark
// line under it along the top, a two pixel white exit band along the
// bottom. A field clips what it holds, so all of it stays in its box and
// the focus ring is drawn on the rim: the outline and the pixel inside it
// turn blue.
let lq_field = fn(pq: vec2, size: vec2, org: vec2, px: float, r: float, hover: float, down: float, focus: float, disabled: float, ground: vec3) -> vec4 {
    let b = lq_snap(org, vec2(0.0, 0.0), vec2(size.x, size.y - 0.7), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let s = min(size.y, 32.0)
    let rr = min(r, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    let n = lq_norm(pq, c, h, rr)
    let en = 1.0 - disabled
    let g = 0.012 + 0.014 * hover * en * (1.0 - down) - 0.02 * down * en
    let face = ground + vec3(g, g, g + 0.004)
    let rim = vec4(mix(vec3(0.620, 0.631, 0.659), lq_accent(), focus * en), mix(0.95, 0.5, disabled))
    var acc = lq_body(pq, c, h, rr, px, s, face, 0.45, 0.9 * mix(1.0, 0.55, disabled), mix(1.0, 0.5, disabled), 0.7, 0.05 * s + px, 2.0, rim, vec3(0.965, 0.973, 0.988))
    let fr = Finish.band(d, px, 2.0 * px, px) * 0.45 * focus * en
    acc = Finish.over(acc, vec4(lq_accent() * fr, fr))
    let low = smoothstep(0.3, 0.9, n.y)
    let ct = Finish.ring_out(d, 0.0, px, px) * low * 0.3 * mix(1.0, 0.4, disabled)
    return Finish.over(acc, vec4(0.0, 0.0, 0.0, ct))
}
// The inputs a slider, a combo box, a number or a well carries inside
// themselves draw nothing: the control round them is the box.
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.w < 0.01 || self.border_radius < 0.5 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, self.hover, self.down, self.focus, self.disabled, vec3(0.0, 0.0, 0.0))
    let hi = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, self.hover, self.down, self.focus, self.disabled, vec3(1.0, 1.0, 1.0))
    return lq_unfill(lo, hi, 0.08)
}
mod.widgets.TextInputFlat.padding.left = 12.0
mod.widgets.TextInputFlat.padding.right = 12.0

// The number field: the same capsule, with its stepper at the right end.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, self.hover, 0.0, self.focus, self.disabled, vec3(0.0, 0.0, 0.0))
    let hi = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, self.hover, 0.0, self.focus, self.disabled, vec3(1.0, 1.0, 1.0))
    return lq_unfill(lo, hi, 0.08)
}
mod.widgets.NumberField.pad_left = 12.0
// The stepper stands clear of the capsule's round end: its column is the
// 12 point stepper plus the 13 point end, drawn in the left 12.
mod.widgets.NumberField.spin_width = 25.0
// The stepper: two small glass halves behind a hairline divider, a black
// chevron in each; the half under the pointer brightens, the held one
// settles darker.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let w = 12.0
    let h = self.rect_size.y
    let mid = Finish.snap(self.rect_pos.y + h * 0.5, px) - self.rect_pos.y
    let live = 1.0 - self.disabled
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let hc = vec2(w * 0.5 + 0.5, mix(mid + (h - mid) * 0.5 - 1.0, mid * 0.5 + 1.0, upper))
    let hh = vec2(w * 0.5 - 2.0, mid * 0.5 - 2.5)
    let hd = Material.sd_box(p, hc, hh, 3.0)
    let wash = Finish.cover(hd, px) * (0.35 * hot * (1.0 - dn))
    var acc = vec4(wash, wash, wash, wash)
    let dk = Finish.cover(hd, px) * 0.12 * dn
    acc = Finish.over(acc, vec4(0.165 * dk, 0.192 * dk, 0.251 * dk, dk))
    // the divider: a hairline down the left, one across the middle
    let inx = step(3.0, p.x) * step(p.x, w - 2.0)
    let iny = step(6.0, p.y) * step(p.y, h - 6.0)
    let dv = max(step(mid - px, p.y) * step(p.y, mid) * inx, step(0.0, p.x) * step(p.x, px) * iny) * 0.5
    acc = Finish.over(acc, vec4(0.620 * dv, 0.631 * dv, 0.659 * dv, dv))
    let cx = w * 0.5 + 0.5
    let yu = mid - 5.0
    let yd = mid + 5.0
    let cu = min(lq_seg(p, vec2(cx - 3.0, yu + 1.5), vec2(cx, yu - 1.5)), lq_seg(p, vec2(cx, yu - 1.5), vec2(cx + 3.0, yu + 1.5)))
    let cd = min(lq_seg(p, vec2(cx - 3.0, yd - 1.5), vec2(cx, yd + 1.5)), lq_seg(p, vec2(cx, yd + 1.5), vec2(cx + 3.0, yd - 1.5)))
    let mk = Finish.cover(min(cu, cd) - 0.75, px) * mix(0.85, 0.3, self.disabled)
    return Finish.over(acc, vec4(vec3(0.110, 0.118, 0.133) * mk, mk))
}
// The printed arrow glyphs are hidden; the face draws the chevrons.
mod.widgets.NumberSpin.draw_text.color = #1c1e2200
mod.widgets.NumberSpin.draw_text.color_disabled = #1c1e2200

// The drag-number: the field, its value a faint blue wash over the glass.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, max(self.hover, self.drag), 0.0, self.focus, 0.0, vec3(0.0, 0.0, 0.0))
    let hi = lq_field(pq, self.rect_size, self.rect_pos, px, 13.0, max(self.hover, self.drag), 0.0, self.focus, 0.0, vec3(1.0, 1.0, 1.0))
    var acc = lq_unfill(lo, hi, 0.08)
    let d = Material.sd_box(pq, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(2.0, 2.0), 11.0)
    let wash = step(0.0, self.fill) * step(pq.x, 2.0 + (self.rect_size.x - 4.0) * max(self.fill, 0.0)) * Finish.cover(d, px) * 0.18
    return Finish.over(acc, vec4(lq_accent() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #1c1e22
mod.widgets.ValueInput.arrow_color = #3d4048
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// DROP-DOWN. A standing glass capsule with a chevron ten points in from the
