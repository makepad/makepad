use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// Frosted glass cards over a dark ground.
// A sheet of frost is the ground lifted by a few percent of cool white,
// more at its head than at its foot, with a band of light under its top
// edge and a caustic gathered over its foot. One device pixel of rim cuts
// it out, brighter on top than below; a dark pixel stands outside the rim,
// a tight contact shadow under the foot and a soft far shadow below that,
// all outside the layout box. Cyan light is the one accent: a fill, a line
// along a foot, a faint halo on the one hero.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = uniform(99.0)
mod.widgets.Button.draw_bg.border_size = uniform(0.5)
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 4.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #1a202b

// Shadows leave the layout box: plain views stop clipping so a shadow can
// fall into the gap under a control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// THE INKS.
// Shadow ink #05070d, frost white with a cool cast, the accent #5fcff5, its
// pale rim #aff2ff, the foot light #81fcfe and the halo blue #2f7fd6.
let fr_ink = fn() -> vec3 { return vec3(0.020, 0.027, 0.051) }
let fr_white = fn() -> vec3 { return vec3(0.94, 0.965, 1.0) }
let fr_acc = fn() -> vec3 { return vec3(0.373, 0.812, 0.961) }
let fr_acc_rim = fn() -> vec3 { return vec3(0.686, 0.949, 1.0) }
let fr_acc_line = fn() -> vec3 { return vec3(0.506, 0.988, 0.996) }
let fr_acc_glow = fn() -> vec3 { return vec3(0.184, 0.498, 0.839) }
// Rose, for error and danger only.
let fr_rose = fn() -> vec3 { return vec3(0.941, 0.318, 0.475) }

// Grain that does not repeat: the library's hash nearly repeats every 97
// cells along an axis, so it is fed a skewed lattice on which no short
// shift lines up again. Signed, triangular, one value per cell.
let fr_grain = fn(p: vec2, amount: float) -> float {
    let i = floor(p)
    let q = vec2(i.x + i.y * 0.4142, i.y - i.x * 0.2718)
    return (Finish.hash(q) - Finish.hash(q.yx * 1.3107 + vec2(17.13, 3.71))) * amount
}

// ---------------------------------------------------------------------------
// THE GLASS. Distances in points, negative inside; px is one device pixel.

// The box snapped to device pixels, as (lo, hi) relative to the quad's
// layout origin, so every rim lands on one pixel row.
let fr_snap = fn(o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    return vec4(lo, hi)
}

// Rounded box with a corner per quadrant: (tl, tr, br, bl).
let fr_box = fn(p: vec2, c: vec2, h: vec2, rr: vec4) -> float {
    let q = p - c
    var r = rr.x
    if q.x > 0.0 {
        r = rr.y
        if q.y > 0.0 {
            r = rr.z
        }
    } else {
        if q.y > 0.0 {
            r = rr.w
        }
    }
    return Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
}

// The frost's white alpha down the face: 0.20 at the head, 0.13 in the
// middle, 0.09 at the foot.
let fr_lift = fn(yn: float) -> float {
    return mix(mix(0.20, 0.13, clamp(yn * 2.0, 0.0, 1.0)), 0.09, clamp(yn * 2.0 - 1.0, 0.0, 1.0))
}

// The rim's alpha round the edge, as a share of `top` (0.60 at rest): top
// 1, left side 0.70, right side 0.60, foot 0.50, so the edge reads as lit
// from the upper left and the top is twice the foot.
let fr_rim = fn(yn: float, xn: float, top: float) -> float {
    let k = top / 0.60
    let v = mix(0.60, 0.30, smoothstep(0.0, 1.0, yn))
    let side = (1.0 - abs(yn * 2.0 - 1.0)) * (0.0 - 0.03 - 0.06 * xn)
    return (v + side) * k
}
// The rim's cool tint, #dfe8ff.
let fr_rimc = fn() -> vec3 { return vec3(0.875, 0.910, 1.0) }

// The glint on a top rim: full over the middle 35 % of the width, a cosine
// fall over a quarter of the width each side.
let fr_glint = fn(xn: float) -> float {
    let e = clamp((abs(xn - 0.5) - 0.175) / 0.25, 0.0, 1.0)
    return 0.5 + 0.5 * cos(3.14159265 * e)
}

// One frosted plate on the snapped box b = (lo, hi), premultiplied:
// the far shadow, the contact shadow and the dark line outside it; a halo
// in the accent blue for the hero, a lit state or a focus; the tone under
// the frost, the frost with its head band and its foot caustic; the rim;
// the focus light along the foot and the hero's glint.
//   face  the frost's strength (1 a button, 0 an outline)
//   amb   the far shadow's strength (1 = 35 %)
//   rim   the rim's strength (1 = top 0.55, foot 0.35)
//   tone  a tinted body under the frost, premultiplied
//   cau   the caustic's strength (1 = 10 %), in cau_col
//   hero  the glint and the wide halo; lit a small halo and a tinted contact
let fr_plate = fn(p: vec2, b: vec4, rr: vec4, px: float, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, tone: vec4, rim_col: vec3, cau_col: vec3, cau: float, hero: float, lit: float) -> vec4 {
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fr_box(p, c, h, rr)
    let r = min(max(max(rr.x, rr.y), max(rr.z, rr.w)), min(h.x, h.y))
    let hh = hi.y - lo.y
    let ww = hi.x - lo.x
    let yn = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / max(ww, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    // Shadows: a press settles the plate onto the ground; hover lifts it a
    // little. The contact of a lit plate is tinted with its light.
    let off = mix(2.2, 0.4, down)
    let sig = mix(3.2 * (1.0 + 0.1 * hover), 1.8, down)
    let fa = Finish.drop(p, c, h, r, vec2(0.0, off), sig) * amb * mix(0.65, 0.30, down) * live
    let ct = Finish.drop(p, c, h, r, vec2(0.0, 0.67), 0.45) * 0.45 * min(rim, 1.0) * live * (1.0 - 0.6 * lit)
    let dl = Finish.ring_out(d, 0.0, px, px) * 0.25 * min(rim, 1.0) * mix(1.0, 0.5, disabled) * (1.0 - 0.8 * lit)
    let sh = (1.0 - (1.0 - fa) * (1.0 - ct) * (1.0 - dl)) * outside
    var o = vec4(fr_ink() * sh, sh)
    // The halo: accent blue, outside only.
    let hk = max(hero * 0.50 * (1.0 + 0.2 * hover - 0.3 * down), focus * 0.35) * live
    if hk > 0.001 {
        let hg = Finish.drop(p, c, h, r, vec2(0.0, mix(1.0, 1.5, hero)), mix(2.4, 2.8, hero)) * hk * outside
        o = Finish.over(o, vec4(fr_acc_glow() * hg, hg))
    }
    // A lit edge's bloom: the accent at 16 % one device pixel out, half of
    // that at two points, gone by five.
    let dd = max(d, 0.0)
    let lh = lit * 0.17 * exp(0.0 - dd * dd / 5.1) * outside * live
    o = Finish.over(o, vec4(fr_acc() * lh, lh))
    // The hero's glint and its bloom just above the top edge.
    let gl = fr_glint(xn) * hero * step(80.0, ww) * live
    let bloom = gl * 0.10 * exp(-(d * d) / 0.64) * outside * step(p.y, c.y)
    o = Finish.over(o, vec4(bloom, bloom, bloom, bloom))
    // The face: tone, frost, head band and foot caustic.
    let depth = 0.0 - d
    let fk = min(face * 3.0, 1.0)
    var wa = fr_lift(yn) * face + (0.07 * hover * (1.0 - down) - 0.05 * down) * fk
    let band = (1.0 - clamp(depth / max(0.12 * hh, 1.5), 0.0, 1.0)) * (1.0 - smoothstep(0.0, 0.6, yn))
    wa = max(wa + band * mix(0.12, 0.22, hero) * mix(1.0, 0.5, down) * max(fk, hero), 0.0)
    var f = Finish.over(tone, vec4(fr_white() * wa, wa))
    let cz = (1.0 - clamp(depth / max(0.10 * hh, 1.5), 0.0, 1.0)) * smoothstep(0.4, 1.0, yn) * 0.10 * cau * (1.0 - down)
    f = Finish.over(f, vec4(cau_col * cz, cz))
    // The focus light: one device pixel of foot light over the middle 70 %,
    // and its glow one-sided into the face, gone within four points.
    let lw = (1.0 - smoothstep(0.2, 0.35, abs(xn - 0.5))) * smoothstep(0.55, 0.9, yn) * focus * live
    let fin = exp(0.0 - max(depth - px, 0.0) / 1.2) * 0.40 * lw
    f = Finish.over(f, vec4(fr_acc_glow() * fin, fin))
    // Its bloom just under the foot, outside.
    let fbl = lw * exp(0.0 - (d * d) / 1.1) * 0.40 * outside
    o = Finish.over(o, vec4(fr_acc_line() * fbl * 0.6, fbl))
    // The rim: brighter on top, the sides lifted by a focus, the glint on
    // the top edge of the hero.
    // The glass sheen: a straight band crossing faces 40 points or wider,
    // from the top edge at 62 % of the width down-left at 60 degrees, 0.35
    // of the height across, white 5 % with a hard leading edge and a soft
    // trailing one. A press dims it; none when disabled.
    let sp = p - vec2(lo.x + 0.62 * ww, lo.y)
    let su = dot(sp, vec2(0.866, 0.5))
    let sw = 0.35 * hh
    let sa = Finish.cover(su, px) * smoothstep(0.0 - sw, 0.0 - 0.25 * sw, su) * 0.055 * step(40.0, ww) * min(max(face, hero) * 1.4, 1.0) * (1.0 - 0.6 * down) * live
    f = Finish.over(f, vec4(fr_white() * sa, sa))
    var ra = (fr_rim(yn, xn, mix(0.60, 0.80, hover * (1.0 - down))) + 0.15 * focus * (1.0 - abs(yn * 2.0 - 1.0))) * rim
    ra = mix(ra, 0.9 + 0.1 * hover, gl * (1.0 - smoothstep(0.0, 0.2, yn)))
    // A lit edge: #aff2ff at full strength on top to #befcff at the foot.
    ra = mix(ra, 1.0, lit * live)
    ra = min(ra, 1.0) * mix(1.0, 0.5, disabled)
    let rc = mix(rim_col, mix(vec3(0.686, 0.949, 1.0), vec3(0.745, 0.988, 1.0), smoothstep(0.2, 0.8, yn)), lit)
    let rb = Finish.band(d, 0.0, px, px) * ra
    f = Finish.over(f, vec4(rc * rb, rb))
    f = mix(f, vec4(fr_acc_line(), 1.0), Finish.band(d, 0.0, px, px) * lw)
    // Face grain, a third of a level, so the long fall does not band.
    let g = fr_grain(p / px, 0.9 / 255.0) * f.a
    f = vec4(f.rgb + vec3(g, g, g), f.a) * inside
    o = Finish.over(o, f)
    return o * mix(1.0, 0.4, disabled)
}

// A recessed well of darker glass on the shape d: black at `a` over what
// is under it, a dark pixel along its head, a light pixel along its foot
// and quieter light up its sides. Premultiplied.
let fr_well_h = fn(d: float, yn: float, px: float, a: float, foot: float, side: float, hd: float) -> vec4 {
    let inside = Finish.cover(d, px)
    let rb = Finish.band(d, 0.0, px, px)
    let head = rb * (1.0 - smoothstep(0.25, 0.5, yn))
    let low = rb * smoothstep(0.5, 0.75, yn)
    let mid = rb * (1.0 - max(1.0 - smoothstep(0.25, 0.5, yn), smoothstep(0.5, 0.75, yn)))
    var o = vec4(0.0, 0.0, 0.0, a)
    o = Finish.over(o, vec4(0.0, 0.0, 0.0, hd * head))
    let l = foot * low + side * mid
    o = Finish.over(o, vec4(fr_white() * l, l))
    return o * inside
}
let fr_well = fn(d: float, yn: float, px: float, a: float, foot: float, side: float) -> vec4 {
    return fr_well_h(d, yn, px, a, foot, side, 0.4)
}

// Distance to a segment.
let fr_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    return length(pa - ba * t)
}

// A frost-white disc: a handle or a thumb. Its own far shadow and contact,
// a face of white 88 % at the head to 78 % at the foot, a white rim on top
// and a pale cyan one below. Premultiplied, laid over `under`.
// The disc is opaque: nothing under it shows through. Its face runs from
// 0.95 at the head to 0.89 at the foot; the hand lifts the foot, a press
// dims the whole disc by 0.06.
let fr_disc = fn(under: vec4, p: vec2, c: vec2, r: float, px: float, hover: float, down: float, disabled: float) -> vec4 {
    let d = length(p - c) - r
    let yn = clamp((p.y - c.y + r) / (2.0 * r), 0.0, 1.0)
    let live = 1.0 - disabled
    let outside = 1.0 - Finish.cover(d, px)
    let amb = Finish.drop(p, c, vec2(r, r), r, vec2(0.0, 0.8), 1.4) * 0.40 * live * outside
    let ct = Finish.drop(p, c, vec2(r, r), r, vec2(0.0, 0.67), 0.35) * 0.30 * live * outside
    let sh = 1.0 - (1.0 - amb) * (1.0 - ct)
    var o = Finish.over(under, vec4(fr_ink() * sh, sh))
    let hv = hover * (1.0 - down)
    var col = mix(vec3(0.945, 0.970, 0.990), mix(vec3(0.865, 0.895, 0.925), vec3(0.925, 0.950, 0.975), hv), yn)
    col = col - vec3(0.065, 0.065, 0.065) * down
    let rb = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(1.0, 1.0, 1.0), vec3(0.804, 0.933, 0.961), yn), rb * (1.0 - 0.5 * down))
    col = mix(col, vec3(0.30, 0.33, 0.37), disabled * 0.55)
    let a = Finish.cover(d, px)
    return Finish.over(o, vec4(col * a, a))
}

// The wait spinner a replaced face draws itself: a pale cyan comet turning
// once a second on a ring where the label was.
let fr_wait = fn(under: vec4, p: vec2, size: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = size * 0.5
    let r = max(min(size.x, size.y) * 0.5 - 6.0, 3.0)
    let q = p - c
    let ring = abs(length(q) - r)
    let a = fract(atan2(q.y, q.x) / 6.2831853 - t)
    let body = Finish.cover(ring - 0.75, px) * a * a * loading
    let track = Finish.cover(ring - 0.5, px) * 0.15 * loading
    let o = Finish.over(under, vec4(fr_white() * track, track))
    return mix(o, vec4(fr_acc_rim(), 1.0), body)
}

// A frosted button: the plate, with the hero's accent body under it.
let fr_button = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, rim_col: vec3, hero: float) -> vec4 {
    let b = fr_snap(o, s, px)
    let yn = clamp((p.y - b.y) / max(b.w - b.y, 1.0), 0.0, 1.0)
    // The hero's body: #89aacf at the head to #6187b8 at the foot, at 75 %.
    let tb = mix(vec3(0.537, 0.667, 0.812), vec3(0.380, 0.529, 0.722), yn) * (1.0 + 0.08 * hover - 0.10 * down)
    let tone = vec4(tb * 0.75, 0.75) * hero
    let cau_col = mix(fr_white(), fr_acc_rim(), hero)
    return fr_plate(p, b, rr, px, hover, down, focus, disabled, face, amb, rim, tone, rim_col, cau_col, mix(1.0, 3.5, hero), hero, 0.0)
}

// ---------------------------------------------------------------------------
// BUTTONS. Pills 26 points tall. The shadows fall outside the box: the quad
// grows by `glow_room` and the button stops clipping.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.icon_walk = Walk{width: 14.0, height: Fit}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(99.0)
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(8.0)
mod.widgets.ButtonFlat.draw_bg.corners = fn() -> vec4 {
    let r = self.border_radius
    return vec4(
        mix(r, self.border_radius_tl, step(0.0, self.border_radius_tl)),
        mix(r, self.border_radius_tr, step(0.0, self.border_radius_tr)),
        mix(r, self.border_radius_br, step(0.0, self.border_radius_br)),
        mix(r, self.border_radius_bl, step(0.0, self.border_radius_bl))
    )
}
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The flat button lies on the ground: frost and rim, the contact line, no
// far shadow. The size ladder wears it too.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.75, 0.0, 0.9, fr_rimc(), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// The standard button: the whole stack.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fr_rimc(), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// The one hero: accent-tinted glass, a brighter rim tinted #b8f0ff, a cyan
// caustic, the glint when it is wide enough, and the only halo at rest.
mod.widgets.ButtonPrimary.draw_bg.glow_room = uniform(10.0)
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.35, 0.0, 1.36, vec3(0.722, 0.941, 1.0), 1.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// The second voice: the standard glass cut by a lavender rim.
mod.widgets.ButtonSecondary.draw_bg.glow_room = uniform(8.0)
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.25, vec3(0.745, 0.725, 0.98), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// Tonal: thinner frost, a lighter shadow, the near-white ink.
mod.widgets.ButtonTertiary.draw_bg.glow_room = uniform(8.0)
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.6, 0.5, 0.85, fr_rimc(), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// Danger: the standard glass with a rose rim and a rose ink.
mod.widgets.ButtonDanger.draw_bg.glow_room = uniform(8.0)
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.3, vec3(0.96, 0.54, 0.64), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// Outline: the rim and its dark line alone, no frost; the hand frosts it.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let face = 0.5 * max(self.hover, self.down)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, face, 0.0, 1.2, fr_rimc(), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}
// Flatter: nothing at rest; the frost and rim come with the pointer.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let face = 0.7 * max(self.hover, self.down)
    let rim = 0.8 * max(max(self.hover, self.down), self.focus)
    let f = fr_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, face, 0.0, rim, fr_rimc(), 0.0)
    return self.host_over(fr_wait(f, p, self.rect_size, px, self.loading, self.anim_time), m)
}

