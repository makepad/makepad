    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fr_check(p, self.rect_pos, self.rect_size, px, self.size, self.border_radius, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}
mod.widgets.CheckBoxCircle.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fr_check(p, self.rect_pos, self.rect_size, px, self.size, self.size * 0.5, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}

// RADIOS. The check box's frost in a circle; on, a white dot 6 points
// across with a small drop under it.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(15.0)
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let yn = clamp((p.y - lo.y) / sz, 0.0, 1.0)
    let on = self.active
    let tone = vec4(mix(vec3(0.239, 0.365, 0.522), vec3(0.231, 0.494, 0.643), yn) * 0.9, 0.9) * on
    let r = sz * 0.5
    let f = fr_plate(p, vec4(lo, hi), vec4(r, r, r, r), px, self.hover, self.down, self.focus, self.disabled, 0.8 * (1.0 - 0.7 * on), 0.85, mix(0.9, 1.3, on), tone, mix(fr_rimc(), fr_acc_rim(), on), vec3(0.678, 1.0, 1.0), mix(1.0, 4.0, on), 0.0, on)
    let c = (lo + hi) * 0.5
    let dd = length(p - c) - 3.0
    let ds = Finish.drop(p, c + vec2(0.0, 0.5), vec2(3.0, 3.0), 3.0, vec2(0.0, 0.0), 0.6) * 0.35 * on * (1.0 - Finish.cover(dd, px))
    let g = Finish.over(f, vec4(fr_ink() * ds, ds))
    let da = Finish.cover(dd, px) * 0.95 * on * mix(1.0, 0.45, self.disabled)
    return Finish.over(g, vec4(da, da, da, da))
}

// TOGGLES. A capsule 28 by 16 of darker glass; on, the channel fills with
// the accent at 55 % and a pale cyan caustic runs along its foot. The
// thumb is a frost-white disc 12 across that floats 2 points in, with its
// own far shadow and contact.
mod.widgets.ToggleFlat.label_walk.margin.left = 28.0
mod.widgets.ToggleFlat.draw_bg.size = uniform(16.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(1.75)
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = (self.rect_size.x - sz.x) * self.mark_at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Finish.sd_pill(p, c, h)
    let yn = clamp((p.y - lo.y) / sz.y, 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / sz.x, 0.0, 1.0)
    let live = 1.0 - self.disabled
    let on = self.active
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    // Contact under the capsule and the dark line round it; a focus halo.
    let ct = Finish.drop(p, c, h, h.y, vec2(0.0, 0.67), 0.45) * 0.45 * live
    let dl = Finish.ring_out(d, 0.0, px, px) * 0.25
    let sh = (1.0 - (1.0 - ct) * (1.0 - dl)) * outside
    var f = vec4(fr_ink() * sh, sh)
    let hg = Finish.drop(p, c, h, h.y, vec2(0.0, 1.0), 2.4) * 0.35 * self.focus * live * outside
    f = Finish.over(f, vec4(fr_acc_glow() * hg, hg))
    // The channel: darker glass off, accent light on; the hand lifts it.
    let hv0 = self.hover * (1.0 - self.down)
    let w = fr_well(d, yn, px, (0.28 - 0.06 * hv0 + 0.06 * self.down) * (1.0 - on), 0.14 + 0.16 * hv0, 0.18 + 0.16 * hv0)
    f = Finish.over(f, w)
    // The hand frosts the channel a little.
    let hw = 0.06 * hv0 * inside
    f = Finish.over(f, vec4(fr_white() * hw, hw))
    // On, the channel is accent-tinted glass, #3d5d85 at the head to
    // #3b7ea4 at the foot at 85 %, the hand a little brighter, a press a
    // little darker.
    let fa = 0.85 * on * inside
    let hv = self.hover * (1.0 - self.down)
    let ch = mix(vec3(0.239, 0.365, 0.522), vec3(0.231, 0.494, 0.643), yn) * (1.0 + 0.10 * hv - 0.10 * self.down)
    f = Finish.over(f, vec4(ch * fa, fa))
    // A caustic gathered over the foot, and the lit foot line #8de1fa one
    // device pixel inside the rim.
    let cz = (1.0 - clamp((0.0 - d) / 2.5, 0.0, 1.0)) * smoothstep(0.45, 1.0, yn) * 0.35 * on * inside
    f = Finish.over(f, vec4(fr_acc_rim() * cz, cz))
    let fl = Finish.band(d, px, 2.0 * px, px) * smoothstep(0.6, 0.9, yn) * on * 0.9
    f = mix(f, vec4(0.553, 0.882, 0.980, 1.0), fl)
    // On, the rim is lit: #aff2ff at full strength on top to #befcff at the
    // foot, with its bloom outside.
    let orim = Finish.band(d, 0.0, px, px) * on
    f = mix(f, vec4(mix(vec3(0.686, 0.949, 1.0), vec3(0.745, 0.988, 1.0), smoothstep(0.2, 0.8, yn)), 1.0), orim)
    let dd = max(d, 0.0)
    let oh = on * 0.17 * exp(0.0 - dd * dd / 5.1) * outside * live
    f = Finish.over(f, vec4(fr_acc() * oh, oh))
    // The focus light along the foot.
    let lw = (1.0 - smoothstep(0.2, 0.35, abs(xn - 0.5))) * smoothstep(0.55, 0.9, yn) * self.focus * live
    f = mix(f, vec4(fr_acc_line(), 1.0), Finish.band(d, 0.0, px, px) * lw)
    // The thumb, following the hand while dragged.
    let t = mix(on, self.drag_pos, self.drag)
    let kr = sz.y * 0.5 - 2.0
    let kc = vec2(mix(lo.x + sz.y * 0.5, hi.x - sz.y * 0.5, t), c.y)
    f = fr_disc(f, p, kc, kr * (1.0 - 0.06 * self.down), px, self.hover, self.down, self.disabled)
    return f * mix(1.0, 0.4, self.disabled)
}

// ---------------------------------------------------------------------------
// SLIDERS. A 4 point groove of darker glass with a dark head pixel and a
// light foot pixel; the value an accent fill with a pale rim top and
// bottom and no halo; a frost-white handle 12 across. Dragging gives the
// handle a faint accent halo; a focus rings it.
let fr_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, x0p: float, x1p: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float, handle: float) -> vec4 {
    let live = 1.0 - disabled
    let y = Finish.snap(o.y + cy, px) - o.y
    let x0 = Finish.snap(o.x + x0p, px) - o.x
    let x1 = Finish.snap(o.x + x1p, px) - o.x
    let gc = vec2((x0 + x1) * 0.5, y)
    let gh = vec2((x1 - x0) * 0.5 + 2.0, 2.0)
    let gd = Finish.sd_pill(p, gc, gh)
    let yn = clamp((p.y - y + 2.0) / 4.0, 0.0, 1.0)
    // The groove holds on the bare ground: well 32 %, head 50 %, foot 18 %.
    var f = fr_well_h(gd, yn, px, 0.32, 0.18, 0.12, 0.50)
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    // The fill: a pill from the origin to the value, inside the groove.
    let fc = vec2((min(xf, xv) + max(xf, xv)) * 0.5, y)
    let fh = vec2(abs(xv - xf) * 0.5 + 2.0, 2.0)
    let fd = Finish.sd_pill(p, fc, fh)
    let fa = Finish.cover(fd, px) * step(0.01, abs(xv - xf) + 0.02) * mix(1.0, 0.4, disabled)
    // A pale rim #c3effc along the fill's head and foot.
    let rimb = Finish.band(fd, 0.0, px, px)
    let fc2 = mix(mix(fr_acc(), vec3(0.553, 0.882, 0.980), 0.45 * max(hover, drag)), vec3(0.765, 0.937, 0.988), rimb)
    f = Finish.over(f, vec4(fc2 * fa, fa))
    let hc = vec2(xv, y)
    // A focus or a drag: a halo round the handle.
    let hk = max(0.15 * drag, 0.30 * focus) * live * handle
    let hd = length(p - hc) - 6.0
    let hg = Finish.drop(p, hc, vec2(6.0, 6.0), 6.0, vec2(0.0, 0.8), 2.2) * hk * (1.0 - Finish.cover(hd, px))
    f = Finish.over(f, vec4(fr_acc_glow() * hg, hg))
    let k = fr_disc(f, p, hc, (6.0 + 0.6 * max(hover, drag)) * handle, px, hover, drag, disabled)
    // The focus ring: one device pixel of foot light round the handle.
    let fr = Finish.cover(abs(hd - 0.2) - px * 0.5, px) * focus * handle * live * 0.8
    return mix(k, vec4(fr_acc_line(), 1.0), fr)
}

mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
// The minimal slider: a hairline rail and the value; its handle only with
// the pointer.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y
    let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
    let rail = Finish.cover(abs(p.y - y - px * 0.5) - px * 0.5, px) * inx * 0.22
    var f = vec4(fr_white() * rail, rail)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(0.0, lo, self.arc_origin) * self.rect_size.x
    let b = mix(self.slide_pos, hi, self.arc_origin) * self.rect_size.x
    let fd = fr_seg(p, vec2(a, y + px * 0.5), vec2(b, y + px * 0.5)) - 1.0
    let fa = Finish.cover(fd, px) * mix(1.0, 0.4, self.disabled)
    f = Finish.over(f, vec4(fr_acc() * fa, fa))
    let hc = vec2(self.slide_pos * self.rect_size.x, y + px * 0.5)
    let touch = max(max(self.hover, self.drag), self.focus)
    return fr_disc(f, p, hc, 5.0 * touch, px, self.hover, self.drag, self.disabled)
}
// The bar slider: label and value above, the groove below.
mod.widgets.SliderFlat.height = 36.0
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let cy = 20.0 + (self.rect_size.y - 20.0) * 0.5
    return fr_slider(p, self.rect_pos, self.rect_size, px, cy, 6.0, self.rect_size.x - 6.0, to, from, self.hover, self.focus, self.drag, self.disabled, 1.0)
}
// The round slider: a capsule well of darker glass beside its label, the
// value a capsule of accent light inside it with a white end, the number
// standing clear to the right of the well.
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let x1 = Finish.snap(o.x + self.rect_size.x - 44.0, px) - o.x
    let c = vec2((x0 + x1) * 0.5, cy)
    let h = vec2((x1 - x0) * 0.5, 5.0)
    let d = Finish.sd_pill(p, c, h)
    let yn = clamp((p.y - cy + 5.0) / 10.0, 0.0, 1.0)
    let ct = Finish.drop(p, c, h, 5.0, vec2(0.0, 0.67), 0.45) * 0.35 * live * (1.0 - Finish.cover(d, px))
    var f = vec4(fr_ink() * ct, ct)
    f = Finish.over(f, fr_well(d, yn, px, 0.28, 0.14 + 0.06 * self.hover, 0.18))
    let ins = 2.0
    let fh = h.y - ins
    let xv = mix(x0 + ins + fh, x1 - ins - fh, self.slide_pos)
    let fd = Finish.sd_pill(p, vec2((x0 + ins + xv + fh) * 0.5, cy), vec2((xv + fh - x0 - ins) * 0.5, fh))
    let fa = Finish.cover(fd, px) * mix(1.0, 0.4, self.disabled)
    let top = Finish.band(fd, 0.0, px, px) * step(p.y, cy)
    let fc = mix(mix(fr_acc(), vec3(0.30, 0.66, 0.86), yn * 0.5), vec3(0.765, 0.937, 0.988), top)
    f = Finish.over(f, vec4(fc * fa, fa))
    let lw = (1.0 - smoothstep(0.2, 0.35, abs((p.x - x0) / max(x1 - x0, 1.0) - 0.5))) * step(cy, p.y) * self.focus * live
    f = mix(f, vec4(fr_acc_line(), 1.0), Finish.band(d, 0.0, px, px) * lw)
    // The white end of the value.
    let ed = length(p - vec2(xv, cy)) - (fh - 0.5)
    let ea = Finish.cover(ed, px) * mix(0.85, 1.0, max(self.hover, self.drag)) * mix(1.0, 0.45, self.disabled)
    return Finish.over(f, vec4(vec3(0.94, 0.975, 1.0) * ea, ea))
}

// FADERS. On his word ('the sliders still look rediculous': the faders'
// glass caps, 'smaller, flatter caps') the cap is a slim, thin slab of
// frosted glass: 21 points along the track and 13 across on a 40 point
// fader, a little wider than the lit value's glow. Its face is flat: what
// lies behind it, blurred, with a milk of frost on it. Over its last point
// and a half it turns down to its edge, a small bevel lit from the upper
// left, and only there does the glass bend what is under it, outward by up
// to a point, as a pane's bevel bends the window. Round its outline one
// device pixel of rim, brightest at the top left, then the bottom right,
// faint between, as on the panes; its corners 2.5 points; a 1 point grip
// line painted across its middle over 0.6 of its half width. It is a point
// and a half thick: it throws a short soft shadow along the key light and a
// contact shadow hugging its foot. The track is a 5 point slot held 8
// points off both ends, the value lit in it from the slot's end to the
// middle of the cap, under its grip line, a tick at every tenth of the
// travel on its far side. Everything is laid out in the fader's own frame
// (`ab`: along the track from the value's zero, up the screen when it
// stands; across it), so SliderFaderY is the same drawing. The cap's length
// is the widget's `cap_size`, which the drag divides by too, so the cap
// still covers its stop at either end of the travel.
mod.widgets.SliderFader.cap_size = 21.0
mod.widgets.SliderFader.track_inset = 8.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.track_size = uniform(5.0)
mod.widgets.SliderFader.draw_bg.cap_cross = uniform(0.325)
mod.widgets.SliderFader.draw_bg.cap_line = uniform(1.0)
// The slab, as uniforms so it tunes live: its corner, its bevel's width
// and the milk of frost on its face; the key light (screen space, x right,
// y down, z out) its shadow is thrown along, its thickness, the cast
// shadow's strength and blur and the contact's; how far the bevel bends
// what is under it, and the frost (roughness), which reads it three times a
// little apart and makes them one; the slot's inner shadow and occlusion;
// exposure in stops and the highlights' roll-off.
mod.widgets.SliderFader.draw_bg.cap_corner = uniform(2.5)
mod.widgets.SliderFader.draw_bg.cap_bevel = uniform(1.5)
mod.widgets.SliderFader.draw_bg.cap_frost = uniform(0.12)
mod.widgets.SliderFader.draw_bg.cap_light = uniform(vec3(-0.3, -0.6, 0.74))
mod.widgets.SliderFader.draw_bg.cap_height = uniform(1.5)
mod.widgets.SliderFader.draw_bg.cap_shadow = uniform(0.3)
mod.widgets.SliderFader.draw_bg.cap_shadow_blur = uniform(3.0)
mod.widgets.SliderFader.draw_bg.cap_contact = uniform(0.35)
mod.widgets.SliderFader.draw_bg.cap_glass_depth = uniform(1.0)
mod.widgets.SliderFader.draw_bg.cap_roughness = uniform(0.44)
mod.widgets.SliderFader.draw_bg.cap_glass_chroma = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_inner = uniform(0.5)
mod.widgets.SliderFader.draw_bg.cap_ao = uniform(0.3)
mod.widgets.SliderFader.draw_bg.cap_exposure = uniform(0.0)
mod.widgets.SliderFader.draw_bg.cap_rolloff = uniform(0.6)
// The glass over the window: on his word ('our frosted glass slider should
// have its shading more like this, so blurring the bg') the slab shows what
// lies behind it, blurred, the way frosted glass over a wallpaper does: the
// fader is drawn twice (the widget's `backdrop`), first the track, the value
// and the ticks with no cap on them, which the window captures with the page
// under them, then the slab alone over that, reading the capture blurred to
// `cap_glass_blur` (0 the scene itself, 1 the first level of its blur) where
// its bevel bends the view. 0.75, on his second word ('the frosted slider is
// now too blurry'): the track and the ground read through it softened, not
// smeared. On a pane of glass (the widget's `backdrop_layer` 2: its track is
// on the pane's overlay, not in the capture) the slab reads the pane under
// it, the window behind the pane as the pane shows it, with the track drawn
// on it. Until there is a capture, and without a backdrop, the slab shows
// the fader's own drawing over the bench's ground.
mod.widgets.SliderFader.backdrop = true
mod.widgets.SliderFader.draw_bg.backdrop_layer = uniform(-1.0)
mod.widgets.SliderFader.draw_bg.cap_glass_blur = uniform(0.75)
// The window behind, bound in this order by the widget: the scene, then
// its pyramid.
mod.widgets.SliderFader.draw_bg.scene_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip0_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip1_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip2_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip3_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip4_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.mip5_texture = texture_2d(float)
mod.widgets.SliderFader.draw_bg.has_gauss = uniform(0.0)
mod.widgets.SliderFader.draw_bg.source_size = uniform(vec2(1.0, 1.0))
mod.widgets.SliderFader.draw_bg.source_y_flip = uniform(0.0)
// The inks, the bench's colours rather than the sheet's cyan: the
// blue-grey ground the fader is drawn over until there is a capture, white
// light, a slate shade, the pale grey grip line, the navy slot, the blue of
// the lit value and the near-white ticks.
mod.widgets.SliderFader.draw_bg.ground_color = uniform(#5b6b8c)
mod.widgets.SliderFader.draw_bg.light_color = uniform(#ffffff)
mod.widgets.SliderFader.draw_bg.shadow_color = uniform(#33405c)
mod.widgets.SliderFader.draw_bg.mark_color = uniform(#f0f0f0)
mod.widgets.SliderFader.draw_bg.track_color = uniform(#2e3a55)
mod.widgets.SliderFader.draw_bg.fill_color = uniform(#3b8bff)
mod.widgets.SliderFader.draw_bg.tick_color = uniform(#dfe6f5)

// How far past its rect the fader's quad reaches, in points: the cap's cast
// shadow, thrown by its height along the key light and then blurred, past
// the cap, which stops at the track's inset ends and never leaves the
// fader's width; the lit value's halo out to twice its wider reach, where a
// few levels of it are left; then the four points over which the edge fades
// out.
let fr_fader_room = fn(rs: vec2, vert: float, inset: float, tw: float, share: float, key_light: vec3, height: float, blur: float) -> float {
    let across = mix(rs.y, rs.x, vert)
    let kl = normalize(key_light)
    let thrown = length(kl.xy) / max(kl.z, 0.25) * height * 0.7 + blur
    let cw = min(max(across * share, 4.0), across)
    let past_cap = max(thrown - inset, cw * 0.5 + thrown - across * 0.5)
    let halo = max(tw * 4.0, 5.0) * 2.0
    let past_value = max(halo - inset, tw * 0.5 + halo - across * 0.5)
    return max(max(past_cap, past_value), 0.0) + 4.0
}

// The fader over the page without painting the page. It is drawn twice:
// over the bench's ground, and over black with the slot's floor black too,
// since that floor is the same ground in shade; what is left over black is
// the fader's own light and ink. Where the two agree the pixel is ink and is
// painted as it is; where they differ, that share of the ground shows
// through, and the page shows through by the least share any channel lets
// through, the rest laid on as light. Premultiplied, as every face of this
// sheet. Over the bench's ground every colour comes out exact. The drawing
// over black is what keeps a darker page right: the bench caps the lit
// value's halo against its lighter ground, so split from the drawing over
// the ground alone, the lip under the lit value came out a dark violet line
// on this page instead of the pale blue one the bench draws.
let fr_over_page = fn(on_ground: vec3, on_black: vec3, gnd: vec3) -> vec4 {
    let through = (on_ground - on_black) / max(gnd, vec3(0.01, 0.01, 0.01))
    let t = clamp(min(through.x, min(through.y, through.z)), 0.0, 1.0)
    return vec4(max(on_ground - gnd * t, vec3(0.0, 0.0, 0.0)), 1.0 - t)
}

// How much of what the fader throws past its rect is left at `p` along one
// axis, where a parent clips it to `lo`..`hi` and the rect spans
// `rlo`..`rhi`. A clip a few points off the fader (a scroll view's edge)
// would cut the halo and the shadow with a hard line, so they fade out over
// the last four points before it, as the quad's own edge fades. The fade
// never reaches into the rect: a fader scrolled half out of its view is cut
// there as everything else is.
let fr_clip_fade = fn(p: float, lo: float, hi: float, rlo: float, rhi: float) -> float {
    let band_lo = clamp(rlo - lo, 0.001, 4.0)
    let band_hi = clamp(hi - rhi, 0.001, 4.0)
    return smoothstep(0.0, band_lo, p - lo) * smoothstep(0.0, band_hi, hi - p)
}

// The B-spline reconstruction the glass family reads its pyramid with (four
// bilinear taps), so a low level stretched under the cap shows no texel
// grid: the two tap places per axis, then the first pair's weight.
let fr_bspline_h = fn(uv: vec2, size: vec2) -> vec4 {
    let tc = uv * size - 0.5
    let f = fract(tc)
    let tc0 = floor(tc)
    let f2 = f * f
    let f3 = f2 * f
    let omf = 1.0 - f
    let w1 = (f3 * 3.0 - f2 * 6.0 + 4.0) / 6.0
    let g0 = omf * omf * omf / 6.0 + w1
    let h0 = clamp((tc0 - 0.5 + w1 / g0) / size, vec2(0.0, 0.0), vec2(1.0, 1.0))
    let h1 = clamp((tc0 + 1.5 + (f3 / 6.0) / (1.0 - g0)) / size, vec2(0.0, 0.0), vec2(1.0, 1.0))
    return vec4(h0.x, h0.y, h1.x, h1.y)
}
let fr_bspline_g0 = fn(uv: vec2, size: vec2) -> vec2 {
    let f = fract(uv * size - 0.5)
    let f2 = f * f
    let omf = 1.0 - f
    return omf * omf * omf / 6.0 + (f2 * f * 3.0 - f2 * 6.0 + 4.0) / 6.0
}

// A displacement in the fader's frame (`ab`) on screen: stood on end, along
// the track runs up the screen.
let fr_frame_to_screen = fn(d: vec2, v: float) -> vec2 {
    return mix(d, vec2(d.y, 0.0 - d.x), v)
}

// THE PANES OF GLASS. A pane shows the window behind it blurred
// (`backdrop_pane`), its light held down so the sheet's near-white ink reads
// on it over the brightest of the ground, and a milk of frost white on that.
let fr_pane_body = fn(back: vec3) -> vec3 {
    let held = back * 0.62 / (vec3(1.0, 1.0, 1.0) + back * 0.95)
    return held + fr_white() * 0.05
}

// The window behind at the screen point `sp`, between the scene itself (0)
// and the first level of its blur (1): what the cap reads. Both are fine
// enough that a plain read shows no texel grid.
mod.widgets.SliderFader.draw_bg.backdrop_fine = fn(level: float, sp: vec2) -> vec3 {
    let q = sp / max(self.source_size, vec2(1.0, 1.0))
    let uv = clamp(vec2(q.x, mix(q.y, 1.0 - q.y, self.source_y_flip)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let t = clamp(level, 0.0, 1.0)
    return mix(self.scene_texture.sample(uv).rgb, self.mip0_texture.sample(uv).rgb, t * t * (3.0 - 2.0 * t))
}

// The window behind at `sp` as a pane shows it: halfway between the fourth
// and the fifth level of its blur (4.5), each read with the B-spline taps so
// the coarse levels show no grid.
mod.widgets.SliderFader.draw_bg.backdrop_pane = fn(sp: vec2) -> vec3 {
    let q = sp / max(self.source_size, vec2(1.0, 1.0))
    let uv = clamp(vec2(q.x, mix(q.y, 1.0 - q.y, self.source_y_flip)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let s3 = max(self.mip3_texture.size(), vec2(1.0, 1.0))
    let h3 = fr_bspline_h(uv, s3)
    let g3 = fr_bspline_g0(uv, s3)
    let k3 = 1.0 - g3
    let c3 = self.mip3_texture.sample(vec2(h3.x, h3.y)) * (g3.x * g3.y) + self.mip3_texture.sample(vec2(h3.z, h3.y)) * (k3.x * g3.y) + self.mip3_texture.sample(vec2(h3.x, h3.w)) * (g3.x * k3.y) + self.mip3_texture.sample(vec2(h3.z, h3.w)) * (k3.x * k3.y)
    let s4 = max(self.mip4_texture.size(), vec2(1.0, 1.0))
    let h4 = fr_bspline_h(uv, s4)
    let g4 = fr_bspline_g0(uv, s4)
    let k4 = 1.0 - g4
    let c4 = self.mip4_texture.sample(vec2(h4.x, h4.y)) * (g4.x * g4.y) + self.mip4_texture.sample(vec2(h4.z, h4.y)) * (k4.x * g4.y) + self.mip4_texture.sample(vec2(h4.x, h4.w)) * (g4.x * k4.y) + self.mip4_texture.sample(vec2(h4.z, h4.w)) * (k4.x * k4.y)
    return mix(c3, c4, 0.5).rgb
}

mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let m = fr_fader_room(self.rect_size, self.is_vertical, self.inset_px, self.track_size, self.cap_cross, self.cap_light, self.cap_height, self.cap_shadow_blur)
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// What lies under the cap at `ab`, in the fader's frame: the ground with the
// slot cut into it and the value in it (lit, `lit_kind` 2, its own light
// with a halo beside the cap; 1 a bar on the slot's floor), and the ticks.
// `base` 1 draws it over the bench's ground, 0 over black with the slot's
// floor black too, for the composite. A glass cap reads this again through
// itself.
mod.widgets.SliderFader.draw_bg.fader_ground = fn(ab: vec2, tbox: vec4, lo: float, hi: float, at: float, hx: float, mid: float, foot: float, travel: float, lt: vec3, px: float, lit_kind: float, fill_ink: vec3, base: float) -> vec3 {
    let tw = tbox.w * 2.0
    // Round ended: the bench's end rounding 1, the whole half width.
    let tr = tbox.w
    let col = Cap.slot(self.ground_color.rgb * base, ab, tbox, tr, lit_kind, lo, hi, at, hx, lt, px, 0.0, 0.0, self.track_color.rgb * base, fill_ink, self.light_color.rgb, self.shadow_color.rgb, self.cap_inner, self.cap_ao)
    return Cap.ticks(col, ab, mid, foot, travel, 10.0, 1.0, 4.0, tw, 0.0, px, self.tick_color.rgb)
}

mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let sz = self.rect_size
    let v = self.is_vertical
    let m = fr_fader_room(sz, v, self.inset_px, self.track_size, self.cap_cross, self.cap_light, self.cap_height, self.cap_shadow_blur)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let qe = self.pos * (sz + vec2(2.0 * m, 2.0 * m))
    let p = qe - vec2(m, m)
    let dis = self.disabled
    let live = 1.0 - dis
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let ab = vec2(mix(p.x, sz.y - p.y, v), mix(p.y, p.x, v))
    let mid = across * 0.5
    // The travel law is the widget's, so what is drawn is what is dragged.
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let at = foot + self.slide_pos * travel
    let hs = vec2(self.cap_px * 0.5, min(max(across * self.cap_cross, 4.0), across) * 0.5)
    // The key light on screen, and turned into the fader's frame for what
    // is laid out in it.
    let l = normalize(self.cap_light)
    let lt = Cap.light(l, v)
    let ground = self.ground_color.rgb
    let black_ground = vec3(0.0, 0.0, 0.0)
    let dark_ink = self.shadow_color.rgb
    // Under the hand and held, the painted line brightens toward the sheet's
    // frost white.
    let mark_ink = mix(self.mark_color.rgb, fr_white(), 0.5 * max(self.hover, self.drag) * live)
    // Disabled, the lamp is out: the value lies on the slot's floor as a
    // bar, faded toward the slot as this sheet fades a disabled value.
    let fill_ink = mix(self.fill_color.rgb, self.track_color.rgb, 0.6 * dis)
    let lit_kind = 2.0 - dis

    // The slot, from the widget's inset to the other; the value from the
    // slot's end (or the default) to the cap, to the slot's far end at the
    // top of the travel.
    let tw = self.track_size
    let tlen = max(along - self.inset_px * 2.0, 1.0)
    let tbox = vec4(self.inset_px + tlen * 0.5, mid, tlen * 0.5, tw * 0.5)
    var lo = foot + self.fill_lo * travel
    var hi = foot + self.fill_hi * travel
    if self.fill_lo < 0.0005 {
        lo = self.inset_px
    }
    if self.fill_hi > 0.9995 {
        hi = along - self.inset_px
    }

    // The slab, wherever it or what it throws can reach. What lies under it
    // is drawn over the bench's ground (`under`) and over black (`under0`),
    // for the composite at the end; the slab is its own ink on any page.
    let q = ab - vec2(at, mid)
    let far = abs(q) - hs
    // Drawn over the window's backdrop (`backdrop_layer` 0 and 1, see
    // `cap_glass_blur`), the body draws everything but the slab and the
    // second layer the slab alone; -1 draws both at once.
    let layer = self.backdrop_layer
    let body_layer = step(-0.5, layer) * (1.0 - step(0.5, layer))
    let cap_layer = step(0.5, layer)
    if cap_layer > 0.5 && max(far.x, far.y) > 2.0 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    // Held, the slab is pressed a quarter point lower.
    let height = self.cap_height - 0.25 * self.drag
    let reach = max(hs.x, hs.y) + height * 2.0 + self.cap_shadow_blur * 1.5 + 4.0
    var under = ground
    var under0 = black_ground
    var cap = ground
    var cov = 0.0
    var sh = 0.0
    if max(far.x, far.y) < reach {
        // Its outline, a rounded box (`fp`: the distance, negative inside,
        // and the outward normal). Over the last `cap_bevel` points in from
        // it the face turns down to the edge (`tilt`: 0 on the flat face, 1
        // at the outline), and only there does the glass bend what is under
        // it, outward along that normal by up to `cap_glass_depth`.
        let r = min(self.cap_corner, min(hs.x, hs.y))
        let fp = Cap.sd_cap(q, hs, r, vec2(1.0, 0.0))
        cov = Finish.cover(fp.x, px)
        let bt = 1.0 - clamp((0.0 - fp.x) / max(self.cap_bevel, 0.001), 0.0, 1.0)
        let tilt = bt * bt
        let disp = fp.yz * (self.cap_glass_depth * tilt * cov) * (1.0 - body_layer)
        if cap_layer * self.has_gauss > 0.5 && cov > 0.001 {
            // Over the backdrop: the window behind the slab, blurred, the
            // track and the value in it, read at three places a little
            // apart (the frost) and made one.
            let bend = Cap.glass_split(disp, hs, self.cap_glass_chroma, self.cap_roughness, cov)
            let sp = self.rect_pos + p
            if layer > 1.5 {
                // On a pane: the pane's own body under the slab, the track
                // laid on it (its ink and how much of the ground it hides,
                // from the drawing over the bench's ground and over black),
                // its edges softened over two and a half device pixels.
                let tm = fr_over_page(self.fader_ground(ab + disp, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px * 2.5, lit_kind, fill_ink, 1.0), self.fader_ground(ab + disp, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px * 2.5, lit_kind, fill_ink, 0.0), self.ground_color.rgb)
                under = tm.rgb + fr_pane_body(self.backdrop_pane(sp + fr_frame_to_screen(disp, v))) * (1.0 - tm.a)
            } else {
                let red = self.backdrop_fine(self.cap_glass_blur, sp + fr_frame_to_screen(bend.xy, v))
                let back = self.backdrop_fine(self.cap_glass_blur, sp + fr_frame_to_screen(disp, v))
                let blue = self.backdrop_fine(self.cap_glass_blur, sp + fr_frame_to_screen(bend.zw, v))
                under = Cap.glass_mix(red, back, blue, self.cap_glass_chroma, self.cap_roughness)
            }
            under0 = under
        } else {
            under = self.fader_ground(ab + disp, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 1.0)
            under0 = self.fader_ground(ab + disp, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 0.0)
            if cov > 0.001 && body_layer < 0.5 {
                let bend = Cap.glass_split(disp, hs, self.cap_glass_chroma, self.cap_roughness, cov)
                let red = self.fader_ground(ab + bend.xy, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 1.0)
                let blue = self.fader_ground(ab + bend.zw, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 1.0)
                under = Cap.glass_mix(red, under, blue, self.cap_glass_chroma, self.cap_roughness)
            }
        }
        // The face: what lies under it under a milk of frost, a little more
        // under the hand, as every cap of this sheet.
        var face = mix(under, fr_white(), self.cap_frost + 0.06 * max(self.hover, self.drag) * live)
        // The bevel, lit from the upper left as the panes' rims are: where
        // it faces the light it is lighter, where it faces away darker.
        let facing = dot(fr_frame_to_screen(fp.yz, v), normalize(vec2(-1.0, -1.0)))
        face = face + fr_white() * (0.14 * tilt * max(facing, 0.0))
        face = face * (1.0 - 0.25 * tilt * max(0.0 - facing, 0.0))
        // The rim: one device pixel inside the outline, brightest at the top
        // left, then the bottom right, faint between.
        let lit = 0.14 + 0.62 * pow(max(facing, 0.0), 2.0) + 0.34 * pow(max(0.0 - facing, 0.0), 2.0)
        face = mix(face, fr_rimc(), Finish.band(fp.x, 0.0, px, px) * lit)
        // The grip line, `cap_line` wide, painted across the middle over 0.6
        // of the half width.
        cap = mix(face, mark_ink, Cap.mark_line(q, hs, vec4(1.0, self.cap_line, 0.35, 0.0), vec4(0.0, 0.5, 0.6, 0.0), px))
        // What it throws: its outline cast by its thickness along the key
        // light and softened, and the contact shadow hugging its foot.
        // Disabled, it is not lifted off the page.
        let top = vec3(1.0, 1.0, r / max(min(hs.x, hs.y), 0.001))
        sh = Cap.shadow(q, hs, r, top, lt, height, self.cap_shadow_blur, self.cap_shadow, px) * live
        sh = sh + Cap.contact(fp.x, max(height * 0.6, 0.75), self.cap_contact)
    } else {
        under = self.fader_ground(ab, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 1.0)
        under0 = self.fader_ground(ab, tbox, lo, hi, at, hs.x, mid, foot, travel, lt, px, lit_kind, fill_ink, 0.0)
    }
    // The shadows darken the ground and what lies on it alike.
    let shadow_k = clamp(sh, 0.0, 1.0) * (1.0 - cov)
    let col = mix(under, under * dark_ink, shadow_k)
    let col0 = mix(under0, under0 * dark_ink, shadow_k)
    // Toned as the bench tones its output, then laid over the page. The
    // body leaves the cap out (what lies under it shows, unshadowed, for the
    // second layer to read); the second layer is the cap alone, opaque.
    let ex = pow(2.0, self.cap_exposure)
    let show = cov * (1.0 - body_layer)
    var res = fr_over_page(Cap.tone(mix(col, cap, show), ex, self.cap_rolloff), Cap.tone(mix(col0, cap, show), ex, self.cap_rolloff), Cap.tone(ground, ex, self.cap_rolloff))
    if cap_layer > 0.5 {
        res = vec4(Cap.tone(cap, ex, self.cap_rolloff) * cov, cov)
    }
    // Disabled, the faded cap shows the page through it as it did, not the
    // track it would otherwise leave under itself.
    res = res * (1.0 - cov * dis * body_layer)
    // The quad's last four points fade out, so the halo ends without an
    // edge, and so do the four before a parent's clip; disabled, the whole
    // fader fades as this sheet fades it.
    let edge_d = min(min(qe.x, qe.y), min(sz.x + 2.0 * m - qe.x, sz.y + 2.0 * m - qe.y))
    let wp = self.rect_pos - vec2(m, m) + qe
    let clip_lo = max(self.draw_clip.xy, self.draw_list.view_clip.xy - self.draw_list.view_shift)
    let clip_hi = min(self.draw_clip.zw, self.draw_list.view_clip.zw - self.draw_list.view_shift)
    let clip_fade = fr_clip_fade(wp.x, clip_lo.x, clip_hi.x, self.rect_pos.x, self.rect_pos.x + sz.x) * fr_clip_fade(wp.y, clip_lo.y, clip_hi.y, self.rect_pos.y, self.rect_pos.y + sz.y)
    return res * smoothstep(0.0, 4.0, edge_d) * clip_fade * mix(1.0, 0.45, dis)
}

// ROTARIES. A frost disc with a rim and a glint on top; a ring well of
// darker glass round its edge in which the value runs as an accent arc
// (no halo at rest, a faint one while turned); a raised frost cap 0.58 of
// the disc with a white pointer.
let fr_arc = fn(q: vec2, r: float, a0: float, a1: float) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let ring = abs(length(q) - r)
    let e0 = vec2(0.0 - sin(a0), cos(a0)) * r
    let e1 = vec2(0.0 - sin(a1), cos(a1)) * r
    let ends = min(length(q - e0), length(q - e1))
    return mix(ends, ring, step(a0, a) * step(a, a1))
}
let fr_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let dia = rad * 2.0
    let b = vec4(c - vec2(rad, rad), c + vec2(rad, rad))
    // The disc: the plate as a circle, with the glint when it is wide.
    var f = fr_plate(p, b, vec4(rad, rad, rad, rad), px, hover, drag, focus, disabled, 0.8, 0.9, 1.0, vec4(0.0, 0.0, 0.0, 0.0), fr_rimc(), fr_white(), 1.0, 0.0, 0.0)
    let q = p - c
    // The glint on a disc 40 points or wider: the top rim rises to white
    // 90 % over the middle 35 % of the upper arc, with a bloom of 0.8 point
    // at 10 % just outside it.
    let dk = length(q) - rad
    let big = step(40.0, dia) * live
    let gk = fr_glint(clamp(q.x / dia + 0.5, 0.0, 1.0)) * big * (1.0 - smoothstep(0.0 - 0.1 * rad, 0.35 * rad, q.y + 0.75 * rad))
    let gb = Finish.band(dk, 0.0, px, px) * gk * 0.9
    f = mix(f, vec4(1.0, 1.0, 1.0, 1.0), gb)
    let gbl = gk * 0.16 * exp(0.0 - dk * dk / 0.64) * (1.0 - Finish.cover(dk, px))
    f = Finish.over(f, vec4(gbl, gbl, gbl, gbl))
    // The ring well, 0.14 of the diameter, inside the rim.
    let wr = rad - 1.5 - dia * 0.07
    let wd = abs(length(q) - wr) - dia * 0.07
    let wy = clamp((p.y - c.y + rad) / dia, 0.0, 1.0)
    f = Finish.over(f, fr_well(wd, 1.0 - wy, px, 0.22, 0.10, 0.10))
    // The value arc, 0.07 of the diameter, in the middle of the well.
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let ad = fr_arc(q, wr, s0, s1) - dia * 0.035
    let hk = 0.15 * max(drag, focus) * live
    let hg = hk * exp(0.0 - max(ad, 0.0) * max(ad, 0.0) / 2.0) * (1.0 - Finish.cover(ad, px))
    f = Finish.over(f, vec4(fr_acc_glow() * hg, hg))
    let aa = Finish.cover(ad, px) * step(0.001, s1 - s0) * mix(1.0, 0.4, disabled)
    f = Finish.over(f, vec4(fr_acc() * mix(0.92, 1.0, max(hover, drag)) * aa, aa))
    // The cap: frost at 1.3 times the face, a brighter rim on top, a contact
    // under it.
    let cr = rad * 0.58
    let cd = length(q) - cr
    let cyn = clamp((p.y - c.y + cr) / (2.0 * cr), 0.0, 1.0)
    let cout = 1.0 - Finish.cover(cd, px)
    let csh = Finish.drop(p, c, vec2(cr, cr), cr, vec2(0.0, 0.9), 1.6) * 0.35 * live * cout
    let cct = Finish.drop(p, c, vec2(cr, cr), cr, vec2(0.0, 0.67), 0.35) * 0.30 * live * cout
    let cs = 1.0 - (1.0 - csh) * (1.0 - cct)
    f = Finish.over(f, vec4(fr_ink() * cs, cs))
    let cw = fr_lift(cyn) * 1.3 + 0.05 * hover - 0.04 * drag
    var cap = vec4(vec3(0.16, 0.19, 0.24) * 0.55, 0.55)
    cap = Finish.over(cap, vec4(fr_white() * cw, cw))
    let crb = Finish.band(cd, 0.0, px, px) * mix(0.70, 0.30, cyn)
    cap = Finish.over(cap, vec4(fr_white() * crb, crb))
    f = Finish.over(f, cap * Finish.cover(cd, px))
    // The pointer: a white line a quarter of the disc long, from near the
    // cap's rim inward.
    let dir = vec2(0.0 - sin(av), cos(av))
    let pd = fr_seg(q, dir * (cr - 1.5), dir * (cr - 1.5 - dia * 0.25)) - 0.75
    let pa = Finish.cover(pd, px) * 0.9 * mix(1.0, 0.45, disabled)
    return Finish.over(f, vec4(pa, pa, pa, pa))
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0) - 8.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 22.0 + 4.0 + dia * 0.5, px)) - self.rect_pos
    return fr_knob(p, c, dia * 0.5, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let dia = min(self.rect_size.x, self.rect_size.y) - 6.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - 3.0 - dia * 0.5, px)) - self.rect_pos
    return fr_knob(p, c, dia * 0.5, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_text.color = #b9c0ca
mod.widgets.RotaryKnob.draw_text.color_hover = #eef4fb
mod.widgets.RotaryKnob.draw_text.color_focus = #eef4fb
mod.widgets.RotaryKnob.draw_text.color_drag = #ffffff
mod.widgets.RotaryKnob.draw_text.color_disabled = #5d6572
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A recessed frost: thinner frost than a button, a dark pixel
// along its head, quieter light up its sides and along its foot, the
// contact line and the dark line outside. A focus lights one device pixel
// of cyan along the foot with a glow into the face, and a soft halo. A
// field whose frame is switched off (the value inside a slider) draws
// nothing.
let fr_field = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hover: float, focus: float, disabled: float) -> vec4 {
    let b = fr_snap(o, s, px)
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / max(hi.x - lo.x, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    let ct = Finish.drop(p, c, h, r, vec2(0.0, 0.67), 0.45) * 0.30 * live
    let dl = Finish.ring_out(d, 0.0, px, px) * 0.25
    let sh = (1.0 - (1.0 - ct) * (1.0 - dl)) * outside
    var f = vec4(fr_ink() * sh, sh)
    let hg = Finish.drop(p, c, h, r, vec2(0.0, 1.0), 2.4) * 0.35 * focus * live * outside
    f = Finish.over(f, vec4(fr_acc_glow() * hg, hg))
    // The face: a faint frost, head to foot 0.09 to 0.05, lifted by the hand.
    let wa = mix(0.09, 0.05, yn) + 0.03 * hover + 0.02 * focus
    var g = vec4(fr_white() * wa, wa)
    let lw = (1.0 - smoothstep(0.2, 0.35, abs(xn - 0.5))) * smoothstep(0.55, 0.9, yn) * focus * live
    let fin = exp(0.0 - max(0.0 - d - px, 0.0) / 1.2) * 0.40 * lw
    g = Finish.over(g, vec4(fr_acc_glow() * fin, fin))
    let fbl = lw * exp(0.0 - (d * d) / 1.1) * 0.40 * outside
    f = Finish.over(f, vec4(fr_acc_line() * fbl * 0.6, fbl))
    // The edge: black 40 % on the head, white 25 % up the sides (more with a
    // focus), white 16 % along the foot.
    let rb = Finish.band(d, 0.0, px, px)
    let head = rb * (1.0 - smoothstep(0.15, 0.35, yn))
    let low = rb * smoothstep(0.65, 0.85, yn)
    let mid = rb * (1.0 - max(1.0 - smoothstep(0.15, 0.35, yn), smoothstep(0.65, 0.85, yn)))
    g = Finish.over(g, vec4(0.0, 0.0, 0.0, 0.40 * head))
    let l = (0.16 + 0.06 * hover) * low + (0.25 + 0.08 * hover + 0.15 * focus) * mid
    g = Finish.over(g, vec4(fr_white() * l, l))
    g = mix(g, vec4(fr_acc_line(), 1.0), rb * lw)
    f = Finish.over(f, g * inside)
    return f * mix(1.0, 0.4, disabled)
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.border_size < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fr_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.focus, self.disabled)
}
mod.widgets.TextInputFlat.draw_text.color = #eef4fb
mod.widgets.TextInputFlat.draw_text.color_empty = #9aa4b2
mod.widgets.TextInputFlat.draw_text.color_disabled = #5d6572
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fr_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.focus, self.disabled)
}
// The stepper: two frost keys joined at the field's right end, a white
// hairline at 10 % between them; the key under the hand lifts, the held
// key settles.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let b = fr_snap(o + vec2(1.0, 2.0), self.rect_size - vec2(3.0, 4.0), px) + vec4(1.0, 2.0, 1.0, 2.0)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 3.0)
    let mid = Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let live = 1.0 - self.disabled
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let down = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let yn = clamp((p.y - b.y) / max(b.w - b.y, 1.0), 0.0, 1.0)
    let wa = fr_lift(yn) * 0.8 + 0.06 * hot * (1.0 - down) - 0.05 * down
    var f = vec4(fr_white() * wa, wa)
    let rb = Finish.band(d, 0.0, px, px) * fr_rim(yn, 0.5, 0.55)
    f = Finish.over(f, vec4(fr_white() * rb, rb))
    let dv = Finish.cover(abs(p.y - mid) - px * 0.5, px) * step(b.x + 3.0, p.x) * step(p.x, b.z - 3.0) * 0.10
    f = Finish.over(f, vec4(fr_white() * dv, dv))
    // The marks: stroked chevrons 6 by 3.5 points in a 1.25 point stroke,
    // #d8e0ea, each centred in its own key (the font's solid triangles are
    // switched off below).
    let cx = (b.x + b.z) * 0.5
    let cu = vec2(cx, (b.y + mid) * 0.5)
    let cl = vec2(cx, (mid + b.w) * 0.5)
    let up = min(fr_seg(p, cu + vec2(-3.0, 1.75), cu + vec2(0.0, -1.75)), fr_seg(p, cu + vec2(0.0, -1.75), cu + vec2(3.0, 1.75)))
    let dn = min(fr_seg(p, cl + vec2(-3.0, -1.75), cl + vec2(0.0, 1.75)), fr_seg(p, cl + vec2(0.0, 1.75), cl + vec2(3.0, -1.75)))
    let ca = Finish.cover(min(up, dn) - 0.625, px) * mix(1.0, 0.45, self.disabled)
    f = Finish.over(f, vec4(vec3(0.847, 0.878, 0.918) * ca, ca))
    return f * Finish.cover(d, px) * mix(1.0, 0.4, self.disabled)
}
mod.widgets.NumberSpin.width = 20.0
mod.widgets.NumberField.spin_width = 20.0
mod.widgets.NumberSpin.draw_text.color = #0000
mod.widgets.NumberSpin.draw_text.color_disabled = #0000

// The drag-number of a toolbar: the recessed frost, the dragged amount a
// wash of accent light across it, the digits near-white.
mod.widgets.ValueInput.clip_x = false
mod.widgets.ValueInput.clip_y = false
mod.widgets.ValueInput.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let f = fr_field(p, self.rect_pos, self.rect_size, px, 4.0, max(self.hover, self.drag), self.focus, 0.0)
    let d = Material.sd_box(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(px, px), 4.0)
    let wash = step(0.0, self.fill) * step(p.x, (self.rect_size.x) * max(self.fill, 0.0)) * Finish.cover(d, px) * 0.20
    return Finish.over(f, vec4(fr_acc() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #eef4fb
mod.widgets.ValueInput.arrow_color = #b9c0ca
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// DROP-DOWNS. The button's frost at a 4 point corner, with a chevron 8 by
// 4.5 in a 1.25 point stroke, 10 points in from the right; open, the foot
// lights as a focus does.
let fr_chevron = fn(under: vec4, p: vec2, s: vec2, px: float, live: float) -> vec4 {
    let c = vec2(s.x - 14.0, s.y * 0.5)
    let ch = min(fr_seg(p, c + vec2(-4.0, -1.75), c + vec2(0.0, 1.75)), fr_seg(p, c + vec2(0.0, 1.75), c + vec2(4.0, -1.75)))
    let a = Finish.cover(ch - 0.625, px) * mix(0.4, 1.0, live)
    return Finish.over(under, vec4(vec3(0.847, 0.878, 0.918) * a, a))
}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.padding.left = 10.0
mod.widgets.DropDownFlat.padding.right = 26.0
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(8.0, 8.0), self.rect_size + vec2(16.0, 16.0))
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(16.0, 16.0)) - vec2(8.0, 8.0)
    let r = self.border_radius
    let f = fr_button(p, self.rect_pos, self.rect_size, px, vec4(r, r, r, r), self.hover, self.down * self.hover, max(self.focus, self.active), self.disabled, 1.0, 1.0, 1.0, fr_rimc(), 0.0)
    return fr_chevron(f, p, self.rect_size, px, 1.0 - self.disabled)
}
