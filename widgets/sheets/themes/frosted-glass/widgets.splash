mod.widgets.SegmentedControl.segment_height = 22.0
mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = vec2(floor((self.rect_pos.x + self.rect_size.x) / px) * px - self.rect_pos.x, floor((self.rect_pos.y + self.rect_size.y) / px) * px - self.rect_pos.y)
    return fr_strip(self.pos * self.rect_size, self.rect_pos, s - vec2(px, px), px, 4.0)
}
// The chip's quad grows 4 points so the bar's halo can fall below it.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    return fr_chip(p, self.rect_pos, self.rect_size, px, 0.0, 3.0, 0.0, 0.0, 0.0, 1.0, 1.0)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #b9c0ca
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #ffffff

// ---------------------------------------------------------------------------
// THE GROUND under everything: the window's own face, on his word ('can
// you generate a random frame from this shader and put it in the
// background'): one still frame of his slow volumetric fluid in white and
// blue, at the time 80.06 (the first of a seeded random draw, chosen over
// seven others for its structure: a broad blue body with white light on its
// flanks and black between). Evaluated per pixel in the frame's own
// coordinates, the window's height one and its middle the origin, y up, so
// it is the same frame at any window size and never stretched; nothing in it
// moves.
let fr_fluid_turn = fn(v: vec2, a: float) -> vec2 {
    let c = cos(a)
    let s = sin(a)
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c)
}
let fr_fluid_dist = fn(q: vec3, t: float) -> float {
    let xz = fr_fluid_turn(vec2(q.x, q.z), t * 0.4)
    let xy = fr_fluid_turn(vec2(xz.x, q.y), t * 0.3)
    let p = vec3(xy.x, xy.y, xz.y)
    let a = p * 2.0 + vec3(t, t, t)
    let o = sin(t * 0.7)
    return length(p + vec3(o, o, o)) * log(length(p) + 1.0) + sin(a.x + sin(a.z + sin(a.y))) * 5.5 - 1.0
}
let fr_fluid = fn(uv: vec2, t: float) -> vec3 {
    let base = mix(vec3(0.15, 0.45, 0.95), vec3(1.0, 1.0, 1.0), smoothstep(-0.65, 0.65, uv.y))
    let dir = normalize(vec3(0.0 - uv.y, uv.x, -1.0))
    var acc = vec3(0.0, 0.0, 0.0)
    var march = 0.9
    for i in 0..6 {
        let q = vec3(0.0, 0.0, 5.0) + dir * march
        let d = fr_fluid_dist(q, t)
        let d2 = fr_fluid_dist(q + vec3(0.1, 0.1, 0.1), t)
        let dens = clamp((d - d2) * 0.5, -0.5, 0.5)
        let light = base * 0.5 + vec3(2.0, 2.0, 2.0) * dens
        let shade = 1.0 - smoothstep(0.0, 1.5, d)
        acc = acc * light + light * (shade * 0.7)
        march = march + min(d, 1.0)
    }
    return acc
}
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let sz = max(self.rect_size, vec2(1.0, 1.0))
    let p = self.pos * sz
    let uv = vec2(p.x - 0.5 * sz.x, 0.5 * sz.y - p.y) / sz.y
    let col = clamp(fr_fluid(uv, 80.06), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0))
    return vec4(col, 1.0)
}

// SEPARATORS: a single hairline of white at 10 %, eight points short of each
// end; no dark partner line, which would make a groove.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let l = step(y, p.y) * step(p.y, y + px) * step(8.0, p.x) * step(p.x, self.rect_size.x - 8.0) * 0.10
    return vec4(fr_white() * l, l)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let l = step(x, p.x) * step(p.x, x + px) * step(8.0, p.y) * step(p.y, self.rect_size.y - 8.0) * 0.10
    return vec4(fr_white() * l, l)
}

// ---------------------------------------------------------------------------
// SURFACES. A panel is a large sheet of frost, radius 12: white 10 % at the
// head to 6 % at the foot, a 6 point band of light under the top rim, the
// rim at 0.45 to 0.25, the glint over the middle of its top edge with a
// short bloom, a far shadow 4 points down, the contact and the dark line.
// An inset panel is darker glass, sunk into the page.
let fr_panel = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, sunken: float, lift: float, frost: float) -> vec4 {
    let b = fr_snap(o, s, px)
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / max(hi.x - lo.x, 1.0), 0.0, 1.0)
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    let raised = 1.0 - sunken
    let fa = Finish.drop(p, c, h, r, vec2(0.0, 4.0), 5.5) * 0.40 * raised * lift
    let ct = Finish.drop(p, c, h, r, vec2(0.0, 0.67), 0.5) * 0.35 * raised
    let dl = Finish.ring_out(d, 0.0, px, px) * 0.25
    let sh = (1.0 - (1.0 - fa) * (1.0 - ct) * (1.0 - dl)) * outside
    var f = vec4(fr_ink() * sh, sh)
    // The glint's bloom above the top edge.
    let gw = fr_glint(xn) * step(80.0, hi.x - lo.x) * raised * frost
    let bl = gw * 0.25 * exp(0.0 - (d * d) / 2.0) * outside * step(p.y, c.y)
    f = Finish.over(f, vec4(bl, bl, bl, bl))
    // The body.
    let depth = 0.0 - d
    var g = vec4(0.0, 0.0, 0.0, 0.16 * sunken)
    let wa = (mix(0.10, 0.06, yn) + (1.0 - clamp(depth / 6.0, 0.0, 1.0)) * (1.0 - smoothstep(0.0, 0.5, yn)) * 0.06) * raised * frost + 0.03 * sunken
    g = Finish.over(g, vec4(fr_white() * wa, wa))
    // The glass sheen at half a button's strength, on raised panels only.
    let ww = hi.x - lo.x
    let sp = p - vec2(lo.x + 0.62 * ww, lo.y)
    let su = dot(sp, vec2(0.866, 0.5))
    let sw = 0.35 * (hi.y - lo.y)
    let sa = Finish.cover(su, px) * smoothstep(0.0 - sw, 0.0 - 0.25 * sw, su) * 0.028 * raised * min(frost, 1.0)
    g = Finish.over(g, vec4(fr_white() * sa, sa))
    // A sunken panel: black 40 % along its head, white 12 % along its foot.
    let rb = Finish.band(d, 0.0, px, px)
    let head = rb * (1.0 - smoothstep(0.0, 0.1, yn)) * sunken
    g = Finish.over(g, vec4(0.0, 0.0, 0.0, 0.40 * head))
    // The rim: 0.45 on top, 0.25 at the foot; the glint on the top edge.
    // The top rim runs at 60 % of the glint at its ends, as a lit edge does.
    let ra = mix(mix(0.42, 0.25, smoothstep(0.0, 1.0, yn)) + 0.02 - 0.04 * xn, 0.95, gw * (1.0 - smoothstep(0.0, 0.05, yn)))
    let rs = mix(ra, mix(0.0, 0.12, smoothstep(0.5, 1.0, yn)) + 0.08 * (1.0 - abs(yn * 2.0 - 1.0)), sunken)
    g = Finish.over(g, vec4(fr_white() * rb * rs, rb * rs))
    let gr = fr_grain(p / px, 0.9 / 255.0) * g.a
    g = vec4(g.rgb + vec3(gr, gr, gr), g.a)
    return Finish.over(f, g * inside)
}
mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(14.0, 14.0), self.rect_size + vec2(28.0, 28.0))
}
// On his word ('put the ui on frosted glass panels that blur this bg where
// there is ui, but leave some parts still visible') a panel is a pane of
// glass (the widget's `backdrop`): the ground behind it blurred
// (`backdrop_pane`), its light held down and a milk of frost white
// (`fr_pane_body`), bent outward over the last ten points to its edge, up to
// six at the edge, so the blurred ground bends at the rim; one device pixel
// of rim, brightest at the top left, then the bottom right, faint between;
// radius 12, no shadow. Between the panes the ground stays sharp. An inset
// panel stays the darker well it was, on the pane. Until there is a capture
// a pane is the same body over a mid grey, opaque, so its ink reads.
mod.widgets.PanelView.backdrop = true
// The gutter a splitter keeps between two panes is the gap where the ground
// shows: clear, its bar only under the hand.
mod.widgets.Splitter.draw_bg.color_bg = #0000
mod.widgets.InsetPanelView.backdrop = false
mod.widgets.PanelView.draw_bg.scene_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip0_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip1_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip2_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip3_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip4_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.mip5_texture = texture_2d(float)
mod.widgets.PanelView.draw_bg.has_gauss = uniform(0.0)
mod.widgets.PanelView.draw_bg.source_size = uniform(vec2(1.0, 1.0))
mod.widgets.PanelView.draw_bg.source_y_flip = uniform(0.0)
mod.widgets.PanelView.draw_bg.backdrop_pane = mod.widgets.SliderFader.draw_bg.backdrop_pane
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(28.0, 28.0)) - vec2(14.0, 14.0)
    if self.sunken > 0.5 {
        return fr_panel(p, self.rect_pos, self.rect_size, px, 8.0, 1.0, 1.0, 1.0)
    }
    let r = 12.0
    let b = fr_snap(self.rect_pos, self.rect_size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let gx = Material.sd_box(p + vec2(0.5, 0.0), c, h, r) - Material.sd_box(p - vec2(0.5, 0.0), c, h, r)
    let gy = Material.sd_box(p + vec2(0.0, 0.5), c, h, r) - Material.sd_box(p - vec2(0.0, 0.5), c, h, r)
    let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    let bevel = 1.0 - clamp(max(0.0 - d, 0.0) / 10.0, 0.0, 1.0)
    var body = fr_pane_body(vec3(0.3, 0.3, 0.3))
    if self.has_gauss > 0.5 {
        body = fr_pane_body(self.backdrop_pane(self.rect_pos + p + n * (6.0 * bevel * bevel)))
    }
    let tl = normalize(vec2(-1.0, -1.0))
    let lit = 0.14 + 0.62 * pow(max(dot(n, tl), 0.0), 2.0) + 0.34 * pow(max(dot(n, vec2(0.0, 0.0) - tl), 0.0), 2.0)
    let rim = Finish.band(d, 0.0, px, px) * lit
    let g = fr_grain(p / px, 0.9 / 255.0)
    let col = mix(body + vec3(g, g, g), fr_rimc(), rim)
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}
// A card is a panel too: elevated it floats with the far shadow; filled
// it lies on the page with a denser frost; outlined it is the rim alone.
// A pressable one lifts under the pointer.
mod.widgets.Card.radius = 12.0
// The panel's pad on every side, and the title on the body's left edge.
mod.widgets.Card.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 10.0 bottom: 12.0}
mod.widgets.CardHeader.padding = mod.turtle.Inset{left: 5.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(14.0, 14.0), self.rect_size + vec2(28.0, 28.0))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(28.0, 28.0)) - vec2(14.0, 14.0)
    let lift = clamp(self.shadow_radius / 4.0, 0.0, 1.0)
    let outlined = step(0.01, self.border_size) * (1.0 - lift)
    let frost = mix(mix(1.5, 1.0, lift), 0.0, outlined)
    let f = fr_panel(p, self.rect_pos, self.rect_size, px, self.border_radius, 0.0, lift, frost)
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, self.border_radius)
    let layer = (0.05 * self.hover - 0.03 * self.down) * Finish.cover(d, px)
    return Finish.over(f, vec4(fr_white() * max(layer, 0.0), max(layer, 0.0)))
}
// The rounded view keeps its caller's colours; its edge is a true device
// pixel and its fill is dithered.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lower = vec2(self.border_inset.x, self.border_inset.y)
    let upper = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lower + upper) * 0.5
    let h = max((upper - lower) * 0.5, vec2(0.5, 0.5))
    let d = Material.sd_box(p, c, h, min(2.0 * max(1.0, self.border_radius), min(h.x, h.y)))
    var fill = self.color
    if self.color_2.x > -0.5 {
        let dir = if self.gradient_fill_horizontal > 0.5 self.pos.x else self.pos.y
        fill = mix(self.color, self.color_2, dir)
    }
    var stroke = self.border_color
    if self.border_color_2.x > -0.5 {
        let dir = if self.gradient_border_horizontal > 0.5 self.pos.x else self.pos.y
        stroke = mix(self.border_color, self.border_color_2, dir)
    }
    let g = fr_grain(p / px, 1.0 / 255.0) * fill.a
    var col = vec4(fill.rgb * fill.a + vec3(g, g, g), fill.a)
    let bw = max(self.border_size, px) * step(0.001, self.border_size)
    let edge = Finish.band(d, 0.0, bw, px) * stroke.a
    col = mix(col, vec4(stroke.rgb, 1.0), edge)
    return col * Finish.cover(d, px)
}

// LIST ROWS. 24 points, contiguous on the glass, no separators: the row under
// the hand is white 6 %, the chosen row white 12 % with a top rim of white
// 25 %, both three points in and radius 3.
mod.widgets.ListItem.height = 24.0
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let b = fr_snap(self.rect_pos + vec2(3.0, 1.0), self.rect_size - vec2(6.0, 2.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 3.0)
    let live = 1.0 - self.disabled
    let wa = max(0.06 * self.hover + 0.04 * self.down, 0.12 * self.selected) * live
    var f = vec4(fr_white() * wa, wa)
    let top = Finish.band(d, 0.0, px, px) * (1.0 - smoothstep(0.0, 0.3, (p.y - b.y) / max(b.w - b.y, 1.0))) * 0.25 * self.selected * live
    f = Finish.over(f, vec4(fr_white() * top, top))
    return f * Finish.cover(d, px)
}
mod.widgets.ListItem.draw_text.color = #eef4fb

// The value field beside a dial is a small frost readout: the recessed
// frost of a field, the number in the base monospace, no glow.
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 5.0 right: 5.0 top: 3.0 bottom: 3.0}
mod.widgets.RotaryFlat.text_input.draw_text.color = #eef4fb
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 8.0}
mod.widgets.RotaryFlat.text_input.draw_selection.color = #0000
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fr_field(p, self.rect_pos, self.rect_size, px, 3.0, self.hover, self.focus, self.disabled)
}
// The value inside a slider is bare: the field row's height must not reach
// it, or its text drops below the groove's line.
mod.widgets.SliderMinimal.text_input.min_height = 0.0
mod.widgets.SliderFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderMinimal.text_input.draw_text.color = #b9c0ca
mod.widgets.SliderFlat.text_input.draw_text.color = #b9c0ca
mod.widgets.SliderRoundFlat.text_input.draw_text.color = #b9c0ca

// CHIPS AND BADGES. A chip is a small frost pill with its rim; the pointer
// lifts it, a press settles it. A badge is a frost pill too, tinted a
// little by its meaning, with the near-white ink.
let fr_pill = fn(p: vec2, o: vec2, s: vec2, px: float, tint: vec4, hover: float, down: float) -> vec4 {
    let b = fr_snap(o + vec2(0.5, 0.5), s - vec2(1.0, 1.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Finish.sd_pill(p, c, h)
    let yn = clamp((p.y - b.y) / max(b.w - b.y, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - b.x) / max(b.z - b.x, 1.0), 0.0, 1.0)
    let inside = Finish.cover(d, px)
    let ct = Finish.drop(p, c, h, h.y, vec2(0.0, 0.67), 0.45) * 0.40 * (1.0 - inside)
    var f = vec4(fr_ink() * ct, ct)
    var g = tint
    let wa = fr_lift(yn) * 0.9 + 0.05 * hover - 0.04 * down
    g = Finish.over(g, vec4(fr_white() * wa, wa))
    let rb = Finish.band(d, 0.0, px, px) * fr_rim(yn, xn, mix(0.55, 0.70, hover)) * 0.9
    g = Finish.over(g, vec4(fr_white() * rb, rb))
    return Finish.over(f, g * inside)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let a = self.color.a * 0.25
    return fr_pill(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, vec4(self.color.rgb * a, a), self.hover, self.down)
}
mod.widgets.BadgeFlat.palette.neutral = #4a5363
mod.widgets.BadgeFlat.palette.on_neutral = #eef4fb
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let a = self.color.a * 0.30
    return fr_pill(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, vec4(self.color.rgb * a, a), 0.0, 0.0)
}
// The spinner keeps its own turning face, in the accent.
mod.widgets.SpinnerFlat.draw_bg.color = #5fcff5


// ---------------------------------------------------------------- band

// THE BAND is the sheet's own slider with two thumbs: the same track, the
// same lit value and the same thumb as the Slider, the value lit between
// the two thumbs, its quad grown as the slider's is so the thumbs keep
// their shape. The widget's grab geometry is set to the thumbs' own, so
// what is drawn is what is dragged.
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.track_inset = 0.0
mod.widgets.RangeSliderFlat.handle_size = 12.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let cy = self.label_px + (self.rect_size.y - self.label_px) * 0.5
    let far = fr_slider(p, self.rect_pos, self.rect_size, px, cy, 6.0, self.rect_size.x - 6.0, self.end_pos, self.start_pos, self.hot_end, self.focus, self.drag * self.hot_end, self.disabled, 1.0)
    let near = fr_slider(p, self.rect_pos, self.rect_size, px, cy, 6.0, self.rect_size.x - 6.0, self.start_pos, self.end_pos, self.hot_start, self.focus, self.drag * self.hot_start, self.disabled, 1.0)
    let mid = 6.0 + (self.start_pos + self.end_pos) * 0.5 * (self.rect_size.x - 12.0)
    return mix(near, far, step(mid, p.x))
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES are the sheet's own toggle, in proportion with the
// labels and the controls beside them: the rocker and the slide switch
// take the toggle's face, its size and shape, its quad and its label
// gap (the library's own faces for them are flat boxes sized for
// another face). The rocker turns on a click; the slide switch follows a
// drag, as the toggle does.
mod.widgets.ToggleRocker.label_walk.margin.left = 28.0
mod.widgets.ToggleSlide.label_walk.margin.left = 28.0
mod.widgets.ToggleRocker.draw_bg.size = uniform(16.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(16.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(1.75)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(1.75)
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel
mod.widgets.ToggleSlide.draw_bg.pixel = mod.widgets.ToggleFlat.draw_bg.pixel

// THE METER sits in the same window as the readouts and the screen: the
// library's display housing drawn round its face -- the bezel ring, a shade
// of whatever ground it is set in with a device pixel of dark at its edge;
// the face with the surround's shadow falling across it from the top and a
// device pixel of black where the glass meets the bezel; the glass's quiet
// diagonal band and the light line inside its top edge; the lip of light on
// the ground under it -- with the same corner, so the meter and the
// readouts read as one family. The scale, the red zone, the needle and its
// pivot are the library's own.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(theme.corner_radius * 0.5)
mod.widgets.NeedleMeter.draw_bg.color_bezel = uniform(theme.color_d_05)
mod.widgets.NeedleMeter.draw_bg.color_lip = uniform(theme.color_u_15)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.border_radius, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, r_out)
    let b = Finish.snap(2.0, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(r_out - b, 0.0)
    let face_d = Material.sd_box(p, c, hf, rf)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    var face = self.color.rgb
    // The scale: a hairline arc and a tick at every division.
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    face = mix(face, self.color_scale.rgb, max(arc, tick))
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        face = mix(face, self.color_zone.rgb, zone_t * zone_r)
    }
    // The needle, from under the pivot cover to just past the scale.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - px * 0.5, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - max(self.pivot_size - px, 0.0), px)
    face = mix(face, self.color_needle.rgb, needle)
    let pd = r - self.pivot_size
    face = mix(face, mix(self.color_needle.rgb, self.color.rgb, 0.35), Finish.cover(pd, px))
    face = mix(face, face * 0.55, Finish.band(pd, 0.0, px, px))
    // The housing: the surround's shadow across the face from the top, the
    // black device pixel at the glass's edge, and the glass over it all.
    let insh = Finish.inset(p, c, hf, rf, vec2(0.0, 2.0), 1.8)
    face = face * (1.0 - 0.55 * insh)
    face = mix(face, face * 0.4, Finish.band(face_d, 0.0, px, px))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let top = Finish.cover(abs(p.y - (c.y - hf.y) - px * 1.5) - px * 0.5, px) * 0.6
    let ga = clamp(0.03 * (band + top), 0.0, 1.0) * Finish.cover(face_d + px, px)
    face = face * (1.0 - ga) + vec3(ga, ga, ga)
    let bz = self.color_bezel
    var col = vec4(bz.rgb * bz.a, bz.a)
    col = Finish.over(col, vec4(0.0, 0.0, 0.0, 0.45 * Finish.band(outer, 0.0, px, px)))
    col = mix(col, vec4(face, 1.0), Finish.cover(face_d, px))
    col = col * Finish.cover(outer, px)
    let lip = Finish.ring_out(outer, 0.0, px, px) * step(hi.y, p.y)
    let la = self.color_lip.a * lip
    return Finish.over(vec4(self.color_lip.rgb * la, la), col) * self.color.a * self.opacity
}

// ---------------------------------------------------------------- lamps
// LAMPS: an LED, as the hardware in his pictures has them. The emitter is
// the light: at full current its middle burns toward white and its rim is
// its most saturated colour; at lower current the middle is no longer
// white, the colour deeper, the glow smaller; out, it is dark tinted glass,
// its colour barely there. Round it a bezel: a raised ring lit from the
// upper left, or a socket cut into the surface, its upper wall in shadow
// and a catch light on its lower rim. Over the lens one crisp highlight of
// a dome. Its light is added, never painted: a tight hot halo and a short
// bloom in its own hue, screened over whatever is there and gone in about
// two radii; on a pale ground, where light can barely brighten, its hue is
// also laid round it as a tint that keeps the ground's luminance (the
// library's halo rule: at most 0.45 one device pixel out, halving every
// 0.4 of its reach, gone at the reach), so it never darkens or greys its
// ground. A bar is the same light drawn out into a light pipe.
let fr_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let fr_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let fr_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = fr_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c` (round when the
// two are equal), `lit` its current 0..1, `ink` its colour and `vivid` how
// far its chroma is raised, `ground` what shows through where nothing is
// drawn, `room` how far its light may reach, `bez` and `raised` its bezel
// (raised 0: a recess cut in what is under it; 1: a raised ring of `bez`;
// 2: the same ring polished metal). Premultiplied over `dst`.
let fr_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, bez: vec3, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.3 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = fr_led_lamp_full(ink)
    let hue = fr_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    // The lens's own frame: `q` in lens radii from its centre line, `t` its
    // distance out, `nrm` the way its outline faces.
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the bead and its bezel throw on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.22 * rt + 0.3), 0.32 * rt + px) * mix(0.18, 0.34, min(raised, 1.0)) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(ground * 0.4 * shd, shd))
    if L > 0.001 && pale > 0.001 {
        // The tint, on a pale ground only: its hue laid over, never darker.
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The bezel: raised, a ring of `bez` rounded over, lit from the upper
    // left; or a socket cut into what is under it, its upper wall in shadow
    // and a catch light on its lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    let metal = clamp(raised - 1.0, 0.0, 1.0)
    var rc = bez * (0.94 + mix(0.12, 0.55, metal) * facing)
    rc = mix(rc, min(bez + vec3(0.30, 0.30, 0.30), white), smoothstep(mix(0.35, 0.55, metal), 0.9, facing) * mix(0.6, 0.85, metal))
    rc = mix(rc, rc * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.0, 0.8, nrm.y) * 0.8)
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = min(mix(sc, rc, min(raised, 1.0)), white)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, gone in
    // about two radii, falling on the bezel too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = fr_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass. Its colour deepens toward
    // the top; light pools low inside, where it comes through the dome; lit,
    // its middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass on a dark ground, a grey bead on a pale one,
    // its colour barely there, the same dome, a catch light along its lower
    // rim.
    let offc = mix(mix(vec3(0.085, 0.09, 0.115), ground * 0.62, pale), b * 0.4, 0.12)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl * (1.0 - 0.5 * pale)
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    // One crisp highlight: a white oval across its upper third.
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    // Out, a faint seam where the dome meets its bezel; lit, none: the rim
    // is the colour.
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp: the lamp above, here in a ring of frosted glass.
// The halo's room is held in the lamp's own box (the library reserves a
// lens thickness either side once a halo is asked for), so the light is
// never cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    let half_len = max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5)
    // The lens is the lamp's size; its socket stands round it in the room.
    let hb = vec2(mix(t * 0.5, half_len, self.bar), t * 0.5)
    let res = fr_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.102, 0.125, 0.169), max(room - 0.5, 2.0), vec3(0.42, 0.47, 0.55), 1.0)
    return res * self.opacity
}
true
