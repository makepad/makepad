mod.theme = mod.themes.dark

// Frosted glass cards over a dark ground.
// Thin sheets of frost float over a cool night gradient with two soft pools
// of colour: a sheet is the ground lifted by a few percent of white, cut by
// one hairline rim that is brighter on top, with a soft far shadow and a
// dark contact line under it. Cyan light is the one accent.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #1a202b
mod.theme.color_fg_app = #1a202b
mod.theme.color_bg_container = #222a37
mod.theme.color_surface_container_lowest = #141922

// Raised faces: buttons, handles, tabs. Frost a few percent over the ground,
// lighter at the head than at the foot.
mod.theme.color_outset = #343c4a
mod.theme.color_outset_1 = #3e4551
mod.theme.color_outset_2 = #333a47
mod.theme.color_outset_hover = #3c4452
mod.theme.color_outset_1_hover = #464e5b
mod.theme.color_outset_2_hover = #3a4250
mod.theme.color_outset_down = #2c333f
mod.theme.color_outset_1_down = #343b47
mod.theme.color_outset_2_down = #2b313d
mod.theme.color_outset_focus = #343c4a
mod.theme.color_outset_1_focus = #3e4551
mod.theme.color_outset_2_focus = #333a47
mod.theme.color_outset_active = #3d5d85
mod.theme.color_outset_disabled = #232a35
mod.theme.color_outset_1_disabled = #232a35
mod.theme.color_outset_2_disabled = #232a35

// Wells: fields, tracks, boxes. Darker glass, not holes.
mod.theme.color_inset = #141922
mod.theme.color_inset_1 = #141922
mod.theme.color_inset_2 = #171c26
mod.theme.color_inset_hover = #171d27
mod.theme.color_inset_1_hover = #171d27
mod.theme.color_inset_2_hover = #1a202b
mod.theme.color_inset_focus = #171d27
mod.theme.color_inset_1_focus = #171d27
mod.theme.color_inset_2_focus = #1a202b
mod.theme.color_inset_active = #1f3a55
mod.theme.color_inset_1_active = #1f3a55
mod.theme.color_inset_2_active = #1f3a55
mod.theme.color_inset_down = #121720
mod.theme.color_inset_1_down = #121720
mod.theme.color_inset_2_down = #121720
mod.theme.color_inset_drag = #171d27
mod.theme.color_inset_1_drag = #171d27
mod.theme.color_inset_2_drag = #171d27
mod.theme.color_inset_empty = #141922
mod.theme.color_inset_1_empty = #141922
mod.theme.color_inset_2_empty = #171c26
mod.theme.color_inset_disabled = #1a202b
mod.theme.color_inset_1_disabled = #1a202b
mod.theme.color_inset_2_disabled = #1a202b

// The rim every stock face still draws: a cool frost line, brighter on
// top; the dividers take it at a tenth.
mod.theme.color_bevel = #7d8699
mod.theme.color_bevel_hover = #9aa3b5
mod.theme.color_bevel_focus = #81d8f0
mod.theme.color_bevel_active = #aff2ff
mod.theme.color_bevel_down = #6c7587
mod.theme.color_bevel_disabled = #3a4250
mod.theme.color_bevel_inset_1 = #0b0e14
mod.theme.color_bevel_inset_2 = #59616f
mod.theme.color_bevel_outset_1 = #9ea3b8
mod.theme.color_bevel_outset_2 = #5a6070
mod.theme.color_bevel_inset_1_disabled = #232a35
mod.theme.color_bevel_inset_2_disabled = #2e3542
mod.theme.color_bevel_outset_1_disabled = #3a4250
mod.theme.color_bevel_outset_2_disabled = #2e3542
mod.theme.beveling = 0.5

// Ink: a cool near-white; white when lit or held; a dim cool grey for the
// second voice; a slate when off.
mod.theme.color_text = #eef4fb
mod.theme.color_text_hover = #ffffff
mod.theme.color_text_focus = #eef4fb
mod.theme.color_text_active = #ffffff
mod.theme.color_text_down = #ffffff
mod.theme.color_text_disabled = #5d6572
mod.theme.color_text_placeholder = #9aa4b2
mod.theme.color_text_placeholder_hover = #aab3c0
mod.theme.color_text_val = #b9c0ca
mod.theme.color_text_meta = #9aa4b2
mod.theme.color_label = #eef4fb
mod.theme.color_label_hover = #ffffff
mod.theme.color_label_focus = #eef4fb
mod.theme.color_label_active = #ffffff
mod.theme.color_label_down = #ffffff
mod.theme.color_label_disabled = #5d6572
mod.theme.color_label_inner = #eef4fb
mod.theme.color_label_inner_hover = #ffffff
mod.theme.color_label_inner_focus = #eef4fb
mod.theme.color_label_inner_active = #ffffff
mod.theme.color_label_inner_down = #ffffff
mod.theme.color_label_inner_disabled = #5d6572
mod.theme.color_label_outer = #eef4fb
mod.theme.color_label_outer_hover = #ffffff
mod.theme.color_label_outer_focus = #eef4fb
mod.theme.color_label_outer_active = #ffffff
mod.theme.color_label_outer_down = #ffffff
mod.theme.color_label_outer_disabled = #5d6572
mod.theme.color_icon = #d8e0ea
mod.theme.color_icon_hover = #ffffff
mod.theme.color_icon_disabled = #5d6572
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`. Cyan light, used sparingly.
mod.theme.color_ctrl_selected = #5fcff5
mod.theme.color_focus = #81fcfe
mod.theme.color_ctrl_active = #5fcff5
mod.theme.color_val = #5fcff5
mod.theme.color_cursor = #aff2ff
mod.theme.color_text_cursor = #aff2ff
mod.theme.color_bg_highlight = #24506a
mod.theme.color_bg_highlight_inline = #24506a
mod.theme.color_selection = #24506a
mod.theme.color_selection_hover = #24506a
mod.theme.color_selection_focus = #2b6080
mod.theme.color_selection_down = #2b6080
// Signals, each only where its meaning is: rose stops, amber warns.
mod.theme.color_success = #6fe0b0
mod.theme.color_warning = #f5d36b
mod.theme.color_error = #f4668a
mod.theme.color_on_error = #2a0710
mod.theme.color_info = #5fcff5

mod.theme.color_terminal_bg = #141922
mod.theme.color_terminal_text = #eef4fb

// Slim: a 26 point control row, 8 point gaps, 4 point field corners.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 3.0 bottom: 0.0 left: 3.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 3.0 right: 0.0 bottom: 3.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 6.0 right: 6.0 bottom: 6.0 left: 6.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 6.0 bottom: 0.0 left: 6.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 6.0 right: 0.0 bottom: 6.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 9.0 right: 9.0 bottom: 9.0 left: 9.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 9.0 bottom: 0.0 left: 9.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 9.0 right: 0.0 bottom: 9.0 left: 0.0}
// The rungs the base froze at its own spacing, restated for this row.
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 24.0
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 32.0
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 6.0
mod.theme.textselection_corner_radius = 1.0

// The base's neutral grotesque, regular weight, at 9.5 points: a cap of
// about a third of the 26 point row. Values in the base monospace.
mod.theme.font_size_base = 9.5
mod.theme.font_size_p = 9.5
mod.theme.font_size_code = 8.0
mod.theme.font_code = mod.theme.font_code{font_size: 8.0}
mod.theme.font_regular = mod.theme.font_regular{font_size: 9.5}
mod.theme.font_bold = mod.theme.font_bold{font_size: 9.5}
mod.theme.font_label = mod.theme.font_label{font_size: 9.5}
mod.theme.font_italic = mod.theme.font_italic{font_size: 9.5}
mod.theme.font_bold_italic = mod.theme.font_bold_italic{font_size: 9.5}
// The body and label rungs the base froze from its own sizes, restated
// on the slimmer row.
mod.theme.font_size_1 = 15.0
mod.theme.font_size_2 = 12.5
mod.theme.font_size_3 = 11.0
mod.theme.font_size_4 = 9.5
mod.theme.type_title_l_size = 12.5
mod.theme.type_title_m_size = 11.0
mod.theme.type_title_s_size = 10.0
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.5 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 11.0 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 10.0 line_spacing: 1.2}
mod.theme.type_body_l_size = 10.5
mod.theme.type_body_m_size = 9.5
mod.theme.type_body_s_size = 8.25
mod.theme.type_label_l_size = 9.5
mod.theme.type_label_m_size = 8.25
mod.theme.type_label_s_size = 7.5
mod.theme.font_body_l = mod.theme.font_regular{font_size: 10.5 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 9.5 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 8.25 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 9.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 8.25 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}

// The surface ladder in cool slate, so every widget built on the roles
// stays in the family: grounds, containers, their ink and outlines.
mod.theme.color_surface = #1a202b
mod.theme.color_surface_dim = #141922
mod.theme.color_surface_bright = #394252
mod.theme.color_surface_container_low = #1f2632
mod.theme.color_surface_container = #242c39
mod.theme.color_surface_container_high = #2a3341
mod.theme.color_surface_container_highest = #313a49
mod.theme.color_on_surface = #eef4fb
mod.theme.color_on_surface_variant = #b9c0ca
mod.theme.color_outline = #7d8699
mod.theme.color_outline_variant = #3d4655
mod.theme.color_inverse_surface = #eef4fb
mod.theme.color_inverse_on_surface = #1a202b
true
