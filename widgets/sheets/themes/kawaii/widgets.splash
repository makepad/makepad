use mod.prelude.widgets_internal.*

// Kawaii. Every part is a sweet on a candy-pink ground: a key is a glossy
// pastel jelly, outlined in a deeper shade of its own colour, lit from the
// upper left -- a soft gloss over its upper half and a crisp white glint at
// its upper left corner -- while the light that comes back through the jelly
// pools as a brighter glow low inside it. Thumbs, radios and handles are
// pearls; checks, pointers and the fader cap are jelly hearts. Shadows are
// soft and rose-tinted, never grey. Every face is drawn in true points (one
// device pixel is `px`); shadows, glows and rings that fall outside a layout
// box are drawn in a quad grown in `vertex`, and no padding is spent on
// relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let kw_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space.
let kw_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let kw_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The sweet box: one pastel per kind of part. 0 strawberry milk, 1 lavender,
// 2 mint, 3 peach, 4 lemon, 5 baby blue, 6 raspberry, 7 cream, 8 hot pink,
// 9 pearl white, 10 lilac grey.
let kw_col = fn(k: float) -> vec3 {
    if k < 0.5 { return vec3(0.980, 0.680, 0.850) }
    if k < 1.5 { return vec3(0.820, 0.702, 0.988) }
    if k < 2.5 { return vec3(0.702, 0.929, 0.761) }
    if k < 3.5 { return vec3(0.988, 0.769, 0.639) }
    if k < 4.5 { return vec3(0.988, 0.890, 0.561) }
    if k < 5.5 { return vec3(0.702, 0.780, 0.988) }
    if k < 6.5 { return vec3(0.800, 0.122, 0.420) }
    if k < 7.5 { return vec3(1.0, 0.957, 0.925) }
    if k < 8.5 { return vec3(0.957, 0.447, 0.690) }
    if k < 9.5 { return vec3(1.0, 0.969, 0.984) }
    return vec3(0.800, 0.753, 0.871)
}

// The colour deep in the jelly where it is thickest: richer and a little
// darker, as light that has crossed more of a coloured sweet is.
let kw_deep = fn(c: vec3) -> vec3 {
    return pow(c, vec3(1.7, 1.7, 1.7)) * 0.97
}

// The outline a sweet is drawn with: its own hue, deep and saturated.
let kw_rim = fn(c: vec3) -> vec3 {
    return pow(c, vec3(2.7, 2.7, 2.7)) * 0.86
}

// A part that cannot be used: its colour washed to a pale lilac grey.
let kw_dull = fn(c: vec3, disabled: float) -> vec3 {
    let l = Finish.lum(c)
    let g = mix(c, vec3(l, l, l), 0.7 * disabled)
    return mix(g, vec3(0.60, 0.55, 0.70), 0.62 * disabled)
}

// The shadow every sweet throws on the ground (unpremultiplied ink): a deep
// rose, so a shadow on the pink ground reads as a darker pink, never grey.
let kw_shade = fn() -> vec3 {
    return vec3(0.64, 0.16, 0.40)
}

// Signed grain, -1..1, one value per device pixel of window space `w`.
// Each pixel is first sent to a far cell picked by the hash of its own, so
// the hash's near-repeat every 97 pixels never lines up into a lattice.
let kw_grain = fn(w: vec2, px: float) -> float {
    let i = floor(w / px)
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j) - Finish.hash(j + vec2(17.13, 3.71))
}

// Which way the outline of a rounded box faces at `p`: a straight side's
// normal on the sides, an arc's on the corners.
let kw_box_n = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - (h - vec2(rr, rr))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// The angle of `q` from straight down, clockwise, 0..2 pi.
let kw_ang = fn(q: vec2) -> float {
    var ang = atan2(0.0 - q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    return ang
}

// ---------------------------------------------------------------- shapes

// A heart standing upright, centred on `c`, `s` points from its middle to
// its top and to its tip (it is a tenth wider than it is tall): the signed
// distance in points, negative inside.
let kw_heart_d = fn(p: vec2, c: vec2, s: float) -> float {
    let k = 0.552
    let u = (p - c) / max(s, 0.01) * k
    let q = vec2(abs(u.x), k - u.y)
    var d = 0.0
    if q.y + q.x > 1.0 {
        d = length(q - vec2(0.25, 0.75)) - 0.35355
    } else {
        let a = q - vec2(0.0, 1.0)
        let m = max(q.x + q.y, 0.0) * 0.5
        let b = q - vec2(m, m)
        d = sqrt(min(dot(a, a), dot(b, b))) * sign(q.x - q.y)
    }
    return d * max(s, 0.01) / k
}

// The same heart turned so its tip points along `tip` (a unit vector).
let kw_heart_turned = fn(p: vec2, c: vec2, s: float, tip: vec2) -> float {
    let v = p - c
    let l = vec2(dot(v, vec2(tip.y, 0.0 - tip.x)), dot(v, tip))
    return kw_heart_d(l, vec2(0.0, 0.0), s)
}

// A five-pointed star standing on two points, centred on `c`, its points
// `r` out and its inner corners `r * rf` in, rounded by `rr`.
let kw_star_d = fn(p: vec2, c: vec2, r: float, rf: float, rr: float) -> float {
    let k1 = vec2(0.809016994, -0.587785252)
    let k2 = vec2(0.0 - k1.x, k1.y)
    var q = vec2(abs(p.x - c.x), c.y - p.y)
    q = q - k1 * (2.0 * max(dot(k1, q), 0.0))
    q = q - k2 * (2.0 * max(dot(k2, q), 0.0))
    q = vec2(abs(q.x), q.y - r)
    let ba = vec2(0.0 - k1.y, k1.x) * rf - vec2(0.0, 1.0)
    let h = clamp(dot(q, ba) / dot(ba, ba), 0.0, r)
    return length(q - ba * h) * sign(q.y * ba.x - q.x * ba.y) - rr
}

// A four-pointed sparkle, its points `r` out: coverage 0..1, crisp at `px`.
let kw_sparkle = fn(p: vec2, c: vec2, r: float, px: float) -> float {
    let q = abs(p - c)
    let d = min(q.x * 3.2 + q.y, q.x + q.y * 3.2) - r
    return Finish.cover(d / 2.2, px)
}

// ---------------------------------------------------------------- materials

// The gloss of a wet sweet in its own 0..1 frame `uv`: a lens of light over
// the upper part, brightest at the top, its lower edge crisp and rising
// toward the sides.
let kw_gloss = fn(uv: vec2) -> float {
    let x = uv.x * 2.0 - 1.0
    let yb = 0.47 - 0.2 * x * x
    let body = (1.0 - smoothstep(yb - 0.07, yb + 0.02, uv.y)) * smoothstep(0.0, 0.12, uv.y)
    return body * mix(0.62, 1.0, clamp(1.0 - uv.y / max(yb, 0.05), 0.0, 1.0))
}

// The light, from the upper left and toward the viewer.
let kw_light = fn() -> vec3 {
    return normalize(vec3(-0.42, -0.70, 0.58))
}

// THE JELLY of a shape whose signed distance at `p` is `d` and whose outline
// faces `n` there, premultiplied, without its shadow. `bw` is the width of
// its rounded shoulder, `t` 0..1 down its height, `uv` its own 0..1 frame
// for the gloss. The jelly is `base`; toward the edge it thickens to its
// deep colour, the shoulder facing the light is lit and the far one in
// shade; light coming back through it pools in its lower half and lines its
// lower edge just inside the outline; a soft gloss lies over its upper half
// and the outline is its rim colour.
let kw_jelly_face = fn(d: float, n: vec2, bw: float, t: float, uv: vec2, px: float, base: vec3, gloss: float, glow: float) -> vec4 {
    let white = vec3(1.0, 1.0, 1.0)
    let deep = kw_deep(base)
    let rim = kw_rim(base)
    let s = clamp(1.0 + d / max(bw, 0.5), 0.0, 1.0)
    let facing = dot(n, vec2(-0.38, -0.92))
    var col = base * (0.97 + 0.05 * t)
    col = mix(col, deep, 0.62 * s * s)
    col = col * (1.0 + 0.10 * facing * s)
    // The glow: light through the jelly, gathered low in it.
    let pool = smoothstep(0.42, 0.98, t) * (1.0 - smoothstep(0.55, 1.0, s))
    col = mix(col, min(base * 1.06 + vec3(0.10, 0.10, 0.10), white), pool * 0.6 * glow)
    // The gloss: a bright lens over the upper half.
    col = mix(col, white, kw_gloss(uv) * (1.0 - s * 0.8) * 0.5 * gloss)
    // The outline, and just inside it the clear edge of the jelly catching
    // the light: brightest along the top, again along the lower edge where
    // light comes back through.
    let ow = clamp(bw * 0.38, max(px, 0.6), 1.45)
    let lower = smoothstep(0.1, 0.9, n.y)
    let upper = smoothstep(0.2, 0.9, 0.0 - n.y)
    col = mix(col, min(base + vec3(0.3, 0.3, 0.3), white), Finish.band(d, ow, ow + px * 1.5, px) * (0.3 + 0.35 * upper + 0.3 * lower * glow))
    col = mix(col, rim, Finish.band(d, 0.0, ow, px) * 0.95)
    let a = Finish.cover(d, px)
    return vec4(min(col, white) * a, a)
}

// The crisp glint of a jelly: a short white stroke following its upper left
// shoulder and a dot after it, as a window seen in a wet sweet.
let kw_glint = fn(dst: vec4, p: vec2, a: vec2, b: vec2, w: float, px: float, amt: float) -> vec4 {
    let d1 = kw_seg(p, a, b) - w
    let dot_c = b + (b - a) * 0.55 + vec2(0.0, w * 0.3)
    let d2 = length(p - dot_c) - w * 0.8
    let cov = max(Finish.cover(d1, px), Finish.cover(d2, px))
    return Finish.over(dst, vec4(1.0, 1.0, 1.0, 1.0) * cov * amt)
}

// A jelly key standing on the ground, premultiplied: `lo`..`hi` its box, `r`
// its corner. Pressed, it sinks: its shadow tightens to a contact shade, the
// ground's shade falls in along its top edge and its gloss dims. `lift` 1
// throws the full soft shadow, 0 seats it with the contact shade only.
let kw_candy = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, base: vec3, hover: float, down: float, disabled: float, focus: float, lift: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sz = min(min(hh, hi.x - lo.x), 40.0)
    let live = 1.0 - disabled
    let dn = clamp(down, 0.0, 1.0) * live
    let d = Material.sd_box(p, c, h, r)
    // The shadow: soft and rose, falling straight down, and a tight contact
    // shade along the foot.
    let reach = clamp(0.1 * sz, 1.0, 3.2)
    let s1 = Finish.drop(p, c, h - vec2(0.04 * sz, 0.0), r, vec2(0.0, reach), reach * 0.9) * 0.34 * lift * (1.0 - 0.8 * dn)
    let s2 = Finish.drop(p, c, h, r, vec2(0.0, px + 0.03 * sz), px + 0.03 * sz) * 0.32
    let sh = (1.0 - (1.0 - s1) * (1.0 - s2)) * (1.0 - 0.5 * disabled) * (1.0 - Finish.cover(d, px))
    var res = vec4(kw_shade() * sh, sh)
    var b = kw_dull(base, disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.16 * hover * live
    b = b * (1.0 - 0.07 * dn)
    // Under the hand the sweet glows: a soft halo of its own colour.
    let halo = Finish.glow(d, 1.6) * 0.45 * hover * live * (1.0 - dn) * (1.0 - Finish.cover(d, px))
    res = Finish.over(res, vec4(kw_rim(b) * halo, halo) * 0.6)
    let n = kw_box_n(p, c, h, r)
    let bw = clamp(0.3 * min(h.x, h.y), 2.0, 7.0)
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let gi = vec2(min(r * 0.6, h.x), 1.0)
    let uv = clamp((p - lo - gi) / max(hi - lo - gi * 2.0, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let gloss = (1.0 - 0.75 * disabled) * (1.0 - 0.55 * dn)
    var face = kw_jelly_face(d, n, bw, t, uv, px, b, gloss, 1.0 - 0.5 * disabled)
    // Pressed: the ground's shade falls in along the top edge.
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 1.6), 1.4) * dn
    face = vec4(mix(face.rgb, kw_rim(b) * face.a, ins * 0.45), face.a)
    res = Finish.over(res, face)
    // The glint, over the upper left shoulder; it slides down when pressed.
    let gy = lo.y + clamp(0.24 * hh, 2.2, 6.0) + 0.8 * dn
    let gx = lo.x + max(r * 0.55, 2.5)
    let gl = clamp(0.14 * (hi.x - lo.x), 2.5, 9.0)
    let gw = clamp(0.05 * hh, 0.7, 1.5)
    res = kw_glint(res, p, vec2(gx, gy + gw), vec2(gx + gl, gy), gw, px, 0.9 * gloss * step(14.0, hh))
    // Focus: a hot-pink ring standing just off the key, with a breath of
    // pink light.
    let ring = Finish.ring_out(d, px, px * 2.6, px) + Finish.glow(d - px * 2.6, 1.2) * 0.35 * (1.0 - Finish.cover(d, px))
    return Finish.over(res, vec4(1.0, 0.37, 0.64, 1.0) * clamp(ring, 0.0, 1.0) * focus * live)
}

// A JELLY HEART, premultiplied over `dst`: its shadow, its jelly, a glint.
// `tip` the way its point faces (straight down for an upright heart).
let kw_jelly_heart = fn(dst: vec4, p: vec2, c: vec2, s: float, tip: vec2, px: float, base: vec3, hover: float, down: float, disabled: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    var b = kw_dull(base, disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.12 * hover * live
    b = b * (1.0 - 0.06 * down * live)
    let d = kw_heart_turned(p, c, s, tip)
    let e = max(px * 0.5, 0.05)
    let gx = kw_heart_turned(p + vec2(e, 0.0), c, s, tip) - d
    let gy = kw_heart_turned(p + vec2(0.0, e), c, s, tip) - d
    let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    let ds = kw_heart_turned(p - vec2(0.0, 0.16 * s + 0.4) * lift, c, s * 0.97, tip)
    let shs = max(0.22 * s, px)
    let sh = (1.0 - smoothstep(0.0 - shs, shs * 1.4, ds)) * 0.36 * lift * (1.0 - 0.5 * disabled) * (1.0 - Finish.cover(d, px))
    var res = Finish.over(dst, vec4(kw_shade() * sh, sh))
    let t = clamp((p.y - (c.y - s)) / max(2.0 * s, 1.0), 0.0, 1.0)
    let uv = clamp((p - (c - vec2(s * 0.8, s * 0.9))) / max(vec2(s * 1.6, s * 1.6), vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let face = kw_jelly_face(d, n, clamp(0.42 * s, 1.2, 6.0), t, uv, px, b, 1.0 - 0.75 * disabled, 1.0 - 0.5 * disabled)
    res = Finish.over(res, face)
    // The glint on the left lobe.
    let g = c + vec2(0.0 - 0.52 * s, 0.0 - 0.42 * s)
    let gq = p - g
    let gd = length(vec2(gq.x * 0.8 + gq.y * 0.6, (gq.y * 0.8 - gq.x * 0.6) * 1.9)) - max(0.15 * s, 0.6)
    return Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * Finish.cover(gd, px) * 0.9 * (1.0 - 0.7 * disabled) * Finish.cover(d, px))
}

// A PEARL laid over `dst`, premultiplied: its soft rose shadow, a lit
// sphere of nacre -- white with a blush, its turned-away rim taking the
// faint lilac, mint and peach play of a pearl -- a broad soft lustre and a
// crisp white glint up and to the left. `tint` blushes it.
let kw_pearl = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, tint: vec3, hover: float, held: float, disabled: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    var b = kw_dull(tint, disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.15 * hover * live
    b = b * (1.0 - 0.05 * held * live)
    let so = c + vec2(0.04 * rad, 0.30 * rad) * lift
    let sd = length(p - so) - rad * 0.9
    let shs = max(0.32 * rad, px)
    let sh = (1.0 - smoothstep(0.0 - shs, shs * 1.6, sd)) * 0.38 * lift
    let cd = length(p - (c + vec2(0.0, 0.12 * rad))) - rad
    let ct = (1.0 - smoothstep(-0.1 * rad, 0.18 * rad + px, cd)) * 0.3
    let shadow = (1.0 - (1.0 - sh) * (1.0 - ct)) * (1.0 - 0.5 * disabled)
    var res = Finish.over(dst, vec4(kw_shade() * shadow, shadow))
    let q = (p - c) / max(rad, 0.5)
    let r2 = dot(q, q)
    let z = sqrt(max(1.0 - r2, 0.0))
    let n = vec3(q.x, q.y, z)
    let l = kw_light()
    let dif = max(dot(n, l), 0.0)
    let shade = mix(b * vec3(0.80, 0.70, 0.84), b, smoothstep(0.0, 0.9, dif))
    var col = shade
    // The play of colour on the turned-away rim of the nacre.
    let fres = pow(1.0 - z, 1.6)
    let ang = atan2(q.y, q.x)
    let irid = mix(vec3(0.86, 0.80, 1.0), vec3(0.80, 0.98, 0.90), 0.5 + 0.5 * sin(ang * 2.0 + 0.6))
    col = mix(col, mix(irid, vec3(1.0, 0.86, 0.80), 0.5 + 0.5 * sin(ang * 3.0 - 1.1)) * b, fres * 0.45)
    // Light coming back through the nacre, low on the far side.
    col = col + (vec3(1.0, 1.0, 1.0) - col) * smoothstep(0.35, 0.95, q.y) * smoothstep(0.4, 0.95, sqrt(r2)) * 0.35
    let hv = normalize(l + vec3(0.0, 0.0, 1.0))
    let nh = max(dot(n, hv), 0.0)
    let gloss = 1.0 - 0.8 * disabled
    col = col + vec3(1.0, 1.0, 1.0) * (pow(nh, 6.0) * 0.20 + pow(nh, 80.0) * 1.1) * gloss
    col = min(col, vec3(1.0, 1.0, 1.0))
    let d = length(p - c) - rad
    col = mix(col, kw_rim(mix(b, vec3(0.98, 0.72, 0.86), 0.7)), Finish.band(d, 0.0, max(px * 1.2, 0.7), px) * 0.55)
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A JELLY BEAD laid over `dst`: a sphere of coloured jelly, its colour
// deepening to the rim, light pooled low inside it and a crisp glint.
let kw_bead = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, base: vec3, lift: float) -> vec4 {
    let so = c + vec2(0.0, 0.32 * rad) * lift
    let sd = length(p - so) - rad * 0.9
    let shs = max(0.3 * rad, px)
    let sh = (1.0 - smoothstep(0.0 - shs, shs * 1.5, sd)) * 0.3 * lift
    var res = Finish.over(dst, vec4(kw_shade() * sh, sh))
    let q = (p - c) / max(rad, 0.3)
    let r2 = dot(q, q)
    let z = sqrt(max(1.0 - r2, 0.0))
    let n = vec3(q.x, q.y, z)
    let l = kw_light()
    let dif = max(dot(n, l), 0.0)
    let deep = kw_deep(base)
    var col = mix(deep, base * 1.04, smoothstep(0.0, 0.85, dif))
    col = mix(col, kw_rim(base), smoothstep(0.55, 1.0, sqrt(r2)) * 0.45)
    col = col + (vec3(1.0, 1.0, 1.0) - col) * smoothstep(0.2, 0.9, q.y) * (1.0 - smoothstep(0.75, 1.0, sqrt(r2))) * 0.4
    let hv = normalize(l + vec3(0.0, 0.0, 1.0))
    let nh = max(dot(n, hv), 0.0)
    col = col + vec3(1.0, 1.0, 1.0) * (pow(nh, 7.0) * 0.18 + pow(nh, 70.0) * 1.0)
    let d = length(p - c) - rad
    col = mix(col, kw_rim(base), Finish.band(d, 0.0, max(px, 0.6), px) * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a))
}

// A channel pressed into the candy, premultiplied: a pale strawberry-milk
// floor `fl`, the ground's rose shade falling in along its upper wall, a
// soft catch light on its lower lip and a rose outline.
let kw_groove = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, fl: vec3) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let hh = hi.y - lo.y
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var col = fl * (0.95 + 0.06 * t)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, clamp(0.3 * hh, 0.6, 2.2)), clamp(0.28 * hh, px, 1.8))
    col = mix(col, kw_deep(fl) * vec3(0.92, 0.80, 0.88), ins * 0.55)
    col = mix(col, kw_rim(mix(fl, vec3(0.97, 0.62, 0.80), 0.6)), Finish.band(d, 0.0, max(px * 1.3, 0.8), px) * 0.85)
    let a = Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(c.y - h.y * 0.2, c.y + h.y * 0.7, p.y) * 0.6
    return Finish.over(vec4(vec3(1.0, 0.97, 0.99) * lip, lip), vec4(col * a, a))
}

// A rod of jelly lying in a channel, laid over `dst`: round across, lit from
// above, its gloss a line along its upper third and its lower half glowing.
let kw_rod = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, px: float, base: vec3, disabled: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.25, 0.25))
    let d = Material.sd_box(p, c, h, min(h.x, h.y))
    let b = kw_dull(base, disabled)
    let deep = kw_deep(b)
    let v = clamp((p.y - c.y) / max(h.y, 0.25), -1.0, 1.0)
    let z = sqrt(max(1.0 - v * v, 0.0))
    var col = mix(deep, b * 1.03, clamp(0.3 + 0.6 * z - 0.25 * v, 0.0, 1.0))
    col = col + (vec3(1.0, 1.0, 1.0) - col) * smoothstep(0.2, 0.9, v) * 0.25
    col = col + vec3(1.0, 1.0, 1.0) * exp(-((v + 0.48) * (v + 0.48)) / 0.05) * 0.5 * (1.0 - 0.8 * disabled)
    // Glitter suspended in the jelly: here and there a fleck catching the
    // light, white or pale gold, one device pixel each.
    let cell = floor((p + vec2(13.7, 5.3)) / px)
    let fl = step(0.93, Finish.hash(cell)) * Finish.cover(d + px, px)
    col = mix(col, mix(vec3(1.0, 1.0, 1.0), vec3(1.0, 0.92, 0.70), Finish.hash(cell + vec2(3.1, 1.7))), fl * 0.6 * (1.0 - disabled))
    col = mix(col, kw_rim(b), Finish.band(d, 0.0, max(px, 0.6), px) * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(dst, vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a))
}

// A PUFFY FRAME round a window, premultiplied: a cushion `bw` wide of
// `rim`, round across like a pillow, lit along its crown; its outer edge
// and the seam where the window starts drawn in the rim's deep shade; the
// window's floor `fill` (at `fill_a`) with the cushion's shade falling in
// under its top edge.
let kw_frame = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, bw: float, rim: vec3, fill: vec3, fill_a: float, hover: float, focus: float, disabled: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let ih = max(h - vec2(bw, bw), vec2(0.5, 0.5))
    let ir = max(r - bw, 0.5)
    let di = Material.sd_box(p, c, ih, ir)
    let live = 1.0 - disabled
    var rc = kw_dull(rim, disabled)
    rc = rc + (vec3(1.0, 1.0, 1.0) - rc) * 0.12 * hover * live
    rc = mix(rc, vec3(1.0, 0.45, 0.70), 0.55 * focus * live)
    let deep = kw_deep(rc)
    let insh = Finish.inset(p, c, ih, ir, vec2(0.0, 1.3), 1.1)
    let win = mix(fill, kw_deep(fill) * vec3(0.95, 0.85, 0.92), 0.45 * insh)
    let n = kw_box_n(p, c, h, r)
    let across = clamp(di / max(bw, 0.5), 0.0, 1.0) * 2.0 - 1.0
    let facing = dot(n * across, vec2(-0.38, -0.92))
    var fr = mix(deep, rc * 1.04, clamp(0.6 + 0.45 * facing, 0.0, 1.0))
    let crown = exp(-((across + 0.1) * (across + 0.1)) / 0.12) * (0.55 + 0.45 * smoothstep(-0.2, 0.9, -n.y))
    fr = mix(fr, vec3(1.0, 1.0, 1.0), crown * 0.5 * (1.0 - 0.6 * disabled))
    let inframe = Finish.cover(0.0 - di, px)
    var col = mix(win, fr, inframe)
    col = mix(col, kw_rim(rc), Finish.band(di, 0.0, max(px, 0.6), px) * 0.6)
    col = mix(col, kw_rim(rc), Finish.band(d, 0.0, max(px * 1.4, 0.9), px) * 0.9)
    let a = Finish.cover(d, px) * mix(fill_a, 1.0, inframe)
    let fo = Finish.ring_out(d, px, px * 2.4, px) * focus * live
    return Finish.over(vec4(col * a, a), vec4(1.0, 0.37, 0.64, 1.0) * fo)
}

// A well pressed into the candy, where the chosen answer sits: a deep
// raspberry jelly floor, the ground's shade falling in from its top edge,
// light caught along its lower lip.
let kw_sunk = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let base = kw_col(6.0) + vec3(0.03, 0.02, 0.02) * hover
    var col = mix(base * 0.78, base * 1.04, t)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 1.8), 1.5)
    col = mix(col, vec3(0.36, 0.03, 0.17), ins * 0.55)
    col = mix(col, vec3(1.0, 0.62, 0.80), Finish.band(d, px, px * 2.4, px) * smoothstep(c.y + h.y * 0.3, hi.y, p.y) * 0.55)
    col = mix(col, vec3(0.42, 0.04, 0.20), Finish.band(d, 0.0, max(px * 1.4, 0.9), px) * 0.9)
    let a = Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(c.y, hi.y, p.y) * 0.7
    return Finish.over(vec4(vec3(1.0, 0.97, 0.99) * lip, lip), vec4(col * a, a))
}

// The focus ring: a hot-pink line standing a device pixel off the edge of
// a shape at distance `d`, with a breath of pink light outside it.
let kw_focus = fn(d: float, px: float) -> float {
    let ring = Finish.ring_out(d, px, px * 2.5, px)
    return clamp(ring + Finish.glow(d - px * 2.5, 1.0) * 0.35 * (1.0 - Finish.cover(d - px * 2.5, px)), 0.0, 1.0)
}
let kw_focus_col = fn() -> vec4 {
    return vec4(1.0, 0.37, 0.64, 1.0)
}

// The three-quarter arc a waiting button turns in place of its label.
let kw_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(0.69, 0.06, 0.37, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- ornaments

// THE ORNAMENTS of the frame and the panels' corners: a satin bow, a jelly
// heart, a lemon star, a strawberry and a sparkle. Each is drawn whole over
// `dst`, `s` its half size in points.

// A satin ribbon bow centred on `c`, `s` its half width: two loops either
// side of a knot, two tails falling below, the loops in shade where they
// gather into the knot and lit along their upper curves.
let kw_bow = fn(dst: vec4, p: vec2, c: vec2, s: float, base: vec3, px: float) -> vec4 {
    let q = (p - c) / max(s, 0.5)
    let m = vec2(abs(q.x), q.y)
    let rim = kw_rim(base)
    let deep = kw_deep(base)
    // The tails, behind the loops: ribbons falling outward, their ends cut
    // in a notch.
    let ta = vec2(0.08, 0.12)
    let tb = vec2(0.46, 0.86)
    let tdir = normalize(tb - ta)
    let tq = m - ta
    let along = dot(tq, tdir)
    let tw = 0.15 + 0.03 * clamp(along, 0.0, 1.0)
    var dt = kw_seg(m, ta, tb) - tw
    let notch = abs(dot(m - tb, vec2(tdir.y, 0.0 - tdir.x))) * 0.9 - dot(m - tb, tdir) * 1.2 - 0.12
    dt = max(dt, 0.0 - notch + 0.12)
    // The loops: each a soft rounded wedge from the knot out to a broad end.
    let lc = vec2(0.52, -0.10)
    let lq = m - lc
    let rot = vec2(lq.x * 0.96 + lq.y * 0.28, lq.y * 0.96 - lq.x * 0.28)
    let pinch = 0.16 + 0.24 * smoothstep(-0.55, 0.35, rot.x)
    let dl = length(vec2(rot.x / 0.5, rot.y / max(pinch * 1.7, 0.05))) - 1.0
    let dloop = dl * min(0.5, pinch * 1.7) * 0.85
    // The knot.
    let dk = Material.sd_box(q, vec2(0.0, 0.0), vec2(0.16, 0.17), 0.09)
    let pxs = px / max(s, 0.5)
    var res = dst
    // Its soft shadow.
    let dall = min(min(dt, dloop), dk)
    let qs = (p - c - vec2(0.0, 0.12 * s)) / max(s, 0.5)
    let ms = vec2(abs(qs.x), qs.y)
    let lqs = ms - lc
    let rots = vec2(lqs.x * 0.96 + lqs.y * 0.28, lqs.y * 0.96 - lqs.x * 0.28)
    let pinchs = 0.16 + 0.24 * smoothstep(-0.55, 0.35, rots.x)
    let dls = (length(vec2(rots.x / 0.5, rots.y / max(pinchs * 1.7, 0.05))) - 1.0) * min(0.5, pinchs * 1.7) * 0.85
    let shd = (1.0 - smoothstep(-0.08, 0.16, min(dls, kw_seg(ms, ta, tb) - tw))) * 0.3 * (1.0 - Finish.cover(dall, pxs))
    res = Finish.over(res, vec4(kw_shade() * shd, shd))
    // Tails.
    var tcol = mix(base * 0.92, deep, clamp(along * 0.8, 0.0, 1.0) * 0.6)
    tcol = mix(tcol, rim, Finish.band(dt, 0.0, pxs * 1.4, pxs) * 0.9)
    let at = Finish.cover(dt, pxs)
    res = Finish.over(res, vec4(tcol * at, at))
    // Loops.
    let gather = 1.0 - smoothstep(-0.35, 0.3, rot.x)
    var lcol = mix(base * 1.03, deep * 0.92, gather * 0.75)
    let crest = exp(-((rot.y + pinch * 0.9) * (rot.y + pinch * 0.9)) / 0.012) * smoothstep(-0.2, 0.3, rot.x)
    lcol = mix(lcol, vec3(1.0, 1.0, 1.0), crest * 0.55)
    // The fold line running into each loop from the knot.
    let fold = Finish.cover(abs(rot.y + 0.02 - rot.x * 0.12) - pxs * 0.9, pxs) * smoothstep(0.3, -0.3, rot.x) * 0.5
    lcol = mix(lcol, rim, fold)
    lcol = mix(lcol, rim, Finish.band(dloop, 0.0, pxs * 1.5, pxs) * 0.9)
    let al = Finish.cover(dloop, pxs)
    res = Finish.over(res, vec4(min(lcol, vec3(1.0, 1.0, 1.0)) * al, al))
    // Knot.
    var kcol = mix(base * 1.02, deep, smoothstep(-0.15, 0.2, q.y) * 0.5)
    kcol = mix(kcol, vec3(1.0, 1.0, 1.0), exp(-((q.y + 0.08) * (q.y + 0.08)) / 0.004) * 0.45)
    kcol = mix(kcol, rim, Finish.band(dk, 0.0, pxs * 1.5, pxs) * 0.9)
    let ak = Finish.cover(dk, pxs)
    return Finish.over(res, vec4(min(kcol, vec3(1.0, 1.0, 1.0)) * ak, ak))
}

// A lemon star with a soft rose shadow, a round shoulder and a glint.
let kw_star = fn(dst: vec4, p: vec2, c: vec2, s: float, base: vec3, px: float) -> vec4 {
    let d = kw_star_d(p, c, s * 0.86, 0.46, s * 0.12)
    let ds = kw_star_d(p - vec2(0.0, 0.14 * s + 0.3), c, s * 0.86, 0.46, s * 0.12)
    let sh = (1.0 - smoothstep(0.0 - 0.2 * s, 0.25 * s, ds)) * 0.3 * (1.0 - Finish.cover(d, px))
    var res = Finish.over(dst, vec4(kw_shade() * sh, sh))
    let e = max(px * 0.5, 0.05)
    let gx = kw_star_d(p + vec2(e, 0.0), c, s * 0.86, 0.46, s * 0.12) - d
    let gy = kw_star_d(p + vec2(0.0, e), c, s * 0.86, 0.46, s * 0.12) - d
    let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    let t = clamp((p.y - (c.y - s)) / max(2.0 * s, 1.0), 0.0, 1.0)
    let uv = clamp((p - (c - vec2(s * 0.7, s * 0.8))) / max(vec2(s * 1.4, s * 1.4), vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    res = Finish.over(res, kw_jelly_face(d, n, clamp(0.3 * s, 0.8, 4.0), t, uv, px, base, 0.8, 1.0))
    let gq = p - (c + vec2(0.0 - 0.18 * s, 0.0 - 0.3 * s))
    let gd = length(vec2(gq.x, gq.y * 1.8)) - max(0.1 * s, 0.5)
    return Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * Finish.cover(gd, px) * 0.85 * Finish.cover(d, px))
}

// A strawberry: a rounded berry of red-pink jelly speckled with pale seeds,
// a crown of mint leaves and a short stalk.
let kw_strawberry = fn(dst: vec4, p: vec2, c: vec2, s: float, px: float) -> vec4 {
    let berry = vec3(0.98, 0.42, 0.52)
    let leaf = vec3(0.50, 0.85, 0.55)
    // The berry: a heart turned over, softened, its broad shoulders up.
    let bc = c + vec2(0.0, 0.12 * s)
    let db = kw_heart_turned(p, bc, s * 0.78, vec2(0.0, 1.0)) - 0.0
    let q = (p - bc) / max(s, 0.5)
    let dbody = max(db, length(q * vec2(0.92, 1.0) - vec2(0.0, 0.02)) * s - s * 0.86) - 0.06 * s
    let e = max(px * 0.5, 0.05)
    let gx = max(kw_heart_turned(p + vec2(e, 0.0), bc, s * 0.78, vec2(0.0, 1.0)), length((p + vec2(e, 0.0) - bc) / max(s, 0.5) * vec2(0.92, 1.0) - vec2(0.0, 0.02)) * s - s * 0.86) - 0.06 * s - dbody
    let gy = max(kw_heart_turned(p + vec2(0.0, e), bc, s * 0.78, vec2(0.0, 1.0)), length((p + vec2(0.0, e) - bc) / max(s, 0.5) * vec2(0.92, 1.0) - vec2(0.0, 0.02)) * s - s * 0.86) - 0.06 * s - dbody
    let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    let dsh = length((p - bc - vec2(0.0, 0.16 * s)) / max(s, 0.5) * vec2(0.92, 1.0)) * s - s * 0.8
    let sh = (1.0 - smoothstep(0.0 - 0.2 * s, 0.25 * s, dsh)) * 0.3 * (1.0 - Finish.cover(dbody, px))
    var res = Finish.over(dst, vec4(kw_shade() * sh, sh))
    let t = clamp((p.y - (c.y - s)) / max(2.0 * s, 1.0), 0.0, 1.0)
    let uv = clamp((p - (c - vec2(s * 0.7, s * 0.6))) / max(vec2(s * 1.4, s * 1.4), vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    var body = kw_jelly_face(dbody, n, clamp(0.35 * s, 0.8, 5.0), t, uv, px, berry, 0.7, 1.0)
    // The seeds: small pale drops set in rows, each in its own dimple.
    let sp = max(0.28 * s, 1.2)
    let row = floor((p.y - bc.y) / sp + 0.5)
    let sx = (p.x - bc.x) / sp + 0.5 * (row - 2.0 * floor(row * 0.5))
    let cell = vec2((fract(sx + 0.5) - 0.5) * sp, ((p.y - bc.y) / sp - row) * sp)
    let sd = length(vec2(cell.x * 1.4, cell.y)) - max(0.06 * s, 0.45)
    let inner = Finish.cover(dbody + 0.18 * s, px)
    body = vec4(mix(body.rgb, vec3(1.0, 0.95, 0.70) * body.a, Finish.cover(sd, px) * inner * 0.95), body.a)
    res = Finish.over(res, body)
    // The crown of leaves: five pointed leaves fanned over the top.
    var dl = 100.0
    var i = 0.0
    loop {
        if i > 4.5 { break }
        let a = -1.15 + i * 0.575
        let dir = vec2(sin(a), 0.0 - cos(a) * 0.55)
        let lc = c + vec2(0.0, 0.0 - 0.5 * s)
        let tipp = lc + dir * s * 0.62
        let dd = kw_seg(p, lc, tipp) - s * 0.13 * (1.0 - 0.75 * clamp(dot(p - lc, dir) / max(s * 0.62, 0.1), 0.0, 1.0))
        dl = min(dl, dd)
        i = i + 1.0
    }
    let dstalk = kw_seg(p, c + vec2(0.0, 0.0 - 0.5 * s), c + vec2(0.1 * s, 0.0 - 0.88 * s)) - 0.07 * s
    dl = min(dl, dstalk)
    var lcol = mix(leaf * 1.05, kw_deep(leaf), smoothstep(c.y - 0.9 * s, c.y - 0.3 * s, p.y) * 0.5)
    lcol = mix(lcol, kw_rim(leaf), Finish.band(dl, 0.0, max(px * 1.2, 0.6), px) * 0.9)
    let al = Finish.cover(dl, px)
    return Finish.over(res, vec4(lcol * al, al))
}

// A LACE TRIM along a straight edge: a row of scallops `rad` round hanging
// from the line y = `y0` (in the direction `dir`, 1 down, -1 up) across x,
// each pierced by an eyelet and a pinhole either side, white with a rose
// shade under it. Returned premultiplied.
let kw_lace = fn(p: vec2, x0: float, x1: float, y0: float, dir: float, rad: float, px: float) -> vec4 {
    let span = max(x1 - x0, 1.0)
    let n = max(floor(span / (rad * 2.0)), 1.0)
    let pitch = span / n
    let k = clamp(floor((p.x - x0) / pitch), 0.0, n - 1.0)
    let cx = x0 + (k + 0.5) * pitch
    let v = (p.y - y0) * dir
    let ds = length(vec2(p.x - cx, max(v, 0.0) * pitch / (rad * 2.0) * 1.05)) - pitch * 0.5
    var d = max(ds, 0.0 - v - rad * 0.55)
    d = max(d, p.x - x1)
    d = max(d, x0 - p.x)
    // The eyelet in each scallop and pinholes along the band.
    let eye = length(vec2(p.x - cx, v - rad * 0.35)) - rad * 0.3
    let pin = length(vec2(p.x - (cx + pitch * 0.5), v + rad * 0.15)) - rad * 0.14
    let holes = min(eye, pin)
    let dl = max(d, 0.0 - holes)
    var col = vec3(1.0, 0.985, 0.99)
    col = mix(col, vec3(0.97, 0.80, 0.89), smoothstep(0.0, rad, v) * 0.35)
    col = mix(col, vec3(0.93, 0.62, 0.78), Finish.band(dl, 0.0, max(px, 0.6), px) * 0.75)
    let a = Finish.cover(dl, px)
    // A soft rose shade round the lace where it lies on the candy.
    let s = (1.0 - smoothstep(0.0, 1.3, d)) * 0.22 * (1.0 - a)
    return vec4(col * a, a) + vec4(kw_shade() * s, s)
}

// ---------------------------------------------------------------- buttons

// Every button is a jelly candy, round-ended so its label sits in a soft
// pill, each kind in its own pastel with its label in a deep shade of the
// same colour: the plain button strawberry milk, the primary lavender, the
// secondary mint, the tertiary peach, the flat one lilac, the large one
// baby blue, the icon key lemon; the danger button is a deep raspberry
// jelly with white words, and the outline is a cream sweet ringed in rose.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlat.min_height = 24.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonSecondary.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonTertiary.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonOutline.padding = mod.turtle.Inset{left: 13.0 right: 13.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonSm.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 1.0 bottom: 1.0}
mod.widgets.ButtonLg.padding = mod.turtle.Inset{left: 15.0 right: 15.0 top: 2.0 bottom: 2.0}
mod.widgets.ButtonXs.draw_text.text_style.font_size = 6.5
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(4.0)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.67)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The candy's colour for a button `kind`: 0 flat (lilac), 1 plain
// (strawberry milk), 2 primary (lavender), 3 secondary (mint), 4 tertiary
// (peach), 5 danger (raspberry), 8 icon (lemon), 9 large (baby blue).
let kw_key_col = fn(kind: float) -> vec3 {
    if kind < 0.5 { return vec3(0.910, 0.868, 0.996) }
    if kind < 1.5 { return kw_col(0.0) }
    if kind < 2.5 { return kw_col(1.0) }
    if kind < 3.5 { return kw_col(2.0) }
    if kind < 4.5 { return kw_col(3.0) }
    if kind < 5.5 { return kw_col(6.0) }
    if kind < 8.5 { return kw_col(4.0) }
    return kw_col(5.0)
}

// The candy and its states, shared by every button template; 6 is the
// outline and 7 the flatter button, a pale pink candy only under the hand.
let kw_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 8.0
    let px = kw_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(kw_snap(0.0, o.x, px), kw_snap(0.0, o.y, px))
    let hi = vec2(kw_snap(size.x, o.x, px), kw_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let r = min(clamp(0.42 * hh, 4.0, 14.0), min(hi.x - lo.x, hh) * 0.5)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 5.5 && kind < 7.5 {
        if kind > 6.5 {
            if hover + down + focus > 0.001 {
                res = kw_candy(p, lo, hi, r, px, kw_col(0.0), hover, down, disabled, focus, 0.6) * clamp(max(max(hover, down), focus), 0.0, 1.0)
            }
        } else {
            // The outline: a cream sweet ringed in a rose band; a dashed
            // outline breaks its ring.
            var key = kw_candy(p, lo, hi, r, px, kw_col(7.0), hover, down, disabled, focus, 1.0)
            let c = (lo + hi) * 0.5
            let h = (hi - lo) * 0.5
            let d = Material.sd_box(p, c, h, r)
            var on = 1.0
            if dash > 0.0 {
                on = step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let ring = Finish.band(d, 0.0, 1.8, px) * on * (1.0 - 0.5 * disabled)
            key = vec4(mix(key.rgb, kw_dull(vec3(0.93, 0.47, 0.70), disabled) * key.a, ring * 0.9), key.a)
            res = key
        }
    } else {
        res = kw_candy(p, lo, hi, r, px, kw_key_col(kind), hover, down, disabled, focus, 1.0)
    }
    if loading > 0.001 {
        let rad = max(min(hi.x - lo.x, hh) * 0.5 - 6.0, 2.0)
        res = kw_spinner(res, p, (lo + hi) * 0.5, rad, anim, loading, 1.5)
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(kw_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0), 8.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(kw_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0), 8.0)
