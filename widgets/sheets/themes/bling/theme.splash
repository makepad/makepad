mod.theme = mod.themes.light

// Bling: white Carrara marble set in polished gold, after the "marble / bling
// light" pictures: a white stone ground with soft grey veins, every control
// framed in a thin bevelled gold rim, buttons as white marble, gold bars or
// cut stones (an emerald for the primary, a ruby for danger), knobs as cut
// gems in gold bezels, slider rails in gold with jewel thumbs. The ink is a
// dark grey-brown; headings and button legends are set in a high-contrast
// serif. The strong second colour is gold; the accent is emerald: the value
// a control holds, a lit level. Screens are black onyx glass with gold
// figures. The faces are drawn in widgets.splash; this file holds the
// tokens every face and every stock widget reads.
mod.theme.color_bg_app = #efeee9
// The surface ladder is grown from this one: a polished white a step over
// the ground.
mod.theme.color_fg_app = #f6f5f1
mod.theme.color_bg_container = #efeee9
mod.theme.color_surface_container = #f3f2ed
mod.theme.color_surface_container_lowest = #e8e6df

// Raised faces the sheet does not redraw: polished white stone, its top the
// brightest, its foot a warm grey.
mod.theme.color_outset = #f6f5f1
mod.theme.color_outset_1 = #fbfaf7
mod.theme.color_outset_2 = #e9e6de
mod.theme.color_outset_hover = #f9f8f4
mod.theme.color_outset_1_hover = #fdfcfa
mod.theme.color_outset_2_hover = #ece9e2
mod.theme.color_outset_focus = #f6f5f1
mod.theme.color_outset_1_focus = #fbfaf7
mod.theme.color_outset_2_focus = #e9e6de
mod.theme.color_outset_active = #e9e6de
mod.theme.color_outset_1_active = #e2dfd6
mod.theme.color_outset_2_active = #eeebe4
mod.theme.color_outset_down = #e9e6de
mod.theme.color_outset_1_down = #e2dfd6
mod.theme.color_outset_2_down = #eeebe4
mod.theme.color_outset_drag = #e9e6de
mod.theme.color_outset_1_drag = #e2dfd6
mod.theme.color_outset_2_drag = #eeebe4
mod.theme.color_outset_disabled = #efede8
mod.theme.color_outset_1_disabled = #efede8
mod.theme.color_outset_2_disabled = #efede8

// Wells: the same stone cut down into the ground, shaded under the top rim.
mod.theme.color_inset = #f4f3ef
mod.theme.color_inset_1 = #eeece6
mod.theme.color_inset_2 = #f8f7f3
mod.theme.color_inset_hover = #f7f6f2
mod.theme.color_inset_1_hover = #f1efea
mod.theme.color_inset_2_hover = #faf9f6
mod.theme.color_inset_focus = #faf9f6
mod.theme.color_inset_1_focus = #f4f3ef
mod.theme.color_inset_2_focus = #faf9f6
mod.theme.color_inset_active = #faf9f6
mod.theme.color_inset_1_active = #f4f3ef
mod.theme.color_inset_2_active = #faf9f6
mod.theme.color_inset_down = #ecebe5
mod.theme.color_inset_1_down = #e6e3dc
mod.theme.color_inset_2_down = #efede8
mod.theme.color_inset_drag = #ecebe5
mod.theme.color_inset_1_drag = #e6e3dc
mod.theme.color_inset_2_drag = #efede8
mod.theme.color_inset_empty = #f4f3ef
mod.theme.color_inset_1_empty = #eeece6
mod.theme.color_inset_2_empty = #f8f7f3
mod.theme.color_inset_disabled = #efede8
mod.theme.color_inset_1_disabled = #efede8
mod.theme.color_inset_2_disabled = #efede8

// The device pixel edges of a stock face are gold: the bright gold of a rim
// catching the light on top, its deep band at the foot.
mod.theme.beveling = 0.6
mod.theme.color_bevel = #b8964e
mod.theme.color_bevel_hover = #c9a65a
mod.theme.color_bevel_focus = #c8962a
mod.theme.color_bevel_active = #a8853e
mod.theme.color_bevel_empty = #b8964e
mod.theme.color_bevel_down = #8a6a2c
mod.theme.color_bevel_drag = #8a6a2c
mod.theme.color_bevel_disabled = #d8cfbd
mod.theme.color_bevel_inset_1 = #8a6a2c
mod.theme.color_bevel_inset_2 = #e2c886
mod.theme.color_bevel_outset_1 = #e2c886
mod.theme.color_bevel_outset_2 = #8a6a2c
mod.theme.color_bevel_inset_1_hover = #7a5c22
mod.theme.color_bevel_inset_2_hover = #ecd496
mod.theme.color_bevel_outset_1_hover = #ecd496
mod.theme.color_bevel_outset_2_hover = #7a5c22
mod.theme.color_bevel_inset_1_focus = #c8962a
mod.theme.color_bevel_inset_2_focus = #c8962a
mod.theme.color_bevel_outset_1_focus = #c8962a
mod.theme.color_bevel_outset_2_focus = #c8962a
mod.theme.color_bevel_inset_1_down = #6a4f1a
mod.theme.color_bevel_inset_2_down = #e2c886
mod.theme.color_bevel_outset_1_down = #8a6a2c
mod.theme.color_bevel_outset_2_down = #e2c886
mod.theme.color_bevel_inset_1_disabled = #d8cfbd
mod.theme.color_bevel_inset_2_disabled = #d8cfbd
mod.theme.color_bevel_outset_1_disabled = #d8cfbd
mod.theme.color_bevel_outset_2_disabled = #d8cfbd

// Ink: the pictures' dark grey-brown, about 11:1 on the stone. The second
// voice a warmer brown at 7:1; headings a gold-brown at 7.5:1; only
// disabled words go pale.
mod.theme.color_text = #3a2e1c
mod.theme.color_text_hover = #2a2112
mod.theme.color_text_focus = #2a2112
mod.theme.color_text_active = #2a2112
mod.theme.color_text_down = #2a2112
mod.theme.color_text_val = #5c4a2e
mod.theme.color_text_disabled = #a89c86
mod.theme.color_text_placeholder = #6e5f46
mod.theme.color_text_placeholder_hover = #64553c
mod.theme.color_text_meta = #64553c
mod.theme.color_text_hl = #5a4319
mod.theme.color_text_cursor = #3a2e1c
mod.theme.color_cursor = #3a2e1c
mod.theme.color_cursor_focus = #3a2e1c
mod.theme.color_label = #3a2e1c
mod.theme.color_label_hover = #2a2112
mod.theme.color_label_focus = #2a2112
mod.theme.color_label_active = #2a2112
mod.theme.color_label_down = #2a2112
mod.theme.color_label_disabled = #a89c86
mod.theme.color_label_inner = #4f3a12
mod.theme.color_label_inner_hover = #2a2112
mod.theme.color_label_inner_focus = #3a2e1c
mod.theme.color_label_inner_active = #2a2112
mod.theme.color_label_inner_down = #2a2112
mod.theme.color_label_inner_drag = #2a2112
mod.theme.color_label_inner_inactive = #64553c
mod.theme.color_label_inner_disabled = #a89c86
mod.theme.color_label_outer = #3a2e1c
mod.theme.color_label_outer_off = #5c4a2e
mod.theme.color_label_outer_hover = #2a2112
mod.theme.color_label_outer_focus = #2a2112
mod.theme.color_label_outer_active = #2a2112
mod.theme.color_label_outer_active_focus = #2a2112
mod.theme.color_label_outer_down = #2a2112
mod.theme.color_label_outer_drag = #2a2112
mod.theme.color_label_outer_disabled = #a89c86
mod.theme.color_icon = #6e521c
mod.theme.color_icon_hover = #4f3a12
mod.theme.color_icon_focus = #6e521c
mod.theme.color_icon_active = #4f3a12
mod.theme.color_icon_down = #4f3a12
mod.theme.color_icon_disabled = #b4a88f
// The inks on the surface ladder, named so they hold on its deepest rung.
mod.theme.color_on_surface = #382c1a
mod.theme.color_on_surface_variant = #5a4319

// The accent: emerald, measured on the pictures' stones (#079846 lit,
// #0b5028 in the deep). It fills a value and lights a level. Focus is a
// warm gold light.
mod.theme.color_focus = #c8962a
mod.theme.color_ctrl_active = #0d6a39
mod.theme.color_val = #0f7a42
mod.theme.color_val_hover = #14904f
mod.theme.color_val_focus = #14904f
mod.theme.color_val_drag = #14904f
mod.theme.color_val_disabled = #d0c8b6
mod.theme.color_mark = #3a2e1c
mod.theme.color_mark_active = #3a2e1c
mod.theme.color_mark_active_hover = #2a2112
mod.theme.color_mark_focus = #3a2e1c
mod.theme.color_mark_disabled = #b4a88f
// The accent seed: the primary, secondary and tertiary families are grown
// from its hue. A deep emerald, so the grown primary carries white ink.
mod.theme.color_ctrl_selected = #0d5c33
mod.theme.color_bg_highlight = #e9dfc6
// Rows of a tree or a list alternate faint washes, so the stone shows
// through them.
mod.theme.color_bg_even = #efe9da66
mod.theme.color_bg_odd = #fbf9f455
mod.theme.color_bg_highlight_inline = #e2c88666
mod.theme.color_text_on_accent = #fffaf0
// Selected text: a wash of pale gold, stronger while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #d9b85a38
mod.theme.color_selection_down = #d9b85a66
mod.theme.color_selection_focus = #d9b85a66
mod.theme.color_handle = #f8f7f3
mod.theme.color_handle_hover = #fdfcfa
mod.theme.color_handle_1 = #fdfcfa
mod.theme.color_handle_2 = #e6e2d8

// Screens are black onyx glass in gold bezels, their figures champagne
// gold. The terminal stays a white page with brown words.
mod.theme.color_screen = #161411
mod.theme.color_screen_ink = #f0d28a
mod.theme.screen_ghost = 0.10
mod.theme.color_terminal_bg = #f7f6f2
mod.theme.color_terminal_text = #3a2e1c

// SPACING. Rows of 26 points, gaps of 8 between controls, 6 inside a
// group, panels padded 10. The base froze what it derived from the
// factor, so every rung this sheet depends on is stated again.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 26.0
// Stock shaders draw a corner twice the number written: 2 is the 4 point
// corner of a jeweller's frame.
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 3.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs in true points: caps 3, fields 4, slabs and cards 6.
mod.theme.radius_s = 3.0
mod.theme.radius_m = 4.0
mod.theme.radius_l = 6.0

// TYPE. Body text in a plain grotesque at 9 points, so it reads on the
// stone; headings and legends in Playfair Display, the pictures' engraved
// serif feel.
mod.theme.font_size_p = 9.0
mod.theme.font_size_base = 9.0
mod.theme.type_title_l_size = 13.0
mod.theme.type_title_m_size = 11.5
mod.theme.type_title_s_size = 10.5
mod.theme.type_body_l_size = 9.5
mod.theme.type_body_m_size = 9.0
mod.theme.type_body_s_size = 8.5
mod.theme.type_label_l_size = 9.5
mod.theme.type_label_m_size = 9.0
mod.theme.type_label_s_size = 8.0
use mod.res.*
use mod.text.*
mod.theme.font_regular = mod.theme.font_regular{font_size: 9.0 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("makepad_widgets:resources/Inter.ttf") weight: 430.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_label = mod.theme.font_label{font_size: 9.0 font_family: mod.theme.font_label.font_family{ibm_plex_text := FontMember{res: crate_resource("makepad_widgets:resources/Inter.ttf") weight: 500.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_bold = mod.theme.font_bold{font_size: 10.5 font_family: mod.theme.font_bold.font_family{ibm_plex_semibold := FontMember{res: crate_resource("self:resources/PlayfairDisplay-Variable.ttf") weight: 700.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_title_l = mod.theme.font_bold{font_size: 13.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 11.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.5 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 9.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 9.0 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 8.0 line_spacing: 1.2}

// No surface material: the faces that matter are drawn by the sheet. The
// glow colour is the warm light of polished gold.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #f2c66a
true
