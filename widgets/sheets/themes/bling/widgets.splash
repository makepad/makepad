// The number field: a field; its stepper two small gold keys stacked at
// the right, parted by a dark seam, their chevrons engraved.
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), mb_snap(self.rect_size.y, o.y, px))
    return mb_field(p, lo, hi, 5.0, px, mb_seed(self.rect_size), self.hover, self.focus, self.disabled, 0.7) * mb_fade(self.pos, self.rect_size, m)
}
mod.widgets.NumberField.spin_width = 16.0
mod.widgets.NumberSpin.width = 16.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let x0 = mb_snap(0.5, o.x, px)
    let x1 = mb_snap(self.rect_size.x - 4.6, o.x, px)
    let y0 = mb_snap(5.2, o.y, px)
    let y1 = mb_snap(self.rect_size.y - 5.2, o.y, px)
    let mid = mb_snap(self.rect_size.y * 0.5, o.y, px)
    let live = 1.0 - self.disabled
    let tu = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), tu) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), tu) * live
    let lo = vec2(x0, mix(mid + px * 0.5, y0, tu))
    let hi = vec2(x1, mix(y1, mid - px * 0.5, tu))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, 1.5)
    let n = mb_normal(p, c, h, 1.5)
    let a = Finish.cover(d, px)
    var col = mb_goldface(p, c, h, d, n, 1.2) * (1.0 + 0.07 * hot - 0.10 * dn)
    col = mix(col, vec3(0.84, 0.81, 0.75), 0.6 * self.disabled)
    var res = vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a)
    let cx = (x0 + x1) * 0.5
    let cu = (y0 + mid) * 0.5
    let cd = (mid + y1) * 0.5
    let du = min(mb_seg(p, vec2(cx - 2.2, cu + 0.9), vec2(cx, cu - 1.0)), mb_seg(p, vec2(cx, cu - 1.0), vec2(cx + 2.2, cu + 0.9)))
    let dd = min(mb_seg(p, vec2(cx - 2.2, cd - 0.9), vec2(cx, cd + 1.0)), mb_seg(p, vec2(cx, cd + 1.0), vec2(cx + 2.2, cd - 0.9)))
    let k = Finish.cover(min(du, dd) - 0.55, px) * mix(1.0, 0.4, self.disabled)
    return Finish.over(res, vec4(vec3(0.20, 0.13, 0.03) * k, k))
}

// The chevron of a drop-down, engraved: 7 x 4 points in a 1.4 point stroke.
let mb_chevron = fn(dst: vec4, p: vec2, cc: vec2, ink: vec3, open: float, px: float) -> vec4 {
    let s = mix(1.0, -1.0, open)
    let dk = min(mb_seg(p, vec2(cc.x - 3.5, cc.y - 1.8 * s), vec2(cc.x, cc.y + 1.9 * s)), mb_seg(p, vec2(cc.x, cc.y + 1.9 * s), vec2(cc.x + 3.5, cc.y - 1.8 * s))) - 0.7
    let k = Finish.cover(dk, px)
    return Finish.over(dst, vec4(ink * k, k))
}

// THE DROP-DOWN: white marble in a chunky gold rim, a line of milgrain
// inside it, with a square key of polished
// gold at its right end carrying the chevron, as the pictures' selectors;
// open, the key is pressed in and its chevron turns up.
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 12.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
let mb_dropdown = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, open: float, dis: float, focus: float, lift: float) -> vec4 {
    let m = 10.0
    let px = mb_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x, o.x, px), mb_snap(size.y, o.y, px))
    let live = 1.0 - dis
    let rw = 3.8
    let held = max(down, open)
    var face = mb_stone(p + mb_seed(size), px, 0.42) * (1.0 + 0.03 * hover * live)
    face = mb_milgrain(face, p, (lo + hi) * 0.5, (hi - lo) * 0.5, 4.5, rw + 1.0, 0.6, 1.9, px)
    // The key: a square of gold inside the rim at the right end.
    let ks = (hi.y - lo.y) - 2.0 * rw
    let kc = vec2(hi.x - rw - ks * 0.5, (lo.y + hi.y) * 0.5)
    let kh = vec2(ks * 0.5, ks * 0.5)
    let kd = Material.sd_box(p, kc, kh, 1.5)
    let kn = mb_normal(p, kc, kh, 1.5)
    var kcol = mb_goldface(p, kc, kh, kd, kn, 1.6) * (1.0 + 0.06 * hover * live - 0.10 * held * live)
    let kin = Finish.inset(p, kc, kh, 1.5, vec2(0.0, 1.2), 1.3)
    kcol = mix(kcol, kcol * 0.72, clamp(kin, 0.0, 1.0) * 0.6 * held)
    kcol = mix(kcol, vec3(0.30, 0.21, 0.07), Finish.band(kd, 0.0, px, px) * 0.4 * step(p.x, kc.x - kh.x + 0.6))
    face = mix(face, kcol, Finish.cover(kd, px))
    face = mix(face, mb_ground(), 0.45 * dis)
    var res = mb_box(p, lo, hi, 4.5, rw, px, face, hover, 0.0, dis, focus, lift)
    res = mb_chevron(res, p, kc, mix(vec3(0.20, 0.13, 0.03), vec3(0.55, 0.50, 0.42), dis), open, px)
    return res * mb_fade(pos, size, m)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    return mb_dropdown(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.active, self.disabled, self.focus, 1.0)
}
mod.widgets.DropDownFlat.draw_text.color = #3a2e1c
mod.widgets.DropDownFlat.draw_text.color_hover = #2a2112
mod.widgets.DropDownFlat.draw_text.color_focus = #3a2e1c
mod.widgets.DropDownFlat.draw_text.color_disabled = #a89c86

