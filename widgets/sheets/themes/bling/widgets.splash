// Tabs: words on the stone parted by a short gold line; the tab in use a
// white marble tab in a gold rim with a gold bar under its word; under the
// hand a pale gold wash.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
let mb_tab = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, active: float) -> vec4 {
    let m = 8.0
    let px = mb_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(1.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x - 1.0, o.x, px), mb_snap(size.y, o.y, px))
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if active > 0.5 {
        let face = mb_stone(p + mb_seed(size), px, 0.42)
        res = mb_box(p, lo, hi, 3.5, 3.0, px, face, hover, 0.0, 0.0, 0.0, 1.0)
        let c = (lo + hi) * 0.5
        let bar = Material.sd_box(p, vec2(c.x, hi.y - 6.2), vec2(clamp(0.22 * (hi.x - lo.x), 5.0, 12.0), 0.8), 0.8)
        let ba = Finish.cover(bar, px)
        res = Finish.over(res, vec4(mb_gold(0.42) * ba, ba))
    } else {
        if hover > 0.001 {
            let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 3.0)
            let w = Finish.cover(d, px) * 0.10 * hover
            res = vec4(vec3(0.78, 0.63, 0.30) * w, w)
        }
    }
    return res * mb_fade(pos, size, m)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return mb_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    return mb_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    return mb_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 1.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let span = step(self.rect_size.y * 0.25, p.y) * step(p.y, self.rect_size.y * 0.75)
    let l = step(x, p.x) * step(p.x, x + px) * span
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * span
    return vec4(mb_gold(0.40), 1.0) * l + vec4(mb_gold(0.85), 1.0) * w * (1.0 - l)
}
mod.widgets.Tabs.draw_mark.color = #b8964e
mod.widgets.Tabs.draw_text.color = #5c4a2e
mod.widgets.Tabs.draw_text_active.color = #2a2112
mod.widgets.Tabs.draw_text.text_style.font_size = 9.0
mod.widgets.Tabs.draw_text_active.text_style.font_size = 9.0

// ---------------------------------------------------------------- feedback

// The progress bar: a gold tube, the value an emerald enamel rod in it
// (deep green with a lit line along its middle and a crystalline sparkle),
// a small round diamond at its head.
mod.widgets.ProgressBarFlat.height = 10.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(8.0, self.rect_size.y)
    let y0 = mb_snap((self.rect_size.y - th) * 0.5, o.y, px)
    let x0 = mb_snap(self.rect_size.x * self.start + 1.0, o.x, px)
    let x1 = mb_snap(self.rect_size.x * self.end - 1.0, o.x, px)
    let lo = vec2(x0, y0)
    let hi = vec2(x1, y0 + th)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if self.track > 0.5 {
        res = mb_rail(res, p, lo, hi, px, 0.0, 0.0, 0.0)
    }
    let rw = 1.5
    let span = hi.x - lo.x - rw * 2.0
    var f0 = lo.x + rw
    var f1 = f0 + span * clamp((self.value - self.start) / max(self.end - self.start, 0.001), 0.0, 1.0)
    let unknown = step(self.value, -0.0001)
    if unknown > 0.5 {
        f0 = lo.x + span * 0.3
        f1 = lo.x + span * 0.7
    }
    let fc = vec2((f0 + f1) * 0.5, (lo.y + hi.y) * 0.5)
    let fh = vec2(max((f1 - f0) * 0.5, 0.01), th * 0.5 - rw)
    let fd = Material.sd_box(p, fc, fh, fh.y)
    let fa = Finish.cover(fd, px) * step(0.5, fh.x)
    let t = (p.y - fc.y) / max(fh.y, 0.5)
    // The enamel: an intent other than the plain one tints it.
    let ic = self.fill_color()
    let tint = step(0.5, self.intent)
    let ink = mix(mb_emerald(), ic.rgb, tint * 0.8)
    var col = mix(ink * 0.55, ink * 1.05, smoothstep(1.0, -0.6, t))
    col = mix(col, mix(ink, vec3(1.0, 1.0, 1.0), 0.55), exp(-(t + 0.25) * (t + 0.25) / 0.06) * 0.55)
    let sp = Finish.hash(floor(p / (px * 1.5)) + vec2(3.7, 1.1))
    col = col * (0.88 + 0.24 * sp)
    col = mix(col, vec3(1.0, 1.0, 1.0), step(0.985, sp) * 0.6)
    var fill = vec4(col * fa, fa)
    if unknown > 0.5 {
        fill = fill * smoothstep(f0 - 1.0, f0 + span * 0.1, p.x) * smoothstep(f1 + 1.0, f1 - span * 0.1, p.x)
    }
    res = Finish.over(res, fill)
    if unknown < 0.5 && f1 > f0 + 2.0 {
        res = mb_gemdot(res, p, vec2(f1, fc.y), 3.9, px)
    }
    return res * self.opacity * mb_fade(self.pos, self.rect_size, m)
}

// THE LEVEL METER: a row of small square-cut stones set in a gold channel,
// the pictures' jewelled meter: emeralds to 70 %, citrines to 90 %, rubies
// past it; a lit stone is light itself (white at its heart), an unlit one
// dark tinted glass. A stone held at the peak, a ruby clip lamp.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    let wa = min(across, 8.0)
    let wb0 = (across - wa) * 0.5
    let wlo = mix(vec2(0.0, wb0), vec2(wb0, sz.y - bar), v)
    let whi = mix(vec2(bar, wb0 + wa), vec2(wb0 + wa, sz.y), v)
    let lo = vec2(mb_snap(wlo.x, o.x, px), mb_snap(wlo.y, o.y, px))
    let hi = vec2(mb_snap(whi.x, o.x, px), mb_snap(whi.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(2.0, min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let n = mb_normal(p, c, h, r)
    let ca = Finish.cover(d, px)
    let rw = clamp(0.18 * wa, 0.8, 1.4)
    var col = mb_gold(0.22)
    col = mix(col, mb_rim(d, rw, n, p), Finish.band(d, 0.0, rw, px))
    var res = vec4(col * ca, ca)
    let pad = rw + 0.6
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.5
    let ga = a - pad
    let ci = floor(ga / pitch)
    let cl = (ga - ci * pitch) - 1.85
    let gb = b - (wb0 + wa * 0.5)
    let ghw = max(wa * 0.5 - rw - 0.5, 0.6)
    let sd = max(abs(cl) - 1.75, abs(gb) - ghw)
    let cell = Finish.cover(sd, px)
    let share = clamp((ci * pitch + 1.85) / span, 0.0, 1.0)
    let inb = step(pad, a) * step(a, bar - pad)
    let ha = max(self.hot_at, 0.7)
    var ink = mb_emerald()
    ink = mix(ink, mb_citrine(), step(ha, share))
    ink = mix(ink, mb_ruby(), step(max(self.hot_to, 0.9), share))
    let on = step(share, self.level) * step(0.001, self.level)
    let hc = step(abs(ci * pitch - floor((span * self.hold) / pitch) * pitch), 0.1) * step(0.002, self.hold)
    let lit = max(on, hc * 0.9)
    let gq = vec2(cl / 1.75, gb / ghw)
    let core = exp(-dot(gq, gq) / 0.35)
    var lcol = mix(mb_lamp_hue(ink, 0.6) * 0.9, vec3(1.0, 0.99, 0.96), core * 0.55)
    lcol = lcol * (0.88 + 0.22 * Finish.hash(vec2(ci, 4.4)))
    var dcol = mix(vec3(0.07, 0.065, 0.055), mb_lamp_full(ink) * 0.35, 0.18)
    dcol = dcol + vec3(0.18, 0.17, 0.15) * smoothstep(0.5, 0.95, gq.y) * 0.5
    let gcol = mix(dcol, lcol, lit)
    res = Finish.over(res, vec4(gcol, 1.0) * cell * inb * self.opacity)
    if self.lamp > 0.5 {
        let lc = mix(vec2(bar + 3.0 + across * 0.5, sz.y * 0.5), vec2(sz.x * 0.5, across * 0.5), v)
        let rl = max(across * 0.5 - 2.0, 1.0)
        res = mb_lamp(res, p, lc, vec2(rl * 0.62, rl * 0.62), step(0.5, self.over), mb_ruby(), 0.6, px, mb_ground(), 2.0, 1.0)
    }
    return res * self.opacity
}

// The spinner keeps the library's own turning face and takes the gold.
mod.widgets.SpinnerFlat.draw_bg.color = #b8964e
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.18

// The rings, the arc and the stock bars keep their own faces; the plain
// intent reads in emerald.
mod.widgets.ProgressRingFlat.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressRing.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressArc.draw_bg.color_primary = #0f7a42
mod.widgets.ActivityRings.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressBar.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressBarGradientX.draw_bg.color_primary = #0f7a42
mod.widgets.ProgressBarGradientY.draw_bg.color_primary = #0f7a42

// Words in the error intent beside a check box or a toggle: a ruby red that
// reads on the stone.
mod.widgets.CheckBoxFlat.draw_text.color_error = #9c1830
mod.widgets.ToggleFlat.draw_text.color_error = #9c1830

// ---------------------------------------------------------------- surfaces

// The scroll bar: a slim gold rod for its gutter and a polished gold bead
// for its thumb, brighter under the hand.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 1.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.is_vertical
    let t0 = mix(sz.x * self.norm_scroll, sz.y * self.norm_scroll, v)
    let t1 = t0 + mix(sz.x * self.norm_handle, sz.y * self.norm_handle, v)
    let mid = mix(sz.y * 0.5, sz.x * 0.5, v)
    let glo = mix(vec2(1.0, mid - 1.0), vec2(mid - 1.0, 1.0), v)
    let ghi = mix(vec2(sz.x - 1.0, mid + 1.0), vec2(mid + 1.0, sz.y - 1.0), v)
    let gd = Material.sd_box(p, (glo + ghi) * 0.5, (ghi - glo) * 0.5, 1.0)
    let gutter = Finish.cover(gd, px) * 0.55
    var res = vec4(mb_gold(0.45) * gutter, gutter)
    let tlo = mix(vec2(t0, mid - 2.6), vec2(mid - 2.6, t0), v)
    let thi = mix(vec2(t1, mid + 2.6), vec2(mid + 2.6, t1), v)
    let lo = vec2(mb_snap(tlo.x, o.x, px), mb_snap(tlo.y, o.y, px))
    let hi = vec2(mb_snap(thi.x, o.x, px), mb_snap(thi.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, 2.6)
    let n = mb_normal(p, c, h, 2.6)
    let across = mix((p.y - c.y) / max(h.y, 0.5), (p.x - c.x) / max(h.x, 0.5), v)
    let nn = mix(vec2(0.0, 1.0), vec2(1.0, 0.0), v)
    var col = mb_gold(mb_env(across * dot(nn, mb_lv()) * 0.9)) * (1.0 + 0.10 * max(self.hover, self.drag))
    let a = Finish.cover(d, px) * 0.95
    res = Finish.over(res, vec4(col * a, a))
    return res * self.opacity
}

// A RAISED PANEL, the pictures' framed marble slab: white marble (its veins
// calm under the words) in a double polished gold frame 5.4 points wide (a
// broad bead, a dark groove, a slim bead), a dark seam and a line of
// milgrain beads inside the frame, a small gold scroll in each corner (kept within
// the corner's nine points, clear of anything the panel holds) and a soft
// warm shadow under it, drawn in from the sides so it stays in the gap.
// `sunk` 1 makes it a well: the stone under the frame, shaded under its top
// edge, no shadow out. `orn` 0 leaves the scrolls off.
let mb_panel = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, hover: float, lift: float, sunk: float, orn: float) -> vec4 {
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x, o.x, px), mb_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = mb_normal(p, c, h, r)
    let hs = vec2(max(h.x - 3.0, 1.0), h.y)
    let amb = Finish.drop(p, c, hs, min(r, min(hs.x, hs.y)), vec2(0.0, 3.0 + 0.6 * hover), 2.6) * (0.26 + 0.04 * hover) * lift
    let con = Finish.drop(p, c, h, r, vec2(0.0, 0.6 + px * 0.5), 0.6 + px * 0.5) * 0.30 * (1.0 - 0.5 * sunk)
    let sc = (1.0 - (1.0 - amb * (1.0 - sunk)) * (1.0 - con)) * (1.0 - a)
    var res = vec4(mb_shade() * sc, sc)
    let rw = 5.4
    var face = mb_stone(p + mb_seed(size) + vec2(37.0, 11.0), px, 0.6)
    let t = clamp((p.y - lo.y) / max(size.y, 1.0), 0.0, 1.0)
    face = face * mix(1.012 - 0.03 * t, 0.955, sunk) + vec3(0.006, 0.006, 0.005) * hover
    let insh = Finish.inset(p, c, h - vec2(rw, rw), max(r - rw, 0.0), vec2(0.0, mix(1.2, 3.4, sunk)), mix(1.5, 4.0, sunk))
    face = mix(face, face * mix(0.86, 0.72, sunk), clamp(insh, 0.0, 1.0) * mix(0.45, 0.9, sunk))
    var col = mb_milgrain(face, p, c, h, r, rw + 1.0, 0.62, 1.9, px)
    // The corner scrolls, with their own small shadow on the stone.
    if orn > 0.5 && size.x > 60.0 && size.y > 40.0 {
        let dl = p - lo
        let dr = hi - p
        let m = vec2(min(dl.x, dr.x), min(dl.y, dr.y)) - vec2(2.6, 2.6)
        let sx = mix(1.0, -1.0, step(dr.x, dl.x))
        let sy = mix(1.0, -1.0, step(dr.y, dl.y))
        let lv = vec2(mb_lv().x * sx, mb_lv().y * sy)
        let g = mb_corner(m, 0.9, lv, px)
        let shm = vec2(min(dl.x - 0.3, dr.x + 0.3), min(dl.y - 0.8, dr.y + 0.8)) - vec2(2.6, 2.6)
        let gs = mb_corner(shm, 0.9, lv, px)
        col = mix(col, col * 0.72, gs.x * 0.6)
        col = mix(col, mb_gold(g.y), g.x)
        // The small stone in each corner's eye.
        let eye = vec2(mix(hi.x - 8.9, lo.x + 8.9, step(0.0, sx)), mix(hi.y - 8.9, lo.y + 8.9, step(0.0, sy)))
        let ed = length(p - eye) - 1.55
        col = mix(col, mb_gold(0.3), Finish.cover(ed - 0.45, px))
        col = mix(col, mb_brilliant(p - eye, 1.55, mb_diamond(), 0.4, px), Finish.cover(ed, px))
    }
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.55)
    col = mix(col, mb_rim2(d, rw, n, p, px), Finish.band(d, 0.0, rw, px))
    return Finish.over(res, vec4(col * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 12.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return mb_panel(p, self.rect_size, self.rect_pos, px, 5.0, 0.0, 1.0, step(0.5, self.sunken), 1.0) * mb_fade(self.pos, self.rect_size, m)
}

// The rounded view keeps the colour its caller gives it, with a true
// corner and, when it is opaque, a fine gold edge.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    var ink = self.border_color
    if self.border_size < 0.01 {
        ink = vec4(mb_gold(0.5), fill.a)
    }
    let a = Finish.cover(d, px)
    let bd = Finish.band(d, 0.0, max(self.border_size, px), px)
    var col = mix(fill.rgb, ink.rgb, bd * ink.a)
    return vec4(col * a * fill.a, a * fill.a) + vec4(ink.rgb * ink.a, ink.a) * bd * a * (1.0 - fill.a)
}

// The card: its three appearances told apart. Elevated, a framed marble
// slab standing off the stone with its scrolls and a deeper shadow, more of
// it under the hand; filled, a framed slab seated with its contact shadow
// only; outlined, the stone inside a fine gold wire.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 13.0 bottom: 13.0}
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 14.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let fade = mb_fade(self.pos, self.rect_size, m)
    if self.border_size > 0.01 {
        let o = self.rect_pos
        let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
        let hi = vec2(mb_snap(self.rect_size.x, o.x, px), mb_snap(self.rect_size.y, o.y, px))
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 5.0)
        let n = mb_normal(p, c, h, 5.0)
        let ring = Finish.band(d, 0.0, 2.4, px)
        let col = mb_rim(d, 2.4, n, p)
        let wash = 0.3 * self.hover * Finish.cover(d, px)
        var res = vec4(vec3(1.0, 1.0, 1.0) * wash, wash)
        return Finish.over(res, vec4(col * ring, ring)) * fade
    }
    if self.shadow_radius < 0.01 {
        return mb_panel(p, self.rect_size, self.rect_pos, px, 5.0, self.hover, 0.0, 0.0, 1.0) * fade
    }
    return mb_panel(p, self.rect_size, self.rect_pos, px, 5.0, self.hover, 1.3, 0.0, 1.0) * fade
}

// LISTS: the rows stand in a white marble well framed in a gold rim, each
// row drawing the part of the well it covers (the well is the clip the rows
// are drawn in, the list's own box, so it stays put while the rows scroll).
// The well is held four points in from the box's leading edge and a point
// from the others, so whatever stands beside the list keeps its room. Under the hand a row takes a pale gold wash; the chosen row is a
// strip of pavé diamonds in a gold rim. The words are the ink.
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 14.0 right: 10.0 top: 0.0 bottom: 0.0}
// A one-line row is 25 points, so a short list ends on a whole row.
mod.widgets.ListItemOne.height = 25.0
mod.widgets.ListItem.clip_x = false
mod.widgets.ListItem.clip_y = false
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let tlo = vec2(mb_snap(self.draw_clip.x - o.x + 4.0, o.x, px), mb_snap(self.draw_clip.y - o.y + 1.0, o.y, px))
    let thi = vec2(mb_snap(self.draw_clip.z - o.x - 1.0, o.x, px), mb_snap(self.draw_clip.w - o.y - 1.0, o.y, px))
    let tc = (tlo + thi) * 0.5
    let th = max((thi - tlo) * 0.5, vec2(1.0, 1.0))
    let tr = min(4.0, min(th.x, th.y))
    let d = Material.sd_box(p, tc, th, tr)
    let n = mb_normal(p, tc, th, tr)
    let a = Finish.cover(d, px)
    // The well's stone is laid in the well's own frame, so it holds still
    // under the scrolling rows.
    let wq = p - tlo + mb_seed(thi - tlo)
    var col = mb_stone(wq, px, 0.4) * 0.985
    col = mix(col, col * 0.84, clamp(Finish.inset(p, tc, th - vec2(2.2, 2.2), tr, vec2(0.0, 2.0), 2.4), 0.0, 1.0) * 0.6)
    col = col + vec3(0.06, 0.045, 0.01) * self.hover * live
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, 2.2, 2.2 + px, px) * 0.5)
    col = mix(col, mb_rim(d, 2.2, n, p), Finish.band(d, 0.0, 2.2, px))
    var res = vec4(col * a, a)
    if self.selected > 0.001 {
        let lo = vec2(mb_snap(8.0, o.x, px), mb_snap(2.0, o.y, px))
        let hi = vec2(mb_snap(self.rect_size.x - 5.0, o.x, px), mb_snap(self.rect_size.y - 2.0, o.y, px))
        res = Finish.over(res, mb_pave_strip(p, lo, hi, px, self.selected) * a)
    }
    return res
}
mod.widgets.ListItem.draw_text.color = #3a2e1c
mod.widgets.ListItem.draw_text_2.color = #5c4a2e

// A chip is a small white marble box in a gold rim; its label the ink
// whatever its role.
mod.widgets.ChipFlat.draw_text.text_style = mod.theme.font_bold{font_size: 9.0}
mod.widgets.ChipFlat.palette.on_neutral = #3a2e1c
mod.widgets.ChipFlat.palette.on_neutral_container = #3a2e1c
mod.widgets.ChipFlat.palette.neutral = #3a2e1c
mod.widgets.ChipFlat.palette.on_primary = #3a2e1c
mod.widgets.ChipFlat.palette.on_primary_container = #3a2e1c
mod.widgets.ChipFlat.palette.primary = #3a2e1c
mod.widgets.ChipFlat.palette.on_secondary_container = #3a2e1c
mod.widgets.ChipFlat.palette.on_tertiary_container = #3a2e1c
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), mb_snap(self.rect_size.y, o.y, px))
    let face = mb_stone(p + mb_seed(self.rect_size), px, 0.45) * (1.0 + 0.04 * self.hover - 0.06 * self.down)
    return mb_box(p, lo, hi, 3.5, 2.6, px, face, self.hover, self.down, 0.0, self.keyed, 1.0) * mb_fade(self.pos, self.rect_size, m)
}

// A count is a small white marble box in a gold rim with brown figures.
mod.widgets.BadgePalette.neutral = #f6f5f1
mod.widgets.BadgePalette.on_neutral = #3a2e1c
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(self.rect_size.x - px * 0.49, o.x, px), mb_snap(self.rect_size.y - px * 0.49, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(3.0, min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let n = mb_normal(p, c, h, r)
    let rw = 2.2
    var col = mb_stone(p + mb_seed(self.rect_size), px, 0.3)
    col = mix(col, self.color.rgb, 0.3 * step(self.color.a, 0.99))
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.5)
    col = mix(col, mb_rim(d, rw, n, p), Finish.band(d, 0.0, rw, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// LAMPS. The Lamp and the bar lamp are the sheet's LED gem (above) in its
// gold bezel. The halo's room is held in the lamp's own box, so the light is
// never cut at its edge; the bar lamp keeps to the left of its cell, short
// enough that it and its light end well before whatever stands beside it.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_accent = uniform(#18b864)
mod.widgets.Lamp.draw_bg.color_success = uniform(#22c76a)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#f5a52e)
mod.widgets.Lamp.draw_bg.color_error = uniform(#ec2f4a)
mod.widgets.Lamp.draw_bg.color_plain = uniform(#ffe6b8)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let c = self.rect_size * 0.5
    // A bar is a short light pipe a little slimmer than the round lamp,
    // set at the left of its cell, its light kept within two and a half
    // points of its bezel.
    let tb = mix(t, t * 0.78, self.bar)
    let half_len = min(max((self.rect_size.x - 2.0 * room) * 0.5, t * 0.5), tb * 1.1)
    let bwb = clamp(0.32 * tb * 0.5, 0.7, 2.4)
    let cb = vec2(mix(c.x, 1.0 + bwb + half_len, self.bar), c.y)
    let hb = vec2(mix(t * 0.5, half_len, self.bar), tb * 0.5)
    let res = mb_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, cb, hb, self.lit, self.intent_color().rgb, 0.35 * (1.0 - step(3.5, self.intent)), px, mb_ground(), mix(max(room - 0.5, 2.0), 2.5, self.bar), 1.0)
    return res * self.opacity
}

// Dividers are a fine gold wire: a bright line over a dark one, a small
// round diamond set at the middle of a long one.
mod.widgets.Hr.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Hr.draw_bg.pixel = fn() {
    let m = 4.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let span = step(4.0, p.x) * step(p.x, self.rect_size.x - 4.0)
    let l = step(y, p.y) * step(p.y, y + px) * span
    let w = step(y + px, p.y) * step(p.y, y + px * 2.0) * (1.0 - l) * span
    var res = vec4(mb_gold(0.80), 1.0) * l + vec4(mb_gold(0.30), 1.0) * w
    if self.rect_size.x > 80.0 {
        res = mb_gemdot(res, p, vec2(self.rect_size.x * 0.5, y + px), 2.6, px)
    }
    return res * mb_fade(self.pos, self.rect_size, m)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let l = step(x, p.x) * step(p.x, x + px)
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * (1.0 - l)
    return vec4(mb_gold(0.80), 1.0) * l + vec4(mb_gold(0.30), 1.0) * w
}

// ---------------------------------------------------------------- screens

// A SCREEN is black onyx glass in a polished gold bezel: the face the
// screen colour with a few faint grey veins in it (a black marble, calm
// enough for the figures), darkest under its top edge where the bezel
// shades it (`recess` points deep), a dark device pixel where the face
// meets the gold; the bezel (`bezel` points, at least two) a round bead lit
// from the top; a contact shadow on the stone under it. Figures on it are
// champagne gold.
let mb_screen = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, bezel: float, recess: float, face_ink: vec3) -> vec4 {
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x, o.x, px), mb_snap(size.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let ro = min(r, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, ro)
    let n = mb_normal(p, c, ho, ro)
    let b = Finish.snap(max(bezel, 2.2), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(ro - b, 0.0)
    let fd = Material.sd_box(p, c, hf, rf)
    let sh = Finish.drop(p, c, ho, ro, vec2(0.0, 1.0), 1.1) * 0.30 * (1.0 - Finish.cover(outer, px))
    var res = vec4(mb_shade() * sh, sh)
    // The black marble: the stone's veins, inverted and faint.
    let st = mb_stone(p + mb_seed(size) + vec2(91.0, 17.0), px, 1.0)
    let vein = clamp((0.965 - dot(st, vec3(0.333, 0.333, 0.334))) * 3.0, 0.0, 1.0)
    var face = face_ink + vec3(0.11, 0.105, 0.095) * vein * 0.55
    if recess > 0.0 {
        let insh = Finish.inset(p, c, hf, rf, vec2(0.0, recess * 0.5), max(recess * 0.45, 0.3))
        face = mix(face, face * 0.35, 0.8 * insh)
    }
    face = mix(face, vec3(0.02, 0.015, 0.008), Finish.band(fd, 0.0, px, px) * 0.8)
    let col = mix(mb_rim(outer, b, n, p), face, Finish.cover(fd, px))
    let a = Finish.cover(outer, px)
    return Finish.over(res, vec4(col * a, a))
}
mod.widgets.ScreenView.draw_bg.border_radius = uniform(5.0)
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    var res = mb_screen(p, self.rect_size, self.rect_pos, px, self.border_radius, self.bezel, self.recess, self.color.rgb)
    // The screen's status light, an emerald lit in its top right corner;
    // its light stays on the face.
    let b = max(self.bezel, 2.2)
    let fdist = Material.sd_box(p, self.rect_size * 0.5, max(self.rect_size * 0.5 - vec2(b, b), vec2(0.5, 0.5)), max(self.border_radius - b, 0.0))
    res = mix(res, mb_lamp(res, p, vec2(self.rect_size.x - b - 5.5, b + 5.5), vec2(1.5, 1.5), 1.0, mb_emerald(), 0.6, px, vec3(0.08, 0.07, 0.06), 6.0, 0.0), Finish.cover(fdist + 0.5, px))
    if self.scan > 0.0 {
        let s = Finish.scan(p.y, px, 3.0 * px, self.scan)
        res = vec4(res.rgb * mix(1.0, s, 0.6), res.a)
    }
    return res * self.color.a
}
// The glass: a faint diagonal band over the face.
mod.widgets.ScreenView.sheen = 0.035
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = mb_px(self.draw_pass.dpi_factor)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let b = Finish.snap(max(self.bezel, 2.2), px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let fd = Material.sd_box(p, c, hf, max(min(self.face_radius, min(ho.x, ho.y)) - b, 0.0))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let a = clamp(self.sheen * band, 0.0, 1.0) * Finish.cover(fd + px, px)
    return vec4(vec3(1.0, 0.95, 0.85) * a, a)
}

// THE NEEDLE METER is a screen: the same onyx in its gold bezel, its scale
// printed in gold (a tick at every division, the majors two device pixels
// wide and the minors one and dimmer, a faint arc under them), the red
// zone a ruby band just outside the arc, the needle a fine gold line with a
// soft warm light along it, its root under a small round diamond in a gold
// bezel.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(5.0)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#d0203e)
mod.widgets.NeedleMeter.draw_bg.color_scale = uniform(#e2c886)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#f6dc98)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = mb_px(self.draw_pass.dpi_factor)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let res = mb_screen(p, self.rect_size, self.rect_pos, px, self.border_radius, 2.4, 4.0, self.color.rgb)
    var col = res.rgb / max(res.a, 0.001)
    let ink = self.color_scale.rgb
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, -q.y * cos(ak) + q.x * sin(ak))
    col = mix(col, ink, max(arc * 0.4, tick * mix(0.55, 0.95, major)))
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        col = mix(col, self.color_zone.rgb, zone_t * zone_r * 0.9)
    }
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let tail = max(self.pivot_size - px, 0.0)
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let span = smoothstep(-1.0, 1.0, rr + 3.0 - along) * smoothstep(-1.0, 1.0, along + tail)
    let halo = 0.30 / (1.0 + (across / 1.2) * (across / 1.2)) * span
    col = col + (vec3(1.0, 1.0, 1.0) - exp(-vec3(0.95, 0.70, 0.30) * halo)) * max(vec3(1.0, 1.0, 1.0) - col, vec3(0.0, 0.0, 0.0))
    let needle = Finish.cover(across - 0.55, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - tail, px)
    col = mix(col, self.color_needle.rgb, needle)
    let pr = max(self.pivot_size + 0.5, 2.0)
    let piv = mb_gemdot(vec4(0.0, 0.0, 0.0, 0.0), p, pv, pr, px)
    col = col * (1.0 - piv.a) + piv.rgb
    return vec4(col * res.a, res.a) * self.opacity
}

// ---------------------------------------------------------------- own faces

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.BurgerButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
