// ---------------------------------------------------------------- selection

// The small controls' quads grow by this much, for their shadow and their
// focus spill.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(15.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(1.5)
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0

// A gold mark (a check or a dash) in a warm white with a dark brown edge,
// so it reads on gold. `dk` its distance.
let mb_mark = fn(dst: vec4, dk: float, px: float, amt: float, dis: float) -> vec4 {
    let ea = Finish.cover(dk - 0.55, px) * amt
    var res = Finish.over(dst, vec4(vec3(0.24, 0.16, 0.04) * ea * 0.85, ea * 0.85))
    let ma = Finish.cover(dk, px) * amt
    let mc = mix(vec3(1.0, 0.975, 0.90), vec3(0.93, 0.91, 0.86), dis)
    return Finish.over(res, vec4(mc * ma, ma))
}

// The check box: a 15 point gold tile with a 3 point corner, its rim a
// polished bead; empty, its middle is a satin gold sunk a little under the
// rim; set, the middle is polished and a warm white check stands on it (a
// dash when mixed).
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(mb_snap(x0, o.x, px), mb_snap(y0, o.y, px))
    let hi = vec2(mb_snap(x0 + sz, o.x, px), mb_snap(y0 + sz, o.y, px))
    let held = max(self.down, self.pressed)
    let on = max(self.active, self.mixed)
    let live = 1.0 - self.disabled
    let sink = 0.5 * held * live
    let c = (lo + hi) * 0.5 + vec2(0.0, sink)
    let h = (hi - lo) * 0.5
    let r = 3.0
    let rw = 1.7
    let hf = h - vec2(rw, rw)
    let df = Material.sd_box(p, c, hf, r - rw * 0.5)
    let nf = mb_normal(p, c, hf, r - rw * 0.5)
    var face = mb_goldface(p, c, hf, df, nf, 1.4)
    // Empty: satin, a step deeper; set: polished.
    let satin = mb_gold(0.36 + 0.06 * (1.0 - smoothstep(-1.0, 1.0, (p.y - c.y) / max(hf.y, 1.0))))
    face = mix(satin, face, on)
    face = face * (1.0 + 0.06 * self.hover * live - 0.12 * held * live)
    face = mix(face, vec3(0.82, 0.79, 0.72), 0.6 * self.disabled)
    var res = mb_box(p, lo, hi, r, rw, px, face, self.hover, held, self.disabled, self.focus, 1.0)
    // The error: the rim turns ruby.
    let d = Material.sd_box(p, c, h, r)
    res = Finish.over(res, vec4(0.70, 0.08, 0.15, 1.0) * Finish.band(d, 0.0, 1.2, px) * self.error * live)
    let cm = c + vec2(0.0, 0.2)
    let dm = min(mb_seg(p, vec2(cm.x - 3.4, cm.y + 0.1), vec2(cm.x - 1.1, cm.y + 2.5)), mb_seg(p, vec2(cm.x - 1.1, cm.y + 2.5), vec2(cm.x + 3.5, cm.y - 2.6)))
    let dd = mb_seg(p, vec2(cm.x - 3.2, cm.y), vec2(cm.x + 3.2, cm.y))
    let dk = mix(dm - 0.85, dd - 0.95, self.mixed)
    res = mb_mark(res, dk, px, on, self.disabled)
    return res * mb_fade(self.pos, self.rect_size, m)
}

// THE TOGGLE, the pictures' gold key in a gold frame: a 36 x 20 point frame
// with a 4 point corner, its floor a satin gold sunk under its rim, and in
// it a square key of polished gold standing up, at the left while off and
// at the right while on. On, the key carries a round brilliant diamond set
// in it, glinting; off, an engraved dash. The key follows a drag.
mod.widgets.ToggleFlat.draw_bg.size = uniform(20.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(1.9)
mod.widgets.ToggleFlat.label_walk.margin.left = 38.0
let mb_toggle = fn(pos: vec2, size: vec2, o: vec2, dpi: float, th0: float, aspect: float, at_end: float, hover: float, held: float, dis: float, on: float, kt: float, focus: float, error: float) -> vec4 {
    let m = 10.0
    let px = mb_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = th0 * aspect
    let th = th0
    let x0 = (size.x - tw) * at_end
    let y0 = size.y * 0.5 - th * 0.5
    let lo = vec2(mb_snap(x0, o.x, px), mb_snap(y0, o.y, px))
    let hi = vec2(mb_snap(x0 + tw, o.x, px), mb_snap(y0 + th, o.y, px))
    let r = 4.0
    let rw = 1.7
    let live = 1.0 - dis
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    // The frame's floor: satin gold, deeper under the rim.
    let floor_col = mix(mb_gold(0.30), mb_gold(0.40 + 0.06 * on), smoothstep(-1.0, 1.0, (p.y - c.y) / max(h.y, 1.0)))
    var face = mix(floor_col, vec3(0.82, 0.79, 0.72), 0.6 * dis)
    var res = mb_box(p, lo, hi, r, rw, px, face, hover * 0.4, 0.0, dis, focus, 0.8)
    // The key: a square of polished gold standing in the frame, its own
    // shadow on the floor.
    let ks = th - 2.0 * rw - 1.0
    let kh = vec2(ks, ks) * 0.5
    let travel = (hi.x - lo.x) - 2.0 * rw - ks - 1.0
    let sink = 0.8 * held * live
    let kc = vec2(lo.x + rw + 0.5 + kh.x + travel * clamp(kt, 0.0, 1.0), c.y + sink)
    let fl = Finish.cover(Material.sd_box(p, c, h - vec2(rw, rw), r - rw), px)
    let ksh = Finish.drop(p, kc, kh, 2.5, vec2(0.5, 1.1), 1.0 + px) * 0.45 * (1.0 - 0.6 * held) * live * fl
    res = Finish.over(res, vec4(mb_shade() * ksh, ksh))
    let kd = Material.sd_box(p, kc, kh, 2.5)
    let kn = mb_normal(p, kc, kh, 2.5)
    var kcol = mb_goldface(p, kc, kh, kd, kn, 2.0)
    kcol = kcol * (1.0 + 0.06 * hover * live - 0.12 * held * live)
    kcol = mix(kcol, mb_gold(0.28), Finish.band(kd, 0.0, px, px) * 0.6)
    kcol = mix(kcol, vec3(0.84, 0.81, 0.75), 0.6 * dis)
    let ka = Finish.cover(kd, px)
    res = Finish.over(res, vec4(kcol * ka, ka))
    // On: a diamond set in the key, glinting; off: an engraved dash.
    let gr = ks * 0.30
    let gd = length(p - kc) - gr
    if on > 0.001 {
        let seat = Finish.cover(gd - 0.7, px) * on
        res = Finish.over(res, vec4(mb_gold(0.25) * seat, seat))
        let gcol = mix(mb_gem(p - kc, gr, vec3(1.0, 1.0, 1.0), 0.3, 2.0), vec3(0.85, 0.84, 0.80), 0.6 * dis)
        let ga = Finish.cover(gd, px) * on
        res = Finish.over(res, vec4(gcol * ga, ga))
        let gl = mb_glint(p - kc - vec2(gr * 0.35, -gr * 0.4), gr * 2.6, px) * on * live
        res = Finish.over(res, vec4(gl, gl, gl, gl))
    }
    let dsh = mb_seg(p, kc - vec2(ks * 0.22, 0.0), kc + vec2(ks * 0.22, 0.0)) - 0.75
    res = mb_mark(res, dsh, px, 1.0 - on, dis)
    let ed = Material.sd_box(p, c, h, r)
    res = Finish.over(res, vec4(0.70, 0.08, 0.15, 1.0) * Finish.band(ed, 0.0, 1.2, px) * error * live)
    return res * mb_fade(pos, size, m)
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleSlide.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleRocker.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    return mb_toggle(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.size, self.pill_aspect, self.mark_at_end, self.hover, max(self.pressed, self.down), self.disabled, self.active, mix(self.active, self.drag_pos, self.drag), self.focus, self.error)
}

// The slide switch is the toggle: the same gold frame and key.
mod.widgets.ToggleSlide.draw_bg.size = uniform(20.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(1.9)
mod.widgets.ToggleSlide.label_walk.margin.left = 38.0
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    return mb_toggle(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.size, self.pill_aspect, self.mark_at_end, self.hover, max(self.pressed, self.down), self.disabled, self.active, mix(self.active, self.drag_pos, self.drag), self.focus, self.error)
}

// The rocker: a white marble plate in a gold rim, split at its middle. The
// half in force is pressed in and turned to polished gold, its legend a
// warm white; the raised half is the white stone, its legend brown: the O
// at the left while off, the I at the right while on.
mod.widgets.ToggleRocker.draw_bg.size = uniform(20.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.3)
mod.widgets.ToggleRocker.label_walk.margin.left = 46.0
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(mb_snap(x0, o.x, px), mb_snap(y0, o.y, px))
    let hi = vec2(mb_snap(x0 + tw, o.x, px), mb_snap(y0 + th, o.y, px))
    let r = 4.0
    let rw = 1.7
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active
    let held = max(self.pressed, self.down)
    var face = mb_stone(p + mb_seed(self.rect_size), px, 0.5)
    face = mix(face, mb_ground(), 0.5 * self.disabled)
    var res = mb_box(p, lo, hi, r, rw, px, face, self.hover, 0.0, self.disabled, self.focus, 1.0)
    // The half in force: polished gold, pressed in under the rim, a dark
    // seam at the middle.
    let hw = (hi.x - lo.x) * 0.5
    let sx = mix(lo.x + rw, c.x, on)
    let slo = vec2(sx, lo.y + rw)
    let shi = vec2(sx + hw - rw, hi.y - rw)
    let sc = (slo + shi) * 0.5
    let sh = (shi - slo) * 0.5
    let sd = Material.sd_box(p, sc, sh, max(r - rw, 0.5))
    let sn = mb_normal(p, sc, sh, max(r - rw, 0.5))
    var gcol = mb_goldface(p, sc, sh, sd, sn, 1.6) * (1.0 - 0.08 * held)
    let ins = Finish.inset(p, sc, sh, max(r - rw, 0.5), vec2(0.0, 1.2), 1.3)
    gcol = mix(gcol, gcol * 0.70, clamp(ins, 0.0, 1.0) * 0.6)
    gcol = mix(gcol, vec3(0.84, 0.81, 0.75), 0.6 * self.disabled)
    let ga = Finish.cover(sd, px)
    res = Finish.over(res, vec4(gcol * ga, ga))
    let seam = Finish.cover(abs(p.x - c.x) - 0.5 * px, px) * Finish.cover(abs(p.y - c.y) - (th * 0.5 - rw), px)
    res = Finish.over(res, vec4(vec3(0.30, 0.21, 0.07) * seam * 0.7, seam * 0.7))
    // The legends.
    let lc_o = vec2(lo.x + hw * 0.5 + 0.5, c.y)
    let lc_i = vec2(c.x + hw * 0.5 - 0.5, c.y)
    let s = th / 20.0
    let d_o = abs(length((p - lc_o) * vec2(1.25, 1.0)) - 3.4 * s) - 0.65 * s
    let d_i = mb_seg(p, lc_i - vec2(0.0, 3.5 * s), lc_i + vec2(0.0, 3.5 * s)) - 0.65 * s
    let cream = vec3(1.0, 0.975, 0.90)
    let brown = vec3(0.30, 0.23, 0.12)
    let fade = mix(1.0, 0.45, self.disabled)
    let ao = Finish.cover(d_o, px) * fade
    let ai = Finish.cover(d_i, px) * fade
    res = Finish.over(res, vec4(mix(cream, brown, on) * ao, ao))
    res = Finish.over(res, vec4(mix(brown, cream, on) * ai, ai))
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    res = Finish.over(res, vec4(0.70, 0.08, 0.15, 1.0) * Finish.band(d, 0.0, 1.2, px) * self.error * live)
    return res * mb_fade(self.pos, self.rect_size, m)
}

// The radio: a 15 point gold dome; chosen, it opens into a gold bezel with
// a round brilliant diamond set in it, glinting.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(15.0)
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0

// A gold dome `rad` round `c`, satin rather than mirror: lit from the top,
// a soft highlight high on it, its lower side a deeper gold, its foot
// rolling under.
let mb_golddome = fn(p: vec2, c: vec2, rad: float) -> vec3 {
    let q = (p - c) / max(rad, 0.5)
    let ql = min(length(q), 1.0)
    let n = q / max(length(q), 0.001)
    let e = sin(ql * 1.4) * dot(n, mb_lv()) / sin(1.4)
    var l = 0.50 + 0.26 * e + 0.30 * exp(-(e - 0.55) * (e - 0.55) / 0.03)
    l = l - 0.12 * smoothstep(0.82, 1.0, ql)
    return mb_gold(l)
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(y0, o.y, px))
    let hi = vec2(mb_snap(sz, o.x, px), mb_snap(y0 + sz, o.y, px))
    let live = 1.0 - self.disabled
    let on = self.active
    let rad = sz * 0.5
    let sink = 0.4 * self.down * live
    let c = (lo + hi) * 0.5 + vec2(0.0, sink)
    let sc = mb_shadow(p, (lo + hi) * 0.5, vec2(rad, rad), rad, px, self.hover, self.down, self.disabled)
    var res = vec4(mb_shade() * sc, sc)
    let d = length(p - c) - rad
    let a = Finish.cover(d, px)
    if self.focus * live > 0.001 {
        res = Finish.over(res, mb_leak(d, a) * self.focus * live)
    }
    var col = mb_golddome(p, c, rad) * (1.0 + 0.06 * self.hover * live - 0.12 * self.down * live)
    // Chosen: the bezel's rim and the stone in it.
    let rw = 1.8
    let n = (p - c) / max(length(p - c), 0.001)
    let bez = mb_rim(d, rw, n, p)
    let gr = rad - rw - 0.3
    let gd = length(p - c) - gr
    let gem = mb_gem(p - c, gr, vec3(1.0, 1.0, 1.0), 0.2, 2.0)
    var chosen = mix(bez, gem, Finish.cover(gd, px))
    chosen = mix(chosen, vec3(0.30, 0.21, 0.07), Finish.band(gd, -px, 0.0, px) * 0.6)
    col = mix(col, chosen, on)
    col = mix(col, vec3(0.84, 0.81, 0.75), 0.6 * self.disabled)
    col = mb_focus_rim(col, d, rw, px, self.focus * live)
    res = Finish.over(res, vec4(col * a, a))
    let gl = mb_glint(p - c - vec2(gr * 0.3, -gr * 0.35), gr * 2.4, px) * on * live
    res = Finish.over(res, vec4(gl, gl, gl, gl))
    return res * mb_fade(self.pos, self.rect_size, m)
}

// The radio tab: a cell of white marble in a gold rim; chosen, it is
// pressed in and its floor turns to polished gold.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), mb_snap(self.rect_size.y, o.y, px))
    let sel = self.active
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rw = 3.0
    let hf = h - vec2(rw, rw)
    let df = Material.sd_box(p, c, hf, 2.0)
    let nf = mb_normal(p, c, hf, 2.0)
    var face = mb_stone(p + mb_seed(self.rect_size), px, 0.45) * (1.0 + 0.03 * self.hover)
    var gold = mb_goldface(p, c, hf, df, nf, 1.8)
    let ins = Finish.inset(p, c, hf, 2.0, vec2(0.0, 1.4), 1.6)
    gold = mix(gold, gold * 0.68, clamp(ins, 0.0, 1.0) * 0.65)
    face = mix(face, gold, sel)
    face = mix(face, mb_ground(), 0.5 * self.disabled)
    return mb_box(p, lo, hi, 3.5, rw, px, face, self.hover, max(self.down, sel), self.disabled, self.focus, 1.0) * mb_fade(self.pos, self.rect_size, m)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #5c4a2e
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #2a2112
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #26190a
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #a89c86
mod.widgets.RadioButtonTabFlat.draw_text.get_color = fn() {
    return self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down)
        .mix(self.color_active, self.active)
        .mix(self.color_disabled, self.disabled)
}

// ---------------------------------------------------------------- sliders

// THE RAIL: a gold tube from `lo` to `hi` with round ends, a polished bead
// along each edge round a satin gold floor a step deeper; the value lies in
// it as a row of pavé diamonds from `f0` to `f1`. Premultiplied over `dst`.
let mb_rail = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, px: float, f0: float, f1: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(h.x, h.y)
    let d = Material.sd_box(p, c, h, r)
    let n = mb_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let sh = Finish.drop(p, c, h, r, vec2(0.0, 0.8), 0.8 + px * 0.5) * 0.25 * (1.0 - a) * (1.0 - 0.6 * dis)
    var res = Finish.over(dst, vec4(mb_shade() * sh, sh))
    let rw = clamp(0.30 * (hi.y - lo.y), 1.0, 1.8)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(mb_gold(0.26), mb_gold(0.42), t)
    col = mix(col, mb_rim(d, rw, n, p), Finish.band(d, 0.0, rw, px))
    col = mix(col, vec3(0.84, 0.81, 0.75), 0.6 * dis)
    res = Finish.over(res, vec4(col * a, a))
    let prad = max(h.y - rw - 0.15, 0.6)
    if f1 > f0 + 0.5 && dis < 0.5 {
        res = mb_pave_row(res, p, f0, f1, c.y, prad, prad * 2.15, px)
    }
    return res
}

// THE THUMB: a step-cut stone (an emerald cut, `hw` x `hv` either side of
// `c`, its corners cut) held in a polished gold frame with a claw at each
// corner, throwing its own shadow; under the hand it glints, held it sits
// down. `ink` the stone.
let mb_thumb = fn(dst: vec4, p: vec2, c0: vec2, hw: float, hv: float, ink: vec3, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let c = c0 + vec2(0.0, 0.4 * drag * live)
    let h = vec2(hw, hv)
    let sc = mb_shadow(p, c0, h, 1.5, px, hover, drag, dis)
    var res = Finish.over(dst, vec4(mb_shade() * sc, sc))
    let d = Finish.sd_chamfer(p, c, h, 2.0)
    let a = Finish.cover(d, px)
    if focus * live > 0.001 {
        res = Finish.over(res, mb_leak(d, a) * focus * live)
    }
    let rw = 1.3
    let n = mb_normal(p, c, h, 1.5)
    let hg = h - vec2(rw, rw)
    var gem = mb_gstep(p - c, hg, ink, 3.0, 0.0, 1.0)
    gem = gem * (1.0 + 0.06 * hover * live)
    var col = mix(mb_rim(d, rw, n, p), gem, Finish.cover(d + rw, px))
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.5)
    col = mix(col, vec3(0.84, 0.81, 0.75), 0.6 * dis)
    col = mb_focus_rim(col, d, rw, px, focus * live)
    res = Finish.over(res, vec4(col * a, a))
    // The claws: four gold beads at the corners.
    let q = abs(p - c) - (h - vec2(1.1, 1.1))
    let cd = length(q) - 1.15
    let ca = Finish.cover(cd, px)
    let cn = (p - c) / max(length(p - c), 0.001)
    let ccol = mix(mb_gold(mb_env(dot(cn, mb_lv()) * 0.7)), vec3(0.84, 0.81, 0.75), 0.6 * dis)
    res = Finish.over(res, vec4(ccol * ca, ca))
    let gl = mb_glint(p - c - vec2(hw * 0.35, -hv * 0.45), 4.0 + 3.0 * hover, px) * (0.35 + 0.65 * max(hover, drag)) * live
    return Finish.over(res, vec4(gl, gl, gl, gl))
}

// A ROUND STONE THUMB: a round brilliant `rad` round `c` in a gold bezel,
// its shadow under it; for the band's ends and the minimal slider. Its
// stone is traced (`flat` 0) or, for the tiny stones (the progress bar's
// head, the divider's stone, the needle's pivot), the flat sparkle of facets
// (`flat` 1), which costs no tracer.
// The setting round a stone whose colour here is `gem`.
let mb_gemset = fn(dst: vec4, p: vec2, c0: vec2, rad: float, gem0: vec3, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let c = c0 + vec2(0.0, 0.4 * drag * live)
    let sc = mb_shadow(p, c0, vec2(rad, rad), rad, px, hover, drag, dis)
    var res = Finish.over(dst, vec4(mb_shade() * sc, sc))
    let d = length(p - c) - rad
    let a = Finish.cover(d, px)
    if focus * live > 0.001 {
        res = Finish.over(res, mb_leak(d, a) * focus * live)
    }
    let rw = clamp(0.24 * rad, 1.1, 1.8)
    let n = (p - c) / max(length(p - c), 0.001)
    var gem = gem0 * (1.0 + 0.06 * hover * live)
    var col = mix(mb_rim(d, rw, n, p), gem, Finish.cover(d + rw, px))
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.5)
    col = mix(col, vec3(0.84, 0.81, 0.75), 0.6 * dis)
    col = mb_focus_rim(col, d, rw, px, focus * live)
    res = Finish.over(res, vec4(col * a, a))
    let gl = mb_glint(p - c - vec2(rad * 0.25, -rad * 0.3), rad * 1.6 + 2.0 * hover, px) * (0.45 + 0.55 * max(hover, drag)) * live
    return Finish.over(res, vec4(gl, gl, gl, gl))
}
let mb_gemthumb = fn(dst: vec4, p: vec2, c0: vec2, rad: float, ink: vec3, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let c = c0 + vec2(0.0, 0.4 * drag * (1.0 - dis))
    let rw = clamp(0.24 * rad, 1.1, 1.8)
    let gem = mb_gem(p - c, rad - rw, mb_gink(ink), 0.4, 2.0)
    return mb_gemset(dst, p, c0, rad, gem, px, hover, drag, focus, dis)
}
let mb_gemdot = fn(dst: vec4, p: vec2, c0: vec2, rad: float, px: float) -> vec4 {
    let rw = clamp(0.24 * rad, 1.1, 1.8)
    let gem = mb_brilliant(p - c0, rad - rw, mb_diamond(), 0.4, px)
    return mb_gemset(dst, p, c0, rad, gem, px, 0.0, 0.0, 0.0, 0.0)
}

// The bar slider: an 8 point gold rail under its label row, the value a row
// of pavé diamonds in it, and a citrine emerald-cut riding it, 13 x 16
// points in its claws.
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 8.0
    let cy = mb_snap(20.0 + (self.rect_size.y - 20.0) * 0.5, o.y, px)
    let lo = vec2(mb_snap(0.0, o.x, px), cy - 4.0)
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), cy + 4.0)
    let span = self.rect_size.x - rad * 2.0
    let hx = rad + self.slide_pos * span
    let ox = rad + self.origin_pos * span
    let f0 = mix(lo.x + 2.0, min(ox, hx), self.arc_origin)
    let f1 = mix(hx - 5.0, max(ox, hx), self.arc_origin)
    var res = mb_rail(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, px, f0, f1, self.disabled)
    return mb_thumb(res, p, vec2(hx, cy), 6.5, 8.2, mb_citrine_gem(), px, self.hover, self.drag, self.focus, self.disabled) * mb_fade(self.pos, self.rect_size, m)
}

// The minimal slider: a slim gold rail with the value in pavé, and a small
// round diamond riding it.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let cy = mb_snap(self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, o.y, px)
    let lo = vec2(mb_snap(0.0, o.x, px), cy - 2.5)
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), cy + 2.5)
    let lo2 = min(self.origin_pos, self.slide_pos)
    let hi2 = max(self.origin_pos, self.slide_pos)
    let f0 = mix(1.5, lo2 * self.rect_size.x, self.arc_origin)
    let f1 = mix(self.slide_pos * self.rect_size.x - 3.0, hi2 * self.rect_size.x, self.arc_origin)
    var res = mb_rail(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, px, f0, f1, self.disabled)
    let hx = clamp(self.slide_pos * self.rect_size.x, 4.5, self.rect_size.x - 4.5)
    return mb_gemthumb(res, p, vec2(hx, cy), 4.5, mb_diamond(), px, self.hover, self.drag, 0.0, self.disabled)
}

// The range slider: the bar slider's rail under its label row, the band in
// pavé between its ends, and at each end a round emerald in a gold bezel.
mod.widgets.RangeSliderFlat.handle_size = 13.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let top = self.label_px
    let track_h = self.rect_size.y - top
    let mid = mb_snap(top + track_h * 0.5, o.y, px)
    let lo = vec2(mb_snap(self.inset_px * 0.5, o.x, px), mid - 3.5)
    let hi = vec2(mb_snap(self.rect_size.x - self.inset_px * 0.5, o.x, px), mid + 3.5)
    let span_x = self.rect_size.x - self.inset_px * 2.0 - self.handle_px
    let s0 = self.inset_px + self.handle_px * 0.5 + self.start_pos * span_x
    let s1 = self.inset_px + self.handle_px * 0.5 + self.end_pos * span_x
    var res = mb_rail(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, px, s0 + 4.0, s1 - 4.0, self.disabled)
    let rad = clamp(track_h * 0.5 - 0.5, 4.5, 6.5)
    // Each pixel traces only the nearer of the two stones.
    let ns = step(abs(p.x - s0), abs(p.x - s1))
    let hot_t = mix(self.hot_end, self.hot_start, ns)
    return mb_gemthumb(res, p, vec2(mix(s1, s0, ns), mid), rad, mb_emerald(), px, hot_t, self.drag * hot_t, self.focus, self.disabled) * mb_fade(self.pos, self.rect_size, m)
}

// The round slider: a label column, then the bar slider's rail, pavé and
// citrine; the rail ends short of the right edge for the value.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 7.0
    let cy = mb_snap(self.rect_size.y * 0.5, o.y, px)
    let x0 = mb_snap(self.label_size, o.x, px)
    let lo = vec2(x0, cy - 4.0)
    let hi = vec2(mb_snap(self.rect_size.x - 37.0, o.x, px), cy + 4.0)
    let span = hi.x - lo.x - rad * 2.0
    let hx = lo.x + rad + self.slide_pos * span
    var res = mb_rail(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, px, lo.x + 2.0, hx - 5.0, self.disabled)
    return mb_thumb(res, p, vec2(hx, cy), 6.5, 8.2, mb_citrine_gem(), px, self.hover, self.drag, self.focus, self.disabled) * mb_fade(self.pos, self.rect_size, m)
}

// THE FADER: a slim gold rail standing in the fader's middle, its value in
// pavé from the stop to the cap, gold ticks either side (every fifth long),
// and the cap an emerald baguette 22 points across and 14 along, held in a
// polished gold frame with claws. Laid out in the fader's own frame (`ab`:
// along the track from the value's zero, up the screen when it stands;
// across it), so SliderFaderY is the same drawing stood on end. The travel
// law is the widget's, so what is drawn is what is dragged.
mod.widgets.SliderFader.cap_size = 22.0
mod.widgets.SliderFader.track_inset = 4.0
mod.widgets.SliderFader.draw_bg.track_size = uniform(5.0)
mod.widgets.SliderFader.draw_bg.cap_cross = uniform(0.24)
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let sz = self.rect_size
    let p = self.pos * (sz + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let v = self.is_vertical
    let dis = self.disabled
    let live = 1.0 - dis
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    // Work in the fader's frame, then hand screen points to the helpers.
    let ab = vec2(mix(p.x, sz.y - p.y, v), mix(p.y, p.x, v))
    let mid = across * 0.5
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let at = foot + self.slide_pos * travel
    // A frame-space point to a screen point.
    let tin = self.inset_px + 3.0
    let tw = self.track_size
    // The ticks, gold hairlines either side of the rail.
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    let n = 24.0
    let k = floor((ab.x - foot) / travel * n + 0.5)
    let tk = foot + k / n * travel
    let major = 1.0 - step(0.5, k - 5.0 * floor(k / 5.0 + 0.0001))
    let tlen = mix(3.0, 5.0, major)
    let side = abs(ab.y - mid) - (tw * 0.5 + 2.5)
    let inrange = step(-0.01, k) * step(k, n + 0.01)
    let tick = Finish.cover(abs(ab.x - tk) - px * mix(0.5, 0.8, major), px) * Finish.cover(max(-side, side - tlen), px) * inrange
    let tcol = mix(mb_gold(0.45), vec3(0.84, 0.81, 0.75), 0.6 * dis)
    res = Finish.over(res, vec4(tcol * tick * 0.9, tick * 0.9))
    // The rail and its value, laid out across the screen axis.
    var lo = foot + self.fill_lo * travel
    var hi = foot + self.fill_hi * travel
    if self.fill_lo < 0.0005 {
        lo = tin
    }
    if self.fill_hi > 0.9995 {
        hi = along - tin
    }
    let q = vec2(ab.x, ab.y)
    let rail = mb_rail(vec4(0.0, 0.0, 0.0, 0.0), q, vec2(tin, mid - tw * 0.5), vec2(along - tin, mid + tw * 0.5), px, lo + 1.0, hi - 1.0, dis)
    res = Finish.over(res, rail)
    // The cap, in screen orientation so its light falls from the top.
    let cs = mix(vec2(at, mid), vec2(mid, sz.y - at), v)
    let capw = min(across * 0.5 - 1.0, 11.0)
    let thumb = mb_thumb(vec4(0.0, 0.0, 0.0, 0.0), p, cs, mix(7.0, capw, v), mix(capw, 7.0, v), mb_emerald(), px, self.hover, self.drag, self.focus, dis)
    res = Finish.over(res, thumb)
    return res * mb_fade(self.pos, self.rect_size, m)
}

// ---------------------------------------------------------------- knobs

// A KNOB is a cut stone in a gold bezel, the pictures' gem knobs: a round
// brilliant that turns with the value, in a polished gold bezel whose outer
// edge is milgrained (a row of fine beads), the pointer an engraved notch
// across the bezel. Round it a slim gold ring over the whole sweep, and lit
// from the start of the sweep (or from the origin) to the value a row of
// pavé diamonds set in it. The big dial adds a ring of gold ticks outside.
// Under the hand the stone glints and the bezel brightens; held, it glints
// more; focus lays the gold light round the bezel; disabled, all fades
// toward the stone. Angles run from straight down, clockwise, the gap at
// the bottom.

// The distance from `q` (at the angle `aq`) to a band `hw` either side of
// the arc of radius `ra` from the angle `a0` to `a1`, its ends round; in .y
// how far along the arc (0..1) the nearest point lies.
let mb_arc_d = fn(q: vec2, aq: float, ra: float, hw: float, a0: float, a1: float) -> vec2 {
    let r = length(q)
    if aq >= a0 && aq <= a1 {
        return vec2(abs(r - ra) - hw, (aq - a0) / max(a1 - a0, 0.0001))
    }
    let d0 = length(q - vec2(-sin(a0), cos(a0)) * ra)
    let d1 = length(q - vec2(-sin(a1), cos(a1)) * ra)
    if d0 < d1 {
        return vec2(d0 - hw, 0.0)
    }
    return vec2(d1 - hw, 1.0)
}

let mb_knob = fn(p: vec2, c: vec2, rr: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, held: float, focus: float, dis: float, ink: vec3, ticks: float) -> vec4 {
    let q = p - c
    let ql = length(q)
    let live = 1.0 - dis
    let one = PI / 180.0
    let sweep = 2.0 * PI - gap * one
    let start = gap * one * 0.5
    let ve = start + sweep * slide
    let oe = start + sweep * origin
    let a0 = mix(start, min(oe, ve), arc_origin)
    let a1 = mix(ve, max(oe, ve), arc_origin)
    var aq = atan2(-q.x, q.y)
    if aq < 0.0 {
        aq = aq + 2.0 * PI
    }
    // The sizes: the ticks (on the dial) outermost, then the ring and its
    // pavé, then the bezel and the stone.
    let tk = ticks * clamp(0.10 * rr, 3.0, 6.0)
    let prad = clamp(0.045 * rr, 1.05, 2.1)
    let ra = rr - tk - prad - 0.6
    let rb = ra - prad - clamp(0.06 * rr, 1.8, 4.0)
    let bw = clamp(0.16 * rb, 1.8, 5.5)
    let rg = rb - bw
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    // THE TICKS (the dial only): eleven gold strokes outside the ring.
    if ticks > 0.5 {
        let tn = 10.0
        let ti = floor(clamp((aq - start) / sweep, 0.0, 1.0) * tn + 0.5)
        let ta = start + sweep * ti / tn
        let td = vec2(-sin(ta), cos(ta))
        let tdist = mb_seg(q, td * (rr - tk + 0.8), td * (rr - 0.8)) - 0.55
        let tcov = Finish.cover(tdist, px)
        let tcol = mix(mb_gold(0.5), vec3(0.84, 0.81, 0.75), 0.6 * dis)
        res = Finish.over(res, vec4(tcol * tcov, tcov))
    }
    // THE RING: a slim gold wire over the whole sweep, its shadow under it.
    let tr = mb_arc_d(q, aq, ra, prad * 0.55, start, start + sweep)
    let rsh = Finish.cover(tr.x - 0.9, 1.2) * 0.18 * (1.0 - Finish.cover(tr.x, px))
    res = Finish.over(res, vec4(mb_shade() * rsh, rsh))
    let ta2 = Finish.cover(tr.x, px)
    let rn = clamp((ql - ra) / max(prad * 0.55, 0.3), -1.0, 1.0)
    var rcol = mb_gold(mb_env(rn * dot(q / max(ql, 0.01), mb_lv()) * 0.9))
    rcol = mix(rcol, vec3(0.84, 0.81, 0.75), 0.6 * dis)
    res = Finish.over(res, vec4(rcol * ta2, ta2))
    // THE PAVÉ: from the start (or the origin) to the value, a diamond every
    // so many degrees on the ring.
    if dis < 0.5 {
        let pitch = prad * 2.3 / max(ra, 1.0)
        let ci = floor((aq - a0) / pitch)
        let ca = a0 + (ci + 0.5) * pitch
        let inside = step(a0, ca) * step(ca, a1)
        let pc = vec2(-sin(ca), cos(ca)) * ra
        res = Finish.over(res, mb_pave(q - pc, prad, Finish.hash(vec2(ci, 9.1)), px) * inside)
    }
    // THE BEZEL'S SHADOW on the stone ground.
    let sc = Finish.drop(p, c, vec2(rb, rb), rb, vec2(0.0, 0.10 * rb + 0.6), 0.10 * rb + 0.6) * 0.32 * (1.0 - 0.6 * dis)
    let db = ql - rb
    let ab_ = Finish.cover(db, px)
    res = Finish.over(res, vec4(mb_shade() * sc * (1.0 - ab_), sc * (1.0 - ab_)))
    if focus * live > 0.001 {
        res = Finish.over(res, mb_leak(db, ab_) * focus * live)
    }
    // THE BEZEL: a polished bead, milgrained along its outer third.
    let n = q / max(ql, 0.01)
    let u = clamp(-db / bw, 0.0, 1.0)
    var l = mb_bead(u, n)
    let nb = max(floor(2.0 * PI * rb / 1.5), 8.0)
    let mg = cos(aq * nb) * (1.0 - smoothstep(0.18, 0.36, u))
    l = l + 0.16 * mg * smoothstep(0.0, 0.08, u)
    var bcol = mb_gold(l) * (1.0 + 0.05 * hover * live)
    bcol = mix(bcol, vec3(0.30, 0.21, 0.07), Finish.band(db, 0.0, px, px) * 0.35)
    // The pointer: an engraved notch across the bezel at the value.
    let dirv = vec2(-sin(ve), cos(ve))
    let nw = max(0.15 * bw, 0.75)
    let nd = mb_seg(q, dirv * (rg - 0.2), dirv * (rb - 0.3)) - nw
    let notch = Finish.cover(nd, px)
    let lip = Finish.cover(mb_seg(q - vec2(0.0, 0.6), dirv * (rg - 0.2), dirv * (rb - 0.3)) - nw, px) * (1.0 - notch)
    bcol = mix(bcol, vec3(1.0, 0.95, 0.78), lip * 0.6)
    bcol = mix(bcol, vec3(0.20, 0.13, 0.03), notch * 0.9)
    // THE STONE, turning with the value; a dark seat where it meets gold.
    let dg = ql - rg
    var gcol = mb_gem_aa(q, rg, mb_gink(ink), ve, px, 4.0, 2.0) * (1.0 + 0.04 * hover * live)
    gcol = mix(gcol, vec3(0.25, 0.18, 0.06), Finish.band(dg, -px, 0.0, px) * 0.6)
    var col = mix(bcol, gcol, Finish.cover(dg, px))
    col = mix(col, mix(mb_ground(), vec3(0.80, 0.78, 0.72), 0.5), 0.55 * dis)
    col = mb_focus_rim(col, db, bw, px, focus * live)
    res = Finish.over(res, vec4(col * ab_, ab_))
    // The glints, the larger one brighter under the hand.
    let g1 = mb_glint(q - vec2(rg * 0.32, -rg * 0.38), rg * 0.95 + 2.0 * hover, px) * (0.55 + 0.45 * max(hover, held))
    let g2 = mb_glint(q - vec2(-rg * 0.45, rg * 0.30), rg * 0.45, px) * 0.45
    var gsum = g1 + g2
    // A white diamond glints at its facet corners instead.
    if max(ink.x, max(ink.y, ink.z)) - min(ink.x, min(ink.y, ink.z)) < 0.15 {
        gsum = mb_dia_glints(q, rg, ve, px) * (0.75 + 0.25 * max(hover, held))
    }
    let gl = clamp(gsum, 0.0, 1.0) * live * Finish.cover(dg + 0.5, px)
    return Finish.over(res, vec4(gl, gl, gl, gl))
}

// The panel knob is 36 points across with no side margin: in a row beside
// a big dial it then keeps inside its own column, its ring a few points
// clear of the next column's frame.
mod.widgets.RotaryKnob.width = 36.0
mod.widgets.RotaryKnob.height = 56.0
mod.widgets.RotaryKnob.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 4.0 bottom: 4.0}
mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The panel knob is an emerald.
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    return mb_knob(p, c, dia * 0.5 - 0.5, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled, mb_emerald(), 0.0) * mb_fade(self.pos, self.rect_size, m)
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The dial is a white diamond with its ring of ticks.
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + 20.0 + dia * 0.5, px) - self.rect_pos.y)
    return mb_knob(p, c, dia * 0.5 - 0.5, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled, mb_diamond(), 1.0) * mb_fade(self.pos, self.rect_size, m)
}
// The dial's readout stands as a plain line under it.
mod.widgets.Rotary.text_input.min_height = 0.0
mod.widgets.Rotary.text_input.padding.top = 0.0
mod.widgets.Rotary.text_input.padding.bottom = 0.0
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_bold{font_size: 8.5}

// ---------------------------------------------------------------- fields

// A FIELD is white marble set in a double gold rim (a broad bead, a dark
// groove, a slim bead), sunk a little under it: a soft shade under its upper
// rim, a line of milgrain beads inside it, the veins calm under the words.
// Focused, the rim burns brighter and spills its gold light. `lift` how
// much shadow it throws.
let mb_field = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, seed: vec2, hover: float, focus: float, dis: float, lift: float) -> vec4 {
    let hh = hi.y - lo.y
    let full = step(20.0, hh)
    let rw = clamp(0.177 * hh, 1.8, 4.6)
    var face = mb_stone(p + seed, px, 0.42) * (1.0 + 0.02 * hover)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let ins = Finish.inset(p, c, h - vec2(rw, rw), max(r - rw, 0.5), vec2(0.0, 1.5), 1.8)
    face = mix(face, face * 0.88, clamp(ins, 0.0, 1.0) * 0.6)
    face = mix(face, mb_milgrain(face, p, c, h, r, rw + 1.0, 0.6, 1.9, px), full)
    face = mix(face, mb_ground(), 0.45 * dis)
    return mb_box2(p, lo, hi, min(r, 0.3 * hh), rw, px, face, hover * 0.3, 0.0, dis, focus, lift, full)
}

mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let m = 8.0
    let px = mb_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(self.rect_size.x, o.x, px), mb_snap(self.rect_size.y, o.y, px))
    return mb_field(p, lo, hi, 5.0, px, mb_seed(self.rect_size), self.hover, self.focus, self.disabled, 0.7) * mb_fade(self.pos, self.rect_size, m)
}
