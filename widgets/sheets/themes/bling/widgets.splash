}

// Open lists: a card of white marble in a gold rim; a row under the hand
// takes a pale gold wash; the chosen row is a strip of pavé in a gold rim.
let mb_menu = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let c = size * 0.5
    let d = Material.sd_box(p, c, c, 4.0)
    let n = mb_normal(p, c, c, 4.0)
    let rw = 3.0
    var col = mb_stone(p + mb_seed(size), px, 0.35)
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.5)
    col = mix(col, mb_rim(d, rw, n, p), Finish.band(d, 0.0, rw, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}
// The pavé strip of a chosen row: a hexagonal field of tiny diamonds in a
// gold rim.
let mb_pave_strip = fn(p: vec2, lo: vec2, hi: vec2, px: float, amt: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(3.0, min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let n = mb_normal(p, c, h, r)
    let a = Finish.cover(d, px) * amt
    let rw = 1.3
    let pitch = 2.5
    let row = floor((p.y - lo.y) / (pitch * 0.866))
    let shift = fract(row * 0.5) * pitch
    let cell = floor((p.x - lo.x - shift) / pitch)
    let cc = vec2(lo.x + shift + (cell + 0.5) * pitch, lo.y + (row + 0.5) * pitch * 0.866)
    var col = mb_gold(0.58)
    let dot = mb_pave(p - cc, 1.12, Finish.hash(vec2(cell, row + 1.7)), px)
    col = col * (1.0 - dot.a) + dot.rgb
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.6)
    col = mix(col, mb_rim(d, rw, n, p), Finish.band(d, 0.0, rw, px))
    let sh = Finish.drop(p, c, h, r, vec2(0.0, 0.7), 0.7) * 0.22 * amt * (1.0 - a)
    return Finish.over(vec4(mb_shade() * sh, sh), vec4(col * a, a))
}
let mb_row = fn(p: vec2, size: vec2, px: float, hover: float, active: float, dis: float) -> vec4 {
    let wash = 0.10 * hover * (1.0 - dis)
    var res = vec4(vec3(0.78, 0.63, 0.30) * wash, wash)
    if active > 0.001 {
        res = Finish.over(res, mb_pave_strip(p, vec2(3.0, 1.5), size - vec2(3.0, 2.0), px, active))
    }
    return res
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    return mb_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = mb_px(self.draw_pass.dpi_factor)
    return mb_row(self.pos * self.rect_size, self.rect_size, px, self.hover, self.active, self.disabled)
}
mod.widgets.PopupMenuItem.draw_text.color = #3a2e1c
mod.widgets.PopupMenuItem.draw_text.color_hover = #2a2112
mod.widgets.PopupMenuItem.draw_text.color_active = #2a2112
