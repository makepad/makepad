use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// Bling: white Carrara marble set in polished gold, after the "marble / bling
// light" pictures. Every face is drawn in true points (one device pixel is
// `px`), and every shadow and light falls OUTSIDE the layout box: the quad
// is grown in `vertex`, the templates that throw a shadow stop clipping, and
// no padding is spent on either. Three materials make every control:
// MARBLE, a white stone with soft grey veins that meander, part and rejoin
// at several scales (broad soft clouds, veins of varied width, a few fine
// dark threads), calm under the content and stronger toward the window's
// frame; GOLD, polished, a round bead that catches a bright specular line on
// the side toward the light (from the top, a little from the left) and a
// warm darker band on the side away from it; and GEMS, cut stones with flat
// facets, a deep coloured interior and a few crisp star glints, set in gold.
// Lamps are LEDs as gems in gold settings. Small gold scrolls stand only in
// the corners of the surfaces and of the window, never over words.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let mb_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let mb_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let mb_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// Which way the outline of a rounded box faces at p.
let mb_normal = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// Anything drawn in a grown quad fades out over its last points, so a soft
// shadow never ends on a hard edge where the quad stops.
let mb_fade = fn(pos: vec2, size: vec2, m: float) -> float {
    let q = pos * (size + vec2(2.0 * m, 2.0 * m))
    let e = min(min(q.x, q.y), min(size.x + 2.0 * m - q.x, size.y + 2.0 * m - q.y))
    return smoothstep(0.0, 3.0, e)
}

// A seed from a box's size, so two faces of different sizes show different
// stone (never the position: a face that scrolls must not change).
let mb_seed = fn(size: vec2) -> vec2 {
    return vec2(fract(size.x * 0.1373) * 997.0 + size.y * 3.7, fract(size.y * 0.2113) * 613.0 + size.x * 1.3)
}

// ---------------------------------------------------------------- palette

// The stone's mean white (#efeee9), for a face that fades to it.
let mb_ground = fn() -> vec3 {
    return vec3(0.937, 0.933, 0.914)
}
// The warm grey-brown every shadow is cast in; laid at a coverage.
let mb_shade = fn() -> vec3 {
    return vec3(0.25, 0.20, 0.13)
}
// The ink, dark grey-brown (#3a2e1c).
let mb_ink = fn() -> vec3 {
    return vec3(0.227, 0.180, 0.110)
}
// The key light in the screen plane, toward the light: from the top, a
// little from the left.
let mb_lv = fn() -> vec2 {
    return vec2(-0.419, -0.908)
}
// The stones, measured on the pictures: emerald (#079846 lit, #0b5028 in
// the deep), ruby, a golden citrine, sapphire, amethyst, a white diamond,
// and the two smoky quartzes of the second and third buttons.
let mb_emerald = fn() -> vec3 {
    return vec3(0.03, 0.56, 0.27)
}
let mb_ruby = fn() -> vec3 {
    return vec3(0.76, 0.06, 0.16)
}
let mb_citrine = fn() -> vec3 {
    return vec3(0.88, 0.55, 0.12)
}
// The citrine as a cut stone shows it: its body a golden yellow (what the
// gem renderer absorbs to).
let mb_citrine_gem = fn() -> vec3 {
    return vec3(0.98, 0.78, 0.16)
}
let mb_sapphire = fn() -> vec3 {
    return vec3(0.14, 0.32, 0.86)
}
let mb_amethyst = fn() -> vec3 {
    return vec3(0.56, 0.26, 0.82)
}
let mb_diamond = fn() -> vec3 {
    return vec3(0.86, 0.875, 0.905)
}
let mb_champagne = fn() -> vec3 {
    return vec3(0.66, 0.53, 0.37)
}
let mb_smoky = fn() -> vec3 {
    return vec3(0.40, 0.36, 0.30)
}

// ---------------------------------------------------------------- gold

// Polished gold by the light it catches, 0..1, measured on the pictures'
// bars: the deep brown-gold of a face turned away (#2e2008), the warm darker
// band (#5a4214), the shade (#8a6a2c), the body (#b8964e), the bright
// (#e2c886) and the specular white-gold (#fff4cc).
let mb_gold = fn(l: float) -> vec3 {
    let x = clamp(l, 0.0, 1.0)
    var c = mix(vec3(0.180, 0.125, 0.031), vec3(0.353, 0.259, 0.078), smoothstep(0.0, 0.2, x))
    c = mix(c, vec3(0.541, 0.416, 0.173), smoothstep(0.2, 0.4, x))
    c = mix(c, vec3(0.722, 0.588, 0.306), smoothstep(0.4, 0.6, x))
    c = mix(c, vec3(0.886, 0.784, 0.525), smoothstep(0.6, 0.8, x))
    return mix(c, vec3(1.0, 0.957, 0.800), smoothstep(0.8, 1.0, x))
}

// What polished metal reflects, by how far a face is turned toward the key
// light (`e` -1..1, 0 facing the eye): the body flat on, a warm darker band
// just past flat on the side away, a narrow bright specular strip on the
// side toward it.
let mb_env = fn(e: float) -> float {
    let x = clamp(e, -1.0, 1.0)
    var l = 0.5 + 0.30 * x
    l = l - 0.24 * exp(-(x + 0.42) * (x + 0.42) / 0.035)
    l = l + 0.48 * exp(-(x - 0.55) * (x - 0.55) / 0.018)
    return clamp(l, 0.0, 1.0)
}

// A round bead of gold: `u` 0 at its outer edge to 1 at its inner, `n` the
// way its outline faces. Its outer half faces out and its inner half in:
// the side toward the light carries the bright specular line, the side
// away the warm dark band; its crest always holds a polished streak, and
// both its edges roll away dark, so a wide rim reads chunky.
let mb_bead = fn(u: float, n: vec2) -> float {
    let t = cos(clamp(u, 0.0, 1.0) * PI)
    var l = mb_env(t * dot(n, mb_lv()) * 0.95)
    l = l + 0.12 * exp(-t * t / 0.05)
    return l - 0.20 * smoothstep(0.80, 1.0, abs(t))
}

// A gold rim `w` points wide inside the outline at distance `d` (negative
// inside), its light varied a little along its run so a long rim is never
// one flat colour.
let mb_rim = fn(d: float, w: float, n: vec2, p: vec2) -> vec3 {
    let u = clamp(-d / max(w, 0.01), 0.0, 1.0)
    let l = mb_bead(u, n) + 0.06 * (Finish.noise(p / 6.0) - 0.5)
    return mb_gold(l)
}

// A DOUBLE RIM `w` points wide: a broad outer bead (0.6 of it), a dark
// groove, and a slimmer inner bead, as the pictures' field frames.
let mb_rim2 = fn(d: float, w: float, n: vec2, p: vec2, px: float) -> vec3 {
    let wo = w * 0.60
    let wg = max(w * 0.12, px)
    let wi = max(w - wo - wg, 0.3)
    let jit = 0.06 * (Finish.noise(p / 6.0) - 0.5)
    let co = mb_gold(mb_bead(clamp(-d / wo, 0.0, 1.0), n) + jit)
    let ci = mb_gold(mb_bead(clamp((-d - wo - wg) / wi, 0.0, 1.0), n) + jit)
    var col = mix(co, mb_gold(0.06), Finish.cover(d + wo, px))
    return mix(col, ci, Finish.cover(d + wo + wg, px))
}

// A gold face: a polished bar, flat in the middle with a soft reflection of
// a bright window across its upper third, its border `bw` rolling over to
// the outline (`d` its distance, `n` the way it faces).
let mb_goldface = fn(p: vec2, c: vec2, h: vec2, d: float, n: vec2, bw: float) -> vec3 {
    let y = (p.y - c.y) / max(h.y, 1.0)
    let edge = 1.0 - smoothstep(0.0, bw, -d)
    var e = -0.16 * y
    e = mix(e, dot(n, mb_lv()) * 0.85, edge)
    var l = mb_env(e)
    l = l + 0.11 * exp(-(y + 0.42) * (y + 0.42) / 0.04) * (1.0 - edge)
    l = l + 0.04 * (Finish.noise(p / vec2(14.0, 3.0)) - 0.5)
    return mb_gold(l)
}

// One gold wire of an ornament: its coverage and light from the signed
// distance `e` across its middle, `hw` half its width, `n` the way +e faces
// and `lv` the light in the wire's own frame.
let mb_wire = fn(e: float, hw: float, n: vec2, lv: vec2, px: float) -> vec2 {
    let a = Finish.cover(abs(e) - hw, px)
    let t = clamp(e / max(hw, 0.01), -1.0, 1.0)
    return vec2(a, mb_env(t * dot(n, lv) * 0.95))
}
let mb_wire_max = fn(a: vec2, b: vec2) -> vec2 {
    if b.x > a.x {
        return b
    }
    return a
}
// A spiral wire about `c`, `pitch` apart, from radius `r0` to `r1`.
let mb_curl = fn(m: vec2, c: vec2, pitch: float, r0: float, r1: float, hw: float, lv: vec2, px: float) -> vec2 {
    let q = m - c
    let r = length(q)
    let ang = atan2(q.y, q.x)
    let e = (fract(r / pitch - ang / (2.0 * PI) + 0.5) - 0.5) * pitch
    let w = smoothstep(r0 - 0.3, r0 + 0.5, r) * (1.0 - smoothstep(r1 - 0.6, r1 + 0.2, r))
    let g = mb_wire(e, hw, q / max(r, 0.01), lv, px)
    return vec2(g.x * w, g.y)
}
// A vine wire along an edge: a wave `amp` either side of `y0`, a wavelength
// `wl` long, from `x0` to `x1`, thinning and calming as it runs.
let mb_vine = fn(m: vec2, x0: float, x1: float, y0: float, amp: float, wl: float, hw: float, lv: vec2, px: float) -> vec2 {
    let k = 2.0 * PI / wl
    let run = clamp((m.x - x0) / max(x1 - x0, 1.0), 0.0, 1.0)
    let fade = smoothstep(x0, x0 + 1.0, m.x) * (1.0 - smoothstep(x1 - 2.0, x1, m.x))
    let A = amp * (1.0 - 0.5 * run)
    let yc = y0 + A * sin((m.x - x0) * k)
    let dy = A * k * cos((m.x - x0) * k)
    let nl = sqrt(1.0 + dy * dy)
    let g = mb_wire((m.y - yc) / nl, hw * mix(1.0, 0.65, run), vec2(-dy, 1.0) / nl, lv, px)
    return vec2(g.x * fade, g.y)
}
// The scroll of one corner at scale `s`, in corner space (`m` points along
// the edges from the corner; folded about the diagonal, so both edges carry
// the same vine): a volute round the corner's eye (where a small stone is
// set), a vine along each edge with a curl hanging from each crest and a
// bud closing it, a short arc across the corner. `lv` the light in corner
// space. All of it within nine points of the edges and the corner.
let mb_corner = fn(m0: vec2, s: float, lv0: vec2, px: float) -> vec2 {
    var m = m0
    var lv = lv0
    if m.y > m.x {
        m = vec2(m0.y, m0.x)
        lv = vec2(lv0.y, lv0.x)
    }
    var g = mb_curl(m, vec2(7.0, 7.0) * s, 1.45 * s, 2.0 * s, 4.4 * s, 0.48 * s, lv, px)
    g = mb_wire_max(g, mb_vine(m, 11.0 * s, 40.0 * s, 5.9 * s, 1.3 * s, 9.0 * s, 0.50 * s, lv, px))
    g = mb_wire_max(g, mb_curl(m, vec2(15.6 * s, 8.3 * s), 0.85 * s, 0.25 * s, 1.95 * s, 0.36 * s, lv, px))
    g = mb_wire_max(g, mb_curl(m, vec2(24.6 * s, 4.3 * s), 0.75 * s, 0.25 * s, 1.5 * s, 0.32 * s, lv, px))
    g = mb_wire_max(g, mb_curl(m, vec2(33.6 * s, 7.4 * s), 0.65 * s, 0.2 * s, 1.3 * s, 0.30 * s, lv, px))
    // A bud at the vine's end.
    let bd = length(m - vec2(41.0 * s, 5.9 * s)) - 0.95 * s
    let bn = (m - vec2(41.0 * s, 5.9 * s)) / max(length(m - vec2(41.0 * s, 5.9 * s)), 0.01)
    g = mb_wire_max(g, vec2(Finish.cover(bd, px), mb_env(dot(bn, lv) * 0.8)))
    return g
}

// ---------------------------------------------------------------- marble

// THE VEINS' FIELD: value noise laid along the veins' general drift `dv`
// (a unit direction; the drift runs from the upper right down to the lower
// left), `sa` points along and `sb` across, the coordinates first warped by
// two more fields (`warp` how far), so its level lines wander, branch and
// rejoin like the veins of a stone rather than running as parallel strokes.
// Its value in .x and its gradient's size per point in .y, measured a point
// either way: a vein's distance in points is its value over that.
let mb_vf = fn(q: vec2, dv: vec2, sa: float, sb: float, warp: float, seed: vec2) -> float {
    var s = vec2(dot(q, dv) / sa, dot(q, vec2(-dv.y, dv.x)) / sb) + seed
    if warp > 0.001 {
        let w = vec2(Finish.fbm(s * 0.55 + vec2(4.3, 1.7)), Finish.fbm(s * 0.55 + vec2(9.1, 6.2))) - vec2(0.5, 0.5)
        s = s + w * warp
    }
    return Finish.fbm(s)
}
let mb_vfg = fn(q: vec2, dv: vec2, sa: float, sb: float, warp: float, seed: vec2) -> vec2 {
    let f = mb_vf(q, dv, sa, sb, warp, seed)
    let fx = mb_vf(q + vec2(1.0, 0.0), dv, sa, sb, warp, seed)
    let fy = mb_vf(q + vec2(0.0, 1.0), dv, sa, sb, warp, seed)
    return vec2(f, max(length(vec2(fx - f, fy - f)), 0.00015))
}

// THE GROUND'S MARBLE at `q` (points in window space), white Carrara:
// - a polished white with broad pale grey clouds drifting along the run;
// - the main veins, a level line of the warped field: where the field is
//   flat they spread into a soft diffuse band, everywhere a darker inner
//   band round a soft core of varied width broken into dabs, fading in and
//   out along their run, grey with stretches warmed to an old gold;
// - forks, where the next level runs close by and parts from it;
// - a finer network that branches off them, and a few fine threads close
//   by them.
// `k` the veins' strength: calm under the content, full at the frame.
let mb_marble = fn(q: vec2, px: float, k: float) -> vec3 {
    let white = vec3(0.966, 0.963, 0.952)
    let dv = vec2(-0.62, 0.785)
    let cl = mb_vf(q, dv, 600.0, 260.0, 1.6, vec2(1.3, 8.2))
    var col = mix(white, vec3(0.872, 0.868, 0.855), smoothstep(0.48, 0.82, cl) * (0.5 + 0.5 * k) * 0.6)
    let cl2 = mb_vf(q, dv, 180.0, 90.0, 1.2, vec2(6.1, 2.4))
    col = mix(col, vec3(0.900, 0.896, 0.884), smoothstep(0.55, 0.85, cl2) * 0.4 * k)
    // The main veins.
    let n1 = mb_vfg(q, dv, 430.0, 190.0, 2.2, vec2(0.0, 0.0))
    let v = abs(n1.x - 0.5)
    let d1 = v / n1.y
    let pres = smoothstep(0.25, 0.7, mb_vf(q, dv, 160.0, 90.0, 0.8, vec2(21.0, 4.0)))
    let tone = smoothstep(0.45, 0.75, Finish.noise(q / 380.0 + vec2(31.0, 7.0)))
    let dab = 0.6 + 0.4 * Finish.noise(q / 7.0 + vec2(3.0, 1.0))
    let vc = mix(vec3(0.52, 0.51, 0.48), vec3(0.66, 0.55, 0.32), tone)
    col = mix(col, vec3(0.80, 0.795, 0.77), clamp(exp(-v / 0.020) * (0.25 + 0.75 * pres) * 0.6 * k, 0.0, 1.0))
    col = mix(col, vec3(0.70, 0.685, 0.65), clamp(exp(-d1 / 3.5) * pres * 0.5 * k, 0.0, 1.0))
    let wn = Finish.noise(q / 70.0 + vec2(1.7, 3.3))
    let hw = 0.4 + 2.2 * smoothstep(0.3, 1.0, wn) * pres
    let core = (1.0 - smoothstep(hw - 0.5, hw + 1.2, d1)) * pres * dab
    col = mix(col, vc, clamp(core * 0.85 * k, 0.0, 1.0))
    // A fork: the next level, close by, where the vein frays.
    let dc = abs(n1.x - 0.53) / n1.y
    let fray = smoothstep(0.5, 0.8, Finish.noise(q / 140.0 + vec2(8.0, 1.0))) * pres
    col = mix(col, vec3(0.66, 0.65, 0.62), clamp((1.0 - smoothstep(0.0, 1.1, dc)) * fray * 0.55 * k, 0.0, 1.0))
    // The branches: a finer network shown off the main veins and in a few
    // patches of its own.
    let n2 = mb_vfg(q, vec2(-0.3, 0.95), 210.0, 130.0, 1.4, vec2(7.3, 2.9))
    let d2 = abs(n2.x - 0.5) / n2.y
    let near = exp(-d1 / 40.0) * (0.3 + 0.7 * pres)
    var m2 = clamp(near + smoothstep(0.66, 0.9, Finish.noise(q / 300.0 + vec2(11.0, 5.0))) * 0.5, 0.0, 1.0)
    m2 = m2 * smoothstep(0.2, 0.6, mb_vf(q, dv, 90.0, 60.0, 0.6, vec2(2.0, 9.0)))
    // Where a field is nearly flat its level lines close into small rings,
    // which no marble has: a branch or a thread fades out there.
    m2 = m2 * smoothstep(0.35 / 130.0, 0.9 / 130.0, n2.y)
    col = mix(col, vec3(0.80, 0.795, 0.77), clamp(exp(-abs(n2.x - 0.5) / 0.015) * m2 * 0.35 * k, 0.0, 1.0))
    col = mix(col, vec3(0.60, 0.59, 0.56), clamp((1.0 - smoothstep(-0.2, 1.0, d2 - 0.25)) * m2 * 0.55 * k * dab, 0.0, 1.0))
    // The fine threads, close by the veins.
    let n3 = mb_vfg(q, dv, 90.0, 60.0, 0.9, vec2(3.1, 17.7))
    let d3 = abs(n3.x - 0.5) / n3.y
    let m3 = clamp(exp(-d1 / 14.0) * 0.8 * pres, 0.0, 1.0) * smoothstep(0.3, 0.6, Finish.noise(q / 40.0 + vec2(5.0, 2.0))) * smoothstep(0.4 / 60.0, 1.0 / 60.0, n3.y)
    col = mix(col, vec3(0.50, 0.49, 0.46), Finish.cover(d3 - 0.2, px) * m3 * 0.5 * k)
    // The polish: a crystalline grain, a device pixel fine.
    let g = Finish.grain(q / px, 0.006)
    return col + vec3(g, g, g)
}

// THE STONE OF A FACE: the same marble, lighter work for a small face: a
// soft cloud, and now and then a soft vein with its diffuse band, fading
// in and out; `k` its strength, kept low under the words a face carries.
let mb_stone = fn(q: vec2, px: float, k: float) -> vec3 {
    let white = vec3(0.968, 0.965, 0.955)
    let dv = vec2(-0.62, 0.785)
    let cl = mb_vf(q, dv, 260.0, 120.0, 1.2, vec2(2.3, 7.1))
    var col = mix(white, vec3(0.895, 0.890, 0.875), smoothstep(0.5, 0.85, cl) * 0.6 * k)
    let n = mb_vfg(q, dv, 300.0, 140.0, 1.6, vec2(4.1, 9.3))
    let v = abs(n.x - 0.5)
    let d = v / n.y
    let pres = smoothstep(0.3, 0.7, Finish.noise(q / 90.0 + vec2(13.0, 2.0)))
    col = mix(col, vec3(0.83, 0.825, 0.80), clamp(exp(-v / 0.02) * 0.5 * k, 0.0, 1.0))
    let hw = 0.3 + 1.0 * Finish.noise(q / 40.0 + vec2(5.1, 1.2))
    col = mix(col, vec3(0.62, 0.605, 0.57), (1.0 - smoothstep(hw - 0.4, hw + 1.0, d)) * pres * 0.6 * k)
    let g = Finish.grain(q / px, 0.005)
    return col + vec3(g, g, g)
}

// ---------------------------------------------------------------- gems

// A stone's colour by the light a facet sends back, 0..1: its deep
// interior (the colour squared, darker), its body, a paler fire and white.
let mb_gemcol = fn(ink: vec3, v: float) -> vec3 {
    let deep = ink * ink * 0.55
    let bright = mix(ink, vec3(1.0, 1.0, 1.0), 0.5)
    var c = mix(deep, ink, smoothstep(0.0, 0.5, v))
    c = mix(c, bright, smoothstep(0.5, 0.86, v))
    return mix(c, vec3(1.0, 1.0, 1.0), smoothstep(0.88, 1.0, v))
}

// A star glint: a hot white core and two crossed rays `s` points long, a
// device pixel thin, and a fainter diagonal pair.
let mb_glint = fn(q: vec2, s: float, px: float) -> float {
    let ax = abs(q.x)
    let ay = abs(q.y)
    let w = max(0.045 * s, 0.35 * px)
    let ray = exp(-ay / w) * max(1.0 - ax / s, 0.0) + exp(-ax / w) * max(1.0 - ay / s, 0.0)
    let dg = vec2(abs(q.x + q.y), abs(q.x - q.y)) * 0.7071
    let diag = exp(-dg.x / w) * max(1.0 - dg.y / (0.45 * s), 0.0) + exp(-dg.y / w) * max(1.0 - dg.x / (0.45 * s), 0.0)
    let core = exp(-(ax * ax + ay * ay) / max(0.025 * s * s, px * px))
    return clamp(ray * ray * 0.95 + diag * diag * 0.45 + core, 0.0, 1.0)
}

// A WHITE DIAMOND, a round brilliant seen from above, radius `R`, turned by
// `spin`. Its facets are flat planes with straight edges, each ONE tone out
// of four (near black, a grey-blue, a light grey, near white), set so that
// neighbours jump between them, nudged by the key light and a little
// chance: the regular octagonal table (about half the stone across), eight
// star facets standing on its edges, eight kites from the table's corners
// to the girdle, and sixteen upper girdle facets in pairs along the rim.
// The table is one flat facet too, a clear glass a breath under white. A
// few white facets flash a pale spectral colour (orange, blue or green);
// every facet edge is a crisp hairline (light on a dark facet, grey-blue on
// a light one) and the girdle a bright line. Laid out in one sector (an
// eighth, its middle on a table edge's middle) folded about that middle,
// so every edge is a straight line. A small stone keeps the table and eight
// crown facets.
let mb_dia_tone = fn(L: float) -> vec3 {
    var c = vec3(0.13, 0.14, 0.18)
    c = mix(c, vec3(0.44, 0.48, 0.57), step(0.25, L))
    c = mix(c, vec3(0.79, 0.81, 0.86), step(0.5, L))
    return mix(c, vec3(0.985, 0.99, 1.0), step(0.75, L))
}
// How much a facet facing the screen direction `d` turns to the key light.
let mb_facing = fn(d: float) -> float {
    return cos(d) * mb_lv().x + sin(d) * mb_lv().y
}
let mb_brilliant_white = fn(q: vec2, R: float, spin: float, px: float) -> vec3 {
    let st = PI / 4.0
    let t2 = 0.41421356
    let r = length(q) / max(R, 0.3)
    let a = atan2(q.y, q.x) - spin + 8.0 * PI
    let k = floor(a / st)
    let am = (a - k * st) - st * 0.5
    let side = step(0.0, am)
    let par = k - 2.0 * floor(k * 0.5)
    let th = k * st + st * 0.5 + spin
    let x = r * cos(am)
    let y = abs(r * sin(am))
    // The table's edge (x = tc, its corner at vy), the star's apex at sx,
    // the kite's foot on the girdle at (gx, gy).
    let tc = 0.48965
    let vy = 0.20282
    let sx = 0.80
    let gx = 0.92388
    let gy = 0.38268
    let ystar = vy * (sx - x) / (sx - tc)
    let csg = (gx - sx) * y - gy * (x - sx)
    let kb = k + side - 8.0 * floor((k + side) / 8.0)
    let small = step(R, 6.0)
    var L = 0.5
    var fid = 0.0
    var e = abs(x - tc) * R
    if x < tc {
        // The table: one flat facet, clear and bright.
        L = 2.0
        fid = 100.0
    } else {
        if small > 0.5 {
            // A small stone: eight crown facets, alternately lit and dark.
            L = mix(0.86, 0.30, par) + 0.15 * mb_facing(th)
            fid = 20.0 + k
            e = min(e, (st * 0.5 - abs(am)) * r * R)
        } else {
            if y < ystar {
                // A star facet.
                L = mix(0.86, 0.42, par) + 0.15 * mb_facing(th) + 0.12 * (Finish.hash(vec2(20.0 + k, 7.7)) - 0.5)
                fid = 20.0 + k
            } else {
                if csg > 0.0 {
                    // A kite, its tone stepping round the stone.
                    let k4 = kb - 4.0 * floor(kb * 0.25)
                    var kbase = 0.16
                    kbase = mix(kbase, 0.66, step(0.5, k4))
                    kbase = mix(kbase, 0.40, step(1.5, k4))
                    kbase = mix(kbase, 0.88, step(2.5, k4))
                    L = kbase + 0.16 * mb_facing(kb * st + spin) + 0.12 * (Finish.hash(vec2(40.0 + kb, 3.3)) - 0.5)
                    fid = 40.0 + kb
                } else {
                    // An upper girdle facet.
                    L = mix(0.30 + 0.2 * par, 0.80 - 0.25 * par, side) + 0.15 * mb_facing(th + (side * 2.0 - 1.0) * st * 0.25) + 0.2 * (Finish.hash(vec2(60.0 + 2.0 * k + side, 9.1)) - 0.5)
                    fid = 60.0 + 2.0 * k + side
                    e = min(e, y * R)
                }
            }
            let nst = sqrt(vy * vy + (sx - tc) * (sx - tc))
            e = min(e, abs((y - ystar) * (sx - tc)) / nst * R + 9.0 * step(sx + 0.02, x))
            let nsg = sqrt((gx - sx) * (gx - sx) + gy * gy)
            e = min(e, abs(csg) / nsg * R + 9.0 * step(y, ystar))
        }
    }
    L = L + 0.03 * (r - 0.6)
    var col = mb_dia_tone(L)
    // The table's own tone: a clear glass a breath under white.
    col = mix(col, vec3(0.915, 0.928, 0.962), step(1.5, L))
    // Fire: a few lit facets flash orange, blue or green.
    let hf = Finish.hash(vec2(fid, 13.3))
    let hue = floor(Finish.hash(vec2(fid, 5.1)) * 3.0)
    var fcol = vec3(1.0, 0.72, 0.42)
    fcol = mix(fcol, vec3(0.55, 0.75, 1.0), step(0.5, hue))
    fcol = mix(fcol, vec3(0.62, 0.95, 0.66), step(1.5, hue))
    col = mix(col, col * (0.62 + 0.38 * fcol), step(0.93, hf) * step(0.75, L) * step(L, 1.5) * (1.0 - step(R, 6.0)))
    // The facet edges: crisp hairlines, light along a dark facet and a
    // grey-blue along a light one; the girdle a bright line.
    let line = 1.0 - smoothstep(0.0, px * 0.9, e)
    let lum = dot(col, vec3(0.3, 0.5, 0.2))
    let ecol = mix(min(col + vec3(0.32, 0.32, 0.32), vec3(1.0, 1.0, 1.0)), vec3(0.56, 0.60, 0.69), step(0.7, lum))
    col = mix(col, ecol, line * 0.6)
    col = mix(col, vec3(1.0, 1.0, 1.0), smoothstep(0.955, 0.99, r) * 0.75)
    return col
}
// The star glints of a white diamond, at facet corners that turn with it:
// a table corner, a star's apex and a kite's foot; one on a small stone.
let mb_dia_glints = fn(q: vec2, R: float, spin: float, px: float) -> float {
    let st = PI / 4.0
    let a1 = spin + 7.0 * st
    let a2 = spin + 3.5 * st
    let a3 = spin + 1.0 * st
    var g = mb_glint(q - vec2(cos(a1), sin(a1)) * (0.53 * R), max(0.55 * R, 2.6), px)
    if R > 6.0 {
        g = g + mb_glint(q - vec2(cos(a2), sin(a2)) * (0.80 * R), 0.28 * R, px) * 0.85
        g = g + mb_glint(q - vec2(cos(a3), sin(a3)) * (0.96 * R), 0.22 * R, px) * 0.7
    }
    return clamp(g, 0.0, 1.0)
}

// A ROUND BRILLIANT in colour (the emerald knobs): the octagonal table
// showing the pavilion through it as wedges that alternate dark and light,
// eight star facets, eight kites and sixteen upper girdle facets, each facet
// a flat light by how it tilts to the key light and a little chance;
// hairlines of light along the facet edges. A white stone is drawn as the
// diamond above. `q` from the centre. Colour only.
let mb_brilliant = fn(q: vec2, R: float, ink: vec3, spin: float, px: float) -> vec3 {
    if max(ink.x, max(ink.y, ink.z)) - min(ink.x, min(ink.y, ink.z)) < 0.15 {
        return mb_brilliant_white(q, R, spin, px)
    }
    let lv = mb_lv()
    let r = length(q) / max(R, 0.5)
    let a = atan2(q.y, q.x) - spin + 8.0 * PI
    let st = PI / 4.0
    let k = floor(a / st)
    let am = (a - k * st) - st * 0.5
    let fa = abs(am) / (st * 0.5)
    let roct = r * cos(am) / cos(st * 0.5)
    let rstar = mix(0.80, 0.53, fa)
    let rug = mix(0.80, 1.0, fa)
    // A white stone is all brilliance, light facets beside near black ones;
    // a coloured one keeps its colour, its facets closer together.
    let chroma = max(ink.x, max(ink.y, ink.z)) - min(ink.x, min(ink.y, ink.z))
    let colored = smoothstep(0.15, 0.4, chroma)
    let base = mix(0.64, 0.42, colored)
    let amp = mix(0.62, 0.36, colored)
    var v = 0.5
    var edge = 10.0
    var hid = 0.0
    if roct < 0.53 {
        // The pavilion seen through the table: sixteen wedges in three
        // rings, alternating, each its own small chance.
        let wk = floor(a / (st * 0.5))
        let ring = floor(r / 0.18)
        let alt = fract((wk + ring) * 0.5) * 2.0
        hid = wk * 7.0 + ring
        v = base + amp * ((alt - 0.5) * 0.95 + 0.4 * (Finish.hash(vec2(hid, 3.1)) - 0.5))
        v = mix(v, base + 0.1, smoothstep(0.07, 0.0, r))
        let ew = abs(fract(a / (st * 0.5) + 0.5) - 0.5) * (st * 0.5) * r * R
        let er = abs(fract(r / 0.18 + 0.5) - 0.5) * 0.18 * R
        edge = min(min((0.53 - roct) * R, ew), er)
    } else {
        var dir = k * st + st * 0.5
        var tilt = 0.45
        var id = 20.0 + k
        if r >= rstar && r < rug {
            let kb = k + step(0.0, am)
            dir = kb * st
            tilt = 0.62
            id = 40.0 + kb
        }
        if r >= rug {
            let side = step(0.0, am)
            dir = k * st + st * 0.5 + (side * 2.0 - 1.0) * st * 0.25
            tilt = 0.85
            id = 60.0 + 2.0 * k + side
        }
        // The two halves of a facet pair either side of its middle line
        // tilt apart a little, so the crown reads as a star of light and
        // dark triangles.
        let half = step(0.0, am) * 2.0 - 1.0
        let face = tilt * dot(vec2(cos(dir + spin + half * st * 0.2), sin(dir + spin + half * st * 0.2)), lv)
        hid = id * 2.0 + step(0.0, am)
        v = base + amp * (0.95 * face + 0.22 * half + 0.5 * (Finish.hash(vec2(hid, 7.7)) - 0.5))
        edge = min(min(abs(roct - 0.53), abs(r - rstar) * 0.85), abs(r - rug) * 0.85) * R
        if r >= rug {
            edge = min(edge, abs(am) * r * R)
        }
    }
    v = clamp(v, 0.0, 1.0)
    var col = mb_gemcol(ink, v)
    // A white stone runs from a near black grey through a cool grey to white.
    var wc = mix(vec3(0.17, 0.18, 0.22), vec3(0.60, 0.62, 0.68), smoothstep(0.0, 0.5, v))
    wc = mix(wc, vec3(1.0, 1.0, 1.0), smoothstep(0.5, 0.92, v))
    col = mix(wc, col, colored)
    // A white stone's fire: a few bright facets throw a spectral tint.
    let fh = Finish.hash(vec2(hid, 13.3))
    let fire = mix(vec3(1.0, 0.86, 0.62), vec3(0.66, 0.80, 1.0), step(0.5, fract(fh * 7.0)))
    col = mix(col, col * fire, (1.0 - colored) * step(0.86, fh) * smoothstep(0.55, 0.8, v) * 0.3)
    let line = 1.0 - smoothstep(0.0, max(px * 0.9, 0.035 * R), edge)
    col = mix(col, mix(col, vec3(1.0, 1.0, 1.0), 0.5), line * mix(0.4, 0.3, colored))
    return col
}

// ---------------------------------------------------------------- the gem renderer

// THE GEMS ARE RAY TRACED. A cut stone is a convex polyhedron (every facet a
// plane n.p <= D), seen from above by an eye several stone radii over it. A
// view ray is refracted in at the crown (a diamond bends light by 2.42),
// bounces off the facets inside a few times by total internal reflection,
// and where it can leave it is refracted out with a slightly different index
// per colour channel, so the colours part a little: the stone's fire. What
// leaves is lit by a studio (below): soft boxes of varied brightness with
// dark seams, the key light brighter at the upper left, spokes of light and
// shade over the eye. A coloured stone takes its colour by absorbing along
// the path inside it (Beer's law). Each pass is bounded: a few bounces, each
// testing one folded wedge of planes. Units: the girdle's radius (a step
// cut's half its smaller side) is 1, z toward the eye.

// A ROUND BRILLIANT, eight-fold: a table 0.565 out at its corners; eight
// bezel facets at 34.5 degrees reaching the girdle; eight stars at 22.5
// degrees on the table's edges; sixteen upper girdle facets at 42 degrees;
// below, eight pavilion mains at 40.8 degrees and sixteen lower girdle
// facets at 42.5. Folded by its symmetry into one wedge (0 the middle of a
// bezel, 22.5 degrees the middle of a star), where one plane of each family
// is the one that counts, so a ray is tested against six planes and the
// girdle's cylinder, not fifty-seven.
let mb_gfold = fn(v: vec2) -> vec2 {
    let st = PI / 4.0
    let a = atan2(v.y, v.x)
    let k = floor(a / st + 0.5)
    return vec2(k, step(0.0, a - k * st) * 2.0 - 1.0)
}
let mb_gto = fn(v: vec3, f: vec2) -> vec3 {
    let a = -f.x * PI / 4.0
    let c = cos(a)
    let s = sin(a)
    return vec3(v.x * c - v.y * s, (v.x * s + v.y * c) * f.y, v.z)
}
let mb_gfrom = fn(v: vec3, f: vec2) -> vec3 {
    let a = f.x * PI / 4.0
    let c = cos(a)
    let s = sin(a)
    let y = v.y * f.y
    return vec3(v.x * c - y * s, v.x * s + y * c, v.z)
}
// One plane's exit: kept in `best` (normal, distance) when it is nearer.
let mb_gplane = fn(best: vec4, p: vec3, d: vec3, n: vec3, dd: float) -> vec4 {
    let nd = dot(n, d)
    let t = (dd - dot(n, p)) / max(nd, 0.00001)
    let take = step(0.00001, nd) * step(t, best.w)
    return mix(best, vec4(n, t), take)
}
// The crown over (x, y): its outward normal and its height.
let mb_gcrown = fn(xy: vec2) -> vec4 {
    let f = mb_gfold(xy)
    let w = mb_gto(vec3(xy.x, xy.y, 0.0), f)
    var best = vec4(0.0, 0.0, 1.0, 0.298967)
    let zb = (0.566406 - 0.566406 * w.x) / 0.824126
    best = mix(best, vec4(0.566406, 0.0, 0.824126, zb), step(zb, best.w))
    let zs = (0.475967 - 0.353553 * w.x - 0.146447 * w.y) / 0.923880
    best = mix(best, vec4(0.353553, 0.146447, 0.923880, zs), step(zs, best.w))
    let zu = (0.669131 - 0.656273 * w.x - 0.130541 * w.y) / 0.743145
    best = mix(best, vec4(0.656273, 0.130541, 0.743145, zu), step(zu, best.w))
    return vec4(mb_gfrom(best.xyz, f), best.w)
}
// Where a ray inside the brilliant leaves it: the outward normal there and
// the distance. The wedge is taken where the ray is guessed to leave and
// the guess refined (`passes` in all); each pass can only shorten the
// distance.
// Every loop of the tracer counts to a number it is handed, not to one
// written in it: a counted loop is compiled once and run, where a written
// one is copied out pass by pass, and the copies made a page of stones take
// seconds to compile.
let mb_gexit = fn(p: vec3, d: vec3, passes: float) -> vec4 {
    var best = vec4(0.0, 0.0, 1.0, 1000.0)
    var g = p + d * 0.6
    for i in 0..passes {
        let f = mb_gfold(g.xy)
        let pw = mb_gto(p, f)
        let dw = mb_gto(d, f)
        var loc = vec4(0.0, 0.0, 1.0, 1000.0)
        loc = mb_gplane(loc, pw, dw, vec3(0.0, 0.0, 1.0), 0.298967)
        loc = mb_gplane(loc, pw, dw, vec3(0.566406, 0.0, 0.824126), 0.566406)
        loc = mb_gplane(loc, pw, dw, vec3(0.353553, 0.146447, 0.923880), 0.475967)
        loc = mb_gplane(loc, pw, dw, vec3(0.656273, 0.130541, 0.743145), 0.669131)
        loc = mb_gplane(loc, pw, dw, vec3(0.653421, 0.0, -0.756995), 0.653421)
        loc = mb_gplane(loc, pw, dw, vec3(0.654071, 0.169154, -0.737277), 0.675590)
        // The girdle, a cylinder of radius 1.
        let a = max(dot(dw.xy, dw.xy), 0.000001)
        let b = dot(pw.xy, dw.xy)
        let c = dot(pw.xy, pw.xy) - 1.0
        let tc = (sqrt(max(b * b - a * c, 0.0)) - b) / a
        let hc = pw.xy + dw.xy * tc
        let hn = hc / max(length(hc), 0.0001)
        loc = mix(loc, vec4(hn.x, hn.y, 0.0, tc), step(0.000001, dot(dw.xy, dw.xy)) * step(tc, loc.w))
        best = mix(best, vec4(mb_gfrom(loc.xyz, f), loc.w), step(loc.w, best.w))
        g = p + d * best.w
    }
    return vec4(best.xyz, clamp(best.w, 0.0, 4.0))
}

// THE STUDIO, by the direction `e` leaving the stone (in the stone's frame,
// `spin` turning it back to the room's): rows of soft boxes from 18 degrees
// up to 72, nine degrees tall and fourteen wide, every row half a box
// along, each box dim, bright or very bright by chance, with dark seams; the
// key side (upper left) brighter; over 72 degrees a ceiling of spokes of
// light and shade radiating from the eye, the eye itself a small dark patch
// straight overhead (`eyed` how dark); below the boxes broad light and dark
// panels round the horizon, lighter where the light comes up from under the
// stone.
let mb_genv = fn(e: vec3, spin: float, eyed: float) -> float {
    let d2r = PI / 180.0
    let az = atan2(e.y, e.x) + spin
    let el = atan2(e.z, length(e.xy))
    let rf = (el - 18.0 * d2r) / (9.0 * d2r)
    let ri = floor(rf)
    let fe = rf - ri
    let u = az / (14.0 * d2r) + ri * 0.5
    let ci = floor(u)
    let fa = u - ci
    let seam = clamp((0.5 - abs(fa - 0.5) - 0.12) / 0.05, 0.0, 1.0) * clamp((0.5 - abs(fe - 0.5) - 0.10) / 0.06, 0.0, 1.0)
    let h = Finish.hash(vec2(ci, ri + 3.0))
    let key = 0.7 + 0.6 * clamp(cos(az + 135.0 * d2r), 0.0, 1.0)
    var b = 0.3
    b = mix(b, 1.4, step(0.22, h))
    b = mix(b, 3.0, step(0.55, h))
    var v = 0.47 + b * key * seam
    // Below the boxes, broad panels round the horizon, light and dark.
    let pl = az / (20.0 * d2r) + 0.25
    let low = mix(0.35, 1.5, step(pl - floor(pl), 0.5)) * (0.8 + 0.4 * clamp(-e.z, 0.0, 1.0))
    v = mix(v, low, step(el, 18.0 * d2r))
    // The ceiling: spokes of light and shade radiating from the eye.
    let sp = az / (15.0 * d2r)
    let ceil = mix(0.55, 2.2, step(sp - floor(sp), 0.5))
    v = mix(v, ceil, step(72.0 * d2r, el))
    return mix(v, mix(v, 0.25, eyed), step(0.996, e.z))
}

// A direction refracted through a surface of normal `n` (facing against
// it), the indices' ratio `eta`; .w 0 where it cannot pass (total internal
// reflection).
let mb_grefr = fn(d: vec3, n: vec3, eta: float) -> vec4 {
    let c = -dot(d, n)
    let k = 1.0 - eta * eta * (1.0 - c * c)
    let thru = step(0.0, k)
    return vec4((eta * d + (eta * c - sqrt(max(k, 0.0))) * n) * thru, thru)
}
let mb_grefl = fn(d: vec3, n: vec3) -> vec3 {
    return d - 2.0 * dot(d, n) * n
}

// What a stone of the colour `ink` absorbs per unit of path inside it: the
// channels its hue lacks, and evenly as much as it is dark (a smoky stone).
let mb_gabsorb = fn(ink: vec3) -> vec3 {
    let mx = max(max(ink.x, ink.y), max(ink.z, 0.02))
    let dk = -log(mx) * 0.5
    return (vec3(1.0, 1.0, 1.0) - ink / mx) * 1.6 + vec3(dk, dk, dk)
}

// A stone's body colour for the renderer: a colourless ink (the sheet's
// diamond white) absorbs nothing.
let mb_gink = fn(ink: vec3) -> vec3 {
    let ch = max(ink.x, max(ink.y, ink.z)) - min(ink.x, min(ink.y, ink.z))
    return mix(vec3(1.0, 1.0, 1.0), ink, step(0.15, ch))
}

// A ROUND BRILLIANT at `q` (points from its centre), radius `R`, turned by
// `spin`; `ink` its body colour (white: a diamond, no absorption), `nb` the
// internal bounces followed (four for a big stone, two for a small one).
// Colour only, tone mapped.
let mb_gem = fn(q: vec2, R: float, ink: vec3, spin: float, nb: float) -> vec3 {
    // Outside the girdle there is no stone: nothing is traced there, so no
    // ray can run off to infinity in a pixel the stone does not cover.
    var res = vec3(0.5, 0.5, 0.5)
    if dot(q, q) < R * R * 1.1 {
        let cs = cos(-spin)
        let sn = sin(-spin)
        let x = (q.x * cs - q.y * sn) / max(R, 0.3)
        let y = (q.x * sn + q.y * cs) / max(R, 0.3)
        let cr = mb_gcrown(vec2(x, y))
        var p = vec3(x, y, cr.w)
        let n = cr.xyz
        // The eye eight radii over the stone and a little off its axis, in the
        // stone's frame.
        let eye = vec3(0.10 * cs + 0.18 * sn, 0.10 * sn - 0.18 * cs, 8.0)
        var d = normalize(p - eye)
        let f0 = 0.172395
        let tint = step(0.15, max(ink.x, max(ink.y, ink.z)) - min(ink.x, min(ink.y, ink.z)))
        let fi = (f0 + (1.0 - f0) * pow(1.0 - clamp(-dot(d, n), 0.0, 1.0), 5.0)) * mix(1.0, 0.4, tint)
        var col = vec3(1.0, 1.0, 1.0) * (fi * mb_genv(mb_grefl(d, n), spin, 1.0))
        var thr = vec3(1.0, 1.0, 1.0) * (1.0 - fi)
        d = mb_grefr(d, n, 1.0 / 2.419).xyz
        let absorb = mb_gabsorb(ink)
        for b in 0..nb {
            let h = mb_gexit(p, d, 2.0)
            p = p + d * h.w
            thr = thr * exp(-absorb * h.w)
            let nh = h.xyz
            let fe = f0 + (1.0 - f0) * pow(1.0 - clamp(dot(d, nh), 0.0, 1.0), 5.0)
            let rr = mb_grefr(d, -nh, 2.414)
            let rg = mb_grefr(d, -nh, 2.419)
            let rb = mb_grefr(d, -nh, 2.425)
            let lit = vec3(mb_genv(normalize(rr.xyz + vec3(0.0, 0.0, 0.00001)), spin, 1.0) * rr.w, mb_genv(normalize(rg.xyz + vec3(0.0, 0.0, 0.00001)), spin, 1.0) * rg.w, mb_genv(normalize(rb.xyz + vec3(0.0, 0.0, 0.00001)), spin, 1.0) * rb.w)
            col = col + thr * (1.0 - fe) * lit
            thr = thr * mix(1.0, fe, rg.w)
            d = mb_grefl(d, nh)
        }
        col = col + thr * 0.6
        res = vec3(1.0, 1.0, 1.0) - exp(-col * 1.5)
    }
    return res
}
// The same with `ns` samples along the device pixel's diagonal, for a big
// stone.
let mb_gem_aa = fn(q: vec2, R: float, ink: vec3, spin: float, px: float, nb: float, ns: float) -> vec3 {
    var acc = vec3(0.0, 0.0, 0.0)
    for k in 0..ns {
        let t = (float(k) + 0.5) / max(ns, 1.0) - 0.5
        acc = acc + mb_gem(q + vec2(t, t) * px, R, ink, spin, nb)
    }
    return acc / max(ns, 1.0)
}

// A STEP CUT (an emerald cut, or a baguette when long and narrow), its
// girdle the box `g` either side of its middle with its corners cut `cc`
// (units of its half height or width, whichever is less): round the table
// two crown steps, at 42 and 26 degrees, 0.22 and 0.18 wide; below, three
// pavilion steps at 55, 45 and 35 degrees, 0.25, 0.25 wide and the rest.
// Folded by its two mirrors into one quarter, where three directions count
// (its long side, its short side and the cut corner), six planes each.
// `dens` scales what the stone absorbs along its path (a pale quartz less
// than an emerald), `veil` darkens its table for words laid on it.
let mb_sdir = fn(best: vec4, p: vec3, d: vec3, u: vec2, gg: float) -> vec4 {
    var b = best
    // The girdle's side.
    b = mb_gplane(b, p, d, vec3(u.x, u.y, 0.0), gg)
    // The crown steps.
    b = mb_gplane(b, p, d, vec3(u.x * 0.669131, u.y * 0.669131, 0.743145), 0.669131 * gg)
    b = mb_gplane(b, p, d, vec3(u.x * 0.438371, u.y * 0.438371, 0.898794), 0.438371 * (gg - 0.22) + 0.898794 * 0.198089)
    // The pavilion steps.
    b = mb_gplane(b, p, d, vec3(u.x * 0.819152, u.y * 0.819152, -0.573576), 0.819152 * gg)
    b = mb_gplane(b, p, d, vec3(u.x * 0.707107, u.y * 0.707107, -0.707107), 0.707107 * (gg - 0.25) + 0.707107 * 0.357037)
    b = mb_gplane(b, p, d, vec3(u.x * 0.573576, u.y * 0.573576, -0.819152), 0.573576 * (gg - 0.5) + 0.819152 * 0.607037)
    return b
}
// The crown's height over a quarter point `w` for one direction: the lower
// of its two steps.
let mb_scrown = fn(best: vec4, w: vec2, u: vec2, gg: float) -> vec4 {
    var b = best
    let s = dot(w, u)
    let z1 = (0.669131 * gg - 0.669131 * s) / 0.743145
    b = mix(b, vec4(u.x * 0.669131, u.y * 0.669131, 0.743145, z1), step(z1, b.w))
    let z2 = (0.438371 * (gg - 0.22) + 0.898794 * 0.198089 - 0.438371 * s) / 0.898794
    return mix(b, vec4(u.x * 0.438371, u.y * 0.438371, 0.898794, z2), step(z2, b.w))
}
// Where a ray inside the step cut leaves it: the quarter taken where it is
// guessed to leave, refined (`passes` in all).
let mb_sexit = fn(p: vec3, d: vec3, g: vec2, gd: float, passes: float) -> vec4 {
    let ud = vec2(0.707107, 0.707107)
    var best = vec4(0.0, 0.0, 1.0, 1000.0)
    var gq = p + d * 0.6
    for i in 0..passes {
        let s2 = vec2(step(0.0, gq.x) * 2.0 - 1.0, step(0.0, gq.y) * 2.0 - 1.0)
        let pw = vec3(p.x * s2.x, p.y * s2.y, p.z)
        let dw = vec3(d.x * s2.x, d.y * s2.y, d.z)
        var loc = vec4(0.0, 0.0, 1.0, 1000.0)
        loc = mb_gplane(loc, pw, dw, vec3(0.0, 0.0, 1.0), 0.285881)
        loc = mb_sdir(loc, pw, dw, vec2(1.0, 0.0), g.x)
        loc = mb_sdir(loc, pw, dw, vec2(0.0, 1.0), g.y)
        loc = mb_sdir(loc, pw, dw, ud, gd)
        best = mix(best, vec4(loc.x * s2.x, loc.y * s2.y, loc.z, loc.w), step(loc.w, best.w))
        gq = p + d * best.w
    }
    return best
}
let mb_gstep = fn(q: vec2, hh: vec2, ink: vec3, nb: float, veil: float, dens: float) -> vec3 {
    // Outside its box there is no stone: nothing is traced there.
    var stone = vec3(0.5, 0.5, 0.5)
    if abs(q.x) < hh.x + 1.0 && abs(q.y) < hh.y + 1.0 {
        let sc = max(min(hh.x, hh.y), 0.5)
        let g = hh / sc
        let cc = 0.12
        let gd = (g.x + g.y - cc) * 0.707107
        let ud = vec2(0.707107, 0.707107)
        let x = q / sc
        // The crown hit, in the quarter.
        let sg = vec2(step(0.0, x.x) * 2.0 - 1.0, step(0.0, x.y) * 2.0 - 1.0)
        let w = abs(x)
        var cr = vec4(0.0, 0.0, 1.0, 0.285881)
        cr = mb_scrown(cr, w, vec2(1.0, 0.0), g.x)
        cr = mb_scrown(cr, w, vec2(0.0, 1.0), g.y)
        cr = mb_scrown(cr, w, ud, gd)
        var p = vec3(x.x, x.y, cr.w)
        let n = vec3(cr.x * sg.x, cr.y * sg.y, cr.z)
        let eye = vec3(0.08 * g.x, -0.15, 3.0 + g.x)
        var d = normalize(p - eye)
        let f0 = 0.172395
        let fi = (f0 + (1.0 - f0) * pow(1.0 - clamp(-dot(d, n), 0.0, 1.0), 5.0)) * 0.4
        var col = vec3(1.0, 1.0, 1.0) * (fi * mb_genv(mb_grefl(d, n), 0.0, 0.0))
        var thr = vec3(1.0, 1.0, 1.0) * (1.0 - fi)
        d = mb_grefr(d, n, 1.0 / 2.419).xyz
        let absorb = mb_gabsorb(ink) * dens
        for b in 0..nb {
            let best = mb_sexit(p, d, g, gd, 2.0)
            let tw = clamp(best.w, 0.0, 4.0)
            p = p + d * tw
            thr = thr * exp(-absorb * tw)
            let nh = best.xyz
            let fe = f0 + (1.0 - f0) * pow(1.0 - clamp(dot(d, nh), 0.0, 1.0), 5.0)
            let rr = mb_grefr(d, -nh, 2.414)
            let rg = mb_grefr(d, -nh, 2.419)
            let rb = mb_grefr(d, -nh, 2.425)
            let lit = vec3(mb_genv(normalize(rr.xyz + vec3(0.0, 0.0, 0.00001)), 0.0, 0.0) * rr.w, mb_genv(normalize(rg.xyz + vec3(0.0, 0.0, 0.00001)), 0.0, 0.0) * rg.w, mb_genv(normalize(rb.xyz + vec3(0.0, 0.0, 0.00001)), 0.0, 0.0) * rb.w)
            col = col + thr * (1.0 - fe) * lit
            thr = thr * mix(1.0, fe, rg.w)
            d = mb_grefl(d, nh)
        }
        col = col + thr * 0.6
        let lit_out = vec3(1.0, 1.0, 1.0) - exp(-col * 1.35)
        // Over the table a veil of the stone's deep colour, `veil` strong, so
        // words laid on it read; the steps round it keep their sparkle.
        let mx = max(max(ink.x, ink.y), max(ink.z, 0.02))
        let deep = ink / mx * 0.40 * min(mx * 1.6, 1.0) + vec3(0.02, 0.02, 0.02)
        stone = mix(lit_out, deep, veil * step(0.999, n.z))
    }
    return stone
}

// A tiny pavé diamond, radius `rad`, `q` from its centre, `h` its chance
// (a few of them catch the light and sparkle). Premultiplied.
let mb_pave = fn(q: vec2, rad: float, h: float, px: float) -> vec4 {
    let t = length(q) / max(rad, 0.1)
    let ang = atan2(q.y, q.x)
    let sec = step(0.5, fract(ang / (PI / 4.0) + h * 3.0))
    var col = mix(vec3(0.985, 0.985, 0.99), vec3(0.66, 0.67, 0.71), smoothstep(0.4, 1.0, t))
    col = col * (0.88 + 0.16 * sec)
    let sq = q / max(rad, 0.1) + vec2(0.28, 0.34)
    col = mix(col, vec3(1.0, 1.0, 1.0), exp(-dot(sq, sq) / 0.08) * 0.9)
    col = mix(col, vec3(0.42, 0.34, 0.20), Finish.band(length(q) - rad, 0.0, max(px * 0.7, 0.10 * rad), px) * 0.45)
    let a = Finish.cover(length(q) - rad, px)
    var res = vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a)
    if h > 0.86 {
        let gl = mb_glint(q + vec2(0.2, 0.25) * rad, rad * 2.6, px) * 0.85
        res = Finish.over(res, vec4(gl, gl, gl, gl))
    }
    return res
}

// MILGRAIN: a line of tiny bright beads `at` points inside the outline of a
// rounded box, `pitch` apart, the jeweller's pavé edge of a frame. Over the
// colour `col` already worked out there.
let mb_milgrain = fn(col: vec3, p: vec2, c: vec2, h: vec2, r: float, at: float, rad: float, pitch: float, px: float) -> vec3 {
    let d = Material.sd_box(p, c, h, r) + at
    let n = mb_normal(p, c, h, r)
    var s = p.x
    if abs(n.x) > abs(n.y) {
        s = p.y
    }
    let t = (fract(s / pitch) - 0.5) * pitch
    let bd = length(vec2(t, d)) - rad
    let a = Finish.cover(bd, px)
    let k = clamp((t * 0.6 - d * 0.8) / max(rad, 0.1), -1.0, 1.0)
    let bc = mix(vec3(0.60, 0.58, 0.55), vec3(1.0, 0.995, 0.985), k * 0.5 + 0.5)
    return mix(col, mix(bc, vec3(0.42, 0.33, 0.16), Finish.band(bd, 0.0, px * 0.6, px) * 0.4), a)
}

// A row of pavé diamonds along x from `x0` to `x1` on the line `cy`, `pitch`
// apart, in a gold seat. Premultiplied, over `dst`.
let mb_pave_row = fn(dst: vec4, p: vec2, x0: float, x1: float, cy: float, rad: float, pitch: float, px: float) -> vec4 {
    let cell = floor((p.x - x0) / pitch)
    let cx = x0 + (cell + 0.5) * pitch
    let inside = step(x0, cx - rad * 0.5) * step(cx + rad * 0.5, x1)
    let h = Finish.hash(vec2(cell, 5.3))
    return Finish.over(dst, mb_pave(p - vec2(cx, cy), rad, h, px) * inside)
}

// ---------------------------------------------------------------- light

// LIGHT is added, never painted: screened over what is there (what lies
// under a point taken as this face over the stone) and rolled off as
// 1 - e^-light, so it brightens and never clips or darkens.
let mb_lit = fn(res: vec4, light: vec3) -> vec4 {
    let est = res.rgb + mb_ground() * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}

// LAMPS: an LED as a gem in a gold setting. The emitter is the light: at
// full current its middle burns toward white and its rim is its most
// saturated colour; at lower current the middle is no longer white, the
// colour deeper, the glow smaller; out, it is dark tinted glass, its colour
// barely there, with a catch light on its lower rim. Its lens is faintly
// faceted, a cut stone. Round it a polished gold bezel (a round bead lit
// from the top), or a socket cut into what is under it. Over the lens one
// crisp highlight of a dome. Its light is added, never painted: a tight hot
// halo and a short bloom in its own hue, gone in about two radii; on a pale
// ground, where light can barely brighten, its hue is laid round it as a
// tint that keeps the ground's luminance (at most 0.45 one device pixel
// out, halving every 0.4 of its reach, gone at the reach). A bar is the
// same light drawn out into a light pipe.
let mb_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let mb_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
let mb_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = mb_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c`, `lit` its
// current 0..1, `ink` its colour, `ground` what shows through, `room` how
// far its light may reach, `raised` its setting (0 a socket cut in what is
// under it; 1 a gold bezel). Premultiplied over `dst`.
let mb_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.32 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = mb_lamp_full(ink)
    let hue = mb_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the setting throws on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.2 * rt + 0.3), 0.28 * rt + px) * mix(0.16, 0.30, raised) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(mb_shade() * shd, shd))
    if L > 0.001 && pale > 0.001 {
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The setting: a polished gold bead round the lens, or a socket cut into
    // what is under it, its upper wall in shadow and a catch light on its
    // lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(1.0 - d / max(bw, 0.01), 0.0, 1.0)
    let gold = mb_gold(mb_bead(u, nrm))
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = mix(sc, gold, clamp(raised, 0.0, 1.0))
    sc = mix(sc, sc * 0.55, Finish.band(d, -px, 0.0, px) * 0.8)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, falling on
    // the setting too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = mb_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE STONE: a glossy dome of coloured glass, faintly faceted. Its
    // colour deepens toward the top; light pools low inside; lit, its
    // middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    let fac = Finish.hash(vec2(floor((atan2(q.y, q.x) + PI) / (PI / 4.0)), floor(t * 2.2) + 3.0))
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = on * (0.86 + 0.28 * fac * smoothstep(0.3, 0.6, t))
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.995, 0.985), exp(-t * t / 0.26) * smoothstep(0.5, 1.0, L) * 0.95)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass, its colour barely there, the same facets, a
    // catch light along its lower rim.
    let offc = mix(vec3(0.075, 0.068, 0.060), b * 0.40, 0.16)
    var off = mix(offc * 0.62, offc * 1.15, top) * (0.85 + 0.35 * fac * smoothstep(0.3, 0.6, t))
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.28, 0.26) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}
let mb_led = fn(dst: vec4, p: vec2, c: vec2, rd: float, lit: float, ink: vec3, px: float) -> vec4 {
    return mb_lamp(dst, p, c, vec2(rd, rd), lit, ink, 0.6, px, mb_ground(), 3.0 * rd + 2.5, 1.0)
}

// ---------------------------------------------------------------- shadows

// What a piece of jewellery standing on the stone throws: a soft warm
// shadow falling a little down, drawn in a point from the sides, half gone
// two points under the foot and gone by five (within half of the eight
// point gap to a neighbour), and a close contact shadow. Held, the piece
// sits down and most of it goes. Returns the coverage.
let mb_shadow = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, hover: float, down: float, dis: float) -> float {
    let sink = 1.0 - 0.7 * down
    let hs = vec2(max(h.x - 1.0, 0.5), h.y)
    let amb = Finish.drop(p, c, hs, min(r, min(hs.x, hs.y)), vec2(0.0, (1.3 + 0.3 * hover) * sink), 1.1 + 0.2 * hover + px * 0.5) * (0.30 + 0.05 * hover) * sink * (1.0 - 0.8 * dis)
    let con = Finish.drop(p, c, h, r, vec2(0.0, 0.45 + px * 0.5), 0.45 + px * 0.5) * mix(0.30, 0.15, down) * (1.0 - 0.6 * dis)
    return 1.0 - (1.0 - amb) * (1.0 - con)
}

// The warm gold light the focus frame spills outward: a tint one device
// pixel out, gone within 2.5 points. Premultiplied, laid under the face.
let mb_leak = fn(d: float, a: float) -> vec4 {
    let s = 1.1
    let g = 0.55 * exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * s * s)) * (1.0 - a)
    return vec4(vec3(0.95, 0.74, 0.30) * g, g)
}
// Focus over a gold rim: the rim burns brighter, toward the white-gold.
let mb_focus_rim = fn(col: vec3, d: float, w: float, px: float, fo: float) -> vec3 {
    if fo < 0.001 {
        return col
    }
    let band = Finish.band(d, 0.0, w, px)
    return mix(col, min(col * 1.25 + vec3(0.10, 0.08, 0.02), vec3(1.0, 0.97, 0.86)), band * fo * 0.8)
}

// A JEWEL BOX: the shape every raised control is cut from: a face set in a
// polished gold rim `rw` wide, sunk a little under the rim (a soft shade
// under its upper edge and a dark device pixel where face meets gold), the
// whole throwing its shadow on the stone. `face` is the colour the caller
// worked out for the face at this point. Held, the box sits half a point
// lower. Premultiplied, over the shadow and focus spill it lays first.
// The same box; `dbl` 1 gives it the double rim.
let mb_box2 = fn(p: vec2, lo: vec2, hi: vec2, r: float, rw: float, px: float, face: vec3, hover: float, down: float, dis: float, focus: float, lift: float, dbl: float) -> vec4 {
    let live = 1.0 - dis
    let sink = 0.8 * down * live
    let c0 = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let c = c0 + vec2(0.0, sink)
    let sc = mb_shadow(p, c0, h, r, px, hover, down, dis) * lift
    var res = vec4(mb_shade() * sc, sc)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, mb_leak(d, a) * fo)
    }
    let n = mb_normal(p, c, h, r)
    var col = face
    let hi_in = h - vec2(rw, rw)
    let ri = max(r - rw, 0.0)
    let insh = Finish.inset(p, c, hi_in, ri, vec2(0.0, 1.0), 1.2)
    col = mix(col, col * 0.80, clamp(insh, 0.0, 1.0) * (0.45 + 0.35 * down * live) * Finish.cover(d + rw, px))
    col = mix(col, vec3(0.30, 0.21, 0.07), Finish.band(d, rw, rw + px, px) * 0.55)
    let rim = Finish.band(d, 0.0, rw, px)
    var gold = mix(mb_rim(d, rw, n, p), mb_rim2(d, rw, n, p, px), dbl)
    gold = mix(gold, mix(vec3(0.80, 0.77, 0.70), gold, 0.35), 0.6 * dis)
    col = mix(col, gold, rim)
    col = mb_focus_rim(col, d, rw, px, fo)
    return Finish.over(res, vec4(col * a, a))
}

// The jewel box with the single rim.
let mb_box = fn(p: vec2, lo: vec2, hi: vec2, r: float, rw: float, px: float, face: vec3, hover: float, down: float, dis: float, focus: float, lift: float) -> vec4 {
    return mb_box2(p, lo, hi, r, rw, px, face, hover, down, dis, focus, lift, 0.0)
}

// ---------------------------------------------------------------- buttons

// Every button is a jewel box: 26 points on a 12 point line, 12 points
// either side, a 3.5 point corner, its gold rim about four points wide. Its shadow and its light fall outside
// the box.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
// The size rungs keep heights of their own.
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 30.0
mod.widgets.ButtonXl.min_height = 34.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(3.5)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.34)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The button and its variants share one face; `kind` picks it: 0 a bar of
// polished gold (the plain, small and large buttons), 1 white marble in a
// gold rim (the default button), 2 an emerald baguette (primary), 3 a
// champagne quartz (secondary), 4 a smoky quartz (tertiary), 5 a ruby
// (danger), 6 an outline of gold wire, 7 no face (a gold wash under the
// hand). A cut stone catches a star glint at its upper right corner,
// brighter under the hand.
// A JEWEL BUTTON'S STONE (kinds 2 to 5) at this pixel, traced in the face
// the button below lays out: an emerald, a champagne or a smoky quartz, or a
// ruby, step cut. A quartz is a pale stone: it absorbs far less along its
// path than an emerald or a ruby. Only the jewel variants call it, so the
// plain buttons' shaders carry no tracer.
let mb_button_gem = fn(pos: vec2, size: vec2, o: vec2, dpi: float, down: float, dis: float, kind: float) -> vec3 {
    let m = 12.0
    let px = mb_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x, o.x, px), mb_snap(size.y, o.y, px))
    let cf = (lo + hi) * 0.5 + vec2(0.0, 0.8 * down * (1.0 - dis))
    let rw = clamp(0.15 * (hi.y - lo.y), 2.6, 4.6)
    var gem = mb_emerald()
    var dens = 1.0
    if kind > 2.5 && kind < 3.5 {
        gem = mb_champagne()
        dens = 0.2
    }
    if kind > 3.5 && kind < 4.5 {
        gem = mb_smoky()
        dens = 0.25
    }
    if kind > 4.5 {
        gem = mb_ruby()
    }
    return mb_gstep(p - cf, (hi - lo) * 0.5 - vec2(rw, rw), gem, 3.0, 0.55, dens)
}

// `gem` is the jewel's stone from the function above (ignored by the
// other kinds).
let mb_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, dis: float, focus: float, loading: float, anim: float, kind: float, dash: float, gem: vec3) -> vec4 {
    let m = 12.0
    let px = mb_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(mb_snap(0.0, o.x, px), mb_snap(0.0, o.y, px))
    let hi = vec2(mb_snap(size.x, o.x, px), mb_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let r = min(3.5, min(h.x, h.y))
    let live = 1.0 - dis
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    var ink = mb_ink()
    if kind > 5.5 {
        let d = Material.sd_box(p, c, h, r)
        let a = Finish.cover(d, px)
        let n = mb_normal(p, c, h, r)
        if focus * live > 0.001 {
            res = Finish.over(res, mb_leak(d, a) * focus * live)
        }
        // Under the hand a faint white wash on the stone, held a faint gold one.
        let wash = 0.45 * hover * (1.0 - down) * live * a
        res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * wash * 0.6, wash * 0.6))
        let press = 0.14 * down * live * a
        res = Finish.over(res, vec4(vec3(0.72, 0.59, 0.31) * press, press))
        if kind < 6.5 {
            // The outline: a round gold wire, its contact shadow under it.
            let rw = 2.4
            var ring = Finish.band(d, 0.0, rw, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let sh = Finish.drop(p, c, h, r, vec2(0.0, 0.6), 0.6) * (1.0 - Finish.cover(d + rw, px)) * 0.25 * live
            res = Finish.over(res, vec4(mb_shade() * sh, sh))
            var gold = mb_rim(d, rw, n, p)
            gold = mix(gold, vec3(0.80, 0.77, 0.70), 0.55 * dis)
            gold = mb_focus_rim(gold, d, rw, px, focus * live)
            res = Finish.over(res, vec4(gold * ring, ring))
        }
    } else {
        let sink = 0.8 * down * live
        let cf = c + vec2(0.0, sink)
        let rw = clamp(0.15 * hh, 2.6, 4.6)
        let hf = h - vec2(rw, rw)
        let rf = max(r - rw, 0.5)
        let df = Material.sd_box(p, cf, hf, rf)
        let nf = mb_normal(p, cf, hf, rf)
        var face = vec3(0.0, 0.0, 0.0)
        if kind < 0.5 {
            face = mb_goldface(p, cf, hf, df, nf, 2.2)
            ink = vec3(0.20, 0.14, 0.04)
        } else if kind < 1.5 {
            let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
            face = mb_stone(p + mb_seed(size), px, 0.55)
            face = face * (1.015 - 0.045 * t)
            face = mb_milgrain(face, p, cf, h, r, rw + 1.0, 0.6, 1.9, px)
        } else {
            face = gem
            ink = vec3(1.0, 0.98, 0.94)
        }
        face = face * (1.0 + 0.05 * hover * live - 0.11 * down * live)
        let fl = dot(face, vec3(0.3, 0.5, 0.2))
        face = mix(face, mix(mb_ground(), vec3(fl, fl, fl), 0.3), 0.6 * dis)
        res = mb_box(p, lo, hi, r, rw, px, face, hover, down, dis, focus, 1.0)
        if kind > 1.5 && dis < 0.5 {
            let gq = p - vec2(hi.x - rw - 4.5, lo.y + rw + 3.2 + sink)
            let g = mb_glint(gq, 5.0 + 1.5 * hover, px) * (0.5 + 0.5 * hover) * Finish.cover(df, px)
            res = Finish.over(res, vec4(g, g, g, g))
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 5.5, 2.0)
        let sdf = Sdf2d.viewport(p)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, 1.5)
        sdf.fill(vec4(ink, loading))
        res = Finish.over(res, sdf.result)
    }
    return res * mb_fade(pos, size, m)
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0, vec3(0.0, 0.0, 0.0)), 12.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0, vec3(0.0, 0.0, 0.0)), 12.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let gem = mb_button_gem(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.down, self.disabled, 2.0)
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0, 0.0, gem), 12.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let gem = mb_button_gem(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.down, self.disabled, 3.0)
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0, 0.0, gem), 12.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let gem = mb_button_gem(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.down, self.disabled, 4.0)
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0, 0.0, gem), 12.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let gem = mb_button_gem(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.down, self.disabled, 5.0)
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0, 0.0, gem), 12.0)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0, self.border_dash, vec3(0.0, 0.0, 0.0)), 12.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return self.host_over(mb_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0, 0.0, vec3(0.0, 0.0, 0.0)), 12.0)
}

