mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #26190a
mod.widgets.SegmentedControlFlat.palette.on_secondary_container = #26190a
mod.widgets.SegmentedControl.palette.on_primary_container = #26190a
mod.widgets.SegmentedControl.palette.on_neutral_container = #26190a
