mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    var out = cb_field(p, size, self.rect_pos, px, self.hover, self.focus, self.disabled, 3.0)
    let held = self.down * self.hover * live
    let cc = vec2(size.x - 14.0, size.y * 0.5 + held * px + 0.5)
    let tri = cb_tri(p, cc, 4.6, 2.8, 1.0) + cb_wob(p, 0.12, vec2(2.0, 2.0))
    return Finish.over(out, cb_fill(tri, p, px, mix(cb_ink_c(), cb_dry_c(), self.disabled), mix(1.0, 0.6, self.disabled)))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. The strip is one piece of card glued on the board,
// framed in marker; the chosen segment is a piece of black card set into it
// with a gap of its own, pressed in, its word in cream.
let cb_strip = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    return cb_piece(p, c, h, vec4(4.0, 4.0, 4.0, 4.0), px, clamp(h.y * 0.19, 1.8, 3.0), 0.0, 0.0, 0.0, 0.0, vec3(0.0, 0.0, 0.0), 1.0, size * vec2(1.1, 0.7))
}
// The chosen cell: black card, its gap round it, pressed in. `lo` and `hi`
// are the cell's corners in the quad's own points.
let cb_cell = fn(p: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = cb_rbox(p, c, h, 3.0) + cb_wob(p, 0.14, vec2(6.0, 6.0))
    var out = cb_gap(p, d, p.y - c.y, h.y, 1.1, px, 1.0)
    var face = cb_blackcard(p + hi * 1.7, px, 1.0)
    let insh = clamp(Finish.inset(p, c, h, 3.0, vec2(0.0, 1.2), 1.0), 0.0, 1.0)
    face = mix(face, vec3(0.03, 0.025, 0.02), insh * 0.5)
    face = cb_cut_edge(face, d, p.y - c.y, h.y, px, 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.SegmentedControlFlat.segment_height = 26.0
mod.widgets.SegmentedControlFlat.segment_padding = 10.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cb_strip(p, self.rect_size, self.rect_pos, px)
}
// The pill is the segment's own box, two points in from the strip; the card
// stands a point further in, inside the strip's marker frame. Its quad grows
// two points round it for the gap and its lip.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(2.0, 2.0), self.rect_size + vec2(4.0, 4.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(4.0, 4.0)) - vec2(2.0, 2.0)
    let lo = vec2(Finish.snap(o.x + 1.5, px), Finish.snap(o.y + 1.5, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 1.5, px), Finish.snap(o.y + size.y - 1.5, px)) - o
    return cb_cell(p, lo, hi, px)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #x18140e
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #xf1e6cf
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #xf1e6cf
mod.widgets.SegmentedControlFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_label{}

// The tab strip: every tab a piece of card glued on the board side by side,
// framed in marker; the tab in use is yellow paper, a hovered one a shade
// lighter. The close mark is a marker cross; the add mark a small piece of
// card of its own with a marker plus.
let cb_tab = fn(pos: vec2, size: vec2, o: vec2, px: float, kind: float, hover: float) -> vec4 {
    let m = 5.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(Finish.snap(o.x + 2.0, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x - 2.0, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    return cb_piece(p, c, h, vec4(4.0, 4.0, 4.0, 4.0), px, clamp(h.y * 0.19, 1.8, 3.0), hover, 0.0, 0.0, kind, vec3(0.0, 0.0, 0.0), 1.0, size * vec2(0.9, 1.3))
}
mod.widgets.Tabs.height = 30.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_tab(self.pos, self.rect_size, self.rect_pos, px, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_tab(self.pos, self.rect_size, self.rect_pos, px, 0.0, 1.0)
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_tab(self.pos, self.rect_size, self.rect_pos, px, 9.0, 0.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_mark.color = #x18140e
mod.widgets.Tabs.draw_mark.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let c = self.rect_size * 0.5
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.plus > 0.5 {
        let bh = self.rect_size * 0.5 + vec2(2.0, 2.0)
        out = cb_piece(p, c, bh, vec4(3.0, 3.0, 3.0, 3.0), px, 2.0, 0.0, 0.0, 0.0, 0.0, vec3(0.0, 0.0, 0.0), 1.0, vec2(23.0, 7.0))
    }
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(3.2, 4.4, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(0.0 - sin(a), cos(a)) * r
    let dd = min(cb_seg(p, c - u, c + u), cb_seg(p, c - v, c + v))
    return Finish.over(out, cb_stroke(dd, mix(0.65, 0.85, self.plus), p, px, self.color.rgb, self.color.a))
}
mod.widgets.Tabs.draw_text.color = #x18140e
mod.widgets.Tabs.draw_text_active.color = #100c08
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_label{font_size: 11.5}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_label{font_size: 11.5}

// ---------------------------------------------------------------------------
// PROGRESS. A thin marker line the length of the bar, and over the value a
// broad stroke of marker (a coloured marker for an intent). The unknown
// value is a row of short slanted strokes along the whole line: a face may
// not run a clock.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = uniform(7.0)
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let cy = size.y * 0.5
    let x0 = size.x * self.start
    let x1 = size.x * self.end
    let dis = step(4.5, self.intent)
    var ink = cb_ink_c()
    if self.intent > 0.5 {
        ink = mix(self.fill_color().rgb * 0.85, cb_ink_c(), 0.25)
    }
    ink = mix(ink, cb_dry_c(), dis)
    let wy = cy + (Finish.noise(vec2(p.x * 0.05, 7.0)) - 0.5) * 0.5
    let hw = th * 0.5 - 0.3
    var out = cb_stroke(cb_seg(p, vec2(x0 + 0.7, wy), vec2(x1 - 0.7, wy)), 0.7, p, px, cb_ink_c(), 0.75 * self.track)
    if self.value < 0.0 {
        let u = (p.x - x0) / 6.0
        let k = floor(u)
        let sx = x0 + (k + 0.5) * 6.0
        let ds = cb_seg(p, vec2(sx - 1.6, wy + hw), vec2(sx + 1.6, wy - hw))
        let inr = step(x0 + 1.0, sx) * step(sx, x1 - 1.0)
        out = Finish.over(out, cb_stroke(ds, 0.8, p, px, ink, inr))
    } else {
        let v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
        if v1 - x0 > 0.5 {
            let a = x0 + hw
            let b = max(v1 - hw, a)
            out = Finish.over(out, cb_stroke(cb_seg(p, vec2(a, wy), vec2(b, wy)), hw, p, px, ink, 1.0))
        }
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LAMPS: an LED pushed through a hole punched in the card. The emitter is
// the light: at full current its middle burns toward white and its rim is
// its most saturated colour; at lower current the middle is no longer
// white, the colour deeper, the glow smaller; out, it is dark tinted glass,
// its colour barely there. Round it the punched hole: a dark socket, its
// upper wall in shade and a catch light on its lower rim, and round that a
// ring of torn card fibres the punch pushed down. Over the lens one crisp
// highlight of a dome. Its light is added, never painted: a tight hot halo
// and a short bloom in its own hue, screened over the card and gone in about
// two radii.
let cb_led_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(0.0 - light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
let cb_led = fn(p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, room: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.42 * rt, 1.0, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
    let mn = min(b.x, min(b.y, b.z))
    let pure = (b - vec3(mn, mn, mn)) / max(1.0 - mn, 0.001)
    let hue = mix(b, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, 1.0 - mn))
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let ground = cb_kraft_c()
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // the punched edge: torn fibres pushed down round the hole
    let ang = atan2(q.y, q.x)
    let tear = (Finish.noise(vec2(ang * 3.0, rt)) - 0.5) * 0.9 + (Finish.hash(vec2(floor(ang * 9.0), rt)) - 0.5) * 0.5
    let dr = ds - 1.2 - tear * 0.7
    let rag = Finish.cover(dr, px) * (1.0 - Finish.cover(ds, px))
    let ragc = mix(cb_liner_c() * 0.95, cb_kraft_c() * 0.58, smoothstep(-0.7, 0.7, 0.0 - nrm.y))
    res = Finish.over(res, vec4(ragc * rag * 0.9, rag * 0.9))
    // the socket: the hole's wall, shade above and a catch light below
    let a_s = Finish.cover(ds, px)
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = vec3(0.14, 0.09, 0.05) * mix(0.55, 1.2, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, cb_liner_c() * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.7)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // the light: a tight hot halo and a short bloom in its hue
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(0.0 - xl / max(0.30 * rt, 0.4)) * 1.5 + exp(0.0 - xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(0.55 * room, room, xl)
        res = cb_led_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin, ground)
    }
    // the bead: a glossy dome of coloured glass
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(0.0 - (q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(0.0 - t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    let offc = mix(vec3(0.085, 0.075, 0.07), b * 0.45, 0.24)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A row of short marker dashes, the lit ones full ink and the
// last tenth in red marker, the unlit ones only outlined in dry pencil; the
// hold is a dash drawn across; the over lamp an LED in a punched hole. On a
// display (a meter with no lamp lying along a screen) the dashes are the
// display's yellow paint, the unlit ones a ghost of it.
mod.widgets.LevelMeter.height = 9.0
mod.widgets.LevelMeterColumn.width = 9.0
mod.widgets.LevelMeter.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let screen = (1.0 - step(0.5, self.lamp)) * (1.0 - step(0.5, vert))
    let th = min(7.0, across - 1.0)
    let lamp_room = self.lamp * (th + 6.0)
    let bar = max(4.0, along - lamp_room)
    let pitch = mix(5.0, 3.5, screen)
    let cw = mix(2.6, 2.0, screen)
    let n = max(floor((bar - 1.0) / pitch), 1.0)
    let pad = (bar - n * pitch) * 0.5
    let k = clamp(floor((a - pad) / pitch), 0.0, n - 1.0)
    let ca = pad + (k + 0.5) * pitch
    let share = (k + 0.5) / n
    let lit = step(share, self.level + 0.5 / n) * step(0.001, self.level)
    let q = vec2(a, b)
    let hh = th * 0.5 - mix(0.5, 1.0, screen)
    let dd = cb_rbox(q, vec2(ca, across * 0.5), vec2(cw * 0.5, hh), cw * 0.5) + cb_wob(p, 0.12, vec2(7.0, 2.0))
    let hot = step(0.9, share)
    var ink = mix(cb_ink_c(), cb_redink_c(), hot)
    ink = mix(ink, vec3(0.949, 0.788, 0.306), screen)
    var out = cb_fill(dd, p, px, ink, lit * mix(1.0, 0.95, screen))
    let pencil = mix(vec3(0.30, 0.24, 0.17), vec3(0.949, 0.788, 0.306), screen)
    out = Finish.over(out, cb_stroke(abs(dd), 0.38, p, px, pencil, (1.0 - lit) * mix(0.45, 0.0, screen)))
    out = Finish.over(out, cb_fill(dd, p, px, pencil, (1.0 - lit) * screen * 0.16))
    if self.hold > 0.002 {
        let at = pad + n * pitch * self.hold
        let hd = cb_seg(q, vec2(at, across * 0.5 - hh - 1.0), vec2(at, across * 0.5 + hh + 1.0))
        out = Finish.over(out, cb_stroke(hd, 0.7, p, px, ink, 1.0))
    }
    if self.lamp > 0.5 {
        let la = bar + 3.0 + th * 0.5
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, cb_led(p, lc, vec2(2.4, 2.4), step(0.5, self.over), vec3(0.95, 0.20, 0.12), 1.0, px, 2.2))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A narrow slot cut in the board, and riding in it a strip of
// board glued on, its thin shadow under it.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let sc = self.rect_size * 0.5
    let sh = mix(vec2(along * 0.5 - 1.0, 1.4), vec2(1.4, along * 0.5 - 1.0), vert)
    let sd = cb_rbox(p, sc, sh, 1.4)
    let sa = Finish.cover(sd, px) * 0.55
    var out = vec4(vec3(0.10, 0.065, 0.035) * sa, sa)
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let tc1 = t0 + tl * 0.5
    let tc = mix(vec2(tc1, sc.y - 0.6), vec2(sc.x, tc1 - 0.6), vert)
    let th = mix(vec2(max(tl * 0.5 - 1.0, 4.0), 3.2), vec2(3.2, max(tl * 0.5 - 1.0, 4.0)), vert)
    out = Finish.over(out, cb_under(p, tc, th, 3.2, px, 1.1, cb_kraft_c(), 0.2))
    let td = cb_rbox(p, tc, th, 3.2)
    var face = cb_kraft(p + vec2(13.0, 3.0), px, Finish.lift(cb_kraft_c(), 0.08), 1.0)
    face = Finish.lift(face, 0.10 * self.hover - 0.06 * self.drag)
    face = cb_cut_edge(face, td, p.y - tc.y, th.y, px, 1.0)
    let ta = Finish.cover(td, px)
    out = Finish.over(out, vec4(face * ta, ta))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised panel is a piece of board glued on the board:
// its shadow, its cut edge along its foot with the flutes in it, the pale
// cut line round its face. The sunken panel is a window cut through the
// board: the cut wall along its top seen side on, the floor the deeper
// board beyond it in the wall's shade, a pale lip where the window's liner
// was cut along its foot.
let cb_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let seed = size * vec2(0.73, 1.19)
    let d = cb_rbox(p, c, h, r) + cb_wob(p, 0.22, seed * 0.01)
    if sunken > 0.5 {
        let th = 3.0
        let g = cb_gap(p, d + 0.01, p.y - c.y, h.y, 0.01, px, 1.0)
        let yin = p.y - lo.y
        let wall = cb_flute(p.x + seed.x, clamp(yin / th, 0.0, 1.0), th, px, cb_kraft_c())
        var flr = cb_kraft(p + seed, px, cb_kraft_c() * 0.86, 1.0)
        let ish = clamp(Finish.inset(p, c + vec2(0.0, th), h, r, vec2(0.0, 1.6), 2.0), 0.0, 1.0)
        flr = mix(flr, cb_shade_c(), ish * 0.40)
        let side = clamp(Finish.inset(p, c, h, r, vec2(0.0, 0.0), 0.6), 0.0, 1.0)
        flr = mix(flr, cb_shade_c(), side * 0.35)
        var col = mix(flr, wall, (1.0 - step(th, yin)) * step(0.0, yin))
        let a = Finish.cover(d, px)
        let lip = Finish.ring_out(d, 0.0, 1.2 * px, px) * smoothstep(0.0, h.y, p.y - c.y) * 0.8
        var out = vec4(cb_liner_c() * lip, lip)
        out = Finish.over(out, vec4(col * a, a))
        return Finish.over(g, out)
    }
    var out = cb_under(p, c, h, r, px, 2.6, cb_kraft_c(), 0.6)
    var face = cb_kraft(p + seed, px, Finish.lift(cb_kraft_c(), 0.05), 1.0)
    // the flutes under the liner show through it as the faintest ribs
    face = face * (1.0 + 0.016 * sin((p.y + seed.y) / 4.4 * 6.2831853) * (0.6 + 0.4 * Finish.noise(p * 0.05)))
    face = cb_cut_edge(face, d, p.y - c.y, h.y, px, 1.0)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cb_plate(p, self.rect_size, self.rect_pos, px, 5.0, self.sunken)
}

// A STRIP OF MASKING TAPE: crepe paper, cream and a little translucent, its
// fine crinkles running across it, its two ends torn ragged. `c` its
// middle, `ang` its turn, `hl` and `hw` half its length and width.
let cb_tape = fn(p: vec2, c: vec2, ang: float, hl: float, hw: float, px: float, seed: float) -> vec4 {
    let cs = cos(ang)
    let sn = sin(ang)
    let q = vec2((p.x - c.x) * cs + (p.y - c.y) * sn, (p.y - c.y) * cs - (p.x - c.x) * sn)
    let tear = (Finish.noise(vec2(q.y * 1.7, seed + step(0.0, q.x) * 9.0)) - 0.5) * 1.8 + (Finish.hash(vec2(floor(q.y * 2.5), seed)) - 0.5) * 0.6
    let de = abs(q.x) - hl - tear
    let ds = abs(q.y) - hw - (Finish.noise(vec2(q.x * 0.6, seed + 3.0)) - 0.5) * 0.3
    let d = max(de, ds)
    let crepe = 1.0 + (Finish.noise(vec2(q.x * 2.4, q.y * 0.25 + seed)) - 0.5) * 0.08 + Finish.grain(p / px, 0.012)
    let col = vec3(0.925, 0.870, 0.725) * crepe
    let a = Finish.cover(d, px) * 0.84
    let edge = Finish.ring_out(d, 0.0, 0.8, px) * 0.12
    var out = vec4(cb_shade_c() * edge, edge)
    return Finish.over(out, vec4(col * a, a))
}

// The card is a sheet of cream paper glued on, held down at its top right
// corner by a strip of masking tape laid across it; it lifts a little under
// the pointer.
mod.widgets.Card.radius = 3.0
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 8.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, 2.0) + cb_wob(p, 0.2, vec2(5.0, 1.0))
    let lift = 0.4 + 0.4 * self.hover - 0.3 * self.down
    var out = cb_under(p, c, h, 2.0, px, 0.0, cb_kraft_c(), lift)
    var face = cb_paper(p + size * 0.37, px, cb_cream_c(), 1.0)
    face = face * (1.02 - 0.05 * smoothstep(0.0 - h.y, h.y, p.y - c.y))
    face = Finish.lift(face, 0.04 * self.hover)
    face = mix(face, face * 0.86, Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    return Finish.over(out, cb_tape(p, vec2(hi.x - 12.0, lo.y + 6.0), 0.62, 13.0, 5.0, px, 3.0))
}

// The plain rounded view keeps the colour its caller gives it, laid as a
// sheet of paper of that colour; the edge a snapped line at the radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, max(self.border_radius, 1.0))
    var col = cb_paper(p + self.rect_size * 0.29, px, fill.rgb, step(0.9, fill.a))
    if self.border_size > 0.0 {
        col = mix(col, self.border_color.rgb, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * fill.a
    return vec4(col * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points of words on the board; a hovered row is
// underlined in faint pencil; the chosen row is a strip of yellow paper
// glued on, its thin shadow under it.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.selected > 0.5 {
        let h = vec2((hi.x - lo.x) * 0.5 - 6.0, (hi.y - lo.y) * 0.5 - 2.0)
        let c = vec2(lo.x + h.x + 2.0, (lo.y + hi.y) * 0.5 - 0.6)
        let d = cb_rbox(p, c, h, 1.0) + cb_wob(p, 0.2, vec2(8.0, 3.0))
        out = cb_under(p, c, h, 1.0, px, 0.0, cb_kraft_c(), 0.1)
        var face = cb_paper(p + vec2(3.0, 41.0), px, cb_yellow_c(), 1.0)
        face = mix(face, face * 0.84, Finish.band(d, 0.0, px, px) * 0.6)
        let a = Finish.cover(d, px)
        out = Finish.over(out, vec4(face * a, a))
    }
    let uy = hi.y - 2.5 + (Finish.noise(vec2(p.x * 0.07, 5.0)) - 0.5) * 0.6
    let du = cb_seg(p, vec2(lo.x + 8.0, uy), vec2(hi.x - 14.0, uy))
    out = Finish.over(out, cb_stroke(du, 0.4, p, px, vec3(0.30, 0.24, 0.17), (0.45 * self.hover + 0.25 * self.down) * live * (1.0 - self.selected)))
    return out
}
mod.widgets.ListItem.draw_text.color = #x18140e

// The open list of a drop-down: a sheet of cream paper with its shadow;
// the row under the pointer is swept with yellow highlighter, the chosen
// row carries a marker tick.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, 2.0) + cb_wob(p, 0.2, vec2(1.0, 1.0))
    var out = cb_under(p, c, h, 2.0, px, 0.0, cb_kraft_c(), 1.0)
    var face = cb_paper(p + vec2(17.0, 9.0), px, cb_cream_c(), 1.0)
    face = mix(face, face * 0.82, Finish.band(d, 0.0, px, px) * 0.7)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let live = 1.0 - self.disabled
    let hy = c.y + (Finish.noise(vec2(p.x * 0.06, 2.0)) - 0.5) * 0.8
    let h = vec2(c.x - 3.0, c.y - 2.0)
    let d = cb_rbox(p, vec2(c.x, hy), h, h.y)
    let wa = Finish.cover(d, px) * self.hover * live * 0.55
    var out = vec4(cb_yellow_c() * wa, wa)
    let m0 = vec2(6.0, c.y)
    let m1 = vec2(8.6, c.y + 2.8)
    let m2 = vec2(13.0, c.y - 3.6)
    let mk = min(cb_seg(p, m0, m1), cb_seg(p, m1, m2))
    return Finish.over(out, cb_stroke(mk, 0.8, p, px, cb_ink_c(), self.active))
}

// The dock's tabs: the tab in use is a piece of board glued on, rounded at
// the top and open at the foot where it joins the panel below; the others
// take a breath of pencil under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 6.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cb_rbox(p, c, h, 4.0)
    var face = cb_kraft(p + vec2(7.0, 7.0), px, Finish.lift(cb_kraft_c(), 0.05), 1.0)
    face = cb_cut_edge(face, d, p.y - c.y, h.y, px, 1.0)
    let a = Finish.cover(d, px) * self.active
    let wash = Finish.cover(d, px) * 0.08 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(cb_shade_c() * wash, wash), vec4(face * a, a))
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = self.rect_size.y - 1.0 + (Finish.noise(vec2(p.x * 0.05, 1.0)) - 0.5) * 0.4
    return cb_stroke(abs(p.y - yb), 0.5, p, px, cb_ink_c(), 0.7)
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small piece in its window (paper of its
// colour when it has one, framed in marker when outlined, bare when a
// ghost); a badge is a slip of paper framed in marker with its count.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let ch = min(24.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    let has_fill = step(0.05, self.color.a)
    let mx = max(self.color.r, max(self.color.g, self.color.b))
    let mn = min(self.color.r, min(self.color.g, self.color.b))
    let neutral = 1.0 - step(0.25, (mx - mn) / max(mx, 0.01))
    let light_ink = step(0.6, Finish.lum(self.ink.rgb))
    let kind = mix(mix(mix(6.0, 5.0, step(0.01, self.border_size)), mix(7.0, 0.0, neutral), has_fill), 1.0, light_ink)
    let tint = vec4(self.color.rgb, has_fill)
    // light words ask for a dark ground: they are written on black card
    return cb_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(4.0, 4.0, 4.0, 4.0), kind, m, tint, 0.0)
}
mod.widgets.BadgePalette.neutral = #xe6d8bc
mod.widgets.BadgePalette.on_neutral = #x18140e
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_label{font_size: 10.0}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_label{font_size: 10.0}
mod.widgets.BadgeFlat.clip_x = false
mod.widgets.BadgeFlat.clip_y = false
mod.widgets.BadgeFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let bh = min(18.0, self.rect_size.y - 1.0)
    let y0 = (self.rect_size.y - bh) * 0.5
    let lo = vec2(1.0, y0)
    let hi = vec2(self.rect_size.x - 1.0, y0 + bh)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = mix(2.5, h.y, step(self.rect_size.x, self.rect_size.y + 0.5) * step(self.rect_size.y, 12.5))
    let d = cb_rbox(p, c, h, r) + cb_wob(p, 0.18, vec2(2.0, 8.0))
    var out = cb_under(p, c, h, r, px, 0.0, cb_kraft_c(), 0.0)
    let face = cb_paper(p + vec2(9.0, 4.0), px, self.color.rgb, 1.0)
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    out = Finish.over(out, cb_stroke(abs(d + 0.7), 0.65, p, px, cb_ink_c(), 1.0))
    return out * self.color.a
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in marker with a dry pencil track ring.
mod.widgets.SpinnerFlat.draw_bg.color = #x18140e
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 3.0
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.22

// Rules between groups: a line of pencil drawn by hand.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = self.rect_size.y * 0.5 + (Finish.noise(vec2(p.x * 0.04, 3.0)) - 0.5) * 0.8
    return cb_stroke(abs(p.y - y), 0.45, p, px, vec3(0.30, 0.24, 0.17), 0.6)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = self.rect_size.x * 0.5 + (Finish.noise(vec2(3.0, p.y * 0.04)) - 0.5) * 0.8
    return cb_stroke(abs(p.x - x), 0.45, p, px, vec3(0.30, 0.24, 0.17), 0.6)
}

// ---------------------------------------------------------------------------
// WORDS IN MARKER. Every word is drawn in felt marker, and the felt bleeds a
// little into the board's fibres: the glyph's edge carries a soft ink that
// is the glyph read again a device pixel away on each diagonal. Pale ink
// (the cream paint pen on black card, the figures on a display) keeps its
// edge, so nothing pale grows a halo. Written once, handed to every label.
let cb_words = fn() {
    if self.texture_index > 0.5 && self.texture_index < 1.5 {
        return self.sample_text_pixel()
    }
    if self.texture_index > 2.5 {
        return self.sample_text_pixel()
    }
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    let e1 = dFdx(self.t.xy) + dFdy(self.t.xy)
    let e2 = dFdx(self.t.xy) - dFdy(self.t.xy)
    var a0 = 0.0
    var a1 = 0.0
    var a2 = 0.0
    var a3 = 0.0
    var a4 = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.sdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
        a1 = self.sdf(scale, clamp(self.t.xy + e1, self.t_min + ht, self.t_max - ht), c)
        a2 = self.sdf(scale, clamp(self.t.xy - e1, self.t_min + ht, self.t_max - ht), c)
        a3 = self.sdf(scale, clamp(self.t.xy + e2, self.t_min + ht, self.t_max - ht), c)
        a4 = self.sdf(scale, clamp(self.t.xy - e2, self.t_min + ht, self.t_max - ht), c)
    } else {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.msdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
        a1 = self.msdf(scale, clamp(self.t.xy + e1, self.t_min + ht, self.t_max - ht), c)
        a2 = self.msdf(scale, clamp(self.t.xy - e1, self.t_min + ht, self.t_max - ht), c)
        a3 = self.msdf(scale, clamp(self.t.xy + e2, self.t_min + ht, self.t_max - ht), c)
        a4 = self.msdf(scale, clamp(self.t.xy - e2, self.t_min + ht, self.t_max - ht), c)
    }
    let pale = step(0.45, dot(c.rgb, vec3(0.299, 0.587, 0.114)))
    let bleed = (a1 + a2 + a3 + a4) * 0.25 * 0.30 * (1.0 - pale)
    let a = clamp(a0 + bleed * (1.0 - a0), 0.0, 1.0) * c.a
    return vec4(c.rgb * a, a)
}
mod.widgets.Label.draw_text.pixel = cb_words
mod.widgets.H1.draw_text.pixel = cb_words
mod.widgets.H2.draw_text.pixel = cb_words
mod.widgets.H3.draw_text.pixel = cb_words
mod.widgets.H4.draw_text.pixel = cb_words
mod.widgets.H5.draw_text.pixel = cb_words
mod.widgets.H6.draw_text.pixel = cb_words
mod.widgets.ButtonFlat.draw_text.pixel = cb_words
mod.widgets.Button.draw_text.pixel = cb_words
mod.widgets.ButtonFlatter.draw_text.pixel = cb_words
mod.widgets.ButtonPrimary.draw_text.pixel = cb_words
mod.widgets.ButtonSecondary.draw_text.pixel = cb_words
mod.widgets.ButtonTertiary.draw_text.pixel = cb_words
mod.widgets.ButtonDanger.draw_text.pixel = cb_words
mod.widgets.ButtonOutline.draw_text.pixel = cb_words
mod.widgets.ButtonXs.draw_text.pixel = cb_words
