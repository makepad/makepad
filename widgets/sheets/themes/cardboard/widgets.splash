// ---------------------------------------------------------------------------
// THE BOARD under everything: the window's own ground, kraft over its whole
// face and calm under the content. The heavy detail is at the frame: the
// board's edges a little rubbed and darker, its cut edge showing along the
// window's foot with the flutes in it, and a strip of brown packing tape
// run along the top where the caption is, glossy, with the fine streaks of
// its stretched film and its long edges a little uneven.
let cb_packing_tape = fn(p: vec2, sz: vec2, px: float) -> vec4 {
    let top = 1.5 + (Finish.noise(vec2(p.x * 0.03, 1.0)) - 0.5) * 0.8
    let bot = 27.0 + (Finish.noise(vec2(p.x * 0.025, 7.0)) - 0.5) * 1.2
    let d = max(top - p.y, p.y - bot)
    let a = Finish.cover(d, px)
    let v = clamp((p.y - top) / max(bot - top, 1.0), 0.0, 1.0)
    let streak = (Finish.noise(vec2(p.x * 0.012, p.y * 2.2)) - 0.5) * 0.10 + (Finish.noise(vec2(p.x * 0.004, p.y * 0.7 + 4.0)) - 0.5) * 0.08
    var col = vec3(0.560, 0.365, 0.170) * (1.0 + streak)
    let sheen = smoothstep(0.08, 0.3, v) * (1.0 - smoothstep(0.32, 0.55, v)) * (0.6 + 0.4 * Finish.noise(vec2(p.x * 0.01, 3.0)))
    col = mix(col, vec3(0.98, 0.90, 0.76), sheen * 0.22)
    col = mix(col, col * 0.75, Finish.band(d, 0.0, 1.5 * px, px))
    let ta = a * 0.62
    var out = vec4(col * ta, ta)
    let sh = Finish.ring_out(d, 0.0, 1.0, px) * step(bot - 2.0, p.y) * 0.18
    return Finish.over(vec4(cb_shade_c() * sh, sh), out)
}
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    var col = cb_kraft(p, px, cb_kraft_c(), 1.0)
    let e = min(min(p.x, sz.x - p.x), sz.y - p.y)
    let rub = (1.0 - smoothstep(0.0, 22.0, e)) * (0.6 + 0.4 * Finish.noise(p * 0.05))
    col = col * (1.0 - 0.13 * rub)
    let th = 4.0
    let fb = sz.y - p.y
    col = mix(col, cb_flute(p.x, clamp(1.0 - fb / th, 0.0, 1.0), th, px, cb_kraft_c()), 1.0 - step(th, fb))
    let fs = min(p.x, sz.x - p.x)
    col = mix(col, col * 0.62, (1.0 - smoothstep(0.0, 1.6, fs)) * 0.5)
    let tape = cb_packing_tape(p, sz, px)
    col = col * (1.0 - tape.a) + tape.rgb
    let mt = cb_tape(p, vec2(sz.x - 20.0, sz.y - 22.0), -0.80, 30.0, 8.5, px, 7.0)
    col = col * (1.0 - mt.a) + mt.rgb
    return vec4(col, 1.0)
}

// A splitter is a seam between two panes: the board shows through its
// strip, and down its middle a faint line of pencil; under the hand, held or
// focused, the line is gone over in marker along the grip's length.
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let v = self.is_vertical
    let across = mix(p.y, p.x, v)
    let along = mix(p.x, p.y, v)
    let thick = mix(self.rect_size.y, self.rect_size.x, v)
    let span = mix(self.rect_size.x, self.rect_size.y, v)
    let m = thick * 0.5 + (Finish.noise(vec2(along * 0.03, 2.0)) - 0.5) * 0.6
    var out = cb_stroke(abs(across - m), 0.35, p, px, vec3(0.30, 0.24, 0.17), 0.35)
    let act = max(max(self.hover, self.drag), self.focus)
    let inbar = 1.0 - smoothstep(self.bar_size * 0.5 - 2.0, self.bar_size * 0.5, abs(along - span * 0.5))
    return Finish.over(out, cb_stroke(abs(across - m), 0.7, p, px, cb_ink_c(), act * inbar))
}

// ---------------------------------------------------------------- switches and meter

// THE SWITCHES are the sheet's own toggle, in proportion with the labels
// and the controls beside them: the rocker and the slide switch take the
// toggle's face (the disc in its slot, black card under it when on), its
// size and shape, its quad and its label gap; the rocker's disc is faced
// with yellow paper and the slide's with blue, so the two kinds tell apart.
mod.widgets.ToggleRocker.label_walk.margin = mod.turtle.Inset{left: 47.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleSlide.label_walk.margin = mod.turtle.Inset{left: 47.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleRocker.draw_bg.size = 18.0
mod.widgets.ToggleSlide.draw_bg.size = 18.0
mod.widgets.ToggleRocker.min_height = 26.0
mod.widgets.ToggleSlide.min_height = 26.0
mod.widgets.ToggleRocker.draw_bg.pill_aspect = 2.111
mod.widgets.ToggleSlide.draw_bg.pill_aspect = 2.111
mod.widgets.ToggleRocker.draw_bg.knob_inset = 9.0
mod.widgets.ToggleSlide.draw_bg.knob_inset = 9.0
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 9.0)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cb_toggle(self.pos, self.rect_size, self.rect_pos, px, self.active, self.drag_pos, self.drag, self.hover, self.down, self.focus, self.disabled, self.error, self.mark_at_end, 2.0)
}

// The readouts and the screen: the instrument window round black card.
mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let b = 3.0
    var face = cb_screen_face(p, px, self.color.rgb)
    if self.scan > 0.0 {
        face = face * Finish.scan(p.y - lo.y, px, 3.0 * px, self.scan)
    }
    return cb_window(p, lo, hi, 2.0, b, px, face, max(self.recess, 2.5))
}
mod.widgets.ScreenView.bezel = 3.0
mod.widgets.ScreenView.sheen = 0.0

// THE METER sits in the same window as the readouts and the screen, on the
// same black card: the scale painted in the display's yellow, the red zone
// in red paint, the needle a cream paint line and its pivot a yellow dot.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(2.0)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#xf1e6cf)
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#xe0533e)
mod.widgets.NeedleMeter.draw_bg.color_scale = uniform(#xf2c94e)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let b = 3.0
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    var face = cb_screen_face(p, px, cb_black_c())
    // The scale: a painted arc and a tick at every division.
    let arc = Finish.cover(abs(r - rr) - px * 0.75, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.6, 1.1, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    face = mix(face, self.color_scale.rgb, max(arc, tick) * 0.92)
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        face = mix(face, self.color_zone.rgb, zone_t * zone_r)
    }
    // The needle, from under the pivot to just past the scale.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - px * 0.9, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along - max(self.pivot_size - px, 0.0), px)
    face = mix(face, self.color_needle.rgb, needle)
    let pd = r - self.pivot_size
    face = mix(face, self.color_scale.rgb, Finish.cover(pd, px))
    face = mix(face, face * 0.5, Finish.band(pd, 0.0, px, px))
    return cb_window(p, lo, hi, self.border_radius, b, px, face, 2.5) * self.color.a * self.opacity
}
mod.widgets.NeedleMeter.draw_label.color = #xf2c94e

// ---------------------------------------------------------------- lamps
// The Lamp widget and the bar lamp. A round lamp's halo has its room in the
// lamp's own box (the library reserves a lens thickness either side once a
// halo is asked for), so the light is never cut at its edge and stays in
// its cell. A bar is a short light pipe: six points thick and a little over
// twice that long, set at the left of its cell three points in, its glow
// held to two and a half points round its hole -- so the whole lamp takes
// the first twenty points of its cell and leaves the rest free.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_accent = uniform(#xff9a2a)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    let tb = min(t, 6.0)
    let lb = tb * 2.1
    let c = mix(self.rect_size * 0.5, vec2(3.5 + lb * 0.5, self.rect_size.y * 0.5), self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(lb * 0.5, tb * 0.5), self.bar)
    let glow = mix(max(room - 0.5, 2.0), 2.5, self.bar)
    let res = cb_led(p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, glow)
    return res * self.opacity
}

// ---------------------------------------------------------------- tree rows
// The rows of a tree are strips of cream paper glued on the board one under
// another, every other one a shade warmer; the chosen row a strip of yellow
// paper.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = vec2(self.rect_size.x * 0.5 - 1.0, self.rect_size.y * 0.5)
    let c = self.rect_size * 0.5
    let d = cb_rbox(p, c, h, 0.5) + cb_wob(p, 0.2, vec2(self.is_even * 7.0, 3.0))
    let base = mix(mix(self.color_1.rgb, self.color_2.rgb, self.is_even), cb_yellow_c(), self.active)
    var face = cb_paper(p + vec2(self.is_even * 37.0, 11.0), px, base, 1.0)
    let ry = self.rect_size.y - 0.8 + (Finish.noise(vec2(p.x * 0.05, self.is_even * 3.0)) - 0.5) * 0.5
    face = mix(face, face * 0.78, Finish.cover(abs(p.y - ry) - 0.3, px) * 0.7)
    let a = Finish.cover(d, px)
    return vec4(face * a, a)
}
true
