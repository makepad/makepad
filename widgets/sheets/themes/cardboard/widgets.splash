use mod.prelude.widgets_internal.*

// Kraft corrugated board, hand made, lit from straight above. A control is
// a PIECE of board cut out and laid back in the window it was cut from
// (button, segment, drop-down: a dark gap round it with the flutes of the
// cut wall showing, a pale line where each cut liner catches the light), a
// piece GLUED ON (knob, thumb, panel, card: its thin shadow and its cut edge
// along its foot, the fluted layer between the two liners seen side on), or
// a line of black felt MARKER drawn on the board (box, ring, track, scale,
// tick), its width wandering as a hand does and its ink bleeding a little
// into the fibres. What is chosen is black card or a marker fill; coloured
// paper (blue, red, yellow) and cream paper are glued on where a role needs
// a colour. Focus is a blue ballpoint line drawn round the control.

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own, so the box metrics are stated once here
// and handed to each field below. A field is a piece of card as a button
// is, its face the box and its cut edge under it, so the box is 32, the
// height of a button.
let field_height = 32.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 3.0
// A hairline, for the few stock fields the faces below do not redraw.
let field_border = 0.6

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: the
// height is all these take; a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #b08659

// Plain views stop clipping, so a shadow, a cut edge or a marker's bleed may
// fall into the gap beside its control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. Every texture is laid in the piece's own space (a
// point from its corner, seeded by its size), so it rides with the piece and
// nothing changes when a page scrolls.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let cb_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let cb_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    let r = clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(r, r)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's radius.
let cb_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let cb_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

let cb_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

let cb_tri = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    // a triangle hw wide either side, 2 hh tall, apex up (dir -1) or down (1)
    let y = (p.y - c.y) * dir
    let e = (abs(p.x - c.x) * 2.0 * hh + hw * (y - hh)) / sqrt(4.0 * hh * hh + hw * hw)
    return max(-hh - y, e)
}

// THE PALETTE. The board's kraft #b08659; the marker #x18140e; shade is the
// board's own brown gone dark, never grey.
let cb_kraft_c = fn() -> vec3 {
    return vec3(0.690, 0.525, 0.349)
}
let cb_ink_c = fn() -> vec3 {
    return vec3(0.094, 0.078, 0.055)
}
let cb_dry_c = fn() -> vec3 {
    return vec3(0.431, 0.353, 0.267)
}
let cb_shade_c = fn() -> vec3 {
    return vec3(0.170, 0.105, 0.050)
}
let cb_liner_c = fn() -> vec3 {
    return vec3(0.925, 0.835, 0.680)
}
let cb_cream_c = fn() -> vec3 {
    return vec3(0.925, 0.878, 0.780)
}
let cb_black_c = fn() -> vec3 {
    return vec3(0.165, 0.153, 0.141)
}
let cb_yellow_c = fn() -> vec3 {
    return vec3(0.886, 0.722, 0.290)
}
let cb_blue_c = fn() -> vec3 {
    return vec3(0.478, 0.608, 0.733)
}
let cb_red_c = fn() -> vec3 {
    return vec3(0.808, 0.451, 0.380)
}
let cb_pen_c = fn() -> vec3 {
    return vec3(0.184, 0.373, 0.620)
}
let cb_redink_c = fn() -> vec3 {
    return vec3(0.690, 0.165, 0.125)
}

// THE FIBRES. One lattice of short straight fibres, at most one to a cell,
// each at its own angle and a length between `l0` and `l1` cells; a point
// looks at the four cells round it so a fibre is never cut at its cell's
// edge. `.x` the dark fibres, `.y` the pale ones (six in ten), as coverage.
let cb_fibres = fn(w: vec2, px: float, cell: float, seed: vec2, dens: float, thick: float, l0: float, l1: float) -> vec2 {
    let q = w / cell
    let g = floor(q)
    let f = q - g
    let o = vec2(step(0.5, f.x), step(0.5, f.y)) - vec2(1.0, 1.0)
    var dk = 0.0
    var lt = 0.0
    var i = 0.0
    for j in 0..4 {
        let k = g + o + vec2(i - 2.0 * floor(i * 0.5), floor(i * 0.5))
        let h0 = Finish.hash(k + seed)
        let h1 = Finish.hash(k + seed + vec2(17.31, 41.73))
        let h2 = Finish.hash(k + seed + vec2(-9.17, 23.41))
        let h3 = Finish.hash(k + seed + vec2(5.53, -3.37))
        let ctr = (k + vec2(h1, h2)) * cell
        let an = h3 * 3.14159265
        let hl = cell * (l0 + (l1 - l0) * fract(h0 * 7.13))
        let dir = vec2(cos(an), sin(an)) * hl
        let dd = cb_seg(w, ctr - dir, ctr + dir) - thick
        let cov = Finish.cover(dd, px) * step(h0, dens)
        let pale = step(0.4, fract(h1 * 13.7 + h2 * 3.1))
        dk = max(dk, cov * (1.0 - pale))
        lt = max(lt, cov * pale)
        i = i + 1.0
    }
    return vec2(dk, lt)
}

// KRAFT at point `w` over `base`: a long drift of tone, a faint cloud
// (small, so it never reads as blotches), a mottle at two fine scales, a
// free grain per device pixel, and the felt of its fibres: short ones packed
// close (a point and a half to a cell) and longer ones among them, the pale
// ones more than the dark, both low in contrast, so the board reads as a
// fine crinkled speckle rather than as hairs on a smooth ground. `amt`
// scales the whole texture.
let cb_kraft = fn(w: vec2, px: float, base: vec3, amt: float) -> vec3 {
    let broad = Finish.noise(w * 0.006 + vec2(3.1, 1.7)) - 0.5
    let cloud = Finish.fbm(w * 0.07 + vec2(13.1, 7.7)) - 0.5
    let m1 = Finish.noise(w * 0.8 + vec2(5.3, 2.9)) - 0.5
    let m2 = Finish.noise(w * 0.3 + vec2(1.3, 8.9)) - 0.5
    let tone = (broad * 0.06 + cloud * 0.04 + m1 * 0.06 + m2 * 0.07) * amt + Finish.grain(w / px, 0.016 * amt)
    var col = base * (1.0 + tone)
    let fa = cb_fibres(w, px, 1.8, vec2(0.0, 0.0), 0.7, 0.22, 0.3, 1.0)
    let fb = cb_fibres(w, px, 4.0, vec2(71.0, 23.0), 0.6, 0.28, 0.3, 1.0)
    let dk = max(fa.x, fb.x * 0.8)
    let lt = max(fa.y, fb.y * 0.8)
    col = col * (1.0 - 0.11 * dk * amt)
    col = col + (vec3(1.0, 1.0, 1.0) - col) * (0.17 * lt * amt)
    return col
}

// PAPER, cream or coloured: finer and calmer than the board.
let cb_paper = fn(w: vec2, px: float, base: vec3, amt: float) -> vec3 {
    let cloud = Finish.fbm(w * 0.09 + vec2(2.3, 9.1)) - 0.5
    let fine = Finish.noise(w * 0.9 + vec2(1.1, 4.4)) - 0.5
    var col = base * (1.0 + (cloud * 0.05 + fine * 0.04) * amt + Finish.grain(w / px, 0.016 * amt))
    let fa = cb_fibres(w, px, 3.0, vec2(13.0, 57.0), 0.5, 0.16, 0.3, 1.0)
    col = mix(col, base * 0.88, fa.x * 0.40 * amt)
    col = mix(col, Finish.lift(base, 0.35), fa.y * 0.45 * amt)
    return col
}

// BLACK CARD: near black, a little cloud, and the pale scuffs of its fibres.
let cb_blackcard = fn(w: vec2, px: float, amt: float) -> vec3 {
    let base = cb_black_c()
    let cloud = Finish.fbm(w * 0.08 + vec2(7.0, 3.0)) - 0.5
    var col = base * (1.0 + cloud * 0.30 * amt) + g3(Finish.grain(w / px, 0.010 * amt))
    let fa = cb_fibres(w, px, 2.6, vec2(37.0, 11.0), 0.6, 0.18, 0.3, 1.0)
    col = mix(col, vec3(0.40, 0.37, 0.34), fa.y * 0.40 * amt)
    col = mix(col, vec3(0.07, 0.065, 0.06), fa.x * 0.40 * amt)
    return col
}

// THE CUT EDGE of the board seen side on: `u` along the edge, `v` 0..1 from
// the face down to the foot of `th` points of board. The two liners as
// bands, the fluted layer between them a wave over dark hollows; the edge
// faces down, away from the light, so all of it is in shade.
let cb_flute = fn(u: float, v: float, th: float, px: float, base: vec3) -> vec3 {
    let liner = 0.2
    let pitch = max(th * 1.2, 2.4)
    let amp = 0.24
    let ph = u / pitch * 6.2831853
    let wy = 0.5 + amp * sin(ph)
    let sl = amp * th * 6.2831853 / pitch * cos(ph)
    let dist = abs(v - wy) * th / sqrt(1.0 + sl * sl)
    let medium = Finish.cover(dist - max(th * 0.08, px * 0.45), px)
    var col = mix(base * 0.24, base * 0.68, medium)
    let top = 1.0 - smoothstep(liner - 0.06, liner + 0.06, v)
    let bot = smoothstep(1.0 - liner - 0.06, 1.0 - liner + 0.06, v)
    col = mix(col, base * 0.80, top)
    col = mix(col, base * 0.48, bot)
    return col
}

// What a piece glued on the board shows beyond its face: the shadow it
// throws (a tight contact shade and a soft one, cast a little down, both
// gone within half a gap) and its cut edge along its foot, `th` points of
// board seen side on. `lift` 0..1 raises it (a softer, longer shadow).
// Premultiplied; the face goes over it.
let cb_under = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, th: float, base: vec3, lift: float) -> vec4 {
    let cs = c + vec2(0.0, th)
    let s1 = Finish.drop(p, cs, h, r, vec2(0.0, 0.4 + 0.5 * lift), 0.45 + 0.4 * lift) * 0.50
    let s2 = Finish.drop(p, cs, h, r, vec2(0.0, 0.8 + 1.0 * lift), 1.1 + 0.8 * lift) * 0.22
    let sa = 1.0 - (1.0 - s1) * (1.0 - s2)
    var out = vec4(cb_shade_c() * sa, sa)
    if th > 0.01 {
        let df = cb_rbox(p, c, h, r)
        let ds = cb_rbox(p, c + vec2(0.0, th * 0.5), h + vec2(0.0, th * 0.5), r)
        let v = clamp(df / th, 0.0, 1.0)
        let side = cb_flute(p.x, v, th, px, base)
        let a2 = Finish.cover(ds, px)
        out = Finish.over(out, vec4(side * a2, a2))
    }
    return out
}

// The face's own cut edge: a pale line where the top liner was cut,
// brightest along the top, and the kraft a shade darker just inside it where
// the knife pressed it down.
let cb_cut_edge = fn(col: vec3, d: float, yrel: float, hy: float, px: float, amt: float) -> vec3 {
    let up = 1.0 - smoothstep(0.0 - hy, hy, yrel)
    var c2 = mix(col, col * 0.84, Finish.band(d, 1.2 * px, 2.6 * px, px) * 0.55 * amt)
    c2 = mix(c2, mix(Finish.lift(col, 0.40), cb_liner_c(), 0.5), Finish.band(d, 0.0, 1.2 * px, px) * (0.30 + 0.60 * up) * amt)
    return c2
}

// The window a piece was cut from, round the piece: the gap between them `g`
// points wide, dark, the flutes of the window's wall showing in it as pale
// flecks and the gap deepest under the window's top wall; and outside it a
// pale line where the window's own liner was cut, brightest along its foot,
// which faces up. `d` is the piece's distance. Premultiplied.
let cb_gap = fn(p: vec2, d: float, yrel: float, hy: float, g: float, px: float, amt: float) -> vec4 {
    let dw = d - g
    let ring = Finish.cover(dw, px) * (1.0 - Finish.cover(d, px))
    let up = 1.0 - smoothstep(0.0 - hy, hy, yrel)
    let fl = smoothstep(0.52, 0.78, Finish.noise(p * 1.9 + vec2(3.0, 8.0)))
    var col = mix(vec3(0.120, 0.078, 0.040), vec3(0.50, 0.37, 0.23), fl * 0.8)
    col = col * (0.78 + 0.32 * (1.0 - up))
    let ra = ring * amt
    var out = vec4(col * ra, ra)
    let lip = Finish.ring_out(dw, 0.0, 1.2 * px, px) * (0.30 + 0.55 * (1.0 - up)) * amt
    out = Finish.over(out, vec4(cb_liner_c() * lip, lip))
    return out
}

// A LINE OF FELT MARKER `hw` points either side of its middle; `dl` is the
// unsigned distance from the middle. Its width wanders as a hand's does,
// its ink is a shade thinner in streaks, and it bleeds a little way into
// the fibres beside it (gone within a point and a half). Premultiplied.
let cb_stroke = fn(dl: float, hw: float, p: vec2, px: float, ink: vec3, amt: float) -> vec4 {
    let w = hw + clamp((Finish.noise(p * 0.22 + vec2(7.0, 3.0)) - 0.5) * 0.5 * hw, -0.2, 0.2)
    let body = Finish.cover(dl - w, px)
    let dens = 0.90 + 0.10 * Finish.noise(p * 1.3 + vec2(1.0, 9.0))
    let x = max(dl - w, 0.0)
    let bleed = exp(0.0 - x / 0.38) * (1.0 - smoothstep(1.0, 1.5, x)) * (1.0 - body) * 0.22 * (0.45 + Finish.noise(p * 3.1 + vec2(4.0, 4.0)))
    let a = clamp(body * dens + bleed, 0.0, 1.0) * amt
    return vec4(ink * a, a)
}

// A shape filled in with marker: `d` its signed distance.
let cb_fill = fn(d: float, p: vec2, px: float, ink: vec3, amt: float) -> vec4 {
    return cb_stroke(max(d + 0.5, 0.0), 0.5, p, px, ink, amt)
}

// A hand's wobble on a line, at most `k` points either way, slow along it.
let cb_wob = fn(p: vec2, k: float, seed: vec2) -> float {
    return (Finish.noise(p * 0.32 + seed) - 0.5) * 2.0 * k
}

// FOCUS: a blue ballpoint line drawn round the control, two and a half
// points out.
let cb_focus = fn(d: float, p: vec2, px: float, focus: float) -> vec4 {
    let dd = d - 2.6 + cb_wob(p, 0.35, vec2(11.0, 3.0))
    return cb_stroke(abs(dd), 0.42, p, px, cb_pen_c(), 0.9 * focus)
}

// The face of a piece: kind 0 the board, 1 black card, 2 blue paper, 4 red
// paper, 7 paper of `tint`, 8 cream paper, 9 yellow paper, 10 board of the
// colour `tint` (a paler slip).
let cb_face = fn(q: vec2, px: float, kind: float, tint: vec3) -> vec3 {
    if kind > 0.5 && kind < 1.5 {
        return cb_blackcard(q, px, 1.0)
    }
    if kind > 1.5 && kind < 2.5 {
        return cb_paper(q, px, cb_blue_c(), 1.0)
    }
    if kind > 3.5 && kind < 4.5 {
        return cb_paper(q, px, cb_red_c(), 1.0)
    }
    if kind > 6.5 && kind < 7.5 {
        return cb_paper(q, px, tint, 1.0)
    }
    if kind > 7.5 && kind < 8.5 {
        return cb_paper(q, px, cb_cream_c(), 1.0)
    }
    if kind > 8.5 && kind < 9.5 {
        return cb_paper(q, px, cb_yellow_c(), 1.0)
    }
    if kind > 9.5 {
        return cb_kraft(q, px, tint, 0.85)
    }
    return cb_kraft(q, px, Finish.lift(cb_kraft_c(), 0.03), 1.0)
}

// A disc of board riding on what is under it: its shadow, its cut edge
// along its foot (`th` points), a face a shade lighter at the top (the
// board's kraft, or paper of a colour glued on it: `kind` as for a piece),
// the pale cut line round its top and a line of shade round its foot.
// Pressed it sits down on its edge. Premultiplied.
let cb_disc_k = fn(p: vec2, c: vec2, r: float, px: float, th: float, hover: float, press: float, dis: float, kind: float) -> vec4 {
    let live = 1.0 - dis
    let ft = th * (1.0 - 0.45 * press)
    let fc = c - vec2(0.0, ft * 0.5)
    var out = cb_under(p, fc, vec2(r, r), r, px, ft, cb_kraft_c(), clamp(0.35 + 0.5 * hover * live - 0.35 * press, 0.0, 1.0))
    out = out * mix(1.0, 0.55, dis)
    let d = length(p - fc) - r
    let q = (p - fc) / max(r, 0.5)
    var face = cb_kraft(p - fc + vec2(31.0, 7.0), px, Finish.lift(cb_kraft_c(), 0.07), 1.0)
    if kind > 0.5 {
        face = cb_face(p - fc + vec2(31.0, 7.0), px, kind, vec3(0.0, 0.0, 0.0))
    }
    face = face * (1.05 - 0.12 * smoothstep(-1.0, 1.0, q.y))
    face = Finish.lift(face, 0.16 * hover * live)
    face = face * (1.0 - 0.07 * press)
    face = mix(face, vec3(0.70, 0.64, 0.57), dis * 0.55)
    face = cb_cut_edge(face, d, p.y - fc.y, r, px, 1.0 + 0.5 * hover * live)
    face = mix(face, face * 0.55, Finish.band(d, 0.0, px, px) * smoothstep(-0.2, 0.8, q.y))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}
let cb_disc = fn(p: vec2, c: vec2, r: float, px: float, th: float, hover: float, press: float, dis: float) -> vec4 {
    return cb_disc_k(p, c, r, px, th, hover, press, dis, 0.0)
}

// ---------------------------------------------------------------------------
// A PIECE OF CARD GLUED ON THE BOARD, the way every working control is
// made: its face the box `c`, `h` (corners `r4`); under its foot the board's
// cut edge `th` points deep, seen side on, the fluted layer between its two
// liners; under it all a soft contact shadow, gone within four points of the
// box (half the gap to a neighbour); the pale line where the face's liner
// was cut; and a line of marker drawn round the face just inside its edge
// (`ol` its strength). Under the pointer the piece stands a little prouder,
// its shadow longer and its face a shade lighter; pressed it is pushed down
// onto the board, its face slipping down into the depth of its edge and its
// shadow drawn in close. Disabled it lies under a sheet of tracing paper.
// `kind` and `tint` pick the face as `cb_face` does. Premultiplied.
let cb_piece = fn(p: vec2, c: vec2, h: vec2, r4: vec4, px: float, th: float, hover: float, press: float, dis: float, kind: float, tint: vec3, ol: float, seed: vec2) -> vec4 {
    let live = 1.0 - dis
    let lift = hover * live * (1.0 - press)
    let sink = th * 0.7 * press
    let fc = c + vec2(0.0, sink)
    let eth = th - sink
    let wob = cb_wob(p, 0.16, seed * 0.01)
    let d = cb_rbox4(p, fc, h, r4) + wob
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    // the shadow of the whole piece, face and edge together
    let pc = c + vec2(0.0, th * 0.5)
    let ph = h + vec2(0.0, th * 0.5)
    let s1 = Finish.drop(p, pc, ph, r, vec2(0.3, 0.5 + 0.3 * lift - 0.3 * press), 0.6 + 0.25 * lift) * 0.62
    let s2 = Finish.drop(p, pc, ph, r, vec2(0.6, 1.1 + 0.8 * lift - 0.7 * press), 1.3 + 0.5 * lift - 0.5 * press) * 0.42
    let db = cb_rbox(p, c, h, r)
    let fade = 1.0 - smoothstep(1.5, 4.0, db)
    let sa = (1.0 - (1.0 - s1) * (1.0 - s2)) * fade * mix(1.0, 0.5, dis)
    var out = vec4(cb_shade_c() * sa, sa)
    // the cut edge, side on
    if eth > 0.05 {
        let de = cb_rbox4(p, fc + vec2(0.0, eth * 0.5), h + vec2(0.0, eth * 0.5), r4) + wob
        var side = cb_flute(p.x + seed.x, clamp(d / eth, 0.0, 1.0), eth, px, cb_kraft_c())
        side = mix(side, vec3(0.62, 0.56, 0.49), dis * 0.6)
        let a2 = Finish.cover(de, px)
        out = Finish.over(out, vec4(side * a2, a2))
    }
    var face = cb_face(p + seed, px, kind, tint)
    face = face * (1.04 - 0.08 * smoothstep(0.0 - h.y, h.y, p.y - fc.y))
    face = mix(face, mix(vec3(0.68, 0.62, 0.55), Finish.lift(face, 0.30), 0.25), dis * 0.78)
    face = Finish.lift(face, 0.10 * lift)
    face = face * (1.0 - 0.10 * press)
    face = cb_cut_edge(face, d, p.y - fc.y, h.y, px, mix(1.0 + 0.4 * lift - 0.4 * press, 0.4, dis))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    let ink = mix(cb_ink_c(), cb_dry_c(), dis)
    let ow = 0.85 + 0.1 * clamp(h.y - 12.0, 0.0, 4.0) * 0.25
    out = Finish.over(out, cb_stroke(abs(d + 1.2 + ow), ow, p, px, ink, ol * a * mix(1.0, 0.55, dis)))
    return out
}

// BUTTONS. A piece of card glued on the board (`cb_piece`); `kind` picks the
// face: 0 the board, 1 black card (primary, no outline: the marker does not
// show on it), 2 blue paper (secondary), 4 red paper (danger), 7 paper of
// `tint`; 5 a frame drawn in marker straight on the board (outline), 6 bare
// until touched (flatter). The quad grows by `m` for the cut edge, the
// shadow and the focus line.
let cb_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, r4: vec4, kind: float, m: float, tint: vec4, row: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let seed = size * vec2(1.37, 2.71)
    let d = cb_rbox4(p, c, h, r4) + cb_wob(p, 0.16, seed * 0.01)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if kind < 4.5 || kind > 6.5 {
        let th = clamp(h.y * 0.21, 2.0, 3.4)
        let ol = 1.0 - step(0.5, kind) * step(kind, 1.5)
        out = cb_piece(p, c, h, r4, px, th, hover, press, dis, kind, tint.rgb, ol, seed)
    } else {
        let bare = step(5.5, kind)
        let show = clamp(hover * live + press, 0.0, 1.0)
        let wash = Finish.cover(d, px) * (0.05 * hover * live + 0.12 * press)
        out = vec4(cb_shade_c() * wash, wash)
        let hw = 1.0 + 0.15 * hover * live
        let pencil = mix(vec3(0.30, 0.24, 0.17), cb_ink_c(), press)
        let ink = mix(mix(cb_ink_c(), pencil, bare), cb_dry_c(), dis)
        let amt = mix(1.0, 0.55 * show, bare) * mix(1.0, 0.6, dis)
        out = Finish.over(out, cb_stroke(abs(d + hw + 0.3), hw * mix(1.0, 0.55, bare), p, px, ink, amt))
    }
    out = Finish.over(out, cb_focus(d, p, px, focus * live))
    // The wait spinner, which the stock face drew and this one must too.
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.4)
        sdf.fill(vec4(0.094, 0.078, 0.055, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

