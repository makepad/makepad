}
mod.widgets.RotaryFlat.text_input.min_height = 22.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.5, 0.5)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(0.5, 1.0)
    return cb_window(p, lo, hi, 2.0, 2.2, px, cb_screen_face(p, px, cb_black_c()), 2.0)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #xf2c94e
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #xf2c94e
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #xf6d470
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #a08a5a
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_bold{font_size: 9.5}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A slip of paler card glued on the board as a piece
// (`cb_piece`): its cut edge under its foot, its shadow, and the marker
// frame round its face. The quad grows for the edge and the shadow; the text
// is clipped to the face as before. Focused, a blue ballpoint line runs
// inside the marker; disabled, the marker has gone dry and the slip is the
// board under tracing paper. `p` is the point in the grown quad.
let cb_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let seed = size * vec2(0.61, 1.7)
    let tint = Finish.lift(cb_kraft_c(), 0.15 + 0.05 * hover)
    var out = cb_piece(p, c, h, vec4(r, r, r, r), px, 3.0, 0.0, 0.0, dis, 10.0, tint, 1.0 + 0.15 * focus, seed)
    let fd = cb_rbox(p, c, h, r) + 3.9 + cb_wob(p, 0.2, vec2(1.0, 21.0))
    return Finish.over(out, cb_stroke(abs(fd), 0.4, p, px, cb_pen_c(), 0.85 * focus))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let g = cb_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cb_field(p, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 3.0)
}
