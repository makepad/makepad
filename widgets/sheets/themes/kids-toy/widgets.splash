// ---------------------------------------------------------------- selection

// The quad of a small control grows by this much so its shadow and focus
// ring can fall outside the box.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(15.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(2.0)
mod.widgets.CheckBoxFlat.label_walk.margin.left = 15.0

// The check box: a square socket moulded into the board. Checked, a chunky
// white tick stands in it; mixed, a red plug fills it with a white dash.
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(kt_snap(x0, o.x, px), kt_snap(y0, o.y, px))
    let hi = vec2(kt_snap(x0 + sz, o.x, px), kt_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let r = 3.5
    let live = 1.0 - self.disabled
    var fl = mix(mix(vec3(0.075, 0.200, 0.490), vec3(0.11, 0.26, 0.57), self.hover * live), vec3(0.36, 0.42, 0.56), self.disabled)
    fl = fl * (1.0 - 0.3 * self.down * live)
    var res = kt_groove(p, lo, hi, r, px, fl)
    // Under the hand the socket's rim lights.
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    res = Finish.over(res, vec4(0.75, 0.86, 1.0, 1.0) * Finish.ring_out(d, 0.0, px * 1.5, px) * 0.5 * self.hover * live)
    // Mixed: a red plug pressed into the socket, a white dash on it.
    let plug = kt_block(p, lo + vec2(1.5, 1.5), hi - vec2(1.5, 1.0), 2.2, px, kt_col(0.0), 0.0, max(self.down, 0.0), self.disabled, 0.0, 0.0)
    res = mix(res, Finish.over(res, plug), self.mixed)
    let cy = c.y - 0.6
    let dd = kt_seg(p, vec2(c.x - 3.2, cy), vec2(c.x + 3.2, cy)) - 1.05
    res = Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * Finish.cover(dd, px) * self.mixed * (1.0 - 0.4 * self.disabled))
    // Checked: the tick, white plastic with its own small shadow.
    let on = self.active * (1.0 - self.mixed)
    let cm = c + vec2(0.0, 0.2)
    let dm = min(kt_seg(p, vec2(cm.x - 4.0, cm.y), vec2(cm.x - 1.2, cm.y + 2.9)), kt_seg(p, vec2(cm.x - 1.2, cm.y + 2.9), vec2(cm.x + 4.2, cm.y - 3.3))) - 1.1
    let ds = min(kt_seg(p - vec2(0.3, 0.9), vec2(cm.x - 4.0, cm.y), vec2(cm.x - 1.2, cm.y + 2.9)), kt_seg(p - vec2(0.3, 0.9), vec2(cm.x - 1.2, cm.y + 2.9), vec2(cm.x + 4.2, cm.y - 3.3))) - 1.1
    res = Finish.over(res, vec4(0.0, 0.02, 0.08, 1.0) * Finish.cover(ds, px * 2.0) * 0.5 * on)
    let tk = mix(vec3(1.0, 1.0, 1.0), vec3(0.72, 0.78, 0.88), self.disabled)
    res = Finish.over(res, vec4(tk, 1.0) * Finish.cover(dm, px) * on)
    // The error: the rim turns red.
    res = Finish.over(res, vec4(0.95, 0.25, 0.2, 1.0) * Finish.ring_out(d, 0.0, px * 2.0, px) * self.error)
    let fr = kt_focus(d - px * 0.5, px)
    return Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(fr, 0.0, 1.0) * self.focus * live)
}

// The toggle: a pill of clear plastic with a clear plastic block for a
// thumb. On, the pill is red jelly lit from inside and the block stands at
// its right end; off, the board shows through the clear plastic.
mod.widgets.ToggleFlat.draw_bg.size = uniform(18.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(1.89)
mod.widgets.ToggleFlat.label_walk.margin.left = 34.0
let kt_toggle = fn(p: vec2, lo: vec2, hi: vec2, o: vec2, px: float, kt: float, on: float, hover: float, down: float, disabled: float, focus: float, tint: vec3) -> vec4 {
    let th = hi.y - lo.y
    let tw = hi.x - lo.x
    let r = th * 0.5
    var res = kt_jelly(p, lo, hi, r, px, tint, 0.85 * on, disabled)
    // The thumb: a clear block the track's height less two points, rounded,
    // riding from end to end.
    let ks = th - 3.0
    let kx = kt_snap(lo.x + 1.5 + (tw - 3.0 - ks) * kt, o.x, px)
    let klo = vec2(kx, lo.y + 1.5)
    let khi = vec2(kx + ks, lo.y + 1.5 + ks)
    let kc = (klo + khi) * 0.5
    let kh = (khi - klo) * 0.5
    let kd = Material.sd_box(p, kc, kh, ks * 0.32)
    let ksh = Finish.drop(p, kc, kh, ks * 0.32, vec2(0.5, 1.4 * (1.0 - 0.6 * down)), 1.2) * 0.5 * (1.0 - Finish.cover(kd, px))
    res = Finish.over(res, vec4(kt_shade() * ksh, ksh))
    let thumb = kt_jelly(p, klo, khi, ks * 0.32, px, vec3(0.92, 0.95, 1.0), 0.55 + 0.1 * hover, disabled)
    res = Finish.over(res, thumb)
    // A glint on the thumb's upper left corner.
    let gq = p - (klo + vec2(ks * 0.3, ks * 0.26))
    let glint = exp(-dot(gq, gq) / max(0.06 * ks * ks, 0.2)) * 0.7 * (1.0 - 0.7 * disabled)
    res = Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * glint * Finish.cover(kd, px))
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, r)
    let fr = Finish.ring_out(d, px, px * 2.5, px) + Finish.glow(d - px * 2.5, 1.0) * 0.35 * (1.0 - Finish.cover(d, px))
    return Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(fr, 0.0, 1.0) * focus * (1.0 - disabled))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(kt_snap(x0, o.x, px), kt_snap(y0, o.y, px))
    let hi = vec2(kt_snap(x0 + tw, o.x, px), kt_snap(y0 + th, o.y, px))
    let kt = mix(self.active, self.drag_pos, self.drag)
    return kt_toggle(p, lo, hi, o, px, kt, self.active, self.hover, max(self.pressed, self.down), self.disabled, self.focus, kt_col(0.0))
}

// The radio: a ball of plastic sitting in a round socket. Not chosen it is
// white; chosen it is the toy red, pressed a little deeper into the socket.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(15.0)
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 15.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(y0, o.y, px))
    let hi = vec2(kt_snap(sz, o.x, px), kt_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let on = self.active
    let live = 1.0 - self.disabled
    var res = kt_groove(p, lo, hi, sz * 0.5, px, mix(vec3(0.075, 0.2, 0.49), vec3(0.36, 0.42, 0.56), self.disabled))
    let rad = sz * 0.5 - 1.6
    let col = mix(kt_col(9.0), kt_col(0.0), on)
    let pushed = max(self.down * live, on)
    res = kt_ball(res, p, c - vec2(0.0, 0.6 * (1.0 - pushed)), rad - 0.4 * self.down * live, px, col, self.hover, pushed, self.disabled, 0.55 - 0.4 * pushed)
    let d = length(p - c) - sz * 0.5
    let fr = kt_focus(d - px * 0.5, px)
    return Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(fr, 0.0, 1.0) * self.focus * live)
}

// The radio tab: an orange key; chosen, it is pressed into the board, a
// navy well with its word lit.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 8.0 top: 3.0 bottom: 5.0}
mod.widgets.RadioButtonTabFlat.min_height = 24.0
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(0.0, o.y, px))
    let hi = vec2(kt_snap(self.rect_size.x, o.x, px), kt_snap(self.rect_size.y, o.y, px))
    let r = clamp(0.24 * (hi.y - lo.y), 3.0, 6.0)
    let key = kt_block(p, lo, hi, r, px, kt_col(4.0), self.hover, self.down, self.disabled, self.focus, 1.0)
    let well = kt_sunk(p, lo, hi, r, px, self.hover)
    return mix(key, well, self.active)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #fff7ee
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #ffffff
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #9fd6ff
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #c9b8a8

// ---------------------------------------------------------------- sliders

// A slider is a channel moulded into the board with a coloured plastic rod
// lying in it up to the value, and a glossy ball riding it; past the value
// the channel's floor is the slider's colour at its deepest. Each kind has
// its colour: the slider green, the minimal one light blue, the round one
// orange, the band purple. Its value sits in a small navy window framed in
// the same colour.
let kt_slider = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, f0: float, f1: float, hx: vec2, px: float, rad: float, base: vec3, hover: float, held: float, disabled: float) -> vec4 {
    let th = hi.y - lo.y
    let fl = mix(kt_deep(kt_dull(base, disabled)) * 0.75, vec3(0.07, 0.19, 0.46), 0.5)
    var res = Finish.over(dst, kt_groove(p, lo, hi, th * 0.5, px, fl))
    let ins = 1.0
    if f1 - f0 > 0.01 {
        res = kt_rod(res, p, vec2(max(f0, lo.x + ins), lo.y + ins), vec2(min(f1, hi.x - ins), hi.y - ins), px, base, disabled)
    }
    if rad > 0.0 {
        res = kt_ball(res, p, hx, rad, px, base, hover, held, disabled, 1.0)
    }
    return res
}

// The value window of a slider kind: a navy window in a thick frame of the
// slider's colour; focused, the frame lightens.
let kt_valbox = fn(pos: vec2, size: vec2, o: vec2, dpi: float, rim: vec3, hover: float, focus: float, disabled: float) -> vec4 {
    let px = kt_px(dpi)
    let p = pos * size
    if size.x < 1.0 || size.y < 1.0 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(0.0, o.y, px))
    let hi = vec2(kt_snap(size.x - px * 0.49, o.x, px), kt_snap(size.y - px * 0.49, o.y, px))
    return kt_frame(p, lo, hi, 5.0, px, 2.5, rim, vec3(0.07, 0.18, 0.44), 1.0, hover, focus, disabled)
}

mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 9.5
    let cy = kt_snap(20.0 + (self.rect_size.y - 20.0) * 0.5, o.y, px)
    let lo = vec2(kt_snap(0.0, o.x, px), cy - 3.5)
    let hi = vec2(kt_snap(self.rect_size.x, o.x, px), cy + 3.5)
    let span = self.rect_size.x - rad * 2.0
    let hx = rad + self.slide_pos * span
    let ox = rad + self.origin_pos * span
    let f0 = mix(lo.x, min(ox, hx), self.arc_origin)
    let f1 = mix(hx, max(ox, hx), self.arc_origin)
    var res = kt_slider(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, f0, f1, vec2(hx, cy - 0.5), px, rad, kt_col(1.0), self.hover, self.drag, self.disabled)
    let d = length(p - vec2(hx, cy - 0.5)) - rad
    let fr = kt_focus(d, px)
    return Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(fr, 0.0, 1.0) * self.focus * (1.0 - self.disabled))
}

// The value field rides in the label row: padded into a small window.
