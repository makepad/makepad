// ---------------------------------------------------------------- field row

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own, so the box metrics are stated ONCE here
// and handed to each field below; a field added to the library later joins
// the row by being named here.
let field_height = 24.0
let field_pad_v = 3.0
let field_radius = 2.5
let field_border = 0.67

// The room a Fit field takes: a minimum height, and the padding with it.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v + 1.0
}
// The box a field draws, given the draw object.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: the
// height is all these take.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
mod.widgets.WellInput.min_height = 0.0
// The drop-down stands in the field row: the text box's padding, so the
// two are one height (sheet_checks::field_row).
mod.widgets.DropDown.padding.top = 3.0
mod.widgets.DropDown.padding.bottom = 4.0

// ---------------------------------------------------------------- rules

// A rule is a groove moulded into the board: a navy line over a pale one.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = kt_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let y0 = kt_snap(self.rect_size.y * 0.5 - px, self.rect_pos.y, px)
    let dark = step(y0, p.y) * step(p.y, y0 + px)
    let light = step(y0 + px, p.y) * step(p.y, y0 + px * 2.0)
    return vec4(0.04, 0.12, 0.32, 1.0) * dark * 0.8 + vec4(0.45, 0.62, 0.92, 1.0) * light * 0.6
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = kt_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x0 = kt_snap(self.rect_size.x * 0.5 - px, self.rect_pos.x, px)
    let dark = step(x0, p.x) * step(p.x, x0 + px)
    let light = step(x0 + px, p.x) * step(p.x, x0 + px * 2.0)
    return vec4(0.04, 0.12, 0.32, 1.0) * dark * 0.8 + vec4(0.45, 0.62, 0.92, 1.0) * light * 0.6
}

// ---------------------------------------------------------------- ground

// Plain views stop clipping so a shadow can fall past their edge; scroll
// views keep clipping their content.
mod.widgets.View.clip_x = false
// A splitter's strip is the board itself: nothing is drawn there at rest.
mod.widgets.Splitter.draw_bg.color_bg = uniform(#00000000)
mod.widgets.View.clip_y = false
mod.widgets.Window.pass.clear_color = #2763b9
// The window's own ground: the board. Round its edge the board's moulded
// rim -- a thick rounded lip lit along its upper and left edges and in
// shade along its lower and right, its corners rounded off over a dark
// gap -- so the detail stays at the frame and the floor under the content
// is calm. The board has been played with: a light scatter of scratches.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = kt_px(self.draw_pass.dpi_factor)
    let sz = self.rect_size
    let p = self.pos * sz
    let w = p + self.rect_pos
    var col = kt_board(w, sz, px)
    let c = sz * 0.5
    let h = sz * 0.5 - vec2(1.0, 1.0)
    let r = 20.0
    let d = Material.sd_box(p, c, h, r)
    let n = kt_box_n(p, c, h, r)
    let rim = 7.0
    let e = clamp(1.0 + d / rim, 0.0, 1.0)
    let facing = dot(n, vec2(-0.38, -0.92))
    col = col * (1.0 + 0.32 * facing * e * e)
    col = mix(col, vec3(1.0, 1.0, 1.0), smoothstep(0.35, 0.95, facing) * smoothstep(0.3, 0.75, e) * (1.0 - smoothstep(0.8, 1.0, e)) * 0.3)
    // The inner foot of the lip: a soft shade where the rim rises off the
    // floor.
    let foot = exp(-((d + rim) * (d + rim)) / 6.0) * 0.12
    col = col * (1.0 - foot)
    col = mix(col, vec3(0.02, 0.06, 0.16), Finish.band(d, 0.0, px * 1.5, px) * 0.8)
    // The wear: scratches lift the plastic toward a pale grey-white where
    // they scatter the light; a deeper gouge darkens at its core. Under the
    // content they stay faint, and a little stronger toward the frame.
    let sc = kt_scratches(w, px)
    let edge = 1.0 - smoothstep(0.0, 90.0, 0.0 - d)
    let amt = mix(0.25, 0.34, edge)
    col = mix(col, vec3(0.80, 0.86, 0.95), clamp(sc.x * amt, 0.0, 0.5))
    col = col * (1.0 - 0.3 * sc.y)
    // Past the rounded corners: the dark gap behind the board.
    col = mix(vec3(0.03, 0.07, 0.17), col, Finish.cover(d, px))
    return vec4(col, 1.0)
}

// ---------------------------------------------------------------- screens

// A SCREEN: navy glass in a thick yellow plastic frame, the readouts' and the
// meter's one housing; the glass shaded under its top edge, a quiet diagonal
// reflection over it. Its figures are the screen ink, a warm white.
mod.widgets.ScreenView.clip_x = false
mod.widgets.ScreenView.clip_y = false
mod.widgets.ScreenView.padding = mod.turtle.Inset{top: 9.0 right: 11.0 bottom: 9.0 left: 11.0}
mod.widgets.ScreenView.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let m = 6.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(0.0, o.y, px))
    let hi = vec2(kt_snap(self.rect_size.x, o.x, px), kt_snap(self.rect_size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let sh = Finish.drop(p, c, h - vec2(1.0, 0.0), 7.0, vec2(0.6, 2.2), 1.8) * 0.45
    var res = vec4(kt_shade() * sh, sh)
    var fill = self.color.rgb
    if self.scan > 0.0 {
        fill = fill * mix(1.0, Finish.scan(p.y, px, 3.0 * px, self.scan), 0.6)
    }
    res = Finish.over(res, kt_frame(p, lo, hi, 7.0, px, max(self.bezel, 3.0), kt_col(2.0), fill, 1.0, 0.0, 0.0, 0.0))
    return res * self.color.a
}
mod.widgets.ScreenView.sheen = 0.04
mod.widgets.ScreenView.draw_glass.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = kt_px(self.draw_pass.dpi_factor)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px)) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let b = max(self.bezel, 3.0) + px
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let fd = Material.sd_box(p, c, hf, 4.0)
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let a = clamp(self.sheen * band, 0.0, 1.0) * Finish.cover(fd + px, px)
    return vec4(vec3(0.85, 0.92, 1.0) * a, a)
}

// THE NEEDLE METER is a screen: the same yellow frame and navy glass, its
// scale printed on the glass in the screen ink, the red zone a red band
// along the arc, the needle red, its root under a red plastic ball.
mod.widgets.NeedleMeter.clip_x = false
mod.widgets.NeedleMeter.clip_y = false
mod.widgets.NeedleMeter.draw_bg.color_zone = uniform(#ff4a3a)
mod.widgets.NeedleMeter.draw_bg.color_needle = uniform(#ff4a3a)
mod.widgets.NeedleMeter.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let m = 6.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(0.0, o.y, px))
    let hi = vec2(kt_snap(self.rect_size.x, o.x, px), kt_snap(self.rect_size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let sh = Finish.drop(p, c, h - vec2(1.0, 0.0), 7.0, vec2(0.6, 2.2), 1.8) * 0.45
    var res = vec4(kt_shade() * sh, sh)
    var face = vec3(0.051, 0.129, 0.329)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    let ink = vec3(1.0, 0.953, 0.722)
    let arc = Finish.cover(abs(r - rr) - px * 0.75, px) * on_scale
    let nn = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * nn + 0.5)
    let ak = (k / nn - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.6, 1.1, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    face = mix(face, ink, max(arc, tick) * 0.9)
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 3.0), px)
        face = mix(face, self.color_zone.rgb, zone_t * zone_r)
    }
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let needle = Finish.cover(across - 0.7, px) * Finish.cover(along - (rr + 3.0), px) * Finish.cover(0.0 - along, px)
    face = mix(face, self.color_needle.rgb, needle)
    res = Finish.over(res, kt_frame(p, lo, hi, 7.0, px, 3.0, kt_col(2.0), face, 1.0, 0.0, 0.0, 0.0))
    // The pivot: a red plastic ball.
    res = kt_ball(res, p, pv, max(self.pivot_size, 3.0), px, kt_col(0.0), 0.0, 0.0, 0.0, 0.4)
    // The glass's quiet reflection.
    let hf = h - vec2(3.0, 3.0)
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    let ga = 0.04 * band * Finish.cover(Material.sd_box(p, c, hf, 4.0), px)
    res = Finish.over(res, vec4(vec3(0.85, 0.92, 1.0) * ga, ga))
    return res * self.color.a * self.opacity
}

// ---------------------------------------------------------------- switches

// THE SWITCHES are the toggle's clear plastic in their own colours: the
// rocker lights orange, the slide switch green.
mod.widgets.ToggleRocker.draw_bg.size = uniform(18.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(18.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(1.89)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(1.89)
mod.widgets.ToggleRocker.label_walk.margin.left = 34.0
mod.widgets.ToggleSlide.label_walk.margin.left = 34.0
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 5.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(kt_snap(x0, o.x, px), kt_snap(y0, o.y, px))
    let hi = vec2(kt_snap(x0 + tw, o.x, px), kt_snap(y0 + th, o.y, px))
    let kt = mix(self.active, self.drag_pos, self.drag)
    return kt_toggle(p, lo, hi, o, px, kt, self.active, self.hover, max(self.pressed, self.down), self.disabled, self.focus, kt_col(4.0))
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let m = 5.0
    let px = kt_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(kt_snap(x0, o.x, px), kt_snap(y0, o.y, px))
    let hi = vec2(kt_snap(x0 + tw, o.x, px), kt_snap(y0 + th, o.y, px))
    let kt = mix(self.active, self.drag_pos, self.drag)
    return kt_toggle(p, lo, hi, o, px, kt, self.active, self.hover, max(self.pressed, self.down), self.disabled, self.focus, kt_col(1.0))
}

// ---------------------------------------------------------------- states

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonTabFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonTabFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.ToggleFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ToggleFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}

// ---------------------------------------------------------------- lamps

// LAMPS: an LED as a toy has it, a glossy bead of coloured glass. At full
// current its middle burns toward white and its rim is its most saturated
// colour; at lower current the middle is no longer white, the colour deeper,
// the glow smaller; out, it is dark tinted glass, its colour barely there.
// Round it a bezel: a raised ring of white plastic lit from the upper left,
// or a socket cut into the board, its upper wall in shadow and a catch
// light on its lower rim. Over the bead one crisp highlight of a dome. Its
// light is added, never painted: a tight hot halo and a short bloom in its
// own hue, gone in about two radii.
let kt_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let kt_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let kt_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = kt_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c` (round when the
// two are equal), `lit` its current 0..1, `ink` its colour and `vivid` how
// far its chroma is raised, `ground` what shows through where nothing is
// drawn, `room` how far its light may reach, `bez` and `raised` its bezel
// (raised 0: a recess cut in what is under it; 1: a raised ring of `bez`;
// 2: the same ring polished metal). Premultiplied over `dst`.
let kt_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, bez: vec3, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.3 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = kt_led_lamp_full(ink)
    let hue = kt_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    // The lens's own frame: `q` in lens radii from its centre line, `t` its
    // distance out, `nrm` the way its outline faces.
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the bead and its bezel throw on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.22 * rt + 0.3), 0.32 * rt + px) * mix(0.18, 0.34, min(raised, 1.0)) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(ground * 0.4 * shd, shd))
    if L > 0.001 && pale > 0.001 {
        // The tint, on a pale ground only: its hue laid over, never darker.
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The bezel: raised, a ring of `bez` rounded over, lit from the upper
    // left; or a socket cut into what is under it, its upper wall in shadow
    // and a catch light on its lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    let metal = clamp(raised - 1.0, 0.0, 1.0)
    var rc = bez * (0.94 + mix(0.12, 0.55, metal) * facing)
    rc = mix(rc, min(bez + vec3(0.30, 0.30, 0.30), white), smoothstep(mix(0.35, 0.55, metal), 0.9, facing) * mix(0.6, 0.85, metal))
    rc = mix(rc, rc * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.0, 0.8, nrm.y) * 0.8)
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = min(mix(sc, rc, min(raised, 1.0)), white)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, gone in
    // about two radii, falling on the bezel too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = kt_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass. Its colour deepens toward
    // the top; light pools low inside, where it comes through the dome; lit,
    // its middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass on a dark ground, a grey bead on a pale one,
    // its colour barely there, the same dome, a catch light along its lower
    // rim.
    let offc = mix(mix(vec3(0.085, 0.09, 0.115), ground * 0.62, pale), b * 0.4, 0.12)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl * (1.0 - 0.5 * pale)
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    // One crisp highlight: a white oval across its upper third.
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    // Out, a faint seam where the dome meets its bezel; lit, none: the rim
    // is the colour.
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp: a glossy toy light bead set in a raised
// ring of white plastic on the board, with its own soft shadow. The halo's
// room is held in the lamp's own box (the library reserves a lens
// thickness either side once a halo is asked for), so the light is never
// cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.color_accent = uniform(#3aa8ff)
mod.widgets.Lamp.draw_bg.color_success = uniform(#3ee05a)
mod.widgets.Lamp.draw_bg.color_warning = uniform(#ffc21a)
mod.widgets.Lamp.draw_bg.color_error = uniform(#ff3a2a)
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    // The bead takes nearly half its box, the rest is room for its bezel
    // and light.
    let t = min(self.rect_size.y / (1.0 + 2.0 * reach) * 1.35, self.rect_size.y * 0.5)
    let room = (self.rect_size.y - t) * 0.5
    let c = self.rect_size * 0.5
    // A round lamp: the bead the lamp's size in the middle of its box. A
    // bar: a short light pipe three fifths of a bead thick and at most 11
    // points long, set from the start of its box with its light gone
    // within a point and a half, so in a row it never reaches toward what
    // stands after it.
    let tb = t * 0.6
    let blen = min(max(self.rect_size.x - 2.0 * room, tb), min(2.0 * tb, 11.0))
    let cb = vec2(1.5 + 0.9 + blen * 0.5, self.rect_size.y * 0.5)
    let cc = mix(c, cb, self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(blen * 0.5, tb * 0.5), self.bar)
    let reach_px = mix(max(room - 0.5, 2.0), 1.5, self.bar)
    let res = kt_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, cc, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.153, 0.388, 0.725), reach_px, vec3(0.93, 0.93, 0.91), 1.0)
    return res * self.opacity
}
mod.widgets.LampBar.draw_bg.color_accent = uniform(#3aa8ff)
mod.widgets.LampBar.draw_bg.color_success = uniform(#3ee05a)
mod.widgets.LampBar.draw_bg.color_warning = uniform(#ffc21a)
mod.widgets.LampBar.draw_bg.color_error = uniform(#ff3a2a)
true
