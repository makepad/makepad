mod.widgets.SegmentedControlFlat.draw_text_selected.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 2.5 {
        if self.slug_curve_count() < 0.5 {
            return vec4(0.0, 0.0, 0.0, 0.0)
        }
        let px_x = max(abs(dFdx(self.pos.x)) + abs(dFdy(self.pos.x)), 0.00001)
        let px_y = max(abs(dFdx(self.pos.y)) + abs(dFdy(self.pos.y)), 0.00001)
        let ex = dFdx(self.pos) * 1.5
        let ey = dFdy(self.pos) * 1.5
        var g = self.alpha_at(self.pos + ex, px_x, px_y)
        g = g + self.alpha_at(self.pos - ex, px_x, px_y)
        g = g + self.alpha_at(self.pos + ey, px_x, px_y)
        g = g + self.alpha_at(self.pos - ey, px_x, px_y)
        let lit = vec4(0.70, 0.88, 1.0, self.color.a)
        let cov = clamp(self.alpha_at(self.pos, px_x, px_y), 0.0, 1.0)
        let lm = vec4(lit.rgb * lit.a * cov, lit.a * cov)
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.6 * lit.a
        return lm + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - lm.a)
    }
    if self.texture_index < 0.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ex = dFdx(self.t.xy) * 1.5
        let ey = dFdy(self.t.xy) * 1.5
        let k = vec4(0.0, 0.0, 0.0, 1.0)
        var g = self.sdf(scale, clamp(self.t.xy + ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy - ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy + ey, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy - ey, self.t_min + half_texel, self.t_max - half_texel), k)
        let c = self.get_color()
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.5 * c.a
        return main + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - main.a)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ex = dFdx(self.t.xy) * 1.5
        let ey = dFdy(self.t.xy) * 1.5
        let k = vec4(0.0, 0.0, 0.0, 1.0)
        var g = self.msdf(scale, clamp(self.t.xy + ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy - ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy + ey, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy - ey, self.t_min + half_texel, self.t_max - half_texel), k)
        let c = self.get_color()
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.5 * c.a
        return main + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - main.a)
    }
    return main
}
mod.widgets.Tabs.draw_text.pixel = fn() {
    let nudge = vec2(0.0, 0.0)
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    if self.texture_index > 2.5 {
        if self.slug_curve_count() < 0.5 {
            return vec4(0.0, 0.0, 0.0, 0.0)
        }
        let dy = dFdy(self.pos)
        let sample = self.pos - vec2(0.0, 0.0)
        let px_x = max(abs(dFdx(self.pos.x)) + abs(dFdy(self.pos.x)), 0.00001)
        let px_y = max(abs(dFdx(self.pos.y)) + abs(dFdy(self.pos.y)), 0.00001)
        let grid = if self.aa_4x4 > 0.5 {4.0} else if self.aa_2x2 > 0.5 {2.0} else {1.0}
        let inv_grid = if self.aa_4x4 > 0.5 {0.25} else if self.aa_2x2 > 0.5 {0.5} else {1.0}
        var alpha_sum = 0.0
        var sample_index = 0.0
        loop {
            if sample_index >= grid * grid { break }
            let row = floor(sample_index * inv_grid)
            let col = sample_index - row * grid
            let offset = (vec2(col, row) + 0.5 - grid * 0.5) * inv_grid * vec2(px_x, px_y)
            alpha_sum = alpha_sum + self.alpha_at(sample + offset, px_x, px_y)
            sample_index = sample_index + 1.0
        }
        let alpha_base = clamp(alpha_sum * inv_grid * inv_grid, 0.0, 1.0)
        let darken = clamp(max(px_x, px_y) * self.stem_darken, 0.0, self.stem_darken_max)
        let edge_weight = clamp(1.0 - abs(alpha_base * 2.0 - 1.0), 0.0, 1.0)
        let alpha = clamp(alpha_base + darken * edge_weight, 0.0, 1.0)
        let c = self.get_color()
        let main = vec4(c.rgb * c.a * alpha, c.a * alpha)
        let s = clamp(self.alpha_at(sample - dy, px_x, px_y), 0.0, 1.0) * 0.55 * c.a
        return main + vec4(0.02, 0.05, 0.16, 1.0) * s * (1.0 - main.a)
    }
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let pm = clamp(self.t.xy - nudge, self.t_min + half_texel, self.t_max - half_texel)
        let main = self.sdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
        let ps = clamp(self.t.xy - nudge - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let s = self.sdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.55 * c.a
        return main + vec4(0.02, 0.05, 0.16, 1.0) * s * (1.0 - main.a)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let pm = clamp(self.t.xy - nudge, self.t_min + half_texel, self.t_max - half_texel)
        let main = self.msdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
        let ps = clamp(self.t.xy - nudge - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.55 * c.a
        return main + vec4(0.02, 0.05, 0.16, 1.0) * s * (1.0 - main.a)
    }
    return self.sample_text_pixel()
}
mod.widgets.Tabs.draw_text_active.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 2.5 {
        if self.slug_curve_count() < 0.5 {
            return vec4(0.0, 0.0, 0.0, 0.0)
        }
        let px_x = max(abs(dFdx(self.pos.x)) + abs(dFdy(self.pos.x)), 0.00001)
        let px_y = max(abs(dFdx(self.pos.y)) + abs(dFdy(self.pos.y)), 0.00001)
        let ex = dFdx(self.pos) * 1.5
        let ey = dFdy(self.pos) * 1.5
        var g = self.alpha_at(self.pos + ex, px_x, px_y)
        g = g + self.alpha_at(self.pos - ex, px_x, px_y)
        g = g + self.alpha_at(self.pos + ey, px_x, px_y)
        g = g + self.alpha_at(self.pos - ey, px_x, px_y)
        let lit = vec4(0.70, 0.88, 1.0, self.color.a)
        let cov = clamp(self.alpha_at(self.pos, px_x, px_y), 0.0, 1.0)
        let lm = vec4(lit.rgb * lit.a * cov, lit.a * cov)
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.6 * lit.a
        return lm + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - lm.a)
    }
    if self.texture_index < 0.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ex = dFdx(self.t.xy) * 1.5
        let ey = dFdy(self.t.xy) * 1.5
        let k = vec4(0.0, 0.0, 0.0, 1.0)
        var g = self.sdf(scale, clamp(self.t.xy + ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy - ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy + ey, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.sdf(scale, clamp(self.t.xy - ey, self.t_min + half_texel, self.t_max - half_texel), k)
        let c = self.get_color()
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.5 * c.a
        return main + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - main.a)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ex = dFdx(self.t.xy) * 1.5
        let ey = dFdy(self.t.xy) * 1.5
        let k = vec4(0.0, 0.0, 0.0, 1.0)
        var g = self.msdf(scale, clamp(self.t.xy + ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy - ex, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy + ey, self.t_min + half_texel, self.t_max - half_texel), k)
        g = g + self.msdf(scale, clamp(self.t.xy - ey, self.t_min + half_texel, self.t_max - half_texel), k)
        let c = self.get_color()
        let a = clamp(g * 0.25, 0.0, 1.0) * 0.5 * c.a
        return main + vec4(0.35 * a, 0.62 * a, 1.0 * a, a) * (1.0 - main.a)
    }
    return main
}
