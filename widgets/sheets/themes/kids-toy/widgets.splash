use mod.prelude.widgets_internal.*

// Kids toy. Every part is injection-moulded plastic on a royal-blue board:
// a key is a thick rounded moulding whose side wall shows under its top
// face, its shoulder deepening the colour where the plastic is thickest, a
// soft window reflection over its upper half and a crisp catch light along
// its top edge, and it throws a short soft shadow down onto the board.
// Every face is drawn in true points (one device pixel is `px`); shadows,
// walls and rings that fall outside a layout box are drawn in a quad grown
// in `vertex`, and no padding is spent on relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let kt_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space.
let kt_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let kt_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The toy box: one colour per kind of part. 0 red, 1 green, 2 yellow,
// 3 purple, 4 orange, 5 light blue, 6 magenta, 7 teal, 8 cyan, 9 white.
let kt_col = fn(k: float) -> vec3 {
    if k < 0.5 { return vec3(0.878, 0.204, 0.165) }
    if k < 1.5 { return vec3(0.278, 0.706, 0.263) }
    if k < 2.5 { return vec3(0.976, 0.812, 0.106) }
    if k < 3.5 { return vec3(0.580, 0.310, 0.780) }
    if k < 4.5 { return vec3(0.957, 0.537, 0.110) }
    if k < 5.5 { return vec3(0.200, 0.557, 0.937) }
    if k < 6.5 { return vec3(0.820, 0.243, 0.773) }
    if k < 7.5 { return vec3(0.090, 0.639, 0.627) }
    if k < 8.5 { return vec3(0.278, 0.776, 0.941) }
    return vec3(0.957, 0.949, 0.925)
}

// The colour deep in the plastic, where it is thickest: darker and more
// saturated, as light that has travelled through a coloured moulding is.
let kt_deep = fn(c: vec3) -> vec3 {
    return c * c * 0.9 + c * 0.08
}

// A part that cannot be used: its colour washed toward a grey board blue.
let kt_dull = fn(c: vec3, disabled: float) -> vec3 {
    let l = Finish.lum(c)
    let g = mix(c, vec3(l, l, l), 0.55 * disabled)
    return mix(g, vec3(0.42, 0.47, 0.64), 0.38 * disabled)
}

// The navy shadow every part throws on the board (unpremultiplied ink).
let kt_shade = fn() -> vec3 {
    return vec3(0.0, 0.03, 0.11)
}

// Signed grain, -1..1, one value per device pixel of window space `w`.
// Each pixel is first sent to a far cell picked by the hash of its own, so
// the hash's near-repeat every 97 pixels never lines up into a lattice.
let kt_grain = fn(w: vec2, px: float) -> float {
    let i = floor(w / px)
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j) - Finish.hash(j + vec2(17.13, 3.71))
}

// Which way the outline of a rounded box faces at `p`: a straight side's
// normal on the sides, an arc's on the corners.
let kt_box_n = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - (h - vec2(rr, rr))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// The board's moulded pebble grain: a height 0..1 at a point of window space
// in points. Three octaves of smooth noise about 1.3, 0.6 and 5 points
// across, the middle one turned, so no cell repeats and nothing lines up.
let kt_pebble = fn(q: vec2) -> float {
    let a = Finish.noise(q * 0.78)
    let b = Finish.noise(vec2(q.x * 1.55 + q.y * 0.42, q.y * 1.55 - q.x * 0.42) + vec2(17.3, 5.9))
    let c = Finish.noise(q * 0.19 + vec2(3.1, 11.7))
    return a * 0.5 + b * 0.3 + c * 0.2
}

// The board at window point `w` of a window `size` points big: royal blue,
// a broad soft light over the upper middle as a lamp over a play table
// gives it, the far corners and the foot a step darker, and the pebble
// grain catching that light from the upper left.
let kt_board = fn(w: vec2, size: vec2, px: float) -> vec3 {
    let u = w / max(size, vec2(1.0, 1.0))
    let dx = (u.x - 0.46) / 0.8
    let dy = (u.y - 0.30) / 0.9
    let lite = exp(-(dx * dx + dy * dy) * 1.5)
    var col = mix(vec3(0.106, 0.318, 0.643), vec3(0.165, 0.420, 0.765), lite)
    col = col * (1.0 - 0.08 * smoothstep(0.65, 1.0, u.y))
    let g = kt_pebble(w) - kt_pebble(w + vec2(-0.3, -0.42))
    col = col * (1.0 + 0.3 * g)
    return col + vec3(1.0, 1.0, 1.0) * kt_grain(w, px) * 0.003
}

// The board's wear: scratches in the plastic. Each cell `g` of a lattice
// `s` points wide holds at most one scratch (with chance `prob`): a thin
// line through a random point of its cell at a random angle, `lmin` to
// `lmax` long (never over two cells, so the cells round a point find every
// scratch that reaches it), barely bowed, tapering to nothing at both ends
// and catching the light unevenly along its length. Most are faint
// hairlines, a few brighter; with chance `gouge` one is cut deeper, a
// dark core with a pale lip either side. Returned: how much it lifts the
// plastic toward white in .x, how much it darkens it in .y.
let kt_scratch = fn(w: vec2, g: vec2, s: float, lmin: float, lmax: float, prob: float, gouge: float, seed: float, px: float) -> vec2 {
    let k = g + vec2(seed * 0.37, seed * 0.91)
    if Finish.hash(k * 1.31 + vec2(3.7, 9.1)) > prob {
        return vec2(0.0, 0.0)
    }
    let h1 = Finish.hash(k + vec2(17.13, 3.31))
    let h2 = Finish.hash(k + vec2(5.71, 41.93))
    let h3 = Finish.hash(k + vec2(29.37, 13.11))
    let h4 = Finish.hash(k + vec2(7.97, 61.73))
    let h5 = Finish.hash(k + vec2(83.19, 27.47))
    let h6 = Finish.hash(k + vec2(47.53, 71.29))
    let h7 = Finish.hash(k + vec2(61.07, 89.41))
    let c = (g + vec2(h1, h2)) * s
    let ang = h3 * PI
    let dir = vec2(cos(ang), sin(ang))
    let nrm = vec2(0.0 - dir.y, dir.x)
    let len = mix(lmin, lmax, h4 * h4)
    let q = w - (c - dir * len * 0.5)
    let along = dot(q, dir)
    let t = clamp(along / len, 0.0, 1.0)
    let bow = (h5 - 0.5) * len * 0.05
    let d = length(vec2(along - t * len, dot(q, nrm) - bow * 4.0 * t * (1.0 - t)))
    let taper = smoothstep(0.0, 0.22, t) * (1.0 - smoothstep(0.7, 1.0, t))
    let strength = 0.4 + 0.3 * h6 * h6 * h6
    let hw = px * (0.22 + 0.4 * h6) * taper
    // Along its length a scratch catches the light unevenly: it breaks up.
    let broken = 0.45 + 0.55 * Finish.noise(vec2(along * 0.16, h1 * 37.0))
    let line = Finish.cover(d - hw, px) * taper * strength * broken
    let deep = step(1.0 - gouge, h7)
    let core = Finish.cover(d - px * 0.45 * taper, px) * taper
    let lip = clamp(Finish.cover(d - px * 1.6 * taper, px) * taper - core, 0.0, 1.0)
    return mix(vec2(line, 0.0), vec2(lip * 0.5, core * 0.55), deep)
}

// Every scratch reaching window point `w`, at three scales: a few long ones
// crossing a large stretch of the board, more of middle length, and short
// nicks that gather into scuffed patches where a low noise says the board
// was handled most. The cells round `w` are searched; the strongest wins.
let kt_scratches = fn(w: vec2, px: float) -> vec2 {
    var res = vec2(0.0, 0.0)
    var i = 0.0
    loop {
        if i > 8.5 { break }
        let o = vec2(i - 3.0 * floor(i / 3.0) - 1.0, floor(i / 3.0) - 1.0)
        let g1 = floor(w / 230.0) + o
        res = max(res, kt_scratch(w, g1, 230.0, 120.0, 440.0, 0.62, 0.14, 1.0, px))
        let g2 = floor(w / 62.0) + o
        res = max(res, kt_scratch(w, g2, 62.0, 14.0, 115.0, 0.5, 0.03, 2.0, px))
        let g3 = floor(w / 22.0) + o
        let patch = smoothstep(0.55, 0.85, Finish.noise((g3 + vec2(0.5, 0.5)) * 22.0 * 0.0055 + vec2(11.3, 4.7)))
        res = max(res, kt_scratch(w, g3, 22.0, 3.0, 30.0, 0.1 + 0.5 * patch, 0.0, 3.0, px) * vec2(0.85, 0.0))
        i = i + 1.0
    }
    return res
}

// ---------------------------------------------------------------- materials

// A moulded plastic key standing on the board, premultiplied. `lo`..`hi` is
// its footprint; the top face stands on a side wall that shows along the
// bottom, about a seventh of the key's height (pressed, the face sinks over
// three quarters of it and the shadow under it all but goes). `lift` 1
// throws the full shadow, 0 seats the key on the board with the contact
// shadow only.
let kt_block = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, base: vec3, hover: float, down: float, disabled: float, focus: float, lift: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sz = min(min(hh, hi.x - lo.x), 40.0)
    let live = 1.0 - disabled
    let dn = clamp(down, 0.0, 1.0) * live
    let wall_full = clamp(0.14 * sz, 1.5, 4.5)
    let wall = wall_full * (1.0 - 0.75 * dn) * (1.0 - 0.45 * disabled)
    let d = Material.sd_box(p, c, h, r)
    // The shadow: a soft one falling down and a little right, and a tight
    // contact shadow along the foot.
    let reach = max(0.085 * sz, 1.0)
    let s1 = Finish.drop(p, c, h - vec2(0.05 * sz, 0.0), r, vec2(0.025 * sz, reach), reach * 0.85) * 0.45 * lift * (1.0 - 0.8 * dn)
    let s2 = Finish.drop(p, c, h, r, vec2(0.0, px + 0.02 * sz), px + 0.025 * sz) * 0.55
    let sh = (1.0 - (1.0 - s1) * (1.0 - s2)) * (1.0 - 0.6 * disabled)
    var res = vec4(kt_shade() * sh, sh)
    var b = kt_dull(base, disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.08 * hover * live
    b = b * (1.0 - 0.07 * dn)
    let deep = kt_deep(b)
    // The top face, lifted by the wall.
    let flo = vec2(lo.x, lo.y + wall_full - wall)
    let fhi = vec2(hi.x, hi.y - wall)
    let fc = (flo + fhi) * 0.5
    let fh = max((fhi - flo) * 0.5, vec2(0.5, 0.5))
    let df = Material.sd_box(p, fc, fh, r)
    let n = kt_box_n(p, fc, fh, r)
    // How far over the rounded shoulder: 0 on the flat, 1 at the edge.
    let bw = clamp(0.2 * sz, 1.6, 5.0)
    let s = clamp(1.0 + df / bw, 0.0, 1.0)
    let s2c = s * s
    let facing = dot(n, vec2(-0.38, -0.92))
    let t = clamp((p.y - flo.y) / max(fhi.y - flo.y, 1.0), 0.0, 1.0)
    var face = b * (1.05 - 0.09 * t)
    face = mix(face, deep, 0.38 * s2c)
    face = face * (1.0 + 0.30 * facing * s2c)
    let uv = clamp((p - flo) / max(fhi - flo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    let gloss = (1.0 - 0.8 * disabled) * (1.0 - 0.5 * dn)
    // The window seen in the gloss: a soft bright band over the upper half,
    // its lower edge curving up toward the ends.
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.sheen(uv, 0.04, 0.52, 0.35) * (1.0 - s * 0.7) * 0.32 * gloss)
    // Light that has come through the plastic gathers above the lower
    // shoulder, a breath brighter and richer.
    face = face + b * 0.12 * smoothstep(0.55, 0.95, t) * (1.0 - s) * (1.0 - disabled)
    let catchl = smoothstep(0.3, 0.95, facing) * smoothstep(0.2, 0.7, s) * (1.0 - smoothstep(0.85, 1.0, s))
    face = mix(face, vec3(1.0, 1.0, 1.0), catchl * 0.6 * gloss)
    // The wall: the colour seen through the thickness, darkening to the foot.
    let tw = clamp((p.y - fhi.y + r * 0.5) / max(hi.y - fhi.y + r * 0.5, 1.0), 0.0, 1.0)
    let wallc = mix(b * 0.72, deep * 0.5, tw)
    var col = mix(wallc, face, Finish.cover(df, px))
    col = mix(col, deep * 0.55, Finish.band(df, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * 0.6)
    // The moulding seam round the whole key, darkest under it.
    col = mix(col, deep * 0.32, Finish.band(d, 0.0, px, px) * mix(0.3, 0.8, step(c.y, p.y)))
    let a = Finish.cover(d, px)
    res = Finish.over(res, vec4(col * a, a))
    // Focus: a toy-yellow ring standing just off the key.
    let ring = Finish.ring_out(d, px, px * 2.5, px) + Finish.glow(d - px * 2.5, 1.0) * 0.4 * (1.0 - a)
    return Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(ring, 0.0, 1.0) * focus * live)
}

// A glossy plastic ball laid over `dst`, premultiplied: its soft shadow on
// the board, a lit sphere whose colour deepens toward its rim, light coming
// back through the plastic low down, a broad soft reflection and a crisp
// white highlight up and to the left.
let kt_ball = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, base: vec3, hover: float, held: float, disabled: float, lift: float) -> vec4 {
    let live = 1.0 - disabled
    var b = kt_dull(base, disabled)
    b = b + (vec3(1.0, 1.0, 1.0) - b) * 0.09 * hover * live
    b = b * (1.0 - 0.06 * held * live)
    let so = c + vec2(0.16 * rad, 0.38 * rad) * lift
    let sd = length(p - so) - rad * 0.84
    let shs = max(0.36 * rad, px)
    let sh = (1.0 - smoothstep(-shs, shs * 1.5, sd)) * 0.42 * lift
    let cd = length(p - (c + vec2(0.0, 0.1 * rad))) - rad
    let ct = (1.0 - smoothstep(-0.12 * rad, 0.22 * rad + px, cd)) * 0.35
    let shadow = (1.0 - (1.0 - sh) * (1.0 - ct)) * (1.0 - 0.5 * disabled)
    var res = Finish.over(dst, vec4(kt_shade() * shadow, shadow))
    let q = (p - c) / max(rad, 0.5)
    let r2 = dot(q, q)
    let z = sqrt(max(1.0 - r2, 0.0))
    let n = vec3(q.x, q.y, z)
    let l = normalize(vec3(-0.45, -0.68, 0.58))
    let dif = max(dot(n, l), 0.0)
    let deep = kt_deep(b)
    var col = mix(deep * 0.8, b * 1.1, dif)
    let rimt = smoothstep(0.5, 1.0, sqrt(r2))
    col = mix(col, deep * 0.9, rimt * 0.3)
    col = col + b * 0.3 * smoothstep(0.25, 0.95, q.y) * rimt
    let hv = normalize(l + vec3(0.0, 0.0, 1.0))
    let nh = max(dot(n, hv), 0.0)
    let gloss = 1.0 - 0.8 * disabled
    col = col + vec3(1.0, 1.0, 1.0) * (pow(nh, 9.0) * 0.16 + pow(nh, 70.0) * 0.95) * gloss
    col = min(col, vec3(1.0, 1.0, 1.0))
    let d = length(p - c) - rad
    col = mix(col, deep * 0.45, Finish.band(d, 0.0, px, px) * 0.45)
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A channel moulded into the board, premultiplied: its floor `fl`, the
// board's shadow falling in along the upper wall, and a catch light on the
// board just under its lower lip.
let kt_groove = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, fl: vec3) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let hh = hi.y - lo.y
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var col = fl * (0.84 + 0.26 * t)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, clamp(0.35 * hh, 0.6, 2.5)), clamp(0.3 * hh, px, 2.0))
    col = col * (1.0 - 0.55 * ins)
    col = mix(col, fl * 0.5, Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(c.y - h.y * 0.2, c.y + h.y * 0.7, p.y) * 0.5
    return Finish.over(vec4(vec3(0.62, 0.77, 1.0) * lip, lip), vec4(col * a, a))
}

// A rod of coloured plastic lying in a channel, laid over `dst`: round
// across, lit from above, with a highlight line along its upper third.
let kt_rod = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, px: float, base: vec3, disabled: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.25, 0.25))
    let d = Material.sd_box(p, c, h, min(h.x, h.y))
    let b = kt_dull(base, disabled)
    let deep = kt_deep(b)
    let v = clamp((p.y - c.y) / max(h.y, 0.25), -1.0, 1.0)
    let z = sqrt(max(1.0 - v * v, 0.0))
    var col = mix(deep * 0.8, b * 1.06, clamp(0.25 + 0.6 * z - 0.3 * v, 0.0, 1.0))
    col = col + vec3(1.0, 1.0, 1.0) * exp(-((v + 0.45) * (v + 0.45)) / 0.06) * 0.38 * (1.0 - 0.8 * disabled)
    col = mix(col, deep * 0.5, Finish.band(d, 0.0, px, px) * 0.5)
    let a = Finish.cover(d, px)
    return Finish.over(dst, vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a))
}

// A thick moulded frame of coloured plastic round a window, premultiplied:
// the frame `bw` wide and round across like a tube, lit from above; the
// window's floor `fill` (at `fill_a`) with the frame's shadow falling in
// under its top edge, and a dark seam where the window starts.
let kt_frame = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, bw: float, rim: vec3, fill: vec3, fill_a: float, hover: float, focus: float, disabled: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let ih = max(h - vec2(bw, bw), vec2(0.5, 0.5))
    let ir = max(r - bw, 0.5)
    let di = Material.sd_box(p, c, ih, ir)
    let live = 1.0 - disabled
    var rc = kt_dull(rim, disabled)
    rc = rc + (vec3(1.0, 1.0, 1.0) - rc) * (0.08 * hover + 0.14 * focus) * live
    let deep = kt_deep(rc)
    let insh = Finish.inset(p, c, ih, ir, vec2(0.0, 1.4), 1.1)
    let win = fill * (1.0 - 0.5 * insh)
    let n = kt_box_n(p, c, h, r)
    let across = clamp(di / max(bw, 0.5), 0.0, 1.0) * 2.0 - 1.0
    let facing = dot(n * across, vec2(-0.38, -0.92))
    var fr = mix(deep * 0.85, rc * 1.08, clamp(0.55 + 0.5 * facing, 0.0, 1.0))
    let crown = exp(-((across + 0.15) * (across + 0.15)) / 0.1) * smoothstep(0.1, 0.9, -n.y)
    fr = mix(fr, vec3(1.0, 1.0, 1.0), crown * 0.42 * (1.0 - 0.7 * disabled))
    let inframe = Finish.cover(-di, px)
    var col = mix(win, fr, inframe)
    col = mix(col, deep * 0.35, Finish.band(di, 0.0, px, px) * 0.8)
    col = mix(col, deep * 0.35, Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px) * mix(fill_a, 1.0, inframe)
    return vec4(col * a, a)
}

// A part pressed into the board: a navy well with the board's shadow falling
// in from its top edge and walls, and light catching its lower wall.
let kt_sunk = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.075, 0.180, 0.440), vec3(0.110, 0.255, 0.560), t) + vec3(0.03, 0.03, 0.04) * hover
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 2.0), 1.6)
    col = col * (1.0 - 0.6 * ins)
    col = mix(col, vec3(0.36, 0.56, 0.92), Finish.band(d, 0.0, px * 1.5, px) * smoothstep(c.y + h.y * 0.3, hi.y, p.y) * 0.6)
    col = mix(col, vec3(0.03, 0.08, 0.22), Finish.band(d, 0.0, px, px) * (1.0 - smoothstep(c.y, hi.y, p.y)) * 0.7)
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// Clear plastic, premultiplied: what is under it shows lightened and tinted
// by `tint` at `density`; a broad reflection over its upper half, a bright
// refraction rim just inside the edge, light gathering at its foot, and a
// faint coloured shadow under it.
let kt_jelly = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, tint: vec3, density: float, disabled: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let tn = kt_dull(tint, disabled)
    let sh = Finish.drop(p, c, h, r, vec2(0.0, 1.2), 1.4) * 0.35 * (1.0 - Finish.cover(d, px))
    var res = vec4(mix(kt_shade(), kt_deep(tn) * 0.5, density) * sh, sh)
    let clear = vec3(0.74, 0.82, 0.95)
    var col = mix(clear, tn, density)
    col = col * (0.92 + 0.12 * t)
    col = col + (vec3(1.0, 1.0, 1.0) - col) * smoothstep(0.55, 1.0, t) * 0.18
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.sheen(uv, 0.06, 0.5, 0.12) * 0.5 * (1.0 - 0.7 * disabled))
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, px, px * 2.5, px) * 0.35)
    col = mix(col, kt_deep(mix(vec3(0.2, 0.35, 0.65), tn, density)) * 0.6, Finish.band(d, 0.0, px, px) * 0.7)
    let a = Finish.cover(d, px) * mix(0.72, 0.95, density)
    return Finish.over(res, vec4(col * a, a))
}

// The focus ring: a toy-yellow line standing a device pixel off the edge
// of a shape at distance `d`, with a short breath of light outside it.
let kt_focus = fn(d: float, px: float) -> float {
    let ring = Finish.ring_out(d, px, px * 2.5, px)
    return clamp(ring + Finish.glow(d - px * 2.5, 1.0) * 0.4 * (1.0 - Finish.cover(d - px * 2.5, px)), 0.0, 1.0)
}

// The three-quarter arc a waiting button turns in place of its label.
let kt_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(1.0, 1.0, 1.0, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is a thick plastic key, each kind in its own colour: the
// plain button red, the primary green, the secondary yellow, the tertiary
// purple, the danger magenta, the flat one orange, the icon key teal; the
// outline is a cyan ring with the board showing through. The key's wall
// takes the bottom of its box, so the label is set two points up from the
// box's middle, onto the face.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 24.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonSecondary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonTertiary.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 4.0}
mod.widgets.ButtonOutline.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonSm.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 0.0 bottom: 2.0}
mod.widgets.ButtonLg.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 0.0 bottom: 3.0}
mod.widgets.ButtonXs.draw_text.text_style.font_size = 6.5
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(2.5)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.67)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The key's colour for a button `kind`: 0 flat (orange), 1 plain (red),
// 2 primary (green), 3 secondary (yellow), 4 tertiary (purple), 5 danger
// (magenta), 8 icon (teal).
let kt_key_col = fn(kind: float) -> vec3 {
    if kind < 0.5 { return kt_col(4.0) }
    if kind < 1.5 { return kt_col(0.0) }
    if kind < 2.5 { return kt_col(1.0) }
    if kind < 3.5 { return kt_col(2.0) }
    if kind < 4.5 { return kt_col(3.0) }
    if kind < 5.5 { return kt_col(6.0) }
    return kt_col(7.0)
}

// The key and its states, shared by every button template; 6 is the
// outline ring and 7 the flatter button, a pale key only under the hand.
let kt_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 8.0
    let px = kt_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(kt_snap(0.0, o.x, px), kt_snap(0.0, o.y, px))
    let hi = vec2(kt_snap(size.x, o.x, px), kt_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let r = clamp(0.24 * hh, 3.0, 7.0)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 5.5 && kind < 7.5 {
        if kind > 6.5 {
            if hover + down + focus > 0.001 {
                res = kt_block(p, lo, hi, r, px, kt_col(9.0) * 0.92, hover, down, disabled, focus, 0.6) * clamp(max(max(hover, down), focus), 0.0, 1.0)
            }
        } else {
            // The outline: a cyan ring moulding standing on the board, the
            // board showing through it a shade darker; under the hand the
            // window fills a little, pressed the ring sinks.
            let c = (lo + hi) * 0.5
            let h = (hi - lo) * 0.5
            let dn = down * (1.0 - disabled)
            let sh = Finish.drop(p, c, h, r, vec2(0.4, 1.6 * (1.0 - 0.8 * dn) + px), 1.3) * 0.45 * (1.0 - 0.5 * disabled)
            res = vec4(kt_shade() * sh, sh)
            var ring = kt_frame(p, lo, hi, r, px, 2.5, kt_col(8.0), vec3(0.10, 0.36, 0.62), 0.16 + 0.16 * hover + 0.25 * dn, hover, 0.0, disabled)
            if dash > 0.0 {
                let dd = Material.sd_box(p, c, h - vec2(1.25, 1.25), max(r - 1.25, 0.5))
                let on = step(0.5, fract((p.x + p.y) / (dash * 2.0)))
                ring = mix(ring * Finish.cover(-dd + 1.25, px), ring, on)
            }
            res = Finish.over(res, ring)
            let d = Material.sd_box(p, c, h, r)
            let fr = Finish.ring_out(d, px, px * 2.5, px) + Finish.glow(d - px * 2.5, 1.0) * 0.4 * (1.0 - Finish.cover(d, px))
            res = Finish.over(res, vec4(1.0, 0.86, 0.2, 1.0) * clamp(fr, 0.0, 1.0) * focus * (1.0 - disabled))
        }
    } else {
        res = kt_block(p, lo, hi, r, px, kt_key_col(kind), hover, down, disabled, focus, 1.0)
    }
    if loading > 0.001 {
        let rad = max(min(hi.x - lo.x, hh) * 0.5 - 6.0, 2.0)
        res = kt_spinner(res, p, (lo + hi) * 0.5 - vec2(0.0, 1.5), rad, anim, loading, 1.5)
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return self.host_over(kt_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0), 8.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return self.host_over(kt_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0), 8.0)
}
mod.widgets.ButtonSm.draw_bg.pixel = fn() {
