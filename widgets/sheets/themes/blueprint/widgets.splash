use mod.prelude.widgets_internal.*

// An engineering blueprint: every control is a technical line drawing in
// white ink on the deep cyanotype paper of the window's ground. Outlines
// are two device pixels with corners of two points, dimension, centre and
// hatch lines one device pixel, all crisp at the device pixel and evenly
// weighted, with no glow and no relief. A face is the paper a shade
// deeper; nothing is filled except where a state needs it: the chosen
// thing takes the pale wash or a light hatch, a held thing the hatched
// shadow of a recess along its top and left edges, a lamp its light.
// Focus is a dashed sky marquee standing off the box, as a selection is
// marked on a drawing; the red pencil marks only danger.
mod.widgets.Button.padding = mod.turtle.Inset{left: 11.0 right: 11.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.67
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same 26 point row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 2.0
let field_border = 0.67

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #154577

// Marks leave the layout box: plain views stop clipping so a focus
// marquee, a hatched side or a leader line can fall into the gap beside a
// control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. The inks: paper #154577, face #11416f (the paper
// a shade deeper), lifted face #1a4e84, held face #0d3a68, well #0f3d6c,
// chosen wash #2a679f, line ink #e3f1ff, sky ink #9cd8fa, dimension ink
// #91c5f7, disabled line #6f93bd, red pencil #f46b66, amber pencil
// #ffd166, green #8ef0b8.
let bp_paper = fn() -> vec3 { return vec3(0.082, 0.271, 0.467) }
let bp_face = fn() -> vec3 { return vec3(0.067, 0.255, 0.435) }
let bp_face_hi = fn() -> vec3 { return vec3(0.102, 0.306, 0.518) }
let bp_face_lo = fn() -> vec3 { return vec3(0.051, 0.227, 0.408) }
let bp_well = fn() -> vec3 { return vec3(0.059, 0.239, 0.424) }
let bp_wash = fn() -> vec3 { return vec3(0.165, 0.404, 0.624) }
let bp_ink = fn() -> vec3 { return vec3(0.890, 0.945, 1.0) }
let bp_white = fn() -> vec3 { return vec3(1.0, 1.0, 1.0) }
let bp_sky = fn() -> vec3 { return vec3(0.612, 0.847, 0.980) }
let bp_sky_hi = fn() -> vec3 { return vec3(0.769, 0.914, 1.0) }
let bp_dimc = fn() -> vec3 { return vec3(0.569, 0.773, 0.969) }
let bp_off = fn() -> vec3 { return vec3(0.435, 0.576, 0.741) }
let bp_red = fn() -> vec3 { return vec3(0.957, 0.420, 0.400) }
let bp_green = fn() -> vec3 { return vec3(0.557, 0.941, 0.722) }
let bp_amber = fn() -> vec3 { return vec3(1.0, 0.820, 0.400) }

// Ink `ink` laid at coverage `a` over the premultiplied `under`.
let bp_put = fn(under: vec4, ink: vec3, a: float) -> vec4 {
    return mix(under, vec4(ink, 1.0), clamp(a, 0.0, 1.0))
}
// The near and far corners of a control's box on whole device pixels, in
// its own points.
let bp_lo = fn(o: vec2, px: float) -> vec2 {
    return vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
}
let bp_hi = fn(o: vec2, s: vec2, px: float) -> vec2 {
    return vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
}
// Distance to a segment.
let bp_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.000001), 0.0, 1.0)
    return length(pa - ba * t)
}
// Hairline hatching at 45 degrees, rising to the right, `pitch` points
// apart: the section lining of a drawing. Counted in the caller's own
// points, so it never moves with the page.
let bp_hatch = fn(p: vec2, pitch: float, px: float) -> float {
    let u = (p.x + p.y) * 0.70710678
    let t = abs(u - pitch * floor(u / pitch + 0.5))
    return Finish.cover(t - 0.5 * px, px)
}
// Dashes along a run `t` points long: on for `duty` of every `period`.
let bp_dash = fn(t: float, period: float, duty: float) -> float {
    return step(fract(t / period), duty)
}
// The focus marquee: a dashed sky hairline 2.5 points outside the box
// (centre `c`, half size `h`, corner `r`), laid over `under`.
let bp_focus = fn(under: vec4, p: vec2, c: vec2, h: vec2, r: float, px: float, focus: float) -> vec4 {
    let off = Finish.snap(2.5, px)
    let d = Material.sd_box(p, c, h + vec2(off, off), r + off)
    let dash = bp_dash(p.x + p.y, 4.0, 0.55)
    return bp_put(under, bp_sky(), Finish.band(d, 0.0, px, px) * dash * focus)
}
// A filled arrowhead, its tip at `tip`, pointing along the unit `dir`,
// `len` long and `hw` either side at its base. Coverage.
let bp_arrow = fn(p: vec2, tip: vec2, dir: vec2, len: float, hw: float, px: float) -> float {
    let q = p - tip
    let along = 0.0 - dot(q, dir)
    let across = abs(q.x * dir.y - q.y * dir.x)
    let k = hw / len
    let side = (across - along * k) / sqrt(1.0 + k * k)
    let d = max(max(0.0 - along, along - len), side)
    return Finish.cover(d, px)
}
// The recess a held thing is drawn as: section hatching inside its top
// and left edges, `w` points deep, inside the line `lw` of the box `d`.
let bp_recess = fn(p: vec2, lo: vec2, d: float, lw: float, w: float, px: float) -> float {
    let rim = min(step(p.y, lo.y + lw + w) + step(p.x, lo.x + lw + w), 1.0)
    return rim * Finish.cover(d + lw, px) * bp_hatch(p, 2.5, px)
}

// THE LETTERING. A single-stroke drafting hand, as a draughtsman's
// lettering guide draws it: each character a few straight strokes in a
// cell 4 units wide and 6 tall (y down), returned as the distance in units
// from `q` to the nearest stroke. The codes: 0-9 the digits, 10-35 A-Z,
// 36 minus, 37 point, 38 slash, 39 colon, 40 space.
let bp_glyph = fn(c: float, q: vec2) -> float {
    var d = 100.0
    if min(abs(c - 0.0), abs(c - 24.0)) < 0.5 {
        d = min(d, bp_seg(q, vec2(1.2, 0.0), vec2(2.8, 0.0)))
        d = min(d, bp_seg(q, vec2(2.8, 0.0), vec2(4.0, 1.3)))
        d = min(d, bp_seg(q, vec2(4.0, 1.3), vec2(4.0, 4.7)))
        d = min(d, bp_seg(q, vec2(4.0, 4.7), vec2(2.8, 6.0)))
        d = min(d, bp_seg(q, vec2(2.8, 6.0), vec2(1.2, 6.0)))
        d = min(d, bp_seg(q, vec2(1.2, 6.0), vec2(0.0, 4.7)))
        d = min(d, bp_seg(q, vec2(0.0, 4.7), vec2(0.0, 1.3)))
        d = min(d, bp_seg(q, vec2(0.0, 1.3), vec2(1.2, 0.0)))
    }
    if abs(c - 1.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.8, 1.2), vec2(2.2, 0.0)))
        d = min(d, bp_seg(q, vec2(2.2, 0.0), vec2(2.2, 6.0)))
    }
    if abs(c - 2.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 1.3), vec2(1.0, 0.1)))
        d = min(d, bp_seg(q, vec2(1.0, 0.1), vec2(3.0, 0.1)))
        d = min(d, bp_seg(q, vec2(3.0, 0.1), vec2(4.0, 1.2)))
        d = min(d, bp_seg(q, vec2(4.0, 1.2), vec2(4.0, 2.3)))
        d = min(d, bp_seg(q, vec2(4.0, 2.3), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(4.0, 6.0)))
    }
    if abs(c - 3.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.8), vec2(1.0, 0.0)))
        d = min(d, bp_seg(q, vec2(1.0, 0.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(4.0, 1.0)))
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(4.0, 2.0)))
        d = min(d, bp_seg(q, vec2(4.0, 2.0), vec2(3.0, 2.9)))
        d = min(d, bp_seg(q, vec2(3.0, 2.9), vec2(1.4, 2.9)))
        d = min(d, bp_seg(q, vec2(3.0, 2.9), vec2(4.0, 3.9)))
        d = min(d, bp_seg(q, vec2(4.0, 3.9), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(0.0, 5.2)))
    }
    if abs(c - 4.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(0.0, 4.2)))
        d = min(d, bp_seg(q, vec2(0.0, 4.2), vec2(4.0, 4.2)))
    }
    if abs(c - 5.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.4, 0.0)))
        d = min(d, bp_seg(q, vec2(0.4, 0.0), vec2(0.1, 2.8)))
        d = min(d, bp_seg(q, vec2(0.1, 2.8), vec2(1.2, 2.4)))
        d = min(d, bp_seg(q, vec2(1.2, 2.4), vec2(3.0, 2.4)))
        d = min(d, bp_seg(q, vec2(3.0, 2.4), vec2(4.0, 3.5)))
        d = min(d, bp_seg(q, vec2(4.0, 3.5), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(0.0, 5.2)))
    }
    if abs(c - 6.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(3.7, 0.6), vec2(2.9, 0.0)))
        d = min(d, bp_seg(q, vec2(2.9, 0.0), vec2(1.2, 0.0)))
        d = min(d, bp_seg(q, vec2(1.2, 0.0), vec2(0.0, 1.4)))
        d = min(d, bp_seg(q, vec2(0.0, 1.4), vec2(0.0, 4.7)))
        d = min(d, bp_seg(q, vec2(0.0, 4.7), vec2(1.2, 6.0)))
        d = min(d, bp_seg(q, vec2(1.2, 6.0), vec2(2.8, 6.0)))
        d = min(d, bp_seg(q, vec2(2.8, 6.0), vec2(4.0, 4.8)))
        d = min(d, bp_seg(q, vec2(4.0, 4.8), vec2(4.0, 3.8)))
        d = min(d, bp_seg(q, vec2(4.0, 3.8), vec2(2.8, 2.7)))
        d = min(d, bp_seg(q, vec2(2.8, 2.7), vec2(1.2, 2.7)))
        d = min(d, bp_seg(q, vec2(1.2, 2.7), vec2(0.0, 3.8)))
    }
    if abs(c - 7.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(4.0, 0.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(1.5, 6.0)))
    }
    if abs(c - 8.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(1.2, 0.0), vec2(2.8, 0.0)))
        d = min(d, bp_seg(q, vec2(2.8, 0.0), vec2(3.7, 0.8)))
        d = min(d, bp_seg(q, vec2(3.7, 0.8), vec2(3.7, 2.1)))
        d = min(d, bp_seg(q, vec2(3.7, 2.1), vec2(2.8, 2.9)))
        d = min(d, bp_seg(q, vec2(2.8, 2.9), vec2(1.2, 2.9)))
        d = min(d, bp_seg(q, vec2(1.2, 2.9), vec2(0.3, 2.1)))
        d = min(d, bp_seg(q, vec2(0.3, 2.1), vec2(0.3, 0.8)))
        d = min(d, bp_seg(q, vec2(0.3, 0.8), vec2(1.2, 0.0)))
        d = min(d, bp_seg(q, vec2(1.2, 2.9), vec2(2.8, 2.9)))
        d = min(d, bp_seg(q, vec2(2.8, 2.9), vec2(4.0, 4.0)))
        d = min(d, bp_seg(q, vec2(4.0, 4.0), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(0.0, 5.0)))
        d = min(d, bp_seg(q, vec2(0.0, 5.0), vec2(0.0, 4.0)))
        d = min(d, bp_seg(q, vec2(0.0, 4.0), vec2(1.2, 2.9)))
    }
    if abs(c - 9.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.3, 5.4), vec2(1.1, 6.0)))
        d = min(d, bp_seg(q, vec2(1.1, 6.0), vec2(2.8, 6.0)))
        d = min(d, bp_seg(q, vec2(2.8, 6.0), vec2(4.0, 4.6)))
        d = min(d, bp_seg(q, vec2(4.0, 4.6), vec2(4.0, 1.3)))
        d = min(d, bp_seg(q, vec2(4.0, 1.3), vec2(2.8, 0.0)))
        d = min(d, bp_seg(q, vec2(2.8, 0.0), vec2(1.2, 0.0)))
        d = min(d, bp_seg(q, vec2(1.2, 0.0), vec2(0.0, 1.2)))
        d = min(d, bp_seg(q, vec2(0.0, 1.2), vec2(0.0, 2.2)))
        d = min(d, bp_seg(q, vec2(0.0, 2.2), vec2(1.2, 3.3)))
        d = min(d, bp_seg(q, vec2(1.2, 3.3), vec2(2.8, 3.3)))
        d = min(d, bp_seg(q, vec2(2.8, 3.3), vec2(4.0, 2.2)))
    }
    if abs(c - 10.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(2.0, 0.0)))
        d = min(d, bp_seg(q, vec2(2.0, 0.0), vec2(4.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.7, 4.0), vec2(3.3, 4.0)))
    }
    if abs(c - 11.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 3.0), vec2(3.0, 3.0)))
        d = min(d, bp_seg(q, vec2(3.0, 3.0), vec2(4.0, 4.0)))
        d = min(d, bp_seg(q, vec2(4.0, 4.0), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(2.8, 0.0)))
        d = min(d, bp_seg(q, vec2(2.8, 0.0), vec2(3.7, 0.8)))
        d = min(d, bp_seg(q, vec2(3.7, 0.8), vec2(3.7, 2.2)))
        d = min(d, bp_seg(q, vec2(3.7, 2.2), vec2(2.9, 3.0)))
    }
    if abs(c - 12.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(1.0, 0.0)))
        d = min(d, bp_seg(q, vec2(1.0, 0.0), vec2(0.0, 1.0)))
        d = min(d, bp_seg(q, vec2(0.0, 1.0), vec2(0.0, 5.0)))
        d = min(d, bp_seg(q, vec2(0.0, 5.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(4.0, 5.0)))
    }
    if abs(c - 13.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(2.4, 6.0)))
        d = min(d, bp_seg(q, vec2(2.4, 6.0), vec2(4.0, 4.4)))
        d = min(d, bp_seg(q, vec2(4.0, 4.4), vec2(4.0, 1.6)))
        d = min(d, bp_seg(q, vec2(4.0, 1.6), vec2(2.4, 0.0)))
        d = min(d, bp_seg(q, vec2(2.4, 0.0), vec2(0.0, 0.0)))
    }
    if abs(c - 14.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(4.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 3.0), vec2(2.8, 3.0)))
    }
    if abs(c - 15.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 3.0), vec2(2.8, 3.0)))
    }
    if abs(c - 16.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(1.0, 0.0)))
        d = min(d, bp_seg(q, vec2(1.0, 0.0), vec2(0.0, 1.0)))
        d = min(d, bp_seg(q, vec2(0.0, 1.0), vec2(0.0, 5.0)))
        d = min(d, bp_seg(q, vec2(0.0, 5.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(4.0, 3.4)))
        d = min(d, bp_seg(q, vec2(4.0, 3.4), vec2(2.2, 3.4)))
    }
    if abs(c - 17.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(4.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 3.0), vec2(4.0, 3.0)))
    }
    if abs(c - 18.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(2.0, 0.0), vec2(2.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 0.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(3.0, 6.0)))
    }
    if abs(c - 20.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.0, 3.8)))
        d = min(d, bp_seg(q, vec2(1.4, 2.7), vec2(4.0, 6.0)))
    }
    if abs(c - 21.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(4.0, 6.0)))
    }
    if abs(c - 22.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(2.0, 3.6)))
        d = min(d, bp_seg(q, vec2(2.0, 3.6), vec2(4.0, 0.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(4.0, 6.0)))
    }
    if abs(c - 23.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(4.0, 6.0)))
        d = min(d, bp_seg(q, vec2(4.0, 6.0), vec2(4.0, 0.0)))
    }
    if abs(c - 25.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(4.0, 1.0)))
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(4.0, 2.2)))
        d = min(d, bp_seg(q, vec2(4.0, 2.2), vec2(3.0, 3.2)))
        d = min(d, bp_seg(q, vec2(3.0, 3.2), vec2(0.0, 3.2)))
    }
    if abs(c - 27.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(0.0, 0.0)))
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(4.0, 1.0)))
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(4.0, 2.2)))
        d = min(d, bp_seg(q, vec2(4.0, 2.2), vec2(3.0, 3.2)))
        d = min(d, bp_seg(q, vec2(3.0, 3.2), vec2(0.0, 3.2)))
        d = min(d, bp_seg(q, vec2(2.0, 3.2), vec2(4.0, 6.0)))
    }
    if abs(c - 28.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(4.0, 1.0), vec2(3.0, 0.0)))
        d = min(d, bp_seg(q, vec2(3.0, 0.0), vec2(1.0, 0.0)))
        d = min(d, bp_seg(q, vec2(1.0, 0.0), vec2(0.0, 1.0)))
        d = min(d, bp_seg(q, vec2(0.0, 1.0), vec2(0.0, 2.0)))
        d = min(d, bp_seg(q, vec2(0.0, 2.0), vec2(1.0, 3.0)))
        d = min(d, bp_seg(q, vec2(1.0, 3.0), vec2(3.0, 3.0)))
        d = min(d, bp_seg(q, vec2(3.0, 3.0), vec2(4.0, 4.0)))
        d = min(d, bp_seg(q, vec2(4.0, 4.0), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(0.0, 5.0)))
    }
    if abs(c - 29.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(4.0, 0.0)))
        d = min(d, bp_seg(q, vec2(2.0, 0.0), vec2(2.0, 6.0)))
    }
    if abs(c - 30.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(0.0, 5.0)))
        d = min(d, bp_seg(q, vec2(0.0, 5.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(4.0, 5.0)))
        d = min(d, bp_seg(q, vec2(4.0, 5.0), vec2(4.0, 0.0)))
    }
    if abs(c - 31.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(2.0, 6.0)))
        d = min(d, bp_seg(q, vec2(2.0, 6.0), vec2(4.0, 0.0)))
    }
    if abs(c - 32.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(1.0, 6.0)))
        d = min(d, bp_seg(q, vec2(1.0, 6.0), vec2(2.0, 2.0)))
        d = min(d, bp_seg(q, vec2(2.0, 2.0), vec2(3.0, 6.0)))
        d = min(d, bp_seg(q, vec2(3.0, 6.0), vec2(4.0, 0.0)))
    }
    if abs(c - 33.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(4.0, 6.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.0, 6.0)))
    }
    if abs(c - 34.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(2.0, 3.0)))
        d = min(d, bp_seg(q, vec2(2.0, 3.0), vec2(4.0, 0.0)))
        d = min(d, bp_seg(q, vec2(2.0, 3.0), vec2(2.0, 6.0)))
    }
    if abs(c - 35.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.0, 0.0), vec2(4.0, 0.0)))
        d = min(d, bp_seg(q, vec2(4.0, 0.0), vec2(0.0, 6.0)))
        d = min(d, bp_seg(q, vec2(0.0, 6.0), vec2(4.0, 6.0)))
    }
    if abs(c - 36.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(0.8, 3.2), vec2(3.2, 3.2)))
    }
    if abs(c - 38.0) < 0.5 {
        d = min(d, bp_seg(q, vec2(3.6, 0.0), vec2(0.4, 6.0)))
    }
    if abs(c - 37.0) < 0.5 {
        d = min(d, length(q - vec2(2.0, 5.9)) - 0.35)
    }
    if abs(c - 39.0) < 0.5 {
        d = min(d, length(q - vec2(2.0, 1.9)) - 0.35)
        d = min(d, length(q - vec2(2.0, 5.9)) - 0.35)
    }
    return d
}

// The strings the sheet letters, by number, character by character.
let bp_str = fn(s: float, i: float) -> float {
    var c = 40.0
    if abs(s - 0.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 16.0 }
        if abs(i - 1.0) < 0.5 { c = 14.0 }
        if abs(i - 2.0) < 0.5 { c = 23.0 }
        if abs(i - 3.0) < 0.5 { c = 14.0 }
        if abs(i - 4.0) < 0.5 { c = 27.0 }
        if abs(i - 5.0) < 0.5 { c = 10.0 }
        if abs(i - 6.0) < 0.5 { c = 21.0 }
        if abs(i - 8.0) < 0.5 { c = 10.0 }
        if abs(i - 9.0) < 0.5 { c = 27.0 }
        if abs(i - 10.0) < 0.5 { c = 27.0 }
        if abs(i - 11.0) < 0.5 { c = 10.0 }
        if abs(i - 12.0) < 0.5 { c = 23.0 }
        if abs(i - 13.0) < 0.5 { c = 16.0 }
        if abs(i - 14.0) < 0.5 { c = 14.0 }
        if abs(i - 15.0) < 0.5 { c = 22.0 }
        if abs(i - 16.0) < 0.5 { c = 14.0 }
        if abs(i - 17.0) < 0.5 { c = 23.0 }
        if abs(i - 18.0) < 0.5 { c = 29.0 }
    }
    if abs(s - 1.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 29.0 }
        if abs(i - 1.0) < 0.5 { c = 18.0 }
        if abs(i - 2.0) < 0.5 { c = 29.0 }
        if abs(i - 3.0) < 0.5 { c = 21.0 }
        if abs(i - 4.0) < 0.5 { c = 14.0 }
    }
    if abs(s - 2.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 13.0 }
        if abs(i - 1.0) < 0.5 { c = 32.0 }
        if abs(i - 2.0) < 0.5 { c = 16.0 }
        if abs(i - 4.0) < 0.5 { c = 23.0 }
        if abs(i - 5.0) < 0.5 { c = 24.0 }
    }
    if abs(s - 3.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 10.0 }
        if abs(i - 1.0) < 0.5 { c = 36.0 }
        if abs(i - 2.0) < 0.5 { c = 0.0 }
        if abs(i - 3.0) < 0.5 { c = 0.0 }
        if abs(i - 4.0) < 0.5 { c = 1.0 }
    }
    if abs(s - 4.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 28.0 }
        if abs(i - 1.0) < 0.5 { c = 12.0 }
        if abs(i - 2.0) < 0.5 { c = 10.0 }
        if abs(i - 3.0) < 0.5 { c = 21.0 }
        if abs(i - 4.0) < 0.5 { c = 14.0 }
    }
    if abs(s - 5.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 1.0 }
        if abs(i - 1.0) < 0.5 { c = 39.0 }
        if abs(i - 2.0) < 0.5 { c = 1.0 }
    }
    if abs(s - 6.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 28.0 }
        if abs(i - 1.0) < 0.5 { c = 17.0 }
        if abs(i - 2.0) < 0.5 { c = 14.0 }
        if abs(i - 3.0) < 0.5 { c = 14.0 }
        if abs(i - 4.0) < 0.5 { c = 29.0 }
    }
    if abs(s - 7.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 1.0 }
        if abs(i - 1.0) < 0.5 { c = 38.0 }
        if abs(i - 2.0) < 0.5 { c = 1.0 }
    }
    if abs(s - 8.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 27.0 }
        if abs(i - 1.0) < 0.5 { c = 14.0 }
        if abs(i - 2.0) < 0.5 { c = 31.0 }
    }
    if abs(s - 9.0) < 0.5 {
        if abs(i - 0.0) < 0.5 { c = 10.0 }
    }
    return c
}
// The number of characters in each string.
let bp_str_len = fn(s: float) -> float {
    var n = 0.0
    if abs(s - 0.0) < 0.5 { n = 19.0 }
    if abs(s - 1.0) < 0.5 { n = 5.0 }
    if abs(s - 2.0) < 0.5 { n = 6.0 }
    if abs(s - 3.0) < 0.5 { n = 5.0 }
    if abs(s - 4.0) < 0.5 { n = 5.0 }
    if abs(s - 5.0) < 0.5 { n = 3.0 }
    if abs(s - 6.0) < 0.5 { n = 5.0 }
    if abs(s - 7.0) < 0.5 { n = 3.0 }
    if abs(s - 8.0) < 0.5 { n = 3.0 }
    if abs(s - 9.0) < 0.5 { n = 1.0 }
    return n
}

// Lettering in that hand: string `s` from its top left `o`, capitals `cap`
// points tall, strokes `w` points wide. Coverage.
let bp_text = fn(p: vec2, o: vec2, cap: float, s: float, w: float, px: float) -> float {
    let k = cap / 6.0
    let u = (p - o) / k
    let i = floor((u.x + 0.7) / 5.4)
    let n = bp_str_len(s)
    let live = step(0.0, i) * step(i, n - 1.0) * step(-1.5, u.y) * step(u.y, 7.5)
    var cov = 0.0
    if live > 0.5 {
        let q = vec2(u.x - i * 5.4, u.y)
        cov = Finish.cover(bp_glyph(bp_str(s, i), q) * k - 0.5 * w, px)
    }
    return cov
}
// One character `ch` in the same hand, its cell's top left at `o`.
let bp_char = fn(p: vec2, o: vec2, cap: float, ch: float, w: float, px: float) -> float {
    let k = cap / 6.0
    let q = (p - o) / k
    let live = step(-1.5, q.x) * step(q.x, 5.5) * step(-1.5, q.y) * step(q.y, 7.5)
    var cov = 0.0
    if live > 0.5 {
        cov = Finish.cover(bp_glyph(ch, q) * k - 0.5 * w, px)
    }
    return cov
}

// A whole number `v` (up to four figures) in the same hand, centred on
// `ctr`: the figure a dimension line carries.
let bp_num = fn(p: vec2, ctr: vec2, cap: float, v: float, w: float, px: float) -> float {
    let k = cap / 6.0
    let vv = floor(v + 0.5)
    let nd = 1.0 + step(9.5, vv) + step(99.5, vv) + step(999.5, vv)
    let o = ctr - vec2((nd * 5.4 - 1.4) * k * 0.5, cap * 0.5)
    let u = (p - o) / k
    let i = floor((u.x + 0.7) / 5.4)
    let live = step(0.0, i) * step(i, nd - 1.0) * step(-1.5, u.y) * step(u.y, 7.5)
    var cov = 0.0
    if live > 0.5 {
        let dg = floor(vv / pow(10.0, nd - 1.0 - i)) - 10.0 * floor(vv / pow(10.0, nd - i))
        let q = vec2(u.x - i * 5.4, u.y)
        cov = Finish.cover(bp_glyph(dg, q) * k - 0.5 * w, px)
    }
    return cov
}

// The wait mark a replaced face draws itself: twelve short ticks on a ring
// where the label was, the one at the head in full ink on the button's own
// animation clock, the rest fading behind it.
let bp_wait = fn(under: vec4, p: vec2, lo: vec2, hi: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let r = clamp((hi.y - lo.y) * 0.3, 3.0, 8.0)
    let q = p - c
    let a = fract(atan2(q.y, q.x) / 6.2831853 + 0.25)
    let slot = floor(a * 12.0 + 0.5)
    let ang = slot / 12.0 * 6.2831853 - 1.5707963
    let dir = vec2(cos(ang), sin(ang))
    let s = bp_seg(q, dir * (r - 2.5), dir * r)
    let head = fract(slot / 12.0 - t)
    let lit = mix(0.2, 1.0, pow(1.0 - head, 3.0))
    let cov = Finish.cover(s - 0.5 * px, px) * loading
    return bp_put(under, mix(bp_off(), bp_ink(), lit), cov)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `style` picks the dressing:
// 0 standard (the face under a two-pixel line), 1 primary (the chosen one:
// the pale wash under a three-pixel line of sky), 2 secondary (the line in
// sky), 3 danger (the line dashed in red pencil), 4 outline (the line
// alone, the grid showing through), 5 flat and 6 flatter (nothing until the
// pointer comes, then a hairline), 7 tertiary (the face under a hairline),
// 8 dashed (the outline in dashes).
// Under the pointer the line turns full white and the face lifts a shade;
// held, the face goes a shade deeper and the recess hatch runs inside its
// top and left edges; disabled, the line is dashed in the dim ink. The
// quad is grown by 6 points for the focus marquee.
let bp_button = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, disabled: float, style: float) -> vec4 {
    let lo = bp_lo(o, px)
    let hi = bp_hi(o, s, px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = 2.0
    let d = Material.sd_box(p, c, h, r)
    let live = 1.0 - disabled
    let hv = hover * live
    let dn = down * live
    let hero = step(0.5, style) * step(style, 1.5)
    let armed = step(1.5, style) * step(style, 2.5)
    let danger = step(2.5, style) * step(style, 3.5)
    let outline = step(3.5, style) * step(style, 4.5)
    let flat = step(4.5, style) * step(style, 6.5)
    let thin = step(6.5, style) * step(style, 7.5)
    let dashed = step(7.5, style)
    let inside = Finish.cover(d, px)
    // The face.
    var face = mix(bp_face(), bp_face_hi(), hv)
    face = mix(face, bp_face_lo(), dn)
    let hface = mix(mix(bp_wash(), vec3(0.200, 0.455, 0.682), hv), vec3(0.137, 0.365, 0.576), dn)
    face = mix(face, hface, hero)
    var fa = 0.9
    fa = mix(fa, max(0.5 * hv, 0.8 * dn), max(max(outline, flat), dashed))
    fa = mix(fa, 0.4, disabled)
    var out = vec4(face * fa * inside, fa * inside)
    // The line's weight.
    var lw = 2.0 * px
    lw = mix(lw, 3.0 * px, hero)
    lw = mix(lw, px, max(thin, flat))
    // Held: the recess.
    out = bp_put(out, bp_ink(), bp_recess(p, lo, d, lw, 3.0, px) * dn * 0.55)
    // The line.
    var lc = mix(bp_ink(), bp_white(), hv)
    lc = mix(lc, mix(bp_sky(), bp_sky_hi(), hv), max(hero, armed))
    lc = mix(lc, mix(bp_red(), vec3(1.0, 0.58, 0.55), hv), danger)
    lc = mix(lc, bp_off(), disabled)
    var shown = mix(1.0, max(hv, dn), flat)
    let dash = bp_dash(p.x + p.y, 5.0, 0.6)
    shown = shown * mix(1.0, dash, max(max(danger, dashed), disabled))
    out = bp_put(out, lc, Finish.band(d, 0.0, lw, px) * shown)
    return bp_focus(out, p, c, h, r, px, focus * live)
}

mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 11.0 right: 11.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk = Walk{width: 13.0, height: Fit}
mod.widgets.ButtonFlat.draw_bg.bp_room = uniform(6.0)
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.bp_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.bp_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = bp_button(p, self.rect_pos, self.rect_size, px, self.hover, self.down, self.focus, self.disabled, 5.0)
    return self.host_over(bp_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time), m)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.bp_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = bp_button(p, self.rect_pos, self.rect_size, px, self.hover, self.down, self.focus, self.disabled, 0.0)
    return self.host_over(bp_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time), m)
}
// The size rungs and the compound are standard buttons. They share the
// flat button's draw object, so they are handed one of their own.
mod.widgets.ButtonXs.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonSm.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonLg.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonXl.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonCompound.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 32.0
mod.widgets.ButtonXl.min_height = 38.0
mod.widgets.ButtonSm.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonXs.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonLg.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}

