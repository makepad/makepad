// The stepper: its own column behind a two-pixel divider, split across
// the middle by a hairline; the half under the pointer takes the wash at
// a third, the held half the recess hatch; the arrows are the white ink.
mod.widgets.NumberSpin.draw_text.color = #eef6ff
mod.widgets.NumberSpin.draw_text.text_style = mod.theme.font_regular{font_size: 6.0 line_spacing: 1.0}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let mid = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let upper = step(p.y, mid)
    let live = 1.0 - self.disabled
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let down = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let x0 = Finish.snap(self.rect_pos.x, px) - self.rect_pos.x
    let a = 0.35 * hot * step(x0 + 2.0 * px, p.x) * step(2.0 * px, p.y) * step(p.y, self.rect_size.y - 2.0 * px)
    var out = vec4(bp_wash() * a, a)
    out = bp_put(out, bp_ink(), bp_hatch(p, 2.5, px) * down * 0.5 * step(x0 + 2.0 * px, p.x) * step(2.0 * px, p.y) * step(p.y, self.rect_size.y - 2.0 * px))
    let groove = Finish.cover(abs(p.y - mid - 0.5 * px) - 0.5 * px, px) * step(x0 + 2.0 * px, p.x) * step(p.x, self.rect_size.x - 2.0 * px)
    let side = step(x0, p.x) * step(p.x, x0 + 2.0 * px)
    var lc = mix(bp_ink(), bp_off(), self.disabled)
    out = bp_put(out, mix(bp_dimc(), bp_off(), self.disabled), groove)
    return bp_put(out, lc, side)
}

// DROP-DOWNS. The button's face and line, a two-pixel divider 22 points
// from the right edge and a chevron in the cell it makes; open, the face
// takes the wash and the chevron turns over.
let bp_dropdown = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, open: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    var f = bp_button(p, o, s, px, hover, down * hover, focus, disabled, 0.0)
    let lo = bp_lo(o, px)
    let hi = bp_hi(o, s, px)
    let inside = Finish.cover(Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5 - vec2(2.0 * px, 2.0 * px), 1.0), px)
    f = bp_put(f, bp_wash(), inside * open * live * 0.8)
    var lc = mix(bp_ink(), bp_white(), hover * live)
    lc = mix(lc, bp_off(), disabled)
    let dx = Finish.snap(o.x + s.x - 22.0, px) - o.x
    let div = step(dx, p.x) * step(p.x, dx + 2.0 * px) * step(5.0, p.y) * step(p.y, s.y - 5.0)
    f = bp_put(f, lc, div)
    let c = vec2(s.x - 11.0, Finish.snap(o.y + s.y * 0.5, px) - o.y)
    let fl = mix(1.0, -1.0, open)
    let a = c + vec2(-3.5, -1.75 * fl)
    let b = c + vec2(0.0, 1.75 * fl)
    let e = c + vec2(3.5, -1.75 * fl)
    let ch = min(bp_seg(p, a, b), bp_seg(p, b, e))
    return bp_put(f, lc, Finish.cover(ch - 0.75 * px, px))
}
