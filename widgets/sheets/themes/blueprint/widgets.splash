// HELD STATES. The stock tracks write the pointer's hover and the press as
// snapped values, and a snapped value never arrives when a state is held
// from the start (a still page, a restored screen). The same states with
// plain values and a snapped entry look and move the same under a live
// pointer, and hold.
let bp_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
bp_held_states(mod.widgets.ButtonFlat)
bp_held_states(mod.widgets.CheckBoxFlat)
bp_held_states(mod.widgets.ToggleFlat)
bp_held_states(mod.widgets.RadioButtonFlat)
bp_held_states(mod.widgets.RadioButtonTabFlat)
bp_held_states(mod.widgets.TextInputFlat)
bp_held_states(mod.widgets.DropDownFlat)

// ---------------------------------------------------------------------------
// CHECK BOXES. A 15 point square with corners of two points in the
// two-pixel line over the face; checked, a check of two strokes in the sky
// ink; mixed, the pale wash with a white dash across it; error, the line in
// red pencil; held, the well hatched as a recess; disabled, the line dashed.
let bp_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, 2.0)
    let live = 1.0 - disabled
    let hv = hover * live
    let dn = down * live
    let mx = mixed * (1.0 - active)
    let lw = 2.0 * px
    let inside = Finish.cover(d, px)
    var face = mix(bp_face(), bp_face_hi(), hv)
    face = mix(face, bp_face_lo(), dn)
    face = mix(face, bp_wash(), mx * live)
    var out = vec4(face * 0.9 * inside, 0.9 * inside)
    out = bp_put(out, bp_ink(), Finish.cover(d + lw, px) * bp_hatch(p, 2.5, px) * dn * 0.5)
    var lc = mix(bp_ink(), bp_white(), hv)
    lc = mix(lc, bp_red(), err)
    lc = mix(lc, bp_off(), disabled)
    let dash = mix(1.0, bp_dash(p.x + p.y, 4.0, 0.6), disabled)
    out = bp_put(out, lc, Finish.band(d, 0.0, lw, px) * dash)
    // The check.
    let k = hi.x - lo.x
    let a = lo + vec2(0.22, 0.52) * k
    let b = lo + vec2(0.42, 0.73) * k
    let e = lo + vec2(0.79, 0.27) * k
    let cw = max(2.5 * px, 0.12 * k)
    let ck = min(bp_seg(p, a, b), bp_seg(p, b, e)) - cw * 0.5
    var ink = mix(bp_sky(), bp_sky_hi(), hv)
    ink = mix(ink, bp_red(), err)
    ink = mix(ink, bp_off(), disabled)
    out = bp_put(out, ink, Finish.cover(ck, px) * active)
    // Mixed: the dash.
    let md = max(abs(p.x - c.x) - 0.25 * k, abs(p.y - c.y) - cw * 0.5)
    out = bp_put(out, mix(bp_white(), bp_off(), disabled), Finish.cover(md, px) * mx)
    return bp_focus(out, p, c, h, 2.0, px, focus * live)
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 18.0
mod.widgets.CheckBoxFlat.draw_bg.size = uniform(15.0)
mod.widgets.CheckBoxFlat.draw_bg.border_radius = uniform(2.0)
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    return bp_check(p, self.rect_pos, self.rect_size, px, self.size, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}
mod.widgets.CheckBoxFlat.draw_text.color_error = #ffb3ae

// RADIOS. A 15 point circle in the two-pixel line; on, a disc of the sky
// ink with a device pixel of face between it and the line.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 18.0
mod.widgets.RadioButtonFlat.draw_bg.size = uniform(15.0)
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    let o = self.rect_pos
    let r = Finish.snap(self.size * 0.5, px)
    let c = vec2(Finish.snap(o.x + r, px) - o.x, Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y)
    let d = length(p - c) - r
    let live = 1.0 - self.disabled
    let hv = self.hover * live
    let dn = self.down * live
    let lw = 2.0 * px
    let inside = Finish.cover(d, px)
    var face = mix(bp_face(), bp_face_hi(), hv)
    face = mix(face, bp_face_lo(), dn)
    var out = vec4(face * 0.9 * inside, 0.9 * inside)
    out = bp_put(out, bp_ink(), Finish.cover(d + lw, px) * bp_hatch(p, 2.5, px) * dn * 0.5)
    var lc = mix(bp_ink(), bp_white(), hv)
    lc = mix(lc, bp_off(), self.disabled)
    let dash = mix(1.0, bp_dash(atan2(p.y - c.y, p.x - c.x) * r, 4.0, 0.6), self.disabled)
    out = bp_put(out, lc, Finish.band(d, 0.0, lw, px) * dash)
    let dd = length(p - c) - Finish.snap(r * 0.5, px)
    out = bp_put(out, mix(mix(bp_sky(), bp_sky_hi(), hv), bp_off(), self.disabled), Finish.cover(dd, px) * self.active)
    return bp_focus(out, p, c, vec2(r, r), r, px, self.focus * live)
}

// TOGGLES AND SWITCHES. One drawing for the three, `kind` picks it:
// 0 the toggle, an outlined pill with a round thumb; 1 the rocker, a box
// split down the middle whose pressed half is hatched as a recess, an I on
// one half and an O on the other, the lit one in sky; 2 the slide switch,
// a slot with a square cap carrying three grip lines. On, the stretch the
// thumb has travelled is hatched in sky and the thumb is the sky ink.
let bp_toggle = fn(p: vec2, o: vec2, rs: vec2, px: float, size: float, aspect: float, at_end: float, t: float, active: float, hover: float, down: float, focus: float, disabled: float, kind: float) -> vec4 {
    let sz = vec2(size * aspect, size)
    let x0 = (rs.x - sz.x) * at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + rs.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let pill = step(kind, 0.5)
    let rocker = step(0.5, kind) * step(kind, 1.5)
    let slide = step(1.5, kind)
    let r = mix(2.5, h.y, pill)
    let d = Material.sd_box(p, c, h, r)
    let live = 1.0 - disabled
    let hv = hover * live
    let dn = down * live
    let on = active * live
    let lw = 2.0 * px
    let inside = Finish.cover(d, px)
    var face = mix(bp_face(), bp_face_hi(), hv * 0.6)
    var out = vec4(face * 0.9 * inside, 0.9 * inside)
    var lc = mix(bp_ink(), bp_white(), hv)
    lc = mix(lc, bp_off(), disabled)
    let dash = mix(1.0, bp_dash(p.x + p.y, 4.0, 0.6), disabled)
    var sky = mix(bp_sky(), bp_sky_hi(), hv)
    sky = mix(sky, bp_off(), disabled)
    // The thumb's travel.
    let tr = h.y - Finish.snap(3.0, px)
    let tx0 = lo.x + h.y
    let tx1 = hi.x - h.y
    let tcx = Finish.snap(o.x + mix(tx0, tx1, t), px) - o.x
    // The travelled stretch, hatched in sky (toggle and slide switch).
    let trav = Finish.cover(d + lw + px, px) * step(p.x, tcx) * (1.0 - rocker)
    out = bp_put(out, sky, trav * bp_hatch(p, 2.5, px) * mix(0.0, 0.85, t) * live)
    // The rocker: the pressed half recessed, the divider, the I and the O.
    let half = mix(step(p.x, c.x), step(c.x, p.x), active)
    out = bp_put(out, bp_ink(), half * Finish.cover(d + lw, px) * bp_hatch(p, 2.5, px) * rocker * 0.45)
    let divd = Finish.cover(abs(p.x - c.x) - px, px) * inside * rocker
    out = bp_put(out, lc, divd)
    let iq = p - vec2(c.x + h.x * 0.5, c.y)
    let im = max(abs(iq.x) - px, abs(iq.y) - h.y * 0.42)
    out = bp_put(out, mix(lc, sky, on), Finish.cover(im, px) * rocker)
    let oq = length(p - vec2(c.x - h.x * 0.5, c.y)) - h.y * 0.38
    out = bp_put(out, mix(sky, lc, active), Finish.band(oq, 0.0, lw, px) * rocker)
    // The line.
    out = bp_put(out, lc, Finish.band(d, 0.0, lw, px) * dash)
    // The toggle's thumb.
    let td = length(p - vec2(tcx, c.y)) - tr
    let tin = Finish.cover(td, px) * pill
    out = bp_put(out, mix(face, sky, on), tin)
    out = bp_put(out, mix(bp_ink(), bp_face(), on), tin * bp_hatch(p, 2.0, px) * dn * 0.6)
    out = bp_put(out, mix(lc, sky, on), Finish.band(td, 0.0, lw, px) * pill)
    // The slide switch's cap: a square block over half the slot.
    let cw = h.x * 0.5 - Finish.snap(2.0, px)
    let ccx = Finish.snap(o.x + mix(lo.x + Finish.snap(2.0, px) + cw, hi.x - Finish.snap(2.0, px) - cw, t), px) - o.x
    let cd = Material.sd_box(p, vec2(ccx, c.y), vec2(cw, h.y - Finish.snap(2.0, px)), 1.0)
    out = bp_put(out, mix(face, bp_face_lo(), dn), Finish.cover(cd, px) * slide)
    let gq = abs(p.x - ccx)
    let grip = Finish.cover(abs(gq - 2.5 * step(1.0, gq)) - 0.5 * px, px) * step(gq, 3.5) * Finish.cover(cd + h.y * 0.35, px)
    out = bp_put(out, mix(lc, sky, on), grip * slide)
    out = bp_put(out, mix(lc, sky, on), Finish.band(cd, 0.0, lw, px) * slide)
    return bp_focus(out, p, c, h, r, px, focus * live)
}

mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.label_walk.margin.left = 42.0
mod.widgets.ToggleFlat.draw_bg.size = uniform(16.0)
mod.widgets.ToggleFlat.draw_bg.pill_aspect = uniform(2.375)
// A knob icon is a 7 point mark in the middle of the thumb. The widget
// places it for the stock knob, and a sheet's writes to those values do
// not reach where it reads them; so the icon's own point hook scales the
// mark about its centre and moves it onto this thumb.
let bp_knob_icon = fn(pos: vec2, rs: vec2, dx: float) -> vec2 {
    let c = rs * 0.5
    let k = 7.0 / max(min(rs.x, rs.y), 1.0)
    return c + (pos - c) * k + vec2(dx, 0.0)
}
mod.widgets.ToggleFlat.draw_icon_off.transform_svg_point = fn(pos: vec2) -> vec2 {
    return bp_knob_icon(pos, self.rect_size, 1.0)
}
mod.widgets.ToggleFlat.draw_icon_on.transform_svg_point = fn(pos: vec2) -> vec2 {
    return bp_knob_icon(pos, self.rect_size, -1.0)
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    let t = mix(self.active, self.drag_pos, self.drag)
    return bp_toggle(p, self.rect_pos, self.rect_size, px, self.size, self.pill_aspect, self.mark_at_end, t, self.active, self.hover, self.down, self.focus, self.disabled, 0.0)
}

// THE SWITCHES are the rocker and the slide switch drawn above, the
// toggle's size, quad and label gap. The rocker turns on a click; the
// slide switch follows a drag, as the toggle does.
mod.widgets.ToggleRocker.clip_x = false
mod.widgets.ToggleSlide.clip_x = false
mod.widgets.ToggleRocker.clip_y = false
mod.widgets.ToggleSlide.clip_y = false
mod.widgets.ToggleRocker.label_walk.margin.left = 42.0
mod.widgets.ToggleSlide.label_walk.margin.left = 42.0
mod.widgets.ToggleRocker.draw_bg.size = uniform(16.0)
mod.widgets.ToggleSlide.draw_bg.size = uniform(16.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(2.375)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(2.375)
mod.widgets.ToggleRocker.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleSlide.draw_bg.vertex = mod.widgets.ToggleFlat.draw_bg.vertex
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    return bp_toggle(p, self.rect_pos, self.rect_size, px, self.size, self.pill_aspect, self.mark_at_end, self.active, self.active, self.hover, self.down, self.focus, self.disabled, 1.0)
}
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    let t = mix(self.active, self.drag_pos, self.drag)
    return bp_toggle(p, self.rect_pos, self.rect_size, px, self.size, self.pill_aspect, self.mark_at_end, t, self.active, self.hover, self.down, self.focus, self.disabled, 2.0)
}

// ---------------------------------------------------------------------------
// SLIDERS. The rail is a slot drawn in two lines, each two device pixels,
// four device pixels apart with round ends; the value fills the slot in
// sky; a tick scale in the dimension ink runs under it, a tick every tenth
// and a longer one at the ends and the middle. The thumb is a small
// outlined square cross-hatched in sky, or (`round_thumb`) a circle with a
// centre mark whose upright runs on past it as a centre line.
let bp_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, pad_l: float, pad_r: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float, ruler: float, round_thumb: float) -> vec4 {
    let live = 1.0 - disabled
    let touch = max(max(hover, drag), focus) * live
    let yc = Finish.snap(o.y + cy, px) - o.y
    let x0 = Finish.snap(o.x + pad_l, px) - o.x
    let x1 = Finish.snap(o.x + rs.x - pad_r, px) - o.x
    let hh = Finish.snap(2.67, px)
    let lw = 2.0 * px
    let d = Material.sd_box(p, vec2((x0 + x1) * 0.5, yc), vec2((x1 - x0) * 0.5 + hh, hh), hh)
    let inside = Finish.cover(d, px)
    var out = vec4(bp_face() * 0.85 * inside, 0.85 * inside)
    // The value in the slot.
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    let fa = min(xf, xv)
    let fb = max(xf, xv)
    let fd = max(d + lw, max(fa - p.x, p.x - fb))
    var ink = mix(bp_sky(), bp_sky_hi(), drag * live)
    ink = mix(ink, bp_off(), disabled)
    out = bp_put(out, ink, Finish.cover(fd, px) * step(0.5 * px, fb - fa))
    // The rails.
    var lc = mix(bp_ink(), bp_white(), touch)
    lc = mix(lc, bp_off(), disabled)
    out = bp_put(out, lc, Finish.band(d, 0.0, lw, px))
    // The scale.
    let tq = (p.x - x0) / max(x1 - x0, 1.0) * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * (x1 - x0) / 10.0
    let major = min(step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti), 1.0)
    let ty = p.y - (yc + hh + Finish.snap(2.5, px))
    let tl = mix(2.5, 4.5, major)
    let tick = Finish.cover(tx - 0.5 * px, px) * step(0.0, ty) * step(ty, tl) * step(-0.5, ti) * step(ti, 10.5) * ruler
    out = bp_put(out, mix(bp_dimc(), bp_off(), disabled), tick)
    // The thumb.
    let hx = Finish.snap(o.x + xv, px) - o.x
    let tc = vec2(hx, yc)
    let sq = Material.sd_box(p, tc, vec2(6.0, 6.0), 2.0)
    let ci = length(p - tc) - 6.5
    let td = mix(sq, ci, round_thumb)
    let tin = Finish.cover(td, px)
    out = bp_put(out, mix(bp_face(), bp_face_hi(), touch), tin)
    let q = p - tc
    let xh = max(bp_hatch(q, 2.0, px), bp_hatch(vec2(0.0 - q.x, q.y), 2.0, px))
    out = bp_put(out, ink, xh * Finish.cover(td + lw + 0.5 * px, px) * (1.0 - round_thumb) * (0.7 + 0.3 * touch))
    let cross = max(Finish.cover(abs(q.x) - 0.5 * px, px), Finish.cover(abs(q.y) - 0.5 * px, px)) * Finish.cover(td + lw + 1.0, px)
    out = bp_put(out, lc, cross * round_thumb)
    let upright = Finish.cover(abs(q.x) - 0.5 * px, px) * step(abs(q.y), 9.0) * (1.0 - tin)
    out = bp_put(out, mix(bp_dimc(), bp_off(), disabled), upright * round_thumb)
    out = bp_put(out, lc, Finish.band(td, 0.0, lw, px))
    return bp_focus(out, p, tc, vec2(6.0, 6.0), mix(2.0, 6.5, round_thumb), px, focus * live)
}

mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.height = 36.0
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    return bp_slider(p, self.rect_pos, self.rect_size, px, 23.0, 6.0, 6.0, to, from, self.hover, self.focus, self.drag, self.disabled, 1.0, 0.0)
}
// The minimal slider is a dimension line: a hairline between two
// extension marks, the value a two-pixel line of sky from the start to an
// arrowhead, and an extension mark standing at the value.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let touch = max(max(self.hover, self.drag), self.focus) * live
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y + 0.5 * px
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + self.rect_size.x - 1.0, px) - o.x
    let inx = step(x0, p.x) * step(p.x, x1)
    var lc = mix(bp_ink(), bp_white(), touch)
    lc = mix(lc, bp_off(), self.disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    out = bp_put(out, mix(bp_dimc(), bp_off(), self.disabled), Finish.cover(abs(p.y - y) - 0.5 * px, px) * inx)
    let ext = Finish.cover(min(abs(p.x - x0), abs(p.x - x1)) - 0.5 * px, px) * step(abs(p.y - y), 5.0)
    out = bp_put(out, mix(bp_dimc(), bp_off(), self.disabled), ext)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(x0, x1, mix(0.0, lo, self.arc_origin))
    let b = mix(x0, x1, mix(self.slide_pos, hi, self.arc_origin))
    let hx = Finish.snap(o.x + mix(x0, x1, self.slide_pos), px) - o.x
    var ink = mix(bp_sky(), bp_sky_hi(), touch)
    ink = mix(ink, bp_off(), self.disabled)
    let run = Finish.cover(abs(p.y - y) - px, px) * step(a, p.x) * step(p.x, b - 4.0)
    out = bp_put(out, ink, run)
    out = bp_put(out, ink, bp_arrow(p, vec2(b, y), vec2(1.0, 0.0), 7.0, 2.6, px) * step(1.0, b - a))
    out = bp_put(out, ink, bp_arrow(p, vec2(a, y), vec2(-1.0, 0.0), 7.0, 2.6, px) * step(1.0, b - a) * step(0.5, self.arc_origin))
    let mark = Finish.cover(abs(p.x - hx) - 0.5 * px, px) * step(abs(p.y - y), 7.0)
    out = bp_put(out, lc, mark)
    return bp_focus(out, p, vec2(hx, y), vec2(3.0, 7.0), 1.0, px, self.focus * live)
}
// The round slider: the rail with the round thumb, between its label
// column and its value.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return bp_slider(p, self.rect_pos, self.rect_size, px, self.rect_size.y * 0.5, self.label_size + 8.0, 46.0, self.slide_pos, 0.0, self.hover, self.focus, self.drag, self.disabled, 0.0, 1.0)
}

// FADERS. The slot is two hairlines 4 points apart closed at both ends,
// the value fills it in sky, a tick ladder stands on both sides, every
// tenth 3 points and every half 5; the cap is a square outlined block
// with three grip lines across it, the middle one the sky index.
mod.widgets.SliderFader.cap_size = 12.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    // Track space: x runs from the value's zero, y across.
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let live = 1.0 - self.disabled
    let touch = max(max(self.hover, self.drag), self.focus) * live
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(across * 0.5, px)
    let a0 = foot - 3.0
    let a1 = foot + travel + 3.0
    let inrun = step(a0, p.x) * step(p.x, a1)
    var lc = mix(bp_ink(), bp_white(), touch)
    lc = mix(lc, bp_off(), self.disabled)
    let dimc = mix(bp_dimc(), bp_off(), self.disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let sd = Material.sd_box(p, vec2((a0 + a1) * 0.5, mid), vec2((a1 - a0) * 0.5, 2.0 + px), 0.0)
    out = bp_put(out, bp_face(), Finish.cover(sd, px) * 0.9)
    // The fill.
    let fa = foot + self.fill_lo * travel
    let fb = foot + self.fill_hi * travel
    let fill = Finish.cover(sd + px, px) * step(fa, p.x) * step(p.x, fb)
    out = bp_put(out, mix(bp_sky(), bp_off(), self.disabled), fill)
    out = bp_put(out, lc, Finish.band(sd, 0.0, px, px) * inrun)
    // Ticks on both sides.
    let tq = (p.x - foot) / travel * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * travel / 10.0
    let major = min(step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti), 1.0)
    let tl = mix(3.0, 5.0, major)
    let tb = abs(p.y - mid) - 6.0
    let tick = Finish.cover(tx - 0.5 * px, px) * step(0.0, tb) * step(tb, tl) * step(-0.5, ti) * step(ti, 10.5)
    out = bp_put(out, dimc, tick)
    // The cap.
    let at = Finish.snap(foot + self.slide_pos * travel, px)
    let cap = Material.sd_box(p, vec2(at, mid), vec2(self.cap_px * 0.5, 11.0), 1.5)
    let cin = Finish.cover(cap, px)
    out = bp_put(out, mix(mix(bp_face(), bp_face_hi(), touch), bp_face_lo(), self.drag * live), cin)
    let gq = abs(p.x - at)
    let grip = Finish.cover(abs(gq - 3.0 * step(1.5, gq)) - 0.5 * px, px) * step(gq, 4.0) * Finish.cover(cap + 3.0, px)
    let index = Finish.cover(gq - px, px) * Finish.cover(cap + 2.0, px)
    out = bp_put(out, lc, grip)
    out = bp_put(out, mix(mix(bp_sky(), bp_sky_hi(), touch), bp_off(), self.disabled), index)
    out = bp_put(out, lc, Finish.band(cap, 0.0, 2.0 * px, px))
    return bp_focus(out, p, vec2(at, mid), vec2(self.cap_px * 0.5, 11.0), 1.5, px, self.focus * live)
}

// ---------------------------------------------------------------------------
// ROTARIES. A knob is drawn as on a drawing: a tick scale round the
// outside (a tick every tenth of the travel, every fifth tick longer), the
// travel as a band outlined in hairlines and filled with sky over the lit
// stretch (from the start of the scale, or from the origin, to the value),
// the body a circle in the two-pixel line with a pointer in white and a
// centre mark, and short centre lines standing out at the sides.
// A dial 30 points or more in radius (`big`) is drawn as a cross-section:
// the left half is the knob's face, the right half is cut away to show the
// section, its housing wall hatched, the bearing balls on their race and
// the shaft hatched, the section plane a chain line down the middle; and
// two numbered balloons in the lower corners of its box point on leader
// lines at the housing and at a ball. Below 12 points in radius a knob
// keeps its band, body and pointer and drops the scale.
// Angles run clockwise from straight down, the way the scale reads: a
// quarter turn is the left, a half the top.
let bp_ang = fn(q: vec2) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    return a
}
let bp_dir = fn(a: float) -> vec2 {
    return vec2(0.0 - sin(a), cos(a))
}
// The part b0..b1 of an annulus centred on radius `rm`, `hw` either side,
// as a signed distance with square ends.
let bp_arcband = fn(rl: float, a: float, rm: float, hw: float, b0: float, b1: float) -> float {
    let dr = abs(rl - rm) - hw
    let da = max(b0 - a, a - b1) * rl
    return max(dr, da)
}
// A chain line (long dash, gap, dot, gap), `t` points along it.
let bp_chain = fn(t: float) -> float {
    let s = fract(t / 9.0) * 9.0
    return max(step(s, 5.0), step(6.5, s) * step(s, 7.5))
}
let bp_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float, rs: vec2) -> vec4 {
    let live = 1.0 - disabled
    let hov = hover * live
    let drg = drag * live
    let big = step(30.0, rad)
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let a1 = a0 + span
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let q = p - c
    let rl = length(q)
    let a = bp_ang(q)
    let lw = 2.0 * px
    var ink = mix(bp_ink(), bp_white(), max(hov, drg))
    ink = mix(ink, bp_off(), disabled)
    var sky = mix(bp_sky(), bp_sky_hi(), drg)
    sky = mix(sky, bp_off(), disabled)
    let dimc = mix(bp_dimc(), bp_off(), disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)

    // The scale.
    let n = mix(10.0, 20.0, big)
    let f = (a - a0) / span
    let tq = f * n
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * span / n * rl
    let major = step(fract(ti / 5.0 + 0.01), 0.05)
    let scaled = step(12.0, rad)
    let tl = rad * mix(mix(0.10, 0.17, major), mix(0.05, 0.09, major), big)
    let tk = Finish.cover(tx - 0.5 * px, px) * step(rad - tl, rl) * step(rl, rad) * step(-0.5, ti) * step(ti, n + 0.5) * scaled
    out = bp_put(out, dimc, tk)

    // The travel band.
    let tmax = rad * mix(0.17, 0.09, big) * scaled
    let bo = rad - tmax - Finish.snap(mix(1.0, 1.5, big), px) * scaled
    let bw = max(Finish.snap(rad * mix(mix(0.24, 0.15, scaled), 0.07, big), px), mix(3.0, 4.0, scaled) * px)
    let rb = bo - bw
    let rm = bo - bw * 0.5
    let bd = bp_arcband(rl, a, rm, bw * 0.5, a0, a1)
    let ld = bp_arcband(rl, a, rm, bw * 0.5 - px, s0, s1)
    out = bp_put(out, bp_face(), Finish.cover(bd, px) * 0.85)
    out = bp_put(out, sky, Finish.cover(ld, px) * step(0.001, s1 - s0))
    out = bp_put(out, ink, Finish.band(bd, 0.0, px, px))

    // The body.
    let bdd = rl - rb
    let bin = Finish.cover(bdd, px)
    out = bp_put(out, mix(bp_face(), bp_face_hi(), hov * 0.6), bin)
    let right = step(0.0, q.x) * big

    // The section, in the right half of a big dial: the housing wall
    // hatched, the bearing race and its balls, the shaft hatched.
    let wall = step(rb * 0.80, rl) * Finish.cover(bdd + lw, px)
    out = bp_put(out, ink, wall * bp_hatch(q, 2.5, px) * right * 0.55)
    out = bp_put(out, ink, Finish.cover(abs(rl - rb * 0.80) - 0.5 * px, px) * right)
    let race = Finish.cover(abs(abs(rl - rb * 0.6) - rb * 0.075) - 0.5 * px, px) * step(rl, rb * 0.79)
    out = bp_put(out, dimc, race * right)
    let bstep = 0.3926991
    let ba = atan2(q.y, q.x)
    let bk = clamp(floor(ba / bstep + 0.5), -3.0, 3.0)
    let bc = vec2(cos(bk * bstep), sin(bk * bstep)) * rb * 0.6
    let ball = Finish.cover(abs(length(q - bc) - rb * 0.055) - 0.5 * px, px)
    out = bp_put(out, ink, ball * right)
    let shaft = rl - rb * 0.18
    out = bp_put(out, ink, Finish.cover(shaft, px) * bp_hatch(q, 1.6, px) * right * 0.7)
    out = bp_put(out, ink, Finish.band(shaft, 0.0, px, px) * big)
    // The section plane: a chain line down the middle.
    let plane = Finish.cover(abs(q.x) - 0.5 * px, px) * step(abs(q.y), rb) * bp_chain(q.y + rb) * big
    out = bp_put(out, dimc, plane)

    // The body's line, and the centre lines standing out at the sides.
    out = bp_put(out, ink, Finish.band(bdd, 0.0, lw, px))
    let cl = Finish.cover(abs(q.y) - 0.5 * px, px) * step(rad + 1.0, abs(q.x)) * step(abs(q.x), rad + 4.5) * scaled
    out = bp_put(out, dimc, cl)
    // The centre mark.
    let arm = max(rb * 0.16, 1.5)
    let cm = max(Finish.cover(abs(q.y) - 0.5 * px, px) * step(abs(q.x), arm), Finish.cover(abs(q.x) - 0.5 * px, px) * step(abs(q.y), arm)) * (1.0 - big)
    out = bp_put(out, dimc, cm)
    let hline = Finish.cover(abs(q.y) - 0.5 * px, px) * step(q.x, 0.0) * step(0.0 - rb, q.x) * bp_chain(0.0 - q.x) * big
    out = bp_put(out, dimc, hline)

    // The pointer.
    let pd = bp_seg(q, bp_dir(av) * rb * mix(0.22, 0.24, big), bp_dir(av) * (rb - Finish.snap(2.0, px)))
    out = bp_put(out, ink, Finish.cover(pd - mix(1.0, 1.5, big) * px, px))

    // The balloons of a big dial, in the lower corners of its box.
    if big > 0.5 {
        let br = max(5.5, 0.085 * rad)
        let cap = br * 0.95
        let b1 = vec2(c.x - min(0.98 * rad, c.x - br + 2.0), c.y + 0.98 * rad)
        let b2 = vec2(c.x + min(0.98 * rad, rs.x - c.x - br + 2.0), c.y + 0.98 * rad)
        let t1 = c + vec2(0.25, 0.86) * rb
        let t2 = c + vec2(0.7071, 0.7071) * rb * 0.6
        let u1 = normalize(t1 - b1)
        let u2 = normalize(t2 - b2)
        var bl = Finish.cover(abs(length(p - b1) - br) - 0.5 * px, px)
        bl = max(bl, Finish.cover(abs(length(p - b2) - br) - 0.5 * px, px))
        bl = max(bl, Finish.cover(bp_seg(p, b1 + u1 * br, t1) - 0.5 * px, px))
        bl = max(bl, Finish.cover(bp_seg(p, b2 + u2 * br, t2) - 0.5 * px, px))
        bl = max(bl, Finish.cover(min(length(p - t1), length(p - t2)) - 1.2, px))
        out = bp_put(out, dimc, bl)
        let gw = max(px, cap * 0.13)
        let g1 = bp_char(p, b1 - vec2(cap * 1.9 / 6.0, cap * 0.5), cap, 1.0, gw, px)
        let g2 = bp_char(p, b2 - vec2(cap * 2.0 / 6.0, cap * 0.5), cap, 2.0, gw, px)
        out = bp_put(out, ink, max(g1, g2))
    }

    // Focus: the marquee round the body.
    return bp_focus(out, p, c, vec2(rad, rad), rad, px, focus * live)
}
// The quad is grown by 8 points for the centre lines and the balloons. A
// box with no room for a dial of 4 points in radius draws nothing.
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(8.0, 8.0), self.rect_size + vec2(16.0, 16.0))
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(16.0, 16.0)) - vec2(8.0, 8.0)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let r = dia * 0.5 - 5.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 22.0 + dia * 0.5, px)) - self.rect_pos
    return bp_knob(p, c, max(r, 4.0), px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled, self.rect_size) * step(4.0, r)
}
mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(8.0, 8.0), self.rect_size + vec2(16.0, 16.0))
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(16.0, 16.0)) - vec2(8.0, 8.0)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let r = dia * 0.5 - 5.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px)) - self.rect_pos
    return bp_knob(p, c, max(min(r, 29.0), 4.0), px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled, self.rect_size) * step(4.0, r)
}
mod.widgets.RotaryKnob.draw_text.color = #eef6ff
mod.widgets.RotaryKnob.draw_text.color_hover = #ffffff
mod.widgets.RotaryKnob.draw_text.color_focus = #ffffff
mod.widgets.RotaryKnob.draw_text.color_drag = #ffffff
mod.widgets.RotaryKnob.draw_text.color_disabled = #86a6cb
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 8.5}

// READOUTS. The value beside a dial is a boxed figure, as a drawing boxes
// a basic dimension: the face under the two-pixel line.
let bp_readout = fn(p: vec2, o: vec2, s: vec2, px: float) -> vec4 {
    let lo = bp_lo(o, px)
    let hi = bp_hi(o, s, px)
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 2.0)
    let inside = Finish.cover(d, px)
    var out = vec4(bp_face() * 0.9 * inside, 0.9 * inside)
    return bp_put(out, bp_ink(), Finish.band(d, 0.0, 2.0 * px, px))
}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 3.0 bottom: 3.0}
mod.widgets.RotaryFlat.text_input.draw_text.color = #eef6ff
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.0}
// The value is selected while the dial is dragged, so typing replaces
// it; the selection is never painted, in any state, so the number
// stays readable under the hand.
mod.widgets.RotaryFlat.text_input.draw_selection.color = #0000
mod.widgets.RotaryFlat.text_input.draw_selection.color_hover = #0000
mod.widgets.RotaryFlat.text_input.draw_selection.color_focus = #0000
mod.widgets.RotaryFlat.text_input.draw_selection.color_down = #0000
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return bp_readout(self.pos * self.rect_size, self.rect_pos, self.rect_size, px)
}
