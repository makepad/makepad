mod.widgets.ComboBoxFlat.input.min_height = 0.0

// ---------------------------------------------------------------------------
// TEXT FIELDS. The two-pixel line round a well the paper shows through, so
// the grid runs on under the field; under the pointer the line turns white,
// on focus it takes the sky and the marquee stands off it; read only, the
// line is dashed in the dim ink.
let bp_field = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let lo = bp_lo(o, px)
    let hi = bp_hi(o, s, px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, 2.0)
    let live = 1.0 - disabled
    let hv = hover * live
    let fc = focus * live
    let dn = down * live
    let inside = Finish.cover(d, px)
    var face = mix(bp_well(), bp_face_hi(), hv * 0.4)
    face = mix(face, bp_face_lo(), dn)
    let fa = mix(0.55, 0.3, disabled)
    var out = vec4(face * fa * inside, fa * inside)
    var lc = mix(bp_ink(), bp_white(), hv)
    lc = mix(lc, bp_sky(), max(fc, dn))
    lc = mix(lc, bp_off(), disabled)
    let dash = mix(1.0, bp_dash(p.x + p.y, 5.0, 0.6), disabled)
    out = bp_put(out, lc, Finish.band(d, 0.0, 2.0 * px, px) * dash)
    return bp_focus(out, p, c, h, 2.0, px, fc)
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.border_size < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    return bp_field(p, self.rect_pos, self.rect_size, px, self.hover, self.down, self.focus, self.disabled)
}
