// OPEN LISTS. A sheet of the face under the two-pixel line; a row under
// the hand takes the wash, the chosen row a sky bar at its left and the
// wash at a third.
let bp_menu = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let d = Material.sd_box(p, size * 0.5, size * 0.5 - vec2(0.5 * px, 0.5 * px), 2.0)
    let inside = Finish.cover(d, px)
    var out = vec4(bp_face() * inside, inside)
    return bp_put(out, bp_ink(), Finish.band(d, 0.0, 2.0 * px, px))
}
let bp_row = fn(p: vec2, size: vec2, px: float, hover: float, active: float, disabled: float) -> vec4 {
    let inb = step(3.0 * px, p.x) * step(p.x, size.x - 3.0 * px)
    let a = max(0.75 * hover * (1.0 - disabled), 0.35 * active) * inb
    var out = vec4(bp_wash() * a, a)
    let bar = step(4.0 * px, p.x) * step(p.x, 7.0 * px) * step(3.0, p.y) * step(p.y, size.y - 3.0)
    return bp_put(out, bp_sky(), bar * active)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return bp_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
