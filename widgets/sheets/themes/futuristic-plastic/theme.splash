mod.theme = mod.themes.dark

// Futuristic plastic: slabs of translucent blue-grey plastic stand on a
// dark slate ground traced with faint circuits; cyan light lives inside the
// controls, along their lit foot edges and in their lamps.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #121a22
mod.theme.color_fg_app = #121a22
mod.theme.color_bg_container = #1f2a35
mod.theme.color_surface_container_lowest = #0d131a

// Raised faces: pale frosted blue-grey plastic, lighter at the head than at
// the foot; the ink on them is a deep blue-grey (label_inner below).
mod.theme.color_outset = #8faabd
mod.theme.color_outset_1 = #a3bccd
mod.theme.color_outset_2 = #7d98ac
mod.theme.color_outset_hover = #99b3c5
mod.theme.color_outset_1_hover = #adc5d5
mod.theme.color_outset_2_hover = #87a1b4
mod.theme.color_outset_down = #7b95a8
mod.theme.color_outset_1_down = #8aa3b5
mod.theme.color_outset_2_down = #6f899c
mod.theme.color_outset_focus = #8faabd
mod.theme.color_outset_1_focus = #a3bccd
mod.theme.color_outset_2_focus = #7d98ac
mod.theme.color_outset_active = #8fd2e6
mod.theme.color_outset_disabled = #26313b
mod.theme.color_outset_1_disabled = #26313b
mod.theme.color_outset_2_disabled = #26313b

// Wells: darker plastic sunk into the slab.
mod.theme.color_inset = #0f171f
mod.theme.color_inset_1 = #0f171f
mod.theme.color_inset_2 = #131c25
mod.theme.color_inset_hover = #131c25
mod.theme.color_inset_1_hover = #131c25
mod.theme.color_inset_2_hover = #16202a
mod.theme.color_inset_focus = #131c25
mod.theme.color_inset_1_focus = #131c25
mod.theme.color_inset_2_focus = #16202a
mod.theme.color_inset_active = #173a4c
mod.theme.color_inset_1_active = #173a4c
mod.theme.color_inset_2_active = #173a4c
mod.theme.color_inset_down = #0d141b
mod.theme.color_inset_1_down = #0d141b
mod.theme.color_inset_2_down = #0d141b
mod.theme.color_inset_drag = #131c25
mod.theme.color_inset_1_drag = #131c25
mod.theme.color_inset_2_drag = #131c25
mod.theme.color_inset_empty = #0f171f
mod.theme.color_inset_1_empty = #0f171f
mod.theme.color_inset_2_empty = #131c25
mod.theme.color_inset_disabled = #151d25
mod.theme.color_inset_1_disabled = #151d25
mod.theme.color_inset_2_disabled = #151d25

// The rim every stock face still draws: a pale lit edge, cyan when lit.
mod.theme.color_bevel = #9fb8c8
mod.theme.color_bevel_hover = #c0d6e2
mod.theme.color_bevel_focus = #7fe3fb
mod.theme.color_bevel_active = #c8f4ff
mod.theme.color_bevel_down = #7f97a8
mod.theme.color_bevel_disabled = #33404c
mod.theme.color_bevel_inset_1 = #070b10
mod.theme.color_bevel_inset_2 = #5c7182
mod.theme.color_bevel_outset_1 = #c7dbe6
mod.theme.color_bevel_outset_2 = #4b6475
mod.theme.color_bevel_inset_1_disabled = #1a232c
mod.theme.color_bevel_inset_2_disabled = #26313b
mod.theme.color_bevel_outset_1_disabled = #33404c
mod.theme.color_bevel_outset_2_disabled = #26313b
mod.theme.beveling = 0.5

// Ink: a cool near-white on the dark ground (the inner labels too: the
// chrome writes them on dark surfaces); the pale plastic faces name their
// own deep blue-grey ink in widgets.splash; a slate when off.
mod.theme.color_text = #eef6fb
mod.theme.color_text_hover = #ffffff
mod.theme.color_text_focus = #eef6fb
mod.theme.color_text_active = #ffffff
mod.theme.color_text_down = #ffffff
mod.theme.color_text_disabled = #5d6b78
mod.theme.color_text_placeholder = #a9bccb
mod.theme.color_text_placeholder_hover = #b8c9d6
mod.theme.color_text_val = #bfd0dc
mod.theme.color_text_meta = #a9bccb
mod.theme.color_label = #eef6fb
mod.theme.color_label_hover = #ffffff
mod.theme.color_label_focus = #eef6fb
mod.theme.color_label_active = #ffffff
mod.theme.color_label_down = #ffffff
mod.theme.color_label_disabled = #5d6b78
mod.theme.color_label_inner = #eef6fb
mod.theme.color_label_inner_hover = #ffffff
mod.theme.color_label_inner_focus = #eef6fb
mod.theme.color_label_inner_active = #ffffff
mod.theme.color_label_inner_down = #ffffff
mod.theme.color_label_inner_disabled = #5d6b78
mod.theme.color_label_outer = #eef6fb
mod.theme.color_label_outer_hover = #ffffff
mod.theme.color_label_outer_focus = #eef6fb
mod.theme.color_label_outer_active = #ffffff
mod.theme.color_label_outer_down = #ffffff
mod.theme.color_label_outer_disabled = #5d6b78
mod.theme.color_icon = #e2edf4
mod.theme.color_icon_hover = #ffffff
mod.theme.color_icon_disabled = #5d6b78
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`. Cyan light.
mod.theme.color_ctrl_selected = #56d4f2
mod.theme.color_focus = #7fe3fb
mod.theme.color_ctrl_active = #56d4f2
mod.theme.color_val = #56d4f2
mod.theme.color_cursor = #c8f4ff
mod.theme.color_text_cursor = #c8f4ff
mod.theme.color_bg_highlight = #1f4d63
mod.theme.color_bg_highlight_inline = #1f4d63
mod.theme.color_selection = #1f4d63
mod.theme.color_selection_hover = #1f4d63
mod.theme.color_selection_focus = #265c76
mod.theme.color_selection_down = #265c76
// Signals, each only where its meaning is: rose stops, amber warns.
mod.theme.color_success = #6fe8c0
mod.theme.color_warning = #f5d36b
mod.theme.color_error = #f06a8a
mod.theme.color_on_error = #2a0710
mod.theme.color_info = #56d4f2

mod.theme.color_terminal_bg = #0d131a
mod.theme.color_terminal_text = #eef6fb

// A 26 point control row, 6 point gaps.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 3.0 bottom: 0.0 left: 3.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 3.0 right: 0.0 bottom: 3.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 6.0 right: 6.0 bottom: 6.0 left: 6.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 6.0 bottom: 0.0 left: 6.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 6.0 right: 0.0 bottom: 6.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 9.0 right: 9.0 bottom: 9.0 left: 9.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 9.0 bottom: 0.0 left: 9.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 9.0 right: 0.0 bottom: 9.0 left: 0.0}
// The rungs the base froze at its own spacing, restated for this row.
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 24.0
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 32.0
mod.theme.corner_radius = 6.0
mod.theme.container_corner_radius = 10.0
mod.theme.textselection_corner_radius = 1.0

// The base's neutral grotesque at 9.5 points: a cap of about a third of the
// 26 point row. Values in the base monospace.
mod.theme.font_size_base = 9.5
mod.theme.font_size_p = 9.5
mod.theme.font_size_code = 8.0
mod.theme.font_code = mod.theme.font_code{font_size: 8.0}
mod.theme.font_regular = mod.theme.font_regular{font_size: 9.5}
mod.theme.font_bold = mod.theme.font_bold{font_size: 9.5}
mod.theme.font_label = mod.theme.font_label{font_size: 9.5}
mod.theme.font_italic = mod.theme.font_italic{font_size: 9.5}
mod.theme.font_bold_italic = mod.theme.font_bold_italic{font_size: 9.5}
mod.theme.font_size_1 = 15.0
mod.theme.font_size_2 = 12.5
mod.theme.font_size_3 = 11.0
mod.theme.font_size_4 = 9.5
mod.theme.type_title_l_size = 12.5
mod.theme.type_title_m_size = 11.0
mod.theme.type_title_s_size = 10.0
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.5 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 11.0 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 10.0 line_spacing: 1.2}
mod.theme.type_body_l_size = 10.5
mod.theme.type_body_m_size = 9.5
mod.theme.type_body_s_size = 8.25
mod.theme.type_label_l_size = 9.5
mod.theme.type_label_m_size = 8.25
mod.theme.type_label_s_size = 7.5
mod.theme.font_body_l = mod.theme.font_regular{font_size: 10.5 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 9.5 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 8.25 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 9.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 8.25 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}

// The surface ladder in blue slate, so every widget built on the roles
// stays in the family.
mod.theme.color_surface = #121a22
mod.theme.color_surface_dim = #0d131a
mod.theme.color_surface_bright = #4f6879
mod.theme.color_surface_container_low = #18212b
mod.theme.color_surface_container = #1e2833
mod.theme.color_surface_container_high = #26313d
mod.theme.color_surface_container_highest = #2f3b48
mod.theme.color_on_surface = #eef6fb
mod.theme.color_on_surface_variant = #e3edf4
mod.theme.color_outline = #8198a9
mod.theme.color_outline_variant = #3a4856
mod.theme.color_inverse_surface = #eef6fb
mod.theme.color_inverse_on_surface = #121a22
mod.theme.color_screen = #0b1218
mod.theme.color_screen_ink = #aeeefc
mod.theme.color_lamp_off = #1a232c
true
