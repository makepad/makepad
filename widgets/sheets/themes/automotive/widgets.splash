use mod.prelude.widgets_internal.*
use mod.sdf.Cap

// Automotive: a racing dash, a deck of dark brushed steel between bands of
// carbon fibre. Satin graphite caps, chrome bezels round every instrument,
// wells of dark brushed steel behind silver frames, plates of lighter steel,
// neon tubes under chrome slider caps, a rainbow bar of light cells,
// tachometer dials with a red line, amber-lit gold tabs, a red safety cover
// over the Delete switch. Every face here is drawn in true
// points (one device pixel is `px`), and every shadow, lip and glow is drawn
// OUTSIDE the layout box: the quad is grown in `vertex`, the templates that
// throw a shadow stop clipping, and no padding is spent on relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let au_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let au_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let au_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A hash that does not line up: the library's hash nearly repeats every 97
// cells, so each cell is first sent to a far cell picked by its own hash.
let au_hash = fn(i: vec2) -> float {
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j)
}
// Value noise on that hash, one unit per cell.
let au_noise = fn(q: vec2) -> float {
    let i = floor(q)
    let f = q - i
    let u = f * f * (vec2(3.0, 3.0) - f * 2.0)
    let a = au_hash(i)
    let b = au_hash(i + vec2(1.0, 0.0))
    let c = au_hash(i + vec2(0.0, 1.0))
    let d = au_hash(i + vec2(1.0, 1.0))
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}
// Horizontal brush streaks, -0.5..0.5: fine lines `s` points apart across,
// long along, over a slower wander so no two strokes run the same.
let au_brush = fn(q: vec2, s: float) -> float {
    let a = au_noise(vec2(q.x / (s * 60.0), q.y / s))
    let b = au_noise(vec2(q.x / (s * 260.0) + 3.1, q.y / (s * 5.0) + 7.7))
    return a * 0.7 + b * 0.3 - 0.5
}
// Grain, one value per device pixel, sd about 0.004 per 0.01 of `amt`.
let au_grain_at = fn(q: vec2, px: float, amt: float) -> float {
    let i = floor(q / px)
    return (au_hash(i) - au_hash(i + vec2(17.13, 3.71))) * amt
}
// A brushed-metal plate's own texture, in the plate's coordinates so it
// moves with it: fine streaks across, the unrepeating grain over them.
let au_plate_tex = fn(p: vec2, px: float) -> float {
    return au_brush(p, 0.7) * 0.030 + au_grain_at(p, px, 0.010)
}

// THE WEAVE. A two-over-two twill of tows `s` points wide, as carbon fibre
// lies under its resin: every tow floats over two cells, round across and
// dipping where it dives under at either end. Returned: the float's
// brightness 0..1 (its roundness, its dip, its fibres and a shade of its
// own), whether it runs across (1) or down (0), and how near its crown the
// point lies.
let au_weave = fn(w: vec2, s: float) -> vec3 {
    let q = w / s
    let cell = floor(q)
    let f = q - cell
    let k = cell.x + cell.y
    let n = k - 4.0 * floor(k * 0.25)
    let horiz = step(n, 1.5)
    let run = mix(n - 2.0, n, horiz)
    let across = mix(f.x, f.y, horiz)
    let along = (run + mix(f.y, f.x, horiz)) * 0.5
    let first = cell - mix(vec2(0.0, run), vec2(run, 0.0), horiz)
    let round = sin(clamp(across, 0.0, 1.0) * PI)
    let dip = smoothstep(0.0, 0.17, along) * smoothstep(0.0, 0.17, 1.0 - along)
    let own = au_hash(first + vec2(horiz * 31.0, 7.0))
    let fib = au_noise(vec2(along * 3.0 + first.x * 1.7, across * 3.5 + first.y * 2.3))
    let b = pow(round, 0.75) * (0.50 + 0.50 * dip) * (0.84 + 0.16 * fib) * (0.82 + 0.32 * own)
    return vec3(b, horiz, round * dip)
}
// Carbon fibre at window point `w`: the tows that run across catch the light
// and the ones that run down stay in shade, so the weave reads as rising
// diagonal ribs; a lit float carries a highlight along its crown. `lift`
// scales the light (a well's weave lies deeper than the ground's).
let au_carbon = fn(w: vec2, s: float, lift: float) -> vec3 {
    let v = au_weave(w, s)
    let lit = mix(0.38, 1.0, v.y)
    let crown = pow(v.z, 5.0) * v.y
    // The light lies along the ribs: brightest down the middle of each
    // rising band of lit floats, so every float shades off toward its far
    // corners and the bands read as chains of diamonds.
    let rib = 0.5 + 0.5 * cos(2.0 * PI * ((w.x + w.y) / s - 1.5) * 0.25)
    let c = vec3(0.011, 0.012, 0.014) + (vec3(0.150, 0.154, 0.164) * v.x * lit + vec3(0.050, 0.052, 0.056) * crown * v.x) * lift * (0.50 + 0.50 * rib)
    return c
}

// BRUSHED METAL at point `w` (points): every device-pixel row its own
// streaks, long ones and short fine ones, changing from row to row, so the
// grain stays crisp at the device pixel however it is scaled; a rare bright
// scratch along a row; under them a slower drift of a few rows at a time
// and a grain of single pixels. Nothing is tiled: the streaks come from the
// unaligned hash. -0.6..0.6 about.
let au_brushed = fn(w: vec2, px: float) -> float {
    let row = floor(w.y / px)
    let a = au_noise(vec2(w.x / 70.0 + au_hash(vec2(row, 3.0)) * 40.0, row))
    let f = au_noise(vec2(w.x / 13.0 + au_hash(vec2(row, 11.0)) * 90.0, row + 517.0))
    let b = au_noise(vec2(w.x / 380.0 + 7.0, w.y / (px * 9.0)))
    let c = au_hash(vec2(floor(w.x / px), row)) - 0.5
    let seg = floor(w.x / 50.0 + au_hash(vec2(row, 7.0)) * 3.0)
    let scr = step(0.993, au_hash(vec2(row, seg))) * smoothstep(0.0, 0.3, au_noise(vec2(w.x / 9.0, row + 91.0)))
    return (a - 0.5) * 0.80 + (f - 0.5) * 0.50 + (b - 0.5) * 0.22 + c * 0.18 + scr * 0.9
}

// The deck the controls stand on: charcoal steel, #2a2c30 at its darkest to
// #33363b where the light lies, brushed across in fine crisp streaks, with
// a broad soft sheen running down from the upper left and a slow cloud of
// light over it. `ww`, `wh` the window's size; `w` a window point.
let au_deck = fn(w: vec2, px: float, ww: float, wh: float) -> vec3 {
    let u = w.x / max(ww, 1.0)
    let v = w.y / max(wh, 1.0)
    let s = u - 0.38 + 0.45 * (v - 0.4)
    let sheen = exp(-s * s / 0.07)
    let cloud = au_noise(w / 260.0 + vec2(5.0, 1.0)) - 0.5
    let lv = 0.168 + 0.030 * sheen + 0.010 * cloud
    let br = au_brushed(w, px) * 0.040
    let k = lv + br
    return vec3(k, k * 1.045, k * 1.13)
}

// A PLATE OF STEEL lighter than the deck, at point `p` of the plate (so it
// moves with it), `t` 0..1 down it and `u` 0..1 across: #535659 under its
// top edge falling to #43464a at its foot, brushed across in the deck's
// crisp streaks, a broad soft sheen sweeping down from the upper middle.
// Held under #555 everywhere, so light words keep 5:1 on it.
let au_steel = fn(p: vec2, px: float, t: float, u: float) -> vec3 {
    let k0 = mix(0.312, 0.262, smoothstep(0.0, 1.0, t))
    let s = u - 0.62 + 0.55 * t
    let sheen = exp(-s * s / 0.05) * (1.0 - 0.5 * t)
    let k = min(k0 + 0.020 * sheen + au_brushed(p, px) * 0.036, 0.334)
    return vec3(k, k * 1.03, k * 1.075)
}
// A dark well of the same brushed steel, for the floors of fields.
let au_dark_steel = fn(p: vec2, px: float, lift: float) -> vec3 {
    let k = 0.082 + 0.022 * lift + au_brushed(p, px) * 0.032
    return vec3(k, k * 1.04, k * 1.12)
}

// A HEXAGON MESH at point `m` (points, the mesh's own origin a hole's
// middle): hexagonal holes `s` points apart on a hex lattice, each hole's
// flat sides left and right, in a web `web` points wide. The web is `webc`
// steel; its edge round each hole catches the light where it faces up (the
// rim over the hole) and falls dark where it faces down; down in a hole
// the lower wall shows a little light. Crisp at the device pixel.
let au_mesh = fn(m: vec2, s: float, web: float, px: float, webc: vec3, lit: float) -> vec3 {
    let r = vec2(s, s * 1.7320508)
    let hh = r * 0.5
    let a = m - r * floor(m / r) - hh
    let b0 = m - hh
    let b = b0 - r * floor(b0 / r) - hh
    var q = b
    if dot(a, a) < dot(b, b) {
        q = a
    }
    let aq = abs(q)
    let dh = max(aq.x, dot(aq, vec2(0.5, 0.8660254)))
    let ap = s * 0.5 - web * 0.5
    let d = dh - ap
    let facing = -q.y / max(length(q), 0.001)
    var wc = webc
    let rim = Finish.ring_out(d, 0.0, px, px)
    let rim2 = Finish.ring_out(d, px, px * 2.0, px)
    wc = mix(wc, min(webc * 1.9 + vec3(0.10, 0.10, 0.105), vec3(1.0, 1.0, 1.0)), rim * smoothstep(0.15, 0.85, facing) * lit)
    wc = mix(wc, min(webc * 1.35 + vec3(0.03, 0.03, 0.03), vec3(1.0, 1.0, 1.0)), rim2 * smoothstep(0.3, 0.9, facing) * lit * 0.6)
    wc = mix(wc, webc * 0.45, rim * smoothstep(0.15, 0.85, -facing))
    let floor_lit = smoothstep(0.2, 1.0, q.y / max(ap, 0.1))
    let hc = vec3(0.010, 0.010, 0.012) + vec3(0.050, 0.051, 0.054) * floor_lit * lit
    return mix(wc, hc, Finish.cover(d, px))
}

// The window ground at a window point `w` (points) in a window `ww` by `wh`
// points. The deck of brushed steel takes the middle of the window; the
// carbon weave shows only in a band along the top (under the caption and
// the tool bar) and a band along the bottom. The deck stands a little proud
// of the weave: its corners are cut at 45 degrees, its top edge is a lit
// bevel two device pixels deep over a black seam, its foot a dark bevel
// over the black seam, and it throws a short shadow down onto the weave
// under it, gone within six points. Nothing here moves with a scrolled view.
let au_ground = fn(w: vec2, px: float, ww: float, wh: float) -> vec3 {
    let top = Finish.snap(88.0, px)
    let bot = Finish.snap(wh - min(215.0, 0.172 * wh), px)
    let c = vec2(ww * 0.5, (top + bot) * 0.5)
    let h = vec2(ww * 0.5 + px * 0.5, (bot - top) * 0.5)
    let d = Finish.sd_chamfer(w, c, h, 22.0)
    // The weave, under a slow light lying toward the top of the window.
    let dx = (w.x - ww * 0.42) / max(ww * 0.55, 1.0)
    let cloud = au_noise(w / 190.0) * 0.6 + au_noise(w / 63.0 + vec2(11.0, 3.0)) * 0.4
    let light = exp(-dx * dx) * (0.85 + 0.35 * cloud)
    var cb = au_carbon(w, 4.2, light)
    let g = au_grain_at(w, px, 0.006)
    cb = cb + vec3(g, g, g)
    // The deck's shadow on the weave: under its foot and its lower cuts.
    let sh = Finish.drop(w, c + vec2(0.0, 2.0), h, 2.0, vec2(0.0, 0.0), 2.6) * 0.7
    cb = cb * (1.0 - sh * step(c.y, w.y))
    // The deck and its bevel, lit by the way its edge faces.
    var dk = au_deck(w, px, ww, wh)
    let e = px * 0.5
    let gx = Finish.sd_chamfer(w + vec2(e, 0.0), c, h, 22.0) - Finish.sd_chamfer(w - vec2(e, 0.0), c, h, 22.0)
    let gy = Finish.sd_chamfer(w + vec2(0.0, e), c, h, 22.0) - Finish.sd_chamfer(w - vec2(0.0, e), c, h, 22.0)
    let n = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    let up = smoothstep(0.2, 0.9, dot(n, vec2(-0.30, -0.95)))
    let down = smoothstep(0.2, 0.9, n.y)
    let r1 = Finish.band(d, px, px * 2.0, px)
    let r2 = Finish.band(d, px * 2.0, px * 3.0, px)
    let r3 = Finish.band(d, px * 3.0, px * 4.0, px)
    dk = mix(dk, vec3(0.540, 0.552, 0.575), r1 * up)
    dk = mix(dk, vec3(0.380, 0.390, 0.410), r2 * up)
    dk = mix(dk, vec3(0.270, 0.278, 0.295), r3 * up)
    dk = mix(dk, vec3(0.085, 0.088, 0.095), (r1 + r2) * down)
    dk = mix(dk, vec3(0.120, 0.124, 0.132), r3 * down)
    dk = mix(dk, vec3(0.006, 0.006, 0.008), Finish.band(d, 0.0, px, px))
    return mix(cb, dk, Finish.cover(d, px))
}

// The room a chrome bezel mirrors, fixed on the screen so the pattern stands
// still as a knob turns: grey walls, pale toward the viewer, darker at the
// height of the bezel's middle, paler overhead than below; a big soft box up
// and to the left and a bright window down and to the right; a dark doorway
// on either side; a pale lamp low down and a dim shelf up and to the left.
// Each shape is an oval with a sharp edge, so on a turned band it lies as a
// crisp crescent, as reflections lie in polished chrome. `r` the mirrored
// direction (x right, y down, z toward the viewer); `wide` 1 on a band wide
// enough for the detail, 0 on a narrow one.
let au_room_patch = fn(a: float, z: float, a0: float, wa: float, z0: float, wz: float, soft: float) -> float {
    let da = atan2(sin(a - a0), cos(a - a0)) / wa
    let dz = (z - z0) / wz
    return 1.0 - smoothstep(1.0 - soft, 1.0, da * da + dz * dz)
}
let au_chrome_room = fn(r: vec3, wide: float) -> vec3 {
    let a = atan2(r.y, r.x)
    let z = r.z
    let k = mix(0.45, 0.25, wide)
    var w = mix(0.36, 0.66, smoothstep(0.0, 0.6, z))
    w = mix(w, 0.52, 1.0 - smoothstep(-0.70, -0.35, z))
    var c = vec3(w, w + 0.005, w + 0.015) + vec3(0.07, 0.07, 0.07) * clamp(-r.y, -1.0, 1.0)
    c = mix(c, vec3(1.0, 1.0, 1.0), au_room_patch(a, z, -2.25, 0.62, 0.05, 0.50, k))
    c = mix(c, vec3(0.96, 0.96, 0.95), au_room_patch(a, z, 0.80, 0.55, -0.15, 0.55, k))
    c = mix(c, vec3(0.05, 0.05, 0.055), au_room_patch(a, z, 0.0, 0.42, -0.30, 0.55, k))
    c = mix(c, vec3(0.08, 0.08, 0.09), au_room_patch(a, z, 3.14159265, 0.50, 0.25, 0.60, k))
    c = mix(c, vec3(0.70, 0.71, 0.73), au_room_patch(a, z, 1.80, 0.40, 0.30, 0.42, k) * wide)
    c = mix(c, vec3(0.40, 0.41, 0.43), au_room_patch(a, z, -2.80, 0.22, 0.45, 0.30, k) * wide)
    return c * mix(1.0, 0.9, smoothstep(0.55, 0.90, z))
}

// A polished chrome ring round `c` from `r0` to `r1`: the band turns from
// facing the viewer at its inner edge to facing out at its outer edge, and
// mirrors the room along that turn; a black line at either edge.
// Premultiplied.
let au_chrome_ring = fn(p: vec2, c: vec2, r0: float, r1: float, px: float, bright: float) -> vec4 {
    let q = p - c
    let rl = length(q)
    let nk = q / max(rl, 0.001)
    let w = max(r1 - r0, px)
    let u = clamp((rl - r0) / w, 0.0, 1.0)
    let wide = smoothstep(3.0, 9.0, w / px)
    let th = mix(mix(0.62, 0.30, wide), mix(0.98, 1.20, wide), u)
    var col = au_chrome_room(vec3(nk * sin(2.0 * th), cos(2.0 * th)), wide)
    col = min(col * (1.0 + 0.10 * bright) + vec3(0.04, 0.04, 0.04) * bright, vec3(1.0, 1.0, 1.0))
    let d = abs(rl - (r0 + r1) * 0.5) - w * 0.5
    col = mix(col, vec3(0.02, 0.02, 0.025), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// The five neon colours of the slider tubes: blue, green, yellow, orange,
// purple, picked by `k` round the five.
let au_neon = fn(k: float) -> vec3 {
    let i = k - 5.0 * floor(k / 5.0 + 0.001)
    if i < 0.5 {
        return vec3(0.22, 0.80, 1.0)
    }
    if i < 1.5 {
        return vec3(0.22, 1.0, 0.46)
    }
    if i < 2.5 {
        return vec3(1.0, 0.93, 0.24)
    }
    if i < 3.5 {
        return vec3(1.0, 0.56, 0.18)
    }
    return vec3(0.80, 0.34, 1.0)
}
// Every slider's tube burns the same neon blue. A colour picked from where
// a slider stands would change as its view scrolls, and a slider has
// nothing else to tell it apart from its neighbours; the rainbow is kept
// for the feedback bars.
let au_neon_at = fn(o: vec2) -> vec3 {
    return au_neon(0.0)
}

// The rainbow of the feedback bars at `t` 0..1: violet, blue, cyan, green,
// yellow, orange.
let au_rainbow = fn(t: float) -> vec3 {
    let x = clamp(t, 0.0, 1.0) * 5.0
    let a = vec3(0.70, 0.30, 1.0)
    let b = vec3(0.24, 0.48, 1.0)
    let c = vec3(0.16, 0.90, 1.0)
    let d = vec3(0.26, 1.0, 0.36)
    let e = vec3(1.0, 0.92, 0.22)
    let f = vec3(1.0, 0.56, 0.16)
    var col = mix(a, b, clamp(x, 0.0, 1.0))
    col = mix(col, c, clamp(x - 1.0, 0.0, 1.0))
    col = mix(col, d, clamp(x - 2.0, 0.0, 1.0))
    col = mix(col, e, clamp(x - 3.0, 0.0, 1.0))
    return mix(col, f, clamp(x - 4.0, 0.0, 1.0))
}

// 1 when bit `b` (a power of two) of `m` is set.
let au_bit = fn(m: float, b: float) -> float {
    return step(0.25, fract(floor(m / b) * 0.5))
}
// A gauge numeral: the distance to the centre line of digit `d` drawn as a
// squared dash type, in glyph units (0.56 wide, 1 tall, top at 0). The
// strokes meet in round joints; the one, the four and the seven are drawn
// as type draws them, not as segments.
let au_glyph = fn(q: vec2, d: float) -> float {
    let n = floor(d + 0.5)
    let tl = vec2(0.0, 0.0)
    let tr = vec2(0.52, 0.0)
    let ml = vec2(0.0, 0.5)
    let mr = vec2(0.52, 0.5)
    let bl = vec2(0.0, 1.0)
    let br = vec2(0.52, 1.0)
    var m = 63.0
    if n > 1.5 {
        m = 91.0
    }
    if n > 2.5 {
        m = 79.0
    }
    if n > 4.5 {
        m = 109.0
    }
    if n > 5.5 {
        m = 125.0
    }
    if n > 7.5 {
        m = 127.0
    }
    if n > 8.5 {
        m = 111.0
    }
    var r = 10.0
    r = min(r, au_seg(q, tl, tr) + (1.0 - au_bit(m, 1.0)) * 10.0)
    r = min(r, au_seg(q, tr, mr) + (1.0 - au_bit(m, 2.0)) * 10.0)
    r = min(r, au_seg(q, mr, br) + (1.0 - au_bit(m, 4.0)) * 10.0)
    r = min(r, au_seg(q, bl, br) + (1.0 - au_bit(m, 8.0)) * 10.0)
    r = min(r, au_seg(q, ml, bl) + (1.0 - au_bit(m, 16.0)) * 10.0)
    r = min(r, au_seg(q, tl, ml) + (1.0 - au_bit(m, 32.0)) * 10.0)
    r = min(r, au_seg(q, ml, mr) + (1.0 - au_bit(m, 64.0)) * 10.0)
    if n > 0.5 && n < 1.5 {
        r = min(au_seg(q, vec2(0.30, 0.0), vec2(0.30, 1.0)), au_seg(q, vec2(0.30, 0.0), vec2(0.08, 0.20)))
    }
    if n > 3.5 && n < 4.5 {
        r = min(min(au_seg(q, vec2(0.40, 0.0), vec2(0.40, 1.0)), au_seg(q, vec2(0.40, 0.0), vec2(0.0, 0.66))), au_seg(q, vec2(0.0, 0.66), vec2(0.56, 0.66)))
    }
    if n > 6.5 && n < 7.5 {
        r = min(au_seg(q, tl, tr), au_seg(q, tr, vec2(0.16, 1.0)))
    }
    return r
}
// A number 0..99 set at `c` (its middle), `h` points tall, leaning like
// dash type; the distance to its strokes in points less half the stroke.
let au_number = fn(p: vec2, c: vec2, h: float, v: float, stroke: float) -> float {
    let n = floor(v + 0.5)
    let two = step(9.5, n)
    let gw = 0.56 * h
    let gap = 0.22 * h
    let tw = gw + two * (gw + gap)
    var q = (p - c + vec2(tw * 0.5, h * 0.5)) / h
    q = vec2(q.x - (0.5 - q.y) * 0.16, q.y)
    let tens = floor(n / 10.0)
    let ones = n - tens * 10.0
    var d = au_glyph(q - vec2(two * (0.56 + 0.22), 0.0), ones)
    if two > 0.5 {
        d = min(d, au_glyph(q, tens))
    }
    return d * h - stroke * 0.5
}

// A raised graphite cap: the drop and contact shadows under it, the black
// outline, the satin face falling from the light at the top, the soft top
// edge, the faint side light, the bottom rim. `lift` 1 casts the drop
// shadow, 0 seats the cap on the ground with the contact shadow only. `rim`
// is the bottom rim's ink. Premultiplied.
let au_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, disabled: float, focus: float, lift: float, tint: vec3, rim: vec4, gloss: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 24.0)
    let d = Material.sd_box(p, c, h, r)
    let up = (1.0 - down) * (1.0 - disabled)
    let small = 1.0 - step(23.5, hh)

    // What the cap throws: a dense shadow under its foot over a soft fall
    // gone within half an 8 point gap to the sides.
    let drop1 = Finish.drop(p, c, h - vec2(0.06 * sh_h, 0.0), r, vec2(0.0, 0.06 * sh_h), 0.05 * sh_h) * 0.92
    let drop2 = Finish.drop(p, c, h - vec2(0.14 * sh_h, 0.02 * sh_h), r, vec2(0.0, 0.12 * sh_h), 0.15 * sh_h) * 0.8
    let drop = (1.0 - (1.0 - drop1) * (1.0 - drop2)) * lift * up
    let contact = Finish.drop(p, c, h, r, vec2(0.0, px), px * 0.6) * 0.9 * (1.0 - 0.6 * disabled)
    let sh = 1.0 - (1.0 - drop) * (1.0 - contact)
    var under = vec4(0.0, 0.0, 0.0, sh)
    // A held cap sits in the ground: a 1 dp lip shows under its foot.
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y + h.y * 0.5, p.y) * down * (1.0 - disabled)
    under = Finish.over(under, vec4(0.30, 0.31, 0.33, 1.0) * lip)

    // The face: satin graphite, #45474b under the top edge falling to
    // #222326 at the foot, brushed across.
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let ft = 1.0 - pow(1.0 - t, 1.4)
    var face = mix(vec3(0.270, 0.276, 0.290), vec3(0.133, 0.137, 0.148), ft) + tint
    let tx = au_plate_tex(p, px)
    face = face + vec3(tx, tx, tx) * 0.7 * up
    face = face + vec3(0.045, 0.046, 0.049) * (1.0 + small) * hover * up
    // Held or chosen: sunk, a floor that falls a little and a shade under
    // the top edge.
    let shade = 0.6 * (1.0 - smoothstep(0.0, 0.24 * min(hh, 24.0), p.y - lo.y - px))
    let held = mix(mix(vec3(0.098, 0.100, 0.108), vec3(0.074, 0.076, 0.082), t) + tint, vec3(0.0, 0.0, 0.0), shade)
    face = mix(face, held, down * (1.0 - disabled))
    face = mix(face, mix(vec3(0.115, 0.117, 0.124), vec3(0.090, 0.092, 0.098), t), disabled)

    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    let r1 = Finish.band(d, px, px * 2.0, px)
    let r2 = Finish.band(d, px * 2.0, px * 3.0, px)
    // A satin sheen over the upper part of the face, and a soft bloom on
    // its upper left where the light lands.
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    face = face + vec3(0.036, 0.037, 0.040) * Finish.sheen(uv, 0.0, 0.5, 0.25) * up * (0.6 + 0.4 * gloss)
    let sw = max(min(0.30 * (hi.x - lo.x), 20.0), 2.0)
    let sq = (p - vec2(lo.x + min(0.24 * (hi.x - lo.x), 16.0), lo.y + 0.10 * hh)) / vec2(sw, max(0.24 * hh, 1.5))
    face = face + vec3(0.050, 0.051, 0.054) * exp(-dot(sq, sq)) * up
    // The edge: a light row along the top (#8a8c90), half of it under, a
    // white catch on the top-left corner, a quieter line down the sides.
    let topw = smoothstep(0.45, 0.97, -n.y)
    let botw = smoothstep(0.45, 0.97, n.y)
    let sidew = smoothstep(0.6, 1.0, abs(n.x))
    let hot = mix(vec3(0.500, 0.508, 0.528), vec3(0.600, 0.608, 0.626), max(gloss, hover))
    face = mix(face, hot, r1 * topw * up)
    face = mix(face, hot * 0.6, r2 * topw * up * 0.6)
    let nl = dot(n, vec2(-0.62, -0.78))
    face = mix(face, vec3(0.86, 0.87, 0.89), r1 * smoothstep(0.93, 0.995, nl) * up * 0.8)
    let sidec = mix(vec3(0.330, 0.336, 0.352), vec3(0.180, 0.184, 0.196), t)
    face = mix(face, sidec, r1 * sidew * (0.35 + 0.65 * up))
    face = mix(face, rim.rgb, (r1 + 0.35 * r2) * botw * rim.a * (1.0 - disabled))
    let ol = mix(vec3(0.024, 0.024, 0.028), vec3(0.008, 0.008, 0.010), t)
    face = mix(face, mix(ol, vec3(0.030, 0.031, 0.034), disabled), Finish.band(d, 0.0, px, px))

    let a = Finish.cover(d, px) * (1.0 - 0.25 * disabled)
    var o = Finish.over(under, vec4(face * a, a))
    // Focus: a thin blue ring just outside the outline, and a breath of it.
    let ring = Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.glow(d - px, 0.7) * 0.3 * (1.0 - Finish.cover(d, px))
    o = Finish.over(o, vec4(0.227, 0.612, 1.0, 1.0) * clamp(ring, 0.0, 1.0) * focus * (1.0 - disabled))
    return o
}

// An LED bar or dot laid over `dst`: a white-hot core, a 1 dp saturated rim
// and a short halo when lit (`halo` scales it); a dark lens when not (a bar:
// one dark glass). `hs` is the half size; the ends are round.
let au_led = fn(dst: vec4, p: vec2, c: vec2, hs: vec2, lit: float, halo: float, px: float, core: vec3, rimc: vec3) -> vec4 {
    let d = Finish.sd_pill(p, c, hs)
    let slot = Finish.cover(d, px)
    let tl = clamp((p.y - (c.y - hs.y)) / max(2.0 * hs.y, px), 0.0, 1.0)
    var lens = mix(vec3(0.150, 0.152, 0.165), vec3(0.060, 0.062, 0.068), smoothstep(0.2, 0.9, tl))
    lens = mix(lens, rimc * 0.22, 0.25)
    let sp = p - (c + vec2(-0.3 * hs.x, -0.35 * hs.y))
    lens = lens + vec3(0.16, 0.16, 0.17) * exp(-dot(sp, sp) / max(2.0 * 0.09 * hs.y * hs.y, 0.001)) * step(1.5, hs.y)
    let bar = step(hs.y * 2.5, hs.x)
    let gc = c + vec2(0.0, px * 0.5)
    let gd = Finish.sd_pill(p, gc, vec2(hs.x + px * 0.5, px * 1.5))
    let gt = clamp((p.y - (gc.y - px * 1.5)) / (px * 3.0), 0.0, 1.0)
    var glass = mix(vec3(0.110, 0.112, 0.122), vec3(0.070, 0.072, 0.078), gt)
    glass = mix(glass, rimc, 0.08) + vec3(0.03, 0.03, 0.03) * (1.0 - step(gc.y - px * 0.5, p.y))
    var o = Finish.over(dst, vec4(0.016, 0.016, 0.020, 1.0) * Finish.ring_out(d, 0.0, px, px) * 0.55 * (1.0 - lit) * (1.0 - bar))
    o = Finish.over(o, vec4(lens, 1.0) * slot * (1.0 - lit) * (1.0 - bar))
    o = Finish.over(o, vec4(glass, 1.0) * Finish.cover(gd, px) * (1.0 - lit) * bar)
    let x = max(d - px, 0.0)
    let g = (0.45 * exp(-(x * x) / (2.0 * 0.5 * 0.5)) + 0.22 * exp(-(x * x) / (2.0 * 1.4 * 1.4))) * (1.0 - slot)
    o = Finish.over(o, vec4(rimc, 1.0) * g * 0.8 * halo * lit)
    let rim = Finish.ring_out(d, 0.0, px, px)
    o = Finish.over(o, vec4(rimc, 1.0) * rim * lit)
    let hot = 1.0 - smoothstep(0.0, hs.y * 1.2, p.y - (c.y - hs.y))
    let col = mix(core, vec3(1.0, 1.0, 1.0), hot * 0.5)
    o = Finish.over(o, vec4(col, 1.0) * slot * lit)
    return o
}

// A lamp lying in the bottom rim of a lit cap: a white-hot bar three device
// pixels tall and `hw` half wide whose last row is `yb`, the glow's colour
// on the face round it, a pale halo hugging the bar, and a spill that runs
// out past the outline onto the ground under the cap. `inside` is the cap's
// cover, `below` 1 on the ground under it. Premultiplied over `dst`.
let au_rim_lamp = fn(dst: vec4, p: vec2, cx: float, hw: float, yb: float, px: float, lit: float, halo: float, core: vec3, glow: vec3, inside: float, below: float) -> vec4 {
    let cy = yb - px
    let d = Finish.sd_pill(p, vec2(cx, cy), vec2(hw, px * 1.5))
    let ex = max(abs(p.x - cx) - hw, 0.0)
    let dy = max(cy - p.y, 0.0)
    let fg = exp(-ex / 4.0) * exp(-dy / 2.0)
    var o = Finish.over(dst, vec4(glow, 1.0) * clamp(fg * 0.6 * halo, 0.0, 1.0) * inside * lit)
    let x = max(d, 0.0)
    let tight = exp(-(x * x) / (2.0 * 0.7 * 0.7)) * (1.0 - Finish.cover(d, px))
    o = Finish.over(o, vec4(mix(glow, core, 0.55), 1.0) * tight * 0.85 * halo * lit * max(inside, below))
    let sy = max(p.y - yb, 0.0)
    let sp = exp(-(ex * ex) / (2.0 * 5.0 * 5.0)) * (0.35 * exp(-sy / 1.6) + 0.30 * exp(-sy / 5.0))
    o = Finish.over(o, vec4(glow * 0.75, 1.0) * sp * below * halo * lit)
    return Finish.over(o, vec4(core, 1.0) * Finish.cover(d, px) * lit)
}

// The three-quarter arc a waiting button turns in place of its label.
let au_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(0.94, 0.98, 1.0, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is the same slim cap: 26 points on a 13 point line, 10
// points either side. Its shadow falls outside the box, so the box is the
// outline and nothing is paid in padding.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
// Glyphs sit at 14 points so an icon never makes a cap taller than the row;
// an icon alone gets a square cap.
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonSecondary.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
// The safety cover's hinge takes the first five points of its box: the
// legend keeps ten points clear of it.
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 15.0 right: 10.0 top: 4.0 bottom: 4.0}
// The short rungs keep their own heights under the row minimum.
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
// The smallest rung's label one step down, so its cap height is a third of
// its cap like every other rung's.
mod.widgets.ButtonXs.draw_text.text_style.font_size = 7.0
mod.widgets.ButtonFlat.draw_bg.border_radius = uniform(1.0)
mod.widgets.ButtonFlat.draw_bg.border_size = uniform(0.34)
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// THE SAFETY COVER: the Delete cap is a flip-up cover of red moulded plastic
// over its switch, hinged on the left. A dark base plate shows round the
// hinge, a chrome hinge barrel stands on it, and the cover runs from the
// barrel to the right end: glossy red falling from the light at the top, a
// hard white reflection across its upper part, a raised lip at the far end
// where a finger lifts it, a dark rim at its foot, and its own shadow on
// the plate. Under the hand it brightens; held, it presses down and dims.
let au_cover = fn(p: vec2, lo: vec2, hi: vec2, px: float, hover: float, down: float, disabled: float, focus: float) -> vec4 {
    let up = (1.0 - down) * (1.0 - disabled)
    var res = au_cap(p, lo, hi, 3.0, px, 0.0, down, disabled, 0.0, 1.0, vec3(-0.04, -0.04, -0.04), vec4(0.20, 0.20, 0.21, 1.0), 0.0)
    // The cover's box, from the hinge to the right end.
    let clo = vec2(lo.x + 4.5, lo.y + 1.5)
    let chi = vec2(hi.x - 1.5, hi.y - 2.0)
    let cc = (clo + chi) * 0.5
    let ch = (chi - clo) * 0.5
    let rc = 3.5
    let d = Material.sd_box(p, cc, ch, rc)
    // Its shadow on the plate: it stands a point and a half above it.
    let sh = Finish.drop(p, cc, ch, rc, vec2(0.8, 1.2) * (1.0 - 0.6 * down), 1.0) * 0.7 * (1.0 - Finish.cover(d, px))
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, sh * Finish.cover(Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 3.0), px)))
    let t = clamp((p.y - clo.y) / max(chi.y - clo.y, 1.0), 0.0, 1.0)
    let u = clamp((p.x - clo.x) / max(chi.x - clo.x, 1.0), 0.0, 1.0)
    var red = mix(vec3(0.800, 0.070, 0.060), vec3(0.380, 0.020, 0.020), smoothstep(0.0, 1.0, t))
    red = red + vec3(0.12, 0.03, 0.03) * hover * up
    // The moulding: the body a shade darker toward the hinge, the lip at the
    // far end standing up into the light.
    red = red * (0.86 + 0.14 * u)
    let lipx = smoothstep(chi.x - 7.0, chi.x - 4.5, p.x)
    red = mix(red, mix(vec3(0.95, 0.16, 0.13), vec3(0.50, 0.03, 0.03), t), lipx * 0.85)
    red = mix(red, red * 0.55, smoothstep(chi.x - 7.5, chi.x - 6.5, p.x) * (1.0 - smoothstep(chi.x - 6.5, chi.x - 5.5, p.x)) * 0.8)
    // The reflection: a hard pale band across the upper third of the
    // gloss, fading toward the hinge, and a white catch on the lip.
    let band = smoothstep(0.06, 0.12, t) * (1.0 - smoothstep(0.24, 0.34, t)) * smoothstep(0.0, 0.25, u)
    red = mix(red, vec3(1.0, 0.86, 0.84), band * 0.34 * up)
    let lc = (p - vec2(chi.x - 4.0, clo.y + 3.0)) / vec2(1.6, 1.4)
    red = mix(red, vec3(1.0, 0.92, 0.90), exp(-dot(lc, lc)) * 0.8 * up)
    // The rims: a pink top edge, a deep red foot, the black outline.
    let r1 = Finish.band(d, px, px * 2.0, px)
    red = mix(red, vec3(1.0, 0.50, 0.46), r1 * (1.0 - step(cc.y, p.y)) * 0.7 * up)
    red = mix(red, vec3(0.22, 0.01, 0.01), r1 * step(cc.y, p.y) * 0.8)
    red = red * (1.0 - 0.35 * down)
    let gl = Finish.lum(red)
    red = mix(red, vec3(gl, gl, gl) * 0.7 + vec3(0.05, 0.02, 0.02), disabled)
    red = mix(red, vec3(0.06, 0.0, 0.0), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    res = Finish.over(res, vec4(red * a, a))
    // The hinge: a chrome barrel down the left of the cover, round across,
    // with a dark seam at either end.
    let hlo = vec2(lo.x + 2.0, lo.y + 3.0)
    let hhi = vec2(lo.x + 6.5, hi.y - 3.5)
    let hd = Material.sd_box(p, (hlo + hhi) * 0.5, (hhi - hlo) * 0.5, 1.5)
    let hx = clamp((p.x - hlo.x) / max(hhi.x - hlo.x, 0.5), 0.0, 1.0)
    var hc = mix(vec3(0.30, 0.30, 0.32), vec3(0.95, 0.95, 0.96), exp(-(hx - 0.35) * (hx - 0.35) / 0.04))
    hc = mix(hc, vec3(0.12, 0.12, 0.13), smoothstep(0.75, 1.0, hx) * 0.8)
    let hm = (hlo.y + hhi.y) * 0.5
    let seam = (1.0 - smoothstep(px * 0.5, px * 1.5, abs(p.y - (hm - 2.5)))) + (1.0 - smoothstep(px * 0.5, px * 1.5, abs(p.y - (hm + 2.5))))
    hc = mix(hc, vec3(0.05, 0.05, 0.06), clamp(seam, 0.0, 1.0) * 0.8)
    hc = mix(hc, vec3(0.03, 0.03, 0.035), Finish.band(hd, 0.0, px, px))
    hc = mix(hc, hc * 0.5, disabled)
    let ha = Finish.cover(hd, px)
    res = Finish.over(res, vec4(hc * ha, ha))
    let ring = Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.glow(d - px, 0.7) * 0.3 * (1.0 - a)
    return Finish.over(res, vec4(0.227, 0.612, 1.0, 1.0) * clamp(ring, 0.0, 1.0) * focus * (1.0 - disabled))
}

// The cap and its states, shared by every button template; `kind` picks the
// variant: 0 flat (a legend on the ground, a cap only under the hand), 1
// raised cap, 2 primary (the blue lit rim), 3 secondary (a chrome trim), 4
// tertiary (a carbon inlay), 5 danger (the safety cover), 6 outline, 7
// flatter.
let au_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 14.0
    let px = au_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(au_snap(0.0, o.x, px), au_snap(0.0, o.y, px))
    let hi = vec2(au_snap(size.x, o.x, px), au_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = 3.5
    let d = Material.sd_box(p, c, h, r)
    let inside = Finish.cover(d, px)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 4.5 && kind < 5.5 {
        res = au_cover(p, lo, hi, px, hover, down, disabled, focus)
    } else {
        if kind < 0.5 || kind > 5.5 {
            // Flat, outline, flatter: no cap at rest. Under the hand a faint
            // cap shows; held, it sinks.
            if kind > 5.5 && kind < 6.5 {
                // Outline: a frame of silver round a window on the ground,
                // the weave under a light smoke.
                var ring = Finish.band(d, 0.0, px, px)
                if dash > 0.0 {
                    ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
                }
                let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
                res = vec4(0.0, 0.0, 0.0, 0.32) * inside
                let sil = mix(vec3(0.62, 0.63, 0.65), vec3(0.34, 0.35, 0.37), t) * (1.0 - 0.5 * disabled)
                res = Finish.over(res, vec4(0.0, 0.0, 0.0, 1.0) * Finish.band(d, px, px * 2.0, px) * 0.7)
                res = Finish.over(res, vec4(sil, 1.0) * ring)
                res = Finish.over(res, vec4(0.0, 0.0, 0.0, 1.0) * Finish.ring_out(d, 0.0, px, px) * 0.6)
            }
            if hover + down > 0.001 && kind < 6.5 {
                let k = mix(0.75, 1.0, down)
                res = Finish.over(res, au_cap(p, lo, hi, r, px, hover, down, disabled, 0.0, 0.0, vec3(0.0, 0.0, 0.0), vec4(0.20, 0.20, 0.21, 1.0), 1.0) * clamp(max(hover, down), 0.0, 1.0) * k)
            }
            if kind > 5.5 && kind < 6.5 && hover + down > 0.001 {
                res = Finish.over(res, au_cap(p, lo, hi, r, px, hover, down, disabled, 0.0, 0.0, vec3(0.0, 0.0, 0.0), vec4(0.20, 0.20, 0.21, 1.0), 1.0) * clamp(max(hover, down), 0.0, 1.0) * 0.8)
            }
            let fr = Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.glow(d - px, 0.7) * 0.3 * (1.0 - inside)
            res = Finish.over(res, vec4(0.227, 0.612, 1.0, 1.0) * clamp(fr, 0.0, 1.0) * focus * (1.0 - disabled))
        } else {
            var tint = vec3(0.0, 0.0, 0.0)
            let lit = 1.0 - disabled
            if kind > 1.5 && kind < 2.5 {
                // Primary: the face cast deep blue by its own rim light.
                tint = vec3(-0.070, -0.022, 0.030) * lit
            }
            if kind > 3.5 && kind < 4.5 {
                tint = vec3(-0.040, -0.040, -0.040)
            }
            let prim = step(1.5, kind) * step(kind, 2.5)
            res = au_cap(p, lo, hi, r, px, hover, down, disabled, focus * (1.0 - prim), 1.0, tint, vec4(0.20, 0.20, 0.21, 1.0), 1.0)
            let up = (1.0 - down) * lit
            if kind > 3.5 && kind < 4.5 {
                // Tertiary: a panel of the weave let into the face under a
                // satin coat, the cap's own frame two points wide round it.
                let wd = Material.sd_box(p, c, h - vec2(2.5, 2.5), max(r - 2.0, 1.0))
                let wv = au_carbon(p + o, 2.5, 1.5) + vec3(0.03, 0.03, 0.032)
                let wa = Finish.cover(wd, px) * (1.0 - 0.6 * disabled)
                var win = mix(wv, wv * 0.6, down)
                win = mix(win, vec3(0.0, 0.0, 0.0), Finish.band(wd, 0.0, px, px) * 0.8)
                res = Finish.over(res, vec4(win * wa, wa))
                let rl = Finish.ring_out(wd, 0.0, px, px) * step(c.y, p.y)
                res = Finish.over(res, vec4(0.36, 0.37, 0.39, 1.0) * rl * 0.7 * up)
            }
            if kind > 2.5 && kind < 3.5 {
                // Secondary: trimmed in polished chrome, a bright hairline
                // just outside the black outline, lit on the top.
                let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
                let trim = mix(vec3(0.78, 0.79, 0.81), vec3(0.40, 0.41, 0.43), smoothstep(0.0, 1.0, t))
                res = Finish.over(res, vec4(trim, 1.0) * Finish.ring_out(d, 0.0, px, px) * (0.4 + 0.6 * lit))
            }
            if kind > 1.5 && kind < 2.5 {
                // Primary: a blue light runs round the rim, two device pixels
                // of it inside the outline (the outer one nearly white), a
                // glow on the face inside it, and a halo on the ground that
                // is gone within half the gap to the next cap.
                let on = lit * (1.0 - 0.35 * down) * (1.0 + 0.15 * hover)
                let depth = max(-d, 0.0)
                let inner = exp(-max(depth - px * 2.0, 0.0) / 2.2) * inside
                res = Finish.over(res, vec4(0.20, 0.52, 1.0, 1.0) * clamp(inner * 0.30 * on, 0.0, 1.0))
                let b1 = Finish.band(d, 0.0, px, px)
                let b2 = Finish.band(d, px, px * 2.0, px)
                let b3 = Finish.band(d, px * 2.0, px * 3.0, px)
                res = Finish.over(res, vec4(0.25, 0.60, 1.0, 1.0) * b1 * on)
                res = Finish.over(res, vec4(0.72, 0.88, 1.0, 1.0) * b2 * on)
                res = Finish.over(res, vec4(0.30, 0.64, 1.0, 1.0) * b3 * 0.8 * on)
                let x = max(d, 0.0)
                let halo = (0.55 * exp(-(x * x) / (2.0 * 0.8 * 0.8)) + 0.25 * exp(-(x * x) / (2.0 * 1.8 * 1.8))) * (1.0 - smoothstep(2.5, 4.0, x)) * (1.0 - inside)
                res = Finish.over(res, vec4(0.20, 0.55, 1.0, 1.0) * clamp(halo * on, 0.0, 1.0))
                // Focus brightens the light rather than ringing it.
                res = Finish.over(res, vec4(0.80, 0.92, 1.0, 1.0) * b2 * 0.5 * focus * lit)
            }
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 7.25, 2.0)
        res = au_spinner(res, p, c - vec2(0.0, px), rad, anim, loading, 1.5)
    }
    return res
}

