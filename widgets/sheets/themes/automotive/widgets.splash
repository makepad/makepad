}

// ---------------------------------------------------------------- field row

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it.
// Fields and buttons share the one 26 point row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 1.5
// The outline is one device pixel; the faces below draw it themselves.
let field_border = 0.34

// The room a Fit field takes. A minimum height rather than a height,
// because a line of text is shorter than a row, and the padding with it:
// where a field is Fit, the padding IS its height, and two fields padded
// differently part company again the moment the type grows.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box, and because writing a corner onto a
// draw struct that has no corner would add a slot its shader never reads.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: a number
// with a stepper, a date, a time. The height is all these take. A padding
// here would NOT hold the line off the box -- each of them measures its
// parts against the turtle's whole rect and draws them from the content
// origin, so the padding displaces the line instead of insetting it, and the
// number came out sitting on the bottom edge with its arrows split around it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
// The number's box strokes its own hairline and declares no border size.
mod.widgets.NumberField.draw_bg.border_radius = field_radius
// The drag-number's corner is written into its own shader, so it takes the
// room and keeps the box it draws.
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
// A picker is a date field in an anchor: the field inside fills the frame.
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own. It is
// a TextInput, so it inherits the minimum above, and a minimum as tall as the
// whole field, applied inside a well already that tall, pushed the line out
// through the bottom of the box.
mod.widgets.WellInput.min_height = 0.0

// ---------------------------------------------------------------- rules

// A rule is engraved: one device pixel of the outline's black over one of
// light, across the middle of its room, no shadow.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let y0 = au_snap(self.rect_size.y * 0.5 - px, self.rect_pos.y, px)
    let dark = step(y0, p.y) * step(p.y, y0 + px)
    let light = step(y0 + px, p.y) * step(p.y, y0 + px * 2.0)
    return vec4(0.010, 0.010, 0.012, 1.0) * dark + vec4(0.26, 0.265, 0.28, 1.0) * light
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x0 = au_snap(self.rect_size.x * 0.5 - px, self.rect_pos.x, px)
    let dark = step(x0, p.x) * step(p.x, x0 + px)
    let light = step(x0 + px, p.x) * step(p.x, x0 + px * 2.0)
    return vec4(0.010, 0.010, 0.012, 1.0) * dark + vec4(0.26, 0.265, 0.28, 1.0) * light
}

// ---------------------------------------------------------------- ground

// A splitter is a seam cut into the deck: the deck shows through its strip,
// and down its middle a device pixel of black over one of light. Under the
// hand, held or focused, the seam lights blue along the grip's length.
mod.widgets.Splitter.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let v = self.is_vertical
    let across = mix(p.y, p.x, v)
    let along = mix(p.x, p.y, v)
    let thick = mix(self.rect_size.y, self.rect_size.x, v)
    let span = mix(self.rect_size.x, self.rect_size.y, v)
    let o = mix(self.rect_pos.y, self.rect_pos.x, v)
    let m = au_snap(thick * 0.5, o, px) - px
    let dark = step(m, across) * (1.0 - step(m + px, across))
    let light = step(m + px, across) * (1.0 - step(m + px * 2.0, across))
    let res = vec4(0.008, 0.008, 0.010, 1.0) * dark * 0.85 + vec4(0.40, 0.41, 0.43, 1.0) * light * 0.45
    let act = max(max(self.hover, self.drag), self.focus)
    let inbar = 1.0 - step(self.bar_size * 0.5, abs(along - span * 0.5))
    return Finish.over(res, vec4(0.227, 0.612, 1.0, 1.0) * (dark + light) * act * inbar)
}

// The rows of a tree stand on the deck, clear; the open row is a slab of
// graphite cast blue, with a lit bar at its left end, as the list's chosen
// row.
mod.widgets.FileTreeNode.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let y0 = au_snap(0.0, o.y, px)
    let y1 = au_snap(self.rect_size.y, o.y, px) - px
    let x0 = au_snap(0.0, o.x, px)
    let x1 = au_snap(self.rect_size.x, o.x, px)
    let t = clamp((p.y - y0) / max(y1 - y0, 1.0), 0.0, 1.0)
    let cb = vec2((x0 + x1) * 0.5, (y0 + y1) * 0.5)
    let d = Material.sd_box(p, cb, vec2((x1 - x0) * 0.5, (y1 - y0) * 0.5), 2.5)
    var col = mix(vec3(0.150, 0.215, 0.300), vec3(0.100, 0.150, 0.215), t)
    col = mix(col, vec3(0.45, 0.60, 0.78), Finish.band(d, px, px * 2.0, px) * (1.0 - step(cb.y, p.y)) * 0.8)
    col = mix(col, vec3(0.012, 0.012, 0.014), Finish.band(d, 0.0, px, px))
    var res = vec4(col, 1.0) * Finish.cover(d, px)
    let lc = vec2(au_snap(3.5, o.x, px) - px * 0.5, cb.y)
    res = au_led(res, p, lc, vec2(px * 0.5 + 0.01, max((y1 - y0) * 0.24, 2.0)), 1.0, 0.8, px, vec3(0.88, 0.96, 1.0), vec3(0.227, 0.612, 1.0))
    return res * self.active
}

// Plain views stop clipping so a shadow can fall past their edge; scroll
// views keep clipping their content.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false
mod.widgets.Window.pass.clear_color = #2c2e32
// The window's own ground (`au_ground`): a brushed steel deck between bands
// of carbon weave.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    return vec4(au_ground(p + self.rect_pos, px, self.rect_size.x, self.rect_size.y), 1.0)
}

// ---------------------------------------------------------------- badge

// The badge is drawn with the screens, as a small dash window (below).

// ---------------------------------------------------------------- states

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}


// ---------------------------------------------------------------- band

// THE BAND is the sheet's own slider with two thumbs: the same groove and
// the same neon tube as the Slider, lit between two round chrome thumbs.
// The widget's grab geometry is set to the thumbs' own, so what is drawn is
// what is dragged.
mod.widgets.RangeSliderFlat.clip_x = false
mod.widgets.RangeSliderFlat.clip_y = false
mod.widgets.RangeSliderFlat.track_inset = 0.0
mod.widgets.RangeSliderFlat.handle_size = 16.0
mod.widgets.RangeSliderFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RangeSliderFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = au_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 8.0
    let cy = au_snap(self.label_px + (self.rect_size.y - self.label_px) * 0.5, o.y, px)
    let lo = vec2(au_snap(0.0, o.x, px), cy - 5.5)
    let hi = vec2(au_snap(self.rect_size.x, o.x, px), cy + 5.5)
    let col = au_neon_at(o)
    var res = au_groove(p, o, lo, hi, px, self.disabled)
    let span = self.rect_size.x - rad * 2.0
    let h0 = rad + self.start_pos * span
    let h1 = rad + self.end_pos * span
    res = au_tube(res, p, h0, h1, cy, 2.7, px, col, self.disabled)
    res = au_ball(res, p, vec2(h0, cy), rad, px, self.hot_start, max(self.drag * self.hot_start, self.focus), self.disabled, col)
    return au_ball(res, p, vec2(h1, cy), rad, px, self.hot_end, max(self.drag * self.hot_end, self.focus), self.disabled, col)
}

// ---------------------------------------------------------------- switches and meter

// THE ROCKER is a round illuminated push button, as a dash has for its
// ignition: an 18 point button in a polished chrome bezel, its cap of dark
// glass domed toward the light. On, a ring of red light burns round the cap
// inside the bezel and the glass glows red from within, its light lying on
// the ground round the bezel; off, the ring is dark tinted glass. Pressed,
// the cap sinks and dims. It flips on a click and does not drag.
mod.widgets.ToggleRocker.draw_bg.size = uniform(18.0)
mod.widgets.ToggleRocker.draw_bg.pill_aspect = uniform(1.0)
mod.widgets.ToggleRocker.label_walk.margin.left = 25.0
mod.widgets.ToggleRocker.draw_bg.pixel = fn() {
    let m = 5.0
    let px = au_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let R = self.size * 0.5
    let c = vec2(au_snap(R, o.x, px), au_snap(self.rect_size.y * 0.5, o.y, px))
    let q = p - c
    let rl = length(q)
    let live = 1.0 - self.disabled
    let on = self.active * live
    let held = max(self.down, self.pressed)
    let red = vec3(1.0, 0.16, 0.10)
    let sh = Finish.drop(p, c, vec2(R, R), R, vec2(0.0, 1.0), 1.3) * 0.8 * (1.0 - Finish.cover(rl - R, px))
    var res = vec4(0.0, 0.0, 0.0, sh)
    let x = max(rl - R, 0.0)
    let halo = (0.38 * exp(-(x * x) / (2.0 * 0.9 * 0.9)) + 0.16 * exp(-(x * x) / (2.0 * 2.0 * 2.0))) * (1.0 - smoothstep(1.4, 2.5, x)) * (1.0 - Finish.cover(rl - R, px))
    res = Finish.over(res, vec4(red, 1.0) * clamp(halo * on, 0.0, 1.0))
    res = Finish.over(res, au_chrome_ring(p, c, R - 1.8, R, px, self.hover))
    // The light ring between the bezel and the cap.
    let ri = R - 1.8
    let rc = R - 3.2
    let ringd = abs(rl - (ri + rc) * 0.5) - (ri - rc) * 0.5
    let ra = Finish.cover(ringd, px)
    let rt = clamp((rl - rc) / max(ri - rc, 0.5), 0.0, 1.0)
    let lit = mix(mix(red, vec3(1.0, 0.85, 0.80), 0.55 * (1.0 - abs(rt - 0.5) * 2.0)), red * 0.8, 0.2)
    let dark = mix(vec3(0.10, 0.03, 0.03), vec3(0.05, 0.02, 0.02), rt)
    res = Finish.over(res, vec4(mix(dark, lit, on) * ra, ra))
    // The cap: dark glass domed toward the light, sunk when pressed.
    let t = clamp((p.y - (c.y - rc)) / max(2.0 * rc, 1.0), 0.0, 1.0)
    var cap = mix(vec3(0.20, 0.205, 0.215), vec3(0.06, 0.061, 0.066), smoothstep(0.0, 1.0, t))
    cap = mix(cap, cap * 0.6, held)
    cap = cap + red * on * (0.30 * exp(-(rl * rl) / max(rc * rc * 0.6, 0.5)) + 0.12)
    let sp = (q - vec2(-0.3 * rc, -0.42 * rc)) / vec2(max(0.5 * rc, 0.5), max(0.3 * rc, 0.4))
    cap = cap + vec3(0.30, 0.30, 0.31) * exp(-dot(sp, sp)) * (1.0 - 0.6 * held) * live
    cap = cap + vec3(0.03, 0.03, 0.03) * self.hover * live
    let cg = Finish.lum(cap)
    cap = mix(cap, vec3(cg, cg, cg) * 0.6, self.disabled)
    cap = mix(cap, vec3(0.0, 0.0, 0.0), Finish.band(rl - rc, 0.0, px, px) * 0.85)
    let ca = Finish.cover(rl - rc, px)
    res = Finish.over(res, vec4(cap * ca, ca))
    let fr = Finish.ring_out(rl - R, 0.0, px, px) * 0.9 + Finish.glow(rl - R - px, 0.7) * 0.3 * (1.0 - Finish.cover(rl - R, px))
    return Finish.over(res, vec4(0.227, 0.612, 1.0, 1.0) * clamp(fr, 0.0, 1.0) * self.focus * live)
}

// THE SLIDE SWITCH is a chrome bat-handle toggle on a graphite plate, as a
// race car's switch panel has them: a chrome bushing in the middle of the
// plate and the lever standing from it toward its state, left off and
// right on, a tapered rod of polished chrome ending in a ball, its shadow
// on the plate. Dragged, the lever swings through upright (pointing at the
// viewer, only its ball over the bushing). A small green LED in the plate's
// right corner is lit while it is on.
mod.widgets.ToggleSlide.draw_bg.size = uniform(18.0)
mod.widgets.ToggleSlide.draw_bg.pill_aspect = uniform(1.89)
mod.widgets.ToggleSlide.label_walk.margin.left = 34.0
mod.widgets.ToggleSlide.draw_bg.pixel = fn() {
    let m = 5.0
    let px = au_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(au_snap(0.0, o.x, px), au_snap(y0, o.y, px))
    let hi = vec2(au_snap(tw, o.x, px), au_snap(y0 + th, o.y, px))
    let live = 1.0 - self.disabled
    let on = self.active * live
    var res = au_cap(p, lo, hi, 3.0, px, 0.0, 0.0, self.disabled, self.focus, 1.0, vec3(-0.07, -0.07, -0.072), vec4(0.17, 0.17, 0.18, 1.0), 0.0)
    let c = vec2(au_snap((lo.x + hi.x) * 0.5, o.x, px), au_snap((lo.y + hi.y) * 0.5, o.y, px))
    // The LED.
    res = au_led(res, p, vec2(hi.x - 3.5, lo.y + 3.5), vec2(1.2, 1.2), on, 0.8, px, vec3(0.86, 1.0, 0.88), vec3(0.20, 0.95, 0.30))
    // The bushing: a chrome nut round a dark bore.
    res = Finish.over(res, Finish.drop(p, c, vec2(5.0, 5.0), 5.0, vec2(0.0, 0.8), 0.8) * vec4(0.0, 0.0, 0.0, 0.6))
    res = Finish.over(res, au_chrome_ring(p, c, 2.4, 5.0, px, self.hover))
    let bd = length(p - c) - 2.4
    res = Finish.over(res, vec4(0.02, 0.02, 0.025, 1.0) * Finish.cover(bd, px))
    // The lever.
    let kt = mix(self.active, self.drag_pos, self.drag)
    let s = kt * 2.0 - 1.0
    let L = 12.0 * abs(s)
    let dir = vec2(sign(s + 0.0001), 0.0)
    let tip = c + dir * L
    let rb = 3.2
    // Its shadow on the plate, down and to the right.
    let sq = p - vec2(1.0, 1.6)
    let sdl = min(au_seg(sq, c, tip) - mix(2.2, 1.4, clamp(dot(sq - c, dir) / max(L, 0.5), 0.0, 1.0)), length(sq - tip) - rb)
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.55 * Finish.cover(sdl, 1.0)))
    let u = clamp(dot(p - c, dir) / max(L, 0.5), 0.0, 1.0)
    let rw = mix(2.2, 1.4, u)
    let rod = au_seg(p, c, tip) - rw
    let across = clamp(((p - c).y) / max(rw, 0.3), -1.0, 1.0)
    var ch = mix(vec3(0.95, 0.95, 0.96), vec3(0.25, 0.25, 0.27), smoothstep(-0.6, 0.8, across))
    ch = mix(ch, vec3(0.55, 0.555, 0.57), smoothstep(0.6, 1.0, across) * 0.6)
    ch = mix(ch, vec3(0.03, 0.03, 0.035), Finish.band(rod, 0.0, px, px) * 0.8)
    let ra = Finish.cover(rod, px)
    res = Finish.over(res, vec4(ch * ra, ra))
    // The ball at its end: a chrome sphere.
    let bq = (p - tip) / rb
    let bz = sqrt(max(1.0 - dot(bq, bq), 0.0))
    let n = normalize(vec3(bq, bz + 0.001))
    let rf = vec3(2.0 * n.z * n.x, 2.0 * n.z * n.y, 2.0 * n.z * n.z - 1.0)
    var bc = au_chrome_room(rf, 1.0) * (1.0 + 0.1 * self.hover * live)
    let bg = Finish.lum(bc)
    bc = mix(bc, vec3(bg, bg, bg) * 0.5, self.disabled)
    let bdd = length(p - tip) - rb
    bc = mix(bc, vec3(0.03, 0.03, 0.035), Finish.band(bdd, 0.0, px, px))
    let ba = Finish.cover(bdd, px)
    return Finish.over(res, vec4(bc * ba, ba))
}

// THE METER is a gauge in the same family as the dials and the readouts: a
// polished chrome frame round black glass, its scale and numbers white, the
// red line red, a red needle on a chrome pivot with its glow on the face, a
// faint glass sheen. The scale, its divisions and the needle's travel are
// the library's own.
mod.widgets.NeedleMeter.draw_bg.border_radius = uniform(3.0)
mod.widgets.NeedleMeter.draw_bg.color_bezel = uniform(theme.color_d_05)
mod.widgets.NeedleMeter.draw_bg.color_lip = uniform(theme.color_u_15)
mod.widgets.NeedleMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lo = vec2(Finish.snap(self.rect_pos.x, px), Finish.snap(self.rect_pos.y, px)) - self.rect_pos
    let hi = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x, px), Finish.snap(self.rect_pos.y + self.rect_size.y, px) - px) - self.rect_pos
    let c = (lo + hi) * 0.5
    let ho = (hi - lo) * 0.5
    let r_out = min(self.border_radius, min(ho.x, ho.y))
    let outer = Material.sd_box(p, c, ho, r_out)
    let pv = self.pivot()
    let rr = self.scale_radius()
    let q = p - pv
    let r = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let sweep = self.sweep * 0.017453293
    let t = ang / sweep + 0.5
    let on_scale = step(-0.0001, t) * step(t, 1.0001)
    // The face: black, a little lighter round the pivot.
    let ft = clamp(r / max(rr * 1.3, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.075, 0.076, 0.080), vec3(0.022, 0.022, 0.025), ft)
    let arc = Finish.cover(abs(r - rr) - px * 0.5, px) * on_scale
    let n = max(floor(self.majors + 0.5), 1.0) * max(floor(self.minors + 0.5), 1.0)
    let k = floor(clamp(t, 0.0, 1.0) * n + 0.5)
    let ak = (k / n - 0.5) * sweep
    let perp = abs(q.x * cos(ak) + q.y * sin(ak))
    let mn = max(floor(self.minors + 0.5), 1.0)
    let major = 1.0 - step(0.5, k - mn * floor(k / mn + 0.0001))
    let len = mix(self.tick_minor, self.tick_major, major)
    let radial = max(rr - len - r, r - rr)
    let tick = Finish.cover(perp - px * mix(0.5, 1.0, major), px) * Finish.cover(radial, px) * step(0.0, 0.0 - q.y * cos(ak) + q.x * sin(ak))
    let inz = step(self.zone, k / n)
    face = mix(face, mix(vec3(0.92, 0.93, 0.94), vec3(1.0, 0.25, 0.18), inz), max(arc * (1.0 - step(self.zone, t)), tick))
    if self.zone < 0.999 {
        let zone_t = Finish.cover((self.zone - t) * sweep * r, px) * Finish.cover((t - 1.0) * sweep * r, px)
        let zone_r = Finish.cover(max(rr + px - r, r - rr - 2.5), px)
        face = mix(face, vec3(0.90, 0.07, 0.05), zone_t * zone_r)
    }
    // The needle: red, its glow on the face round it.
    let na = self.needle_angle(self.value)
    let nd = vec2(sin(na), 0.0 - cos(na))
    let along = dot(q, nd)
    let across = abs(q.x * nd.y - q.y * nd.x)
    let nb = max(across - px * 0.7, max(along - (rr + 3.0), 0.0 - along - max(self.pivot_size - px, 0.0)))
    let gx = max(nb, 0.0)
    face = mix(face, vec3(1.0, 0.12, 0.06), (0.35 * exp(-(gx * gx) / (2.0 * 0.8 * 0.8)) + 0.12 * exp(-(gx * gx) / (2.0 * 2.0 * 2.0))) * (1.0 - Finish.cover(nb, px)))
    face = mix(face, vec3(1.0, 0.22, 0.14), Finish.cover(nb, px))
    // The pivot: a chrome cap.
    let pd = r - self.pivot_size
    let pq = (q - vec2(-0.3, -0.4) * self.pivot_size) / max(self.pivot_size * 0.6, 0.5)
    let pc = mix(vec3(0.35, 0.35, 0.37), vec3(0.95, 0.95, 0.96), exp(-dot(pq, pq)))
    face = mix(face, pc, Finish.cover(pd, px))
    face = mix(face, vec3(0.02, 0.02, 0.025), Finish.band(pd, 0.0, px, px))
    // The frame: two and a half points of polished chrome, bright on the
    // top and the foot, a black line where the glass meets it.
    let b = Finish.snap(2.5, px)
    let hf = max(ho - vec2(b, b), vec2(0.5, 0.5))
    let rf = max(r_out - b * 0.5, 0.5)
    let face_d = Material.sd_box(p, c, hf, rf)
    face = face * (1.0 - 0.6 * Finish.inset(p, c, hf, rf, vec2(0.0, 2.0), 1.8))
    face = mix(face, vec3(0.0, 0.0, 0.0), Finish.band(face_d, 0.0, px, px))
    let u = (p - (c - hf)) / max(hf * 2.0, vec2(1.0, 1.0))
    let diag = u.x + u.y * 0.6
    let band = smoothstep(0.0, 0.12, diag) * (1.0 - smoothstep(0.28, 0.5, diag))
    face = face + vec3(0.025, 0.025, 0.027) * band
    let fu = clamp(-outer / max(b, px), 0.0, 1.0)
    let ny = fu * 2.0 - 1.0
    let ty = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let lit = max(1.0 - smoothstep(0.0, 0.2, ty), smoothstep(0.8, 1.0, ty))
    var fc = mix(vec3(0.40, 0.405, 0.42), vec3(0.92, 0.925, 0.935), exp(-(ny + 0.2) * (ny + 0.2) / 0.12))
    fc = mix(fc * 0.75, min(fc * 1.12, vec3(1.0, 1.0, 1.0)), lit)
    var col = mix(fc, face, Finish.cover(face_d, px))
    col = mix(col, vec3(0.008, 0.008, 0.010), Finish.band(outer, 0.0, px, px))
    let a = Finish.cover(outer, px)
    return vec4(col * a, a) * self.color.a * self.opacity
}

// THE SCREENS: a readout's window and the screen are the dash window, black
// glass in a polished silver frame (`au_glass_box`); the segments are the
// library's, lit white.
mod.widgets.ScreenView.draw_bg.border_radius = uniform(3.0)
mod.widgets.ScreenView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    var res = au_glass_box(p, lo, hi, px, 3.5)
    if self.scan > 0.0 {
        let s = Finish.scan(p.y - lo.y, px, 3.0 * px, self.scan)
        res = vec4(res.rgb * s, res.a)
    }
    return res
}
mod.widgets.ScreenView.sheen = 0.0

// The badge (a count) is the same small dash window, its number white.
mod.widgets.BadgePalette.neutral = #060708
mod.widgets.BadgePalette.on_neutral = #f2f5f8
mod.widgets.BadgeFlat.shape = mod.widgets.BadgeShape.Rounded
mod.widgets.BadgeFlat.radius = 2.5
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = au_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(au_snap(0.0, o.x, px), au_snap(0.0, o.y, px))
    let hi = vec2(au_snap(self.rect_size.x - px * 0.49, o.x, px), au_snap(self.rect_size.y - px * 0.49, o.y, px))
    let l = Finish.lum(self.color.rgb)
    let ch = length(self.color.rgb - vec3(l, l, l))
    var res = au_glass_box(p, lo, hi, px, 2.5)
    // A badge given a role colour keeps it, as a tint in its glass.
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5 - vec2(px * 3.0, px * 3.0), 1.0)
    res = Finish.over(res, vec4(self.color.rgb, 1.0) * Finish.cover(d, px) * smoothstep(0.08, 0.16, ch) * 0.5 * self.color.a)
    return res
}

// ---------------------------------------------------------------- lamps
// LAMPS: an LED, as the hardware in his pictures has them. The emitter is
// the light: at full current its middle burns toward white and its rim is
// its most saturated colour; at lower current the middle is no longer
// white, the colour deeper, the glow smaller; out, it is dark tinted glass,
// its colour barely there. Round it a bezel: a raised ring lit from the
// upper left, or a socket cut into the surface, its upper wall in shadow
// and a catch light on its lower rim. Over the lens one crisp highlight of
// a dome. Its light is added, never painted: a tight hot halo and a short
// bloom in its own hue, screened over whatever is there and gone in about
// two radii; on a pale ground, where light can barely brighten, its hue is
// also laid round it as a tint that keeps the ground's luminance (the
// library's halo rule: at most 0.45 one device pixel out, halving every
// 0.4 of its reach, gone at the reach), so it never darkens or greys its
// ground. A bar is the same light drawn out into a light pipe.
let au_led_lamp_add = fn(res: vec4, light: vec3, ground: vec3) -> vec4 {
    let est = res.rgb + ground * (1.0 - res.a)
    let add = (vec3(1.0, 1.0, 1.0) - exp(-light)) * max(vec3(1.0, 1.0, 1.0) - est, vec3(0.0, 0.0, 0.0))
    return vec4(res.rgb + add, res.a)
}
// An LED's colour at full strength: its brightest channel at one.
let au_led_lamp_full = fn(ink: vec3) -> vec3 {
    return ink / max(max(ink.x, max(ink.y, ink.z)), 0.01)
}
// The same colour at the emitter's own chroma: the hue kept and its
// saturation raised by `vivid` (0 leaves a pale colour pale; a colour with
// next to no hue, a white or a plain lamp, stays neutral either way).
let au_led_lamp_hue = fn(ink: vec3, vivid: float) -> vec3 {
    let f = au_led_lamp_full(ink)
    let mn = min(f.x, min(f.y, f.z))
    let ch = 1.0 - mn
    let pure = (f - vec3(mn, mn, mn)) / max(ch, 0.001)
    return mix(f, pure, clamp(vivid, 0.0, 1.0) * 0.72 * smoothstep(0.03, 0.12, ch))
}
// The lamp: its lens a rounded box `hb` either side of `c` (round when the
// two are equal), `lit` its current 0..1, `ink` its colour and `vivid` how
// far its chroma is raised, `ground` what shows through where nothing is
// drawn, `room` how far its light may reach, `bez` and `raised` its bezel
// (raised 0: a recess cut in what is under it; 1: a raised ring of `bez`;
// 2: the same ring polished metal). Premultiplied over `dst`.
let au_led_lamp = fn(dst: vec4, p: vec2, c: vec2, hb: vec2, lit: float, ink: vec3, vivid: float, px: float, ground: vec3, room: float, bez: vec3, raised: float) -> vec4 {
    let rt = max(min(hb.x, hb.y), 0.4)
    let d = Material.sd_box(p, c, hb, rt)
    let bw = clamp(0.3 * rt, 0.7, 2.4)
    let ds = d - bw
    let L = clamp(lit, 0.0, 1.0)
    let b = au_led_lamp_full(ink)
    let hue = au_led_lamp_hue(ink, vivid)
    let pw = L * sqrt(L)
    let white = vec3(1.0, 1.0, 1.0)
    let lum = vec3(0.2126, 0.7152, 0.0722)
    let pale = smoothstep(0.35, 0.75, dot(ground, lum))
    var res = dst
    let x = max(ds, 0.0)
    let reach = max(room, 1.0)
    let win = 1.0 - smoothstep(0.55 * reach, reach, x)
    // The lens's own frame: `q` in lens radii from its centre line, `t` its
    // distance out, `nrm` the way its outline faces.
    let ex = max(hb.x - hb.y, 0.0)
    let ey = max(hb.y - hb.x, 0.0)
    let qx = p.x - c.x
    let qy = p.y - c.y
    let q = vec2(qx - clamp(qx, 0.0 - ex, ex), qy - clamp(qy, 0.0 - ey, ey)) / rt
    let t = clamp(length(q), 0.0, 1.0)
    let nrm = q / max(length(q), 0.001)
    // What the bead and its bezel throw on the ground: a soft shadow, down.
    let shd = Finish.drop(p, c, hb + vec2(bw, bw), rt + bw, vec2(0.0, 0.22 * rt + 0.3), 0.32 * rt + px) * mix(0.18, 0.34, min(raised, 1.0)) * (1.0 - 0.6 * pw)
    res = Finish.over(res, vec4(ground * 0.4 * shd, shd))
    if L > 0.001 && pale > 0.001 {
        // The tint, on a pale ground only: its hue laid over, never darker.
        let h = clamp(0.42 * pw * pow(2.0, -x / max(0.4 * reach, 0.5)) * win, 0.0, 0.45) * pale
        let est = res.rgb + ground * (1.0 - res.a)
        let w = clamp(dot(hue, lum) / max(dot(est, lum), 0.001), 0.0, 1.0)
        res = Finish.over(res, vec4(hue * h * w, h * w))
    }
    // The bezel: raised, a ring of `bez` rounded over, lit from the upper
    // left; or a socket cut into what is under it, its upper wall in shadow
    // and a catch light on its lower rim.
    let a_s = Finish.cover(ds, px)
    let u = clamp(d / max(bw, 0.01), 0.0, 1.0)
    let facing = dot(nrm * (u - 0.5) * 2.0, vec2(-0.45, -0.89))
    let metal = clamp(raised - 1.0, 0.0, 1.0)
    var rc = bez * (0.94 + mix(0.12, 0.55, metal) * facing)
    rc = mix(rc, min(bez + vec3(0.30, 0.30, 0.30), white), smoothstep(mix(0.35, 0.55, metal), 0.9, facing) * mix(0.6, 0.85, metal))
    rc = mix(rc, rc * 0.8, Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.0, 0.8, nrm.y) * 0.8)
    let under = res.rgb / max(res.a, 0.001) * step(0.001, res.a) + ground * (1.0 - step(0.001, res.a))
    let gy = clamp(nrm.y * t, -1.0, 1.0)
    var sc = under * mix(0.55, 0.92, smoothstep(-0.9, 0.9, gy))
    sc = mix(sc, min(under * 1.06 + vec3(0.28, 0.28, 0.28), white), Finish.band(ds, 0.0, max(px, 0.45), px) * smoothstep(0.2, 0.95, nrm.y) * 0.85)
    sc = min(mix(sc, rc, min(raised, 1.0)), white)
    res = Finish.over(res, vec4(sc * a_s, a_s))
    // The light: a tight hot halo and a short bloom in its hue, gone in
    // about two radii, falling on the bezel too.
    if L > 0.001 {
        let xl = max(d, 0.0)
        let halo = exp(-xl / max(0.30 * rt, 0.4)) * 1.5 + exp(-xl / max(0.65 * rt, 0.7)) * 0.32
        let hwin = 1.0 - smoothstep(1.1 * rt, 2.0 * rt + 1.0, xl)
        res = au_led_lamp_add(res, mix(hue, white, 0.15 * pw) * halo * pw * hwin * win, ground)
    }
    // THE BEAD: a glossy dome of coloured glass. Its colour deepens toward
    // the top; light pools low inside, where it comes through the dome; lit,
    // its middle burns toward white at full current and its rim is its most
    // saturated colour.
    let top = smoothstep(-1.0, 0.6, q.y)
    let pool = exp(-(q.y - 0.55) * (q.y - 0.55) / 0.09 - q.x * q.x / 0.30)
    var on = mix(hue * mix(0.55, 0.8, L), mix(b, hue, 0.5), top)
    on = mix(on, min(mix(b, hue, 0.4) + vec3(0.35, 0.35, 0.35), white), pool * 0.5)
    on = mix(on, vec3(1.0, 0.99, 0.975), exp(-t * t / 0.20) * smoothstep(0.5, 1.0, L) * 0.85)
    on = mix(on, hue * (0.82 + 0.18 * L), smoothstep(0.62, 1.0, t))
    on = on * (0.42 + 0.58 * L)
    // Out: dark tinted glass on a dark ground, a grey bead on a pale one,
    // its colour barely there, the same dome, a catch light along its lower
    // rim.
    let offc = mix(mix(vec3(0.085, 0.09, 0.115), ground * 0.62, pale), b * 0.4, 0.12)
    var off = mix(offc * 0.62, offc * 1.08, top)
    off = mix(off, min(offc + vec3(0.18, 0.18, 0.18), white), pool * 0.35)
    off = off * mix(1.0, 0.75, smoothstep(0.75, 1.0, t))
    let catchl = smoothstep(0.62, 0.9, t) * (1.0 - smoothstep(0.9, 1.0, t)) * smoothstep(0.2, 0.9, nrm.y)
    off = off + vec3(0.30, 0.30, 0.32) * catchl * (1.0 - 0.5 * pale)
    var col = mix(off, min(on, white), smoothstep(0.0, 0.35, L))
    // One crisp highlight: a white oval across its upper third.
    let e = length(vec2(q.x / 0.62, (q.y + 0.46) / 0.30))
    let spec = (1.0 - smoothstep(0.55, 1.0, e)) * mix(1.0, 0.3, clamp((q.y + 0.76) / 0.6, 0.0, 1.0))
    col = mix(col, white, spec * mix(0.8, 0.55, L) * smoothstep(0.9, 2.2, rt))
    // Out, a faint seam where the dome meets its bezel; lit, none: the rim
    // is the colour.
    col = mix(col, col * 0.7, Finish.band(d, 0.0, px * 0.6, px) * 0.6 * (1.0 - smoothstep(0.0, 0.25, L)))
    col = min(col, white)
    let a_l = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a_l, a_l))
}

// The Lamp widget and the bar lamp: the lamp above, in a polished chrome ring.
// The halo's room is held in the lamp's own box (the library reserves a
// lens thickness either side once a halo is asked for), so the light is
// never cut at its edge.
mod.widgets.Lamp.halo = 0.3
mod.widgets.Lamp.halo_reach = 1.0
mod.widgets.Lamp.draw_bg.vertex = fn() {
    let m = 2.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Lamp.draw_bg.pixel = fn() {
    let m = 2.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let reach = clamp(self.reach, 0.0, 1.0)
    let t = self.rect_size.y / (1.0 + 2.0 * reach)
    let room = t * reach
    // A round lamp: the lens the lamp's size in the middle of its box, its
    // socket and its light in the room round it. A bar: a short light pipe
    // three quarters of a round lens thick and at most two of its
    // thicknesses long, set three points in from the start of its box,
    // its light gone within two points; so in a row of lamps it never
    // reaches past its box toward whatever stands after it.
    let tb = t * 0.75
    let blen = min(max(self.rect_size.x - 2.0 * room, tb), 2.0 * tb)
    let cb = vec2(min(room, 2.0) + 1.0 + blen * 0.5, self.rect_size.y * 0.5)
    let c = mix(self.rect_size * 0.5, cb, self.bar)
    let hb = mix(vec2(t * 0.5, t * 0.5), vec2(blen * 0.5, tb * 0.5), self.bar)
    let reach_px = mix(max(room - 0.5, 2.0), 1.8, self.bar)
    let res = au_led_lamp(vec4(0.0, 0.0, 0.0, 0.0), p, c, hb, self.lit, self.intent_color().rgb, 1.0 - step(3.5, self.intent), px, vec3(0.045, 0.046, 0.050), reach_px, vec3(0.62, 0.63, 0.65), 2.0)
    return res * self.opacity
}
true
