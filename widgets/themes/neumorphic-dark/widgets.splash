// THE OPEN LIST. A raised panel with a 6 point corner; the row under the
// pointer lifts a little, the chosen row is a sunken strip with a lit bar
// at its left end and its label in the accent.
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_panel(pq, self.rect_size, self.rect_pos, px, nd_ground() + vec3(0.012, 0.012, 0.014), 6.0, 1.0, 0.0, 0.0)
}
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5 - vec2(0.0, 1.0)
    let d = Material.sd_box(p, c, h, 3.0)
    let en = 1.0 - self.disabled
    let deep = Finish.inset(p, c, h, 3.0, vec2(0.0, 1.6), 2.2)
    var col = mix(nd_ground() - vec3(0.035, 0.035, 0.035), vec3(0.0, 0.0, 0.0), deep * 0.5)
    let bx = 3.0
    let bd = nd_seg(p, vec2(bx, c.y - h.y * 0.45), vec2(bx, c.y + h.y * 0.45)) - 0.5
    col = mix(col, nd_led(col, bd, px, nd_accent(), 1.0, 1.0), self.active)
    let wa = Finish.cover(d, px) * self.active * en
    var acc = vec4(col * wa, wa)
    let hv = Finish.cover(d, px) * self.hover * en * 0.04
    return Finish.over(acc, vec4(hv, hv, hv, hv))
}
mod.widgets.PopupMenuItem.draw_text.color_active = #45ebe0

// Templates that draw a face of their own on top of these roots keep the
