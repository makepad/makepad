// CHECK BOX. A 14 point well with a 3 point corner, lit lip below; the mark
// is a 1.5 point accent stroke set in the dark, with a short halo. Under
// the pointer an unticked box shows the tick engraved.
let nd_check = fn(pq: vec2, size: vec2, org: vec2, px: float, box: float, hover: float, down: float, focus: float, active: float, disabled: float, mixed: float, error: float, round: float, at_end: float) -> vec4 {
    let y0 = Finish.snap(org.y + size.y * 0.5 - box * 0.5, px) - org.y
    let x0 = Finish.snap(org.x + (size.x - box) * at_end, px) - org.x
    let c = vec2(x0 + box * 0.5, y0 + box * 0.5)
    let h = vec2(box * 0.5, box * 0.5)
    let r = mix(3.0, box * 0.5, round)
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let fill = mix(vec3(0.055, 0.059, 0.075) + vec3(0.02, 0.02, 0.022) * hover * en - vec3(0.02, 0.02, 0.02) * down * en, vec3(0.133, 0.145, 0.165), disabled)
    var col = nd_well(fill, pq, c, h, r, d, px, box, (1.0 + 0.3 * down) * mix(1.0, 0.4, disabled))
    let ink = mix(mix(nd_accent(), vec3(0.878, 0.443, 0.424), error), vec3(0.29, 0.306, 0.337), disabled)
    let k0 = vec2(c.x - box * 0.25, c.y + box * 0.0)
    let k1 = vec2(c.x - box * 0.07, c.y + box * 0.18)
    let k2 = vec2(c.x + box * 0.25, c.y - box * 0.17)
    let tick = min(nd_seg(pq, k0, k1), nd_seg(pq, k1, k2)) - 0.75
    let dash = nd_seg(pq, vec2(c.x - box * 0.22, c.y), vec2(c.x + box * 0.22, c.y)) - 0.75
    let dm = mix(tick, dash, mixed)
    let on = max(active, mixed)
    // The short light of the mark on the well floor.
    let x = max(dm, 0.0)
    let fall = 1.0 - smoothstep(0.0, 2.5, x)
    col = col + ink * 0.22 * fall * fall * on * en * step(0.0, dm)
    // Off, under the pointer: the tick engraved in the floor.
    let eng = Finish.cover(tick, px) * (1.0 - on) * hover * en
    col = mix(col, vec3(0.2, 0.212, 0.239), eng * 0.8)
    col = mix(col, ink, Finish.cover(dm, px) * on)
    col = col + vec3(nd_grain(org + pq, px, 1.9))
    // Under the error intent the well's rim takes the error ink.
    col = mix(col, vec3(0.878, 0.443, 0.424), Finish.band(d, 0.0, px, px) * error * 0.85)
    let a = Finish.cover(d, px)
    var acc = vec4(col * a, a)
    acc = Finish.over(acc, nd_lip(pq, c, h, d, px, en))
    return Finish.over(acc, nd_focus(d, px, focus * en))
}
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_check(pq, self.rect_size, self.rect_pos, px, 14.0, self.hover, self.down, self.focus, self.active, self.disabled, self.mixed, self.error, 0.0, self.mark_at_end)
}
