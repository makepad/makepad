// A 7 by 4 point chevron at a one-point stroke, pointing down.
let nd_chevron = fn(p: vec2, cx: float, cy: float, px: float) -> float {
    let d = min(nd_seg(p, vec2(cx - 3.5, cy - 2.0), vec2(cx, cy + 2.0)), nd_seg(p, vec2(cx, cy + 2.0), vec2(cx + 3.5, cy - 2.0)))
    return Finish.cover(d - 0.6, px)
}

// TEXT FIELDS. A raised pill plate whose face is a deeper dish than a
// button's: dark under the top edge, lighter at the foot, so the words sit
// in a hollow. Focused, an LED line lights in its foot, 0.6 of the width.
let nd_field = fn(pq: vec2, size: vec2, org: vec2, px: float, r: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + size.x, px), Finish.snap(org.y + size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rr = min(r, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    let s = min(size.y, 30.0)
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.4, disabled)
    var acc = nd_cast(pq, c, h, rr, s, 0.9 * dis, 0.8 * en * (1.0 + 0.4 * hover), dis)
    let v = clamp((pq.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let g = mix(-0.06, 0.035, smoothstep(0.0, 0.95, v)) * en + 0.03 * hover * en
    var col = nd_ground() + vec3(g, g, g)
    // The hollow's own shadow under the top edge.
    let sh = Finish.inset(pq, c, h, rr, vec2(0.0, 0.08 * s), 0.1 * s)
    col = mix(col, vec3(0.0, 0.0, 0.0), sh * (0.25 + 0.35 * down) * en)
    col = col - vec3(0.02, 0.02, 0.02) * down * en
    let bot = 1.0 - smoothstep(rr * 0.3, rr + 0.6, (c.y + h.y) - pq.y)
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * bot * 0.06 * en)
    let ly = c.y + h.y - 0.13 * s
    let lw = h.x * 0.6 - rr * 0.5
    let dc = nd_seg(pq, vec2(c.x - lw, ly), vec2(c.x + lw, ly)) - 0.5
    col = mix(col, nd_led(col, dc, px, nd_accent(), 1.0, 1.0), focus * en)
    col = col + vec3(nd_grain(org + pq, px, 1.9))
    col = mix(col, nd_line(), Finish.band(d, 0.0, px, px) * mix(0.75, 0.35, disabled))
    let a = Finish.cover(d, px)
    return Finish.over(acc, vec4(col * a, a))
}
// The inputs a slider, a combo box, a number or a well carries inside
// themselves draw nothing: the control round them is the box.
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// A field keeps its sideways clip (a long line scrolls inside it) and lets
// its shadows past its top and foot.
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.w < 0.01 || self.border_radius < 0.5 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_field(pq, self.rect_size, self.rect_pos, px, self.border_radius, self.hover, self.down, self.focus, self.disabled)
}
mod.widgets.TextInputFlat.padding.left = 12.0
mod.widgets.TextInputFlat.padding.right = 12.0

