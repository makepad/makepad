// RADIO. A 14 point round well, darker than a box, with a 7 point lamp in
// it: off a dim grey cell, on the accent with a hot middle.
let nd_radio = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, active: float, disabled: float) -> vec4 {
    let rr = 7.0
    let cy = Finish.snap(org.y + size.y * 0.5, px) - org.y
    let c = vec2(rr, cy)
    let h = vec2(rr, rr)
    let d = length(pq - c) - rr
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.4, disabled)
    let v = clamp((pq.y - (c.y - rr)) / (2.0 * rr), 0.0, 1.0)
    var fill = mix(vec3(0.02, 0.024, 0.043), vec3(0.059, 0.071, 0.09), v)
    fill = fill + vec3(0.04, 0.042, 0.046) * hover * en - vec3(0.015, 0.015, 0.015) * down * en
    fill = mix(fill, vec3(0.133, 0.145, 0.165), disabled)
    var col = nd_well(fill, pq, c, h, rr, d, px, 14.0, (1.0 + 0.3 * down) * dis)
    let dr = 3.5
    let dd = length(pq - c) - dr
    let offc = mix(vec3(0.2, 0.212, 0.239) + vec3(0.08, 0.08, 0.09) * hover * en, vec3(0.16, 0.17, 0.19), disabled)
    col = mix(col, offc, Finish.cover(dd, px) * (1.0 - active * en))
    col = mix(col, nd_lamp(col, pq, c, dr, px, nd_accent(), 1.0, 1.0), active * en)
    col = col + vec3(nd_grain(org + pq, px, 1.9))
    let a = Finish.cover(d, px)
    var acc = vec4(col * a, a)
    acc = Finish.over(acc, nd_lip(pq, c, h, d, px, en))
    return Finish.over(acc, nd_focus(d, px, focus * en))
}
