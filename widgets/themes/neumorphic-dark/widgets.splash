// The outlined button is cut into the page: the contact line round a flat
// face and a lit lip under it; it rises under the pointer.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
