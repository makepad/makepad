use mod.prelude.widgets_internal.*

// THE MATERIAL. One navy-charcoal ground, pushed up into raised parts or
// pressed into wells. Relief is light, not colour: a faint lift above a
// raised part, a soft fall and a tight contact shadow below it, a
// one-device-pixel near-black contact line round it, a lighter line just
// inside its top edge, and a face that is a shallow dish (darker under the
// top edge, a little lighter than the ground at the foot). State lives in
// small lights of one accent, set in a dark slot so they read as lights.
// Light comes from the top left. Distances are points; shadows are drawn
// OUTSIDE the layout box, in a quad grown in `vertex`, so they cost no
// padding.

let nd_ground = fn() -> vec3 {
    return vec3(0.173, 0.184, 0.212)
}
let nd_accent = fn() -> vec3 {
    return vec3(0.271, 0.922, 0.878)
}
let nd_line = fn() -> vec3 {
    return vec3(0.043, 0.051, 0.067)
}

// Fine monochrome grain, one value per device pixel in window space, so a
// face and the ground round it read as one material. `amt` is the peak in
// levels of 255 (the standard deviation is 0.41 of it).
let nd_grain = fn(q: vec2, px: float, amt: float) -> float {
    return Finish.grain(q / px, amt / 255.0)
}

// What a raised part throws round itself, premultiplied: a soft fall below
// (reaching about a quarter of the part's height), a tight contact shadow
// right under the edge, and a faint lift of the ground above and to the
// left. `s` is the part's own height, the rest their strengths.
let nd_cast = fn(p: vec2, c: vec2, h: vec2, r: float, s: float, fall: float, lift: float, con: float) -> vec4 {
    let f = Finish.drop(p, c, h, r, vec2(0.02 * s, 0.075 * s), max(0.09 * s, 1.0)) * 0.7 * fall
    let t = Finish.drop(p, c, h, r, vec2(0.0, 0.03 * s), max(0.03 * s, 0.5)) * 0.65 * con
    let l = Finish.drop(p, c, h, r, vec2(-0.025 * s, -0.05 * s), max(0.06 * s, 0.7)) * 0.13 * lift
    var acc = vec4(vec3(0.039, 0.043, 0.055) * f, f)
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, t))
    acc = Finish.over(acc, vec4(l, l, l, l))
    return acc
}

// A raised face: the dish, the light line one device pixel inside the top
// edge (fading down the corners), and a fainter one along the foot.
let nd_face = fn(p: vec2, c: vec2, h: vec2, r: float, d: float, px: float, raise: float, lift: float, lines: float) -> vec3 {
    let v = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let g = mix(-0.042, 0.03, smoothstep(0.02, 0.92, v)) * raise + lift
    var col = nd_ground() + vec3(g, g, g)
    let top = 1.0 - smoothstep(r * 0.3, r + 0.6, p.y - (c.y - h.y))
    let bot = 1.0 - smoothstep(r * 0.3, r + 0.6, (c.y + h.y) - p.y)
    let inner = Finish.band(d, px, 2.0 * px, px)
    col = mix(col, vec3(1.0, 1.0, 1.0), inner * top * 0.11 * lines)
    col = mix(col, vec3(1.0, 1.0, 1.0), inner * bot * 0.05 * lines)
    return col
}

// A well: the fill given, the ground's shadow falling in along the top, and
// a dark line on the rim.
let nd_well = fn(fill: vec3, p: vec2, c: vec2, h: vec2, r: float, d: float, px: float, s: float, k: float) -> vec3 {
    let sh = Finish.inset(p, c, h, r, vec2(0.0, 0.1 * s), max(0.14 * s, 0.8))
    var o = mix(fill, vec3(0.0, 0.0, 0.0), sh * 0.6 * k)
    o = mix(o, nd_line(), Finish.band(d, 0.0, px, px) * 0.55 * k)
    return o
}

// The lit lip one device pixel outside a well's lower edge.
let nd_lip = fn(p: vec2, c: vec2, h: vec2, d: float, px: float, k: float) -> vec4 {
    let low = smoothstep(c.y + h.y * 0.1, c.y + h.y, p.y)
    let a = Finish.ring_out(d, 0.0, px, px) * low * 0.08 * k
    return vec4(a, a, a, a)
}

// The focus mark: a one-pixel accent ring a point and a half outside the
// contact line, and a short teal halo either side of it.
let nd_focus = fn(d: float, px: float, f: float) -> vec4 {
    let ring = Finish.ring_out(d, 1.5, 1.5 + px, px) * 0.55 * f
    let soft = (1.0 - smoothstep(0.0, 2.5, abs(d - 1.5 - 0.5 * px))) * 0.25 * step(0.0, d) * f
    var acc = vec4(vec3(0.118, 0.408, 0.412) * soft, soft)
    return Finish.over(acc, vec4(nd_accent() * ring, ring))
}

// A light in a slot. `dc` is the distance to the lit core (negative
// inside): the core, one device pixel of dark gap round it, and beyond the
// gap a short halo that is gone three points out. Unlit, the core is a dark
// cell and there is no halo.
let nd_led_gap = fn(col: vec3, dc: float, px: float, gap: float, ink: vec3, lit: float, halo: float) -> vec3 {
    let x = max(dc - gap, 0.0)
    let fall = 1.0 - smoothstep(0.0, 2.3, x)
    var o = col + ink * 0.2 * fall * fall * halo * lit * step(0.0, dc)
    o = mix(o, nd_line(), Finish.ring_out(dc, 0.0, gap, px) * 0.85)
    let core = mix(vec3(0.102, 0.110, 0.129), ink, lit)
    return mix(o, core, Finish.cover(dc, px))
}
let nd_led = fn(col: vec3, dc: float, px: float, ink: vec3, lit: float, halo: float) -> vec3 {
    return nd_led_gap(col, dc, px, px, ink, lit, halo)
}

// A round lamp: lit, the core with a hot middle; off, a dark cell below the
// ground.
let nd_lamp = fn(col: vec3, p: vec2, lc: vec2, lr: float, px: float, ink: vec3, lit: float, halo: float) -> vec3 {
    let dd = length(p - lc) - lr
    let hot = 1.0 - smoothstep(lr * 0.15, lr * 0.55, length(p - lc - vec2(0.0, -0.1 * lr)))
    let lamp_ink = mix(ink, mix(ink, vec3(1.0, 1.0, 1.0), 0.4), hot * lit)
    let off = vec3(0.086, 0.094, 0.102)
    var o = nd_led(col, dd, px, lamp_ink, lit, halo)
    return mix(o, mix(off, lamp_ink, lit), Finish.cover(dd, px))
}

// The distance to an arc of radius R about c, clockwise from a0 to a1
// measured from straight down, with round ends, w wide. Written here
// because the stock arc gives up on any sweep past half a turn.
let nd_arc = fn(p: vec2, c: vec2, R: float, a0: float, a1: float, w: float) -> float {
    let q = p - c
    var ap = atan2(-q.x, q.y)
    if ap < 0.0 {
        ap = ap + 2.0 * PI
    }
    let rel = ap - a0 - floor((ap - a0) / (2.0 * PI)) * 2.0 * PI
    let on = step(rel, a1 - a0)
    let band = abs(length(q) - R) - 0.5 * w
    let e0 = length(q - vec2(-sin(a0), cos(a0)) * R) - 0.5 * w
    let e1 = length(q - vec2(-sin(a1), cos(a1)) * R) - 0.5 * w
    return mix(min(e0, e1), band, on)
}

// A distance to a segment, for the strokes the faces draw by hand.
let nd_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// BUTTONS. `rest` 1 stands up off the page, 0 lies flat and rises two
// thirds under the pointer; `ghost` draws the contact line round a flat
// face; `hollow` shows nothing until the pointer asks, and then a faint
// hollow. `slot` puts an LED line in the foot of the face (`led.a` is how
// lit it is). Held, any of them is pressed in: flat, a step below the
// ground, the page's shadow falling in along the top.
let nd_button = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, ink: vec4, rest: float, ghost: float, hollow: float, slot: float, led: vec4) -> vec4 {
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + size.x, px), Finish.snap(org.y + size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let s = min(size.y, 32.0)
    let r = min(0.27 * size.y, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let hv = hover * en
    let press = down * en
    let raised = step(0.5, rest)
    let up = mix(mix(0.65 * hv, 1.0, raised), 0.0, hollow) * (1.0 - press)
    var acc = nd_cast(pq, c, h, r, s, up * mix(1.0, 0.4, disabled), up * en * (1.0 + 0.4 * hv), max(up * mix(1.0, 0.5, disabled), 0.45 * press))
    var col = nd_face(pq, c, h, r, d, px, up * en, 0.03 * hv, up * en * (1.0 + 0.6 * hv))
    let sink = max(press, hollow * hv * 0.55)
    let deep = Finish.inset(pq, c, h, r, vec2(0.0, 0.08 * s), 0.1 * s)
    let pc = mix(nd_ground() - vec3(0.045, 0.045, 0.045), vec3(0.0, 0.0, 0.0), deep * 0.5)
    col = mix(col, pc, sink)
    // The LED line in the foot of the face: 0.4 of the width, two device
    // pixels of light in a slot of dark, its centre on a pixel boundary so
    // the core fills two whole rows.
    let ly = Finish.snap(org.y + c.y + h.y - 0.12 * s, px) - org.y
    let lw = h.x * 0.4
    let dc = nd_seg(pq, vec2(c.x - lw, ly), vec2(c.x + lw, ly)) - px
    col = mix(col, nd_led(col, dc, px, led.rgb, led.a * en, 1.0), slot)
    col = col + vec3(nd_grain(org + pq, px, 1.9))
    // The contact line: on anything that stands up, on a pressed face, and
    // on the ghost's flat one.
    let ol = max(max(up, sink), ghost) * mix(0.75, 0.3, disabled)
    col = mix(col, nd_line(), Finish.band(d, 0.0, px, px) * ol)
    let a = Finish.cover(d, px)
    acc = Finish.over(acc, vec4(col * a, a))
    // A ghost face is cut into the page: the lit lip under its foot.
    acc = Finish.over(acc, nd_lip(pq, c, h, d, px, max(ghost * (1.0 - up), sink) * en))
    acc = Finish.over(acc, nd_focus(d, px, focus * en))
    // The wait spinner is drawn by the face, so a face that replaces the
    // stock one has to draw it again: a lit arc in a dark track.
    let rr = max(min(h.x, h.y) - 5.0, 2.0)
    let a0 = anim * 2.0 * PI
    let sa = Finish.cover(nd_arc(pq, c, rr, a0, a0 + 1.5 * PI, 1.0), px) * ink.a * loading
    return Finish.over(acc, vec4(ink.rgb * sa, sa))
}

// The room round every button for its shadows and its focus ring.
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
// A view lets what it holds draw past its edge; scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// The flat button: the page until the pointer raises it.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 0.0, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
// The standard, sized and compound buttons stand up off the page.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 1.0, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonXs.draw_bg.pixel = fn() {
