}
// The borderless button shows nothing until the pointer finds it.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nd_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 0.0, 0.0, 1.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}

// Rows of 26: 6 above and below the line, 12 either side.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 6.25 bottom: 6.25}
mod.widgets.ButtonFlat.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonFlat.spacing = 6.0
mod.widgets.ButtonFlat.icon_walk.width = 13.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 6.0 bottom: 6.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 6.0 bottom: 6.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 6.0 bottom: 6.0}
mod.widgets.ButtonFlat.draw_bg.loading_color = #45ebe0
mod.widgets.ButtonFlat.draw_icon.color = #b9bfca
mod.widgets.ButtonFlat.draw_icon_end.color = #b9bfca

// Hover eases in over the tenth of a second the animator already gives it
// rather than snapping, so a hover held still (the states page) shows.
mod.widgets.ButtonFlat.animator.hover.on.apply.draw_bg.hover = 1.0
mod.widgets.ButtonFlat.animator.hover.on.apply.draw_text.hover = 1.0
mod.widgets.TextInputFlat.animator.hover.on.apply.draw_bg.hover = 1.0
mod.widgets.TextInputFlat.animator.hover.on.apply.draw_text.hover = 1.0
// The press does the same, over three hundredths of a second, so a held
// press shows too.
mod.widgets.ButtonFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.ButtonFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.ButtonFlat.animator.hover.down.apply.draw_text.down = 1.0
mod.widgets.TextInputFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.TextInputFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.DropDownFlat.animator.hover.on.apply.draw_bg.hover = 1.0
mod.widgets.DropDownFlat.animator.hover.on.apply.draw_text.hover = 1.0
mod.widgets.DropDownFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.DropDownFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.CheckBoxFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.CheckBoxFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.ToggleFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.ToggleFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.RadioButtonFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.RadioButtonFlat.animator.hover.down.apply.draw_bg.down = 1.0
mod.widgets.RadioButtonTabFlat.animator.hover.down.from.all.duration = 0.03
mod.widgets.RadioButtonTabFlat.animator.hover.down.apply.draw_bg.down = 1.0

// Label inks: the working grey, a step brighter on the primary, the
// accent on the tertiary and the outline, coral on the destructive one.
let nd_medium = mod.theme.font_regular{font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Inter.ttf") weight: 500.0 asc: 0.0 desc: 0.0}}}
mod.widgets.ButtonFlat.draw_text.text_style = nd_medium
mod.widgets.ButtonPrimary.draw_text.color = #d7dde6
mod.widgets.ButtonPrimary.draw_text.color_hover = #eef2f7
mod.widgets.ButtonPrimary.draw_text.color_down = #eef2f7
mod.widgets.ButtonPrimary.draw_text.color_focus = #d7dde6
mod.widgets.ButtonPrimary.draw_text.color_disabled = #5a5e66
mod.widgets.ButtonPrimary.draw_icon.color = #d7dde6
mod.widgets.ButtonSecondary.draw_text.color = #b9bfca
mod.widgets.ButtonSecondary.draw_text.color_hover = #d7dde6
mod.widgets.ButtonSecondary.draw_text.color_down = #d7dde6
mod.widgets.ButtonSecondary.draw_text.color_focus = #b9bfca
