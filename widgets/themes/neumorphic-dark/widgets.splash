// TOGGLE. A 34 by 18 pill well with a lit lip, and in it a 14 point raised
// thumb carrying a 5 point lamp: off a dark cell, on the accent with a hot
// middle.
let nd_toggle = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, active: float, disabled: float, error: float, t: float, at_end: float) -> vec4 {
    let w = 34.0
    let x0 = Finish.snap(org.x + (size.x - w) * at_end, px) - org.x
    let cy = Finish.snap(org.y + size.y * 0.5, px) - org.y
    let tc = vec2(x0 + w * 0.5, cy)
    let th = vec2(w * 0.5, 9.0)
    let td = Material.sd_box(pq, tc, th, 9.0)
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.4, disabled)
    var col = nd_well(mix(vec3(0.075, 0.082, 0.098), vec3(0.133, 0.145, 0.165), disabled), pq, tc, th, 9.0, td, px, 18.0, dis)
    // A faint accent wash along the well where the lit thumb has been.
    let wash = (1.0 - smoothstep(0.0, 18.0, abs(pq.x - (x0 + 9.0 + 16.0 * t)))) * active * en * 0.05
    col = col + nd_accent() * wash
    col = col + vec3(nd_grain(org + pq, px, 1.9))
    let ta = Finish.cover(td, px)
    var acc = vec4(col * ta, ta)
    acc = Finish.over(acc, nd_lip(pq, tc, th, td, px, en))
    // The thumb, and what it throws.
    // Seven points, rounded to whole device pixels so the light line under
    // the thumb's top edge lands on one pixel row.
    let kr = Finish.snap(7.0, px)
    let kc = vec2(x0 + 9.0 + 16.0 * t, cy)
    let kh = vec2(kr, kr)
    let kd = length(pq - kc) - kr
    let press = down * en
    let up = 1.0 - press
    let hv = hover * en * (1.0 - press)
    acc = Finish.over(acc, nd_cast(pq, kc, kh, kr, 14.0, up * dis, up * en * (1.0 + 0.4 * hv), dis))
    // The face: a dish from the ground under its top edge to well above it
    // at its foot, with the light line, so the thumb stands off the black
    // track; held, it is pressed flat below the ground with the shadow
    // falling in along its top.
    var kcol = nd_face(pq, kc, kh, kr, kd, px, en, 0.042 * en + 0.03 * hv, en * (1.35 + 0.5 * hv))
    let deep = Finish.inset(pq, kc, kh, kr, vec2(0.0, 1.6), 1.8)
    let pc = mix(nd_ground() - vec3(0.05, 0.05, 0.05), vec3(0.0, 0.0, 0.0), deep * 0.6)
    kcol = mix(kcol, pc, press)
    kcol = mix(kcol, nd_line(), Finish.band(kd, 0.0, px, px) * 0.75 * dis)
    let ink = mix(nd_accent(), vec3(0.878, 0.443, 0.424), error)
    // The lamp cell, five points across with its dark ring.
    kcol = nd_lamp(kcol, pq, kc, 2.5 - px, px, ink, active * en, 1.0)
    kcol = kcol + vec3(nd_grain(org + pq, px, 1.9))
    let ka = Finish.cover(kd, px)
    acc = Finish.over(acc, vec4(kcol * ka, ka))
    return Finish.over(acc, nd_focus(td, px, focus * en))
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let t = mix(self.active, self.drag_pos, self.drag)
    return nd_toggle(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.active, self.disabled, self.error, t, self.mark_at_end)
}
mod.widgets.ToggleFlat.draw_bg.size = 18.0
