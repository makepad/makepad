// The primary face is the plain face with its LED line lit; the colour is
// that line and never a filled face.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
