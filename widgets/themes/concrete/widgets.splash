// ---------------------------------------------------------------------------
// THE SLAB under everything: the window's own ground. The cast grey with its
// blotches, streaks, sand and pores, and a long fall of 0.03 from top to
// bottom.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let t = clamp(self.pos.y, 0.0, 1.0)
    let base = vec3(0.545, 0.541, 0.525) * (1.035 - 0.08 * t)
    let col = cc_stone(base, p + self.rect_pos, px, 1.0, 1.0)
    return vec4(col, 1.0)
}
true
