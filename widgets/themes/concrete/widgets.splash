// NUMBER FIELDS. The pocket, and on its right a 14 point column of two small
// cast blocks split by a joint, each with a stamped triangle; the half under
// the pointer lifts, the held half is pressed in.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 2.0)
}
mod.widgets.NumberField.pad_left = 8.0
mod.widgets.NumberSpin.width = 14.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
let cc_tri = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    // a triangle hw wide either side, 2 hh tall, apex up (dir -1) or down (1)
    let y = (p.y - c.y) * dir
    let e = (abs(p.x - c.x) * 2.0 * hh + hw * (y - hh)) / sqrt(4.0 * hh * hh + hw * hw)
    return max(-hh - y, e)
}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, 2.0 * px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(2.0 * px, 3.0 * px)
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let hc = vec2((lo.x + hi.x) * 0.5, mix((mid + px + hi.y) * 0.5, (lo.y + mid) * 0.5, upper))
    let hh = vec2((hi.x - lo.x) * 0.5, mix((hi.y - mid - px) * 0.5, (mid - lo.y) * 0.5, upper))
    var out = cc_cap(p, hc, hh, vec4(1.0, 1.0, 1.0, 1.0), o, px, hot, dn, self.disabled, vec4(0.0, 0.0, 0.0, 0.0))
    let cx = (lo.x + hi.x) * 0.5
    let tu = cc_tri(p, vec2(cx, (lo.y + mid) * 0.5 + dn * px * upper), 3.0, 1.6, -1.0)
    let td = cc_tri(p, vec2(cx, (mid + hi.y) * 0.5 + dn * px * (1.0 - upper)), 3.0, 1.6, 1.0)
    let tl = Finish.cover(min(cc_tri(p - vec2(0.0, px), vec2(cx, (lo.y + mid) * 0.5), 3.0, 1.6, -1.0), cc_tri(p - vec2(0.0, px), vec2(cx, (mid + hi.y) * 0.5), 3.0, 1.6, 1.0)), px) * 0.5 * live
    out = Finish.over(out, vec4(0.88 * tl, 0.875 * tl, 0.86 * tl, tl))
    let ti = Finish.cover(min(tu, td), px)
    let ink = mix(vec3(0.12, 0.12, 0.115), vec3(0.42, 0.418, 0.405), self.disabled)
    return Finish.over(out, vec4(ink * ti, ti))
}

// The drag-number: the pocket, its track a pale wash behind dark digits.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = cc_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 2.0)
    let d = cc_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(2.0 * px, 2.0 * px), 2.0)
    let wx = 2.0 * px + (self.rect_size.x - 4.0 * px) * max(self.fill, 0.0)
    let wash = step(0.0, self.fill) * step(p.x, wx) * Finish.cover(d, px) * 0.14
    return Finish.over(out, vec4(0.435 * wash, 0.682 * wash, 0.533 * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #e6e5df
mod.widgets.ValueInput.draw_text.text_style = mod.theme.font_label{font_size: 8.5 line_spacing: 1.0}
mod.widgets.ValueInput.arrow_color = #c8c7c1
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// ---------------------------------------------------------------------------
// DROP-DOWNS. The cast block with a 22 point arrow cell on the right, set off
// by an engraved joint; the arrow is a stamped triangle. Open, the block is
// held pressed.
// `ins` 1: the drop-down stands in the field row, whose box is two points
// taller than a block for the lip a pocket keeps inside; its block takes the
// pocket's rows, so it stands as tall as the fields and the buttons beside it.
let cc_dropdown = fn(pos0: vec2, size0: vec2, o0: vec2, px: float, hover: float, held: float, focus: float, dis: float, ins: float) -> vec4 {
    let m = 6.0
    let p = pos0 * (size0 + vec2(2.0 * m, 2.0 * m)) - vec2(m, m) - vec2(0.0, px * ins)
    let size = size0 - vec2(0.0, 3.0 * px * ins)
    let o = o0 + vec2(0.0, px * ins)
    let pos = (p + vec2(m, m)) / (size + vec2(2.0 * m, 2.0 * m))
    var out = cc_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(2.5, 2.5, 2.5, 2.5), 0.0, m, vec4(0.0, 0.0, 0.0, 0.0))
    let live = 1.0 - dis
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.18, p.y) * step(p.y, size.y * 0.82)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * mix(0.8, 0.4, dis)
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.6
    out = Finish.over(out, vec4(0.06 * div_d, 0.06 * div_d, 0.055 * div_d, div_d))
    out = Finish.over(out, vec4(0.88 * div_l, 0.875 * div_l, 0.86 * div_l, div_l))
    let dn = held * live * px
    let cc = vec2(Finish.snap(o.x + size.x - 11.0, px) - o.x, size.y * 0.5 + dn)
    let lit = Finish.cover(cc_tri(p - vec2(0.0, px), cc, 3.5, 2.0, 1.0), px) * 0.5 * live
    out = Finish.over(out, vec4(0.88 * lit, 0.875 * lit, 0.86 * lit, lit))
    let tri = Finish.cover(cc_tri(p, cc, 3.5, 2.0, 1.0), px)
    let ink = mix(vec3(0.12, 0.12, 0.115), vec3(0.42, 0.418, 0.405), dis)
    return Finish.over(out, vec4(ink * tri, tri))
}

