use mod.prelude.widgets_internal.*

// Cast concrete, lit from straight above. A control is a cast BLOCK (button,
// thumb, knob, toggle cube, slab) or a POCKET sunk into the slab (field,
// groove, check box, slot, chosen cell). Blocks: the slab's own grey with its
// pores and sand, a chamfered shoulder lit at the top and dark at the foot, a
// crisp light line along the top edge, a dark hairline, and a soft cast
// shadow under them. Pockets: a darker floor, a shade falling in under the
// top edge, a black line inside it, a light lip under the pocket. Light only
// where a value is: a pale verdigris inlay set in dark glass.

// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. A field is a pocket and draws its seat and lip
// inside its own box, since it clips its own text; so the box is 28 and the
// visible pocket 26, the height of a button's block, whose shadow falls
// outside its box.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.34

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #8b8a86

// Plain views stop clipping, so a cast shadow or a lip may fall into the gap
// beside its control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. `w` is a point in window space.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let cc_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let cc_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    let r = clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(r, r)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's radius.
let cc_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let cc_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

let cc_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The cast's tone at window point w, as a signed share: broad blotches, the
// vertical streaks the form water left, fine sand and a free grain.
let cc_tex = fn(w: vec2, px: float) -> float {
    let mott = (Finish.fbm(w * 0.021) - 0.5) * 0.20
    let streak = (Finish.fbm(vec2(w.x * 0.15, w.y * 0.009) + vec2(31.0, 7.0)) - 0.5) * 0.10
    let sand = (Finish.noise(w * 0.7) - 0.5) * 0.06
    return mott + streak + sand + Finish.grain(w / px, 0.03)
}

// One lattice of pores: a hole in some of the cells, dark, its lower rim
// catching the light. `.x` the hole, `.y` the lit lip.
let cc_pore_layer = fn(w: vec2, px: float, cell: float, dens: float, r0: float, r1: float, seed: vec2) -> vec2 {
    let g = floor(w / cell)
    let h0 = Finish.hash(g + seed)
    let h1 = Finish.hash(g + seed + vec2(17.31, 41.73))
    let h2 = Finish.hash(g + seed + vec2(-9.17, 23.41))
    let h3 = Finish.hash(g + seed + vec2(5.53, -3.37))
    let ctr = (g + vec2(0.25 + 0.5 * h1, 0.25 + 0.5 * h2)) * cell
    let r = mix(r0, r1, h0 * h0 * h0)
    let q = w - ctr
    let d = length(q) - r
    let on = step(h3, dens)
    let hole = Finish.cover(d, px) * on
    let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, r, q.y) * on
    return vec2(hole, lip)
}

// Pores at two scales: a fine pepper and the odd air bubble.
let cc_pores = fn(w: vec2, px: float, amt: float) -> vec2 {
    let a = cc_pore_layer(w, px, 6.0, 0.16 * amt, 0.28, 1.0, vec2(0.0, 0.0))
    let b = cc_pore_layer(w, px, 37.0, 0.24 * amt, 0.8, 2.0, vec2(113.0, 57.0))
    return vec2(max(a.x, b.x), max(a.y, b.y))
}

// The material laid on a base colour: tone, then pores.
let cc_stone = fn(base: vec3, w: vec2, px: float, tex: float, pore: float) -> vec3 {
    var col = base * (1.0 + cc_tex(w, px) * tex)
    let pr = cc_pores(w, px, pore)
    col = mix(col, base * 0.32, pr.x * 0.75)
    col = mix(col, Finish.lift(base, 0.30), pr.y * 0.45)
    return col
}

// The soft cast shadow under a block: a broad one cast down and a tight
// contact one, both near black. `soft` and `tight` scale them.
let cc_cast = fn(p: vec2, c: vec2, h: vec2, r: float, soft: float, tight: float) -> vec4 {
    let s1 = Finish.drop(p, c, h, r, vec2(0.0, 2.4), 1.9) * 0.78 * soft
    let s2 = Finish.drop(p, c, h, r, vec2(0.0, 0.7), 0.6) * 0.70 * tight
    let a = clamp(s1 + s2 * (1.0 - s1), 0.0, 1.0)
    return vec4(0.05 * a, 0.05 * a, 0.045 * a, a)
}

// A cast block's face, premultiplied: the material over a fall from the
// lit top to the foot, the chamfered shoulder (light facing up, dark facing
// down), the light line on the top edge, a dark hairline. Pressed, the block
// sits lower: darker, a shade under its top edge, the shoulder quiet.
let cc_cap = fn(p: vec2, c: vec2, h: vec2, r4: vec4, o: vec2, px: float, hover: float, press: float, dis: float, tint: vec4) -> vec4 {
    let d = cc_rbox4(p, c, h, r4)
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    let yin = p.y - (c.y - h.y)
    let t = clamp(yin / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let e = 0.5
    let gx = cc_rbox4(p + vec2(e, 0.0), c, h, r4) - cc_rbox4(p - vec2(e, 0.0), c, h, r4)
    let gy = cc_rbox4(p + vec2(0.0, e), c, h, r4) - cc_rbox4(p - vec2(0.0, e), c, h, r4)
    let g = vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
    var base = mix(vec3(0.640, 0.636, 0.618), vec3(0.545, 0.541, 0.525), t)
    base = mix(base, tint.rgb * (Finish.lum(base) / 0.62), tint.a)
    var face = cc_stone(base, p + o + vec2(37.0, 11.0), px, 0.9, 0.45)
    face = face * (1.0 - 0.13 * press)
    face = mix(face, vec3(0.05, 0.05, 0.045), clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.2), 1.4), 0.0, 1.0) * 0.50 * press)
    let bev = Finish.bevel(d, g, 2.6, vec2(0.0, -1.0)) * Finish.cover(d, px)
    face = Finish.lift(face, bev * mix(0.50, 0.06, press) * mix(1.0, 0.35, dis))
    // the foot: the block's lower edge in its own shade
    face = mix(face, face * 0.78, smoothstep(2.0 * h.y - 3.5, 2.0 * h.y, yin) * (1.0 - press) * (1.0 - dis))
    face = Finish.lift(face, 0.09 * hover * (1.0 - press))
    face = mix(face, vec3(0.62, 0.617, 0.60), dis * 0.45)
    let across = 1.0 - smoothstep(h.x - r - 0.5, h.x - r * 0.2, abs(p.x - c.x))
    let hl = (Finish.band(d, px, 2.0 * px, px) + 0.45 * Finish.band(d, 2.0 * px, 3.0 * px, px)) * mix(1.0, across, step(0.5, r)) * step(yin, max(r, 2.0 * px) + 2.0 * px)
    face = mix(face, vec3(0.93, 0.925, 0.91), clamp(hl, 0.0, 1.0) * mix(0.90, 0.25, press) * mix(1.0, 0.4, dis))
    let olc = mix(vec3(0.36, 0.355, 0.34), vec3(0.13, 0.13, 0.125), smoothstep(0.15, 0.85, t))
    face = mix(face, olc, Finish.band(d, 0.0, px, px) * mix(0.95, 0.5, dis))
    let a = Finish.cover(d, px)
    return vec4(face * a, a)
}

// A pocket sunk into the slab, premultiplied: its floor (the material, a
// little quieter), the shade falling in under the top edge, a black line
// inside the top, a dark rim, and round it a dark seat above and a light
// lip below. `fill` is the floor's grey, `shade` the depth.
let cc_pocket = fn(p: vec2, c: vec2, h: vec2, r: float, o: vec2, px: float, fill: vec3, shade: float, lip: float) -> vec4 {
    let d = cc_rbox(p, c, h, r)
    let yin = p.y - (c.y - h.y)
    var col = cc_stone(fill, p + o + vec2(71.0, 5.0), px, 0.55, 0.35)
    let sh = clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.5), 1.9), 0.0, 1.0)
    col = mix(col, vec3(0.03, 0.03, 0.028), sh * shade)
    let top = 1.0 - smoothstep(0.0, max(h.y, 1.0), yin)
    col = mix(col, vec3(0.05, 0.05, 0.048), Finish.band(d, px, 2.0 * px, px) * top * 0.55 * shade)
    col = mix(col, vec3(0.10, 0.10, 0.095), Finish.band(d, 0.0, px, px) * mix(0.55, 0.9, top))
    let a = Finish.cover(d, px)
    let up = smoothstep(0.0, h.y * 0.85, c.y - p.y)
    let low = smoothstep(0.0, h.y * 0.85, p.y - c.y)
    let li = (Finish.ring_out(d, 0.0, px, px) * 0.75 + Finish.ring_out(d, px, 2.0 * px, px) * 0.25) * low * lip
    let sd = Finish.ring_out(d, 0.0, px, px) * up * 0.30 * lip
    var out = vec4(0.88 * li, 0.875 * li, 0.86 * li, li)
    out = Finish.over(out, vec4(0.05 * sd, 0.05 * sd, 0.045 * sd, sd))
    return Finish.over(out, vec4(col * a, a))
}

// Focus: a device pixel and a half of verdigris two points outside the edge.
let cc_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 1.5, 1.5 + 1.5 * px, px) * 0.95 * focus
    return vec4(0.184 * f, 0.490 * f, 0.384 * f, f)
}

// The lit inlay colour and its core.
let cc_lit = fn(k: float) -> vec3 {
    return mix(vec3(0.80, 0.95, 0.85), vec3(0.435, 0.682, 0.533), smoothstep(0.0, 0.5, k))
}

// A round glass inlay set into a block or the slab: lit, a pale core, the
// verdigris body and a soft halo held within two points; dark, smoked glass
// with a glint. `ink` is the lit colour.
let cc_lamp = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, core: vec3, lit: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let k = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let v = clamp(q.y / max(rad, 0.001) * 0.5 + 0.5, 0.0, 1.0)
    let on = mix(mix(core, ink, smoothstep(0.1, 0.75, k)), ink * 0.72, smoothstep(0.75, 1.0, k))
    let off = mix(vec3(0.14, 0.145, 0.14), vec3(0.23, 0.235, 0.23), v)
    var col = mix(off, on, lit)
    let gl = Finish.cover(length(q - vec2(-0.3, -0.35) * rad) - rad * 0.28, px)
    col = mix(col, vec3(0.62, 0.63, 0.62), gl * (1.0 - lit) * 0.6)
    col = mix(col, mix(vec3(0.06, 0.06, 0.058), ink * 0.45, lit), Finish.band(d, 0.0, px, px) * 0.8)
    let a = Finish.cover(d, px)
    let ha = lit * 0.45 * exp(-max(d, 0.0) / 1.1) * step(0.0, d) * (1.0 - a)
    var out = vec4(ink * ha, ha)
    let lp = Finish.ring_out(d, 0.0, px, px) * smoothstep(-0.2, 0.5, q.y / max(rad, 0.001)) * 0.6 * (1.0 - lit)
    out = Finish.over(out, vec4(0.88 * lp, 0.875 * lp, 0.86 * lp, lp))
    return Finish.over(out, vec4(col * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing: 0 the cast
// block, 1 the block with a lit verdigris inlay (primary), 2 the block with
// its inlay dark (secondary), 4 the block with a lit red inlay (danger), 5 a
// stamped frame that rises to a block under the pointer (outline), 6 a
// shallow pocket (flatter). The quad is grown by `m` for the cast shadow and
// the focus ring.
let cc_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, r4: vec4, kind: float, m: float, tint: vec4) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = cc_rbox4(p, c, h, r4)
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if kind < 4.5 {
        out = cc_cast(p, c, h, r, (1.0 - press * 0.85) * (1.0 - dis) * (1.0 + 0.25 * hover * live), 1.0 - 0.6 * dis)
        out = Finish.over(out, cc_cap(p, c, h, r4, o, px, hover * live, press, dis, tint))
        if kind > 0.5 {
            let lc = vec2(Finish.snap(o.x + lo.x + 9.5, px) - o.x, Finish.snap(o.y + c.y, px) - o.y)
            let red = step(3.5, kind)
            let ink = mix(vec3(0.435, 0.682, 0.533), vec3(0.878, 0.216, 0.157), red)
            let core = mix(vec3(0.88, 0.99, 0.92), vec3(1.0, 0.78, 0.70), red)
            let lit = (1.0 - step(1.5, kind) * step(kind, 2.5)) * live
            out = Finish.over(out, cc_lamp(p, lc + vec2(0.0, press * 0.5), 2.6, px, ink, core, lit))
        }
    } else {
        if kind < 5.5 {
            let show = clamp(hover * live * 0.85 + press, 0.0, 1.0)
            out = cc_cast(p, c, h, r, show * (1.0 - press * 0.85), show)
            out = Finish.over(out, cc_cap(p, c, h, r4, o, px, 0.0, press, dis, tint) * show)
            // at rest a stamped frame: a dark groove a point wide, lit on
            // its lower inner side
            let rest = 1.0 - show
            let gd = abs(d + 0.6) - 0.6
            let gr = Finish.cover(gd, px) * mix(0.55, 0.25, dis) * rest
            out = Finish.over(out, vec4(0.06 * gr, 0.06 * gr, 0.055 * gr, gr))
            let li = Finish.band(d, 1.2, 1.2 + px, px) * smoothstep(0.0, h.y * 0.8, p.y - c.y) * 0.5 * rest
            let lo2 = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, h.y * 0.8, p.y - c.y) * 0.55 * rest
            out = Finish.over(out, vec4(0.88 * (li + lo2), 0.875 * (li + lo2), 0.86 * (li + lo2), li + lo2))
        } else {
            let fill = Finish.lift(vec3(0.537, 0.533, 0.518), 0.10 * hover * live - 0.06 * press)
            out = cc_pocket(p, c, h, r, o, px, mix(fill, vec3(0.58, 0.577, 0.56), dis), mix(0.55 + 0.25 * press, 0.2, dis), mix(1.0, 0.5, dis))
        }
    }
    out = Finish.over(out, cc_focus(d, px, focus * live))
    // The wait spinner, which the stock face drew and this one must too.
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        sdf.fill(vec4(0.16, 0.16, 0.15, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// Every button template: the root and the sizes share its draw object, so
// they wear the plain block; the roles are specialised below.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 0.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 0.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 1.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 2.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 0.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 4.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, cc_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 5.0, 6.0, vec4(0.0, 0.0, 0.0, 0.0))
}
