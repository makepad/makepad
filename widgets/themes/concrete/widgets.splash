// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point pocket sunk into the slab; set, a stamped block
// check stands in it, light on its upper edge. Under the pointer the pocket
// lightens. The quad grows four points for the lip and the focus ring.
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let live = 1.0 - self.disabled
    let x0 = mix(1.0, size.x - sz - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - sz) * 0.5, px)) - o
    let h = vec2(sz * 0.5, sz * 0.5)
    let c = lo + h
    let r = mix(2.0, h.y, step(20.0, self.border_radius))
    let d = cc_rbox(p, c, h, r)
    let fill = Finish.lift(mix(vec3(0.33, 0.328, 0.318), vec3(0.50, 0.497, 0.485), self.disabled), 0.30 * self.hover * live - 0.08 * self.down * live)
    var out = cc_pocket(p, c, h, r, o, px, fill, mix(0.75 + 0.2 * self.down * live, 0.3, self.disabled), mix(1.0, 0.5, self.disabled))
    let er = Finish.band(d, 0.0, 2.0 * px, px) * self.error
    out = Finish.over(out, vec4(0.78 * er, 0.20 * er, 0.16 * er, er))
    // the check, or the mixed dash: a 1.6 point stroke, pale, its shadow
    // one device pixel under it
    let k = sz / 14.0
    let m0 = lo + vec2(3.6, 7.2) * k
    let m1 = lo + vec2(6.0, 9.7) * k
    let m2 = lo + vec2(10.5, 4.4) * k
    let ck = min(cc_seg(p, m0, m1), cc_seg(p, m1, m2)) - 0.8 * k
    let ck_s = min(cc_seg(p - vec2(0.0, px), m0, m1), cc_seg(p - vec2(0.0, px), m1, m2)) - 0.8 * k
    let d0 = lo + vec2(4.0, 7.0) * k
    let d1 = lo + vec2(10.0, 7.0) * k
    let dash = cc_seg(p, d0, d1) - 0.8 * k
    let dash_s = cc_seg(p - vec2(0.0, px), d0, d1) - 0.8 * k
    let show_ck = self.active * (1.0 - self.mixed)
    let mk = mix(Finish.cover(ck, px) * show_ck, Finish.cover(dash, px), self.mixed)
    let mk_s = mix(Finish.cover(ck_s, px) * show_ck, Finish.cover(dash_s, px), self.mixed) * 0.7
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, mk_s))
    let ink = mix(mix(vec3(0.925, 0.922, 0.898), vec3(0.95, 0.45, 0.40), self.error), vec3(0.70, 0.697, 0.68), self.disabled)
    out = Finish.over(out, vec4(ink * mk, mk))
    return Finish.over(out, cc_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 30 by 14 point slot sunk into the slab, two cells long, and a
// 14 point cast cube riding in it with its shadow; on, the cell the cube has
// left shows a lit verdigris inlay.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 38.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 14.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.1429
mod.widgets.ToggleFlat.draw_bg.knob_inset = 1.0
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let tw = 30.0
    let x0 = mix(1.0, size.x - tw - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - 14.0) * 0.5, px)) - o
    let c = lo + vec2(tw * 0.5, 7.0)
    let h = vec2(tw * 0.5, 7.0)
    let d = cc_rbox(p, c, h, 2.0)
    let on = self.active
    let fill = Finish.lift(mix(vec3(0.33, 0.328, 0.318), vec3(0.50, 0.497, 0.485), self.disabled), 0.30 * self.hover * live)
    var out = cc_pocket(p, c, h, 2.0, o, px, fill, mix(0.75, 0.3, self.disabled), mix(1.0, 0.5, self.disabled))
    let er = Finish.band(d, 0.0, 2.0 * px, px) * self.error
    out = Finish.over(out, vec4(0.78 * er, 0.20 * er, 0.16 * er, er))
    let kt = clamp(mix(on, self.drag_pos, self.drag), 0.0, 1.0)
    // the lamp in the cell the cube leaves: lit only when on
    let lc = vec2(Finish.snap(o.x + lo.x + 7.5, px) - o.x, Finish.snap(o.y + c.y, px) - o.y)
    out = Finish.over(out, cc_lamp(p, lc, 2.5, px, vec3(0.435, 0.682, 0.533), vec3(0.88, 0.99, 0.92), on * live))
    // the cube
    let kh = vec2(6.5, 6.5)
    let kx = Finish.snap(o.x + lo.x + 0.5 + kt * (tw - 14.0), px) - o.x
    let kc = vec2(kx + 6.5, c.y - 0.5)
    let press = self.down * live
    out = Finish.over(out, cc_cast(p, kc, kh, 2.0, (0.8 + 0.2 * self.hover * live - press * 0.5) * mix(1.0, 0.35, self.disabled), 1.0))
    out = Finish.over(out, cc_cap(p, kc, kh, vec4(2.0, 2.0, 2.0, 2.0), o, px, self.hover * live, press * 0.6, self.disabled, vec4(0.0, 0.0, 0.0, 0.0)))
    return Finish.over(out, cc_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// RADIOS. A round cast pebble in the slab; chosen, it is pressed in flush and
// a lit verdigris inlay shows at its centre.
let cc_radio = fn(p: vec2, c: vec2, rad: float, o: vec2, px: float, hover: float, down: float, focus: float, active: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let q = p - c
    let d = length(q) - rad
    let sunk = clamp(active + down * live * 0.6, 0.0, 1.0)
    var out = cc_cast(p, c, vec2(rad, rad), rad, (1.0 - sunk * 0.85) * (1.0 - dis) * 0.9, 1.0 - 0.6 * dis)
    // the pebble: the block's face on a disc; its shoulder is the whole dome
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var base = mix(vec3(0.70, 0.696, 0.676), vec3(0.54, 0.536, 0.52), smoothstep(0.1, 1.0, t))
    var face = cc_stone(base, p + o + vec2(23.0, 61.0), px, 0.8, 0.5)
    let dome = clamp(-q.y / rad, -1.0, 1.0) * smoothstep(rad * 0.3, rad, length(q))
    face = Finish.lift(face, dome * mix(0.28, 0.06, sunk))
    face = face * (1.0 - 0.14 * sunk)
    face = mix(face, vec3(0.05, 0.05, 0.045), clamp(Finish.inset(p, c, vec2(rad, rad), rad, vec2(0.0, 1.0), 1.2), 0.0, 1.0) * 0.45 * sunk)
    face = Finish.lift(face, 0.20 * hover * live * (1.0 - sunk))
    face = mix(face, vec3(0.62, 0.617, 0.60), dis * 0.45)
    let up = 1.0 - smoothstep(-0.3, 0.1, q.y / rad)
    face = mix(face, vec3(0.90, 0.895, 0.88), Finish.band(d, px, 2.0 * px, px) * up * 0.7 * (1.0 - sunk) * live)
    let olc = mix(vec3(0.36, 0.355, 0.34), vec3(0.13, 0.13, 0.125), t)
    face = mix(face, olc, Finish.band(d, 0.0, px, px) * mix(0.95, 0.5, dis))
    let a = Finish.cover(d, px)
    out = Finish.over(out, vec4(face * a, a))
    // chosen: the ground lip under the sunk pebble, and the inlay
    let lp = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, rad * 0.8, q.y) * 0.6 * sunk
    out = Finish.over(out, vec4(0.88 * lp, 0.875 * lp, 0.86 * lp, lp))
    out = Finish.over(out, cc_lamp(p, c, rad * 0.36, px, vec3(0.435, 0.682, 0.533), vec3(0.88, 0.99, 0.92), active * live) * active)
    return Finish.over(out, cc_focus(d, px, focus * live))
}

mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
