    return cc_tab(self.pos, self.rect_size, self.rect_pos, px, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return cc_tab(self.pos, self.rect_size, self.rect_pos, px, 0.0, 1.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_mark.color = #161615
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // 7 points across, a 1.2 point stroke; the plus is the cross turned
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(3.4, 4.5, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(-sin(a), cos(a)) * r
    let dd = min(cc_seg(p, c - u, c + u), cc_seg(p, c - v, c + v)) - 0.6
    let dl = min(cc_seg(p - vec2(0.0, px), c - u, c + u), cc_seg(p - vec2(0.0, px), c - v, c + v)) - 0.6
    let l = Finish.cover(dl, px) * 0.5 * self.color.a
    let k = Finish.cover(dd, px) * self.color.a
    return Finish.over(vec4(0.88 * l, 0.875 * l, 0.86 * l, l), vec4(self.color.rgb * k, k))
}
mod.widgets.Tabs.draw_text.color = #161615
mod.widgets.Tabs.draw_text_active.color = #ecebe5
// The strip centres a 14 point line box, which leaves the capitals high in
// a 26 point block: they are dropped to the block's middle.
mod.widgets.Tabs.draw_text.text_style.top_drop = 0.22
mod.widgets.Tabs.draw_text_active.text_style.top_drop = 0.22

// ---------------------------------------------------------------------------
// PROGRESS. An 8 point channel cut into the slab, dark; the value the lit
// verdigris bar in it, a pale core along its middle, its glow on the
// channel's floor. The unknown value is a still hatch of lit bars across the
// whole channel: a face may not run a clock.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = 8.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 2.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let top = Finish.snap(o.y + (size.y - th) * 0.5, px) - o.y
    let bot = Finish.snap(o.y + (size.y + th) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + size.x * self.end, px) - o.x
    let h = vec2((x1 - x0) * 0.5, (bot - top) * 0.5)
    let c = vec2(x0, top) + h
    let r = 2.0
    let dis = step(4.5, self.intent)
    var out = cc_pocket(p, c, h, r, o, px, mix(vec3(0.22, 0.218, 0.21), vec3(0.45, 0.447, 0.435), dis), 0.8, 1.0) * self.track
    var v0 = x0 + 1.5
    var v1 = x0 + 1.5 + (x1 - x0 - 3.0) * clamp(self.value, 0.0, 1.0)
    var hatch = 1.0
    if self.value < 0.0 {
        v1 = x1 - 1.5
        hatch = Finish.stripes(p + o, 0.785398, 7.0, 0.35, px) * 0.7
    }
    let fh = vec2(max((v1 - v0) * 0.5, 0.0), max(h.y - 1.5, 0.8))
    let fc = vec2((v0 + v1) * 0.5, c.y + 0.3)
    let fd = cc_rbox(p, fc, fh, 1.0)
    let k = clamp(abs(p.y - fc.y) / fh.y, 0.0, 1.0)
    var ink = cc_lit(k * k)
    var body = vec3(0.435, 0.682, 0.533)
    if self.intent > 0.5 {
        body = self.fill_color().rgb
        ink = mix(Finish.lift(body, 0.55), body, k * k)
    }
    ink = mix(ink, vec3(0.55, 0.547, 0.535), dis)
    let fa = Finish.cover(fd, px) * step(0.01, v1 - v0) * hatch
    let d = cc_rbox(p, c, h, r)
    let ga = exp(-max(fd, 0.0) / 1.4) * 0.35 * Finish.cover(d, px) * (1.0 - fa) * step(0.01, v1 - v0) * (1.0 - dis) * mix(0.4, 1.0, hatch)
    out = Finish.over(out, vec4(body * ga, ga))
    out = Finish.over(out, vec4(ink * fa, fa))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A 6 point channel of cells 4 points long with a point
// between: unlit cells dark glass, lit ones verdigris, then amber from 70 %
// and red from 90 %, a pale line along their middle. The hold is a pale
// hairline; the over lamp a red inlay, smoked glass until it latches.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let q = vec2(a, b)
    let th = min(6.0, across - 2.0)
    let lamp_room = self.lamp * (th + 4.0)
    let bar = max(4.0, along - lamp_room)
    let h = vec2(bar * 0.5, th * 0.5)
    let c = vec2(h.x, across * 0.5)
    let r = 1.5
    let d = cc_rbox(q, c, h, r)
    let pad = 1.5
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((a - pad) / span, 0.0, 1.0)
    let pitch = 5.0
    let cell = fract((a - pad) / pitch)
    let in_cell = step(cell, 4.0 / pitch) * step(abs(b - c.y), h.y - 1.2)
    let lit = step(a, pad + span * self.level) * step(pad, a) * in_cell
    let ramp = mix(mix(vec3(0.435, 0.682, 0.533), vec3(0.918, 0.690, 0.235), step(0.7, share)), vec3(0.918, 0.278, 0.200), step(0.9, share))
    let kk = clamp(abs(b - c.y) / max(h.y - 1.2, 0.5), 0.0, 1.0)
    let cellc = mix(mix(vec3(0.95, 0.98, 0.94), ramp, smoothstep(0.0, 0.8, kk)), vec3(0.19, 0.195, 0.19), 1.0 - lit)
    var out = cc_pocket(q, c, h, r, o, px, vec3(0.16, 0.16, 0.155), 0.6, 1.0)
    let unlit = in_cell * step(pad, a) * step(a, pad + span) * (1.0 - lit) * 0.6
    out = Finish.over(out, vec4(0.21 * unlit, 0.215 * unlit, 0.21 * unlit, unlit))
    out = Finish.over(out, vec4(cellc * lit, lit))
    if self.hold > 0.002 {
        let at = pad + span * self.hold
        let hm = step(abs(a - at), px) * step(abs(b - c.y), h.y - 1.0)
        out = Finish.over(out, vec4(0.85 * hm, 0.85 * hm, 0.82 * hm, hm))
    }
    if self.lamp > 0.5 {
        let la = bar + 2.0 + th * 0.5 + 1.0
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, cc_lamp(p, lc, 2.5, px, vec3(0.878, 0.216, 0.157), vec3(1.0, 0.78, 0.70), step(0.5, self.over)))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A 10 point groove the length of the view, and an 8 point cast
// block riding in it with three engraved grip lines across its middle.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let sh = vec2(along * 0.5, across * 0.5 - px)
    let sc = vec2(along * 0.5, across * 0.5)
    var out = cc_pocket(q, sc, sh, 2.0, o, px, vec3(0.44, 0.437, 0.425), 0.55, 0.0)
    // the block
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let th = vec2(max(tl * 0.5 - 1.5, 4.0), 3.5)
    let tc = vec2(t0 + tl * 0.5, sc.y)
    out = Finish.over(out, cc_cap(q, tc, th, vec4(1.5, 1.5, 1.5, 1.5), o, px, self.hover, self.drag * 0.6, 0.0, vec4(0.0, 0.0, 0.0, 0.0)))
    let fi = clamp(floor((a - tc.x) / 2.0 + 0.5), -1.0, 1.0)
    let rx = floor((tc.x + fi * 2.0) / px) * px
    let inb = step(abs(b - tc.y), 2.0)
    let dk = step(rx - px, a) * step(a, rx) * inb * 0.7
    let lt = step(rx, a) * step(a, rx + px) * inb * 0.5
    out = Finish.over(out, vec4(0.05 * dk, 0.05 * dk, 0.045 * dk, dk))
    out = Finish.over(out, vec4(0.9 * lt, 0.895 * lt, 0.88 * lt, lt))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised slab: a cast block at a larger scale with a
// deeper soft shadow. The sunken panel is a broad pocket, its floor kept
// pale enough for the stamped ink.
let cc_slab = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    if sunken > 0.5 {
        return cc_pocket(p, c, h, r, o, px, vec3(0.537, 0.533, 0.518), 0.55, 1.0)
    }
    let s1 = Finish.drop(p, c, h, r, vec2(0.0, 3.4), 2.8) * 0.70
    let s2 = Finish.drop(p, c, h, r, vec2(0.0, 1.0), 0.9) * 0.60
    let sa = s1 + s2 * (1.0 - s1)
    var out = vec4(0.05 * sa, 0.05 * sa, 0.045 * sa, sa)
    let d = cc_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let e = 0.5
    let g = vec2(cc_rbox(p + vec2(e, 0.0), c, h, r) - cc_rbox(p - vec2(e, 0.0), c, h, r), cc_rbox(p + vec2(0.0, e), c, h, r) - cc_rbox(p - vec2(0.0, e), c, h, r))
    let gn = g / max(length(g), 0.0001)
    var face = cc_stone(mix(vec3(0.650, 0.646, 0.627), vec3(0.604, 0.600, 0.580), t), p + o + vec2(19.0, 83.0), px, 1.0, 0.9)
    face = Finish.lift(face, Finish.bevel(d, gn, 3.2, vec2(0.0, -1.0)) * Finish.cover(d, px) * 0.42)
    face = mix(face, face * 0.8, smoothstep(2.0 * h.y - 4.0, 2.0 * h.y, p.y - lo.y))
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (lo.y + r))
    face = mix(face, vec3(0.90, 0.895, 0.88), Finish.band(d, px, 2.0 * px, px) * up * 0.7)
    face = mix(face, mix(vec3(0.36, 0.355, 0.34), vec3(0.12, 0.12, 0.115), smoothstep(0.1, 0.9, t)), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cc_slab(p, self.rect_size, self.rect_pos, px, 3.0, self.sunken)
}

// The card is the raised slab too; its palette and shadow numbers from Rust
// are not read. It lifts a little under the pointer.
mod.widgets.Card.radius = 3.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 8.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = cc_slab(p, self.rect_size, self.rect_pos, px, 3.0, 0.0)
    let d = cc_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(px, px), 3.0)
    let l = Finish.cover(d, px) * (0.08 * self.hover - 0.04 * self.down)
    return Finish.over(out, vec4(max(l, 0.0), max(l, 0.0), max(l, 0.0), abs(l)))
}

// The plain rounded view keeps the colours its caller gives it; the edge is
// a snapped hairline at the true radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = cc_rbox(p, c, h, max(self.border_radius, 1.0))
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points on the slab, split by a faint engraved line; a
// hovered row darkens a shade; the chosen row is pressed into the slab, a
// pocket with a shade under its top edge, ending short of the scroll bar.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let lay = (self.hover * 0.06 + self.down * 0.08) * live
    var out = vec4(0.05 * lay, 0.05 * lay, 0.045 * lay, lay)
    if self.selected > 0.5 {
        let h = vec2((hi.x - lo.x) * 0.5 - 6.0, (hi.y - lo.y) * 0.5 - 2.0 * px)
        let c = vec2(lo.x + h.x + 1.0, (lo.y + hi.y) * 0.5 - 0.5 * px)
        out = Finish.over(out, cc_pocket(p, c, h, 2.0, o, px, vec3(0.537, 0.533, 0.518), 0.5, 1.0))
    }
    let yb = hi.y
    let dk = step(yb - px, p.y) * step(p.y, yb) * 0.12 * (1.0 - self.selected)
    out = Finish.over(out, vec4(0.05 * dk, 0.05 * dk, 0.045 * dk, dk))
    return out
}
mod.widgets.ListItem.draw_text.color = #161615

// The open list of a drop-down: a raised slab; the row under the pointer a
// shallow pocket, the chosen row a stamped check.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return cc_slab(p, self.rect_size, self.rect_pos, px, 3.0, 0.0)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = self.rect_size * 0.5
    let h = c - vec2(2.0, 1.0)
    let live = 1.0 - self.disabled
    var out = cc_pocket(p, c, h, 2.0, o, px, vec3(0.537, 0.533, 0.518), 0.45, 0.0) * self.hover * live
    let m0 = vec2(6.0, c.y)
    let m1 = vec2(8.5, c.y + 2.5)
    let m2 = vec2(12.5, c.y - 3.0)
    let lit = Finish.cover(min(cc_seg(p - vec2(0.0, px), m0, m1), cc_seg(p - vec2(0.0, px), m1, m2)) - 0.75, px) * self.active * 0.5
    out = Finish.over(out, vec4(0.88 * lit, 0.875 * lit, 0.86 * lit, lit))
    let mk = Finish.cover(min(cc_seg(p, m0, m1), cc_seg(p, m1, m2)) - 0.75, px) * self.active
    return Finish.over(out, vec4(0.086 * mk, 0.086 * mk, 0.082 * mk, mk))
}

// The dock's tabs: the bar is the slab with an engraved line at its foot;
// the tab in use is a block rounded at the top and open at the foot, where it
// joins the panel below; the others lighten a little under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 6.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let cap = cc_cap(p, c, h, vec4(2.5, 2.5, 2.5, 2.5), o, px, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0)) * self.active
    let d = cc_rbox(p, c, h, 2.5)
    let lift = Finish.cover(d, px) * 0.12 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(lift, lift, lift, lift), cap)
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * 0.45
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.55
    var out = vec4(0.05 * dk, 0.05 * dk, 0.045 * dk, dk)
    return Finish.over(out, vec4(0.88 * lt, 0.875 * lt, 0.86 * lt, lt))
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small cast block (pressed in while chosen);
// a badge is a small dark pocket with pale digits.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = cc_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let ch = min(22.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    // A filled chip (light ink) is a block dyed its role's colour; a tonal
    // one the grey block faintly dyed; an outlined one the stamped frame; a
    // ghost a shallow pocket.
    let light_ink = step(0.6, Finish.lum(self.ink.rgb))
    let has_fill = step(0.05, self.color.a)
    let kind = mix(mix(6.0, 5.0, step(0.01, self.border_size)), 0.0, has_fill)
    let tint = vec4(self.color.rgb, has_fill * mix(0.35, 1.0, light_ink))
    return cc_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(2.5, 2.5, 2.5, 2.5), kind, m, tint)
}
mod.widgets.BadgePalette.neutral = #3a3936
mod.widgets.BadgePalette.on_neutral = #ecebe5
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(16.0, self.rect_size.y - 2.0)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x + 1.0, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.0, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = mix(2.0, h.y, step(self.rect_size.x, self.rect_size.y + 0.5) * step(self.rect_size.y, 12.5))
    let fill = mix(vec3(0.24, 0.238, 0.23), self.color.rgb, step(0.06, length(self.color.rgb - vec3(0.227, 0.224, 0.212))))
    return cc_pocket(p, c, h, r, o, px, fill, 0.6, 1.0) * self.color.a
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in the stamped ink with a two point stroke on a
// visible track ring, so a still frame reads as a working indicator.
mod.widgets.SpinnerFlat.draw_bg.color = #2a2927
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 3.0
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.25

// Rules between groups: engraved, one dark device row over one light one.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let dk = step(y - px, p.y) * (1.0 - step(y, p.y)) * 0.45
    let lt = step(y, p.y) * (1.0 - step(y + px, p.y)) * 0.55
    return Finish.over(vec4(0.05 * dk, 0.05 * dk, 0.045 * dk, dk), vec4(0.88 * lt, 0.875 * lt, 0.86 * lt, lt))
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let dk = step(x - px, p.x) * (1.0 - step(x, p.x)) * 0.45
    let lt = step(x, p.x) * (1.0 - step(x + px, p.x)) * 0.55
    return Finish.over(vec4(0.05 * dk, 0.05 * dk, 0.045 * dk, dk), vec4(0.88 * lt, 0.875 * lt, 0.86 * lt, lt))
}

// ---------------------------------------------------------------------------
// STAMPED WORDS. Every word is pressed into the cast, as the lettering on the
// slabs of the picture: the light comes from the upper left, so the wall of
// the letter facing it lies in shade (a dark rim inside the stroke on its
// upper left and a faint shade just outside it) and the far wall catches the
// light (a pale line one and a half device pixels wide outside the stroke on
// its lower right).
// The glyph body keeps its ink, dark enough to read at 4.5:1 or more.
// Two more samples of the glyph, one device pixel up-left and one down-right,
// on the small (single channel) and the large (multi channel) atlas alike.
// Pale ink (words in the dark pockets) keeps the shade and only a trace of
// the light line, so the letters do not grow a halo.
// The function is written once and handed to every label below.
let cc_stamp = fn() {
    if self.texture_index > 0.5 && self.texture_index < 1.5 {
        return self.sample_text_pixel()
    }
    if self.texture_index > 2.5 {
        return self.sample_text_pixel()
    }
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    let d = dFdx(self.t.xy) + dFdy(self.t.xy)
    var a0 = 0.0
    var au = 0.0
    var ad = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.sdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
        au = self.sdf(scale, clamp(self.t.xy - 1.5 * d, self.t_min + ht, self.t_max - ht), c)
        ad = self.sdf(scale, clamp(self.t.xy + d, self.t_min + ht, self.t_max - ht), c)
    } else {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let ht = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        a0 = self.msdf(scale, clamp(self.t.xy, self.t_min + ht, self.t_max - ht), c)
        au = self.msdf(scale, clamp(self.t.xy - 1.5 * d, self.t_min + ht, self.t_max - ht), c)
        ad = self.msdf(scale, clamp(self.t.xy + d, self.t_min + ht, self.t_max - ht), c)
    }
    let pale = step(0.5, dot(c.rgb, vec3(0.299, 0.587, 0.114)))
    let rim = a0 * (1.0 - au)
    let lit = au * (1.0 - a0) * mix(0.75, 0.1, pale)
    let shade = ad * (1.0 - a0) * (1.0 - au) * mix(0.38, 0.55, pale)
    // On a cap the face is light enough to let the floor of the letter come
    // up a little toward the stone (stamp_lift, set per template), while the
    // rim facing the light stays at the ink: the pressed-in profile of the
    // picture, a dark edge on the upper left and a lighter floor beside it.
    // Only the rest ink lifts: the darker hover and held inks (#0e0e0d) and
    // the faint disabled ink keep their own value, so a held cap, whose face
    // is darker, still reads at 4.5:1.
    let ink_l = dot(c.rgb, vec3(0.299, 0.587, 0.114))
    let dark = smoothstep(0.066, 0.078, ink_l) * (1.0 - smoothstep(0.12, 0.3, ink_l))
    let fl = vec3(1.0, 1.0, 0.97) * self.stamp_lift * dark * au
    let body = (c.rgb + fl) * (1.0 - 0.55 * rim * (1.0 - pale))
    let res = vec4(max(body, vec3(0.0, 0.0, 0.0)) * a0 * c.a, a0 * c.a)
    let edge = vec4(vec3(0.93, 0.925, 0.9) * lit, lit + shade) * c.a
    return res + edge * (1.0 - res.a)
}
mod.widgets.Label.draw_text.pixel = cc_stamp
