// ---------------------------------------------------------------------------
// CHECK BOXES AND RADIOS. A 15 point box of thinner frost, radius 3, or a
// circle. On, the body takes the accent-tinted blue, the rim turns pale
// cyan and a caustic gathers at its foot, the contact line under it turns
// blue with a faint halo; the mark is a white stroke. Mixed is a small
// accent square; error turns the rim and the caustic rose.
let fr_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, r: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let yn = clamp((p.y - lo.y) / sz, 0.0, 1.0)
    let on = max(active, mixed)
    let tk = max(active, mixed * 0.55)
    let tone = vec4(mix(vec3(0.239, 0.365, 0.522), vec3(0.231, 0.494, 0.643), yn) * 0.9, 0.9) * tk
    let rim_col = mix(mix(fr_rimc(), fr_acc_rim(), on), vec3(0.97, 0.56, 0.66), err)
    let cau_col = mix(vec3(0.678, 1.0, 1.0), fr_rose(), err)
    let rim = mix(0.9, 1.3, max(on, err))
    let f = fr_plate(p, vec4(lo, hi), vec4(r, r, r, r), px, hover, down, focus, disabled, 0.8 * (1.0 - 0.7 * tk), 0.85, rim, tone, rim_col, cau_col, mix(1.0, 4.0, max(on, err)), 0.0, on * (1.0 - err))
    let q = (p - lo) / sz
    let c = (lo + hi) * 0.5
    let live = mix(1.0, 0.45, disabled)
    // The tick: 1.5 points, round ends.
    let tick = min(fr_seg(q, vec2(0.26, 0.52), vec2(0.44, 0.70)), fr_seg(q, vec2(0.44, 0.70), vec2(0.76, 0.32))) * sz
    let ta = Finish.cover(tick - 0.75, px) * active * (1.0 - mixed) * live
    let g = Finish.over(f, vec4(ta, ta, ta, ta))
    // Mixed: a 7 point accent square at 80 %, radius 1.5.
    let sq = Material.sd_box(p, c, vec2(3.5, 3.5), 1.5)
    let sa = Finish.cover(sq, px) * mixed * 0.8 * live
    return Finish.over(g, vec4(fr_acc() * sa, sa))
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0
mod.widgets.CheckBoxFlat.draw_bg.size = 15.0
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 3.0
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
