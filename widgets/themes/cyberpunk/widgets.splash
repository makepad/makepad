use mod.prelude.widgets_internal.*
// Cyberpunk: chamfered controls edge-lit in neon. Every face below is cut
// on the same chamfer -- the top-left and bottom-right corners hard, the
// other two clipped -- with a hairline rim just inside the lip that runs dim
// cyan at rest, full cyan under the pointer or focus and magenta while held,
// and a short inner glow that only lights with the state. Static: nothing
// here animates on its own, so an idle window redraws nothing.
//
// The chamfer is read off the face's own border_radius (the big cut is 2.8x
// it), so a use site that rounds a button tighter also cuts it tighter.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 6.0 bottom: 6.0}
mod.widgets.Button.draw_bg.border_radius = 2.5
mod.widgets.Button.draw_bg.border_size = 1.0
// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it.
let field_height = 24.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = mod.theme.corner_radius
let field_border = mod.theme.beveling

// The room a Fit field takes. A minimum height rather than a height,
// because a line of text is shorter than a row, and the padding with it:
// where a field is Fit, the padding IS its height, and two fields padded
// differently part company again the moment the type grows.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box, and because writing a corner onto a
// draw struct that has no corner would add a slot its shader never reads.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: a number
// with a stepper, a date, a time. The height is all these take. A padding
// here would NOT hold the line off the box -- each of them measures its
// parts against the turtle's whole rect and draws them from the content
// origin, so the padding displaces the line instead of insetting it, and the
// number came out sitting on the bottom edge with its arrows split around it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
// The number's box strokes its own hairline and declares no border size.
mod.widgets.NumberField.draw_bg.border_radius = field_radius
// The drag-number's corner is written into its own shader, so it takes the
// room and keeps the box it draws.
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
// A picker is a date field in an anchor: the field inside fills the frame.
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own. It is
// a TextInput, so it inherits the minimum above, and a minimum as tall as the
// whole field, applied inside a well already that tall, pushed the line out
// through the bottom of the box.
mod.widgets.WellInput.min_height = 0.0

mod.widgets.Window.pass.clear_color = #07080c
mod.widgets.Window.caption_bar.caption_label.padding = mod.turtle.Inset{left: 8.0}
mod.widgets.Window.caption_bar.caption_label.label.draw_text.color = #14f0ff
mod.widgets.Modal.bg_view.draw_bg.color = #000000c0

// THE BUTTON FACE. The state mixes are the library's own (face_fill and
// face_stroke read the theme's outset and bevel roles), only the shape and
// the light are this sheet's.
mod.widgets.Button.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let h = max(sz * 0.5 - vec2(0.5, 0.5), vec2(0.5, 0.5))
    let q = abs(s) - h
    let k = min(mix(self.border_radius, self.border_radius * 2.8, step(0.0, s.x * s.y)), min(h.x, h.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let fill = self.face_fill()
    let stroke = self.face_stroke()
    let bw = self.border_size
    let rim = (1.0 - smoothstep(bw - px, bw + px * 0.5, -d)) * step(0.01, bw) * stroke.a
    let lit = max(self.hover, max(self.focus, self.down)) * (1.0 - self.disabled)
    let glow = exp(min(d, 0.0) / 3.5) * 0.30 * lit * stroke.a
    var o = vec4(fill.rgb * fill.a, fill.a)
    o = vec4(mix(o.rgb, stroke.rgb, rim), max(o.a, rim))
    o = vec4(o.rgb + stroke.rgb * glow * (1.0 - rim), max(o.a, glow))
    o = o * cov
    if self.loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        sdf.clear(o)
        let c = sz * 0.5
        let r = max(min(sz.x, sz.y) * 0.5 - self.loading_inset, 1.0)
        let a0 = self.anim_time * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, r, a0, a0 + 1.5 * PI, self.loading_stroke)
        sdf.fill(vec4(self.loading_color.rgb, self.loading_color.a * self.loading))
        return sdf.result
    }
    return o
}

// THE FIELD: a black glass well in the same cut, its rim lit by focus.
mod.widgets.TextInput.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let h = max(sz * 0.5 - vec2(0.5, 0.5), vec2(0.5, 0.5))
    let q = abs(s) - h
    let k = min(mix(self.border_radius, self.border_radius * 2.8, step(0.0, s.x * s.y)), min(h.x, h.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let fill = self.color
        .mix(self.color_empty, self.empty)
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover.mix(self.color_down, self.down), self.hover)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_empty, self.empty)
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_hover.mix(self.border_color_down, self.down), self.hover)
        .mix(self.border_color_disabled, self.disabled)
    let bw = self.border_size
    let rim = (1.0 - smoothstep(bw - px, bw + px * 0.5, -d)) * step(0.01, bw) * stroke.a
    let glow = exp(min(d, 0.0) / 4.0) * 0.22 * self.focus * (1.0 - self.disabled) * stroke.a
    var o = vec4(fill.rgb * fill.a, fill.a)
    o = vec4(mix(o.rgb, stroke.rgb, rim), max(o.a, rim))
    o = vec4(o.rgb + stroke.rgb * glow * (1.0 - rim), max(o.a, glow))
    return o * cov
}

// THE CHOOSER: a plate in the same cut with a magenta chevron; the rim
// lights while its list is open.
mod.widgets.DropDown.draw_bg.arrow_color = #ff1fb8
mod.widgets.DropDown.draw_bg.arrow_color_focus = #ff1fb8
mod.widgets.DropDown.draw_bg.arrow_color_hover = #ff5fd0
mod.widgets.DropDown.draw_bg.arrow_color_down = #ffffff
mod.widgets.DropDown.draw_bg.arrow_color_disabled = #4f6272
mod.widgets.DropDown.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let h = max(sz * 0.5 - vec2(0.5, 0.5), vec2(0.5, 0.5))
    let q = abs(s) - h
    let k = min(mix(self.border_radius, self.border_radius * 2.8, step(0.0, s.x * s.y)), min(h.x, h.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let fill = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down * self.hover)
        .mix(self.color_disabled, self.disabled)
    let lit = max(max(self.hover, self.focus), self.active) * (1.0 - self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_hover, max(self.hover, self.active))
        .mix(self.border_color_disabled, self.disabled)
    let bw = self.border_size
    let rim = (1.0 - smoothstep(bw - px, bw + px * 0.5, -d)) * step(0.01, bw) * stroke.a
    let glow = exp(min(d, 0.0) / 3.5) * 0.26 * lit * stroke.a
    var o = vec4(fill.rgb * fill.a, fill.a)
    o = vec4(mix(o.rgb, stroke.rgb, rim), max(o.a, rim))
    o = vec4(o.rgb + stroke.rgb * glow * (1.0 - rim), max(o.a, glow))
    // The chevron: two strokes of a V near the right edge.
    let x = sz.x - 11.0
    let y = sz.y * 0.5
    let a1 = vec2(x - 3.5, y - 1.8)
    let b1 = vec2(x, y + 1.8)
    let a2 = vec2(x + 3.5, y - 1.8)
    let pa = p - a1
    let ba = b1 - a1
    let d1 = length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0))
    let pb = p - a2
    let bb = b1 - a2
    let d2 = length(pb - bb * clamp(dot(pb, bb) / dot(bb, bb), 0.0, 1.0))
    let ar = 1.0 - smoothstep(0.45, 0.45 + px * 1.5, min(d1, d2))
    let arrow = self.arrow_color
        .mix(self.arrow_color_focus, self.focus)
        .mix(self.arrow_color_hover.mix(self.arrow_color_down, self.down), self.hover)
        .mix(self.arrow_color_disabled, self.disabled)
    o = vec4(mix(o.rgb, arrow.rgb, ar * arrow.a), max(o.a, ar * arrow.a))
    return o * cov
}
true
