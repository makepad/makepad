mod.theme = mod.themes.dark

// Cyberpunk: night-city street tech. Near-black glass and gunmetal, one
// electric cyan for everything live (focus, selection, values, rims), hot
// magenta for what is pressed or active, warning yellow kept for warnings.
// The palette is amp's cyberpunk skin (apps/stage/apps/amp/resources/styles/
// cyberpunk.splash) lifted onto the library's roles; widgets.splash cuts the
// controls into chamfers and edge-lights them. Flat: no moulded material.
mod.theme.corner_radius = 2.5
mod.theme.container_corner_radius = 4.0
mod.theme.textselection_corner_radius = 1.5
mod.theme.beveling = 1.0
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}

// THE CHAMFER: the big cut on the top-left and bottom-right corners, the
// small one on the other two. Read by this sheet's shaders and by apps that
// draw their own chrome in the same cut.
mod.theme.chamfer = 7.0
mod.theme.chamfer_small = 2.5

// Grounds: void, gunmetal, raised plate, black glass well.
mod.theme.color_bg_app = #07080c
mod.theme.color_fg_app = #0d0f14
mod.theme.color_bg_container = #0d0f14
mod.theme.color_bg_even = #0b0d11
mod.theme.color_bg_odd = #0f1217
mod.theme.color_app_caption_bar = #06070a
mod.theme.color_dock_tab_active = #0d0f14

// The neon: cyan is live, magenta is held, yellow warns.
mod.theme.color_focus = #14f0ff
mod.theme.color_makepad = #14f0ff
mod.theme.color_ctrl_selected = #14f0ff
mod.theme.color_ctrl_active = #ff1fb8
