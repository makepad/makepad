}
mod.widgets.Select.face.padding = mod.turtle.Inset{left: 12.0 right: 26.0 top: 4.0 bottom: 4.0}
mod.widgets.MultiSelect.face.padding = mod.turtle.Inset{left: 12.0 right: 26.0 top: 4.0 bottom: 4.0}
mod.widgets.Select.face.min_height = 26.0
mod.widgets.MultiSelect.face.min_height = 26.0

// The combo box: a white pill one can type in, pressed into the plate like
// a field, the drop-down's chevron at its right.
mod.widgets.ComboBoxFlat.padding = mod.turtle.Inset{left: 12.0 right: 26.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBoxFlat.input.min_height = 0.0
mod.widgets.ComboBoxFlat.clip_x = false
mod.widgets.ComboBoxFlat.clip_y = false
mod.widgets.ComboBoxFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    return po_dropdown(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, 0.0, 0.0, self.disabled, self.focus)
}

// Open lists: a white card with a soft shadow line; rows shade a little
// under the hand; the chosen row a raised white pill with the warm light
// under its middle.
let po_menu = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let c = size * 0.5
    let d = Material.sd_box(p, c, c, 8.0)
    let t = clamp(p.y / max(size.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(1.0, 1.0, 1.0), vec3(0.965, 0.968, 0.975), t)
    col = mix(col, vec3(0.74, 0.76, 0.80), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}
let po_row = fn(p: vec2, size: vec2, px: float, hover: float, active: float, dis: float) -> vec4 {
    let wash = 0.05 * hover * (1.0 - dis)
    var res = vec4(po_shade() * wash, wash)
    if active > 0.001 {
        let lo = vec2(3.0, 2.0)
        let hi = size - vec2(3.0, 3.0)
        let sel = po_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, 0.0, 0.0, 0.0, 0.0, 0.4, 0.0, 1.0)
        res = mix(res, sel, active)
    }
    return res
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    return po_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    return po_row(self.pos * self.rect_size, self.rect_size, px, self.hover, self.active, self.disabled)
}
mod.widgets.PopupMenuItem.draw_text.color_active = #1f2227
mod.widgets.ComboBoxFlat.draw_popup_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    return po_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.ComboBoxFlat.draw_item.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    return po_row(self.pos * self.rect_size, self.rect_size, px, self.hover, self.active, 0.0)
}
mod.widgets.ComboBoxFlat.draw_item_text.color_active = #1f2227

// ---------------------------------------------------------------- tabs

// The segmented control: a track pressed into the plate; the chosen answer
// a raised white cap 2 points in, lit warm from inside at its foot.
mod.widgets.SegmentedControl.segment_height = 22.0
mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    return po_sunk(p, lo, hi, (hi.y - lo.y) * 0.5, px, vec3(0.905, 0.912, 0.928), 0.0, 0.0, 0.0, 0.8) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let m = 12.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    return po_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, 0.0, 0.0, 0.0, 0.0, 0.5, 0.0, 1.0) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.SegmentedControlFlat.draw_text.text_style.font_size = 9.0
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style.font_size = 9.0
mod.widgets.SegmentedControlFlat.draw_text.color = #4f545d
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #1f2227
// The chosen word takes its ink from the role palette: graphite on the
// glaze.
mod.widgets.SegmentedControlFlat.palette.on_primary_container = #1f2227
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #1f2227
mod.widgets.SegmentedControlFlat.palette.on_secondary_container = #1f2227
mod.widgets.SegmentedControl.palette.on_primary_container = #1f2227
mod.widgets.SegmentedControl.palette.on_neutral_container = #1f2227
mod.widgets.SegmentedControl.palette.on_secondary_container = #1f2227

// Tabs: quiet words on the plate, parted by a short grey line; the tab in
// use a raised white pill 2 points in, lit from under; under the hand a
// quiet pill pressed in.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
let po_tab = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, active: float) -> vec4 {
    let m = 14.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(1.0, o.x, px), po_snap(2.0, o.y, px))
    let hi = vec2(po_snap(size.x - 1.0, o.x, px), po_snap(size.y - 2.0, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if active > 0.5 {
        res = po_cap(p, lo, hi, r, px, hover, 0.0, 0.0, 0.0, 0.8, 0.0, 1.0)
    } else {
        if hover > 0.001 {
            res = po_sunk(p, lo, hi, r, px, vec3(0.925, 0.933, 0.949), 0.0, 0.0, 0.0, 0.55) * hover
        }
    }
    return res * po_fade(pos, size, m)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    return po_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 1.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let span = step(self.rect_size.y * 0.3, p.y) * step(p.y, self.rect_size.y * 0.7)
    let l = step(x, p.x) * step(p.x, x + px) * span
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * span
    return vec4(0.76, 0.78, 0.82, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w * (1.0 - l)
}
mod.widgets.Tabs.draw_mark.color = #6b7079
mod.widgets.Tabs.draw_text.color = #4f545d
mod.widgets.Tabs.draw_text_active.color = #1f2227
mod.widgets.Tabs.draw_text.text_style.font_size = 9.0
mod.widgets.Tabs.draw_text_active.text_style.font_size = 9.0

// ---------------------------------------------------------------- feedback

// The progress bar: a 6 point groove pressed in, the amber rod in it, the
// whole bar standing in an 8 point row.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(6.0, self.rect_size.y)
    let y0 = po_snap((self.rect_size.y - th) * 0.5, o.y, px)
    let x0 = po_snap(self.rect_size.x * self.start, o.x, px)
    let x1 = po_snap(self.rect_size.x * self.end, o.x, px)
    let lo = vec2(x0, y0)
    let hi = vec2(x1, y0 + th)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if self.track > 0.5 {
        res = po_sunk(p, lo, hi, th * 0.5, px, vec3(0.915, 0.921, 0.935), 0.0, 0.0, 0.0, 0.9)
    }
    let span = hi.x - lo.x - px * 2.0
    var f0 = lo.x + px
    var f1 = f0 + span * clamp((self.value - self.start) / max(self.end - self.start, 0.001), 0.0, 1.0)
    if self.value < 0.0 {
        // Still: the sweep would need the pass clock, which a sheet may not
        // read, so the unknown is a lit stretch in the middle, ends fading.
        f0 = lo.x + span * 0.3
        f1 = lo.x + span * 0.7
    }
    var fill = po_fill(vec4(0.0, 0.0, 0.0, 0.0), p, vec2(f0, lo.y + px * 1.5), vec2(f1, hi.y - px * 1.5), th * 0.5, px, 0.0, 0.8, 0.0, lo, hi, th * 0.5)
    // An intent other than the plain one tints the light with its colour.
    let ic = self.fill_color()
    let tint = step(0.5, self.intent)
    fill = vec4(mix(fill.rgb, ic.rgb * fill.a, tint * 0.75), fill.a)
    if self.value < 0.0 {
        fill = fill * smoothstep(f0 - 1.0, f0 + span * 0.1, p.x) * smoothstep(f1 + 1.0, f1 - span * 0.1, p.x)
    }
    res = Finish.over(res, fill)
    return res * self.opacity * po_fade(self.pos, self.rect_size, m)
}

// The level meter: cells 3 points long with 1.5 point gaps in a groove
// pressed into the plate; amber to 70 %, a hotter amber to 90 %, red past
// it; unlit cells a pale dimple; a cell held at the peak; the clip lamp.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    let wa = min(across, 8.0)
    let wb0 = (across - wa) * 0.5
    let wlo = mix(vec2(0.0, wb0), vec2(wb0, sz.y - bar), v)
    let whi = mix(vec2(bar, wb0 + wa), vec2(wb0 + wa, sz.y), v)
    let lo = vec2(po_snap(wlo.x, o.x, px), po_snap(wlo.y, o.y, px))
    let hi = vec2(po_snap(whi.x, o.x, px), po_snap(whi.y, o.y, px) - px)
    var res = po_sunk(p, lo, hi, 2.0, px, vec3(0.915, 0.921, 0.935), 0.0, 0.0, 0.0, 0.8)
    let pad = 2.0
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.5
    let ca = a - pad
    let cell = Finish.cover(abs(fract(ca / pitch) * pitch - 1.5) - 1.5, px)
    let share = clamp((floor(ca / pitch) * pitch + 1.5) / span, 0.0, 1.0)
    let inb = step(pad, a) * step(a, bar - pad) * step(wb0 + 1.5, b) * step(b, wb0 + wa - 1.5)
    let ha = max(self.hot_at, 0.7)
    var lit = mix(vec3(0.90, 0.52, 0.17), vec3(1.0, 0.70, 0.33), smoothstep(0.0, 1.0, share / ha))
    lit = mix(lit, vec3(0.96, 0.46, 0.14), step(ha, share))
    lit = mix(lit, vec3(0.84, 0.20, 0.13), step(max(self.hot_to, 0.9), share))
    let qm = (b - (wb0 + wa * 0.5)) / max(0.3 * (wa - 3.0), px * 0.8)
    lit = mix(lit, vec3(1.0, 0.90, 0.70), exp(-qm * qm) * 0.5 * (1.0 - step(max(self.hot_to, 0.9), share)))
    let on = step(share, self.level) * step(0.001, self.level)
    let ghost = vec3(0.86, 0.868, 0.885)
    let col = mix(ghost, lit, on)
    res = Finish.over(res, vec4(col, 1.0) * cell * inb * self.opacity)
    let hold_at = floor((span * self.hold) / pitch) * pitch
    let hc = step(abs(floor(ca / pitch) * pitch - hold_at), 0.1) * step(0.002, self.hold)
    res = Finish.over(res, vec4(vec3(0.95, 0.60, 0.24), 1.0) * hc * cell * inb * 0.9)
    if self.lamp > 0.5 {
        let lc = mix(vec2(bar + 3.0 + across * 0.5, sz.y * 0.5), vec2(sz.x * 0.5, across * 0.5), v)
        let rl = max(across * 0.5 - 2.0, 1.0)
        let ld = Finish.sd_circle(p, lc, rl)
        let over = step(0.5, self.over)
        let halo = exp(-max(ld, 0.0) / 0.8) * (1.0 - Finish.cover(ld, px)) * 0.4 * over
        res = Finish.over(res, vec4(vec3(0.90, 0.30, 0.20) * halo, halo))
        let la = Finish.cover(ld, px)
        let lcol = mix(vec3(0.84, 0.85, 0.875), mix(vec3(0.86, 0.22, 0.14), vec3(1.0, 0.86, 0.80), 1.0 - smoothstep(0.0, rl, length(p - lc))), over)
        res = Finish.over(res, vec4(lcol * la, la))
    }
    return res * self.opacity
}

// The spinner keeps the library's own turning face and takes the amber.
mod.widgets.SpinnerFlat.draw_bg.color = #e8963a
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.15

// The rings, the arc and the stock bars keep their own faces; the plain
// intent reads amber, the one accent.
mod.widgets.ProgressRingFlat.draw_bg.color_primary = #e8963a
mod.widgets.ProgressRing.draw_bg.color_primary = #e8963a
mod.widgets.ProgressArc.draw_bg.color_primary = #e8963a
mod.widgets.ActivityRings.draw_bg.color_primary = #e8963a
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #e8963a
mod.widgets.ProgressBar.draw_bg.color_primary = #e8963a
mod.widgets.ProgressBarGradientX.draw_bg.color_primary = #e8963a
mod.widgets.ProgressBarGradientY.draw_bg.color_primary = #e8963a

// Words in the error intent beside a check box or a toggle: a deep red that
// reads on the plate.
mod.widgets.CheckBoxFlat.draw_text.color_error = #a8261c
mod.widgets.ToggleFlat.draw_text.color_error = #a8261c

// ---------------------------------------------------------------- surfaces

// The scroll bar: an 8 point gutter with no fill; the thumb a 5 point grey
// pill, darker under the hand.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 1.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.is_vertical
    let t0 = mix(sz.x * self.norm_scroll, sz.y * self.norm_scroll, v)
    let t1 = t0 + mix(sz.x * self.norm_handle, sz.y * self.norm_handle, v)
    let mid = mix(sz.y * 0.5, sz.x * 0.5, v)
    let tlo = mix(vec2(t0, mid - 2.5), vec2(mid - 2.5, t0), v)
    let thi = mix(vec2(t1, mid + 2.5), vec2(mid + 2.5, t1), v)
    let lo = vec2(po_snap(tlo.x, o.x, px), po_snap(tlo.y, o.y, px))
    let hi = vec2(po_snap(thi.x, o.x, px), po_snap(thi.y, o.y, px))
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 2.5)
    let a = Finish.cover(d, px) * (0.30 + 0.22 * max(self.hover, self.drag))
    return vec4(vec3(0.42, 0.45, 0.51) * a, a) * self.opacity
}

// The fine grain of the glaze: monochrome, one value per two device pixels,
// laid in window space so it never repeats and never swims.
let po_grain = fn(p: vec2, o: vec2, px: float) -> float {
    return Finish.grain((p + o) / (2.0 * px), 0.008)
}

// A raised panel: a white porcelain slab standing on the plate. Its soft
// shadow stays inside the gap to its neighbours; its face is whiter than
// the plate, brightest at the top, with a white hairline along its top and
// a 3 point shoulder inside its edge that catches the light above and
// turns into shade at its foot. `leak` 1 lets the warm light show from
// under its foot (a pressable card under the hand).
let po_panel = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, hover: float, leak: float, lift: float) -> vec4 {
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = po_normal(p, c, h, r)
    let amb = Finish.drop(p, c, h - vec2(3.0, 1.5), r, vec2(0.0, 3.0 + 1.0 * hover), 3.2) * (0.26 + 0.06 * hover) * lift
    let con = Finish.drop(p, c, h, r, vec2(0.0, px * 1.2), px * 1.2) * 0.35
    let sc = (1.0 - (1.0 - amb) * (1.0 - con)) * (1.0 - a)
    var res = vec4(po_shade() * sc, sc)
    if leak > 0.001 {
        res = Finish.over(res, po_spot(p, c.x, hi.y + 1.0, min(size.x * 0.5, 60.0), 0.5 * leak) * (1.0 - a))
    }
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.985, 0.987, 0.992), vec3(0.960, 0.963, 0.972), t) + vec3(0.008, 0.008, 0.006) * hover
    col = col + vec3(1.0, 1.0, 1.0) * po_grain(p, o, px)
    let upper = smoothstep(0.0, 0.9, -n.y)
    let lower = smoothstep(0.2, 0.9, n.y)
    let x = max(-d, 0.0)
    let sh = 1.0 - smoothstep(0.0, 3.0, x)
    col = mix(col, vec3(1.0, 1.0, 1.0), sh * upper * 0.7)
    col = mix(col, vec3(0.86, 0.87, 0.89), sh * lower * 0.5)
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(0.74, 0.76, 0.80), vec3(1.0, 1.0, 1.0), upper), ring)
    col = min(col, vec3(1.0, 1.0, 1.0))
    return Finish.over(res, vec4(col * a, a))
}
// A tray: the same box pressed into the plate, shaded from its top rim, a
// white lip on the plate under its foot.
let po_tray = fn(p: vec2, size: vec2, o: vec2, px: float, r: float) -> vec4 {
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let lipa = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(0.2, 0.9, n.y)
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var col = vec3(0.862, 0.870, 0.890) + vec3(1.0, 1.0, 1.0) * po_grain(p, o, px)
    col = mix(col, vec3(0.56, 0.585, 0.64), 0.7 * Finish.inset(p, c, h, r, vec2(0.0, 2.6), 4.2))
    col = mix(col, vec3(0.68, 0.70, 0.745), Finish.band(d, 0.0, px, px) * smoothstep(0.3, -0.9, n.y))
    return Finish.over(res, vec4(col * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 10.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    if self.sunken > 0.5 {
        return po_tray(p, self.rect_size, self.rect_pos, px, 10.0) * po_fade(self.pos, self.rect_size, m)
    }
    return po_panel(p, self.rect_size, self.rect_pos, px, 10.0, 0.0, 0.0, 1.0) * po_fade(self.pos, self.rect_size, m)
}

// The rounded view keeps the colour its caller gives it, with a true
// corner and, when it is opaque, a one device pixel edge.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    var ink = self.border_color
    if self.border_size < 0.01 {
        ink = vec4(0.80, 0.815, 0.845, fill.a)
    }
    let a = Finish.cover(d, px)
    let bd = Finish.band(d, 0.0, max(self.border_size, px), px)
    var col = mix(fill.rgb, ink.rgb, bd * ink.a)
    return vec4(col * a * fill.a, a * fill.a) + vec4(ink.rgb * ink.a, ink.a) * bd * a * (1.0 - fill.a)
}

// The card: its three appearances told apart. Elevated, a white slab
// standing well off the plate; filled, a slab seated with its contact
// shadow only; outlined, the plate inside one grey device pixel. Under the
// hand the warm light shows from under a pressable card's foot.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let fade = po_fade(self.pos, self.rect_size, m)
    if self.border_size > 0.01 {
        let o = self.rect_pos
        let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
        let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 10.0)
        let n = po_normal(p, c, h, 10.0)
        let ring = Finish.band(d, 0.0, px, px)
        let col = mix(vec3(0.70, 0.72, 0.77), vec3(0.78, 0.80, 0.84), smoothstep(-0.3, 0.9, -n.y))
        let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y)
        let wash = 0.3 * self.hover * Finish.cover(d, px)
        var res = vec4(vec3(1.0, 1.0, 1.0) * wash, wash)
        res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * lip, lip))
        return Finish.over(res, vec4(col * ring, ring)) * fade
    }
    if self.shadow_radius < 0.01 {
        return po_panel(p, self.rect_size, self.rect_pos, px, 10.0, self.hover, 0.0, 0.0) * fade
    }
    return po_panel(p, self.rect_size, self.rect_pos, px, 10.0, self.hover, self.hover, 1.4) * fade
}

// List rows: 10 points in, a grey device pixel divider under each with a
// white one under it; under the hand the row shades a little; the chosen
// row rises as a white slab with the warm light under its middle.
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let yb = po_snap(self.rect_size.y, o.y, px)
    let inx = step(10.0, p.x) * step(p.x, self.rect_size.x - 10.0)
    let div = step(yb - px * 2.0, p.y) * step(p.y, yb - px) * inx
    let lipl = step(yb - px, p.y) * step(p.y, yb) * inx
    var res = vec4(0.82, 0.835, 0.86, 1.0) * div * (1.0 - self.selected)
    res = Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * lipl * (1.0 - self.selected))
    let wash = (0.035 * self.hover + 0.03 * self.down) * live
    res = Finish.over(res, vec4(po_shade() * wash, wash))
    if self.selected > 0.001 {
        let lo = vec2(po_snap(3.0, o.x, px), po_snap(3.0, o.y, px))
        let hi = vec2(po_snap(self.rect_size.x - 3.0, o.x, px), yb - px * 4.0)
        let sl = po_cap(p, lo, hi, 6.0, px, 0.0, 0.0, 0.0, 0.0, 0.35, 0.0, 1.0)
        res = mix(res, sl, self.selected)
    }
    return res
}
mod.widgets.ListItem.draw_text.color = #2b2e35
mod.widgets.ListItem.draw_text_2.color = #555a63

// A chip is a small seated white pill; its label graphite whatever its role.
mod.widgets.ChipFlat.draw_text.text_style.font_size = 9.0
mod.widgets.ChipFlat.palette.on_neutral = #2b2e35
mod.widgets.ChipFlat.palette.on_neutral_container = #2b2e35
mod.widgets.ChipFlat.palette.neutral = #2b2e35
mod.widgets.ChipFlat.palette.on_primary = #2b2e35
mod.widgets.ChipFlat.palette.on_primary_container = #2b2e35
mod.widgets.ChipFlat.palette.primary = #2b2e35
mod.widgets.ChipFlat.palette.on_secondary_container = #2b2e35
mod.widgets.ChipFlat.palette.on_tertiary_container = #2b2e35
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    let spot = 0.35 * self.hover + 0.3 * self.down
    var res = po_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, self.hover, self.down, 0.0, self.keyed, 0.3, 0.0, spot)
    return res * po_fade(self.pos, self.rect_size, m)
}

// A count is a small white pill with graphite figures.
mod.widgets.BadgePalette.neutral = #fafbfc
mod.widgets.BadgePalette.on_neutral = #2b2e35
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x - px * 0.49, o.x, px), po_snap(self.rect_size.y - px * 0.49, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(h.x, h.y)
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = self.color.rgb + vec3(0.02, 0.02, 0.02) * (1.0 - t) - vec3(0.035, 0.035, 0.03) * t
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(min(col, vec3(1.0, 1.0, 1.0)), mix(vec3(0.70, 0.72, 0.77), vec3(1.0, 1.0, 1.0), smoothstep(-0.35, 0.35, -n.y)), ring)
    let a = Finish.cover(d, px) * max(self.color.a, ring)
    return vec4(col * a, a)
}

// Dividers are engraved: a grey device pixel with a white one under it.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let l = step(y, p.y) * step(p.y, y + px)
    let w = step(y + px, p.y) * step(p.y, y + px * 2.0) * (1.0 - l)
    return vec4(0.78, 0.795, 0.83, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let l = step(x, p.x) * step(p.x, x + px)
    let w = step(x + px, p.x) * step(p.x, x + px * 2.0) * (1.0 - l)
    return vec4(0.78, 0.795, 0.83, 1.0) * l + vec4(1.0, 1.0, 1.0, 1.0) * w
}

// ---------------------------------------------------------------- own faces

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
