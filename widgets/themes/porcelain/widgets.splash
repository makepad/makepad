// ---------------------------------------------------------------- selection

// The small controls' quads grow by this much, for their shadow, their
// focus leak and their lamp.
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 2.0
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0

// The check box: a 14 point white cap with a 4 point corner; on, it is
// pushed into the plate and carries a graphite check.
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let x0 = (self.rect_size.x - sz) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(po_snap(x0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(x0 + sz, o.x, px), po_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let r = min(self.border_radius * 2.0, sz * 0.5)
    let held = max(self.down, self.pressed)
    let on = max(self.active, self.mixed)
    let live = 1.0 - self.disabled
    let spot = 0.3 * self.hover * (1.0 - held) * (1.0 - on) * live
    let up = po_cap(p, lo, hi, r, px, self.hover, held, self.disabled, self.focus, 0.7, 1.0, spot)
    var sunk = po_sunk(p, lo, hi, r, px, vec3(0.93, 0.935, 0.946), self.hover, held, self.disabled, 0.9)
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    sunk = po_frame_over(sunk, d, px, self.focus * live, Finish.cover(d, px), sz)
    var res = mix(up, sunk, on)
    // The error: the edge turns red.
    res = Finish.over(res, vec4(0.78, 0.18, 0.12, 1.0) * Finish.band(d, 0.0, px, px) * self.error * live)
    // The mark: a check 7 points across in a 1.6 point stroke, or a dash.
    let ink = mix(mix(vec3(0.169, 0.180, 0.208), vec3(0.66, 0.15, 0.11), self.error), vec3(0.62, 0.64, 0.68), self.disabled)
    let dm = min(po_seg(p, vec2(c.x - 3.2, c.y + 0.2), vec2(c.x - 1.0, c.y + 2.4)), po_seg(p, vec2(c.x - 1.0, c.y + 2.4), vec2(c.x + 3.3, c.y - 2.4)))
    let dd = po_seg(p, vec2(c.x - 3.0, c.y), vec2(c.x + 3.0, c.y))
    let dk = mix(dm - 0.8, dd - 0.8, self.mixed)
    let mk = Finish.cover(dk, px) * on
    res = Finish.over(res, vec4(ink * mk, mk))
    return res * po_fade(self.pos, self.rect_size, m)
}

// The toggle: a 32 x 18 point track pressed into the plate, a 14 point
// white knob standing in it with its own shadow. On, the knob stands at
// the right and a small warm lamp is lit in the track where it was.
mod.widgets.ToggleFlat.draw_bg.size = 18.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 1.78
mod.widgets.ToggleFlat.label_walk.margin.left = 32.0
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let tw = self.size * self.pill_aspect
    let th = self.size
    let x0 = (self.rect_size.x - tw) * self.mark_at_end
    let y0 = self.rect_size.y * 0.5 - th * 0.5
    let lo = vec2(po_snap(x0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(x0 + tw, o.x, px), po_snap(y0 + th, o.y, px))
    let r = th * 0.5
    let held = max(self.pressed, self.down)
    let live = 1.0 - self.disabled
    let on = self.active
    var res = po_sunk(p, lo, hi, r, px, mix(vec3(0.94, 0.945, 0.955), vec3(0.965, 0.955, 0.945), on), self.hover, held * 0.5, self.disabled, 0.85)
    let ed = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, r)
    res = po_frame_over(res, ed, px, self.focus * live, Finish.cover(ed, px), th)
    // The lamp where the knob stood when off.
    let lc = vec2(lo.x + th * 0.5 + 1.0, (lo.y + hi.y) * 0.5)
    res = po_lamp(res, p, lc, 2.2, px, on, self.disabled)
    // The knob follows the value, or the pointer while it is dragged.
    let kt = mix(on, self.drag_pos, self.drag)
    let kr = 7.0
    let inset = (th - kr * 2.0) * 0.5
    let kc = vec2(lo.x + inset + kr + (tw - inset * 2.0 - kr * 2.0) * kt, (lo.y + hi.y) * 0.5)
    let knob = po_cap(p, kc - vec2(kr, kr), kc + vec2(kr, kr), kr, px, self.hover, held * 0.6, self.disabled, 0.0, 0.8, 0.0, 0.0)
    res = Finish.over(res, knob)
    // The error: the track's edge turns red.
    res = Finish.over(res, vec4(0.78, 0.18, 0.12, 1.0) * Finish.band(ed, 0.0, px, px) * self.error * live)
    return res * po_fade(self.pos, self.rect_size, m)
}

// The radio: a 14 point white disc; chosen, it is pushed in and a small
// warm lamp is lit in its middle.
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.size = 14.0
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sz = self.size
    let y0 = self.rect_size.y * 0.5 - sz * 0.5
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(y0, o.y, px))
    let hi = vec2(po_snap(sz, o.x, px), po_snap(y0 + sz, o.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active
    let up = po_cap(p, lo, hi, sz * 0.5, px, self.hover, self.down, self.disabled, self.focus, 0.7, 1.0, 0.3 * self.hover * (1.0 - self.down) * live)
    var sunk = po_sunk(p, lo, hi, sz * 0.5, px, vec3(0.93, 0.935, 0.946), self.hover, self.down, self.disabled, 0.9)
    let d = Finish.sd_circle(p, c, sz * 0.5)
    sunk = po_frame_over(sunk, d, px, self.focus * live, Finish.cover(d, px), sz)
    var res = mix(up, sunk, on)
    // The lamp, with a graphite ring under it so the chosen one reads
    // without its colour.
    let rd = Finish.sd_circle(p, c, 3.4)
    let rr = Finish.band(-rd, 0.0, px, px) * on
    res = Finish.over(res, vec4(vec3(0.42, 0.44, 0.49) * rr, rr))
    res = po_lamp(res, p, c, 3.0, px, on, self.disabled)
    let dg = Finish.cover(Finish.sd_circle(p, c, 3.0), px) * on * self.disabled
    res = Finish.over(res, vec4(vec3(0.62, 0.64, 0.68) * dg, dg))
    return res * po_fade(self.pos, self.rect_size, m)
}

// The radio tab: words on the plate at rest; under the hand a quiet pill
// pressed in; chosen, a raised white cap lit from under.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    let sel = self.active
    let quiet = po_sunk(p, lo, hi, r, px, vec3(0.925, 0.933, 0.949), self.hover, self.down, self.disabled, 0.6) * max(self.hover, self.down) * (1.0 - self.disabled)
    let chosen = po_cap(p, lo, hi, r, px, self.hover, self.down, self.disabled, self.focus, 1.0, 0.0, 1.0)
    return mix(quiet, chosen, sel) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #4f545d
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #1f2227
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #1f2227
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #a0a4ac

// ---------------------------------------------------------------- sliders

// A white disc handle standing in the groove with its own shadow and a
// graphite dimple; held, the warm light shows from under it.
let po_handle = fn(dst: vec4, p: vec2, c: vec2, rad: float, px: float, hover: float, drag: float, focus: float, dis: float) -> vec4 {
    let lo = c - vec2(rad, rad)
    let hi = c + vec2(rad, rad)
    let spot = (0.3 * hover * (1.0 - drag) + 0.6 * drag) * (1.0 - dis)
    var res = Finish.over(dst, po_cap(p, lo, hi, rad, px, hover, drag * 0.5, dis, focus, 0.8, 0.0, spot))
    let d = Finish.sd_circle(p, c, 1.6)
    let da = Finish.cover(d, px) * (1.0 - 0.6 * dis)
    return Finish.over(res, vec4(vec3(0.30, 0.32, 0.37) * da, da))
}

// The bar slider: a 6 point groove pressed in under its label row, the lit
// amber value, and a 16 point white disc riding it.
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 8.0
    let cy = po_snap(20.0 + (self.rect_size.y - 20.0) * 0.5, o.y, px)
    let lo = vec2(po_snap(0.0, o.x, px), cy - 3.0)
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), cy + 3.0)
    var res = po_sunk(p, lo, hi, 3.0, px, vec3(0.915, 0.921, 0.935), 0.0, 0.0, self.disabled, 0.9)
    let span = self.rect_size.x - rad * 2.0
    let hx = rad + self.slide_pos * span
    let ox = rad + self.origin_pos * span
    let f0 = mix(lo.x + px, min(ox, hx), self.arc_origin)
    let f1 = mix(hx, max(ox, hx), self.arc_origin)
    res = po_fill(res, p, vec2(f0, lo.y + px * 1.5), vec2(f1, hi.y - px * 1.5), 2.0, px, self.disabled, 0.6, max(max(self.hover, self.drag), self.focus), lo, hi, 3.0)
    return po_handle(res, p, vec2(hx, cy), rad, px, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}

// The minimal slider: a hairline groove and the lit value; a slim white
// cap shows under the hand.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let cy = po_snap(self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, o.y, px)
    let lo = vec2(po_snap(0.0, o.x, px), cy - 1.5)
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), cy + 1.5)
    var res = po_sunk(p, lo, hi, 1.5, px, vec3(0.90, 0.907, 0.922), 0.0, 0.0, self.disabled, 0.7)
    let lo2 = min(self.origin_pos, self.slide_pos)
    let hi2 = max(self.origin_pos, self.slide_pos)
    let f0 = mix(0.0, lo2, self.arc_origin) * self.rect_size.x
    let f1 = mix(self.slide_pos, hi2, self.arc_origin) * self.rect_size.x
    res = po_fill(res, p, vec2(max(f0, lo.x), lo.y), vec2(min(f1, hi.x), hi.y), 1.5, px, self.disabled, 0.0, max(self.hover, self.drag), lo, hi, 1.5)
    let hx = self.slide_pos * self.rect_size.x
    let show = max(self.hover, self.drag)
    let cap = po_cap(p, vec2(hx - 3.0, cy - 5.0), vec2(hx + 3.0, cy + 5.0), 3.0, px, 0.0, 0.0, self.disabled, 0.0, 0.0, 0.0, 0.0)
    return Finish.over(res, cap * show)
}

// The round slider: a label column, then the bar slider's groove, value
// and disc; the groove ends short of the right edge for the value.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let rad = 7.0
    let cy = po_snap(self.rect_size.y * 0.5, o.y, px)
    let x0 = po_snap(self.label_size, o.x, px)
    let lo = vec2(x0, cy - 3.0)
    let hi = vec2(po_snap(self.rect_size.x - 37.0, o.x, px), cy + 3.0)
    var res = po_sunk(p, lo, hi, 3.0, px, vec3(0.915, 0.921, 0.935), 0.0, 0.0, self.disabled, 0.9)
    let span = hi.x - lo.x - rad * 2.0
    let hx = lo.x + rad + self.slide_pos * span
    res = po_fill(res, p, vec2(lo.x + px, lo.y + px * 1.5), vec2(hx, hi.y - px * 1.5), 2.0, px, self.disabled, 0.6, max(max(self.hover, self.drag), self.focus), lo, hi, 3.0)
    return po_handle(res, p, vec2(hx, cy), rad, px, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}

// The fader: a 3 point slot, lit amber below the cap; a white cap 20 x 11
// points with a graphite value line and two grip lines; a tick scale
// beside the slot with an amber mark at unity.
mod.widgets.SliderFader.cap_size = 11.0
mod.widgets.SliderFader.draw_bg.track_size = 3.0
mod.widgets.SliderFader.draw_bg.cap_cross = 0.5
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let m = 6.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * (sz + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let v = self.is_vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let mid = across * 0.5
    let slo = mix(vec2(self.inset_px, mid - 1.5), vec2(mid - 1.5, self.inset_px), v)
    let shi = mix(vec2(sz.x - self.inset_px, mid + 1.5), vec2(mid + 1.5, sz.y - self.inset_px), v)
    let lo = vec2(po_snap(slo.x, o.x, px), po_snap(slo.y, o.y, px))
    let hi = vec2(po_snap(shi.x, o.x, px), po_snap(shi.y, o.y, px))
    var res = po_sunk(p, lo, hi, 1.5, px, vec3(0.90, 0.907, 0.922), 0.0, 0.0, self.disabled, 0.8)
    let cap_at = foot + self.slide_pos * travel
    let flo = mix(vec2(lo.x, lo.y), vec2(lo.x, sz.y - cap_at), v)
    let fhi = mix(vec2(cap_at, hi.y), vec2(hi.x, hi.y), v)
    res = po_fill(res, p, flo, fhi, 1.5, px, self.disabled, 0.4, max(self.hover, self.drag), lo, hi, 1.5)
    // The scale: a device pixel tick every 5 points on one side, longer at
    // the ends and the middle; the unity mark amber.
    let pitch = 5.0
    let k = floor((a - foot) / pitch + 0.5)
    let ka = foot + k * pitch
    let inrange = step(0.0, k) * step(ka, foot + travel + 0.1)
    let tk = mid + 6.0
    let midk = floor(travel / pitch * 0.5 + 0.5)
    let major = step(abs(k - midk), 0.1) + step(k, 0.1) + step(abs(ka - (foot + travel)), 0.1)
    let tlen = mix(3.0, 5.0, clamp(major, 0.0, 1.0))
    let tick = (1.0 - smoothstep(px * 0.4, px * 0.6, abs(a - ka))) * step(tk, b) * step(b, tk + tlen) * inrange
    let unity = step(abs(k - floor(travel / pitch * 0.75 + 0.5)), 0.1)
    let tcol = mix(vec3(0.55, 0.575, 0.625), vec3(0.90, 0.55, 0.20), unity)
    res = Finish.over(res, vec4(tcol, 1.0) * tick * (1.0 - 0.6 * self.disabled))
    let cw = min(max(across * self.cap_cross, 4.0), across)
    let cc = mix(vec2(cap_at, mid), vec2(mid, sz.y - cap_at), v)
    let ch = mix(vec2(self.cap_px * 0.5, cw * 0.5), vec2(cw * 0.5, self.cap_px * 0.5), v)
    let clo = vec2(po_snap(cc.x - ch.x, o.x, px), po_snap(cc.y - ch.y, o.y, px))
    let chi = vec2(po_snap(cc.x + ch.x, o.x, px), po_snap(cc.y + ch.y, o.y, px))
    let spot = (0.25 * self.hover + 0.5 * self.drag) * (1.0 - self.disabled)
    res = Finish.over(res, po_cap(p, clo, chi, 3.0, px, self.hover, 0.0, self.disabled, self.focus, 0.7, 0.0, spot))
    let ccs = (clo + chi) * 0.5
    let g = mix(p.x - ccs.x, p.y - ccs.y, v)
    let gx = mix(abs(p.y - ccs.y), abs(p.x - ccs.x), v)
    let inx = step(gx, cw * 0.5 - 2.0)
    let line = 1.0 - smoothstep(px * 0.4, px * 0.6, abs(g))
    let dark = (1.0 - smoothstep(px * 0.4, px * 0.6, abs(abs(g) - 2.5)))
    let light = (1.0 - smoothstep(px * 0.4, px * 0.6, abs(abs(g) - 2.5 - px)))
    res = Finish.over(res, vec4(0.20, 0.215, 0.25, 1.0) * line * inx * (1.0 - 0.5 * self.disabled))
    res = Finish.over(res, vec4(0.72, 0.74, 0.78, 1.0) * dark * inx * 0.8)
    res = Finish.over(res, vec4(1.0, 1.0, 1.0, 1.0) * light * inx * 0.9)
    return res * po_fade(self.pos, self.rect_size, m)
}

// ---------------------------------------------------------------- knobs

// A knob: a white dome in a slim groove pressed into the plate; the value
// burns in the groove as a slim amber arc, haloed only while the knob is
// held or focused; the pointer is a graphite line on the glaze. Angles run
// from straight down, clockwise, the gap at the bottom.
let po_knob = fn(p: vec2, c: vec2, rr: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, held: float, focus: float, dis: float) -> vec4 {
    let ring_w = min(max(0.13 * rr, 3.0), 4.5)
    let ring_out = rr
    let ring_in = rr - ring_w
    let ring_mid = (ring_in + ring_out) * 0.5
    let rc = ring_in - min(max(0.04 * rr, 1.0), 2.0)
    let dr = Finish.sd_ring(p, c, ring_mid, ring_w)
    let q = p - c
    let rl = length(q)
    let live = 1.0 - dis
    let dir_n = q / max(rl, 0.01)
    // The groove: pressed in, shaded along its upper wall, a white lip on
    // the plate under its lower outer edge.
    var res = vec4(1.0, 1.0, 1.0, 1.0) * Finish.ring_out(rl - ring_out, 0.0, px * 1.5, px) * smoothstep(0.2, 0.9, dir_n.y)
    var col = mix(vec3(0.80, 0.815, 0.845), vec3(0.905, 0.912, 0.93), smoothstep(-0.8, 0.8, dir_n.y))
    col = mix(col, vec3(0.68, 0.70, 0.745), Finish.band(dr, 0.0, px, px) * smoothstep(0.2, -0.8, dir_n.y))
    col = mix(col, po_ground(), 0.4 * dis)
    let ra = Finish.cover(dr, px)
    res = Finish.over(res, vec4(col * ra, ra))
    let one = PI / 180.0
    let sweep = 2.0 * PI - gap * one
    let start = gap * one * 0.5
    let ve = start + sweep * slide
    let oe = start + sweep * origin
    let a0 = mix(start, min(oe, ve), arc_origin)
    let a1 = mix(ve, max(oe, ve), arc_origin)
    let sdf = Sdf2d.viewport(p)
    sdf.arc_round_caps(c.x, c.y, ring_mid, a0, a1, ring_w - px * 2.0)
    sdf.fill(vec4(1.0, 1.0, 1.0, 1.0))
    let arc = sdf.result.w
    let hot = 1.0 - smoothstep(0.1, 0.4 * ring_w, abs(rl - ring_mid))
    let core = mix(vec3(1.0, 0.86, 0.62), vec3(1.0, 0.96, 0.86), max(max(hover, held), focus))
    let edge = smoothstep(0.25 * ring_w, 0.5 * ring_w, abs(rl - ring_mid))
    let acol = mix(mix(vec3(0.95, 0.56, 0.18), vec3(0.78, 0.40, 0.10), edge), core, hot * 0.55)
    let halo = max(held, focus) * live
    if halo > 0.001 {
        let sdh = Sdf2d.viewport(p)
        sdh.arc_round_caps(c.x, c.y, ring_mid, a0, a1, ring_w + 4.0)
        sdh.fill(vec4(1.0, 1.0, 1.0, 1.0))
        let hb = sdh.result.w * (1.0 - arc) * exp(-max(abs(rl - ring_mid) - ring_w * 0.5, 0.0) / 1.4) * 0.45 * halo
        res = Finish.over(res, vec4(vec3(0.99, 0.70, 0.36) * hb, hb))
    }
    let aa = arc * mix(1.0, 0.4, dis)
    res = Finish.over(res, vec4(mix(acol, vec3(0.80, 0.81, 0.84), dis) * aa, aa))
    // The dome, standing on the plate inside the groove.
    let spot = (0.25 * hover + 0.45 * held) * live
    res = Finish.over(res, po_cap(p, c - vec2(rc, rc), c + vec2(rc, rc), rc, px, hover, 0.0, dis, focus, 1.0, 0.0, spot))
    // The dome's roundness: a soft light upper left, a shade lower right.
    let dq = q / max(rc, 1.0)
    let dome = Finish.cover(rl - rc + px, px)
    let lightk = exp(-dot(dq + vec2(0.3, 0.45), dq + vec2(0.3, 0.45)) * 2.2) * 0.5
    res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * lightk * dome, lightk * dome))
    let shadek = smoothstep(0.35, 1.0, length(dq - vec2(-0.25, -0.35))) * 0.10 * dome
    res = Finish.over(res, vec4(po_shade() * shadek, shadek))
    let dir = vec2(-sin(ve), cos(ve))
    let len = 0.4 * rc
    let tip = rc - 0.18 * rc
    let pd = po_seg(p, c + dir * (tip - len), c + dir * tip) - max(0.05 * rc, 0.85)
    let pa = Finish.cover(pd, px) * mix(1.0, 0.45, dis)
    return Finish.over(res, vec4(vec3(0.20, 0.215, 0.25) * pa, pa))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    return po_knob(p, c, dia * 0.5 - 1.0, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 14.0
    let px = po_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + 20.0 + dia * 0.5, px) - self.rect_pos.y)
    return po_knob(p, c, dia * 0.5 - 1.0, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.drag, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}
// The dial's readout stands as a plain line under it.
mod.widgets.Rotary.text_input.min_height = 0.0
mod.widgets.Rotary.text_input.padding.top = 0.0
mod.widgets.Rotary.text_input.padding.bottom = 0.0

// ---------------------------------------------------------------- fields

// A text field: a white pill pressed into the plate, whiter than the plate,
// shaded under its top rim, a white lip under its foot. Focused, the lit
// frame burns just inside its rim.
let po_field = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, focus: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let fo = focus * (1.0 - dis)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if fo > 0.001 {
        res = po_leak(d, a) * fo
    }
    let fill = vec3(0.978, 0.980, 0.986) + vec3(0.01, 0.01, 0.01) * fo
    res = Finish.over(res, po_sunk(p, lo, hi, r, px, fill, hover, down, dis, 0.6))
    return po_frame_over(res, d, px, fo, a, hh)
}

mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    let r = min((hi.y - lo.y) * 0.5, 13.0)
    return po_field(p, lo, hi, r, px, self.hover, self.down, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_cursor.color = #2b2e35
mod.widgets.TextInputFlat.draw_text.color = #2b2e35
mod.widgets.TextInputFlat.draw_text.color_empty = #676c75
mod.widgets.TextInputFlat.draw_text.color_disabled = #9ba0a8

// The number field: the same well; its stepper two small white caps
// stacked at the right, parted by a grey device pixel.
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let m = 8.0
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(self.rect_size.x, o.x, px), po_snap(self.rect_size.y, o.y, px))
    return po_field(p, lo, hi, 6.0, px, self.hover, 0.0, self.focus, self.disabled) * po_fade(self.pos, self.rect_size, m)
}
mod.widgets.NumberField.spin_width = 16.0
mod.widgets.NumberSpin.width = 16.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = po_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let x0 = po_snap(1.0, o.x, px)
    let x1 = po_snap(self.rect_size.x - 2.0, o.x, px)
    let y0 = po_snap(2.5, o.y, px)
    let y1 = po_snap(self.rect_size.y - 3.0, o.y, px)
    let mid = po_snap(self.rect_size.y * 0.5 - 0.25, o.y, px)
    let live = 1.0 - self.disabled
    // Each half a small white cap, lifted under the hand, pressed when held.
    let tu = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), tu) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), tu) * live
    let lo = vec2(x0, mix(mid + px, y0, tu))
    let hi = vec2(x1, mix(y1, mid - px * 0.5, tu))
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 3.0)
    let a = Finish.cover(d, px)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(1.0, 1.0, 1.0), vec3(0.93, 0.935, 0.948), t) + vec3(0.02, 0.02, 0.02) * hot - vec3(0.06, 0.06, 0.055) * dn
    col = mix(col, vec3(0.72, 0.74, 0.78), Finish.band(d, 0.0, px, px) * smoothstep(-0.5, 0.5, p.y - (hi.y - 1.5)))
    col = mix(col, po_ground(), 0.5 * self.disabled)
    var res = vec4(min(col, vec3(1.0, 1.0, 1.0)) * a, a)
    // The chevrons: 5 x 3 points, a 1.4 point graphite line.
    let cx = (x0 + x1) * 0.5
    let cu = (y0 + mid) * 0.5
    let cd = (mid + y1) * 0.5
    let du = min(po_seg(p, vec2(cx - 2.5, cu + 1.2), vec2(cx, cu - 1.3)), po_seg(p, vec2(cx, cu - 1.3), vec2(cx + 2.5, cu + 1.2)))
    let dd = min(po_seg(p, vec2(cx - 2.5, cd - 1.2), vec2(cx, cd + 1.3)), po_seg(p, vec2(cx, cd + 1.3), vec2(cx + 2.5, cd - 1.2)))
    let k = Finish.cover(min(du, dd) - 0.65, px) * mix(1.0, 0.4, self.disabled)
    let ink = mix(vec3(0.30, 0.32, 0.37), vec3(0.85, 0.48, 0.15), max(hot, dn))
    return Finish.over(res, vec4(ink * k, k))
}

// The chevron of a drop-down: 8 x 4.5 points in a 1.5 point graphite
// stroke; open, it turns amber.
let po_chevron = fn(dst: vec4, p: vec2, cc: vec2, ink: vec3, open: float, dis: float) -> vec4 {
    let dk = min(po_seg(p, vec2(cc.x - 4.0, cc.y - 2.0), vec2(cc.x, cc.y + 2.2)), po_seg(p, vec2(cc.x, cc.y + 2.2), vec2(cc.x + 4.0, cc.y - 2.0))) - 0.75
    let px = 0.67
    let col = mix(mix(ink, vec3(0.85, 0.48, 0.15), open), vec3(0.66, 0.68, 0.72), dis)
    let k = Finish.cover(dk, px)
    return Finish.over(dst, vec4(col * k, k))
}

// The drop-down: a raised white pill with its chevron 13 points in from the
// right; open, it is pressed in and the chevron turns amber.
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 12.0 right: 26.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
let po_dropdown = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, open: float, dis: float, focus: float) -> vec4 {
    let m = 14.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    let live = 1.0 - dis
    let spot = (0.35 * hover + 0.3 * down) * live
    var res = po_cap(p, lo, hi, r, px, hover, max(down, open), dis, focus, 1.0, 0.0, spot)
    res = po_chevron(res, p, vec2(hi.x - 13.0, (lo.y + hi.y) * 0.5), vec3(0.24, 0.255, 0.295), open, dis)
    return res * po_fade(pos, size, m)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    return po_dropdown(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.active, self.disabled, self.focus)
}
mod.widgets.DropDownFlat.draw_text.color = #2b2e35
mod.widgets.DropDownFlat.draw_text.color_hover = #1f2227
mod.widgets.DropDownFlat.draw_text.color_focus = #2b2e35
mod.widgets.DropDownFlat.draw_text.color_disabled = #9ba0a8

// The select wears a button of its own, built before this sheet: it is
// given the drop-down's face, its grown quad and its room here.
mod.widgets.Select.clip_x = false
mod.widgets.Select.clip_y = false
mod.widgets.MultiSelect.clip_x = false
mod.widgets.MultiSelect.clip_y = false
mod.widgets.Select.face.clip_x = false
mod.widgets.Select.face.clip_y = false
mod.widgets.MultiSelect.face.clip_x = false
mod.widgets.MultiSelect.face.clip_y = false
