mod.theme = mod.themes.light

// White porcelain: white on white, form drawn by light and soft shadow alone.
// White glazed caps stand on a pale grey-white plate; each throws a soft
// cool-grey shadow and carries a white hairline on its upper edge. Wells are
// pressed into the plate: shaded under their top rim, a white lip under
// their foot. The one colour is a small warm lamp: it lights what is on and
// the value a control holds, and nothing else. The faces are drawn in
// widgets.splash; this file holds the tokens every face and every stock
// widget reads.
mod.theme.color_bg_app = #e4e6eb
// The surface ladder is grown from this one: a white a step over the plate.
mod.theme.color_fg_app = #eff1f4
mod.theme.color_bg_container = #e4e6eb
mod.theme.color_surface_container_lowest = #dde0e5

// Raised faces the sheet does not redraw: a white glazed cap, its top the
// brightest, its foot turning grey.
mod.theme.color_outset = #f5f6f8
mod.theme.color_outset_1 = #ffffff
mod.theme.color_outset_2 = #e9ebef
mod.theme.color_outset_hover = #f9fafb
mod.theme.color_outset_1_hover = #ffffff
mod.theme.color_outset_2_hover = #eef0f3
mod.theme.color_outset_focus = #f5f6f8
mod.theme.color_outset_1_focus = #ffffff
mod.theme.color_outset_2_focus = #e9ebef
mod.theme.color_outset_active = #e6e8ec
mod.theme.color_outset_1_active = #dfe2e6
mod.theme.color_outset_2_active = #eceef1
mod.theme.color_outset_down = #e6e8ec
mod.theme.color_outset_1_down = #dfe2e6
mod.theme.color_outset_2_down = #eceef1
mod.theme.color_outset_drag = #e6e8ec
mod.theme.color_outset_1_drag = #dfe2e6
mod.theme.color_outset_2_drag = #eceef1
mod.theme.color_outset_disabled = #eef0f3
mod.theme.color_outset_1_disabled = #eef0f3
mod.theme.color_outset_2_disabled = #eef0f3

// Wells: a white pressed into the plate, whiter than it; the edges below
// shade its top and light its foot.
mod.theme.color_inset = #f8f9fb
mod.theme.color_inset_1 = #f3f4f7
mod.theme.color_inset_2 = #fafbfc
mod.theme.color_inset_hover = #fbfbfc
mod.theme.color_inset_1_hover = #f6f7f9
mod.theme.color_inset_2_hover = #fcfcfd
mod.theme.color_inset_focus = #fdfdfe
mod.theme.color_inset_1_focus = #f8f9fb
mod.theme.color_inset_2_focus = #fdfdfe
mod.theme.color_inset_active = #fdfdfe
mod.theme.color_inset_1_active = #f8f9fb
mod.theme.color_inset_2_active = #fdfdfe
mod.theme.color_inset_down = #f1f2f5
mod.theme.color_inset_1_down = #eceef1
mod.theme.color_inset_2_down = #f3f4f7
mod.theme.color_inset_drag = #f1f2f5
mod.theme.color_inset_1_drag = #eceef1
mod.theme.color_inset_2_drag = #f3f4f7
mod.theme.color_inset_empty = #f8f9fb
mod.theme.color_inset_1_empty = #f3f4f7
mod.theme.color_inset_2_empty = #fafbfc
mod.theme.color_inset_disabled = #eef0f3
mod.theme.color_inset_1_disabled = #eef0f3
mod.theme.color_inset_2_disabled = #eef0f3

// The device pixel edges of a stock face: white on top of a cap, a soft
// grey contact line under it; grey on top of a well, white under it.
mod.theme.beveling = 0.5
mod.theme.color_bevel = #c4c7cd
mod.theme.color_bevel_hover = #b9bcc3
mod.theme.color_bevel_focus = #e8963a
mod.theme.color_bevel_active = #b9bcc3
mod.theme.color_bevel_empty = #c4c7cd
mod.theme.color_bevel_down = #b9bcc3
mod.theme.color_bevel_drag = #b9bcc3
mod.theme.color_bevel_disabled = #d9dce1
mod.theme.color_bevel_inset_1 = #b9bcc3
mod.theme.color_bevel_inset_2 = #ffffff
mod.theme.color_bevel_outset_1 = #ffffff
mod.theme.color_bevel_outset_2 = #b9bcc3
mod.theme.color_bevel_inset_1_hover = #b1b4bb
mod.theme.color_bevel_inset_2_hover = #ffffff
mod.theme.color_bevel_outset_1_hover = #ffffff
mod.theme.color_bevel_outset_2_hover = #b1b4bb
mod.theme.color_bevel_inset_1_focus = #e8963a
mod.theme.color_bevel_inset_2_focus = #e8963a
mod.theme.color_bevel_outset_1_focus = #e8963a
mod.theme.color_bevel_outset_2_focus = #e8963a
mod.theme.color_bevel_inset_1_down = #aeb1b8
mod.theme.color_bevel_inset_2_down = #ffffff
mod.theme.color_bevel_outset_1_down = #c4c7cd
mod.theme.color_bevel_outset_2_down = #ffffff
mod.theme.color_bevel_inset_1_disabled = #d9dce1
mod.theme.color_bevel_inset_2_disabled = #d9dce1
mod.theme.color_bevel_outset_1_disabled = #d9dce1
mod.theme.color_bevel_outset_2_disabled = #d9dce1

// Ink: a graphite, about 12:1 on the plate and 13:1 on a white cap. The
// second voice a lighter graphite at 5.5:1; only disabled words go pale.
mod.theme.color_text = #2b2e35
mod.theme.color_text_hover = #1f2227
mod.theme.color_text_focus = #1f2227
mod.theme.color_text_active = #1f2227
mod.theme.color_text_down = #1f2227
mod.theme.color_text_val = #4f545d
mod.theme.color_text_disabled = #9ba0a8
mod.theme.color_text_placeholder = #676c75
mod.theme.color_text_placeholder_hover = #5f646d
mod.theme.color_text_meta = #555a63
mod.theme.color_text_cursor = #2b2e35
mod.theme.color_cursor = #2b2e35
mod.theme.color_cursor_focus = #2b2e35
mod.theme.color_label = #2b2e35
mod.theme.color_label_hover = #1f2227
mod.theme.color_label_focus = #1f2227
mod.theme.color_label_active = #1f2227
mod.theme.color_label_down = #1f2227
mod.theme.color_label_disabled = #9ba0a8
mod.theme.color_label_inner = #2b2e35
mod.theme.color_label_inner_hover = #1f2227
mod.theme.color_label_inner_focus = #2b2e35
mod.theme.color_label_inner_active = #1f2227
mod.theme.color_label_inner_down = #1f2227
mod.theme.color_label_inner_drag = #1f2227
mod.theme.color_label_inner_inactive = #555a63
mod.theme.color_label_inner_disabled = #9ba0a8
mod.theme.color_label_outer = #2b2e35
mod.theme.color_label_outer_off = #4f545d
mod.theme.color_label_outer_hover = #1f2227
mod.theme.color_label_outer_focus = #1f2227
mod.theme.color_label_outer_active = #1f2227
mod.theme.color_label_outer_active_focus = #1f2227
mod.theme.color_label_outer_down = #1f2227
mod.theme.color_label_outer_drag = #1f2227
mod.theme.color_label_outer_disabled = #9ba0a8
mod.theme.color_icon = #3a3e46
mod.theme.color_icon_hover = #1f2227
mod.theme.color_icon_focus = #3a3e46
mod.theme.color_icon_active = #1f2227
mod.theme.color_icon_down = #1f2227
mod.theme.color_icon_disabled = #a3a7ae
// The inks on the surface ladder, named so they hold on its deepest rung.
mod.theme.color_on_surface = #25282e
mod.theme.color_on_surface_variant = #4f545d

// The one colour: a small warm lamp, a warm-white core in an amber rim.
// The value fills burn the same amber.
mod.theme.color_focus = #e8963a
mod.theme.color_ctrl_active = #e8963a
mod.theme.color_val = #e8963a
mod.theme.color_val_hover = #f0a246
mod.theme.color_val_focus = #f0a246
mod.theme.color_val_drag = #f0a246
mod.theme.color_val_disabled = #cfd2d8
mod.theme.color_mark = #2b2e35
mod.theme.color_mark_active = #2b2e35
mod.theme.color_mark_active_hover = #1f2227
mod.theme.color_mark_focus = #2b2e35
mod.theme.color_mark_disabled = #a3a7ae
// The accent seed: the primary, secondary and tertiary families are grown
// from its hue. A burnt amber, so the grown primary carries white ink.
mod.theme.color_ctrl_selected = #b85a1a
mod.theme.color_bg_highlight = #e4e6ea
mod.theme.color_bg_highlight_inline = #f7dcb480
mod.theme.color_text_on_accent = #ffffff
// Selected text: a warm wash, stronger while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #f5c98a40
mod.theme.color_selection_down = #f5c98a73
mod.theme.color_selection_focus = #f5c98a73
mod.theme.color_handle = #fbfbfc
mod.theme.color_handle_hover = #ffffff
mod.theme.color_handle_1 = #ffffff
mod.theme.color_handle_2 = #e6e8ec

// Screens and the terminal stay white glass with graphite words.
mod.theme.color_screen = #f4f5f7
mod.theme.color_screen_ink = #2b2e35
mod.theme.color_terminal_bg = #f6f7f9
mod.theme.color_terminal_text = #2b2e35

// SPACING. Rows of 26 points, gaps of 8 between controls, 6 inside a
// group, panels padded 10. The base froze what it derived from the
// factor, so every rung this sheet depends on is stated again.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 26.0
// Stock shaders draw a corner twice the number written: 4 is the 8 point
// corner of a cap, 6 the 12 point corner of a panel.
mod.theme.corner_radius = 4.0
mod.theme.container_corner_radius = 6.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs in true points: caps 6, fields 6, panels and cards 10.
mod.theme.radius_s = 4.0
mod.theme.radius_m = 6.0
mod.theme.radius_l = 10.0

// TYPE. The base's grotesque at 9 points (12 layout points), so a label's
// cap height is about a third of the 26 point row.
mod.theme.font_size_p = 9.0
mod.theme.font_size_base = 9.0

// No surface material: the faces that matter are drawn by the sheet.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #f0a246
true
