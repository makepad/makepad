use mod.prelude.widgets_internal.*

// Worn safety-yellow painted steel. The plate is paint over steel: mottled,
// scratched, chipped to the metal at a few places and grimed toward its
// edges. Every control stands on it in black rubber or dark gunmetal, with a
// warm contact shadow and a short soft one under it; wells are charcoal cut
// into the paint with a paler lip under their foot; knobs are spun chrome in
// knurled rubber skirts; surfaces are yellow plates in black rubber frames
// held by screws. The one lit colour is a sky blue: a lamp, a value line, a
// lit legend, the focus mouth. Every rim is one device pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 26.
let field_height = 26.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #dcaa38

// Plain views stop clipping, so a part's shadow may fall into the gap
// beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let sy_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A segment's distance.
let sy_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroked chevron's distance: `w` wide, `hgt` tall, pointing down
// (`flip` 1 points up).
let sy_chevron = fn(p: vec2, c: vec2, w: float, hgt: float, flip: float) -> float {
    let s = mix(1.0, -1.0, flip)
    let a = c + vec2(-w * 0.5, -hgt * 0.5 * s)
    let b = c + vec2(0.0, hgt * 0.5 * s)
    let e = c + vec2(w * 0.5, -hgt * 0.5 * s)
    return min(sy_seg(p, a, b), sy_seg(p, b, e))
}

// A disc laid on the pixel grid: a whole number of device pixels across,
// its edge on a pixel boundary. `c` is quad-local; returns (x, y, radius).
let sy_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// The one lit colour: the lamp's core, the value line's core, its light and
// dark rims.
let sy_acc = fn() -> vec3 {
    return vec3(0.337, 0.722, 0.941)
}
let sy_fill = fn() -> vec3 {
    return vec3(0.227, 0.604, 0.847)
}
let sy_rim_hi = fn() -> vec3 {
    return vec3(0.580, 0.827, 0.965)
}
let sy_rim_lo = fn() -> vec3 {
    return vec3(0.129, 0.380, 0.580)
}
// The lit colour as disabled parts show it: an unlit grey.
let sy_off = fn() -> vec3 {
    return vec3(0.200, 0.196, 0.188)
}
// Black rubber.
let sy_bezel = fn() -> vec3 {
    return vec3(0.071, 0.067, 0.059)
}
// Shadows on the paint are a warm brown-black.
let sy_shadow_ink = fn() -> vec3 {
    return vec3(0.110, 0.055, 0.004)
}

// Signed grain, -amount..amount with a triangular spread, one value per
// device pixel (pass `p / px`); two hashes whose lattices are displaced by
// a first one, so no shift lines them up again.
let sy_grain = fn(q: vec2, amount: float) -> float {
    let i = floor(q)
    let h = Finish.hash(i)
    let a = Finish.hash(i + vec2(h * 397.13, h * 211.71))
    let b = Finish.hash(vec2(i.y * 0.7548 + h * 157.3, i.x * 1.1698 + h * 89.9))
    return (a + b - 1.0) * amount
}

// One scratch per cell, in about a third of the cells: a straight stroke at
// a hashed angle, tapered at both ends. Returns (groove, scuff), each 0..1.
let sy_scratch = fn(q: vec2, cell: float, seed: float, px: float) -> vec2 {
    let ci = floor(q / cell)
    let h1 = Finish.hash(ci + vec2(seed, seed * 0.37))
    let h2 = Finish.hash(ci + vec2(h1 * 91.3 + seed, 17.1))
    let h3 = Finish.hash(ci + vec2(33.7, h2 * 71.9 + seed))
    let h4 = Finish.hash(ci + vec2(h3 * 53.1, h1 * 29.3))
    let on = step(0.74, h1)
    let ang = (h2 - 0.5) * 2.6
    let dir = vec2(cos(ang), sin(ang))
    let len = cell * (0.12 + 0.22 * h3)
    let c = (ci + vec2(0.5, 0.5) + (vec2(h4, h3) - vec2(0.5, 0.5)) * 0.25) * cell
    let ts = clamp(dot(q - c, dir) / len, -1.0, 1.0)
    let d = length(q - c - dir * ts * len)
    let taper = 1.0 - ts * ts
    let groove = (1.0 - smoothstep(0.0, 0.18 * taper + px * 0.5, d)) * taper
    let scuff = exp(-d / 0.7) * taper
    return vec2(groove, scuff) * on
}

// The paint, in window coordinates `q`: a slow mottle, rubbed lighter
// patches, scratches through to a dark groove with a pale scuff beside
// them, a few chips down to steel with a rust rim, and the grain. No fall
// and no grime: those belong to the whole window.
let sy_paint = fn(q: vec2, px: float) -> vec3 {
    var col = vec3(0.863, 0.667, 0.220)
    let m1 = Finish.fbm(q / 130.0 + vec2(3.7, 1.3)) - 0.5
    let m2 = Finish.fbm(q / 26.0 + vec2(11.1, 5.9)) - 0.5
    col = col * (1.0 + 0.16 * m1 + 0.07 * m2)
    // rubbed paint: paler and a little more saturated where the mottle peaks
    col = mix(col, vec3(0.925, 0.745, 0.290), smoothstep(0.10, 0.28, m1) * 0.35)
    // small chips down to the steel, in a few clusters: a slow field
    // decides where paint is tired, a fine one cuts the flakes
    let n = Finish.fbm(q / 9.0 + vec2(21.3, 7.7))
    let field = Finish.fbm(q / 210.0 + vec2(5.0, 13.0))
    let th = 0.90 - 0.15 * smoothstep(0.62, 0.76, field)
    let chip = smoothstep(th, th + 0.02, n)
    let rim = smoothstep(th - 0.06, th, n) * (1.0 - chip)
    let deep = smoothstep(th + 0.03, th + 0.08, n)
    var steel = mix(vec3(0.620, 0.470, 0.180), vec3(0.540, 0.370, 0.150), Finish.fbm(q / 5.0 + vec2(2.0, 9.0)))
    steel = mix(steel, vec3(0.380, 0.260, 0.120), deep * 0.85)
    col = mix(col, col * vec3(0.86, 0.78, 0.64), rim * 0.55)
    col = mix(col, steel, chip * 0.9)
    // grime: soft brown smudges where a middle field and a fine one agree
    let gm = Finish.fbm(q / 48.0 + vec2(8.1, 2.2))
    let gf = Finish.fbm(q / 6.0 + vec2(1.7, 4.4))
    let grime = smoothstep(0.58, 0.72, gm) * smoothstep(0.45, 0.70, gf)
    col = mix(col, col * vec3(0.72, 0.62, 0.46), grime * 0.45)
    // the paint's own skin: a fine orange peel
    col = col * (1.0 + 0.035 * (Finish.noise(q / 1.6 + vec2(3.3, 9.1)) - 0.5))
    // scratches, two grids of cells offset from each other: a thin dark
    // groove, a pale scuff beside it
    let s1 = sy_scratch(q, 52.0, 0.0, px)
    let s2 = sy_scratch(q + vec2(19.3, 31.7), 83.0, 7.3, px)
    let groove = max(s1.x, s2.x)
    let scuff = max(s1.y, s2.y) * (1.0 - chip)
    col = mix(col, vec3(0.965, 0.847, 0.510), scuff * 0.16)
    col = mix(col, vec3(0.420, 0.320, 0.170), groove * 0.35)
    // dirt specks, one in a few hundred pixels
    let i = floor(q / px)
    let sp = step(0.9975, Finish.hash(vec2(i.x + 71.3, i.y + 19.7 + Finish.hash(i) * 613.7)))
    col = mix(col, vec3(0.420, 0.300, 0.120), sp * 0.35)
    return col + g3(sy_grain(q / px, 0.020))
}

// The window's ground: the paint, lit from the top, grimed toward the edges.
let sy_ground = fn(p: vec2, size: vec2, px: float) -> vec3 {
    var col = sy_paint(p, px)
    let t = clamp(p.y / max(size.y, 1.0), 0.0, 1.0)
    col = col * mix(1.03, 0.93, t)
    let e = min(min(p.x, size.x - p.x), min(p.y, size.y - p.y))
    let grime = (1.0 - smoothstep(0.0, 90.0, e)) * (0.4 + 0.8 * Finish.fbm(p / 24.0 + vec2(1.0, 3.0)))
    return mix(col, vec3(0.380, 0.270, 0.090), clamp(grime, 0.0, 1.0) * 0.35)
}

// The face of a raised gunmetal cap by height t 0..1: lit at the top,
// falling 2:1 to its foot.
let sy_face = fn(t: float) -> vec3 {
    let top = vec3(0.330, 0.330, 0.325)
    let mid = vec3(0.262, 0.262, 0.260)
    let foot = vec3(0.180, 0.180, 0.178)
    return mix(mix(top, mid, clamp(t * 2.0, 0.0, 1.0)), foot, clamp(t * 2.0 - 1.0, 0.0, 1.0))
}

// The rubber stipple on a cap: a fine diamond knurl, a few levels deep.
let sy_knurl = fn(q: vec2, px: float) -> float {
    let k = q / px
    return (sin((k.x + k.y) * 2.1) + sin((k.x - k.y) * 2.1)) * 0.25
}

// An LED dash: `lit` 0 shows the unlit bead `off` in its slot, 1 the lit
// core, white-hot over its middle third, with a tight halo.
let sy_dash = fn(p: vec2, c: vec2, hw: float, hh: float, px: float, ink: vec3, lit: float, off: vec3) -> vec4 {
    let d = sy_rbox(p, c, vec2(hw, hh), hh)
    let a = Finish.cover(d, px)
    let across = abs(p.y - c.y) / max(hh, 0.001)
    let hot = 1.0 - smoothstep(0.15, 0.6, across)
    let core = mix(ink, vec3(1.0, 1.0, 1.0), 0.55 * hot)
    let col = mix(off, core, lit)
    var out = vec4(col * a, a)
    let ha = 0.30 * lit * exp(-max(d - px, 0.0) / (0.8 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A lamp bead: a round lens, lit with a white-hot centre and a tight halo,
// or unlit at a third of its light.
let sy_bead = fn(p: vec2, c: vec2, rad: float, px: float, ink: vec3, lit: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    let a = Finish.cover(d, px)
    let rr = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(mix(ink, vec3(1.0, 1.0, 1.0), 0.6), ink * 0.85, smoothstep(0.0, 1.0, rr))
    let off = mix(ink * 0.30, ink * 0.18, rr) + g3(0.03)
    var col = mix(off, on, lit)
    col = mix(col, sy_bezel(), Finish.band(d, 0.0, px, px) * 0.6 * (1.0 - lit))
    var out = vec4(col * a, a)
    let ha = 0.32 * lit * exp(-max(d - px, 0.0) / (0.9 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A well cut into the paint: the fill, the plate's shadow falling in from
// the top wall, a dark mouth darkest on top. Its lip is `sy_lip`.
let sy_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, depth: float) -> vec3 {
    let d = sy_rbox(p, c, h, r)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, depth * 0.5), max(depth * 0.4, px * 0.6))
    var col = mix(fill, vec3(0.047, 0.043, 0.039), clamp(sh, 0.0, 1.0) * 0.85)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, vec3(0.063, 0.043, 0.020), Finish.band(d, 0.0, px, px) * mix(0.55, 0.95, up))
    return col
}

// The lip under a well's lower rim, outside it on the paint, confined to
// the foot and the lower corners: a pale catch of light, premultiplied.
let sy_lip = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, a: float) -> vec4 {
    let d = sy_rbox(p, c, h, r)
    let foot = smoothstep(c.y + h.y - max(r, 1.0) - 1.5, c.y + h.y, p.y)
    let l = Finish.ring_out(d, 0.0, px, px) * foot * a
    let k = vec3(1.0, 0.925, 0.690)
    return vec4(k * l, l)
}

// Focus: one device pixel of the lit blue, two device pixels out.
let sy_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * 0.9 * focus
    let k = vec3(0.110, 0.420, 0.700)
    return vec4(k * f, f)
}

// Spun chrome: a conic sheen, two bright lobes top and bottom, two dark at
// the sides, over lathe rings one device pixel apart. Returns a luminance.
let sy_conic = fn(q: vec2, px: float, lo: float, hi: float, turn: float) -> float {
    let r = max(length(q), 0.0001)
    let cs = q.x / r
    let sn = q.y / r
    let c1 = cs * cos(turn) - sn * sin(turn)
    let s1 = sn * cos(turn) + cs * sin(turn)
    let c2 = s1 * s1 - c1 * c1
    let k = c2 * 0.5 + 0.5
    var l = mix(lo, hi, k * k * (3.0 - 2.0 * k))
    let rings = Finish.noise(vec2(r / px, 0.37)) - 0.5
    l = l + rings * 0.03 * smoothstep(0.0, 2.0, r)
    l = l + 0.05 * (1.0 - smoothstep(0.0, px * 1.2, r))
    return l
}

// A small chrome disc standing on the paint: contact ring, a warm cast
// shadow, a bright chamfer, the spun face.
let sy_disc = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let hh = vec2(rad, rad)
    let dia = 2.0 * rad
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let cast = Finish.drop(p, c, hh, rad, vec2(dia * 0.05, dia * 0.10), dia * 0.12) * 0.65 * (1.0 - 0.5 * press) * mix(1.0, 0.4, dis)
    let ink = sy_shadow_ink()
    out = Finish.over(out, vec4(ink * cast, cast))
    let q = p - c
    let d = length(q) - rad
    let con = Finish.ring_out(d, 0.0, px, px) * 0.7
    out = Finish.over(out, vec4(sy_bezel() * con, con))
    var face = g3(sy_conic(q, px, 0.42, 0.86, 0.12 * hover))
    face = face * vec3(1.0, 0.99, 0.97)
    face = face + g3(0.07 * hover - 0.06 * press)
    face = mix(face, mix(g3(0.36), face * 0.5, 0.5), dis)
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    let ch = mix(vec3(0.80, 0.80, 0.79), vec3(0.97, 0.97, 0.96), smoothstep(0.35, 1.0, t))
    face = mix(face, vec3(0.30, 0.30, 0.30), Finish.band(d, 2.0 * px, 3.0 * px, px) * 0.9)
    face = mix(face, mix(ch, g3(0.38), dis), Finish.band(d, 0.0, 2.0 * px, px) * 0.9)
    face = mix(face, vec3(0.20, 0.20, 0.20), Finish.band(d, 0.0, px, px) * 0.7)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// A ribbed rubber block with chrome ends, the thumb of a bar slider and the
// cap of a fader. `c` its centre, `h` its half size; `along` 1 when its ribs
// run across x (a horizontal slider), 0 when they run across y.
let sy_block = fn(p: vec2, c: vec2, h: vec2, px: float, horiz: float, hover: float, press: float, dis: float, lit: float) -> vec4 {
    let ink = sy_shadow_ink()
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let r = 1.8
    let cast = Finish.drop(p, c, h, r, vec2(0.4, 1.6), 1.4) * 0.60 * (1.0 - 0.4 * press) * mix(1.0, 0.4, dis)
    out = Finish.over(out, vec4(ink * cast, cast))
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px) * 0.7
    out = Finish.over(out, vec4(ink * con, con))
    let d = sy_rbox(p, c, h, r)
    // u along the block's length 0..1, v across it 0..1 (top to bottom)
    let u = mix((c.y + h.y - p.y) / max(2.0 * h.y, 1.0), (p.x - (c.x - h.x)) / max(2.0 * h.x, 1.0), horiz)
    let vv = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let len = mix(2.0 * h.y, 2.0 * h.x, horiz)
    let endw = min(3.0, len * 0.18) / max(len, 1.0)
    let is_end = 1.0 - step(endw, u) * step(u, 1.0 - endw)
    // chrome ends: a cylinder lit from above
    var chrome = mix(vec3(0.93, 0.93, 0.92), vec3(0.36, 0.36, 0.36), smoothstep(0.1, 0.95, vv))
    chrome = mix(chrome, vec3(0.99, 0.99, 0.98), (1.0 - smoothstep(0.08, 0.30, vv)) * 0.6)
    // rubber: ribs across the length, one rib per three device pixels
    let along = mix(p.y, p.x, horiz) / px
    let rib = 0.5 + 0.5 * sin(along * 2.094)
    var rubber = mix(vec3(0.060, 0.058, 0.055), vec3(0.230, 0.228, 0.222), rib)
    rubber = rubber * mix(1.25, 0.70, vv)
    rubber = rubber + g3(0.10 * hover * (1.0 - press) - 0.04 * press)
    var face = mix(rubber, chrome, is_end)
    face = mix(face, mix(g3(0.30), face * 0.6, 0.5), dis)
    // the held block shows a lit blue line down its middle
    let mid = abs(u - 0.5) * len
    let ln = (1.0 - smoothstep(px * 0.5, px * 1.5, mid)) * lit * (1.0 - is_end)
    face = mix(face, sy_acc(), ln)
    face = mix(face, sy_bezel(), Finish.band(d, 0.0, px, px) * 0.8)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// A steel screw head in the paint: a dark socket ring, a domed head spun
// round its centre, a cross slot at a hashed turn.
let sy_screw = fn(p: vec2, c: vec2, rad: float, px: float, turn: float) -> vec4 {
    let ink = sy_shadow_ink()
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let q = p - c
    let d = length(q) - rad
    let cast = Finish.drop(p, c, vec2(rad, rad), rad, vec2(0.3, 0.8), 0.8) * 0.55
    out = Finish.over(out, vec4(ink * cast, cast))
    let sock = Finish.ring_out(d, 0.0, 1.5 * px, px) * 0.7
    out = Finish.over(out, vec4(sy_bezel() * sock, sock))
    var face = g3(sy_conic(q, px, 0.38, 0.78, turn))
    // domed: lighter toward the upper left, darker toward the lower right
    face = face * (1.08 - 0.30 * clamp(dot(q / max(rad, 0.1), vec2(0.45, 0.85)) * 0.5 + 0.5, 0.0, 1.0))
    face = face * vec3(1.0, 0.98, 0.94)
    // the slot: a cross, a dark stroke with a lit edge below it
    let cs = cos(turn)
    let sn = sin(turn)
    let a1 = vec2(cs, sn) * rad * 0.62
    let a2 = vec2(-sn, cs) * rad * 0.62
    let sl = min(sy_seg(p, c - a1, c + a1), sy_seg(p, c - a2, c + a2)) - max(rad * 0.13, px * 0.6)
    let sl_lit = min(sy_seg(p - vec2(0.0, px), c - a1, c + a1), sy_seg(p - vec2(0.0, px), c - a2, c + a2)) - max(rad * 0.13, px * 0.6)
    face = mix(face, g3(0.85), Finish.cover(sl_lit, px) * 0.5)
    face = mix(face, g3(0.10), Finish.cover(sl, px))
    face = mix(face, g3(0.18), Finish.band(d, 0.0, px, px) * 0.8)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. A rubber keycap: a black rubber base two device pixels wide, and
// on it the gunmetal cap, knurled, lit along its top row, a dark row at its
// foot; a warm contact shadow and a short soft one on the paint. `kind`
// picks the dressing: 0 flat plate (no soft layer), 1 raised, 2 raised with
// a lit dash (primary), 3 raised with the dash unlit (secondary), 4 raised
// with a red dash (danger), 5 an engraved outline on the paint, 6 bare
// until touched, 7 a brushed steel pad. The quad is grown by `m`.
let sy_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live * (1.0 - press)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = sy_rbox(p, c, h, r)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let outl = step(4.5, kind) * step(kind, 5.5)
    let pad = step(6.5, kind)
    let solid = 1.0 - bare - outl
    let bez = 3.0 * px
    let soft_on = step(0.5, kind) * solid

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = sy_shadow_ink()
    // the soft layer: a little right, mostly below, gone within half of
    // the eight point gap to the next row
    let soft = Finish.drop(p, c, h, r, vec2(0.3, 1.6), 1.3) * 0.55 * soft_on * (1.0 - press) * live
    out = Finish.over(out, vec4(ink * soft, soft))
    // the contact line right under the edge
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px * 1.2) * 0.75 * solid * mix(1.0, 0.35, press) * mix(1.0, 0.5, disabled)
    out = Finish.over(out, vec4(ink * con, con))

    // the cap: its top row one device pixel lower while pressed
    let sink = press * px
    let t = clamp((p.y - lo.y - sink) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let yi = p.y - lo.y - bez - sink
    var face = sy_face(t)
    if pad > 0.5 {
        face = mix(vec3(0.420, 0.420, 0.412), vec3(0.310, 0.310, 0.306), t)
        face = face + g3((Finish.brushed(p + o, vec2(1.0, 0.0), px * 1.2) - 0.5) * 0.05)
    }
    face = face + g3(sy_knurl(p + o, px) * 0.035 * (1.0 - pad))
    // a soft sheen over the cap's upper third, the rubber's satin
    face = face + g3(0.05 * (1.0 - smoothstep(0.05, 0.40, t)) * (1.0 - press))
    face = face + g3(0.065 * hov)
    // pressed: a darker cap with the base's shadow inside its top
    let sunk = mix(vec3(0.035, 0.033, 0.030), vec3(0.120, 0.120, 0.117), smoothstep(0.0, 3.0 * px + 1.5, yi))
    face = mix(face, sunk + g3(sy_knurl(p + o, px) * 0.02), press)
    face = mix(face, vec3(0.290, 0.282, 0.263), disabled)
    face = face + g3(sy_grain((p + o) / px, 0.014))
    // the top highlight: one device pixel, then a short ramp into the face
    let topw = 1.0 - smoothstep(lo.y + bez + r + 0.5, lo.y + bez + r + 1.5, p.y)
    let botw = smoothstep(hi.y - bez - r - 1.5, hi.y - bez - r - 0.5, p.y)
    let hl_row = Finish.band(d, bez, bez + px, px) * topw
    let ramp = (1.0 - smoothstep(0.0, 2.0, yi - px)) * step(0.0, yi) * 0.30
    let hl = mix(vec3(0.420, 0.416, 0.400), vec3(0.560, 0.556, 0.540), hov)
    let lit_top = max(hl_row, ramp) * (1.0 - press) * live
    face = mix(face, mix(hl, vec3(0.62, 0.62, 0.60), pad * 0.6), lit_top)
    // the foot line
    face = mix(face, vec3(0.043, 0.039, 0.035), Finish.band(d, bez, bez + px, px) * botw * (1.0 - press))
    // the rubber base, its outer row catching a warm light on top
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    var base = sy_bezel()
    base = mix(base, vec3(0.290, 0.220, 0.120), Finish.band(d, 0.0, px, px) * up * 0.6 * live)
    face = mix(face, base, Finish.band(d, 0.0, bez, px))

    // the dash of the primary, secondary and danger faces
    if kind > 1.5 && kind < 4.5 {
        let hw = clamp(h.x * 0.42, 5.0, 14.0)
        let dy = Finish.snap(o.y + hi.y - bez - 3.0, px) - o.y + sink
        let is_red = step(3.5, kind)
        let lit = step(kind, 2.5) * live + is_red * live
        let dink = mix(sy_acc(), vec3(0.980, 0.380, 0.300), is_red)
        let doff = vec3(0.071, 0.067, 0.063)
        let dash = sy_dash(p, vec2(c.x, dy + px), hw, px, px, mix(dink, sy_off(), disabled), lit, mix(doff, vec3(0.20, 0.20, 0.19), disabled))
        face = face * (1.0 - dash.a) + dash.rgb
    }

    var fa = 1.0
    if kind > 4.5 && kind < 6.5 {
        fa = 0.0
    }
    let a = Finish.cover(d, px) * fa
    out = Finish.over(out, vec4(face * a, a))

    // the outline and the bare face: a shade on the paint; the outline
    // is an engraved groove, dark over a pale lip
    if kind > 4.5 && kind < 6.5 {
        let sh = Finish.cover(d, px) * ((0.08 * hov + 0.16 * press) + outl * 0.04)
        out = Finish.over(out, vec4(ink * sh, sh))
        let dk = Finish.band(d, 0.0, 1.5 * px, px) * mix(0.9, 0.45, disabled) * mix(outl, hov + press, bare)
        out = Finish.over(out, vec4(sy_bezel() * dk, dk))
        let low = smoothstep(-0.5, 0.5, p.y - c.y)
        let li = Finish.ring_out(d, 0.0, px, px) * low * 0.35 * live * outl
        out = Finish.over(out, vec4(vec3(1.0, 0.925, 0.690) * li, li))
    }

    out = Finish.over(out, sy_focus(d, px, focus * live))

    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        let k = sy_acc()
        sdf.fill(vec4(k * loading, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The drop-down face: the cap with an engraved split 22 points from its
// right end and a stroked chevron behind it; `held` is pressed.
let sy_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, disabled: float, m: float) -> vec4 {
    var out = sy_button(pos, size, o, px, hover, held, focus, disabled, 0.0, 0.0, 2.0, 1.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.2, p.y) * step(p.y, size.y * 0.8)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * 0.9
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.7 * (1.0 - held)
    let bz = sy_bezel()
    out = Finish.over(out, vec4(bz * div_d, div_d))
    let hl = vec3(0.380, 0.376, 0.365)
    out = Finish.over(out, vec4(hl * div_l, div_l))
    let cc = vec2(size.x - 11.0, Finish.snap(o.y + size.y * 0.5, px) - o.y + held * live * px)
    let ch = Finish.cover(sy_chevron(p, cc, 6.0, 3.5, 0.0) - 0.65, px)
    let ink = mix(mix(vec3(0.84, 0.83, 0.80), vec3(0.95, 0.94, 0.92), hover * live), vec3(0.56, 0.55, 0.51), disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the raised faces grow their quad for the shadow and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return sy_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 2.0, 0.0, 0.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return sy_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 2.0, 6.0, 0.0)
}
mod.widgets.Button.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return sy_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 2.0, 1.0, 6.0)
}
