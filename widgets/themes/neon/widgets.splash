    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Flatter: nothing at rest; the tube comes with the pointer.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_button(p, self.rect_pos, self.rect_size, px, self.corners(), vec3(0.18, 0.855, 1.0), vec3(0.004, 0.518, 0.698), self.hover, self.down, self.focus, self.disabled, 0.0, 0.0, 0.0, 0.0)
    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}

