    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Danger: red-pink, lit as the secondary.
mod.widgets.ButtonDanger.draw_bg.glow_room = uniform(3.0)
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
