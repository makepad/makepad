// ---------------------------------------------------------------------------
// MORE LIGHT HELPERS.

// Distance to an arc of radius r about the centre, from angle a0 to a1,
// angles measured from straight down and turning clockwise, with round
// ends. q is the point relative to the centre.
let n_arc = fn(q: vec2, r: float, a0: float, a1: float) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let ring = abs(length(q) - r)
    let e0 = vec2(0.0 - sin(a0), cos(a0)) * r
    let e1 = vec2(0.0 - sin(a1), cos(a1)) * r
    let ends = min(length(q - e0), length(q - e1))
    return mix(ends, ring, step(a0, a) * step(a, a1))
}

// A dark knob body: glass lit from below, a 1 dpx rim lighter on its top
// half, a pixel darker inside it. Premultiplied.
let n_body = fn(p: vec2, c: vec2, r: float, px: float, live: float) -> vec4 {
    let d = length(p - c) - r
    let yn = clamp((p.y - c.y + r) / (2.0 * r), 0.0, 1.0)
    var col = mix(vec3(0.055, 0.075, 0.153), vec3(0.086, 0.114, 0.22), yn)
    col = mix(col, col * 0.6, Finish.band(d, px, 2.0 * px, px))
    col = mix(col, mix(vec3(0.16, 0.20, 0.30), vec3(0.08, 0.10, 0.17), yn), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// A slider handle: the dark body with its rim carried right round (+0.06
// lum on top, +0.03 below) and a near-black pixel ring outside it, so the
// disc stands apart from the lit fill it sits on. Premultiplied.
let n_handle = fn(p: vec2, c: vec2, r: float, px: float) -> vec4 {
    let d = length(p - c) - r
    let yn = clamp((p.y - c.y + r) / (2.0 * r), 0.0, 1.0)
    var col = mix(vec3(0.055, 0.075, 0.153), vec3(0.086, 0.114, 0.22), yn)
    col = mix(col, col * 0.6, Finish.band(d, 1.5 * px, 2.5 * px, px))
    col = mix(col, mix(vec3(0.14, 0.18, 0.27), vec3(0.10, 0.13, 0.23), yn), Finish.band(d, 0.0, 1.5 * px, px))
    col = mix(col, vec3(0.008, 0.012, 0.039), Finish.ring_out(d, 0.0, px, px))
    let a = Finish.cover(d - px, px)
    return vec4(col * a, a)
}

// A lamp dot: plain hue, a paler centre, the tight glow. Laid over `under`.
let n_lamp = fn(under: vec4, p: vec2, c: vec2, r: float, px: float, hue: vec3, deep: vec3, lit: float) -> vec4 {
    let d = length(p - c) - r
    let k = clamp(length(p - c) / max(r, 0.5), 0.0, 1.0)
    let col = mix(mix(hue, vec3(1.0, 1.0, 1.0), 0.45), hue, k * k)
    var o = Finish.over(under, vec4(deep * n_halo(d, 0.35 * lit, 0.0), 0.0))
    return mix(o, vec4(col, 1.0), Finish.cover(d, px) * lit)
}

// A dark slot: near-black, a 1 dpx dark rim, round ends. Premultiplied.
let n_slot = fn(d: float, px: float) -> vec4 {
    var col = vec3(0.008, 0.012, 0.039)
    col = mix(col, vec3(0.004, 0.004, 0.02), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// The plate: panel ground #0b0f1f, lit from the upper right, with a fine
// monochrome grain (sd about 0.006 lum over a 2 dpx cell and a softer
// second octave). Opaque.
let n_plate = fn(p: vec2, size: vec2, px: float, base: vec3) -> vec3 {
    let u = p / max(size, vec2(1.0, 1.0))
    let lift = 1.0 + 0.10 * (1.0 - 2.0 * u.y) + 0.04 * u.x
    let g = Finish.grain(p / (2.0 * px), 3.8 / 255.0) + (Finish.noise(p / (3.3)) - 0.5) * 0.012
    return base * lift + vec3(g, g, g)
}

// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point box with a resting tube around a navy well; on,
// the well takes the hue at 20 % and the tick is a white stroke with a
// hue glow. Mixed is a short bar, error turns the hue red-pink.
let n_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, r: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, min(r, sz * 0.5))
    let yn = clamp((p.y - lo.y) / sz, 0.0, 1.0)
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.961, 0.0, 0.435), err)
    let deep = mix(vec3(0.004, 0.518, 0.698), vec3(0.447, 0.059, 0.239), err)
    let live = 1.0 - disabled
    let on = max(active, mixed)
    let warm = max(max(on, max(focus, down)), hover * 0.55)
    let lit = mix(0.55, 1.0, warm) * mix(0.8, 1.0, yn)
    let well = vec3(0.016, 0.031, 0.094)
    let face = vec4(mix(well, hue, (0.20 * active + 0.10 * mixed + 0.05 * hover) * live), 1.0)
    let tight = (0.3 * hover + 0.35 * on + 0.55 * focus) * live
    let h2 = mix(hue, vec3(0.071, 0.137, 0.251), disabled)
    var f = n_frame(d, px, mix(face, vec4(0.024, 0.039, 0.114, 1.0), disabled), h2, deep, mix(lit, 1.0, disabled), live, tight, 0.0)
    // The tick, then the mixed bar.
    let q = (p - lo) / sz
    let tick = min(n_seg(q, vec2(0.24, 0.52), vec2(0.43, 0.71)), n_seg(q, vec2(0.43, 0.71), vec2(0.77, 0.30))) * sz
    let ink = mix(mix(hue, vec3(1.0, 1.0, 1.0), 0.55), vec3(0.165, 0.29, 0.37), disabled)
    f = n_stroke(f, tick, 0.75, px, ink, deep, active * (1.0 - mixed), live, 0.35 * live)
    let bar = n_seg(p, c - vec2(3.0, 0.0), c + vec2(3.0, 0.0))
    return n_stroke(f, bar, 0.75, px, ink, deep, mixed, live, 0.35 * live)
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 2.5
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    return n_check(p, self.rect_pos, self.rect_size, px, self.size, self.border_radius, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}

// RADIOS. A 14 point ring tube; on, a 6.5 point dot white at its centre
// and the hue at its rim, with its own tight glow.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.size = 14.0
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let o = self.rect_pos
    let r = self.size * 0.5
    let c = vec2(Finish.snap(o.x + r, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    let d = length(p - c) - r
    let yn = clamp((p.y - c.y + r) / (2.0 * r), 0.0, 1.0)
    let hue = vec3(0.18, 0.855, 1.0)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - self.disabled
    let warm = max(max(self.active, max(self.focus, self.down)), self.hover * 0.55)
    let lit = mix(0.55, 1.0, warm) * mix(0.8, 1.0, yn)
    let face = vec4(mix(vec3(0.016, 0.031, 0.094), hue, 0.05 * self.hover * live), 1.0)
    let tight = (0.3 * self.hover + 0.35 * self.active + 0.55 * self.focus) * live
    let h2 = mix(hue, vec3(0.071, 0.137, 0.251), self.disabled)
    let f = n_frame(d, px, mix(face, vec4(0.024, 0.039, 0.114, 1.0), self.disabled), h2, deep, mix(lit, 1.0, self.disabled), live, tight, 0.0)
    return n_lamp(f, p, c, 3.25, px, mix(hue, vec3(0.165, 0.29, 0.37), self.disabled), deep, self.active)
}

// TOGGLES. The instrument switch: a near-black capsule 26 by 12 with a
// quiet rim, a dark 10 point knob; ON lights a 4 point lamp in the knob
// and washes the capsule with the hue at 14 %.
mod.widgets.ToggleFlat.label_walk.margin.left = 26.0
mod.widgets.ToggleFlat.draw_bg.size = 12.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.1667
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = (self.rect_size.x - sz.x) * self.mark_at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let d = Finish.sd_pill(p, c, (hi - lo) * 0.5)
    let yn = clamp((p.y - lo.y) / sz.y, 0.0, 1.0)
    let hue = vec3(0.18, 0.855, 1.0)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - self.disabled
    let warm = max(max(self.focus, self.down), self.hover * 0.55) * live
    // At rest the capsule is a near-black well with one quiet pixel of rim
    // on its lower half only; the cyan tube comes with the hand or a focus.
    let lit = mix(0.55, 1.0, warm) * mix(0.8, 1.0, yn)
    let well = mix(vec3(0.008, 0.012, 0.039), hue, 0.14 * self.active * live)
    let wa = Finish.cover(d, px)
    var rest = vec4(well, 1.0)
    rest = mix(rest, vec4(0.043, 0.075, 0.188, 1.0), Finish.band(d, 0.0, px, px) * step(c.y, p.y))
    rest = rest * wa
    let tube = n_frame(d, px, vec4(well, 1.0), hue, deep, lit, 1.0, 0.3 * self.hover + 0.55 * self.focus, 0.0)
    let f = mix(rest, tube, min(warm * 1.8, 1.0))
    let t = mix(self.active, self.drag_pos, self.drag)
    let kr = sz.y * 0.5 - 1.0
    let kc = vec2(mix(lo.x + sz.y * 0.5, hi.x - sz.y * 0.5, t), c.y)
    let k = Finish.over(f, n_body(p, kc, kr, px, live))
    return n_lamp(k, p, kc, 2.0, px, hue, deep, self.active * live)
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false

// ---------------------------------------------------------------------------
// SLIDERS. The value is the light, not the control: a 5 point near-black
// slot that is never lit, a 2 point hue fill with a tight glow, a dark
// 14 point handle that shows its lamp only while touched.
let n_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, pad: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float, handle: float) -> vec4 {
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.071, 0.137, 0.251), disabled)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - disabled
    let y = Finish.snap(o.y + cy, px) - o.y
    let x0 = Finish.snap(o.x + pad, px) - o.x
    let x1 = Finish.snap(o.x + rs.x - pad, px) - o.x
    let slot = Finish.sd_pill(p, vec2((x0 + x1) * 0.5, y), vec2((x1 - x0) * 0.5 + 2.5, 2.5))
    var f = n_slot(slot, px)
    // The lip under the slot, the light being above.
    f = Finish.over(vec4(0.03, 0.04, 0.07, 1.0) * Finish.ring_out(slot, 0.0, px, px) * step(y, p.y), f)
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    let fill = n_seg(p, vec2(min(xf, xv), y), vec2(max(xf, xv), y))
    f = n_stroke(f, fill, 1.0, px, hue * mix(0.85, 1.0, max(hover, drag)), deep, 1.0, 0.0, 0.3 * live)
    let hc = vec2(xv, y)
    let k = Finish.over(f, n_handle(p, hc, 7.0 * handle, px) * handle)
    let touch = max(max(hover, drag), focus) * live
    // At rest the handle keeps a faint ring where the lamp will be.
    let ring = abs(length(p - hc) - 2.0) - px * 0.5
    let r2 = mix(k, vec4(hue * 0.3, 1.0), Finish.cover(ring, px) * (1.0 - touch) * handle * 0.9)
    return n_lamp(r2, p, hc, 2.0, px, hue, deep, touch * handle)
}

mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
// The minimal slider: a hairline rail and the lit value; its handle only
// comes with the pointer.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let o = self.rect_pos
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.071, 0.137, 0.251), self.disabled)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - self.disabled
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y
    let rail = abs(p.y - y) - px * 0.5
    let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
    var f = vec4(vec3(0.118, 0.184, 0.349) * Finish.cover(rail, px) * inx, Finish.cover(rail, px) * inx)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(0.0, lo, self.arc_origin) * self.rect_size.x
    let b = mix(self.slide_pos, hi, self.arc_origin) * self.rect_size.x
    let fill = n_seg(p, vec2(a, y), vec2(b, y))
    f = n_stroke(f, fill, 1.0, px, hue, deep, 1.0, 0.0, 0.3 * live)
    let hc = vec2(self.slide_pos * self.rect_size.x, y)
    let touch = max(self.hover, self.drag)
    let k = Finish.over(f, n_handle(p, hc, 5.0, px) * touch)
    return n_lamp(k, p, hc, 1.75, px, hue, deep, touch * live)
}
// The bar slider: label and value above, the slot below.
mod.widgets.SliderFlat.height = 34.0
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let cy = 18.0 + (self.rect_size.y - 18.0) * 0.5
    let f = n_slider(p, self.rect_pos, self.rect_size, px, cy, 7.0, to, from, self.hover, self.focus, self.drag, self.disabled, 1.0)
    // The handle stands on the value, not on the end of the bar.
    return f
}
// The round slider: a capsule well beside its label, filled with the lit
// value as a capsule of its own.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let o = self.rect_pos
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.071, 0.137, 0.251), self.disabled)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - self.disabled
    // The well stops short of the value, which stands on its own to the
    // right of it.
    let lo = vec2(Finish.snap(o.x + self.label_size, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 34.0, px), Finish.snap(o.y + self.rect_size.y - 2.0, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let well = Finish.sd_pill(p, c, h)
    let warm = max(max(self.focus, self.drag), self.hover * 0.55)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var f = n_frame(well, px, vec4(0.008, 0.012, 0.039, 1.0), vec3(0.118, 0.184, 0.349) + hue * 0.3 * warm, deep, mix(0.9, 1.0, yn), 0.0, 0.0, 0.0)
    let ins = 4.0
    let fh = h.y - ins
    let xv = mix(lo.x + ins + fh, hi.x - ins - fh, self.slide_pos)
    let fill = Finish.sd_pill(p, vec2((lo.x + ins + xv + fh) * 0.5, c.y), vec2((xv + fh - lo.x - ins) * 0.5, fh))
    let fa = Finish.cover(fill, px)
    let top = Finish.band(fill, 0.0, px, px) * step(p.y, c.y)
    f = Finish.over(f, vec4(vec3(0.004, 0.518, 0.698) * n_halo(fill, 0.3 * live, 0.0), 0.0))
    f = mix(f, vec4(mix(hue * 0.6, mix(hue, vec3(1.0, 1.0, 1.0), 0.6), top), 1.0), fa)
    return n_lamp(f, p, vec2(xv, c.y), 2.0 * max(self.hover, self.drag), px, vec3(1.0, 1.0, 1.0), deep, max(self.hover, self.drag) * live)
}

// FADERS. The same slot stood on end, engraved ticks either side, and a
// dark cap with three grip lines, the middle one lit in the hue.
mod.widgets.SliderFader.cap_size = 10.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(3.0, 3.0), self.rect_size + vec2(6.0, 6.0))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(6.0, 6.0)) - vec2(3.0, 3.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    // Track space: a runs from the value's zero, b across.
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.071, 0.137, 0.251), self.disabled)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - self.disabled
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(across * 0.5, px)
    let slot = Finish.sd_pill(p, vec2(along * 0.5, mid), vec2(along * 0.5 - self.inset_px + 2.5, 2.5))
    var f = n_slot(slot, px)
    // Engraved ticks: a dark pixel over a light one, long at the ends and
    // the middle, short between.
    let tq = (p.x - foot) / travel * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * travel / 10.0
    let major = step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti)
    let tl = mix(3.0, 6.0, min(major, 1.0))
    let tb = abs(abs(p.y - mid) - 5.5 - tl * 0.5) - tl * 0.5
    let inside = step(-0.5, ti) * step(ti, 10.5)
    let groove = Finish.cover(tb, px) * Finish.cover(tx - px * 0.5, px) * inside
    let lip = Finish.cover(tb, px) * Finish.cover(abs(tx - px) - px * 0.5, px) * inside
    f = Finish.over(f, vec4(0.0, 0.0, 0.0, 0.8 * groove))
    f = Finish.over(f, vec4(0.07, 0.08, 0.12, 1.0) * lip * 0.7)
    let a = foot + self.fill_lo * travel
    let b = foot + self.fill_hi * travel
    f = n_stroke(f, n_seg(p, vec2(a, mid), vec2(b, mid)), 1.0, px, hue, deep, 1.0, 0.0, 0.3 * live)
    // The cap.
    let at = foot + self.slide_pos * travel
    let cap = Material.sd_box(p, vec2(at, mid), vec2(self.cap_px * 0.5, 9.0), 2.0)
    let yn = clamp((p.x - at + self.cap_px * 0.5) / self.cap_px, 0.0, 1.0)
    var cc = mix(vec3(0.071, 0.098, 0.204), vec3(0.047, 0.063, 0.129), yn)
    let gl = abs(abs(p.x - at) - 2.0)
    cc = mix(cc, cc * 0.5, Finish.cover(gl - px * 0.5, px) * step(1.0, abs(p.x - at)))
    cc = mix(cc, cc + vec3(0.06, 0.06, 0.07), Finish.cover(abs(abs(p.x - at) - 2.0 - px) - px * 0.5, px))
    let centre = Finish.cover(abs(p.x - at) - px * 0.75, px) * step(abs(p.y - mid), 7.5)
    cc = mix(cc, hue * mix(0.6, 1.0, max(self.hover, self.drag)), centre)
    cc = mix(cc, vec3(0.16, 0.20, 0.30), Finish.band(cap, 0.0, px, px) * step(p.x, at))
    cc = mix(cc, vec3(0.02, 0.025, 0.05), Finish.band(cap, 0.0, px, px) * step(at, p.x))
    let ca = Finish.cover(cap, px)
    return Finish.over(f, vec4(cc * ca, ca))
}

// ROTARIES. A dark knob with a thin value arc outside its body: only the
// part up to the value is drawn, the rest is a faint rail; the pointer is
// a lamp dot in the body.
let n_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let hue = mix(vec3(0.18, 0.855, 1.0), vec3(0.071, 0.137, 0.251), disabled)
    let deep = vec3(0.004, 0.518, 0.698)
    let live = 1.0 - disabled
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let q = p - c
    let ra = rad - 1.5
    let rail = n_arc(q, ra, a0, a0 + span)
    var f = vec4(vec3(0.118, 0.184, 0.349) * 0.55, 0.55) * Finish.cover(rail - px * 0.5, px)
    let touch = max(max(hover, drag), focus)
    f = n_stroke(f, n_arc(q, ra, s0, s1), 0.67, px, hue * mix(0.85, 1.0, touch), deep, 1.0, 0.0, 0.3 * live)
    // The travel ends: two short ticks.
    let e0 = vec2(0.0 - sin(a0), cos(a0))
    let e1 = vec2(0.0 - sin(a0 + span), cos(a0 + span))
    let t0 = n_seg(q, e0 * (ra + 2.0), e0 * (ra + 3.5))
    let t1 = n_seg(q, e1 * (ra + 2.0), e1 * (ra + 3.5))
    f = mix(f, vec4(vec3(0.49, 0.54, 0.65), 1.0), Finish.cover(min(t0, t1) - px * 0.5, px) * 0.8)
    let br = rad * 0.72
    let k = Finish.over(f, n_body(p, c, br, px, live))
    let dir = vec2(0.0 - sin(av), cos(av))
    return n_lamp(k, p, c + dir * br * 0.7, clamp(br * 0.12, 1.0, 1.5), px, hue, deep, live * mix(0.8, 1.0, touch))
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 22.0 + dia * 0.5, px)) - self.rect_pos
    return n_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px)) - self.rect_pos
    return n_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A navy-black well in a magenta tube: the second voice is the
// voice of input. Focus lights the lower edge fully and heats its middle.
// A field whose frame is switched off (the value inside a slider) draws
// nothing.
let n_field = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / max(hi.x - lo.x, 1.0), 0.0, 1.0)
    let hue = mix(vec3(1.0, 0.337, 0.788), vec3(0.071, 0.137, 0.251), disabled)
    let deep = vec3(0.871, 0.0, 0.404)
    let live = 1.0 - disabled
    let on = max(focus, down)
    let lower = step(0.5, yn)
    let lit = mix(mix(0.55, 0.8, max(on, hover * 0.8)), 1.0, on * lower) * mix(0.85, 1.0, yn)
    // The well: a pixel of shadow under its top edge.
    var well = vec3(0.012, 0.02, 0.059)
    well = mix(well, well * 0.5, Finish.band(p.y - lo.y - 3.0 * px, 0.0, px, px) * step(0.0, 0.0 - d))
    let spot = 1.0 + 0.3 * on * lower * (1.0 - smoothstep(0.1, 0.3, abs(xn - 0.5)))
    let tight = (0.25 * hover + 0.5 * on) * spot * live
    return n_frame(d, px, vec4(mix(well, vec3(0.024, 0.039, 0.114), disabled), 1.0), hue, deep, mix(lit, 1.0, disabled), live, tight, 0.0)
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
