use mod.prelude.widgets_internal.*

// Tubes of light on a near-black indigo ground.
// A control is dark glass with a two pixel tube on its edge: a hue
// shoulder outside, a white-hot core inside it, and one pixel darker than
// the face under both. At rest the tube burns at 55 % and throws no light;
// hover warms it, a press, a focus or an ON state lights it fully and
// gives it a tight glow that is gone within two points. The primary button
// is the one light allowed a wide, faint bloom.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 4.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 3.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #060a1d

// Light leaves the layout box: plain views stop clipping so a glow can
// fall into the gap beside a control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// THE LIGHT. Every function takes distances in points, negative inside.

// Tight glow (sigma 0.7 pt) and the hero's wide bloom (sigma 3.4 pt), x
// points out from the lit edge.
let n_halo = fn(x: float, tight: float, wide: float) -> float {
    let t = max(x, 0.0)
    return tight * exp(-1.02 * t * t) + wide * exp(-0.0433 * t * t)
}

// A lit frame on the edge of the shape d: the hue shoulder on the outer
// device pixel, the white-hot core on the next, a pixel darker than the
// face inside them, the face lit from its rim, and the glow outside. `face`
// is premultiplied; `tube` is the tube's intensity, `core` how much core
// it has. Returns premultiplied.
let n_frame = fn(d: float, px: float, face: vec4, hue: vec3, deep: vec3, tube: float, core: float, tight: float, wide: float) -> vec4 {
    let inside = Finish.cover(d, px)
    let xi = max(-d - 3.0 * px, 0.0)
    let sep = Finish.band(d, 2.0 * px, 3.0 * px, px)
    let lin = deep * n_halo(xi, tight * 0.8, wide * 0.6) * face.a * (1.0 - sep)
    var o = vec4(face.rgb * (1.0 - 0.45 * sep) + lin, face.a)
    let sh = Finish.band(d, 0.0, px, px) * min(tube * 4.0, 1.0)
    o = mix(o, vec4(hue * tube, 1.0), sh)
    // The core: hue a quarter to white at rest, 65 % to white when on.
    let cr = Finish.band(d, px, 2.0 * px, px) * core
    let hot = mix(0.25, 0.65, clamp((tube - 0.55) * 2.2, 0.0, 1.0))
    o = mix(o, vec4(mix(hue * min(tube * 1.65, 1.0), vec3(1.0, 1.0, 1.0), hot), 1.0), cr)
    let g = n_halo(d, tight, wide) * (1.0 - inside)
    return o * inside + vec4(deep * g, g * 0.25)
}

// Distance to a segment.
let n_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    return length(pa - ba * t)
}

// A lit stroke of distance s (to its centre line) and half width w: plain
// hue body, white-hot centre when `hot`, tight glow. Laid over `under`.
let n_stroke = fn(under: vec4, s: float, w: float, px: float, hue: vec3, deep: vec3, lit: float, hot: float, tight: float) -> vec4 {
    let body = Finish.cover(s - w, px) * lit
    let core = Finish.cover(s - w * 0.4, px) * hot * lit
    var o = Finish.over(under, vec4(deep * n_halo(s - w, tight * lit, 0.0), 0.0))
    o = mix(o, vec4(hue, 1.0), body)
    return mix(o, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.7), 1.0), core)
}

// Rounded box with a corner per quadrant: (tl, tr, br, bl).
let n_box = fn(p: vec2, c: vec2, h: vec2, rr: vec4) -> float {
    let q = p - c
    var r = rr.x
    if q.x > 0.0 {
        r = rr.y
        if q.y > 0.0 {
            r = rr.z
        }
    } else {
        if q.y > 0.0 {
            r = rr.w
        }
    }
    return Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
}

// The wait spinner a replaced face draws itself: a comet turning once a
// second on a ring where the label was, laid over the face.
let n_wait = fn(under: vec4, p: vec2, size: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = size * 0.5
    let r = max(min(size.x, size.y) * 0.5 - 6.0, 3.0)
    let q = p - c
    let ring = abs(length(q) - r)
    let a = fract(atan2(q.y, q.x) / 6.2831853 - t)
    let head = a * a
    let body = Finish.cover(ring - 0.75, px) * head * loading
    var o = Finish.over(under, vec4(vec3(0.004, 0.518, 0.698) * n_halo(ring - 0.75, 0.5 * head * loading, 0.0), 0.0))
    o = mix(o, vec4(0.72, 0.98, 1.0, 1.0), body)
    return o
}

// One button: the box snapped to device pixels, dark glass bottom-lit,
// the frame at its state's intensity, the hue washed over the face while
// held or on. `flood` lights a filled button, `tube` shows the frame at
// rest (0 on a flatter face), `body` shows the glass (0 on an outline),
// `hero` gives the wide bloom. Premultiplied.
let n_button = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, hue: vec3, deep: vec3, hover: float, down: float, focus: float, disabled: float, flood: float, tube: float, body: float, hero: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = n_box(p, c, (hi - lo) * 0.5, rr)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let xn = clamp((p.x - lo.x) / max(hi.x - lo.x, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    // Only a press, a focus or the hero light the tube; a flooded face
    // (secondary, danger) keeps the resting tube and throws no light.
    let on = max(max(down, focus), hero)
    let warm = max(on, hover * 0.55)
    // Rest 55 %, hover 80 %, on 100 %; the lower edge runs hotter.
    let lit = mix(0.55, 1.0, warm) * mix(0.8, 1.0, yn)
    let shown = max(tube, max(hover, on))
    let wash = (0.06 * hover * max(body, 0.5) + down * mix(0.20, 0.28, yn) + flood * mix(0.16, 0.28, yn)) * live
    let glass = mix(vec3(0.024, 0.043, 0.118), vec3(0.043, 0.086, 0.204), yn)
    let fa = max(body * live, min(wash * 4.0, 1.0))
    var face = vec4(mix(glass * fa, hue, wash), fa)
    face = mix(face, vec4(0.024, 0.039, 0.114, 1.0) * body, disabled)
    // Focus heats the middle of the lower edge.
    let spot = 1.0 + 0.3 * focus * step(0.5, yn) * (1.0 - smoothstep(0.1, 0.3, abs(xn - 0.5)))
    let tight = (0.3 * hover + 0.5 * on) * spot * live * shown
    let wide = hero * (0.07 + 0.04 * hover) * live
    let h2 = mix(hue, vec3(0.071, 0.137, 0.251), disabled)
    let t2 = mix(lit * shown, 1.0, disabled)
    return n_frame(d, px, face, h2, deep, t2, live * shown, tight, wide)
}

// The hues and their deeper glow pairs.
// cyan #2edaff / #0184b2, magenta #ff56c9 / #de0067, blue #3d63ff / #0d30d4,
// red-pink #f5006f / #720f3d.

// ---------------------------------------------------------------------------
// BUTTONS. The glow falls outside the box: the quad grows by `glow_room`
// and the button stops clipping so the light can reach the gap.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.icon_walk = Walk{width: 14.0, height: Fit}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonFlat.draw_bg.border_radius = 4.0
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(3.0)
mod.widgets.ButtonFlat.draw_bg.corners = fn() -> vec4 {
    let r = self.border_radius
    return vec4(
        mix(r, self.border_radius_tl, step(0.0, self.border_radius_tl)),
        mix(r, self.border_radius_tr, step(0.0, self.border_radius_tr)),
        mix(r, self.border_radius_br, step(0.0, self.border_radius_br)),
        mix(r, self.border_radius_bl, step(0.0, self.border_radius_bl))
    )
}
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The flat button: no glass, the frame a quiet rail until the pointer comes.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_button(p, self.rect_pos, self.rect_size, px, self.corners(), vec3(0.18, 0.855, 1.0), vec3(0.004, 0.518, 0.698), self.hover, self.down, self.focus, self.disabled, 0.0, 0.6, 0.0, 0.0)
    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The standard button: dark glass, the resting tube.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_button(p, self.rect_pos, self.rect_size, px, self.corners(), vec3(0.18, 0.855, 1.0), vec3(0.004, 0.518, 0.698), self.hover, self.down, self.focus, self.disabled, 0.0, 1.0, 1.0, 0.0)
    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonXs.draw_bg.pixel = mod.widgets.Button.draw_bg.pixel
mod.widgets.ButtonSm.draw_bg.pixel = mod.widgets.Button.draw_bg.pixel
mod.widgets.ButtonLg.draw_bg.pixel = mod.widgets.Button.draw_bg.pixel
mod.widgets.ButtonXl.draw_bg.pixel = mod.widgets.Button.draw_bg.pixel
mod.widgets.ButtonCompound.draw_bg.pixel = mod.widgets.Button.draw_bg.pixel
// The one hero: cyan flooded into the glass, the tube fully lit, and the
// only wide bloom on the page.
mod.widgets.ButtonPrimary.draw_bg.glow_room = uniform(9.0)
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_button(p, self.rect_pos, self.rect_size, px, self.corners(), vec3(0.18, 0.855, 1.0), vec3(0.004, 0.518, 0.698), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, 1.0)
    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The second voice: magenta, lit but without the bloom.
mod.widgets.ButtonSecondary.draw_bg.glow_room = uniform(3.0)
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = n_button(p, self.rect_pos, self.rect_size, px, self.corners(), vec3(1.0, 0.337, 0.788), vec3(0.871, 0.0, 0.404), self.hover, self.down, self.focus, self.disabled, 0.4, 1.0, 1.0, 0.0)
    return n_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Tonal: the accent's cyan at the resting 55 %, no flood; it differs from
