mod.theme = mod.themes.dark

// Steampunk brass. Controls are fittings: bevelled brass frames round
// smoked faces, knurled brass caps, gauge faces, riveted iron plates, a
// parchment list. What is chosen or on is lit a pale steel blue; the
// instruments glow amber. Every state of a family is spelled out, because
// the base derived its states once, from its own colours.

// The ground: brushed dark brown-grey metal.
mod.theme.color_bg_app = #3b342b
mod.theme.color_fg_app = #3a332a
mod.theme.color_bg_container = #3a332a
mod.theme.color_surface_container_lowest = #241f1a

// Raised faces: smoked glass in a frame, lighter over its upper third.
mod.theme.color_outset = #3d3a35
mod.theme.color_outset_1 = #4a4640
mod.theme.color_outset_2 = #1d1c1a
mod.theme.color_outset_hover = #45413b
mod.theme.color_outset_1_hover = #524d46
mod.theme.color_outset_2_hover = #23211f
mod.theme.color_outset_down = #1c1a18
mod.theme.color_outset_1_down = #1c1a18
mod.theme.color_outset_2_down = #1c1a18
mod.theme.color_outset_focus = #3d3a35
mod.theme.color_outset_1_focus = #4a4640
mod.theme.color_outset_2_focus = #1d1c1a
mod.theme.color_outset_active = #3d3a35
mod.theme.color_outset_1_active = #4a4640
mod.theme.color_outset_2_active = #1d1c1a
mod.theme.color_outset_disabled = #34302b
mod.theme.color_outset_1_disabled = #34302b
mod.theme.color_outset_2_disabled = #34302b

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #1c1b17
mod.theme.color_inset_1 = #1c1b17
mod.theme.color_inset_2 = #1c1b17
mod.theme.color_inset_hover = #211f1b
mod.theme.color_inset_1_hover = #211f1b
mod.theme.color_inset_2_hover = #211f1b
mod.theme.color_inset_focus = #1f1d19
mod.theme.color_inset_1_focus = #1f1d19
mod.theme.color_inset_2_focus = #1f1d19
mod.theme.color_inset_active = #1c1b17
mod.theme.color_inset_1_active = #1c1b17
mod.theme.color_inset_2_active = #1c1b17
mod.theme.color_inset_down = #171613
mod.theme.color_inset_1_down = #171613
mod.theme.color_inset_2_down = #171613
mod.theme.color_inset_drag = #171613
mod.theme.color_inset_1_drag = #171613
mod.theme.color_inset_2_drag = #171613
mod.theme.color_inset_empty = #1c1b17
mod.theme.color_inset_1_empty = #1c1b17
mod.theme.color_inset_2_empty = #1c1b17
mod.theme.color_inset_disabled = #2a2620
mod.theme.color_inset_1_disabled = #2a2620
mod.theme.color_inset_2_disabled = #2a2620

// The edge a stock face still draws: brass.
mod.theme.color_bevel = #9c8152
mod.theme.color_bevel_hover = #b89c62
mod.theme.color_bevel_focus = #x7fb6e8
mod.theme.color_bevel_down = #5c4726
mod.theme.color_bevel_active = #9c8152
mod.theme.color_bevel_empty = #9c8152
mod.theme.color_bevel_disabled = #5a4c36
mod.theme.color_bevel_inset_1 = #120d06
mod.theme.color_bevel_inset_2 = #5c4726
mod.theme.color_bevel_outset_1 = #c4a867
mod.theme.color_bevel_outset_2 = #x2e2212
mod.theme.beveling = 0.5

// Ink: a warm cream, never white; a dimmer tan for idle marks.
mod.theme.color_text = #xe6ddc8
mod.theme.color_text_hover = #xf4ebd8
mod.theme.color_text_focus = #xe6ddc8
mod.theme.color_text_active = #xe6ddc8
mod.theme.color_text_down = #c9bda4
mod.theme.color_text_disabled = #7a7060
mod.theme.color_text_placeholder = #8a806d
mod.theme.color_text_placeholder_hover = #998f7b
mod.theme.color_text_val = #d2c4a6
mod.theme.color_text_meta = #b4a88f
mod.theme.color_text_cursor = #x7fb6e8
mod.theme.color_cursor = #x7fb6e8
mod.theme.color_label = #xe3d8c2
mod.theme.color_label_hover = #xf4ebd8
mod.theme.color_label_focus = #xe3d8c2
mod.theme.color_label_active = #xe3d8c2
mod.theme.color_label_down = #c9bda4
mod.theme.color_label_disabled = #7a7060
mod.theme.color_label_inner = #xe3d8c2
mod.theme.color_label_inner_hover = #xf4ebd8
mod.theme.color_label_inner_focus = #xe3d8c2
mod.theme.color_label_inner_active = #xe3d8c2
mod.theme.color_label_inner_down = #c9bda4
mod.theme.color_label_inner_disabled = #7a7060
mod.theme.color_label_outer = #xe3d8c2
mod.theme.color_label_outer_hover = #xf4ebd8
mod.theme.color_label_outer_focus = #xe3d8c2
mod.theme.color_label_outer_active = #xe3d8c2
mod.theme.color_label_outer_down = #c9bda4
mod.theme.color_label_outer_disabled = #7a7060
mod.theme.color_icon = #xe3d8c2
mod.theme.color_icon_hover = #xf4ebd8
mod.theme.color_icon_focus = #xe3d8c2
mod.theme.color_icon_active = #xe3d8c2
mod.theme.color_icon_down = #c9bda4
mod.theme.color_icon_disabled = #7a7060

// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`. A pale steel blue for what is chosen or on.
mod.theme.color_ctrl_selected = #x7fb6e8
mod.theme.color_focus = #x7fb6e8
mod.theme.color_ctrl_active = #x7fb6e8
mod.theme.color_val = #c9a860
mod.theme.color_selection_focus = #x7fb6e850
mod.theme.color_bg_highlight_inline = #x7fb6e840

mod.theme.color_terminal_bg = #1c1b17
mod.theme.color_terminal_text = #xe6ddc8

// The instruments: amber digits in a dark well, dark amber lamp glass.
mod.theme.color_screen = #17130f
mod.theme.color_screen_ink = #f0a848
mod.theme.screen_ghost = 0.10
mod.theme.color_lamp_off = #2a1a12
mod.theme.lamp_halo = 0.25

// The surface ladder in warm iron, so every widget built on the roles
// stays in the family, with ink that reads on the brightest rung.
mod.theme.color_surface = #3b342b
mod.theme.color_surface_dim = #2f2922
mod.theme.color_surface_bright = #4f473c
mod.theme.color_surface_container_low = #3a332a
mod.theme.color_surface_container = #x3f382e
mod.theme.color_surface_container_high = #443c32
mod.theme.color_surface_container_highest = #4a4136
mod.theme.color_on_surface = #xe9dfcb
mod.theme.color_on_surface_variant = #bdb096
mod.theme.color_outline = #9c8f78
mod.theme.color_outline_variant = #4f473c
mod.theme.color_inverse_surface = #xe9dfcb
mod.theme.color_inverse_on_surface = #3b342b

// A 28 point control row, 6 point gaps inside a group, true radii of
// 2 points on controls and 3 on plates.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.space_4 = 12.0
mod.theme.space_5 = 18.0
mod.theme.space_6 = 24.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 3.0 bottom: 0.0 left: 3.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 3.0 right: 0.0 bottom: 3.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 6.0 right: 6.0 bottom: 6.0 left: 6.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 6.0 bottom: 0.0 left: 6.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 6.0 right: 0.0 bottom: 6.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 9.0 right: 9.0 bottom: 9.0 left: 9.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 9.0 bottom: 0.0 left: 9.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 9.0 right: 0.0 bottom: 9.0 left: 0.0}
// The rungs the base froze at its own space factor, restated at ours.
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 28.0
mod.theme.size_control_l = 32.0
mod.theme.tab_height = 28.0
mod.theme.tab_flat_height = 26.0
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 3.0
mod.theme.textselection_corner_radius = 1.0
mod.theme.radius_xs = 1.5
mod.theme.radius_s = 2.0
mod.theme.radius_m = 3.0
mod.theme.radius_l = 4.0

// The base family at the sizes of a 28 point row: a font size draws 1.333
// layout points per unit, so 8.25 is an 11 point legend.
mod.theme.font_size_base = 8.25
mod.theme.font_size_p = 8.25
mod.theme.font_size_code = 8.25
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.25}
mod.theme.font_label = mod.theme.font_label{font_size: 8.25}
mod.theme.font_bold = mod.theme.font_bold{font_size: 8.25}
mod.theme.font_italic = mod.theme.font_italic{font_size: 8.25}
mod.theme.font_bold_italic = mod.theme.font_bold_italic{font_size: 8.25}
mod.theme.font_code = mod.theme.font_code{font_size: 8.25}
mod.theme.type_title_l_size = 12.0
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_s_size = 9.0
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.0 line_spacing: 1.2}
mod.theme.type_body_l_size = 9.0
mod.theme.type_body_m_size = 8.25
mod.theme.type_body_s_size = 7.5
mod.theme.type_label_l_size = 8.25
mod.theme.type_label_m_size = 7.5
mod.theme.type_label_s_size = 6.75
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.25 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 7.5 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.25 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 6.75 line_spacing: 1.2}
true
