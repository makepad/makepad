use mod.prelude.widgets_internal.*

// Steampunk brass. Raised controls are smoked faces set in bevelled brass
// frames; caps, knobs and thumbs are brass (knurled, spun, geared); wells
// are cut into dark iron with rivets along their frames; plates are riveted
// iron; the dial is a pressure gauge; the list is parchment. What is chosen
// or on is lit a pale steel blue; the instruments glow amber. Every rim is
// one device pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 28.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #3b342b

// Plain views stop clipping, so a part's shadow may fall into the gap
// beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let bz_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// Its outward direction, by central differences.
let bz_grad = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let e = 0.35
    let gx = bz_rbox(p + vec2(e, 0.0), c, h, r) - bz_rbox(p - vec2(e, 0.0), c, h, r)
    let gy = bz_rbox(p + vec2(0.0, e), c, h, r) - bz_rbox(p - vec2(0.0, e), c, h, r)
    return normalize(vec2(gx, gy) + vec2(0.00001, 0.00002))
}

// A segment's distance.
let bz_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroked chevron's distance: `w` wide, `hgt` tall, pointing down
// (`flip` 1 points up).
let bz_chevron = fn(p: vec2, c: vec2, w: float, hgt: float, flip: float) -> float {
    let s = mix(1.0, -1.0, flip)
    let a = c + vec2(-w * 0.5, -hgt * 0.5 * s)
    let b = c + vec2(0.0, hgt * 0.5 * s)
    let e = c + vec2(w * 0.5, -hgt * 0.5 * s)
    return min(bz_seg(p, a, b), bz_seg(p, b, e))
}

// A disc laid on the pixel grid: a whole number of device pixels across.
// `c` is quad-local; returns (centre.x, centre.y, radius).
let bz_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// Signed grain, -amount..amount, one value per device pixel (pass `p / px`),
// two hashes displaced by a first so no lattice repeats.
let bz_grain = fn(q: vec2, amount: float) -> float {
    let i = floor(q)
    let h = Finish.hash(i)
    let a = Finish.hash(i + vec2(h * 397.13, h * 211.71))
    let b = Finish.hash(vec2(i.y * 0.7548 + h * 157.3, i.x * 1.1698 + h * 89.9))
    return (a + b - 1.0) * amount
}

// Six-stop ramp over 0..1.
let bz_ramp = fn(x0: float, k0: vec3, k1: vec3, k2: vec3, k3: vec3, k4: vec3, k5: vec3) -> vec3 {
    let x = clamp(x0, 0.0, 1.0)
    var col = mix(k0, k1, clamp(x / 0.2, 0.0, 1.0))
    col = mix(col, k2, clamp((x - 0.2) / 0.2, 0.0, 1.0))
    col = mix(col, k3, clamp((x - 0.4) / 0.2, 0.0, 1.0))
    col = mix(col, k4, clamp((x - 0.6) / 0.2, 0.0, 1.0))
    return mix(col, k5, clamp((x - 0.8) / 0.2, 0.0, 1.0))
}

// The metals by light 0..1, measured on the picture: brass (#4a371b deep,
// #8a6e40 shade, #c4a867 body, #ecd89c highlight), copper, and warm iron.
let bz_brass = fn(l: float) -> vec3 {
    return bz_ramp(l, vec3(0.086, 0.059, 0.024), vec3(0.290, 0.216, 0.106), vec3(0.525, 0.420, 0.255), vec3(0.722, 0.612, 0.392), vec3(0.886, 0.808, 0.600), vec3(0.984, 0.945, 0.812))
}
let bz_copper = fn(l: float) -> vec3 {
    return bz_ramp(l, vec3(0.082, 0.039, 0.020), vec3(0.278, 0.176, 0.118), vec3(0.478, 0.290, 0.188), vec3(0.659, 0.459, 0.337), vec3(0.816, 0.643, 0.533), vec3(0.957, 0.847, 0.753))
}
let bz_iron = fn(l: float) -> vec3 {
    return bz_ramp(l, vec3(0.055, 0.051, 0.043), vec3(0.180, 0.169, 0.153), vec3(0.231, 0.220, 0.204), vec3(0.306, 0.294, 0.275), vec3(0.439, 0.424, 0.396), vec3(0.659, 0.643, 0.612))
}
// 0 brass, 1 copper, 2 iron.
let bz_metal = fn(l: float, metal: float) -> vec3 {
    let b = bz_brass(l)
    let k = bz_copper(l)
    let i = bz_iron(l)
    return mix(mix(b, k, step(0.5, metal)), i, step(1.5, metal))
}

// The light on a bevelled frame `fw` wide: a rounded bead whose outer half
// faces out and inner half faces in, lit from the top left, with a ridge
// highlight on the lit runs. `g` is the outward direction.
let bz_frame_l = fn(d: float, g: vec2, fw: float) -> float {
    let t = clamp(-d / max(fw, 0.001), 0.0, 1.0)
    let facing = dot(g, vec2(-0.24, -0.97))
    let slope = 1.0 - 2.0 * t
    var l = 0.50 + 0.30 * facing * slope + 0.13 * facing
    let s = (t - 0.34) / 0.2
    l = l + 0.24 * max(facing, 0.0) * exp(-s * s)
    return l
}

// A domed rivet with its shadow on the plate, premultiplied.
let bz_rivet = fn(p: vec2, c: vec2, rad: float, px: float, metal: float, lift: float) -> vec4 {
    let q = p - c
    let r = length(q)
    let d = r - rad
    let sd = length(q - vec2(rad * 0.35, rad * 0.55)) - rad
    let sh = (1.0 - smoothstep(-rad * 0.3, rad * 0.8, sd)) * 0.5
    var out = vec4(0.0, 0.0, 0.0, sh)
    let n = q / max(rad, 0.001)
    var l = 0.46 - 0.26 * n.y - 0.10 * n.x + lift
    let hq = q - vec2(-0.30, -0.38) * rad
    l = l + 0.42 * exp(-dot(hq, hq) / max(rad * rad * 0.12, 0.0001))
    l = l * mix(1.0, 0.6, smoothstep(0.6, 1.0, r / max(rad, 0.001)))
    let col = bz_metal(l, metal)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(col * a, a))
}

// The accent: a pale steel blue, its hot core and its deep glass.
let bz_acc = fn() -> vec3 {
    return vec3(0.498, 0.714, 0.910)
}
let bz_acc_hot = fn() -> vec3 {
    return vec3(0.843, 0.925, 1.0)
}
let bz_acc_deep = fn() -> vec3 {
    return vec3(0.200, 0.345, 0.522)
}
// The instrument light: amber.
let bz_amber = fn() -> vec3 {
    return vec3(0.941, 0.659, 0.282)
}
let bz_shadow_ink = fn() -> vec3 {
    return vec3(0.039, 0.027, 0.016)
}
let bz_edge = fn() -> vec3 {
    return vec3(0.055, 0.035, 0.016)
}

// The smoked face of a framed control by height t 0..1: #58544d under the
// frame, #3e3b36 over the upper third, then the dark glass of its lower
// half, #191817 at the foot.
let bz_smoke = fn(t: float) -> vec3 {
    let a = vec3(0.380, 0.361, 0.333)
    let b = vec3(0.286, 0.271, 0.251)
    let c = vec3(0.137, 0.133, 0.125)
    let e = vec3(0.098, 0.094, 0.090)
    var col = mix(a, b, smoothstep(0.0, 0.28, t))
    col = mix(col, c, smoothstep(0.36, 0.58, t))
    return mix(col, e, smoothstep(0.6, 1.0, t))
}

// Focus: one device pixel of the accent, two device pixels out.
let bz_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * 0.8 * focus
    let k = bz_acc()
    return vec4(k * f, f)
}

// A well cut into iron: the fill, the plate's shadow falling in from the
// top wall, a dark mouth darkest on top.
let bz_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, depth: float) -> vec3 {
    let d = bz_rbox(p, c, h, r)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, depth * 0.5), max(depth * 0.4, px * 0.6))
    var col = mix(fill, vec3(0.031, 0.024, 0.016), clamp(sh, 0.0, 1.0) * 0.85)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, vec3(0.031, 0.024, 0.016), Finish.band(d, 0.0, px, px) * mix(0.5, 0.95, up))
    return col
}

// The lip under a well's lower rim, outside it: premultiplied warm white.
let bz_lip = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, a: float) -> vec4 {
    let d = bz_rbox(p, c, h, r)
    let foot = smoothstep(c.y + h.y - max(r, 1.0) - 1.5, c.y + h.y, p.y)
    let l = Finish.ring_out(d, 0.0, px, px) * foot * a
    return vec4(l, l * 0.95, l * 0.85, l)
}

// A lamp bead of glass: lit with a white-hot centre and a tight halo, or
// unlit at a fifth of its light.
let bz_bead = fn(p: vec2, c: vec2, rad: float, px: float, ink: vec3, lit: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    let a = Finish.cover(d, px)
    let rr = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(mix(ink, vec3(1.0, 1.0, 1.0), 0.65), ink * 0.85, smoothstep(0.0, 1.0, rr))
    let off = mix(ink * 0.26, ink * 0.12, rr) + g3(0.02)
    var col = mix(off, on, lit)
    // a glint on the glass
    let gq = q - vec2(-0.35, -0.4) * rad
    col = col + g3(0.25 * exp(-dot(gq, gq) / max(rad * rad * 0.06, 0.0001)))
    var out = vec4(col * a, a)
    let ha = 0.28 * lit * exp(-max(d - px, 0.0) / (0.8 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(out, vec4(ink * ha, ha))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing:
// 0 flat smoked plate, 1 smoked face in a brass frame, 2 a polished brass
// plate in a bronze frame (primary), 3 as 1 (secondary, brass legend),
// 4 smoked face in a copper frame (danger), 5 the brass frame alone,
// 6 bare until touched, 7 an aged bronze plate (tertiary), 8 smoked face in
// an iron frame (drop-down), 9 a brass cap in a thin bronze frame (segments).
// The quad is grown by `m` on every side for the shadow and the focus ring.
let bz_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live * (1.0 - press)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = bz_rbox(p, c, h, r)
    let isflat = 1.0 - step(0.5, kind)
    let outl = step(4.5, kind) * step(kind, 5.5)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let pad = step(6.5, kind) * step(kind, 7.5)
    let plate = step(1.5, kind) * step(kind, 2.5) + step(8.5, kind)
    let metal = step(3.5, kind) * step(kind, 4.5) + 2.0 * step(7.5, kind) * step(kind, 8.5)
    let framed = 1.0 - isflat - bare - pad
    let thin = step(7.5, kind)
    let fw = mix(7.0 * px, 4.0 * px, thin) * framed
    let solid = 1.0 - bare - outl

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = bz_shadow_ink()
    // the soft layer, faded within the gap to the next row
    let soft = Finish.drop(p, c, h, r, vec2(0.5, 2.5), 2.6) * 0.45 * solid * (1.0 - press) * live * (1.0 - 0.5 * isflat)
    out = Finish.over(out, vec4(ink * soft, soft))
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px * 1.2) * 0.65 * mix(1.0, 0.3, press) * mix(1.0, 0.5, disabled) * solid
    out = Finish.over(out, vec4(ink * con, con))

    // the face inside the frame
    let fy0 = lo.y + fw
    let fh = max(2.0 * h.y - 2.0 * fw, 1.0)
    let t = clamp((p.y - fy0) / fh, 0.0, 1.0)
    let yi = p.y - fy0
    let q = p + o
    let br = (Finish.brushed(q, vec2(1.0, 0.0), px * 1.3) - 0.5) * 0.06
    var face = bz_smoke(t)
    if plate > 0.5 {
        face = bz_brass(mix(mix(0.80, 0.74, thin), mix(0.56, 0.50, thin), t) + br + 0.07 * hov - 0.20 * press)
    }
    if pad > 0.5 {
        face = bz_brass(mix(0.34, 0.20, t) + br * 0.6 + 0.04 * hov - 0.08 * press)
    }
    face = face + g3(0.05 * hov * (1.0 - plate - pad))
    face = face * (1.0 + (Finish.fbm(q * 0.09) - 0.5) * 0.10 * (1.0 - plate - pad))
    // pressed: the smoked face sinks: dark, its gloss gone
    let sunk = mix(vec3(0.063, 0.059, 0.055), vec3(0.110, 0.106, 0.098), smoothstep(0.0, 3.0, yi))
    face = mix(face, sunk, press * (1.0 - plate - pad))
    // the frame's shadow inside the face, deeper while pressed
    let ih = h - vec2(fw, fw)
    let insh = Finish.inset(p, c, ih, max(r - fw * 0.5, 0.5), vec2(0.0, 1.0 + 1.6 * press), 1.0 + 1.2 * press)
    face = mix(face, vec3(0.020, 0.016, 0.012), clamp(insh, 0.0, 1.0) * mix(0.45, 0.8, press) * framed)
    face = mix(face, vec3(0.200, 0.184, 0.161), disabled * 0.85)
    face = face + g3(bz_grain(q / px, 0.012))
    // unframed plates: a lit top line and a dark edge
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    let topw = 1.0 - smoothstep(lo.y + r + 0.5, lo.y + r + 1.5, p.y)
    let unf = isflat + pad
    let hl = mix(vec3(0.459, 0.439, 0.404), bz_brass(0.62), pad)
    face = mix(face, hl, Finish.band(d, px, 2.0 * px, px) * topw * (1.0 - press) * live * unf)
    face = mix(face, bz_edge(), Finish.band(d, 0.0, px, px) * unf * 0.9)

    // the frame: a bevelled bead of metal
    let g = bz_grad(p, c, h, r)
    var fl = bz_frame_l(d, g, max(fw, px)) + 0.08 * hov - 0.05 * press
    fl = fl - 0.16 * step(1.5, kind) * step(kind, 2.5) - 0.12 * thin
    var fcol = bz_metal(fl, metal)
    fcol = mix(fcol, vec3(0.31, 0.28, 0.24), disabled * 0.75)
    let fm = (1.0 - Finish.cover(d + fw, px)) * framed
    // its dark outer line and the dark line where it meets the face
    fcol = mix(fcol, bz_edge(), Finish.band(d, 0.0, px, px) * 0.85)
    let inner = Finish.band(d + fw, -px, 0.0, px) * framed * 0.75
    var col = mix(face, fcol, fm)
    col = mix(col, bz_edge(), inner)

    var fa = 1.0
    if kind > 4.5 && kind < 6.5 {
        fa = mix(0.0, 0.55, hov) + 0.45 * press
    }
    let alpha = Finish.cover(d, px) * mix(fa, 1.0, fm)
    out = Finish.over(out, vec4(col * alpha, alpha))

    // rivets on the long runs of a wide frame
    if framed > 0.5 && size.x > 40.0 && size.y > 23.0 && kind < 7.5 {
        let rr = fw * 0.36
        let ry0 = lo.y + fw * 0.5 + 0.2
        let ry1 = hi.y - fw * 0.5 - 0.2
        let rx0 = lo.x + fw * 0.5 + 0.2
        let rx1 = hi.x - fw * 0.5 - 0.2
        let rx = mix(rx0, rx1, step(c.x, p.x))
        let ry = mix(ry0, ry1, step(c.y, p.y))
        let rv = bz_rivet(p, vec2(rx, ry), rr, px, metal, 0.08 * hov - 0.25 * disabled)
        out = Finish.over(out, rv)
    }

    out = Finish.over(out, bz_focus(d, px, focus * live))

    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rs = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rs, a0, a0 + 1.5 * PI, 1.2)
        let k = bz_acc()
        sdf.fill(vec4(k * loading, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The drop-down face: smoked in an iron frame, an engraved split 22 points
// from its right end and a stroked chevron behind it; `held` is pressed.
let bz_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, disabled: float, m: float) -> vec4 {
    var out = bz_button(pos, size, o, px, hover, held, focus, disabled, 0.0, 0.0, 2.0, 8.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.22, p.y) * step(p.y, size.y * 0.78)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * 0.9
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.5 * (1.0 - held)
    let bz = bz_edge()
    out = Finish.over(out, vec4(bz * div_d, div_d))
    let hl = vec3(0.420, 0.400, 0.369)
    out = Finish.over(out, vec4(hl * div_l, div_l))
    let cc = vec2(size.x - 11.5, Finish.snap(o.y + size.y * 0.5, px) - o.y + held * live * px)
    let ch = Finish.cover(bz_chevron(p, cc, 6.0, 3.5, 0.0) - 0.65, px)
    let ink = mix(mix(vec3(0.890, 0.847, 0.761), vec3(0.957, 0.922, 0.847), hover * live), vec3(0.478, 0.439, 0.376), disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the framed faces grow their quad for the shadow and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return bz_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 2.0, 0.0, 0.0)
}
