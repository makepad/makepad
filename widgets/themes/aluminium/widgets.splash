use mod.prelude.widgets_internal.*

// Turned and brushed aluminium on a pale anodised housing.
// Metal parts stand on the housing with a hard contact line and a faint
// ambient shade, drawn outside their boxes; tracks and wells are cut into
// it, dark at the top edge with a bright lip under the lower rim. Every rim
// is one device pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 4.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 24.
let field_height = 24.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 4.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #cacacc

// Plain views stop clipping, so a part's contact shadow may fall into the
// gap beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let alu_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A disc laid on the pixel grid: a whole number of device pixels across,
// its edge on a pixel boundary, so its one-pixel rings are one pixel.
// `c` is quad-local; returns (centre.x, centre.y, radius).
let alu_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// The housing: a fall of -0.05 from top to bottom of the window, a faint
// lift in the upper third, and one-pixel grain at sd 0.010.
let alu_ground = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let t = clamp(p.y / max(size.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.831, 0.831, 0.839), vec3(0.749, 0.749, 0.757), t)
    let cc = vec2(size.x * 0.5, size.y * 0.3)
    let reach = length(size) * 0.7
    let lift = 1.0 - smoothstep(0.0, reach, length(p - cc))
    col = col + g3(0.03 * lift * lift)
    col = col + g3(Finish.grain(p / px, 0.0245))
    return vec4(col, 1.0)
}

// The brushed face of a raised part, by height t 0..1: bright top, a
// darker waist, lighter again at the foot, with horizontal streaks.
let alu_face = fn(t: float, q: vec2, px: float) -> vec3 {
    let top = vec3(0.925, 0.933, 0.941)
    let mid = vec3(0.847, 0.855, 0.867)
    let foot = vec3(0.788, 0.796, 0.808)
    var col = mix(mix(top, mid, clamp(t * 2.0, 0.0, 1.0)), foot, clamp(t * 2.0 - 1.0, 0.0, 1.0))
    let s = Finish.brushed(q, vec2(1.0, 0.0), px * 1.4) - 0.5
    return col + g3(s * 0.034)
}

// Turned metal: four lobes round the centre, brightest left and right,
// darkest on the diagonals, over concentric lathe rings. `amp` scales the
// lobes (1 a knob, 0.5 a thumb, 0.3 disabled). Returns a luminance.
let alu_conic = fn(q: vec2, px: float, amp: float, turn: float) -> float {
    let r = max(length(q), 0.0001)
    let cs = q.x / r
    let sn = q.y / r
    // A small turn of the lobes, as the light catches a hovered cap.
    let c1 = cs * cos(turn) - sn * sin(turn)
    let s1 = sn * cos(turn) + cs * sin(turn)
    let c2 = c1 * c1 - s1 * s1
    let c4 = 2.0 * c2 * c2 - 1.0
    var l = 0.66 + amp * (0.09 * c2 + 0.12 * c4)
    let rings = Finish.noise(vec2(r / px * 0.75, 0.37)) - 0.5
    let streak = Finish.noise(vec2(cs * 23.0 + 7.1, sn * 23.0 + 3.3)) - 0.5
    l = l + rings * 0.03 + streak * 0.04 * smoothstep(0.0, 2.0, r)
    // the pinprick where the lobes meet
    l = l + 0.05 * (1.0 - smoothstep(0.0, px * 1.2, r))
    return l
}

// A lamp: a lit lens in a chrome socket, never a light source. `ink` the
// lens at its brightest, `lit` 0 dark .. 1 lit, `glow` 0 or the halo's
// strength at one device pixel (held under the family ceiling of 0.30).
let alu_lamp = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, dark: vec3, lit: float, glow: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let v = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    // Brightest just below the middle, darker at top and foot.
    let on = mix(mix(ink * 0.72, ink, smoothstep(0.1, 0.58, v)), ink * 0.45, smoothstep(0.62, 1.0, v))
    let off = mix(dark * 1.25, dark, v)
    var col = mix(off, on, lit)
    // specular crescent at the top inside
    let spec = Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(-0.2, 0.25, q.y / rad))
    col = mix(col, vec3(0.80, 0.88, 0.94), spec * 0.5)
    // dark rim
    col = mix(col, dark * 0.6, Finish.band(d, 0.0, px, px) * 0.9)
    let a = Finish.cover(d, px)
    var out = vec4(col * a, a)
    // socket: a dark hairline above, a bright lip below, outside the lens
    let above = Finish.ring_out(d, 0.0, px, px) * (1.0 - smoothstep(-0.3, 0.3, q.y / rad))
    let below = Finish.ring_out(d, 0.0, px, px) * smoothstep(-0.3, 0.3, q.y / rad)
    out = Finish.over(vec4(0.0, 0.0, 0.0, above * 0.45), out)
    out = Finish.over(vec4(below * 0.85, below * 0.85, below * 0.85, below * 0.85), out)
    // halo: an exponential with a 1 point decay, at the core's hue
    let ha = glow * lit * exp(-max(d - px, 0.0) / 0.8) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing:
// 0 flat plate, 1 chrome-ringed, 2 chrome with a lit blue lamp (primary),
// 3 chrome with a dark lamp, 4 chrome with a lit red lamp (danger),
// 5 engraved outline, 6 bare until hovered.
// The quad is grown by `m` (6 points) on every side for the shade and the
// focus ring.
let alu_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5 + vec2(0.0, press * px)
    let h = (hi - lo) * 0.5
    let d = alu_rbox(p, c, h, r)
    let raised = step(kind, 4.5)
    let bare = step(5.5, kind)
    let ring = step(0.5, kind) * raised

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // The ground round a raised part: lifted above it, shaded below it.
    let rest = (1.0 - press) * raised
    // Both stay over and under the part: the gap beside it stays clear,
    // and both fade out before the edge of the grown quad.
    let beside = 1.0 - smoothstep(-r, 0.5, abs(p.x - c.x) - h.x)
    let reach = clamp((m - (abs(p.y - c.y) - h.y)) / 2.0, 0.0, 1.0)
    let under = smoothstep(-2.0, 2.0, p.y - c.y)
    let lift = Finish.drop(p, c, h, r, vec2(0.0, -1.6), 2.2) * 0.40 * rest * beside * reach * (1.0 - under) * mix(1.0, 0.3, disabled)
    out = Finish.over(out, vec4(lift, lift, lift, lift))
    let amb = Finish.drop(p, c, h, r, vec2(0.0, 2.0), 2.4) * mix(0.16, 0.20, hover) * rest * beside * reach * under * mix(1.0, 0.3, disabled)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, amb))
    let con = Finish.drop(p, c, h, r, vec2(0.0, mix(0.9, 0.35, press)), 0.45) * mix(0.55, 0.4, press) * raised * mix(1.0, 0.3, disabled)
    out = Finish.over(out, vec4(vec3(0.078, 0.071, 0.082) * con, con))
    // An engraved outline sits in the ground: a light lip under its lower rim.
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y, p.y) * step(4.5, kind) * (1.0 - bare) * 0.8
    out = Finish.over(out, vec4(lip, lip, lip, lip))

    // The face.
    let t = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let tt = mix(t, 1.0 - t, press * 0.45)
    var face = alu_face(tt, p + o, px)
    face = Finish.lift(face, 0.2 * hover * live * (1.0 - press) - 0.08 * press)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), disabled)
    var fa = 1.0
    if kind > 4.5 {
        // outline and bare faces are the housing itself until touched
        fa = mix(0.0, 0.55, hover * live) + 0.25 * press
    }
    // chrome band, the inner dark line inside it
    let chrome = Finish.lift(mix(vec3(0.961, 0.965, 0.973), vec3(0.847, 0.851, 0.863), t), 0.15 * hover)
    face = mix(face, vec3(0.212, 0.212, 0.220), Finish.band(d, 3.0 * px, 4.0 * px, px) * 0.3 * ring * mix(1.0, 0.4, disabled))
    let rim_in = mix(4.0, 1.0, 1.0 - ring) * px
    // lit rims on the inside of the face: bright top, quiet bottom
    let top_rim = Finish.band(d, rim_in, rim_in + px, px) * (1.0 - smoothstep(-0.5, 0.5, p.y - c.y)) * 0.85 * (1.0 - press)
    let bot_rim = Finish.band(d, rim_in, rim_in + px, px) * smoothstep(-0.5, 0.5, p.y - c.y) * 0.35
    face = mix(face, vec3(0.988, 0.988, 0.996), (top_rim + bot_rim) * raised * live)
    var edge_a = fa
    if ring > 0.5 {
        let band = Finish.band(d, px, 3.0 * px, px)
        face = mix(face, chrome, band * mix(1.0, 0.4, disabled))
    }
    // the outline, one device pixel
    let ol = Finish.band(d, 0.0, px, px)
    var ol_a = mix(0.85, 0.35, disabled)
    if kind > 4.5 {
        ol_a = mix(0.55, 0.3, disabled) * (1.0 - bare) + hover * live * 0.5 * bare
        edge_a = max(fa, ol * ol_a)
    }
    face = mix(face, vec3(0.247, 0.251, 0.267), ol * ol_a / max(edge_a, 0.001))

    // the lamp of the primary, secondary and danger faces
    if kind > 1.5 && kind < 4.5 {
        let lc = vec2(lo.x + 9.5, c.y)
        let is_red = step(3.5, kind)
        let ink = mix(vec3(0.506, 0.812, 0.992), vec3(0.972, 0.235, 0.239), is_red)
        let dark = mix(vec3(0.173, 0.306, 0.412), vec3(0.353, 0.102, 0.110), is_red)
        let lit = (1.0 - step(2.5, kind) * step(kind, 3.5)) * live
        let lamp = alu_lamp(p, lc, 2.5, px, ink, dark, lit, 0.0)
        face = mix(face, lamp.rgb / max(lamp.a, 0.001), lamp.a)
    }

    let a = Finish.cover(d, px) * edge_a
    out = Finish.over(out, vec4(face * a, a))

    // Focus: a flat ring two points out, never a glow.
    let fr = Finish.ring_out(d, 1.5, 3.0, px) * 0.55 * focus * live
    out = Finish.over(out, vec4(vec3(0.051, 0.631, 0.984) * fr, fr))

    // The wait spinner, which the stock face drew and this one must too.
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.5)
        sdf.fill(vec4(0.235, 0.239, 0.251, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the raised faces grow their quad for the shade and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 3.0, 0.0, 0.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 3.0, 6.0, 0.0)
}
mod.widgets.Button.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 4.0, 1.0, 6.0)
}
