// ---------------------------------------------------------------------------
// WELLS. A slot or pocket cut into the housing: a dark hairline round its
// mouth (darkest at the top), the housing's shadow falling in from the top
// edge, and a bright lip under the lower rim drawn by the caller.
let alu_recess = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, depth: float, foot: vec3, shade: float) -> vec3 {
    let d = alu_rbox(p, c, h, r)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, depth * 0.55), max(depth * 0.4, px * 0.6))
    var col = mix(fill, vec3(0.118, 0.122, 0.133), clamp(sh, 0.0, 1.0) * shade)
    let low = smoothstep(-0.5, 0.5, p.y - c.y)
    let rim = mix(vec3(0.247, 0.251, 0.267), foot, low)
    col = mix(col, rim, Finish.band(d, 0.0, px, px) * mix(0.9, 0.75, low))
    return col
}

// The bright lip under a recess's lower rim, outside it: premultiplied.
let alu_lip = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, w: float, a: float) -> vec4 {
    let d = alu_rbox(p, c, h, r)
    let l = Finish.ring_out(d, 0.0, w, px) * smoothstep(-0.5, 0.5, p.y - c.y) * a
    return vec4(0.980 * l, 0.984 * l, 0.992 * l, l)
}

// A flat focus ring two points out, never a glow.
let alu_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 1.5, 3.0, px) * 0.55 * focus
    return vec4(0.051 * f, 0.631 * f, 0.984 * f, f)
}

// A turned disc standing on the housing: contact line, faint ambient shade,
// a thin ring and the four-lobed face over a vertical profile.
// `amp` the lobes' strength; `hover`, `press`, `dis` its states.
let alu_disc = fn(p: vec2, c: vec2, rad: float, px: float, amp: float, hover: float, press: float, dis: float) -> vec4 {
    let hh = vec2(rad, rad)
    let live = 1.0 - dis
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let amb = Finish.drop(p, c, hh, rad, vec2(0.0, rad * 0.16), rad * 0.2) * 0.16 * (1.0 - press) * mix(1.0, 0.3, dis)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, amb))
    let con = Finish.drop(p, c, hh, rad, vec2(0.0, mix(0.9, 0.35, press)), 0.45) * mix(0.62, 0.4, press) * mix(1.0, 0.3, dis)
    out = Finish.over(out, vec4(vec3(0.078, 0.071, 0.082) * con, con))
    let q = p - c
    let d = length(q) - rad
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    let top = vec3(0.965, 0.969, 0.976)
    let mid = vec3(0.647, 0.663, 0.675)
    let foot = vec3(0.843, 0.847, 0.863)
    var face = mix(mix(top, mid, smoothstep(0.02, 0.52, t)), foot, smoothstep(0.52, 0.95, t))
    let l = alu_conic(q, px, 1.0, 0.105 * hover)
    face = mix(face, g3(l) * vec3(0.99, 1.0, 1.015), amp)
    face = Finish.lift(face, 0.18 * hover * live * (1.0 - press) - 0.06 * press)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), dis)
    // the chrome ring: a dark hairline, a bright band two pixels wide, a
    // grey hairline, then the face; the band's foot falls a little darker
    let up = 1.0 - smoothstep(-0.3, 0.3, q.y / rad)
    let band = mix(vec3(0.80, 0.805, 0.815), vec3(0.937, 0.937, 0.945), smoothstep(-0.8, 0.2, -q.y / rad))
    face = mix(face, vec3(0.604, 0.608, 0.616), Finish.band(d, 3.0 * px, 4.0 * px, px) * 0.8)
    face = mix(face, band, Finish.band(d, px, 3.0 * px, px) * mix(1.0, 0.4, dis))
    face = mix(face, vec3(0.365, 0.365, 0.373), Finish.band(d, 0.0, px, px) * mix(0.95, 0.4, dis))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// ---------------------------------------------------------------------------
// CHECK BOXES. A 15 point pocket, 3 points in from the edge of the row so
// its focus ring has room: grey when clear, blue when set, the mark white
// with a dark hairline over it, as ink cut into colour.
let alu_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 24.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 15.0
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sz = self.size
    let x0 = mix(3.0, self.rect_size.x - sz - 3.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let c = lo + vec2(sz * 0.5, sz * 0.5 - 0.5 * px)
    let h = vec2(sz * 0.5, sz * 0.5 - 0.5 * px)
    // the round box keeps its round pocket
    let r = mix(3.0, h.y, step(20.0, self.border_radius))
    let d = alu_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let on = max(self.active, self.mixed)
    let blue = mix(vec3(0.357, 0.655, 0.851), vec3(0.624, 0.702, 0.757), self.disabled)
    let grey = mix(vec3(0.659, 0.663, 0.678), vec3(0.765, 0.769, 0.780), self.disabled)
    var fill = mix(grey, blue, on)
    fill = Finish.lift(fill, 0.08 * self.hover * live * (1.0 - self.down) - 0.08 * self.down * live)
    let foot = mix(vec3(0.282, 0.286, 0.294), vec3(0.224, 0.298, 0.357), on)
    var col = alu_recess(p, c, h, r, px, fill, 2.2 + self.down, foot, mix(0.55, 0.25, self.disabled))
    // error: the mouth of the pocket turns red
    col = mix(col, vec3(0.796, 0.090, 0.102), Finish.band(d, 0.0, px, px) * self.error)
    // the mark, or the mixed dash
    let k = sz / 15.0
    let m0 = lo + vec2(4.0, 7.8) * k
    let m1 = lo + vec2(6.6, 10.3) * k
    let m2 = lo + vec2(11.2, 4.8) * k
    let ck = min(alu_seg(p, m0, m1), alu_seg(p, m1, m2)) - 0.85 * k
    let ck_dark = min(alu_seg(p + vec2(0.0, px), m0, m1), alu_seg(p + vec2(0.0, px), m1, m2)) - 0.85 * k
    let dash = alu_seg(p, lo + vec2(4.0, 7.5) * k, lo + vec2(11.0, 7.5) * k) - 0.85 * k
    let dash_dark = alu_seg(p + vec2(0.0, px), lo + vec2(4.0, 7.5) * k, lo + vec2(11.0, 7.5) * k) - 0.85 * k
    let show_ck = self.active * (1.0 - self.mixed)
    let dk = mix(Finish.cover(ck_dark, px) * show_ck, Finish.cover(dash_dark, px), self.mixed)
    let wk = mix(Finish.cover(ck, px) * show_ck, Finish.cover(dash, px), self.mixed)
    col = mix(col, vec3(0.118, 0.227, 0.322), dk * 0.5 * live)
    col = mix(col, mix(vec3(1.0, 1.0, 1.0), vec3(0.93, 0.94, 0.95), self.disabled), wk)
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, px, 0.9)
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, alu_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 34 by 18 slot, grey or lit blue, darkened toward the thumb it
// carries; the thumb is a turned disc as tall as the slot.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 43.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 18.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 1.8889
mod.widgets.ToggleFlat.draw_bg.knob_inset = 0.0
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = mix(3.0, self.rect_size.x - sz.x - 3.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (self.rect_size.y - sz.y) * 0.5, px)) - o
    // the lip lies outside the box, so the slot keeps its whole 18 points
    let lip_w = 2.0 * px
    let h = vec2(sz.x * 0.5, sz.y * 0.5)
    let c = lo + h
    let r = h.y
    let d = alu_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let knob_t = mix(self.active, self.drag_pos, self.drag)
    // the thumb as tall as the slot, its left edge on a pixel boundary
    let kr = h.y
    let ke = Finish.snap(o.x + lo.x + knob_t * (sz.x - 2.0 * kr), px) - o.x
    let kx = ke + kr
    let kc = vec2(kx, c.y)
    // lit slot: bright at the far end, shaded toward the thumb
    let near = clamp((p.x - lo.x) / max(kx - lo.x, 1.0), 0.0, 1.0)
    let lit = mix(vec3(0.510, 0.788, 0.969), vec3(0.349, 0.655, 0.847), near * near)
    let blue = mix(lit, vec3(0.624, 0.702, 0.757), self.disabled)
    let grey = mix(vec3(0.659, 0.663, 0.678), vec3(0.765, 0.769, 0.780), self.disabled)
    var fill = mix(grey, blue, self.active)
    fill = Finish.lift(fill, 0.12 * self.hover * live * (1.0 - self.down) - 0.06 * self.down * live)
    let foot = mix(vec3(0.282, 0.286, 0.294), vec3(0.224, 0.365, 0.467), self.active)
    var col = alu_recess(p, c, h, r, px, fill, 2.7, foot, mix(0.72, 0.3, self.disabled))
    // error: the mouth of the slot turns red, as the check box's does
    col = mix(col, vec3(0.796, 0.090, 0.102), Finish.band(d, 0.0, px, px) * self.error)
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, lip_w, 0.9)
    out = Finish.over(out, vec4(col * a, a))
    out = Finish.over(out, alu_focus(d, px, self.focus * live))
    let disc = alu_disc(p, kc, kr, px, 0.85, self.hover * live * 1.5, self.down * live * 1.4, self.disabled)
    return Finish.over(out, disc)
}

// ---------------------------------------------------------------------------
// RADIOS. A lamp in a chrome socket: a dark blue lens when clear, lit when
// chosen. Lit lamps carry no halo; the lens is lit, not a light source.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 24.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = 15.0
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 3.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let c = lo + vec2(sz * 0.5, sz * 0.5)
    let rad = sz * 0.5
    let live = 1.0 - self.disabled
    let q = p - c
    let d = length(q) - rad
    // the socket: dark at the top, the chrome lip at the foot
    let sock_t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var sock = mix(vec3(0.255, 0.259, 0.275), vec3(0.62, 0.63, 0.64), smoothstep(0.0, 0.45, sock_t))
    sock = mix(sock, vec3(0.906, 0.972, 1.0), smoothstep(0.62, 0.95, sock_t))
    let a = Finish.cover(d, px)
    var out = vec4(sock * a, a)
    // the lens, one ring in
    let ink = mix(vec3(0.506, 0.812, 0.992), vec3(0.62, 0.70, 0.76), self.disabled)
    let dark = mix(vec3(0.173, 0.306, 0.412), vec3(0.45, 0.48, 0.51), self.disabled)
    let lamp = alu_lamp(p, c, rad - 1.6, px, ink, dark, self.active, 0.0)
    let hov = Finish.cover(length(q) - rad + 1.6, px) * 0.10 * self.hover * live
    out = Finish.over(out, lamp)
    out = Finish.over(out, vec4(hov, hov, hov, hov))
    let dn = Finish.cover(length(q) - rad + 1.6, px) * 0.22 * self.down * live
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dn))
    return Finish.over(out, alu_focus(d, px, self.focus * live))
}

// Radio tabs: a recessed slot holding the segment; the chosen one stands up
// out of it as a brushed face.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let live = 1.0 - self.disabled
    let h = (hi - lo) * 0.5 - vec2(0.0, px * 0.5)
    let c = lo + h
    let r = 4.0
    let d = alu_rbox(p, c, h, r)
    var well = mix(vec3(0.725, 0.729, 0.741), vec3(0.80, 0.80, 0.81), self.disabled)
    well = Finish.lift(well, 0.08 * self.hover * live * (1.0 - self.active) * (1.0 - self.down) - 0.09 * self.down * live)
    let col = alu_recess(p, c, h, r, px, well, 2.2, vec3(0.282, 0.286, 0.294), mix(0.5, 0.25, self.disabled))
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, px, 0.9)
    out = Finish.over(out, vec4(col * a, a))
    // the raised segment, two device pixels in
    let sh = h - vec2(2.0 * px, 2.0 * px)
    let sd = alu_rbox(p, c, sh, r - 1.0)
    let t = clamp((p.y - (c.y - sh.y)) / max(2.0 * sh.y, 1.0), 0.0, 1.0)
    var face = alu_face(t, p + o, px)
    face = Finish.lift(face, 0.2 * self.hover * live)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), self.disabled)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    face = mix(face, vec3(0.988, 0.988, 0.996), Finish.band(sd, px, 2.0 * px, px) * mix(0.3, 0.85, up) * live)
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(sd, 0.0, px, px) * 0.7)
    let con = Finish.drop(p, c, sh, r - 1.0, vec2(0.0, 0.6), 0.4) * 0.45 * self.active
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, con * a))
    let fa = Finish.cover(sd, px) * self.active
    out = Finish.over(out, vec4(face * fa, fa))
    return Finish.over(out, alu_focus(d, px, self.focus * live))
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #3c3d40
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #2e2f32
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #8e8f93

// ---------------------------------------------------------------------------
// SLIDERS. A 6 point track cut into the housing, the blue fill inside it,
// hairline ticks engraved above, and a 16 point turned thumb. The quad
// grows by 6 points for the thumb's shade and the focus ring.
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false

let alu_track = fn(p: vec2, lo: vec2, w: float, th: float, px: float, fx: float, dis: float) -> vec4 {
    let h = vec2(w * 0.5, th * 0.5)
    let c = lo + h
    let r = h.y
    let d = alu_rbox(p, c, h, r)
    let filled = step(p.x, fx)
    // the fill is shaded toward the thumb that stands in it
    let near = clamp((p.x - lo.x) / max(fx - lo.x, 1.0), 0.0, 1.0)
    let lit = mix(vec3(0.420, 0.710, 0.890), vec3(0.310, 0.600, 0.800), near * near)
    let blue = mix(lit, vec3(0.624, 0.702, 0.757), dis)
    let grey = mix(vec3(0.659, 0.663, 0.678), vec3(0.765, 0.769, 0.780), dis)
    var fill = mix(grey, blue, filled)
    // the fill's lit top line under the inner shadow
    let ytop = p.y - (c.y - h.y)
    fill = mix(fill, vec3(0.541, 0.812, 0.965), filled * (1.0 - dis) * Finish.band(-ytop + 2.0 * px, 0.0, px, px) * 0.6)
    let foot = mix(vec3(0.282, 0.286, 0.294), vec3(0.224, 0.298, 0.357), filled)
    let col = alu_recess(p, c, h, r, px, fill, th * 0.34, foot, mix(0.55, 0.25, dis))
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, px, 0.9)
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.SliderFlat.height = 38.0
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let tr = 8.0
    let cy = size.y - tr - 1.0
    let th = 6.0
    let top = Finish.snap(o.y + cy - th * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let w = Finish.snap(o.x + size.x - 1.0, px) - o.x - x0
    let kx = x0 + tr + self.slide_pos * (w - 2.0 * tr)
    var out = alu_track(p, vec2(x0, top), w, th, px, kx, self.disabled)
    // engraved ticks above the track at an 8 point pitch, a long one every
    // fifth; each is one device-pixel column, #5e5e60 at 0.85
    let span = w - 2.0 * tr
    let nt = max(floor(span / 8.0 + 0.5), 1.0)
    let pitch = span / nt
    let fi = floor((p.x - x0 - tr) / pitch + 0.5)
    let tx = Finish.snap(o.x + x0 + tr + fi * pitch, px) - o.x
    let major = 1.0 - step(0.3, abs(fract(fi / 5.0 + 0.5) - 0.5))
    let tl = mix(2.5, 4.0, major)
    let ty = Finish.snap(o.y + top - 3.0, px) - o.y
    let ty0 = Finish.snap(o.y + top - 3.0 - tl, px) - o.y
    let in_x = step(-0.5, fi) * step(fi, nt + 0.5)
    let tick = step(tx, p.x) * (1.0 - step(tx + px, p.x)) * step(ty0, p.y) * (1.0 - step(ty, p.y)) * in_x
    let ta = tick * 0.85 * mix(1.0, 0.4, self.disabled)
    out = Finish.over(vec4(0.369 * ta, 0.369 * ta, 0.376 * ta, ta), out)
    let kf = alu_fit(vec2(kx, top + th * 0.5), o, tr, px)
    let kc = kf.xy
    let disc = alu_disc(p, kc, kf.z, px, 0.8, max(self.hover, self.focus) * live, self.drag * live, self.disabled)
    out = Finish.over(out, disc)
    return Finish.over(out, alu_focus(length(p - kc) - kf.z, px, self.focus * live))
}

// The minimal slider: a hairline groove, a blue thread in it, and a small
// turned cap.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 5.0, px) - o.y
    let tr = mix(4.0, 5.0, max(self.hover, self.drag))
    let kx = tr + self.slide_pos * (size.x - 2.0 * tr)
    let inx = step(0.0, p.x) * step(p.x, size.x)
    // groove: two dark rows over one light row
    let dark = step(cy - 2.0 * px, p.y) * step(p.y, cy) * inx
    let light = step(cy, p.y) * step(p.y, cy + px) * inx
    let lit = step(p.x, kx) * dark
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    out = Finish.over(out, vec4(light * 0.6, light * 0.6, light * 0.6, light * 0.6))
    let g = mix(vec3(0.243, 0.243, 0.243), mix(vec3(0.357, 0.655, 0.851), vec3(0.624, 0.702, 0.757), self.disabled), lit)
    out = Finish.over(out, vec4(g * dark, dark))
    let kf = alu_fit(vec2(kx, cy - px), o, tr, px)
    let disc = alu_disc(p, kf.xy, kf.z, px, 0.55, self.hover * live, self.drag * live, self.disabled)
    out = Finish.over(out, disc)
    return Finish.over(out, alu_focus(length(p - kf.xy) - kf.z, px, self.focus * live))
}

mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}
mod.widgets.SliderRoundFlat.height = 14.0
mod.widgets.SliderRoundFlat.text_input.margin = mod.turtle.Inset{left: 0.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}

// The round slider: a pill slot beside its label, a blue capsule in it and
// a small turned cap on the capsule's end; the value reads on the slot.
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let y0 = Finish.snap(o.y, px) - o.y
    let hi = vec2(Finish.snap(o.x + size.x, px) - o.x, Finish.snap(o.y + size.y, px) - o.y - px)
    let h = (hi - vec2(x0, y0)) * 0.5
    let c = vec2(x0, y0) + h
    let r = h.y
    let d = alu_rbox(p, c, h, r)
    let well = Finish.lift(mix(vec3(0.725, 0.729, 0.741), vec3(0.80, 0.80, 0.81), self.disabled), 0.12 * self.hover * live)
    let col = alu_recess(p, c, h, r, px, well, 2.5, vec3(0.282, 0.286, 0.294), mix(0.5, 0.25, self.disabled))
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, px, 0.9)
    out = Finish.over(out, vec4(col * a, a))
    // the capsule
    let ins = 2.0
    let ch = vec2(h.x - ins, h.y - ins)
    let cr = ch.y
    let kx = x0 + ins + cr + self.slide_pos * (2.0 * ch.x - 2.0 * cr)
    let cap_lo = x0 + ins
    let cap_c = vec2((cap_lo + kx) * 0.5, c.y)
    let cap_h = vec2((kx - cap_lo) * 0.5 + cr * 0.0, ch.y)
    let cd = alu_rbox(p, vec2(cap_c.x + cr * 0.5, c.y), vec2(cap_h.x + cr * 0.5, ch.y), cr)
    let blue = mix(vec3(0.357, 0.655, 0.851), vec3(0.624, 0.702, 0.757), self.disabled)
    let bcol = alu_recess(p, vec2(cap_c.x + cr * 0.5, c.y), vec2(cap_h.x + cr * 0.5, ch.y), cr, px, blue, 1.5, vec3(0.224, 0.298, 0.357), 0.4)
    let ba = Finish.cover(cd, px)
    out = Finish.over(out, vec4(bcol * ba, ba))
    let kf = alu_fit(vec2(kx, c.y), o, cr, px)
    let disc = alu_disc(p, kf.xy, kf.z, px, 0.55, self.hover * live, self.drag * live, self.disabled)
    out = Finish.over(out, disc)
    return Finish.over(out, alu_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. A turned cap on a dark body that shows as a chamfer at its foot,
// a hard contact line, a faint ambient shade; an engraved pointer; the value
// as a blue arc outside the cap, the unlit part a pale engraved track.
let alu_knob = fn(p: vec2, c: vec2, rad: float, px: float, val: float, gap: float, hover: float, press: float, dis: float) -> vec4 {
    let dia = rad * 2.0
    let hh = vec2(rad, rad)
    let live = 1.0 - dis
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let amb = Finish.drop(p, c, hh, rad, vec2(0.0, dia * 0.07), dia * 0.08) * 0.16 * mix(1.0, 0.3, dis)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, amb))
    let con = Finish.drop(p, c, hh, rad, vec2(0.0, dia * 0.055), 0.5) * 0.7 * mix(1.0, 0.3, dis)
    out = Finish.over(out, vec4(vec3(0.035, 0.027, 0.031) * con, con))
    // the body, showing as a chamfer below the cap
    let bc = c + vec2(0.0, dia * 0.045)
    let bd = length(p - bc) - rad
    let bt = clamp((p.y - bc.y) / rad, 0.0, 1.0)
    let body = mix(vec3(0.357, 0.357, 0.357), vec3(0.212, 0.212, 0.212), bt)
    let ba = Finish.cover(bd, px)
    out = Finish.over(out, vec4(body * ba, ba))
    // the cap
    let q = p - c
    let d = length(q) - rad
    var face = g3(alu_conic(q, px, 1.0, 0.105 * hover))
    face = Finish.lift(face, 0.15 * hover * live * (1.0 - press) - 0.05 * press)
    face = mix(face, mix(vec3(0.76, 0.765, 0.775), face, 0.35), dis)
    // the chrome ring: dark hairline, a bright band of 0.05 D, a dark
    // hairline, then a lit rim on the top inside of the face
    let up = 1.0 - smoothstep(-0.3, 0.3, q.y / rad)
    let bw = max(floor(dia * 0.05 / px) * px, 2.0 * px)
    let chrome = mix(vec3(0.961, 0.965, 0.973), vec3(0.80, 0.805, 0.815), smoothstep(-0.9, 0.9, q.y / rad))
    face = mix(face, vec3(0.929, 0.929, 0.929), Finish.band(d, 2.0 * px + bw, 3.0 * px + bw, px) * up * 0.4 * live)
    face = mix(face, vec3(0.176, 0.180, 0.188), Finish.band(d, px + bw, 2.0 * px + bw, px) * mix(0.8, 0.35, dis))
    face = mix(face, chrome, Finish.band(d, px, px + bw, px) * mix(1.0, 0.45, dis))
    face = mix(face, vec3(0.212, 0.212, 0.220), Finish.band(d, 0.0, px, px) * mix(0.9, 0.35, dis))
    // the pointer, engraved: a dark line with a light edge below it
    let ang = gap * 0.5 + (2.0 * PI - gap) * val
    let dir = vec2(-sin(ang), cos(ang))
    let pa = c + dir * rad * 0.42
    let pb = c + dir * rad * 0.84
    let pl = alu_seg(p, pa, pb) - max(dia * 0.022, 0.6)
    let pl_lit = alu_seg(p - vec2(0.0, px), pa, pb) - max(dia * 0.022, 0.6)
    face = mix(face, vec3(0.97, 0.97, 0.98), Finish.cover(pl_lit, px) * 0.5 * live)
    face = mix(face, mix(vec3(0.314, 0.314, 0.322), vec3(0.55, 0.55, 0.56), dis), Finish.cover(pl, px))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// The value arc: `ar` its middle radius, `aw` its width.
let alu_arc = fn(p: vec2, c: vec2, ar: float, aw: float, px: float, val: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    var ang = atan2(-q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let rd = abs(length(q) - ar) - aw * 0.5
    let in_arc = step(start, ang) * step(ang, start + sweep)
    // round caps at both stops
    let e0 = c + vec2(-sin(start), cos(start)) * ar
    let e1 = c + vec2(-sin(start + sweep), cos(start + sweep)) * ar
    let v1 = c + vec2(-sin(start + sweep * val), cos(start + sweep * val)) * ar
    let cap = min(length(p - e0), length(p - e1)) - aw * 0.5
    let track_d = min(mix(1000.0, rd, in_arc), cap)
    let lit_in = step(start, ang) * step(ang, start + sweep * val)
    let lit_d = min(mix(1000.0, rd, lit_in), min(length(p - e0), length(p - v1)) - aw * 0.5)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ta = Finish.cover(track_d, px)
    // the unlit part: a shallow groove, darker than the housing
    var tcol = vec3(0.690, 0.694, 0.706)
    tcol = mix(tcol, vec3(0.247, 0.251, 0.267), Finish.band(track_d, 0.0, px, px) * 0.35 * step(ar, length(q)))
    out = vec4(tcol * ta, ta)
    let la = Finish.cover(lit_d, px)
    let blue = mix(vec3(0.051, 0.631, 0.984), vec3(0.624, 0.702, 0.757), dis)
    return Finish.over(out, vec4(blue * la, la))
}

mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - rr, px) - o.y)
    let gap = self.gap * PI / 180.0
    // whole device pixels: the cap's radius, the arc's width and its inner edge
    let rad = floor(rr * 0.68 / px) * px
    let aw = max(floor(2.0 * rad * 0.055 / px + 0.5) * px, 2.0 * px)
    let ar = floor((rad + rr * 0.07) / px + 0.5) * px + aw * 0.5
    var out = alu_arc(p, c, ar, aw, px, self.slide_pos, gap, self.disabled)
    let lifted = max(self.hover, max(self.focus, self.drag)) * live
    out = Finish.over(out, alu_knob(p, c, rad, px, self.slide_pos, gap, lifted, self.drag * live, self.disabled))
    return Finish.over(out, alu_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}

mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let room = vec2(size.x, size.y - 20.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 20.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let rad = floor(rr * 0.7 / px) * px
    let aw = max(floor(2.0 * rad * 0.055 / px + 0.5) * px, 2.0 * px)
    let ar = floor((rad + rr * 0.08) / px + 0.5) * px + aw * 0.5
    var out = alu_arc(p, c, ar, aw, px, self.slide_pos, gap, self.disabled)
    let lifted = max(self.hover, max(self.focus, self.drag)) * live
    out = Finish.over(out, alu_knob(p, c, rad, px, self.slide_pos, gap, lifted, self.drag * live, self.disabled))
    return Finish.over(out, alu_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}

// The dial's readout: a small window of dark glass in a thin chrome bezel,
// a reflection across its top, amber digits with no halo.
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 5.0 right: 5.0 top: 2.35 bottom: 2.35}
mod.widgets.RotaryFlat.text_input.min_height = 22.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, 2.5)
    let gd = d + 4.0 * px
    var col = vec3(0.039, 0.043, 0.063)
    // the reflection: a band across the top with a hard lower edge
    let yt = p.y - (c.y - h.y) - 4.0 * px
    col = col + g3(0.04 * step(0.0, yt) * step(yt, 3.0) * (1.0 - yt / 4.0))
    col = mix(col, vec3(0.09, 0.095, 0.11), Finish.band(gd, 0.0, px, px))
    // the bezel: dark, chrome, dark
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let chrome = mix(vec3(0.94, 0.94, 0.95), vec3(0.72, 0.73, 0.74), t)
    col = mix(col, vec3(0.05, 0.05, 0.06), Finish.band(d, 3.0 * px, 4.0 * px, px))
    col = mix(col, chrome, Finish.band(d, px, 3.0 * px, px))
    col = mix(col, vec3(0.212, 0.212, 0.220), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #f2e198
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #f2e198
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #f2e198
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #8a7f55
// digits of 13 points from the tabular monospace that ships (no condensed
// face does)
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 9.75 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/jetbrains_mono_variable.ttf") weight: 500.0 asc: 0.0 desc: 0.0}}}

// ---------------------------------------------------------------------------
// FADERS. A black slot three points wide with a bright lip, engraved ticks
// on both sides, and a rectangular cap with a dark centre line.
mod.widgets.SliderFader.cap_size = 10.0
mod.widgets.SliderFader.draw_bg.cap_cross = 0.45
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    // track space: `a` along the travel from its zero, `b` across
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = floor(across * 0.5 * 1.5) / 1.5
    // the slot
    let sw = 3.0
    let sl = vec2(self.inset_px, mid - sw * 0.5)
    let sh = vec2((along - self.inset_px * 2.0) * 0.5, sw * 0.5)
    let sc = sl + sh
    let q = vec2(a, b)
    let sd = alu_rbox(q, sc, sh, sh.y)
    var col = mix(vec3(0.039, 0.039, 0.047), vec3(0.13, 0.13, 0.14), self.disabled)
    let sa = Finish.cover(sd, px)
    let lipq = Finish.ring_out(sd, 0.0, px, px) * step(sc.y, b) * 0.6
    var out = vec4(lipq, lipq, lipq, lipq)
    out = Finish.over(out, vec4(col * sa, sa))
    // ticks both sides: long every quarter, short between
    let f = (a - foot) / travel * 10.0
    let fi = floor(f + 0.5)
    let da = abs(a - (foot + fi / 10.0 * travel))
    let major = 1.0 - step(0.3, abs(fract(fi / 5.0 + 0.5) - 0.5))
    let tl = mix(2.5, 4.0, major)
    let off = abs(b - mid)
    let in_rng = step(-0.5, fi) * step(fi, 10.5)
    let tk = (1.0 - smoothstep(px * 0.5 - 0.01, px * 0.5 + 0.01, da)) * step(sw * 0.5 + 3.0, off) * step(off, sw * 0.5 + 3.0 + tl) * in_rng * 0.8
    out = Finish.over(out, vec4(0.369 * tk, 0.369 * tk, 0.376 * tk, tk))
    // the cap
    let cap_w = min(max(across * self.cap_cross, 4.0), across)
    let at = foot + self.slide_pos * travel
    let ch = vec2(self.cap_px * 0.5, cap_w * 0.5)
    let cc = vec2(at, mid)
    let cd = alu_rbox(q, cc, ch, 1.5)
    let down_y = mix(vec2(0.0, 1.0), vec2(-1.0, 0.0), vert)
    let amb = Finish.drop(q, cc, ch, 1.5, down_y * 1.4, 1.4) * 0.18 * mix(1.0, 0.3, self.disabled)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, amb))
    let con = Finish.drop(q, cc, ch, 1.5, down_y * 0.8, 0.4) * 0.55 * mix(1.0, 0.3, self.disabled)
    out = Finish.over(out, vec4(0.078 * con, 0.071 * con, 0.082 * con, con))
    let ct = clamp((mix(q.y, -q.x, vert) - mix(cc.y, -cc.x, vert)) / 1.0, -1.0, 1.0)
    var face = alu_face(clamp(0.5 + (mix(p.y, p.y, vert) - mix(cc.y, size.y - cc.x, vert)) / (2.0 * mix(ch.y, ch.x, vert)), 0.0, 1.0), p, px)
    face = Finish.lift(face, 0.2 * max(self.hover, self.focus) * live - 0.04 * self.drag * live)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), self.disabled)
    // the dark centre line, lit on its upper side
    let cl = abs(a - at)
    face = mix(face, vec3(0.478, 0.482, 0.494), (1.0 - smoothstep(px * 0.5 - 0.01, px * 0.5 + 0.01, cl)) * step(abs(b - mid), ch.y - 1.0))
    face = mix(face, vec3(0.98, 0.98, 0.99), (1.0 - smoothstep(px * 0.5 - 0.01, px * 0.5 + 0.01, abs(a - at - px))) * step(abs(b - mid), ch.y - 1.0) * 0.7)
    face = mix(face, vec3(0.141, 0.141, 0.141), Finish.band(cd, 0.0, px, px) * mix(0.9, 0.4, self.disabled))
    let ca = Finish.cover(cd, px)
    out = Finish.over(out, vec4(face * ca, ca))
    return Finish.over(out, alu_focus(cd, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A milled pocket lighter than the housing: dark hairline
// mouth, a short shadow under the top edge, the bright lip on the last row
// of the box. The focus ring is drawn inside the box as a blue mouth, so a
// field needs no room outside itself.
let alu_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, r)
    var well = mix(vec3(0.914, 0.918, 0.925), vec3(0.965, 0.965, 0.969), 0.35)
    well = Finish.lift(well, 0.25 * hover * (1.0 - dis))
    well = mix(well, vec3(0.839, 0.843, 0.851), dis)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, 1.1), 0.9)
    var col = mix(well, vec3(0.271, 0.271, 0.278), clamp(sh, 0.0, 1.0) * mix(0.35, 0.15, dis))
    let low = smoothstep(-0.5, 0.5, p.y - c.y)
    // a bright hairline at the inner foot
    col = mix(col, vec3(0.992, 0.996, 1.0), Finish.band(d, px, 2.0 * px, px) * low * 0.8)
    let mouth = mix(vec3(0.247, 0.251, 0.267), vec3(0.28, 0.29, 0.30), low)
    col = mix(col, mouth, Finish.band(d, 0.0, px, px) * mix(mix(0.75, 0.95, hover), 0.35, dis))
    // focus: the mouth turns blue and a second blue row lies inside it
    let blue = vec3(0.051, 0.631, 0.984)
    col = mix(col, blue, Finish.band(d, 0.0, 2.0 * px, px) * focus * 0.85)
    let a = Finish.cover(d, px)
    let lip = Finish.ring_out(d, 0.0, px, px) * low * 0.9
    var out = vec4(0.980 * lip, 0.984 * lip, 0.992 * lip, lip)
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 3.0 bottom: 3.0}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 4.0)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #66676b
mod.widgets.TextInputFlat.draw_text.color_disabled = #8e8f93
mod.widgets.TextInputFlat.draw_cursor.color = #0da1fb

mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 4.0)
}
// The stepper: a raised brushed column, split by an engraved line.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(px, 2.0 * px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, 3.0)
    let live = 1.0 - self.disabled
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = alu_face(t, p + o, px)
    let upper = step(p.y, c.y)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    face = Finish.lift(face, 0.04 * hot - 0.07 * dn)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), self.disabled)
    let mid = Finish.snap(o.y + c.y, px) - o.y
    face = mix(face, vec3(0.247, 0.251, 0.267), step(mid - px, p.y) * step(p.y, mid) * 0.45)
    face = mix(face, vec3(0.99, 0.99, 1.0), step(mid, p.y) * step(p.y, mid + px) * 0.6)
    face = mix(face, vec3(0.99, 0.99, 1.0), Finish.band(d, px, 2.0 * px, px) * (1.0 - t) * 0.7)
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px)
    return vec4(face * a, a)
}
mod.widgets.NumberSpin.draw_text.color = #3c3d40

// ---------------------------------------------------------------------------
// DROP-DOWNS. The chrome-ringed face with a chevron zone at the right, set
// off by an engraved divider; the chevron is a stroked hairline angle.
let alu_chevron = fn(p: vec2, c: vec2, px: float) -> float {
    let a = c + vec2(-3.5, -1.5)
    let b = c + vec2(0.0, 2.0)
    let e = c + vec2(3.5, -1.5)
    return min(alu_seg(p, a, b), alu_seg(p, b, e)) - 0.75
}

mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 10.0 right: 26.0 top: 3.0 bottom: 3.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let o = self.rect_pos
    let held = max(self.down * self.hover, self.active)
    var out = alu_button(self.pos, size, o, px, self.hover, held, self.focus, self.disabled, 0.0, 0.0, 4.0, 1.0, m)
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let dx = Finish.snap(o.x + size.x - 19.0, px) - o.x
    let in_y = step(4.0, p.y) * step(p.y, size.y - 4.0)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * 0.35
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.6
    let dn = held * live * px
    out = Finish.over(out, vec4(0.247 * div_d, 0.251 * div_d, 0.267 * div_d, div_d))
    out = Finish.over(out, vec4(0.99 * div_l, 0.99 * div_l, 1.0 * div_l, div_l))
    let cc = vec2(size.x - 9.5, size.y * 0.5 + dn)
    let lit = Finish.cover(alu_chevron(p - vec2(0.0, px), cc, px), px) * 0.45 * live
    out = Finish.over(out, vec4(lit, lit, lit, lit))
    let ch = Finish.cover(alu_chevron(p, cc, px), px)
    let ink = mix(vec3(0.235, 0.239, 0.251), vec3(0.557, 0.561, 0.576), self.disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}
mod.widgets.DropDown.draw_bg.color_disabled = #d3d4d6

// The combo box: the milled pocket with a brushed chevron key joined at its
// right end.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 8.0 right: 26.0 top: 3.0 bottom: 3.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    var out = alu_field(p, size, o, px, self.hover, self.focus, self.disabled, 4.0)
    // the key
    let kx = Finish.snap(o.x + size.x - 19.0, px) - o.x
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(px, 2.0 * px)
    let klo = vec2(kx, Finish.snap(o.y, px) - o.y + px)
    let kh = (hi - klo) * 0.5
    let kc = klo + kh
    let kd = max(alu_rbox(p, kc + vec2(2.0, 0.0), kh + vec2(2.0, 0.0), 3.0), -(p.x - kx))
    let t = clamp((p.y - klo.y) / max(2.0 * kh.y, 1.0), 0.0, 1.0)
    let held = self.down * self.hover * live
    var face = alu_face(mix(t, 1.0 - t, held * 0.3), p + o, px)
    face = Finish.lift(face, 0.2 * self.hover * live * (1.0 - held) - 0.06 * held)
    face = mix(face, mix(vec3(0.788, 0.792, 0.800), face, 0.4), self.disabled)
    face = mix(face, vec3(0.99, 0.99, 1.0), step(klo.y, p.y) * step(p.y, klo.y + px) * 0.7)
    face = mix(face, vec3(0.247, 0.251, 0.267), step(kx, p.x) * step(p.x, kx + px) * 0.55)
    let ka = Finish.cover(kd, px)
    out = Finish.over(out, vec4(face * ka, ka))
    let cc = vec2(size.x - 10.0, size.y * 0.5)
    let ch = Finish.cover(alu_chevron(p, cc, px), px)
    let ink = mix(vec3(0.235, 0.239, 0.251), vec3(0.557, 0.561, 0.576), self.disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. One recessed slot holding metal segments: the chosen
// one stands up as a brushed face, the others are engraved words on the
// well, split by engraved hairlines.
let alu_slot = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, well: vec3) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, r)
    let col = alu_recess(p, c, h, r, px, well, 2.4, vec3(0.282, 0.286, 0.294), 0.5)
    let a = Finish.cover(d, px)
    var out = alu_lip(p, c, h, r, px, px, 0.9)
    return Finish.over(out, vec4(col * a, a))
}
// A brushed segment standing in a slot, `ins` in from its box.
let alu_segment = fn(p: vec2, size: vec2, o: vec2, px: float, ins: float, r: float, hover: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(ins, ins)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(ins, ins)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = alu_face(t, p + o, px)
    face = Finish.lift(face, 0.2 * hover)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    face = mix(face, vec3(0.988, 0.988, 0.996), Finish.band(d, px, 2.0 * px, px) * mix(0.3, 0.85, up))
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(d, 0.0, px, px) * 0.7)
    let con = Finish.drop(p, c, h, r, vec2(0.0, 0.6), 0.4) * 0.45
    let a = Finish.cover(d, px)
    return Finish.over(vec4(0.0, 0.0, 0.0, con), vec4(face * a, a))
}

mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_slot(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 4.0, vec3(0.725, 0.729, 0.741))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_segment(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 2.0 * px, 3.0, 0.0)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #3c3d40
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #2e2f32

// The tab strip: the same slot; the tab in use is the raised segment, a
// hovered one lifts a little, quiet ones are words on the well.
mod.widgets.Tabs.height = 24.0
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_slot(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 4.0, vec3(0.725, 0.729, 0.741))
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = self.rect_size * 0.5 - vec2(2.0 * px, 2.0 * px)
    let d = alu_rbox(p, self.rect_size * 0.5, h, 3.0)
    let a = Finish.cover(d, px) * 0.12
    return vec4(a, a, a, a)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_segment(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 2.0 * px, 3.0, 0.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let x = self.pos.x * self.rect_size.x
    let dk = step(x, px) * 0.35
    let lt = step(px, x) * step(x, 2.0 * px) * 0.5
    return vec4(0.247 * dk + lt, 0.251 * dk + lt, 0.267 * dk + lt, dk + lt)
}
mod.widgets.Tabs.draw_mark.color = #3c3d40
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // 7 points across, a 1 point stroke; the plus is the cross turned
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(4.2, 3.0, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(-sin(a), cos(a)) * r
    let dd = min(alu_seg(p, c - u, c + u), alu_seg(p, c - v, c + v)) - 0.5
    let k = Finish.cover(dd, px) * self.color.a
    return vec4(self.color.rgb * k, k)
}
mod.widgets.Tabs.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_regular{font_size: 7.5}
mod.widgets.Tabs.draw_text.color = #4a4b4f
mod.widgets.Tabs.draw_text_active.color = #2e2f32

// ---------------------------------------------------------------------------
// PROGRESS. The slider's track: a 6 point slot with the blue fill, its lit
// top line under the inner shadow. The unknown value is shown by still
// diagonal stripes across the whole fill: a face may not run a clock.
mod.widgets.ProgressBarFlat.height = 7.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = 7.0
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let w = self.rect_size.x
    let th = min(self.thickness, self.rect_size.y) - px
    let top = Finish.snap(o.y + (self.rect_size.y - th - px) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + w * self.start, px) - o.x
    let x1 = Finish.snap(o.x + w * self.end, px) - o.x
    let h = vec2((x1 - x0) * 0.5, th * 0.5)
    let c = vec2(x0, top) + h
    let r = h.y
    let d = alu_rbox(p, c, h, r)
    let dis = step(4.5, self.intent)
    var ink = vec3(0.357, 0.655, 0.851)
    if self.intent > 0.5 {
        ink = self.fill_color().rgb
    }
    ink = mix(ink, vec3(0.624, 0.702, 0.757), dis)
    let xv = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
    var filled = step(p.x, xv) * step(0.0, self.value)
    var stripe = 0.0
    if self.value < 0.0 {
        filled = 1.0
        stripe = Finish.stripes(p + o, 0.785398, 8.0, 0.5, px)
    }
    let grey = vec3(0.659, 0.663, 0.678)
    var fill = mix(grey, ink, filled)
    fill = Finish.lift(fill, 0.08 * stripe)
    let ytop = p.y - top
    fill = mix(fill, Finish.lift(ink, 0.35), filled * Finish.band(-ytop + 2.0 * px, 0.0, px, px) * 0.6)
    let foot = mix(vec3(0.282, 0.286, 0.294), vec3(0.224, 0.298, 0.357), filled)
    let col = alu_recess(p, c, h, r, px, fill, th * 0.34, foot, 0.55)
    let a = Finish.cover(d, px) * self.track
    var out = alu_lip(p, c, h, r, px, px, 0.9 * self.track)
    out = Finish.over(out, vec4(col * a, a))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A ladder of cells in a slot: lit cells run yellow through
// orange to red with no hard zones, unlit cells are the well with a dark
// top line. The over lamp is a red lens, dark until it latches.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let q = vec2(a, b)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    let h = vec2(bar * 0.5, across * 0.5 - px * 0.5)
    let c = h
    let r = 1.5
    let d = alu_rbox(q, c, h, r)
    let pad = 1.5
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((a - pad) / span, 0.0, 1.0)
    // cells: 3 points long with a point and a half between
    let pitch = 4.5
    let cell = fract((a - pad) / pitch)
    let in_cell = step(cell, 3.0 / pitch)
    let lit = step(a, pad + span * self.level) * step(pad, a) * in_cell
    let ramp = mix(mix(vec3(0.914, 0.867, 0.396), vec3(0.929, 0.592, 0.196), smoothstep(0.55, 0.85, share)), vec3(0.906, 0.165, 0.039), smoothstep(0.85, 1.0, share))
    let well = vec3(0.60, 0.605, 0.62)
    var fill = mix(well, ramp, lit)
    // unlit cells: the well a little darker, a dark hairline on their top
    let cell_row = in_cell * step(pad, a) * step(a, pad + span)
    fill = mix(fill, well * 0.95, cell_row * (1.0 - lit))
    // a lit cell keeps a lighter line along its top
    let bt = b - (c.y - h.y)
    fill = mix(fill, Finish.lift(ramp, 0.3), lit * step(pad, bt) * step(bt, pad + px) * 0.7)
    var col = alu_recess(q, c, h, r, px, fill, 1.4, vec3(0.282, 0.286, 0.294), 0.45)
    // the hold mark: a dark hairline pair
    if self.hold > 0.002 {
        let at = pad + span * self.hold
        let hm = step(abs(a - at), px) * step(pad, b) * step(b, across - pad)
        col = mix(col, vec3(0.20, 0.20, 0.21), hm)
    }
    let ca = Finish.cover(d, px)
    var out = Finish.over(alu_lip(q, c, h, r, px, px, 0.8), vec4(col * ca, ca))
    if self.lamp > 0.5 {
        // the lens is lit from above in the window, not along the track
        let la = bar + 3.0 + across * 0.5
        let lb = across * 0.5
        let lc = vec2(mix(la, lb, vert), mix(lb, self.rect_size.y - la, vert))
        let lamp = alu_lamp(p, lc, across * 0.5 - px, px, vec3(0.972, 0.235, 0.239), vec3(0.353, 0.102, 0.110), step(0.5, self.over), 0.0)
        out = Finish.over(out, lamp)
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A 9 point slot with a brushed 5 point thumb in it.
mod.widgets.ScrollBar.bar_size = 9.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let sh = vec2(along * 0.5, across * 0.5 - px * 0.5)
    let sc = sh
    let sd = alu_rbox(q, sc, sh, sh.y)
    let col = alu_recess(q, sc, sh, sh.y, px, vec3(0.725, 0.729, 0.741), 2.0, vec3(0.282, 0.286, 0.294), 0.4)
    let sa = Finish.cover(sd, px)
    var out = vec4(col * sa, sa)
    // the thumb
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let th = vec2(tl * 0.5 - 1.0, 2.5)
    let tc = vec2(t0 + tl * 0.5, across * 0.5 - px * 0.5)
    let td = alu_rbox(q, tc, th, 2.5)
    let tt = clamp((b - (tc.y - th.y)) / 5.0, 0.0, 1.0)
    var face = mix(vec3(0.925, 0.933, 0.941), vec3(0.788, 0.796, 0.808), tt)
    face = Finish.lift(face, 0.2 * self.hover - 0.05 * self.drag)
    face = mix(face, vec3(0.988, 0.988, 0.996), Finish.band(td, px, 2.0 * px, px) * (1.0 - tt) * 0.8)
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(td, 0.0, px, px) * 0.7)
    let con = Finish.drop(q, tc, th, 2.5, vec2(0.0, 0.6), 0.35) * 0.4
    out = Finish.over(out, vec4(0.078 * con, 0.071 * con, 0.082 * con, con))
    let ta = Finish.cover(td, px)
    out = Finish.over(out, vec4(face * ta, ta))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. An anodised plate: faint ambient shade and a contact
// line outside it, a hairline edge, brushing and grain in the face, a lit
// top rim. The sunken panel is a shallow pocket in the housing.
let alu_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, r)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let amb = Finish.drop(p, c, h, r, vec2(0.0, 1.5), 2.6) * 0.10 * (1.0 - sunken)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, amb))
    let con = Finish.drop(p, c, h, r, vec2(0.0, 0.5), 0.5) * 0.35 * (1.0 - sunken)
    out = Finish.over(out, vec4(0.078 * con, 0.071 * con, 0.082 * con, con))
    let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(-0.5, 0.5, p.y - c.y) * 0.8 * sunken
    out = Finish.over(out, vec4(lip, lip, lip, lip))
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.851, 0.851, 0.859), vec3(0.796, 0.796, 0.804), t)
    face = mix(face, mix(vec3(0.784, 0.784, 0.792), vec3(0.757, 0.757, 0.765), t), sunken)
    let s = Finish.brushed(p + o, vec2(1.0, 0.0), px * 1.4) - 0.5
    face = face + g3(s * 0.02 + Finish.grain((p + o) / px, 0.0245))
    // the sunken pocket: the housing's shadow under its top edge
    let sh = Finish.inset(p, c, h, r, vec2(0.0, 1.8), 1.6)
    face = mix(face, vec3(0.118, 0.122, 0.133), clamp(sh, 0.0, 1.0) * 0.45 * sunken)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * mix(0.2, 0.7, up) * (1.0 - sunken))
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(d, 0.0, px, px) * mix(0.35, mix(0.3, 0.5, up), sunken))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return alu_plate(p, self.rect_size, self.rect_pos, px, 6.0, self.sunken)
}

// The card is the raised plate too; its palette and shadow numbers from
// Rust are not read.
mod.widgets.Card.radius = 6.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 8.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 8.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = alu_plate(p, self.rect_size, self.rect_pos, px, 6.0, 0.0)
    let d = alu_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5, 6.0)
    let l = Finish.cover(d, px) * (0.05 * self.hover - 0.05 * self.down)
    return Finish.over(out, vec4(max(l, 0.0), max(l, 0.0), max(l, 0.0), abs(l)))
}

// The plain rounded view keeps the colours its caller gives it; the edge is
// a snapped hairline at the true radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, max(self.border_radius, 1.0))
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points split by a double hairline; the chosen row is a
// shallow pocket with a small lit lamp at its head; a hovered row lifts.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 14.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // hover and press
    let lay = (self.hover * 0.10 - self.down * 0.06) * live
    out = vec4(max(lay, 0.0), max(lay, 0.0), max(lay, 0.0), abs(lay))
    // the chosen row
    if self.selected > 0.5 {
        // it ends 11 points short of the row's right edge, clear of the
        // 9 point scroll bar, so its rounded end and lip stay in view
        let h = (hi - lo) * 0.5 - vec2(7.5, 1.5)
        let c = lo + (hi - lo) * 0.5 - vec2(5.5, 0.5)
        let d = alu_rbox(p, c, h, 3.0)
        let col = alu_recess(p, c, h, 3.0, px, vec3(0.706, 0.710, 0.725), 2.0, vec3(0.282, 0.286, 0.294), 0.45)
        let a = Finish.cover(d, px)
        out = Finish.over(Finish.over(out, alu_lip(p, c, h, 3.0, px, px, 0.85)), vec4(col * a, a))
        let lamp = alu_lamp(p, vec2(lo.x + 7.0, c.y), 2.0, px, vec3(0.506, 0.812, 0.992), vec3(0.173, 0.306, 0.412), live, 0.0)
        out = Finish.over(out, lamp)
    }
    // the double hairline under the row
    let yb = hi.y
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * 0.10
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.35
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dk))
    out = Finish.over(out, vec4(lt, lt, lt, lt))
    return out
}
mod.widgets.ListItem.draw_text.color = #3c3d40

// The open list of a drop-down: an anodised plate; the row under the
// pointer takes a faint blue wash, the chosen row its check.
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_plate(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 4.0, 0.0)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let d = alu_rbox(p, c, c - vec2(1.0, 0.5), 3.0)
    let live = 1.0 - self.disabled
    let wash = Finish.cover(d, px) * 0.18 * self.hover * live
    var out = vec4(0.357 * wash, 0.655 * wash, 0.851 * wash, wash)
    let m0 = vec2(5.0, c.y)
    let m1 = vec2(7.5, c.y + 2.5)
    let m2 = vec2(11.5, c.y - 3.0)
    let mk = Finish.cover(min(alu_seg(p, m0, m1), alu_seg(p, m1, m2)) - 0.7, px) * self.active
    return Finish.over(out, vec4(0.235 * mk, 0.239 * mk, 0.251 * mk, mk))
}

// The dock's tabs: the bar is the housing with a double hairline at its
// foot; the tab in use is a brushed face rounded at the top, the others
// engraved words that lift a little under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 3.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 4.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(p, c, h, 4.0)
    let t = clamp((p.y - lo.y) / max(self.rect_size.y - 2.0, 1.0), 0.0, 1.0)
    var face = alu_face(t * 0.6, p + o, px)
    face = mix(face, vec3(0.988, 0.988, 0.996), Finish.band(d, px, 2.0 * px, px) * 0.85 * step(p.y, lo.y + 3.0))
    face = mix(face, vec3(0.247, 0.251, 0.267), Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px) * self.active
    let lift = Finish.cover(d, px) * 0.10 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(lift, lift, lift, lift), vec4(face * a, a))
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    var out = vec4(0.0, 0.0, 0.0, 0.04)
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * 0.25
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.5
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dk))
    return Finish.over(out, vec4(lt, lt, lt, lt))
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is the 20 point button face (sunk into a lit
// blue well while chosen); a badge is a small plate of dark glass.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let ch = min(20.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    // chosen: the loud fill carries light ink
    let chosen = step(0.6, dot(self.ink.rgb, vec3(0.299, 0.587, 0.114)))
    if chosen < 0.5 {
        return alu_button(pp, sz, o + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, 4.0, 1.0, m)
    }
    let q = p - vec2(0.0, dy)
    let oo = o + vec2(0.0, dy)
    let lo = vec2(Finish.snap(oo.x, px), Finish.snap(oo.y, px)) - oo
    let hi = vec2(Finish.snap(oo.x + sz.x, px), Finish.snap(oo.y + sz.y, px)) - oo - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = alu_rbox(q, c, h, 4.0)
    let fill = Finish.lift(vec3(0.357, 0.655, 0.851), 0.08 * self.hover - 0.08 * self.down)
    let col = alu_recess(q, c, h, 4.0, px, fill, 2.2, vec3(0.224, 0.298, 0.357), 0.55)
    let a = Finish.cover(d, px)
    var out = alu_lip(q, c, h, 4.0, px, px, 0.9)
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, alu_focus(d, px, self.keyed))
}
mod.widgets.BadgePalette.neutral = #1b1c20
mod.widgets.BadgePalette.on_neutral = #e9eaec
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 6.0}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 6.0}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(16.0, self.rect_size.y)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    // a dot (as wide as tall and small) is round; a count is a plate
    let r = mix(3.0, h.y, step(self.rect_size.x, self.rect_size.y + 0.5) * step(self.rect_size.y, 12.5))
    let d = alu_rbox(p, c, h, r)
    var col = vec3(0.106, 0.110, 0.125)
    // a faint reflection in the upper half of the glass
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    col = col + g3(0.025 * (1.0 - smoothstep(0.35, 0.5, t)))
    // the lit top rim, then the dark edge
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, col + g3(0.06), Finish.band(d, px, 2.0 * px, px) * up)
    col = mix(col, vec3(0.047, 0.047, 0.055), Finish.band(d, 0.0, px, px) * 0.9)
    let a = Finish.cover(d, px) * self.color.a
    var out = alu_lip(p, c, h, r, px, px, 0.7)
    return Finish.over(out, vec4(col * a, a))
}

// Rules between groups: one dark device row over one light one, never a
// single grey line.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let dk = step(y - px, p.y) * (1.0 - step(y, p.y)) * 0.11
    let lt = step(y, p.y) * (1.0 - step(y + px, p.y)) * 0.30
    return Finish.over(vec4(0.0, 0.0, 0.0, dk), vec4(lt, lt, lt, lt))
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let dk = step(x - px, p.x) * (1.0 - step(x, p.x)) * 0.11
    let lt = step(x, p.x) * (1.0 - step(x + px, p.x)) * 0.30
    return Finish.over(vec4(0.0, 0.0, 0.0, dk), vec4(lt, lt, lt, lt))
}

// ---------------------------------------------------------------------------
// THE HOUSING under everything: the window's own ground.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return alu_ground(self.pos * self.rect_size, self.rect_size, px)
}
true
