use mod.prelude.widgets_internal.*

// An olive-drab field radio. The case is painted steel, mottled, grained
// and scratched through to bright metal. Raised caps are dark olive-grey
// set in a bright steel ring with a black gap round the cap, lit on top,
// with a shadow under them; wells are near black inside a steel frame.
// Knobs are turned chrome over a black skirt with a printed scale; slider
// thumbs are ribbed steel blocks. Values glow amber; what is on is a lamp,
// amber or red, lit from within. Every rim is one device pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 26.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #3f4232

// Plain views stop clipping, so a part's shadow may fall into the gap
// beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let fr_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A segment's distance.
let fr_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroked chevron's distance: `w` wide, `hgt` tall, pointing down
// (`flip` 1 points up).
let fr_chevron = fn(p: vec2, c: vec2, w: float, hgt: float, flip: float) -> float {
    let s = mix(1.0, -1.0, flip)
    let a = c + vec2(-w * 0.5, -hgt * 0.5 * s)
    let b = c + vec2(0.0, hgt * 0.5 * s)
    let e = c + vec2(w * 0.5, -hgt * 0.5 * s)
    return min(fr_seg(p, a, b), fr_seg(p, b, e))
}

// A disc laid on the pixel grid: a whole number of device pixels across,
// its edge on a pixel boundary, so its one-pixel rings are one pixel.
// `c` is quad-local; returns (centre.x, centre.y, radius).
let fr_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// The one accent, amber: the lit core, the fill's body, its hot and deep
// rims. Red is the second lamp colour, for what is armed or wrong.
let fr_acc = fn() -> vec3 {
    return vec3(1.0, 0.690, 0.302)
}
let fr_fill = fn() -> vec3 {
    return vec3(0.933, 0.576, 0.180)
}
let fr_rim_hi = fn() -> vec3 {
    return vec3(1.0, 0.839, 0.588)
}
let fr_rim_lo = fn() -> vec3 {
    return vec3(0.557, 0.290, 0.047)
}
let fr_red = fn() -> vec3 {
    return vec3(1.0, 0.341, 0.263)
}
// The accent as disabled parts show it: an unlit olive grey.
let fr_off = fn() -> vec3 {
    return vec3(0.200, 0.200, 0.160)
}
let fr_bezel = fn() -> vec3 {
    return vec3(0.031, 0.033, 0.022)
}
let fr_shadow_ink = fn() -> vec3 {
    return vec3(0.016, 0.018, 0.008)
}
// Steel: the bright ring round caps and wells, by where on the ring (`up`
// 1 on the top run, 0 on the foot).
let fr_steel = fn(up: float) -> vec3 {
    return mix(vec3(0.200, 0.204, 0.180), vec3(0.380, 0.384, 0.357), up)
}

// Signed grain, -amount..amount with a triangular spread, one value per
// device pixel (pass `p / px`). The library hash nearly repeats every 97
// pixels (0.1031 x 97 is almost a whole number), which the eye finds on a
// wide ground; a first hash scaled far up displaces the lattice of the two
// that are summed, so no shift lines them up again.
let fr_grain = fn(q: vec2, amount: float) -> float {
    let i = floor(q)
    let h = Finish.hash(i)
    let a = Finish.hash(i + vec2(h * 397.13, h * 211.71))
    let b = Finish.hash(vec2(i.y * 0.7548 + h * 157.3, i.x * 1.1698 + h * 89.9))
    return (a + b - 1.0) * amount
}

// Scratches: in each 40 point cell at most one short straight scratch at a
// cell-random angle, a hairline of bright steel with a darker edge beside
// it; the eight neighbours are searched so a scratch may cross its cell.
// Returns (bright, dark) coverage.
let fr_scratch_in = fn(p: vec2, ci: vec2, px: float, cell: float, density: float) -> vec2 {
    let h0 = Finish.hash(ci + vec2(13.1, 71.7))
    let h1 = Finish.hash(ci + vec2(41.3, 7.9))
    let h2 = Finish.hash(ci + vec2(3.7, 29.3))
    let h3 = Finish.hash(ci + vec2(97.1, 53.3))
    let ctr = (ci + vec2(h1, h2)) * cell
    let ang = h3 * 3.14159 * 0.6 + 0.3
    let dir = vec2(cos(ang), sin(ang))
    let len = cell * (0.25 + 0.6 * Finish.hash(ci + vec2(17.3, 5.1)))
    let a = ctr - dir * len * 0.5
    let pa = p - a
    let ba = dir * len
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let e = pa - ba * k
    let d = length(e)
    // a scratch fades out toward both ends; a cell above the density has none
    let on = step(h0, density)
    let fade = sin(k * 3.14159) * (0.45 + 0.55 * h0 / max(density, 0.001)) * on
    let br = (1.0 - smoothstep(0.2 * px, 2.2 * px, d)) * fade
    let side = dot(e, vec2(-dir.y, dir.x))
    let dk = (1.0 - smoothstep(0.3 * px, 2.0 * px, abs(side - 1.6 * px))) * fade * 0.35
    return vec2(br, dk)
}
let fr_scratch = fn(p: vec2, px: float, cell: float, density: float) -> vec2 {
    let g = floor(p / cell)
    var s = fr_scratch_in(p, g, px, cell, density)
    s = max(s, fr_scratch_in(p, g + vec2(-1.0, -1.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(0.0, -1.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(1.0, -1.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(-1.0, 0.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(1.0, 0.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(-1.0, 1.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(0.0, 1.0), px, cell, density))
    s = max(s, fr_scratch_in(p, g + vec2(1.0, 1.0), px, cell, density))
    return s
}

// The paint's own mottle over a hand's width, for the case (see THE CASE
// near the end) and the plates.
let fr_paint = fn(p: vec2, px: float) -> float {
    // the mottle: two octaves of smooth noise, about 140 and 45 points
    let m = Finish.noise(p / 140.0 + vec2(3.1, 7.7)) * 0.65 + Finish.noise(p / 45.0 + vec2(11.3, 2.9)) * 0.35
    return (m - 0.5) * 0.045
}

// The camouflage the case is painted in (see THE CASE near the end).
let fr_camo = fn(q: vec2) -> vec3 {
    let w = vec2(Finish.fbm(q / 260.0 + vec2(1.7, 9.2)), Finish.fbm(q / 260.0 + vec2(8.3, 2.8))) - vec2(0.5, 0.5)
    let wf = vec2(Finish.noise(q / 31.0 + vec2(4.1, 0.7)), Finish.noise(q / 29.0 + vec2(9.3, 5.5))) - vec2(0.5, 0.5)
    let ww = w * 1.9 + wf * 0.16
    let n1 = Finish.fbm(q / 200.0 + vec2(3.3, 7.1) + ww)
    let n2 = Finish.fbm(q / 160.0 + vec2(11.9, 4.4) + vec2(ww.y, ww.x))
    let n3 = Finish.fbm(q / 120.0 + vec2(6.2, 13.8) - ww)
    let e = 0.014
    var col = vec3(0.278, 0.286, 0.202)
    col = mix(col, vec3(0.235, 0.247, 0.157), smoothstep(0.52 - e, 0.52 + e, n1))
    col = mix(col, vec3(0.255, 0.238, 0.168), smoothstep(0.56 - e, 0.56 + e, n2))
    col = mix(col, vec3(0.180, 0.186, 0.136), smoothstep(0.63 - e, 0.63 + e, n3))
    return col
}

// The face of a raised cap by height t 0..1: #3d3e33 at the top, #33342b
// at the waist, #26271f at the foot.
let fr_face = fn(t: float) -> vec3 {
    let top = vec3(0.239, 0.243, 0.200)
    let mid = vec3(0.200, 0.204, 0.169)
    let foot = vec3(0.149, 0.153, 0.122)
    return mix(mix(top, mid, clamp(t * 2.0, 0.0, 1.0)), foot, clamp(t * 2.0 - 1.0, 0.0, 1.0))
}

// A lit face: amber glass lit from behind, a dark ramp under the bezel,
// the lit body, paler toward the middle.
let fr_lit_face = fn(t: float, yi: float) -> vec3 {
    let body = mix(vec3(0.933, 0.576, 0.180), vec3(1.0, 0.760, 0.420), smoothstep(0.45, 1.0, t))
    return mix(vec3(0.200, 0.090, 0.010), body, smoothstep(0.0, 3.0, yi))
}

// An LED dash: `lit` 0 shows the unlit bead `off` in its engraved slot, 1
// the lit core, white-hot over its middle third, with a halo of 0.25 at
// one device pixel that is gone within three.
let fr_dash = fn(p: vec2, c: vec2, hw: float, hh: float, px: float, ink: vec3, lit: float, off: vec3) -> vec4 {
    let d = fr_rbox(p, c, vec2(hw, hh), hh)
    let a = Finish.cover(d, px)
    let across = abs(p.y - c.y) / max(hh, 0.001)
    let hot = 1.0 - smoothstep(0.15, 0.6, across)
    let core = mix(ink, vec3(1.0, 1.0, 1.0), 0.55 * hot)
    let col = mix(off, core, lit)
    var out = vec4(col * a, a)
    // the slot's lip under an unlit dash
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y, p.y) * 0.07 * (1.0 - lit)
    out = Finish.over(vec4(lip, lip, lip, lip), out)
    let ha = 0.25 * lit * exp(-max(d - px, 0.0) / (0.6 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A lamp bead: a round lens, lit with a white-hot centre and a tight halo,
// or unlit at a third of its light in a darker hue.
let fr_bead = fn(p: vec2, c: vec2, rad: float, px: float, ink: vec3, lit: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    let a = Finish.cover(d, px)
    let rr = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(mix(ink, vec3(1.0, 1.0, 1.0), 0.55), ink * 0.8, smoothstep(0.0, 1.0, rr))
    let off = mix(ink * 0.30, ink * 0.18, rr) + g3(0.03)
    var col = mix(off, on, lit)
    col = mix(col, fr_bezel(), Finish.band(d, 0.0, px, px) * 0.6 * (1.0 - lit))
    var out = vec4(col * a, a)
    // the socket: a dark ring outside the lens
    let sock = Finish.ring_out(d, 0.0, px, px) * 0.55
    out = Finish.over(vec4(0.0, 0.0, 0.0, sock * (1.0 - lit)), out)
    let ha = 0.25 * lit * exp(-max(d - px, 0.0) / (0.6 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A well cut into the plate: the fill, the plate's shadow falling in from
// the top wall, a dark mouth darkest on top. Its lip is `fr_lip`.
let fr_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, depth: float) -> vec3 {
    let d = fr_rbox(p, c, h, r)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, depth * 0.5), max(depth * 0.4, px * 0.6))
    var col = mix(fill, vec3(0.027, 0.029, 0.020), clamp(sh, 0.0, 1.0) * 0.85)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, vec3(0.027, 0.029, 0.020), Finish.band(d, 0.0, px, px) * mix(0.5, 0.95, up))
    return col
}

// The lip under a well's lower rim, outside it, confined to the foot and
// the lower corners: premultiplied white.
let fr_lip = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, a: float) -> vec4 {
    let d = fr_rbox(p, c, h, r)
    let foot = smoothstep(c.y + h.y - max(r, 1.0) - 1.5, c.y + h.y, p.y)
    let l = Finish.ring_out(d, 0.0, px, px) * foot * a
    return vec4(l, l, l, l)
}

// Focus: one device pixel of the accent, two device pixels out; no halo.
let fr_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * 0.7 * focus
    let k = fr_acc()
    return vec4(k * f, f)
}

// Turned metal: a conic sheen with two bright lobes at twelve and six
// o'clock and two dark ones at three and nine, over lathe rings one device
// pixel apart. `lo` and `hi` are the dark and bright lobes' luminance.
// Returns a luminance.
let fr_conic = fn(q: vec2, px: float, lo: float, hi: float, turn: float) -> float {
    let r = max(length(q), 0.0001)
    let cs = q.x / r
    let sn = q.y / r
    let c1 = cs * cos(turn) - sn * sin(turn)
    let s1 = sn * cos(turn) + cs * sin(turn)
    // cos of twice the angle from vertical: +1 top and bottom, -1 sides
    let c2 = s1 * s1 - c1 * c1
    let k = c2 * 0.5 + 0.5
    var l = mix(lo, hi, k * k * (3.0 - 2.0 * k))
    let rings = Finish.noise(vec2(r / px, 0.37)) - 0.5
    l = l + rings * 0.016 * smoothstep(0.0, 2.0, r)
    // the pinprick where the lobes meet
    l = l + 0.04 * (1.0 - smoothstep(0.0, px * 1.2, r))
    return l
}

// A turned thumb standing on the plate: contact ring, a cast shadow to the
// lower right, a bright chamfer ring, a groove, the spun face. `hover`,
// `press` and `dis` are its states.
let fr_disc = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let hh = vec2(rad, rad)
    let dia = 2.0 * rad
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let cast = Finish.drop(p, c, hh, rad, vec2(dia * 0.06, dia * 0.08), dia * 0.14) * 0.6 * (1.0 - 0.5 * press) * mix(1.0, 0.4, dis)
    let ink = fr_shadow_ink()
    out = Finish.over(out, vec4(ink * cast, cast))
    let q = p - c
    let d = length(q) - rad
    let con = Finish.ring_out(d, 0.0, px, px) * 0.7
    out = Finish.over(out, vec4(vec3(0.024, 0.026, 0.016) * con, con))
    var face = g3(fr_conic(q, px, 0.50, 0.80, 0.12 * hover))
    face = face * vec3(1.0, 0.99, 0.95)
    face = face + g3(0.08 * hover - 0.05 * press)
    face = mix(face, mix(g3(0.28), face * 0.45, 0.5), dis)
    // chamfer: a bright ring two device pixels wide, brightest at the foot
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    let ch = mix(vec3(0.78, 0.79, 0.80), vec3(0.96, 0.97, 0.97), smoothstep(0.35, 1.0, t))
    face = mix(face, vec3(0.349, 0.365, 0.369), Finish.band(d, 2.0 * px, 3.0 * px, px) * 0.9)
    face = mix(face, mix(ch, g3(0.32), dis), Finish.band(d, 0.0, 2.0 * px, px) * 0.9)
    face = mix(face, vec3(0.42, 0.43, 0.45), Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. A cap of dark olive-grey set in a bright steel ring: from the
// outside in, a dark outer edge, three device pixels of steel lit along its
// top run, one black device pixel of gap, then the cap with its own lit lip
// and dark foot. Pressed, the cap drops into the ring: its lip goes dark,
// the ring's shadow falls over its top and the face darkens. `kind` picks
// the dressing: 0 flat cap (no ring, no soft layer), 1 ringed cap,
// 2 ringed with a lit amber lamp at its head (primary), 3 the lamp unlit
// (secondary), 4 a dark red lens (danger), 5 the steel ring alone (outline),
// 6 bare until touched, 7 an olive plate with a black edge (tertiary). The
// quad is grown by `m` on every side for the shadow and the focus ring.
let fr_lamp_lens = fn(p: vec2, c: vec2, rad: float, px: float, ink: vec3, lit: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    let a = Finish.cover(d, px)
    let rr = clamp(length(q - vec2(-0.25, -0.35) * rad) / max(rad, 0.001), 0.0, 1.4)
    // lit: a white-hot middle, the lamp's colour, a deeper rim
    let on = mix(mix(ink, vec3(1.0, 0.97, 0.88), 0.62), ink * 0.72, smoothstep(0.05, 1.05, rr))
    // unlit: dark glass in the lamp's hue with one small reflection
    var off = mix(ink * 0.26, ink * 0.12, smoothstep(0.0, 1.0, rr))
    let spec = 1.0 - smoothstep(0.0, 0.35 * rad, length(q - vec2(-0.3, -0.35) * rad))
    off = off + g3(0.10 * spec)
    let col = mix(off, on, lit)
    var out = vec4(col * a, a)
    // the socket: a black ring, then a thin steel collar
    let sock = Finish.ring_out(d, 0.0, px, px) * 0.85
    out = Finish.over(vec4(fr_bezel() * sock, sock), out)
    let up = 1.0 - smoothstep(-0.4 * rad, 0.4 * rad, q.y)
    let col2 = Finish.ring_out(d, px, 2.0 * px, px) * 0.9
    out = Finish.over(vec4(fr_steel(up) * col2, col2), out)
    // the light it throws on what is round it
    let ha = lit * 0.5 * exp(-max(d, 0.0) / (1.6 * px + rad * 0.35)) * step(0.0, d) * (1.0 - a)
    return Finish.over(out, vec4(ink * ha, ha))
}

let fr_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live * (1.0 - press)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fr_rbox(p, c, h, r)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let outl = step(4.5, kind) * step(kind, 5.5)
    let pad = step(6.5, kind)
    let flat = 1.0 - step(0.5, kind)
    let solid = 1.0 - bare - outl
    // the ring: three device pixels of steel, one of black gap
    let ringed = (1.0 - pad) * (1.0 - flat) * (1.0 - bare)
    let rw = mix(4.0, 6.0, step(25.5, size.y)) * px * ringed
    let gw = px * ringed
    let edge = rw + gw
    let soft_on = step(0.5, kind) * solid

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = fr_shadow_ink()
    // the soft layer: mostly below, gone within the gap to the next row
    let soft = Finish.drop(p, c, h, r, vec2(0.3, 2.2), 2.2) * 0.55 * soft_on * live
    out = Finish.over(out, vec4(ink * soft, soft))
    // the contact line right under the edge
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px * 1.2) * 0.75 * solid * mix(1.0, 0.5, disabled)
    out = Finish.over(out, vec4(ink * con, con))
    // a dark seam all round a ringed cap, where the ring meets the case
    let seam = Finish.ring_out(d, 0.0, 2.0 * px, px) * 0.55 * ringed * solid * live
    out = Finish.over(out, vec4(ink * seam, seam))

    // the cap
    let t = clamp((p.y - lo.y - edge) / max(2.0 * h.y - 2.0 * edge, 1.0), 0.0, 1.0)
    let yi = p.y - lo.y - edge
    var face = fr_face(t)
    if pad > 0.5 {
        face = mix(vec3(0.290, 0.302, 0.227), vec3(0.235, 0.247, 0.184), t)
    }
    face = face + g3(0.050 * hov)
    // pressed: the cap sits a device pixel lower in its ring, darker, with
    // the ring's shadow over its top
    let sunk = mix(vec3(0.047, 0.051, 0.035), fr_face(t) * 0.62, smoothstep(0.0, 3.0 * px + 1.2, yi))
    face = mix(face, sunk, press)
    face = mix(face, vec3(0.188, 0.196, 0.153), disabled)
    // paint wear on the cap: grain and a fine mottle
    let q = p + o
    face = face * (1.0 + fr_paint(q * 2.3, px) * 1.2) + g3(fr_grain(q / px, 0.016))
    // the cap's lit lip: one device pixel, then a short ramp into the face
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    let topw = 1.0 - smoothstep(lo.y + edge + r + 0.5, lo.y + edge + r + 1.5, p.y)
    let botw = smoothstep(hi.y - edge - r - 1.5, hi.y - edge - r - 0.5, p.y)
    let lip_d = d + edge
    let hl_row = Finish.band(lip_d, 0.0, px, px) * topw
    let ramp = (1.0 - smoothstep(0.0, 2.5, yi - px)) * step(0.0, yi) * 0.35
    let hl = mix(vec3(0.408, 0.412, 0.353), vec3(0.459, 0.463, 0.400), hov)
    let lit_top = max(hl_row, ramp) * (1.0 - press) * live
    face = mix(face, hl, lit_top * mix(1.0, 0.7, pad))
    // the cap's foot line
    face = mix(face, vec3(0.071, 0.075, 0.051), Finish.band(lip_d, 0.0, px, px) * botw * (1.0 - press))
    // the black gap round the cap
    face = mix(face, fr_bezel(), Finish.band(d, rw, edge, px) * ringed)
    // the steel ring, round in section: its outer half faces the light on
    // the top run and its inner half on the foot, brushed along its length
    let e = 0.5
    let gx = fr_rbox(p + vec2(e, 0.0), c, h, r) - fr_rbox(p - vec2(e, 0.0), c, h, r)
    let gy = fr_rbox(p + vec2(0.0, e), c, h, r) - fr_rbox(p - vec2(0.0, e), c, h, r)
    let nout = normalize(vec2(gx, gy) + vec2(0.0001, 0.0001))
    let sd = clamp(-d / max(rw, 0.001), 0.0, 1.0)
    let tilt = (0.5 - sd) * 2.0
    let lite = clamp(0.5 - nout.y * tilt * 0.75 - nout.x * tilt * 0.15, 0.0, 1.0)
    var steel = mix(vec3(0.150, 0.153, 0.130), vec3(0.600, 0.605, 0.565), smoothstep(0.0, 1.0, lite))
    steel = steel * (0.92 + 0.16 * Finish.brushed(q, vec2(1.0, 0.0), px)) + g3(fr_grain(q / px, 0.02))
    // a specular glint where the top run faces the light most
    steel = steel + g3(0.16 * smoothstep(0.82, 1.0, lite))
    steel = steel + g3(0.07 * hov)
    steel = mix(steel, mix(face, steel, 0.35), disabled)
    face = mix(face, steel, Finish.band(d, 0.0, rw, px) * ringed)
    // the outer edge: a dark device pixel all round, darkest at the foot
    let outer = mix(vec3(0.047, 0.051, 0.035), vec3(0.157, 0.161, 0.133), up)
    face = mix(face, outer, Finish.band(d, 0.0, px, px))
    if pad > 0.5 || flat > 0.5 {
        face = mix(face, fr_bezel(), Finish.band(d, 0.0, px, px) * 0.9)
    }

    // the lamp of the primary, secondary and danger faces, at the head
    if kind > 1.5 && kind < 4.5 {
        let is_red = step(3.5, kind)
        let lit = step(kind, 2.5) * live
        let lk = mix(fr_acc(), fr_red(), is_red)
        let lc = vec2(Finish.snap(o.x + lo.x + edge + 5.0, px) - o.x, Finish.snap(o.y + c.y, px) - o.y + press * px)
        let lamp = fr_lamp_lens(p, lc, 2.1, px, mix(lk, fr_off(), disabled), lit)
        face = face * (1.0 - lamp.a) + lamp.rgb
    }

    var fa = 1.0
    if bare > 0.5 {
        fa = mix(0.0, 0.55, hov) + 0.45 * press
    }
    let a = Finish.cover(d, px) * fa
    // the outline: the ring alone, the ground showing inside
    var oa = a
    if outl > 0.5 {
        oa = a * (1.0 - smoothstep(edge - 0.5 * px, edge + 0.5 * px, -d)) + a * press * 0.6 + a * hov * 0.12
        oa = min(oa, a)
    }
    out = Finish.over(out, vec4(face * oa, oa))

    out = Finish.over(out, fr_focus(d, px, focus * live))

    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        let k = fr_acc()
        sdf.fill(vec4(k * loading, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The drop-down face: the raised face with an engraved split 22 points
// from its right end (1 dpx dark, 1 dpx light, inset a fifth of the height)
// and a stroked chevron 6 by 3.5 points behind it; `held` is pressed.
let fr_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, disabled: float, m: float) -> vec4 {
    var out = fr_button(pos, size, o, px, hover, held, focus, disabled, 0.0, 0.0, 4.0, 1.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    // the split: a steel bar across the cap from ring to ring, black on
    // each side, as if the key were a second cap in the same ring
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let y0 = Finish.snap(o.y, px) - o.y + 3.0 * px
    let y1 = Finish.snap(o.y + size.y, px) - o.y - 3.0 * px
    let in_y = step(y0, p.y) * step(p.y, y1)
    let bl = (step(dx - 2.0 * px, p.x) * step(p.x, dx - px) + step(dx + px, p.x) * step(p.x, dx + 2.0 * px)) * in_y
    let st = step(dx - px, p.x) * step(p.x, dx + px) * in_y
    let bz = fr_bezel()
    out = Finish.over(out, vec4(bz * bl, bl))
    let up = clamp(1.0 - (p.y - y0) / max(y1 - y0, 1.0), 0.0, 1.0)
    out = Finish.over(out, vec4(fr_steel(up) * st, st) * mix(1.0, 0.6, disabled))
    let cc = vec2(size.x - 10.5, Finish.snap(o.y + size.y * 0.5, px) - o.y + held * live * px)
    let ch = Finish.cover(fr_chevron(p, cc, 6.0, 3.5, 0.0) - 0.7, px)
    let ink = mix(mix(vec3(0.824, 0.784, 0.647), vec3(0.925, 0.890, 0.769), hover * live), vec3(0.431, 0.424, 0.345), disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the raised faces grow their quad for the shadow and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fr_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 4.0, 0.0, 0.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
