// HELD STATES. The stock tracks write the pointer's hover and the press as
// snapped values, and a snapped value never arrives when a state is held
// from the start (a still page, a restored screen): a held button showed
// rest, a held press only the hover. The same states with plain values and
// a snapped entry look and move the same under a live pointer, and hold.
let tm_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
tm_held_states(mod.widgets.ButtonFlat)
tm_held_states(mod.widgets.CheckBoxFlat)
tm_held_states(mod.widgets.ToggleFlat)
tm_held_states(mod.widgets.RadioButtonFlat)
tm_held_states(mod.widgets.RadioButtonTabFlat)
tm_held_states(mod.widgets.TextInputFlat)
tm_held_states(mod.widgets.DropDownFlat)

