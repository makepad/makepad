mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fill = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down * self.hover)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, self.down * self.hover)
    let acol = self.arrow_color.mix(self.arrow_color_hover, self.hover)
    return tm_field(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, fill, stroke, 1.0, 1.0, acol)
}
mod.widgets.ComboBoxFlat.draw_popup_bg.color = #0e1e09
mod.widgets.ComboBoxFlat.draw_popup_bg.border_color = #43862b
