    d.color_hover = #163507
    d.color_focus = #0f2403
    d.color_down = #163507
    d.color_disabled = #040603
    d.color_2 = vec4(-1.0, -1.0, -1.0, -1.0)
    d.border_color = #43862b
    d.border_color_hover = #60c83e
    d.border_color_focus = #98ff20
    d.border_color_down = #98ff20
    d.border_color_disabled = #1d4611
    d.border_color_2 = vec4(-1.0, -1.0, -1.0, -1.0)
    d.arrow_color = #6ee747
    d.arrow_color_hover = #98ff20
    d.arrow_color_focus = #98ff20
    d.arrow_color_down = #98ff20
    d.arrow_color_disabled = #1d4611
}
tm_dropdown_inks(mod.widgets.DropDownFlat.draw_bg)
