mod.widgets.SliderFader.draw_bg.handle_color_focus = #98ff20

// The minimal slider: the same line, and a one-cell tick for a handle that
// grows into the block under the pointer.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let val = self.val_color
        .mix(self.val_color_hover.mix(self.val_color_drag, self.drag), self.hover)
        .mix(self.val_color_disabled, self.disabled)
    let handle = self.handle_color
        .mix(self.handle_color_hover.mix(self.handle_color_drag, self.drag), self.hover)
        .mix(self.handle_color_disabled, self.disabled)
    let hw = mix(2.0, 6.0, max(self.hover, self.drag))
    return tm_slider_line(p, self.rect_pos, self.rect_size, self.offset_y, px, self.slide_pos, lo, hi, hw, 5.0, val, handle, 0.0, self.focus, self.drag, self.disabled)
}

// The bar form (the round slider): a framed bar, one pixel of line, one
// pixel clear, the fill a solid accent block from the left, the empty part
