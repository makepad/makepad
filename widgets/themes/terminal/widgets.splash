mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fill = self.color
        .mix(self.color_hover, self.hover * (1.0 - self.active))
        .mix(self.color_active, max(self.active, self.down))
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_active, self.active)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, self.down)
        .mix(self.border_color_disabled, self.disabled)
    return tm_button(self.pos, self.rect_size, self.rect_pos, px, fill, stroke, 1.0, self.hover, self.down, self.focus, self.disabled, 0.0, 0.0, vec4(0.596, 1.0, 0.125, 1.0), 0.05 * self.active, 7.0)
}
