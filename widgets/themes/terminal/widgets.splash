// The mark box of a check box, radio or toggle: where it stands in the quad.
// `w` its width, `hgt` its height; `at_end` puts it after the label.
let tm_markbox = fn(size: vec2, o: vec2, w: float, hgt: float, at_end: float, px: float) -> vec4 {
    let x = (size.x - w) * at_end
    let y = size.y * 0.5 - hgt * 0.5
    return tm_snapbox(o, vec2(x, y), vec2(x + w, y + hgt), px)
}

mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = tm_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let sb = tm_markbox(self.rect_size, self.rect_pos, self.size, self.size, self.mark_at_end, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    let fill = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_active, self.active)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_active, self.active)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, self.down)
        .mix(self.border_color_error, self.error)
        .mix(self.border_color_disabled, self.disabled)
    let mark0 = self.mark_color
        .mix(self.mark_color_hover, self.hover)
        .mix(self.mark_color_active, self.active)
        .mix(self.mark_color_error, self.error * self.active)
    let mark = vec4(mix(mark0.rgb, self.mark_color_disabled.rgb, self.disabled), mark0.a)
    let ink = vec3(0.596, 1.0, 0.125)

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // The halo of the line under the pointer, and of the held box.
    let ha = tm_halo(d, max(0.05 * self.hover, 0.08 * self.down) * live)
    out = vec4(ink * ha, ha)
    let inside = Finish.cover(d, px)
    out = tm_over(out, vec4(fill.rgb * fill.a * inside, fill.a * inside))
    // An error hatches the box: one pixel on the diagonal every three.
    let hatch = Finish.stripes(p + self.rect_pos, 0.785398, 3.0 * px, 0.34, px) * inside * self.error * 0.3
    out = tm_over(out, vec4(stroke.rgb * hatch, hatch))
    var line = Finish.band(d, 0.0, px, px)
    line = max(line, Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * self.error)
    let la = line * stroke.a
    out = tm_over(out, vec4(stroke.rgb * la, la))
    // On: a lit block. Mixed: a bar. Both inverse while held.
    let hold = self.down * live
    let blk = Finish.cover(tm_box(p, c, h - vec2(3.0, 3.0)), px) * mark.a * (1.0 - self.mixed)
    let bar = Finish.cover(tm_box(p, c, vec2(h.x - 3.0, 1.0)), px) * self.mixed * self.mark_color_mixed.a
    let mk = max(blk, bar)
    let mink = mix(mix(mark.rgb, self.mark_color_mixed.rgb, self.mixed), self.mark_color_disabled.rgb, self.disabled)
    let mcol = mix(mink, vec3(0.016, 0.024, 0.012), hold)
    out = tm_over(out, vec4(mcol * mk, mk))
    // Focus: the keyline two pixels out.
    let kf = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * self.focus * live * (1.0 - self.error)
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false

// TOGGLES. A 28 by 12 track, one pixel of line green round a well; the knob
// a 10 by 8 block two points in, dim at the left when off, lit at the right
// when on; the side it has left is a fifty per cent checker of the dim ink.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 36.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.3333
mod.widgets.ToggleFlat.draw_bg.knob_inset = 2.0
mod.widgets.ToggleFlat.draw_bg.color = #0f2403
mod.widgets.ToggleFlat.draw_bg.color_hover = #0f2403
mod.widgets.ToggleFlat.draw_bg.color_down = #0f2403
mod.widgets.ToggleFlat.draw_bg.color_active = #0f2403
mod.widgets.ToggleFlat.draw_bg.color_focus = #0f2403
mod.widgets.ToggleFlat.draw_bg.color_disabled = #040603
mod.widgets.ToggleFlat.draw_bg.mark_color = #2e5d1d
mod.widgets.ToggleFlat.draw_bg.mark_color_hover = #43862b
mod.widgets.ToggleFlat.draw_bg.mark_color_down = #98ff20
mod.widgets.ToggleFlat.draw_bg.mark_color_active = #98ff20
mod.widgets.ToggleFlat.draw_bg.mark_color_active_hover = #b7f588
mod.widgets.ToggleFlat.draw_bg.mark_color_disabled = #1d4611
mod.widgets.Toggle.draw_bg.border_color = #60c83e
mod.widgets.Toggle.draw_bg.border_color_hover = #98ff20
mod.widgets.Toggle.draw_bg.border_color_down = #98ff20
mod.widgets.Toggle.draw_bg.border_color_active = #60c83e
mod.widgets.Toggle.draw_bg.border_color_focus = #98ff20
mod.widgets.Toggle.draw_bg.border_color_disabled = #1d4611
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let tw = self.size * self.pill_aspect
    let sb = tm_markbox(self.rect_size, self.rect_pos, tw, self.size, self.mark_at_end, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    let fill = self.color
        .mix(self.color_active, self.active)
        .mix(self.color_hover, self.hover)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_active, self.active)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, self.down)
        .mix(self.border_color_error, self.error)
        .mix(self.border_color_disabled, self.disabled)
    let knob_col = self.mark_color
        .mix(self.mark_color_hover, self.hover)
        .mix(self.mark_color_active, self.active)
        .mix(self.mark_color_down, self.down)
        .mix(self.mark_color_disabled, self.disabled)
    let ink = vec3(0.596, 1.0, 0.125)
    // The knob: 10 by 8, travelling 14 points; it follows the pointer while
    // dragged.
    let t = mix(self.active, self.drag_pos, self.drag)
    let ki = self.knob_inset
    let kw = 10.0
    let kh = h.y * 2.0 - ki * 2.0
    let kx = Finish.snap(sb.x + self.rect_pos.x + ki + t * (h.x * 2.0 - ki * 2.0 - kw), px) - self.rect_pos.x
    let kc = vec2(kx + kw * 0.5, c.y)
    let kd = tm_box(p, kc, vec2(kw * 0.5, kh * 0.5))

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // A lit knob throws the family's halo; nothing else here does.
    let ha = tm_halo(kd, max(0.05 * self.active * self.hover, 0.08 * self.down) * live) * (1.0 - Finish.cover(d, px))
    out = vec4(ink * ha, ha)
    let inside = Finish.cover(d, px)
    out = tm_over(out, vec4(fill.rgb * fill.a * inside, fill.a * inside))
    // The side the knob has left: a one pixel checker, dim.
    let cell = floor((p + self.rect_pos) / px)
    let chk = step(0.5, fract((cell.x + cell.y) * 0.5))
    let slot = Finish.cover(tm_box(p, c, h - vec2(ki, ki)), px) * (1.0 - Finish.cover(kd + ki * 0.5, px))
    let ca = chk * slot * mix(0.55, 0.3, self.disabled)
    out = tm_over(out, vec4(vec3(0.18, 0.365, 0.114) * ca, ca))
    let la = Finish.band(d, 0.0, px, px) * stroke.a
    out = tm_over(out, vec4(stroke.rgb * la, la))
    let ka = Finish.cover(kd, px) * knob_col.a
    // the lit block carries a hotter top pixel row
    let top = Finish.band(p.y - (kc.y - kh * 0.5), -px, 0.0, px) * self.active * 0.08
    out = tm_over(out, vec4(mix(knob_col.rgb, vec3(1.0, 1.0, 1.0), top) * ka, ka))
    let kf = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * self.focus * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}

// RADIOS. A 12 point diamond drawn in one pixel of line green; on, a lit
// 6 point diamond inside it.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 8.0 top: 5.0 bottom: 5.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 20.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = 12.0
mod.widgets.RadioButtonFlat.draw_bg.color = #00000000
mod.widgets.RadioButtonFlat.draw_bg.color_hover = #98ff201a
mod.widgets.RadioButtonFlat.draw_bg.color_down = #98ff20
mod.widgets.RadioButtonFlat.draw_bg.color_active = #00000000
mod.widgets.RadioButtonFlat.draw_bg.color_focus = #00000000
mod.widgets.RadioButtonFlat.draw_bg.color_disabled = #00000000
mod.widgets.RadioButtonFlat.draw_bg.mark_color = #00000000
mod.widgets.RadioButtonFlat.draw_bg.mark_color_active = #98ff20
mod.widgets.RadioButtonFlat.draw_bg.mark_color_disabled = #1d4611
mod.widgets.RadioButton.draw_bg.border_color = #60c83e
mod.widgets.RadioButton.draw_bg.border_color_hover = #98ff20
mod.widgets.RadioButton.draw_bg.border_color_down = #98ff20
mod.widgets.RadioButton.draw_bg.border_color_active = #60c83e
mod.widgets.RadioButton.draw_bg.border_color_focus = #98ff20
mod.widgets.RadioButton.draw_bg.border_color_disabled = #1d4611
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let g = tm_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let sb = tm_markbox(self.rect_size, self.rect_pos, self.size, self.size, 0.0, px)
    let c = (sb.xy + sb.zw) * 0.5
    let r = (sb.z - sb.x) * 0.5
    let q = abs(p - c)
    // true distance to a diamond of half-diagonal r
    let d = (q.x + q.y - r) * 0.70711
    let fill = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_active, self.active)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_active, self.active)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, self.down)
        .mix(self.border_color_disabled, self.disabled)
    let mark0 = self.mark_color.mix(self.mark_color_active, self.active)
    let mark = vec4(mix(mark0.rgb, self.mark_color_disabled.rgb, self.disabled), mark0.a)
    let ink = vec3(0.596, 1.0, 0.125)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ha = tm_halo(d, max(0.05 * self.hover, 0.08 * self.down) * live)
    out = vec4(ink * ha, ha)
    let inside = Finish.cover(d, px)
    out = tm_over(out, vec4(fill.rgb * fill.a * inside, fill.a * inside))
    let la = Finish.band(d, 0.0, px, px) * stroke.a
    out = tm_over(out, vec4(stroke.rgb * la, la))
    let md = (q.x + q.y - r * 0.5) * 0.70711
    let ma = Finish.cover(md, px) * mark.a
    let mcol = mix(mark.rgb, vec3(0.016, 0.024, 0.012), self.down * live)
    out = tm_over(out, vec4(mcol * ma, ma))
    let kf = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * self.focus * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false

