// ---------------------------------------------------------------------------
// TABS. Outlined cells a row tall sharing their one pixel lines; the tab in
// use is filled (inverse) and is the one lit thing of the strip. A rule in
// the frame green runs under the strip.
mod.widgets.Tabs.height = 24.0
mod.widgets.Tabs.draw_bg.color = #00000000
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let la = Finish.band(p.y - yb, 0.0, px, px)
    return vec4(vec3(0.263, 0.525, 0.169) * la, la)
}
let tm_tab_face = fn(pos: vec2, size: vec2, o: vec2, px: float, fill: vec4, stroke: vec3, glow: float) -> vec4 {
    let m = 7.0
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    // the box runs one pixel past the right edge, so neighbours share it
    let sb = tm_snapbox(o, vec2(0.0, 0.0), size + vec2(px, 0.0), px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    let ink = vec3(0.596, 1.0, 0.125)
    let ha = tm_halo(d, glow)
    var out = vec4(ink * ha, ha)
    let inside = Finish.cover(d, px)
    let top = Finish.band(p.y - sb.y, -px, 0.0, px) * step(0.5, fill.a) * 0.08
    out = tm_over(out, vec4(mix(fill.rgb, vec3(1.0, 1.0, 1.0), top) * fill.a * inside, fill.a * inside))
    let la = Finish.band(d, 0.0, px, px)
    out = tm_over(out, vec4(stroke * la, la))
    return out
}
let tm_tab_vertex = fn(rp: vec2, rs: vec2) -> vec4 {
    return tm_grow(rp, rs, 7.0)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let g = tm_tab_vertex(self.rect_pos, self.rect_size)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return tm_tab_face(self.pos, self.rect_size, self.rect_pos, px, vec4(0.0, 0.0, 0.0, 0.0), vec3(0.263, 0.525, 0.169), 0.0)
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let g = tm_tab_vertex(self.rect_pos, self.rect_size)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return tm_tab_face(self.pos, self.rect_size, self.rect_pos, px, vec4(0.596, 1.0, 0.125, 0.1), vec3(0.596, 1.0, 0.125), 0.0)
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let g = tm_tab_vertex(self.rect_pos, self.rect_size)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return tm_tab_face(self.pos, self.rect_size, self.rect_pos, px, vec4(0.455, 0.98, 0.294, 1.0), vec3(0.455, 0.98, 0.294), 0.05)
}
mod.widgets.Tabs.draw_sep.color = #00000000
mod.widgets.Tabs.draw_mark.color = #43862b
// The close mark is an x one cell wide at the right of its box, so it
// stands a cell clear of the label and a cell in from the tab's line; the
// add mark a one pixel plus in the middle of its own box.
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let is_plus = step(0.5, self.plus)
    let cx0 = mix(self.rect_size.x - 5.5, self.rect_size.x * 0.5, is_plus)
    let c = vec2(Finish.snap(o.x + cx0, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o + vec2(px * 0.5, px * 0.5)
    let q = p - c
    let r = mix(2.5, 3.5, is_plus)
    // the cross: two diagonals; the plus: two straight arms
    let x1 = abs(q.x - q.y) * 0.70711
    let x2 = abs(q.x + q.y) * 0.70711
    let inbox = step(max(abs(q.x), abs(q.y)), r + px * 0.5)
    let cross = max(Finish.cover(x1 - px * 0.5, px), Finish.cover(x2 - px * 0.5, px)) * inbox
    let plus = max(step(abs(q.x), px * 0.5) , step(abs(q.y), px * 0.5)) * inbox
    let a = mix(cross, plus, is_plus) * self.color.a
    return vec4(self.color.rgb * a, a)
}
mod.widgets.Tabs.draw_text.color = #6ee747
mod.widgets.Tabs.draw_text_active.color = #040603
mod.widgets.Tabs.draw_text.ink_centered = true
mod.widgets.Tabs.draw_text_active.ink_centered = true
// The strip shares its width among the tabs and sets every label 10
// points in from a fixed box, so the label type is a step under the body
// type: the longest label then has a cell of room on either side.
let tm_tab_type = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.0}
mod.widgets.Tabs.draw_text.text_style = tm_tab_type
mod.widgets.Tabs.draw_text_active.text_style = tm_tab_type
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false

// The segmented group: one frame round the row, the chosen cell inverse.
mod.widgets.SegmentedControlFlat.segment_height = 24.0
mod.widgets.SegmentedControlFlat.segment_padding = 8.0
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sb = tm_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    let la = Finish.band(d, 0.0, px, px)
    return vec4(vec3(0.263, 0.525, 0.169) * la, la)
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sb = tm_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    let a = Finish.cover(d, px)
    let top = Finish.band(p.y - sb.y, -px, 0.0, px) * 0.08
    return vec4(mix(vec3(0.455, 0.98, 0.294), vec3(1.0, 1.0, 1.0), top) * a, a)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #6ee747
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #040603
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_regular{}
// the chosen cell's letters are the palette's ink on the container
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #040603

// ---------------------------------------------------------------------------
// PROGRESS. An 8 point bar: a one pixel frame, two pixels clear, and a fill
// of lit cells four device pixels apart with a one pixel darker gap;
// the rest of the bar is ground. The indeterminate bar cannot move without
// a clock, so it stands still as a light-shade dither over the whole bar.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = 8.0
mod.widgets.ProgressBarFlat.draw_bg.border_radius = 0.0
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #98ff20
mod.widgets.ProgressBarFlat.draw_bg.color_success = #98ff20
mod.widgets.ProgressBarFlat.draw_bg.color_info = #98ff20
mod.widgets.ProgressBarFlat.draw_bg.color_warning = #98ff20
mod.widgets.ProgressBarFlat.draw_bg.color_error = #98ff20
mod.widgets.ProgressBarFlat.draw_bg.color_disabled = #1d4611
mod.widgets.ProgressBarFlat.draw_bg.track_color = #00000000
mod.widgets.ProgressBarFlat.draw_bg.border_color = #60c83e
mod.widgets.ProgressBar.draw_bg.border_color = #60c83e
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let hgt = min(self.thickness, self.rect_size.y)
    let y0 = (self.rect_size.y - hgt) * 0.5
    let x0 = self.rect_size.x * self.start
    let x1 = self.rect_size.x * self.end
    let sb = tm_snapbox(o, vec2(x0, y0), vec2(x1, y0 + hgt), px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    let fill = self.fill_color()
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.track > 0.5 {
        let la = Finish.band(d, 0.0, px, px) * self.border_color.a
        out = vec4(self.border_color.rgb * la, la)
        let ta = Finish.cover(d, px) * self.track_color.a * (1.0 - Finish.band(d, 0.0, px, px))
        out = tm_over(vec4(self.track_color.rgb * ta, ta), out)
    }
    // the inner field, three pixels in (one of line, two clear)
    let ih = h - vec2(3.0 * px, 3.0 * px)
    let inner = Finish.cover(tm_box(p, c, ih), px)
    let fx0 = c.x - ih.x
    let span = ih.x * 2.0
    if self.value >= 0.0 {
        let v = clamp((self.value - self.start) / max(self.end - self.start, 0.0001), 0.0, 1.0)
        let fx1 = Finish.snap(o.x + fx0 + v * span, px) - o.x
        let on = step(p.x, fx1) * inner
        // cells four device pixels apart (three lit, one gap in the darker
        // green), counted in whole window pixels so the pitch never beats
        let k = floor((p.x + o.x) / px + 0.001)
        let gap = step(0.7, fract(k * 0.25))
        let col = mix(fill.rgb, vec3(0.153, 0.549, 0.0), gap)
        let fa = on * fill.a
        out = tm_over(out, vec4(col * fa, fa))
    } else {
        let q = floor((p + o) / px)
        let dot = step(fract(q.x / 3.0), 0.2) * step(fract((q.y + floor(q.x / 3.0) * 1.5) / 3.0), 0.2)
        let da = dot * inner
        out = tm_over(out, vec4(fill.rgb * da, da))
    }
    return out * self.opacity
}

// LEVEL METERS. Cells 8 points long with 2 clear, 6 points across; the
// quiet run in the accent, amber from 70 %, red over the last 10 % -- the
// only other hues this palette allows, and only here. Unlit cells stand at
// a quarter of their ink; the held peak is one pixel across in the core ink.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.color_level = #98ff20
mod.widgets.LevelMeter.draw_bg.color_hot = #dd8b1b
mod.widgets.LevelMeter.draw_bg.color_mark = #b7f588
mod.widgets.LevelMeter.draw_bg.color_lamp = #ff2116
mod.widgets.LevelMeter.draw_bg.color_lamp_off = #1d4611
mod.widgets.LevelMeter.draw_bg.lamp_size = 6.0
mod.widgets.LevelMeter.draw_bg.lamp_gap = 4.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let along = mix(self.rect_size.x, self.rect_size.y, self.vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.vertical)
    let s = mix(self.pos.x * self.rect_size.x, (1.0 - self.pos.y) * self.rect_size.y, self.vertical)
    let q = mix(self.pos.y * self.rect_size.y, self.pos.x * self.rect_size.x, self.vertical)
    let lamp_room = self.lamp * (self.lamp_size + self.lamp_gap)
    let bar = max(4.0, along - lamp_room)
    let pitch = 10.0
    let n = floor((bar + 2.0) / pitch)
    let k = floor(s / pitch)
    let within = s - k * pitch
    let in_cell = step(within, pitch - 2.0) * step(k, n - 1.0) * step(0.0, s)
    let cw = min(6.0, across)
    let qa = (across - cw) * 0.5
    let in_q = step(qa, q) * step(q, qa + cw)
    // the scale share at the middle of this cell
    let share = (k + 0.5) / max(n, 1.0)
    let zone_amber = step(0.7, share)
    let zone_red = step(0.9, share)
    var ink = mix(self.color_level.rgb, self.color_hot.rgb, zone_amber)
    ink = mix(ink, vec3(1.0, 0.129, 0.086), zone_red)
    let lit = step(share, self.level + 0.5 / max(n, 1.0) - 0.0001) * step(0.0001, self.level)
    let col = mix(ink * 0.25, ink, lit)
    let a = in_cell * in_q
    var out = vec4(col * a, a)
    // the held peak: one pixel across the whole meter, in the core ink
    if self.hold > 0.002 {
        let at = floor(self.hold * bar)
        let pk = Finish.band(abs(s - at) - px * 0.5, 0.0, px, px) * in_q
        out = tm_over(out, vec4(self.color_mark.rgb * pk, pk))
    }
    if self.lamp > 0.5 {
        let lc = vec2(bar + self.lamp_gap + self.lamp_size * 0.5, across * 0.5)
        let ld = tm_box(vec2(s, q), lc, vec2(self.lamp_size * 0.5, 3.0))
        let on = step(0.5, self.over)
        let lcol = mix(self.color_lamp_off.rgb, self.color_lamp.rgb, on)
        // a lit lamp is whiter at its centre, and carries the halo
        let core = (1.0 - smoothstep(0.0, 2.5, length(vec2(s, q) - lc))) * 0.15 * on
        let ha = tm_halo(ld, 0.08 * on)
        out = tm_over(out, vec4(lcol * ha, ha))
        let la = Finish.cover(ld, px)
        out = tm_over(out, vec4(mix(lcol, vec3(1.0, 1.0, 1.0), core) * la, la))
    }
    return out * self.opacity
}

// SCROLL BARS. Half a cell wide: a light-shade dither of the disabled green
// for the track, a solid block for the thumb, lit while dragged.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.size = 8.0
mod.widgets.ScrollBar.draw_bg.color = #43862b
mod.widgets.ScrollBar.draw_bg.color_hover = #60c83e
mod.widgets.ScrollBar.draw_bg.color_drag = #98ff20
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let len = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let t = mix(p.x, p.y, self.is_vertical)
    let q = floor((p + self.rect_pos) / px)
    let dot = step(fract(q.x / 3.0), 0.2) * step(fract((q.y + floor(q.x / 3.0) * 1.5) / 3.0), 0.2)
    let da = dot * 0.9
    var out = vec4(vec3(0.114, 0.275, 0.067) * da, da)
    let t0 = len * self.norm_scroll
    let t1 = t0 + len * self.norm_handle
    let on = Finish.cover(max(t0 - t, t - t1), px)
    let col = self.color.mix(self.color_hover, self.hover).mix(self.color_drag, self.drag)
    out = tm_over(out, vec4(col.rgb * on, on))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SURFACES. Flat rectangles, never slabs. The rounded view is square here.
mod.widgets.RoundedView.draw_bg.border_radius = 0.0
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let sb = tm_snapbox(self.rect_pos, lo, hi, px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let inside = Finish.cover(d, px)
    var out = vec4(fill.rgb * fill.a * inside, fill.a * inside)
    if self.border_size > 0.0 {
        let la = Finish.band(d, 0.0, px, px) * self.border_color.a
        out = tm_over(out, vec4(self.border_color.rgb * la, la))
    }
    return out
}

// The panel ground: the panel green with scanlines (every other device row
// at 0.92) and a grain of about 0.004, both in window space.
let tm_ground = fn(base: vec3, p: vec2, o: vec2, px: float, dpi: float) -> vec3 {
    let w = p + o
    let s = tm_scan(w.y, dpi, 0.08)
    return base * s + vec3(1.0, 1.0, 1.0) * tm_grain(w, px, 0.01)
}

// Panels: a single box line of the frame green half a cell in from the edge.
// Sunken, the panel is an embedded screen: darker, a double line (the outer
// one at half strength), and three points of darkening under its top edge.
mod.widgets.PanelView.draw_bg.color = #0e1e09
mod.widgets.PanelView.draw_bg.border_radius = 0.0
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dpi = max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sunk = step(0.5, self.sunken)
    let base = mix(self.color.rgb, vec3(0.008, 0.016, 0.004), sunk)
    var col = tm_ground(base, p, o, px, dpi)
    let top = (1.0 - clamp(p.y / 3.0, 0.0, 1.0)) * 0.2 * sunk
    col = col * (1.0 - top)
    let sb = tm_snapbox(o, vec2(4.0, 4.0), self.rect_size - vec2(4.0, 4.0), px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    let frame = vec3(0.263, 0.525, 0.169)
    let l1 = Finish.band(d, 0.0, px, px)
    let l2 = Finish.band(d, 3.0 * px, 4.0 * px, px) * sunk
    col = mix(col, frame, max(l1 * mix(1.0, 0.5, sunk), l2))
    return vec4(col * self.color.a, self.color.a)
}

// Cards: the panel ground and one box line at the card's own edge.
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dpi = max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size3
    let o = self.rect_pos2
    let lo = self.sdf_rect_pos - vec2(self.border_size, self.border_size)
    let hi = lo + self.sdf_rect_size + vec2(2.0 * self.border_size, 2.0 * self.border_size)
    let sb = tm_snapbox(o, lo, hi, px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    var col = tm_ground(vec3(0.055, 0.118, 0.035), p, o, px, dpi)
    let layer = self.hover * 0.06 + self.down * 0.1
    col = mix(col, vec3(0.596, 1.0, 0.125), layer)
    col = mix(col, vec3(0.263, 0.525, 0.169), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}

// List rows: a row a line tall, no rules. The chosen row carries the dim
// bar and a lit block in its first half cell; the pointer lays a 12 % tint.
mod.widgets.ListItemOne.height = 24.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 12.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_text.color = #6ee747
mod.widgets.ListItem.draw_text_2.color = #4f9a33
mod.widgets.ListItem.draw_bg.color_selected = #1d4611
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var ground = mix(self.color, self.color_selected, self.selected)
    ground = vec4(ground.rgb, ground.a * mix(1.0, 0.4, self.disabled))
    let layer = (self.hover * 0.12 + self.down * 0.2) * (1.0 - self.disabled)
    var out = vec4(ground.rgb * ground.a, ground.a)
    out = tm_over(out, vec4(vec3(0.596, 1.0, 0.125) * layer, layer))
    let mark = step(p.x, Finish.snap(self.rect_pos.x + 4.0, px) - self.rect_pos.x) * self.selected
    out = tm_over(out, vec4(vec3(0.596, 1.0, 0.125) * mark, mark))
    return out
}

// The open list of a drop-down: the panel ground, the pointer's row a
// faint tint, the chosen row inverse.
mod.widgets.PopupMenuItem.draw_bg.color_hover = #98ff201f
mod.widgets.PopupMenuItem.draw_bg.color_active = #74fa4b
mod.widgets.PopupMenuItem.draw_text.color_active = #040603

// THE SPINNER. One cell of a console spinner, the slash of | / - \, one
// device pixel wide in the accent, no circle. A sheet may not read the
// pass clock and the spinner carries no other, so the slash stands still.
mod.widgets.SpinnerFlat.size = 16.0
mod.widgets.SpinnerFlat.draw_bg.color = #98ff20
mod.widgets.SpinnerFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    let q = p - c
    // a cell 8 wide and 16 tall: the slash runs corner to corner of its
    // inner 6 by 10
    let dir = normalize(vec2(3.0, -5.0))
    let along = clamp(dot(q, dir), -5.83, 5.83)
    let dl = length(q - dir * along) - px * 0.5
    let a = Finish.cover(dl, px) * self.color.a * self.alpha
    return vec4(self.color.rgb * a, a)
}

// Chips and badges are square cells too, in the one hue: a neutral mark is
// a dim block with the core ink, a tonal chip a well with the text ink.
mod.widgets.ChipFlat.radius = 0.0
// A chip is a cell row 24 points tall inside the 28 its size rung takes,
// boxed by one snapped device pixel of the frame green (its own stroke
// colour when it has one); the pointer lays the accent tint over it.
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let inset = max((self.rect_size.y - 24.0) * 0.5, 0.0)
    let sb = tm_snapbox(self.rect_pos, vec2(0.0, inset), self.rect_size - vec2(0.0, inset), px)
    let d = tm_box(p, (sb.xy + sb.zw) * 0.5, (sb.zw - sb.xy) * 0.5)
    let inside = Finish.cover(d, px)
    let layer = (self.hover * 0.1 + self.down * 0.2) * self.ink.a
    let fill = vec4(mix(self.color.rgb, vec3(0.596, 1.0, 0.125), layer), max(self.color.a, layer))
    var out = vec4(fill.rgb * fill.a * inside, fill.a * inside)
    let lined = step(0.001, self.border_size)
    let lc = mix(vec4(0.263, 0.525, 0.169, 1.0), self.border_color, lined)
    let la = Finish.band(d, 0.0, px, px) * lc.a
    out = tm_over(out, vec4(lc.rgb * la, la))
    let kf = Finish.band(d, -3.0 * px, -2.0 * px, px) * self.keyed
    out = tm_over(out, vec4(vec3(0.596, 1.0, 0.125) * kf, kf))
    return out
}
mod.widgets.BadgeFlat.shape = mod.widgets.BadgeShape.Square
mod.widgets.BadgePalette.neutral = #2e5d1d
mod.widgets.BadgePalette.on_neutral = #b7f588
mod.widgets.BadgePalette.neutral_container = #0f2403
mod.widgets.BadgePalette.on_neutral_container = #6ee747
true
