mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let ink = vec3(0.596, 1.0, 0.125)
    let sb = tm_snapbox(self.rect_pos, vec2(self.label_size, 0.0), self.rect_size, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    let stroke = self.border_color
        .mix(self.border_color_focus.mix(self.border_color_hover.mix(self.border_color_drag, self.drag), self.hover), self.focus)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_disabled, self.disabled)
    let val = self.val_color
        .mix(self.val_color_hover.mix(self.val_color_drag, self.drag), self.hover)
        .mix(self.val_color_disabled, self.disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let inside = Finish.cover(d, px)
    let well = self.color.mix(vec4(0.016, 0.024, 0.012, 1.0), self.disabled)
    out = tm_over(out, vec4(well.rgb * inside, inside))
    // the fill: inside the one pixel gap
    let ih = h - vec2(2.0 * px, 2.0 * px)
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let fx0 = Finish.snap(self.rect_pos.x + c.x - ih.x + lo * ih.x * 2.0, px) - self.rect_pos.x
    let fx1 = Finish.snap(self.rect_pos.x + c.x - ih.x + hi * ih.x * 2.0, px) - self.rect_pos.x
    let fd = tm_box(p, vec2((fx0 + fx1) * 0.5, c.y), vec2(max((fx1 - fx0) * 0.5, 0.0), ih.y))
    let fa = Finish.cover(fd, px) * val.a
    let topr = Finish.band(p.y - (c.y - ih.y), -px, 0.0, px) * 0.08 * live
    out = tm_over(out, vec4(mix(val.rgb, vec3(1.0, 1.0, 1.0), topr) * fa, fa))
    let la = Finish.band(d, 0.0, px, px) * stroke.a
    out = tm_over(out, vec4(stroke.rgb * la, la))
    let kf = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * self.focus * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.text_input.draw_text.color = #b7f588
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 4.0 right: 4.0 top: 1.0 bottom: 1.0}
mod.widgets.RotaryFlat.text_input.min_height = 0.0

// FADERS. A one pixel rail in the frame green, lit accent below the cap; a
// ladder of one pixel dots every 4 points either side, a longer tick every
// fourth; the cap a 14 by 6 lit block cut across by one ground-coloured
// pixel line, the line the value is read off.
mod.widgets.SliderFader.cap_size = 6.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFaderY.width = 24.0
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let ink = vec3(0.596, 1.0, 0.125)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    // track space: `a` along from the value's zero, `b` across
    let a = mix(p.x, self.rect_size.y - p.y, self.is_vertical)
    let b = mix(p.y, p.x, self.is_vertical)
    let oa = mix(self.rect_pos.x, self.rect_pos.y, self.is_vertical)
    let ob = mix(self.rect_pos.y, self.rect_pos.x, self.is_vertical)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(ob + across * 0.5, px) - ob
    let val = self.val_color
        .mix(self.val_color_hover.mix(self.val_color_drag, self.drag), self.hover)
        .mix(self.val_color_disabled, self.disabled)
    let cap = self.handle_color
        .mix(self.handle_color_focus, self.focus)
        .mix(self.handle_color_hover.mix(self.handle_color_drag, self.drag), self.hover)
        .mix(self.handle_color_disabled, self.disabled)
    let dim = mix(vec3(0.18, 0.365, 0.114), vec3(0.114, 0.275, 0.067), self.disabled)
    let frame = mix(vec3(0.263, 0.525, 0.169), vec3(0.114, 0.275, 0.067), self.disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let on_track = step(self.inset_px, a) * step(a, along - self.inset_px)
    // the ladder
    let da = a - foot
    let k = floor(da / 4.0 + 0.5)
    let near = abs(da - k * 4.0)
    let dotl = Finish.band(near - px * 0.5, 0.0, px, px) * step(0.0, da + 0.5) * step(da, travel + 0.5)
    let off = abs(b - mid)
    let major = step(fract(k / 4.0 + 0.01), 0.1)
    let ldot = Finish.band(off - 3.0, -px, 0.0, px)
    let ltick = step(2.5, off) * step(off, 5.5) * major
    let lad = dotl * max(ldot, ltick)
    out = tm_over(out, vec4(dim * lad, lad))
    // the rail, lit where the value has filled it
    let rail = Finish.cover(abs(b - mid - px * 0.5) - px * 0.5, px) * on_track
    let lo = foot + self.fill_lo * travel
    let hi = foot + self.fill_hi * travel
    let lit = step(lo, a) * step(a, hi)
    let rcol = mix(frame, val.rgb, lit)
    out = tm_over(out, vec4(rcol * rail, rail))
    // the cap
    let cap_w = 14.0
    // The cap's centre on a device pixel edge in window space, whichever
    // way the fader lies (a vertical one counts `a` up from its foot).
    let at = foot + self.slide_pos * travel
    let ca_h = Finish.snap(oa + at, px) - oa
    let ca_v = along - (Finish.snap(oa + along - at, px) - oa)
    let ca = mix(ca_h, ca_v, self.is_vertical)
    let cd = tm_box(vec2(a, b), vec2(ca, mid + px * 0.5), vec2(self.cap_px * 0.5, cap_w * 0.5))
    let ha = tm_halo(cd, 0.08 * self.drag * live)
    out = tm_over(out, vec4(ink * ha, ha))
    // A solid lit block of whole device pixels: nine along, one of them the
    // ground-coloured centre line, and 21 across, centred on the rail.
    let half = floor(self.cap_px * 0.5 / px)
    let blk = step(ca - half * px, a) * step(a, ca + (half + 1.0) * px) * step(mid - 10.0 * px, b) * step(b, mid + 11.0 * px)
    let cov = blk * cap.a
    let cut = step(ca, a) * step(a, ca + px)
    let ccol = mix(cap.rgb, vec3(0.016, 0.024, 0.012), cut)
    out = tm_over(out, vec4(ccol * cov, cov))
    let kf = Finish.ring_out(cd, 2.0 * px, 3.0 * px, px) * max(self.hover, self.focus) * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}

// ---------------------------------------------------------------------------
// KNOBS. The one permitted curve: a thin drawn ring. Round it a 270 degree
// arc of block segments, one pixel apart, lit accent up to the value and
// the disabled green beyond; a straight pointer in the hot core ink. No
// cap, no bevel, no shading.
let tm_knob = fn(p: vec2, c: vec2, rad: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let ink = vec3(0.596, 1.0, 0.125)
    let v = p - c
    let r = length(v)
    // angle from straight down, clockwise on screen, 0..2 pi
    var th = atan2(-v.x, v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let start = gap * 0.5 * PI / 180.0
    let sweep = 2.0 * PI - gap * PI / 180.0
    let t = (th - start) / sweep
    let n = 24.0
    let rin = rad * 0.89
    let rout = rad * 0.98
    let rmid = (rin + rout) * 0.5
    let seg = floor(t * n)
    let seglen = sweep * rmid / n
    let f = fract(t * n) * seglen
    let in_seg = step(f, seglen - px) * step(0.0, t) * step(t, 1.0)
    let band = Finish.cover(max(rin - r, r - rout), px) * in_seg
    let lo = min(origin, slide) * arc_origin
    let hi = mix(slide, max(origin, slide), arc_origin)
    let sc = (seg + 0.5) / n
    let lit = step(lo, sc) * step(sc, hi + 0.5 / n - 0.0001) * live
    let unlit = vec3(0.114, 0.275, 0.067)
    let bright = mix(ink, vec3(0.718, 0.961, 0.533), drag)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // halo of the lit arc while it is turned
    let bd = max(rin - r, r - rout)
    let tv = clamp((th - start) / sweep, 0.0, 1.0)
    let ha = tm_halo(bd, 0.08 * drag * live) * step(lo, tv) * step(tv, hi) * step(0.0, t) * step(t, 1.0)
    out = vec4(ink * ha, ha)
    let col = mix(unlit, bright, lit)
    let ba = band
    out = tm_over(out, vec4(col * ba, ba))
    // the drawn ring
    let frame = mix(vec3(0.263, 0.525, 0.169), vec3(0.596, 1.0, 0.125), hover * live)
    // one device pixel: the strip within half a pixel of the ring radius
    let ring = Finish.band(abs(r - rad * 0.6) - px * 0.5, 0.0, px, px) * mix(1.0, 0.5, disabled)
    out = tm_over(out, vec4(frame * ring, ring))
    // the pointer
    let av = start + sweep * slide
    let dir = vec2(-sin(av), cos(av))
    let along = clamp(dot(v, dir), rad * 0.12, rad * 0.54)
    let pd = length(v - dir * along) - px * 0.75
    let pa = Finish.cover(pd, px)
    let pcol = mix(vec3(0.718, 0.961, 0.533), unlit, disabled)
    out = tm_over(out, vec4(pcol * pa, pa))
    // focus: the keyline ring two pixels out
    let kf = Finish.band(abs(r - rad - 2.5 * px), -px * 0.5, px * 0.5, px) * focus * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}

mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y)
    let rad = dia * 0.5 - 2.0
    let c = vec2(self.rect_size.x * 0.5, self.rect_size.y - dia * 0.5)
    return tm_knob(p, c, rad, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y - 24.0)
    let rad = dia * 0.5 - 2.0
    let c = vec2(self.rect_size.x * 0.5, 24.0 + dia * 0.5)
    return tm_knob(p, c, rad, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}

// ---------------------------------------------------------------------------
// FIELDS. A flat well in one pixel of frame green; the pointer brings the
// line green, focus the accent; no inner shadow. A field that a host has
// made invisible (the value field inside a slider) stays invisible: the face
// draws only what its colours carry.
let tm_field = fn(p: vec2, o: vec2, size: vec2, px: float, fill: vec4, stroke: vec4, lined: float, arrow: float, acol: vec4) -> vec4 {
    let sb = tm_snapbox(o, vec2(0.0, 0.0), size, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let inside = Finish.cover(d, px)
    out = vec4(fill.rgb * fill.a * inside, fill.a * inside)
    let la = Finish.band(d, 0.0, px, px) * stroke.a * step(0.001, lined)
    out = tm_over(out, vec4(stroke.rgb * la, la))
    if arrow > 0.5 {
        // a solid down triangle in the last cell, no divider
        let ac = vec2(Finish.snap(o.x + size.x - 11.0, px) - o.x, Finish.snap(o.y + size.y * 0.5 + 2.0, px) - o.y)
        let q = p - ac
        let td = max(-2.0 - q.y, (abs(q.x) - (2.0 - q.y) * 0.9) * 0.74)
        let ta = Finish.cover(td, px) * acol.a
        out = tm_over(out, vec4(acol.rgb * ta, ta))
    }
    return out
}

mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fill = self.color
        .mix(self.color_empty, self.empty)
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover.mix(self.color_down, self.down), self.hover)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_empty, self.empty)
        .mix(self.border_color_hover.mix(self.border_color_down, self.down), self.hover)
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_disabled, self.disabled)
    return tm_field(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, fill, stroke, self.border_size, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
let tm_field_inks = fn(d) {
    d.color = #0f2403
    d.color_hover = #0f2403
    d.color_focus = #0f2403
    d.color_down = #0f2403
    d.color_empty = #0f2403
    d.color_disabled = #040603
    d.border_color = #43862b
    d.border_color_hover = #60c83e
    d.border_color_focus = #98ff20
    d.border_color_down = #98ff20
    d.border_color_empty = #43862b
    d.border_color_disabled = #1d4611
}
tm_field_inks(mod.widgets.TextInputFlat.draw_bg)
tm_field_inks(mod.widgets.TextInput.draw_bg)
mod.widgets.TextInputFlat.draw_text.color_empty = #43862b
mod.widgets.TextInputFlat.draw_text.color_empty_hover = #4f9a33
mod.widgets.TextInputFlat.draw_text.color_empty_focus = #43862b
// The caret is the underline block of a console: one cell wide, three
// device pixels tall at the foot of the cell, lit. (A full block is drawn
// after the letters here and cannot turn the letter under it to the
// ground, so it would hide it.)
mod.widgets.TextInputFlat.draw_cursor.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(vec2(self.rect_pos.x + 1.0, self.rect_pos.y + self.rect_size.y - 2.0), vec2(7.5, 2.0))
}
mod.widgets.TextInputFlat.draw_cursor.pixel = fn() {
    let a = (1.0 - self.blink) * self.focus * (1.0 - self.disabled)
    return vec4(self.color.rgb * a, a)
}
mod.widgets.TextInputFlat.draw_selection.border_radius = 0.0

// The number field draws its own box the same way; its step column is two
// dim cells split by one pixel of frame.
mod.widgets.NumberField.draw_bg.color = #0f2403
mod.widgets.NumberField.draw_bg.color_hover = #0f2403
mod.widgets.NumberField.draw_bg.color_focus = #0f2403
mod.widgets.NumberField.draw_bg.color_disabled = #040603
mod.widgets.NumberField.draw_bg.border_color = #43862b
mod.widgets.NumberField.draw_bg.border_color_focus = #98ff20
mod.widgets.NumberField.draw_bg.border_color_disabled = #1d4611
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fill = self.color
        .mix(self.color_hover, self.hover)
        .mix(self.color_focus, self.focus)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(vec4(0.376, 0.784, 0.243, 1.0), self.hover)
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_disabled, self.disabled)
    return tm_field(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, fill, stroke, 1.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.NumberSpin.draw_bg.color = #00000000
mod.widgets.NumberSpin.draw_bg.color_hover = #98ff201a
mod.widgets.NumberSpin.draw_bg.color_down = #98ff20
mod.widgets.NumberSpin.draw_bg.color_disabled = #00000000
mod.widgets.NumberSpin.draw_bg.rule_color = #43862b
mod.widgets.NumberSpin.draw_bg.rule_color_disabled = #1d4611
mod.widgets.NumberSpin.draw_bg.rule = 0.67
mod.widgets.NumberSpin.draw_text.color = #6ee747
mod.widgets.NumberSpin.draw_text.color_disabled = #1d4611

// DROP-DOWNS. The field, with a solid down triangle in its last cell.
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 8.0 right: 22.0 top: 2.5 bottom: 2.5}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fill = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down * self.hover)
        .mix(self.color_disabled, self.disabled)
    let stroke = self.border_color
        .mix(self.border_color_focus, self.focus)
        .mix(self.border_color_hover, self.hover)
        .mix(self.border_color_down, max(self.down * self.hover, self.active))
        .mix(self.border_color_disabled, self.disabled)
    let acol = self.arrow_color
        .mix(self.arrow_color_focus, self.focus)
        .mix(self.arrow_color_hover.mix(self.arrow_color_down, self.down), self.hover)
        .mix(self.arrow_color_disabled, self.disabled)
    return tm_field(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, fill, stroke, 1.0, 1.0, acol)
}
let tm_dropdown_inks = fn(d) {
