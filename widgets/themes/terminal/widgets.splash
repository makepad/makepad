use mod.prelude.widgets_internal.*

// A text interface: one face, one ink, drawn in character cells.
// Box lines one device pixel wide, snapped to the pixel grid; square
// corners; state as inverse video. The only light is the halo of a lit
// element, drawn outside its box and gone within a third of a row.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 2.5 bottom: 2.5}
mod.widgets.ButtonFlat.min_height = 24.0
mod.widgets.ButtonFlat.spacing = 6.0
mod.widgets.Button.draw_bg.border_radius = 0.0
mod.widgets.Button.draw_bg.border_size = 0.34
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons stand at the same 24.
let field_height = 24.0
let field_pad_v = 2.5
let field_radius = 0.0
let field_border = 0.34

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #040603

// Plain views stop clipping, so a halo or a focus keyline may fall into the
// gap beside a control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

// A square box.
let tm_box = fn(p: vec2, c: vec2, h: vec2) -> float {
    let q = abs(p - c) - h
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0)))
}

// The halo of a lit element: a gaussian of sigma 1.7 points outside its
// edge, at `amp` of the core at the edge, cut to nothing at 7 points.
// `amp` is held at 0.10 or under: 9 % one device pixel out, 2 % at 3 points.
let tm_halo = fn(d: float, amp: float) -> float {
    let o = max(d, 0.0)
    return amp * exp(-o * o / 5.78) * (1.0 - smoothstep(5.0, 7.0, o)) * step(0.0, d)
}

// Scanlines: every other device row of the screen a shade darker, counted
// in window space so they run on unbroken from one surface to the next.
let tm_scan = fn(y: float, dpi: float, depth: float) -> float {
    return 1.0 - depth * step(0.5, fract(floor(y * dpi) * 0.5))
}

// The screen's grain, one value per device pixel, zero mean.
let tm_grain = fn(q: vec2, px: float, amount: float) -> float {
    return Finish.grain(q / px, amount)
}

// Premultiplied source-over.
let tm_over = fn(dst: vec4, src: vec4) -> vec4 {
    return src + dst * (1.0 - src.a)
}

// A box snapped to whole device pixels in window space, in the quad's
// local points: .xy the low corner, .zw the high one.
let tm_snapbox = fn(o: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    let a = vec2(Finish.snap(o.x + lo.x, px), Finish.snap(o.y + lo.y, px)) - o
    let b = vec2(Finish.snap(o.x + hi.x, px), Finish.snap(o.y + hi.y, px)) - o
    return vec4(a.x, a.y, b.x, b.y)
}

// Dotted line pattern: one device pixel on, two off, along `t` points.
let tm_dots = fn(t: float, px: float) -> float {
    return step(fract(floor(t / px) / 3.0), 0.2)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; the template's own colours pick the
// dressing. `frame`: 0 none, 1 single line, 2 double line, 3 dotted line.
// The quad is grown by 7 points on every side for the halo and the focus
// keyline, which cost no layout.
let tm_button = fn(pos: vec2, size: vec2, o: vec2, px: float, fill0: vec4, stroke0: vec4, frame: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, glow_ink: vec4, glow_rest: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    // A waiting button is not a held one: it goes back to the outline form,
    // a line-green box round a clear face, whatever face it wore.
    let fill = vec4(fill0.rgb, fill0.a * (1.0 - loading))
    let stroke = mix(stroke0, vec4(0.376, 0.784, 0.243, 1.0), loading)
    let sb = tm_snapbox(o, vec2(0.0, 0.0), size, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = tm_box(p, c, h)

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // The halo: at rest only where the template asks, under the pointer a
    // little, while held the most (0.08 at the edge, the family's ceiling
    // being 0.10 one pixel out). Never on a disabled face.
    let lit = max(fill.a, stroke.a)
    let amp = max(glow_rest, max(0.05 * hover, 0.08 * down)) * live * lit
    let ha = tm_halo(d, amp)
    out = vec4(glow_ink.rgb * ha, ha)

    // The face, flat, with the hotter top device row a lit block carries.
    let inside = Finish.cover(d, px)
    let top = Finish.band(p.y - sb.y, -px, 0.0, px) * step(0.5, fill.a) * 0.08
    let face = vec4(mix(fill.rgb, vec3(1.0, 1.0, 1.0), top) , fill.a)
    out = tm_over(out, vec4(face.rgb * face.a * inside, face.a * inside))

    // The box line.
    var line = Finish.band(d, 0.0, px, px)
    if frame > 1.5 {
        // double: one pixel, two clear, one pixel
        line = max(line, Finish.band(d, 3.0 * px, 4.0 * px, px))
    }
    if frame > 2.5 {
        // dotted along x on the top and bottom lines, along y on the sides
        let side = step(abs(p.y - c.y) - h.y, abs(p.x - c.x) - h.x)
        let t = mix(p.x, p.y, side) + mix(o.x, o.y, side)
        line = Finish.band(d, 0.0, px, px) * tm_dots(t + 0.01 * px, px)
    }
    let la = line * stroke.a * max(step(0.5, frame), loading)
    out = tm_over(out, vec4(stroke.rgb * la, la))

    // Focus: a keyline one pixel wide, two pixels clear of the face.
    let kf = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * focus * live
    out = tm_over(out, vec4(glow_ink.rgb * kf, kf))

    // The wait spinner, which the stock face drew and this one must too: a
    // bar turning in four steps, the way a console spins | / - \, in the
    // first cell, in front of the dimmed label.
    if loading > 0.0 {
        let step4 = floor(anim * 4.0) * 0.25 * PI
        let dir = vec2(sin(step4), -cos(step4))
        let q = p - vec2(sb.x + 4.5, c.y)
        let along = clamp(dot(q, dir), -3.0, 3.0)
        let dl = length(q - dir * along) - 0.5 * px
        let sa = Finish.cover(dl, px) * loading
        out = tm_over(out, vec4(vec3(0.596, 1.0, 0.125) * sa, sa))
    }
    return out
}

// The label of a waiting button stays, in the disabled green, instead of
// fading out under the spinner.
mod.widgets.ButtonFlat.draw_text.get_color = fn() {
    let ink = self.color
        .mix(self.color_focus, self.focus)
        .mix(self.color_hover, self.hover)
        .mix(self.color_down, self.down)
        .mix(self.color_disabled, self.disabled)
    return vec4(mix(ink.rgb, vec3(0.114, 0.275, 0.067), self.loading), ink.a)
}

let tm_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The frame kind and the halo at rest are the template's own.
mod.widgets.ButtonFlat.draw_bg.frame = uniform(1.0)
mod.widgets.ButtonFlat.draw_bg.glow_rest = uniform(0.0)
mod.widgets.ButtonFlat.draw_bg.glow_ink = uniform(#98ff20)
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = tm_grow(self.rect_pos, self.rect_size, 7.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return tm_button(self.pos, self.rect_size, self.rect_pos, px, self.face_fill(), self.face_stroke(), self.frame, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.glow_ink, self.glow_rest, 7.0)
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false

