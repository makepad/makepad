// ---------------------------------------------------------------------------
// SLIDERS. The line form: a one pixel track across the middle of the track
// row, solid accent on the filled side and a dotted dim line on the rest,
// and a solid 8 by 14 block for the handle. The pointer draws the keyline
// two pixels round the block; a drag lights it.
let tm_slider_line = fn(p: vec2, o: vec2, size: vec2, top: float, px: float, slide: float, lo: float, hi: float, hw: float, hh: float, val: vec4, handle: vec4, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let ink = vec3(0.596, 1.0, 0.125)
    let yc = Finish.snap(o.y + top + (size.y - top) * 0.5, px) - o.y
    let x0 = hw * 0.5
    let span = max(size.x - hw, 1.0)
    let hx = Finish.snap(o.x + x0 + slide * span, px) - o.x
    let fx0 = x0 + lo * span
    let fx1 = x0 + hi * span
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the track row: one device pixel under the centre line
    let row = Finish.band(p.y - yc, -px, 0.0, px) * step(0.0, p.x) * step(p.x, size.x)
    let filled = step(fx0, p.x) * step(p.x, fx1)
    let dot = tm_dots(p.x + o.x, px) * (1.0 - filled)
    let ta = row * filled * val.a
    out = tm_over(out, vec4(val.rgb * ta, ta))
    let da = row * dot * mix(1.0, 0.6, disabled)
    let dim = vec3(0.18, 0.365, 0.114)
    out = tm_over(out, vec4(dim * da, da))
    // the handle block
    let hc = vec2(hx, yc - px * 0.5)
    let hd = tm_box(p, hc, vec2(hw * 0.5, hh * 0.5))
    let ha = tm_halo(hd, 0.08 * drag * live)
    out = tm_over(out, vec4(ink * ha, ha))
    let ba = Finish.cover(hd, px) * handle.a
    let topr = Finish.band(p.y - (hc.y - hh * 0.5), -px, 0.0, px) * 0.08 * live
    out = tm_over(out, vec4(mix(handle.rgb, vec3(1.0, 1.0, 1.0), topr) * ba, ba))
    let kf = Finish.ring_out(hd, 2.0 * px, 3.0 * px, px) * max(hover, focus) * live
    out = tm_over(out, vec4(ink * kf, kf))
    return out
}

mod.widgets.SliderFlat.draw_bg.handle_size = 8.0
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = tm_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let val = self.val_color
        .mix(self.val_color_focus, self.focus)
        .mix(self.val_color_hover.mix(self.val_color_drag, self.drag), self.hover)
        .mix(self.val_color_disabled, self.disabled)
    let handle = self.handle_color
        .mix(self.handle_color_focus, self.focus)
        .mix(self.handle_color_hover.mix(self.handle_color_drag, self.drag), self.hover)
        .mix(self.handle_color_disabled, self.disabled)
    return tm_slider_line(p, self.rect_pos, self.rect_size, 20.0, px, self.slide_pos, lo, hi, self.handle_size, 14.0, val, handle, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
let tm_slider_inks = fn(d) {
    d.val_color = #98ff20
    d.val_color_hover = #98ff20
    d.val_color_focus = #98ff20
    d.val_color_drag = #b7f588
    d.val_color_disabled = #1d4611
    d.handle_color = #74fa4b
    d.handle_color_hover = #98ff20
    d.handle_color_focus = #98ff20
    d.handle_color_drag = #b7f588
    d.handle_color_disabled = #1d4611
}
tm_slider_inks(mod.widgets.SliderMinimal.draw_bg)
tm_slider_inks(mod.widgets.SliderFlat.draw_bg)
tm_slider_inks(mod.widgets.Slider.draw_bg)
