use mod.prelude.widgets_internal.*

// A segment display on a pale glass: the face of a digital wristwatch and
// the screen of a handheld game console with a dot-matrix screen.
// The glass is flat and holds four shades and no more: ink, a dark and a
// light middle, and the pale ground; anything between them is a dither,
// never a veil. Every mark on it is ink, the unlit segments stay faintly
// there as ghosts, and the ink floats a hair above the reflector, so it
// throws a faint shadow down and to the left. Keys are pixel-framed tiles
// or inverse legends; groups are glass windows set in a dark frame with a
// light lip under it. A state is a flag, a filled segment or an inverse
// legend. Nothing glows.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 2.5 bottom: 2.5}
mod.widgets.ButtonFlat.min_height = 24.0
mod.widgets.ButtonFlat.spacing = 6.0
mod.widgets.Button.draw_bg.border_radius = 1.5
mod.widgets.Button.draw_bg.border_size = 0.34
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons stand at the same 24.
let field_height = 24.0
let field_pad_v = 2.5
let field_radius = 1.5
let field_border = 0.34

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #9ca388

// Plain views stop clipping, so a frame, a lip, an ink shadow or a focus
// ring may fall into the gap beside a control. Scroll views keep theirs.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points; `o` the quad's origin in the window.

// The four shades of the glass, the ghost between the two palest, the lit
// glass of an inverted legend, and the dark frame of a window.
let lcd_ink = fn() -> vec3 { return vec3(0.161, 0.169, 0.125) }
let lcd_dark = fn() -> vec3 { return vec3(0.337, 0.353, 0.275) }
let lcd_mid = fn() -> vec3 { return vec3(0.478, 0.502, 0.396) }
let lcd_ghost = fn() -> vec3 { return vec3(0.553, 0.576, 0.482) }
let lcd_glass = fn() -> vec3 { return vec3(0.635, 0.663, 0.557) }
// The page is the glass a step down; a window's glass a step up from it.
let lcd_ground = fn() -> vec3 { return vec3(0.612, 0.639, 0.533) }
let lcd_wglass = fn() -> vec3 { return vec3(0.682, 0.710, 0.604) }
let lcd_lit = fn() -> vec3 { return vec3(0.714, 0.741, 0.635) }
let lcd_frame = fn() -> vec3 { return vec3(0.110, 0.114, 0.129) }
let lcd_red = fn() -> vec3 { return vec3(0.639, 0.149, 0.110) }

let lcd_g3 = fn(v: float) -> vec3 { return vec3(v, v, v) }

// A box of true radius r.
let lcd_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let q = abs(p - c) - h + vec2(r, r)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r
}

// Premultiplied source-over.
let lcd_over = fn(dst: vec4, src: vec4) -> vec4 {
    return src + dst * (1.0 - src.a)
}

// A box snapped to whole device pixels in window space, in the quad's
// local points: .xy the low corner, .zw the high one.
let lcd_snapbox = fn(o: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    let a = vec2(Finish.snap(o.x + lo.x, px), Finish.snap(o.y + lo.y, px)) - o
    let b = vec2(Finish.snap(o.x + hi.x, px), Finish.snap(o.y + hi.y, px)) - o
    return vec4(a.x, a.y, b.x, b.y)
}

let lcd_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The centre of the device pixel p lies in, in local points: shapes tested
// there come out as hard pixel art, stairs and all.
let lcd_pix = fn(p: vec2, o: vec2, px: float) -> vec2 {
    return (floor((p + o) / px + vec2(0.001, 0.001)) + vec2(0.5, 0.5)) * px - o
}

// Dithers, counted in window pixels: a checker (half), and one pixel in
// four (quarter).
let lcd_checker = fn(p: vec2, o: vec2, px: float) -> float {
    let q = floor((p + o) / px + vec2(0.001, 0.001))
    return step(0.5, fract((q.x + q.y) * 0.5))
}
let lcd_quarter = fn(p: vec2, o: vec2, px: float) -> float {
    let q = floor((p + o) / px + vec2(0.001, 0.001))
    return step(0.5, fract(q.x * 0.5)) * step(0.5, fract(q.y * 0.5))
}

// A straight segment from a to b: the distance to its axis.
let lcd_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The shadow ink throws on the reflector, given the mark's distance at p
// moved back by the throw (-0.75, +1.0): a blur of a point and a half,
// about a seventh of the ink at the mark, gone within five device pixels.
let lcd_inkshade = fn(ds: float, amt: float) -> float {
    return (1.0 - smoothstep(-1.0, 2.5, ds)) * amt
}
let lcd_throw = fn() -> vec2 { return vec2(-0.75, 1.0) }

// A dashed ring one device pixel wide, `gap` points outside a box edge:
// two device pixels on, two off, counted in window pixels along the side.
// It is the focus mark of every control.
let lcd_dash_ring = fn(d: float, p: vec2, c: vec2, h: vec2, o: vec2, gap: float, px: float) -> float {
    let ring = Finish.band(-(d - gap - px), 0.0, px, px)
    let side = step(abs(p.y - c.y) - h.y, abs(p.x - c.x) - h.x)
    let t = mix(p.x + o.x, p.y + o.y, side)
    let on = step(fract(floor(t / px + 0.01) * 0.25), 0.3)
    return ring * on
}

// The glass in window points: the base, a sheen lighter toward the upper
// right, a one-device-pixel grain that never repeats, and the faint pixel
// matrix of the panel, one device pixel dots every two points.
let lcd_glass_at = fn(base: vec3, w: vec2, px: float, sheen: float) -> vec3 {
    var col = base * (1.0 + sheen)
    col = col + lcd_g3(Finish.grain(w / px, 0.022))
    let cell = floor(w / px + vec2(0.01, 0.01))
    let dot = step(fract(cell.x / 3.0), 0.1) * step(fract(cell.y / 3.0), 0.1)
    col = col - lcd_g3(0.02 * dot)
    return col
}

// A 5 by 7 dot-matrix letter: O, N or F (0, 1, 2), one bit per row in each
// of five columns, the top row the lowest bit. `q` counts device pixels
// from the letter's top left.
let lcd_letter = fn(ch: float, q: vec2) -> float {
    let col = q.x
    var c0 = 62.0
    var c1 = 65.0
    var c2 = 65.0
    var c3 = 65.0
    var c4 = 62.0
    if ch > 0.5 {
        c0 = 127.0
        c1 = 4.0
        c2 = 8.0
        c3 = 16.0
        c4 = 127.0
    }
    if ch > 1.5 {
        c0 = 127.0
        c1 = 9.0
        c2 = 9.0
        c3 = 9.0
        c4 = 1.0
    }
    let v = c0 * step(col, 0.5) + c1 * step(0.5, col) * step(col, 1.5) + c2 * step(1.5, col) * step(col, 2.5) + c3 * step(2.5, col) * step(col, 3.5) + c4 * step(3.5, col) * step(col, 4.5)
    let bit = step(0.5, fract(floor(v / pow(2.0, q.y) + 0.001) * 0.5))
    return bit * step(0.0, q.x) * step(q.x, 4.5) * step(0.0, q.y) * step(q.y, 6.5)
}
// A word of dot-matrix letters, "OFF" (0) or "ON" (1), set with its top
// left at `at` (a window-snapped point); coverage at p, in whole pixels.
let lcd_word = fn(p: vec2, o: vec2, at: vec2, px: float, word: float) -> float {
    let q = floor((p + o) / px + vec2(0.001, 0.001)) - floor((at + o) / px + vec2(0.5, 0.5))
    let k = floor(q.x / 6.0)
    let lq = vec2(q.x - k * 6.0, q.y)
    let n = mix(3.0, 2.0, word)
    // OFF: O F F; ON: O N
    let ch = mix(mix(0.0, 2.0, step(0.5, k)), mix(0.0, 1.0, step(0.5, k)), word)
    return lcd_letter(ch, lq) * step(0.0, k) * step(k, n - 0.5)
}

// A small seven-segment numeral row: the scale numbers 0 25 50 75 100 (k
// = 0..4), each set on its tick, the first flush left and the last flush
// right. Returns coverage, and .y the distance to the nearest number's
// extent (for the rule that joins them).
let lcd_scale_numbers = fn(p: vec2, x0: float, x1: float, y0: float, dh: float, px: float) -> vec2 {
    let span = max(x1 - x0, 1.0)
    let k = clamp(floor((p.x - x0) / (span * 0.25) + 0.5), 0.0, 4.0)
    let ax = x0 + k * span * 0.25
    let n = mix(mix(1.0, 2.0, step(0.5, k)), 3.0, step(3.5, k))
    let adv = dh * 0.68
    let cw = dh * 0.5
    let w = (n - 1.0) * adv + cw
    let align = mix(mix(0.0, 0.5, step(0.5, k)), 1.0, step(3.5, k))
    let left = ax - w * align
    let j = floor((p.x - left) / adv)
    let u = (p.x - left - j * adv) / cw
    // the digits of 0, 25, 50, 75, 100
    var dg = 0.0
    if k > 0.5 && k < 1.5 {
        dg = mix(2.0, 5.0, step(0.5, j))
    }
    if k > 1.5 && k < 2.5 {
        dg = mix(5.0, 0.0, step(0.5, j))
    }
    if k > 2.5 && k < 3.5 {
        dg = mix(7.0, 5.0, step(0.5, j))
    }
    if k > 3.5 {
        dg = mix(1.0, 0.0, step(0.5, j))
    }
    let uv = vec2(u, (p.y - y0) / dh)
    let inside = step(0.0, j) * step(j, n - 0.5) * step(0.0, u) * step(u, 1.0)
    let a = Finish.seg7(uv, dg, px / dh) * inside
    let ext = max(left - p.x, p.x - (left + w))
    return vec2(a, ext)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; the template picks the kind:
// 0 a cell drawn in ink on the glass, framed by `frame` (0 none, 1 a
//   one-pixel outline, 2 a dashed outline, 3 an ink rule under the word);
// 1 a pixel-framed tile, the frame two device pixels of ink with stepped
//   corners; 2 the inverse tile, filled with ink, lit glass letters;
// 3 the warning tile, its frame and word printed in red on the glass,
//   filled red while held; 4 a tile framed twice.
// Under the pointer a glass face lays the checker dither; pressed, it
// inverts; an inverse face turns back to glass.
// The quad is grown 5 points for the ink shadow and the focus ring.
let lcd_button_face = fn(p: vec2, sb: vec4, o: vec2, px: float, kind: float, frame: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let held = down * live
    let pq = lcd_pix(p, o, px)
    let tile = step(0.5, kind)
    // the stepped outline of a tile, tested on pixel centres; a cell is
    // square
    let k = mix(0.01, 3.0 * px, tile)
    let dq = Finish.sd_chamfer(pq, c, h, k)
    let d = mix(lcd_rbox(p, c, h, 0.01), dq, tile)
    let inside = mix(Finish.cover(d, px), step(dq, 0.0), tile)
    let inverse = step(1.5, kind) * step(kind, 2.5)
    let red = step(2.5, kind) * step(kind, 3.5)
    let under = step(2.5, frame) * (1.0 - tile)
    // what is filled: the inverse tile at rest, any glass face while held;
    // the inverse tile turns to glass while held
    let solid = mix(held, 1.0 - held, inverse)
    // the rule under the word of the tonal cell: the label's width and two
    // points either side, three points under its foot
    let uy = Finish.snap(o.y + c.y + 6.5, px) - o.y
    let ux0 = sb.x + 8.0
    let ux1 = sb.z - 8.0
    let uc = vec2((ux0 + ux1) * 0.5, uy + px * 0.5)
    let uh = vec2(max((ux1 - ux0) * 0.5, 1.0), px * 0.5)
    let ul = step(ux0, p.x) * step(p.x, ux1) * step(uy, p.y) * step(p.y, uy + px) * under * (1.0 - solid)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the ink's shadow on the reflector: of the fill, of the frame, of the
    // rule; a held key lies flat
    let th = lcd_throw()
    let ds = Finish.sd_chamfer(p - th, c, h, k)
    let framed = max(tile, step(0.5, frame) * step(frame, 2.5))
    let shf = lcd_inkshade(ds, 0.14) * solid * (1.0 - inside) * (1.0 - held)
    let shl = lcd_inkshade(abs(ds + px) - px, 0.14) * framed * (1.0 - solid) * (1.0 - inside)
    let shu = lcd_inkshade(lcd_rbox(p - th, uc, uh, 0.01), 0.14) * under * (1.0 - solid) * (1.0 - ul)
    let sh = max(max(shf, shl), shu) * live
    out = vec4(lcd_ink() * sh, sh)
    // the band under the pointer: a checker of the light middle
    let chk = lcd_checker(p, o, px)
    let ba = inside * chk * hover * live * (1.0 - solid)
    out = lcd_over(out, vec4(lcd_mid() * ba, ba))
    // the fill: ink, or on the warning tile the printed red
    var fcol = mix(lcd_ink(), lcd_dark(), 0.35 * hover * live * inverse)
    fcol = mix(fcol, lcd_red(), red)
    let fa = inside * solid
    let fill = mix(fcol, lcd_mid(), disabled * inverse)
    out = lcd_over(out, vec4(fill * fa, fa))
    // the frame
    var line = 0.0
    // a tile: two device pixels of stepped ink
    line = max(line, step(dq, 0.0) * step(-2.0 * px, dq) * tile * (1.0 - inverse))
    // twice: an inner line two pixels further in
    line = max(line, step(dq, -3.0 * px) * step(-4.0 * px, dq) * step(3.5, kind))
    // a cell: one device pixel, solid or dashed
    var cl = Finish.band(d, 0.0, px, px) * step(0.5, frame) * step(frame, 2.5) * (1.0 - tile)
    let side = step(abs(p.y - c.y) - h.y + 1.0, abs(p.x - c.x) - h.x + 1.0)
    let t = mix(p.x + o.x, p.y + o.y, side)
    let dash = step(fract(floor(t / px + 0.01) * 0.25), 0.3)
    cl = cl * mix(1.0, dash, step(1.5, frame))
    line = max(line, cl)
    line = max(line, ul)
    // the inverse tile's frame shows while it is held (turned to glass)
    line = max(line, step(dq, 0.0) * step(-2.0 * px, dq) * inverse * held)
    let lcol = mix(mix(lcd_ink(), lcd_red(), red), lcd_mid(), disabled)
    let la = line * (1.0 - solid * (1.0 - inverse))
    out = lcd_over(out, vec4(lcol * la, la))
    // the inverse tile under the pointer: a glass keyline two pixels in
    let kl = step(dq, -2.0 * px) * step(-3.0 * px, dq) * inverse * hover * live * (1.0 - held)
    out = lcd_over(out, vec4(lcd_lit() * kl, kl))
    // focus: a dashed ink ring two points out
    let kf = lcd_dash_ring(d, p, c, h, o, 2.0, px) * focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}

// The wait spinner the stock face drew, which this one must draw too: eight
// segments round the middle of the face, the lit one walking on the
// button's own animation clock, the rest at ghost.
let lcd_wait = fn(p: vec2, c: vec2, px: float, anim: float, ink: vec3, ghost: vec3) -> vec4 {
    let v = p - c
    var th = atan2(v.x, -v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let k = floor(th / (PI * 0.25) + 0.5)
    let ang = k * PI * 0.25
    let dir = vec2(sin(ang), -cos(ang))
    let along = clamp(dot(v, dir), 2.5, 5.5)
    let dd = length(v - dir * along) - 0.75
    let a = Finish.cover(dd, px)
    let head = floor(fract(anim) * 8.0)
    let age = fract((head - k) / 8.0 + 1.0)
    let lit = max(1.0 - age * 3.0, 0.0)
    let col = mix(ghost, ink, lit)
    return vec4(col * a, a)
}

let lcd_button = fn(pos: vec2, size: vec2, o: vec2, px: float, kind: float, frame: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sb = lcd_snapbox(o, vec2(0.0, 0.0), size, px)
    var out = lcd_button_face(p, sb, o, px, kind, frame, hover, down, focus, disabled)
    if loading > 0.001 {
        let c = (sb.xy + sb.zw) * 0.5
        let dark = step(1.5, kind) * step(kind, 2.5)
        let ink = mix(lcd_ink(), lcd_lit(), dark)
        let ghost = mix(lcd_ghost(), lcd_dark(), dark)
        let w = lcd_wait(p, c, px, anim, ink, ghost)
        out = lcd_over(out, w * loading)
    }
    return out
}

mod.widgets.ButtonFlat.draw_bg.kind = uniform(0.0)
mod.widgets.ButtonFlat.draw_bg.frame = uniform(0.0)
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lcd_button(self.pos, self.rect_size, self.rect_pos, px, self.kind, self.frame, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 5.0)
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false

// Inks. On the glass: ink, turned to the lit glass when the face inverts.
mod.widgets.ButtonFlat.draw_text.color = #292b20
mod.widgets.ButtonFlat.draw_text.color_hover = #292b20
mod.widgets.ButtonFlat.draw_text.color_down = #b6bda2
mod.widgets.ButtonFlat.draw_text.color_focus = #292b20
mod.widgets.ButtonFlat.draw_text.color_disabled = #6c725c
mod.widgets.ButtonFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.ButtonFlat.draw_icon.color = #292b20
mod.widgets.ButtonFlat.icon_walk.width = 14.0

// The tiles: the standard key and everything cut from it. They are handed
// a draw object of their own, since most of them share the flat button's.
let lcd_tile_bg = mod.widgets.ButtonFlat.draw_bg{
    kind: 1.0
    frame: 0.0
}
let lcd_tiled = fn(w) {
    w.draw_bg = lcd_tile_bg
}
lcd_tiled(mod.widgets.Button)
lcd_tiled(mod.widgets.ButtonGradientX)
lcd_tiled(mod.widgets.ButtonGradientY)
lcd_tiled(mod.widgets.ButtonIcon)
lcd_tiled(mod.widgets.ButtonGradientXIcon)
lcd_tiled(mod.widgets.ButtonGradientYIcon)
lcd_tiled(mod.widgets.ButtonXs)
lcd_tiled(mod.widgets.ButtonSm)
lcd_tiled(mod.widgets.ButtonLg)
lcd_tiled(mod.widgets.ButtonXl)
lcd_tiled(mod.widgets.ButtonCompound)

// The primary: the inverse tile, the one filled key of a row.
mod.widgets.ButtonPrimary.draw_bg.kind = 2.0
mod.widgets.ButtonPrimary.draw_text.color = #b6bda2
mod.widgets.ButtonPrimary.draw_text.color_hover = #c6cdb2
mod.widgets.ButtonPrimary.draw_text.color_down = #292b20
mod.widgets.ButtonPrimary.draw_text.color_focus = #b6bda2
mod.widgets.ButtonPrimary.draw_text.color_disabled = #3a3d2e
mod.widgets.ButtonPrimary.draw_text.text_style = mod.theme.font_bold{}
mod.widgets.ButtonPrimary.draw_icon.color = #b6bda2

// The second action: the tile framed twice.
mod.widgets.ButtonSecondary.draw_bg.kind = 4.0
mod.widgets.ButtonSecondary.draw_text.color = #292b20
mod.widgets.ButtonSecondary.draw_text.color_hover = #292b20
mod.widgets.ButtonSecondary.draw_text.color_down = #b6bda2
mod.widgets.ButtonSecondary.draw_text.color_focus = #292b20
mod.widgets.ButtonSecondary.draw_text.color_disabled = #6c725c
mod.widgets.ButtonSecondary.draw_text.text_style = mod.theme.font_label{}
mod.widgets.ButtonSecondary.draw_icon.color = #292b20

// The tonal action: a bare word with an ink rule under it; the pointer
// lays the dither behind it, a press inverts it.
mod.widgets.ButtonTertiary.draw_bg.kind = 0.0
mod.widgets.ButtonTertiary.draw_bg.frame = 3.0
mod.widgets.ButtonTertiary.draw_text.color = #292b20
