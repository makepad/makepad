// HELD STATES. The stock tracks write the pointer's hover and the press as
// snapped values, and a snapped value never arrives when a state is held
// from the start (a still page, a restored screen). The same states with
// plain values and a snapped entry look and move the same under a live
// pointer, and hold.
let lcd_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
lcd_held_states(mod.widgets.ButtonFlat)
lcd_held_states(mod.widgets.CheckBoxFlat)
lcd_held_states(mod.widgets.ToggleFlat)
lcd_held_states(mod.widgets.RadioButtonFlat)
lcd_held_states(mod.widgets.RadioButtonTabFlat)
lcd_held_states(mod.widgets.TextInputFlat)
lcd_held_states(mod.widgets.DropDownFlat)

// ---------------------------------------------------------------------------
// CHECK BOXES. A 12 point box of one device pixel of ink; inside it the
// mark, a square segment 2.5 points in, at ghost when off and ink when on;
// mixed, a bar; an error hatches the box and doubles its line. Held, the
// whole box inverts.
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 5.0 bottom: 5.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 19.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 12.0
mod.widgets.CheckBoxFlat.draw_bg.border_size = 0.34
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 0.0
mod.widgets.CheckBoxFlat.draw_text.color_error = #292b20

// The mark box of a check box, radio or toggle: where it stands in the quad.
let lcd_markbox = fn(size: vec2, o: vec2, w: float, hgt: float, at_end: float, px: float) -> vec4 {
    let x = (size.x - w) * at_end
    let y = size.y * 0.5 - hgt * 0.5
    return lcd_snapbox(o, vec2(x, y), vec2(x + w, y + hgt), px)
}

mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let held = self.down * live
    let sb = lcd_markbox(self.rect_size, o, self.size, self.size, self.mark_at_end, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = lcd_rbox(p, c, h, 0.01)
    let inside = Finish.cover(d, px)
    let on = self.active * (1.0 - self.mixed)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the ink's shadow: the line's, or the held box's
    let ds = lcd_rbox(p - lcd_throw(), c, h, 0.01)
    let sh = mix(lcd_inkshade(abs(ds) - px * 0.5, 0.14), lcd_inkshade(ds, 0.14), held) * (1.0 - inside) * live
    out = vec4(lcd_ink() * sh, sh)
    // the pointer lays the light dither inside
    let chk = lcd_checker(p, o, px)
    let ba = inside * chk * self.hover * live * (1.0 - held)
    out = lcd_over(out, vec4(lcd_mid() * ba, ba))
    // an error hatches the box: one pixel on the diagonal every three
    let hatch = Finish.stripes(p + o, 0.785398, 3.0 * px, 0.34, px) * inside * self.error * (1.0 - held)
    out = lcd_over(out, vec4(lcd_dark() * hatch, hatch))
    // held, the box inverts
    let ia = inside * held
    out = lcd_over(out, vec4(lcd_ink() * ia, ia))
    // the line, doubled by an error
    var line = Finish.band(d, 0.0, px, px)
    line = max(line, Finish.ring_out(d, px, 2.0 * px, px) * self.error)
    let lcol = mix(lcd_ink(), lcd_mid(), self.disabled)
    let la = line
    out = lcd_over(out, vec4(lcol * la, la))
    // the mark: a square segment, or the bar of a mixed box; unlit, a ghost
    let inner = h - vec2(2.5, 2.5)
    let mk = Finish.cover(lcd_rbox(p, c, inner, 0.01), px) * (1.0 - self.mixed)
    let bar = Finish.cover(lcd_rbox(p, c, vec2(inner.x, 1.0), 0.01), px) * self.mixed
    let lit = max(mk * on, bar)
    let ghost = mk * (1.0 - on) * (1.0 - self.mixed)
    let gcol = mix(lcd_ghost(), vec3(0.604, 0.631, 0.529), self.disabled)
    let ga = ghost * (1.0 - held)
    out = lcd_over(out, vec4(gcol * ga, ga))
    let mcol = mix(mix(lcd_ink(), lcd_mid(), self.disabled), lcd_lit(), held)
    out = lcd_over(out, vec4(mcol * lit, lit))
    // focus: the dashed ring two points out
    let kf = lcd_dash_ring(d, p, c, h, o, 2.0, px) * self.focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false

// TOGGLES. A flag pair: two cells in one ink box, OFF and ON in dot-matrix
// capitals; the word that holds is an inverse legend, the other stands at
// ghost. Pressed, the other cell darkens toward its turn.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 41.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 4.0 bottom: 4.0}
mod.widgets.ToggleFlat.draw_bg.size = 16.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.125
mod.widgets.ToggleFlat.draw_bg.knob_inset = 1.0
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let held = self.down * live
    let tw = self.size * self.pill_aspect
    let sb = lcd_markbox(self.rect_size, o, tw, self.size, self.mark_at_end, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = lcd_rbox(p, c, h, 0.01)
    let inside = Finish.cover(d, px)
    // which word holds: follows the pointer while dragged
    let t = step(0.5, mix(self.active, self.drag_pos, self.drag))
    let mid = Finish.snap(o.x + c.x - px, px) - o.x
    let in_on = step(mid, p.x)
    let cur = mix(1.0 - in_on, in_on, t)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ds = lcd_rbox(p - lcd_throw(), c, h, 0.01)
    let sh = lcd_inkshade(abs(ds) - px * 0.5, 0.14) * (1.0 - inside) * live
    out = vec4(lcd_ink() * sh, sh)
    // the other cell: dithered under the pointer, darker while pressed
    let chk = lcd_checker(p, o, px)
    let other = inside * (1.0 - cur)
    let oa = other * chk * max(self.hover * live, held)
    let ocol = mix(lcd_mid(), lcd_dark(), held)
    out = lcd_over(out, vec4(ocol * oa, oa))
    // the cell that holds: an ink fill (a light middle while disabled)
    let fa = inside * cur
    let fcol = mix(lcd_ink(), lcd_mid(), self.disabled)
    out = lcd_over(out, vec4(fcol * fa, fa))
    // the box and the rule between the cells
    let rule = step(mid, p.x) * step(p.x, mid + px) * inside
    let la = max(Finish.band(d, 0.0, px, px), rule)
    let lcol = mix(lcd_ink(), lcd_mid(), self.disabled)
    out = lcd_over(out, vec4(lcol * la, la))
    // an error doubles the line
    let el = Finish.ring_out(d, px, 2.0 * px, px) * self.error
    out = lcd_over(out, vec4(lcd_ink() * el, el))
    // the words, 7 pixels tall, centred in their cells
    let yw = Finish.snap(o.y + c.y - 3.5 * px, px) - o.y
    let xoff = Finish.snap(o.x + (sb.x + mid) * 0.5 - 8.5 * px, px) - o.x
    let xon = Finish.snap(o.x + (mid + sb.z) * 0.5 - 5.5 * px, px) - o.x
    let w_off = lcd_word(p, o, vec2(xoff, yw), px, 0.0)
    let w_on = lcd_word(p, o, vec2(xon, yw), px, 1.0)
    let lit_col = mix(lcd_lit(), lcd_glass(), self.disabled)
    let ghost_col = mix(mix(lcd_mid(), lcd_dark(), 0.25), lcd_ghost(), 0.6 * self.disabled)
    let won = w_on * t + w_off * (1.0 - t)
    let wgh = w_on * (1.0 - t) + w_off * t
    out = lcd_over(out, vec4(ghost_col * wgh, wgh))
    out = lcd_over(out, vec4(lit_col * won, won))
    let kf = lcd_dash_ring(d, p, c, h, o, 2.0, px) * self.focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false

// RADIOS. A 12 point diamond in stepped pixels; inside, a diamond segment
// at ghost, filled with ink when chosen.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 8.0 top: 5.0 bottom: 5.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 19.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = 12.0
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let held = self.down * live
    let sb = lcd_markbox(self.rect_size, o, self.size + px, self.size + px, 0.0, px)
    let c = (sb.xy + sb.zw) * 0.5
    let r = (sb.z - sb.x) * 0.5
    // a diamond tested on pixel centres: hard stairs
    let q = abs(lcd_pix(p, o, px) - c)
    let dq = q.x + q.y - r
    let inside = step(dq, 0.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let qs = abs(p - lcd_throw() - c)
    let ds = (qs.x + qs.y - r) * 0.70711
    let sh = lcd_inkshade(abs(ds) - px * 0.5, 0.14) * (1.0 - inside) * live
    out = vec4(lcd_ink() * sh, sh)
    let chk = lcd_checker(p, o, px)
    let ba = inside * chk * self.hover * live * (1.0 - held)
    out = lcd_over(out, vec4(lcd_mid() * ba, ba))
    let ia = inside * held
    out = lcd_over(out, vec4(lcd_ink() * ia, ia))
    // the stepped line, one pixel wide along the stairs
    let line = inside * step(-1.5 * px, dq)
    let lcol = mix(lcd_ink(), lcd_mid(), self.disabled)
    out = lcd_over(out, vec4(lcol * line, line))
    // the inner diamond segment
    let mk = step(q.x + q.y - r * 0.5, 0.0)
    let gcol = mix(lcd_ghost(), vec3(0.604, 0.631, 0.529), self.disabled)
    let ga = mk * (1.0 - self.active) * (1.0 - held)
    out = lcd_over(out, vec4(gcol * ga, ga))
    let mcol = mix(mix(lcd_ink(), lcd_mid(), self.disabled), lcd_lit(), held)
    let ma = mk * self.active
    out = lcd_over(out, vec4(mcol * ma, ma))
    let dd = (abs(p - c).x + abs(p - c).y - r) * 0.70711
    let kf = Finish.band(-(dd - 2.0 - px), 0.0, px, px) * self.focus * live * lcd_checker(p, o, px)
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false

// RADIO TABS. Square caption cells: a one-pixel rule above and below and a
// divider either side; the chosen one is the inverse legend, dark with lit
// glass letters. The pointer lays the dither, a press inverts.
let lcd_caption = fn(p: vec2, sb: vec4, o: vec2, px: float, fill: float, dither: float, focus: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = lcd_rbox(p, c, h, 0.01)
    let inx = step(sb.x, p.x) * step(p.x, sb.z)
    let iny = step(sb.y, p.y) * step(p.y, sb.w)
    let inside = inx * iny
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let sh = lcd_inkshade(lcd_rbox(p - lcd_throw(), c, h, 0.01), 0.14) * fill * (1.0 - inside) * live
    out = vec4(lcd_ink() * sh, sh)
    let chk = lcd_checker(p, o, px)
    let da = inside * chk * dither * (1.0 - fill)
    out = lcd_over(out, vec4(lcd_mid() * da, da))
    let fa = inside * fill
    let fcol = mix(lcd_ink(), lcd_mid(), disabled)
    out = lcd_over(out, vec4(fcol * fa, fa))
    let rules = max(step(p.y, sb.y + px), step(sb.w - px, p.y)) * inx
    let divs = max(step(p.x, sb.x + px), step(sb.z - px, p.x)) * iny
    let la = max(rules, divs) * inside
    let lcol = mix(lcd_ink(), lcd_mid(), disabled)
    out = lcd_over(out, vec4(lcol * la, la))
    let kf = lcd_dash_ring(d, p, c, h, o, 2.0, px) * focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 5.0 bottom: 5.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 9.0 right: 9.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.draw_text.color = #292b20
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #292b20
mod.widgets.RadioButtonTabFlat.draw_text.color_down = #b6bda2
mod.widgets.RadioButtonTabFlat.draw_text.color_focus = #292b20
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #b6bda2
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #6c725c
mod.widgets.RadioButtonTabFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sb = lcd_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, px)
    // chosen: the inverse legend; the press inverts too
    let live = 1.0 - self.disabled
    let inv = max(self.active, self.down * live)
    return lcd_caption(p, sb, self.rect_pos, px, inv, self.hover * live, self.focus, self.disabled)
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTab.clip_x = false
mod.widgets.RadioButtonTab.clip_y = false

// ---------------------------------------------------------------------------
// SLIDERS. The bar scale of the wristwatch: a row of short dashes, the
// value's run filled with ink and the rest at ghost; over it the scale's
// numbers 0 25 50 75 100 in small segment digits, joined by a one-pixel
// rule; under it the thumb, a small ink pointer. The pointer is outlined
// under the hand, and grows while dragged.
let lcd_scale = fn(p: vec2, o: vec2, size: vec2, top: float, px: float, slide: float, lo: float, hi: float, numbers: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let x0 = 3.0
    let x1 = size.x - 3.0
    let span = max(x1 - x0, 1.0)
    // rows, from the top of the track band
    let dh = 5.5
    let y_num = top
    let y_dash = Finish.snap(o.y + top + mix(0.5, 7.5, numbers), px) - o.y
    let dash_h = 4.0
    let y_ptr = y_dash + dash_h + 1.0
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the dashes: whole segments, a gap of two points, about 8.5 apart
    let n = max(floor((span + 2.0) / 8.5), 4.0)
    let pitch = (span + 2.0) / n
    let k = floor((p.x - x0) / pitch)
    let within = p.x - x0 - k * pitch
    let in_dash = step(0.0, within) * step(within, pitch - 2.0) * step(0.0, k) * step(k, n - 1.0)
    let in_row = step(y_dash, p.y) * step(p.y, y_dash + dash_h)
    let sc = (k + 0.5) / n
    let lit = step(lo, sc + 0.5 / n - 0.0001) * step(sc - 0.5 / n + 0.0001, hi) * step(0.0001, hi - lo + 0.0001)
    let full = step(lo, sc) * step(sc, hi)
    let on = max(full, lit * step(0.0, hi - lo - 0.0001) * step(sc, hi + 0.0001) * step(lo - 0.0001, sc))
    let da = in_dash * in_row
    let lcol = mix(lcd_ink(), lcd_mid(), disabled)
    let dcol = mix(lcd_ghost(), lcol, on)
    // the lit dashes throw the ink's shadow
    let sp = p - lcd_throw()
    let sk = clamp(floor((sp.x - x0 + 1.0) / pitch), 0.0, n - 1.0)
    let sbc = vec2(x0 + sk * pitch + (pitch - 2.0) * 0.5, y_dash + dash_h * 0.5)
    let sbd = lcd_rbox(sp, sbc, vec2((pitch - 2.0) * 0.5, dash_h * 0.5), 0.01)
    let ssc = (sk + 0.5) / n
    let sh = lcd_inkshade(sbd, 0.14) * step(lo, ssc) * step(ssc, hi) * (1.0 - da) * live
    out = vec4(lcd_ink() * sh, sh)
    out = lcd_over(out, vec4(dcol * da, da))
    // the numbers and the rule joining them
    if numbers > 0.5 {
        let nm = lcd_scale_numbers(p, x0, x1, y_num, dh, px)
        let ncol = mix(lcd_ink(), lcd_mid(), disabled)
        let na = nm.x
        out = lcd_over(out, vec4(ncol * na, na))
        let yr = Finish.snap(o.y + y_num + dh * 0.5, px) - o.y
        let rule = step(yr, p.y) * step(p.y, yr + px) * step(1.5, nm.y) * step(x0, p.x) * step(p.x, x1)
        let ra = rule * 0.8
        out = lcd_over(out, vec4(ncol * ra, ra))
    }
    // the pointer: a small triangle, tip up against the dashes
    let hx = Finish.snap(o.x + x0 + slide * span, px) - o.x + px * 0.5
    let grow = 1.0 + 0.35 * drag * live
    let ph = 3.5 * grow
    let pw = 3.5 * grow
    let q = p - vec2(hx, y_ptr)
    let td = max(-q.y, abs(q.x) * (ph / pw) + q.y - ph) * 0.7
    let pa = Finish.cover(td, px)
    let psd = max(-(q.y - 1.0), abs(q.x + 0.75) * (ph / pw) + (q.y - 1.0) - ph) * 0.7
    let psh = lcd_inkshade(psd, 0.14) * (1.0 - pa) * live
    out = lcd_over(out, vec4(lcd_ink() * psh, psh))
    out = lcd_over(out, vec4(lcol * pa, pa))
    // under the pointer: a one-pixel box round the thumb; focus: dashed
    let bc = vec2(hx, y_ptr + ph * 0.5)
    let bh = vec2(pw + 1.5, ph * 0.5 + 1.5)
    let bd = lcd_rbox(p, bc, bh, 0.01)
    let hb = Finish.band(-bd, 0.0, px, px) * hover * live * (1.0 - focus)
    out = lcd_over(out, vec4(lcd_ink() * hb, hb))
    let kf = lcd_dash_ring(bd, p, bc, bh, o, 0.0, px) * focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}

mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    return lcd_scale(p, self.rect_pos, self.rect_size, 19.5, px, self.slide_pos, lo, hi, 1.0, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false

// The minimal slider: the dashes and the pointer, no numbers.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    return lcd_scale(p, self.rect_pos, self.rect_size, self.offset_y, px, self.slide_pos, lo, hi, 0.0, self.hover, self.focus, self.drag, self.disabled)
}

// The value read out beside a slider: tabular digits in the ink.
let lcd_value_style = mod.theme.font_regular{font_size: 7.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/jetbrains_mono_variable.ttf") weight: 600.0 asc: 0.0 desc: 0.0}}}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = lcd_value_style
mod.widgets.SliderFlat.text_input.draw_text.text_style = lcd_value_style
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = lcd_value_style

// The round slider becomes a segment bar: a glass window framed in one
// pixel of ink, its dashes filled up to the value, the number at its right.
mod.widgets.SliderRoundFlat.height = 20.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 6.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let sb = lcd_snapbox(o, vec2(self.label_size, 0.0), self.rect_size, px)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = lcd_rbox(p, c, h, 1.5)
    let inside = Finish.cover(d, px)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // a window let into the glass: a shade under its top edge
    let topd = clamp((p.y - sb.y) / 3.0, 0.0, 1.0)
    let wcol = mix(lcd_glass() * 0.82, lcd_glass() * 0.97, topd)
    out = vec4(wcol * inside, inside)
    // dashes inside, leaving room for the number at the right
    let lo = min(self.origin_pos, self.slide_pos) * self.arc_origin
    let hi = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let x0 = sb.x + 3.0
    let x1 = sb.z - 36.0
    let span = max(x1 - x0, 1.0)
    let n = max(floor((span + 1.5) / 6.0), 4.0)
    let pitch = (span + 1.5) / n
    let k = floor((p.x - x0) / pitch)
    let within = p.x - x0 - k * pitch
    let in_dash = step(0.0, within) * step(within, pitch - 1.5) * step(0.0, k) * step(k, n - 1.0)
    let in_row = step(c.y - 3.0, p.y) * step(p.y, c.y + 3.0)
    let sc = (k + 0.5) / n
    let on = step(lo, sc) * step(sc, hi)
    let lcol = mix(lcd_ink(), lcd_mid(), self.disabled)
    let dcol = mix(vec3(0.537, 0.561, 0.467), lcol, on)
    let da = in_dash * in_row
    out = lcd_over(out, vec4(dcol * da, da))
    let chk = lcd_checker(p, o, px)
    let hv = inside * chk * 0.0
    let la = Finish.band(d, 0.0, px, px)
    let fl = Finish.band(d, px, 2.0 * px, px) * max(self.hover, self.drag) * live
    out = lcd_over(out, vec4(lcol * max(la, fl), max(la, fl)))
    let kf = lcd_dash_ring(d, p, c, h, o, 2.0, px) * self.focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false

// FADERS. A slot four points wide let into the glass: one device pixel of
// ink round a core of one-to-one ink hatching, the family's mid-tone. A
// printed ladder on ONE side of it, two points clear: ten steps, a long
// tick at 0, 50 and 100. The cap is an inverse tile 18 across and 10 along
// with a lit line across its middle, the line the value is read off; it
// throws the ink's shadow and moves over the slot.
mod.widgets.SliderFader.cap_size = 10.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFaderY.width = 26.0
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    let a = mix(p.x, self.rect_size.y - p.y, self.is_vertical)
    let b = mix(p.y, p.x, self.is_vertical)
    let oa = mix(self.rect_pos.x, self.rect_pos.y, self.is_vertical)
    let ob = mix(self.rect_pos.y, self.rect_pos.x, self.is_vertical)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(ob + across * 0.5, px) - ob
    let icol = mix(lcd_ink(), lcd_mid(), self.disabled)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the ladder, on the near side only (left of a column, above a row)
    let pc = lcd_pix(p, self.rect_pos, px)
    let ac = mix(pc.x, self.rect_size.y - pc.y, self.is_vertical)
    let bc = mix(pc.y, pc.x, self.is_vertical)
    let da = ac - foot
    let step10 = travel / 10.0
    let kk = floor(da / step10 + 0.5)
    let near = abs(da - kk * step10)
    let tick = step(near, px * 0.5) * step(-0.5, kk) * step(kk, 10.5)
    let off = mid - bc
    let major = step(fract(kk / 5.0 + 0.01), 0.1)
    let tl = mix(3.0, 5.0, major)
    let tk = tick * step(4.0, off) * step(off, 4.0 + tl)
    out = lcd_over(out, vec4(icol * tk, tk))
    // the slot: six device pixels across, square ends of half a point
    let sa0 = Finish.snap(oa + self.inset_px, px) - oa
    let sa1 = Finish.snap(oa + along - self.inset_px, px) - oa
    let sb0 = mid - 3.0 * px
    let sc = vec2((sa0 + sa1) * 0.5, sb0 + 3.0 * px)
    let sh2 = vec2((sa1 - sa0) * 0.5, 3.0 * px)
    let q = vec2(a, b)
    let sd = lcd_rbox(q, sc, sh2, 0.5)
    let sfill = Finish.cover(sd, px)
    let hatch = lcd_checker(p, self.rect_pos, px)
    var scol = mix(lcd_ground() * 0.92, icol, hatch * 0.85)
    scol = mix(scol, icol, Finish.band(sd, 0.0, px, px))
    out = lcd_over(out, vec4(scol * sfill, sfill))
    // the cap
    let at = foot + self.slide_pos * travel
    let ca_h = Finish.snap(oa + at, px) - oa
    let ca_v = along - (Finish.snap(oa + along - at, px) - oa)
    let ca = mix(ca_h, ca_v, self.is_vertical)
    let cc = vec2(ca, mid)
    let chh = vec2(self.cap_px * 0.5, 9.0)
    let cd = lcd_rbox(q, cc, chh, 1.0)
    // the ink's shadow, down and a little left in screen space
    let sofs = mix(vec2(-0.75, 1.0), vec2(-1.0, -0.75), self.is_vertical)
    let csd = lcd_rbox(q - sofs, cc, chh, 1.0)
    let ca2 = Finish.cover(cd, px)
    let sh = lcd_inkshade(csd, 0.16) * (1.0 - ca2) * live
    out = lcd_over(out, vec4(lcd_ink() * sh, sh))
    let face = mix(mix(lcd_ink(), lcd_dark(), 0.4 * self.hover * live), lcd_mid(), self.disabled)
    out = lcd_over(out, vec4(face * ca2, ca2))
    // the lit line across the cap, one pixel, and a keyline while dragged
    let cut = step(ca, a) * step(a, ca + px) * step(abs(b - cc.y), chh.y - 2.0 * px) * ca2
    out = lcd_over(out, vec4(lcd_lit() * cut, cut))
    let kl = Finish.band(cd, -3.0 * px, -2.0 * px, px) * self.drag * live
    out = lcd_over(out, vec4(lcd_lit() * kl, kl))
    let kf = lcd_dash_ring(cd, q, cc, chh, vec2(oa, ob), 2.0, px) * self.focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}

// ---------------------------------------------------------------------------
// KNOBS. The wristwatch's bezel: a dark ring printed with minute marks in
// the glass colour, lit along its upper edge, standing on the glass with a
// short shade under it. Inside, a glass dial with its own shadow under the
// rim, a ring of 24 segments lit up to the value and ghosted beyond, and a
// plain centre with an ink pointer.
let lcd_knob = fn(p: vec2, c: vec2, rad: float, o: vec2, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let v = p - c
    let r = length(v)
    let rin = rad * 0.78
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the bezel's shade on the glass
    let sr = length(v - vec2(-0.4, 1.0))
    let sh = (1.0 - smoothstep(rad - 0.8, rad + 1.8, sr)) * 0.30 * (1.0 - Finish.cover(r - rad, px)) * mix(1.0, 0.4, disabled)
    out = vec4(0.0, 0.0, 0.0, sh)
    // a light lip where the glass meets the bezel's foot
    let lip = Finish.band(-(r - rad - px), 0.0, px, px) * smoothstep(0.2, 0.8, v.y / max(r, 0.001)) * 0.7
    out = lcd_over(out, vec4(lcd_g3(0.84) * lip, lip))
    // the bezel ring
    let ring = Finish.cover(max(r - rad, rin - r), px)
    let up = clamp(-v.y / max(rad, 1.0), -1.0, 1.0)
    var bcol = lcd_frame() * (1.0 + 0.25 * up) + lcd_g3(0.02 * hover * live)
    // the minute marks: sixty, the fifth ones longer
    var th = atan2(v.x, -v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let mi = floor(th / (PI / 30.0) + 0.5)
    let mang = mi * PI / 30.0
    let mdir = vec2(sin(mang), -cos(mang))
    let mperp = abs(dot(v, vec2(mdir.y, -mdir.x)))
    let five = step(fract(mi / 5.0 + 0.01), 0.1)
    let mlen = mix(0.09, 0.16, five) * rad
    let mark = Finish.band(mperp - px * mix(0.5, 0.75, five), -px, 0.0, px) * step(rad - px * 2.0 - mlen, r) * step(r, rad - px * 2.0)
    let mcol = mix(vec3(0.600, 0.627, 0.529), lcd_lit(), hover * live)
    bcol = mix(bcol, mcol * mix(1.0, 0.5, disabled), mark * 0.9)
    // the lit line on the bezel's upper outer edge, the dark lip inside
    let edge = Finish.band(-(r - rad), 0.0, px, px) * clamp(up * 1.6, 0.0, 1.0)
    bcol = mix(bcol, vec3(0.380, 0.392, 0.416), edge)
    let inner = Finish.band(r - rin, 0.0, px, px)
    bcol = mix(bcol, lcd_g3(0.01), inner)
    out = lcd_over(out, vec4(bcol * ring, ring))
    // the dial glass, shaded under the rim at the top
    let dial = Finish.cover(r - rin, px)
    let shade = (1.0 - smoothstep(0.0, rin * 0.28, dot(v, vec2(0.0, 1.0)) + rin)) * 0.45
    var gcol = lcd_wglass() * (1.0 - shade)
    gcol = gcol + lcd_g3(Finish.grain((p + o) / px, 0.018))
    // the ring of segments
    let start = gap * 0.5 * PI / 180.0
    let sweep = 2.0 * PI - gap * PI / 180.0
    var ta = atan2(-v.x, v.y)
    if ta < 0.0 {
        ta = ta + 2.0 * PI
    }
    let t = (ta - start) / sweep
    let s0 = rin * 0.70
    let s1 = rin * 0.90
    let smid = (s0 + s1) * 0.5
    // segments about three and a half points long, 12 to 24 of them
    let n = clamp(floor(sweep * smid / 3.6), 12.0, 24.0)
    let seg = floor(t * n)
    let seglen = sweep * smid / n
    let f = fract(t * n) * seglen
    let in_seg = step(f, seglen - 1.0) * step(0.0, t) * step(t, 1.0)
    let band = Finish.cover(max(s0 - r, r - s1), px) * in_seg
    let lo = min(origin, slide) * arc_origin
    let hi = mix(slide, max(origin, slide), arc_origin)
    let sc = (seg + 0.5) / n
    let lit = step(lo, sc) * step(sc, hi + 0.5 / n - 0.0001)
    let icol = mix(lcd_ink(), lcd_mid(), disabled)
    let segc = mix(lcd_wglass() * 0.86, icol, lit)
    gcol = mix(gcol, segc, band)
    // the pointer: a short ink bar in the plain centre, a tenth to four
    // tenths of the radius out, well inside the ring of segments
    let av = start + sweep * slide
    let dir = vec2(-sin(av), cos(av))
    let al = clamp(dot(v, dir), rad * 0.10, rad * 0.40)
    let pw = rad * 0.06 * mix(1.0, 1.25, drag * live)
    let pd = length(v - dir * al) - pw
    let pa = Finish.cover(pd, px)
    let psd = length(v - lcd_throw() - dir * clamp(dot(v - lcd_throw(), dir), rad * 0.10, rad * 0.40)) - pw
    gcol = mix(gcol, gcol * 0.86, lcd_inkshade(psd, 1.0) * (1.0 - pa))
    gcol = mix(gcol, icol, pa)
    out = lcd_over(out, vec4(gcol * dial, dial))
    // focus: a dashed ring two points out
    let kr = Finish.band(abs(r - rad - 2.0 - px * 0.5) - px * 0.5, -px, 0.0, px)
    let kd = step(fract(floor(th * rad / px / 2.0 + 0.01) * 0.5), 0.3)
    let kf = kr * kd * focus * live
    out = lcd_over(out, vec4(lcd_ink() * kf, kf))
    return out
}

mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let rad = dia * 0.5 - 1.5
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px)) - self.rect_pos
    return lcd_knob(p, c, rad, self.rect_pos, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = lcd_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y - 24.0)
    let rad = dia * 0.5 - 2.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 24.0 + dia * 0.5, px)) - self.rect_pos
    return lcd_knob(p, c, rad, self.rect_pos, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 4.0 right: 4.0 top: 1.0 bottom: 1.0}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.draw_text.text_style = lcd_value_style

// ---------------------------------------------------------------------------
// FIELDS. A window let into the glass: one device pixel of ink round a
// glass a shade darker, a shadow under its top edge, and a light lip under
// its foot where the cut catches the light. The pointer lays a sparse
// dither; focus doubles the line. A field a host has made invisible (the
// value inside a slider) stays invisible.
let lcd_well = fn(p: vec2, sb: vec4, o: vec2, px: float, hover: float, focus: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let d = lcd_rbox(p, c, h, 1.5)
    let inside = Finish.cover(d, px)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the lip under the foot
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y + h.y - 1.0, p.y) * 0.75
    out = vec4(lcd_g3(0.80) * lip, lip)
    // the glass: shaded under the top edge over four points, ease-out
    let t = clamp((p.y - sb.y) / 4.0, 0.0, 1.0)
    let fall = 1.0 - (1.0 - t) * (1.0 - t)
    var col = mix(lcd_ground() * 0.66, lcd_ground() * 0.955, fall)
    col = mix(col, lcd_ground() * 0.985, disabled)
    col = col + lcd_g3(Finish.grain((p + o) / px, 0.016))
    out = lcd_over(out, vec4(col * inside, inside))
    // under the pointer: one pixel in four of the light middle
    let qa = lcd_quarter(p, o, px) * inside * hover * live * 0.8
    out = lcd_over(out, vec4(lcd_mid() * qa, qa))
    // the line; focus doubles it inward
    let lcol = mix(lcd_ink(), lcd_mid(), disabled)
    let la = max(Finish.band(d, 0.0, px, px), Finish.band(d, px, 2.0 * px, px) * focus * live)
    out = lcd_over(out, vec4(lcol * la, la))
    return out
}

mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sb = lcd_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size - vec2(0.0, px), px)
    let vis = step(0.001, self.border_size)
    return lcd_well(p, sb, self.rect_pos, px, self.hover, self.focus, self.disabled) * vis
}
mod.widgets.TextInputFlat.draw_text.color_empty = #5d624d
mod.widgets.TextInputFlat.draw_text.color_empty_hover = #535843
mod.widgets.TextInputFlat.draw_text.color_empty_focus = #5d624d
// The caret is an ink block a point and a half wide.
mod.widgets.TextInputFlat.draw_cursor.pixel = fn() {
    let a = (1.0 - self.blink) * self.focus * (1.0 - self.disabled)
    return vec4(vec3(0.161, 0.169, 0.125) * a, a)
}
mod.widgets.TextInputFlat.draw_selection.border_radius = 0.0

// The number field: the same window, its stepper cut off at the right by
// a one-pixel rule, two cells with pixel arrows; a cell lays the dither
// under the pointer and inverts while pressed.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sb = lcd_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size - vec2(0.0, px), px)
    return lcd_well(p, sb, self.rect_pos, px, self.hover, self.focus, self.disabled)
}
mod.widgets.NumberField.pad_left = 8.0
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let w = self.rect_size.x
    let hgt = self.rect_size.y
    let mid = Finish.snap(o.y + hgt * 0.5, px) - o.y
    let live = 1.0 - self.disabled
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let inx = step(px, p.x) * step(p.x, w - px)
    let iny = step(1.5 * px, p.y) * step(p.y, hgt - 1.5 * px)
    let cell = inx * iny
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let chk = lcd_checker(p, o, px)
    let ha = cell * chk * hot * (1.0 - dn)
    out = lcd_over(out, vec4(lcd_mid() * ha, ha))
    let ia = cell * dn
    out = lcd_over(out, vec4(lcd_ink() * ia, ia))
    // the rules: down the left edge and across the middle
    let rl = step(p.x, px) * step(px, p.y) * step(p.y, hgt - px)
    let rm = step(mid - px * 0.5, p.y) * step(p.y, mid + px * 0.5) * step(px, p.x)
    let icol = mix(lcd_ink(), lcd_mid(), self.disabled)
    let ra = max(rl, rm)
    out = lcd_over(out, vec4(icol * ra, ra))
    // the arrows: stepped triangles, 5 pixels across
    let cx = Finish.snap(o.x + w * 0.5, px) - o.x
    let q = floor((p + o) / px + vec2(0.001, 0.001)) - floor((vec2(cx, 0.0) + o) / px + vec2(0.5, 0.5))
    let yu = floor((o.y + mid * 0.5) / px) - floor(o.y / px + 0.5)
    let yd = floor((o.y + mid + (hgt - mid) * 0.5) / px) - floor(o.y / px + 0.5)
    let qy = floor((p.y + o.y) / px + 0.001) - floor(o.y / px + 0.5)
    let ru = qy - (yu - 1.0)
    let rd = (yd + 1.0) - qy
    let au = step(0.0, ru) * step(ru, 2.5) * step(abs(q.x + 0.5), ru + 0.6)
    let ad = step(0.0, rd) * step(rd, 2.5) * step(abs(q.x + 0.5), rd + 0.6)
    let ucol = mix(icol, lcd_lit(), max(0.0, self.down) * live)
    let dcol = mix(icol, lcd_lit(), max(0.0, -self.down) * live)
    out = lcd_over(out, vec4(ucol * au, au))
    out = lcd_over(out, vec4(dcol * ad, ad))
    return out
}
// The printed arrow glyphs are hidden; the face draws the arrows.
mod.widgets.NumberSpin.draw_text.color = #292b2000
mod.widgets.NumberSpin.draw_text.color_disabled = #292b2000

// DROP-DOWNS. The window, with a cell 18 points wide at its right split
// off by a one-pixel rule and a stepped ink triangle in it; open or held,
// the cell inverts.
let lcd_choice = fn(p: vec2, sb: vec4, o: vec2, px: float, hover: float, open: float, focus: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    var out = lcd_well(p, sb, o, px, 0.0, focus, disabled)
    let c = (sb.xy + sb.zw) * 0.5
    let h = (sb.zw - sb.xy) * 0.5
    let rx = Finish.snap(o.x + sb.z - 18.0, px) - o.x
    let incell = step(rx + px, p.x) * step(p.x, sb.z - px) * step(sb.y + px, p.y) * step(p.y, sb.w - px)
    let chk = lcd_checker(p, o, px)
    let ha = incell * chk * hover * live * (1.0 - open)
    out = lcd_over(out, vec4(lcd_mid() * ha, ha))
    let ia = incell * open * live
    out = lcd_over(out, vec4(lcd_ink() * ia, ia))
    let icol = mix(lcd_ink(), lcd_mid(), disabled)
    let rule = step(rx, p.x) * step(p.x, rx + px) * step(sb.y, p.y) * step(p.y, sb.w)
    out = lcd_over(out, vec4(icol * rule, rule))
    // the triangle: 7 pixels across, 4 down, stepped
    let tx = Finish.snap(o.x + rx + 9.0, px) - o.x
    let q = floor((p + o) / px + vec2(0.001, 0.001)) - floor((vec2(tx, c.y - 1.5) + o) / px + vec2(0.5, 0.5))
    let tr = 3.0 - q.y
    let ta = step(0.0, q.y) * step(q.y, 3.5) * step(abs(q.x + 0.5), tr + 0.6)
    let tcol = mix(icol, lcd_lit(), open * live)
    out = lcd_over(out, vec4(tcol * ta, ta))
    // focus also shows as the dashed ring outside
    let d = lcd_rbox(p, c, h, 1.5)
    return out
}
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 8.0 right: 26.0 top: 2.5 bottom: 2.5}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let sb = lcd_snapbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size - vec2(0.0, px), px)
    return lcd_choice(p, sb, self.rect_pos, px, self.hover, max(self.active, self.down * self.hover), self.focus, self.disabled)
}
