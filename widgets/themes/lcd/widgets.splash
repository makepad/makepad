mod.widgets.DropDownFlat.draw_text.color_hover = #292b20
mod.widgets.DropDownFlat.draw_text.color_focus = #292b20
mod.widgets.DropDownFlat.draw_text.color_down = #292b20
mod.widgets.DropDownFlat.draw_text.color_disabled = #6c725c

