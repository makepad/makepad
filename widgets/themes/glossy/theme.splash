mod.theme = mod.themes.dark

// Dark gloss with LED. Thin charcoal caps on a lifted charcoal ground: a
// hard black outline, one light line along the top edge only, a face that
// darkens a little toward the bottom, and a short shadow that falls down.
// The "gloss" is that one top line, never a sweep across the face. State is
// said by light: a small LED lit or dark, and a legend that glows. The faces
// themselves are drawn in widgets.splash; this file holds the tokens every
// face and every stock widget reads.
mod.theme.color_bg_app = #393b44
mod.theme.color_fg_app = #393b44
mod.theme.color_bg_container = #393b44

// Raised caps: the middle of the face, for any stock face this sheet does
// not replace.
mod.theme.color_outset = #35373f
mod.theme.color_outset_1 = #3f414a
mod.theme.color_outset_2 = #2a2c34
mod.theme.color_outset_hover = #3a3c45
mod.theme.color_outset_1_hover = #444650
mod.theme.color_outset_2_hover = #2f3139
mod.theme.color_outset_focus = #35373f
mod.theme.color_outset_1_focus = #3f414a
mod.theme.color_outset_2_focus = #2a2c34
mod.theme.color_outset_active = #2c3643
mod.theme.color_outset_1_active = #2c3643
mod.theme.color_outset_2_active = #2c3643
mod.theme.color_outset_down = #2c2e35
mod.theme.color_outset_1_down = #2c2e35
mod.theme.color_outset_2_down = #2c2e35
mod.theme.color_outset_drag = #2c2e35
mod.theme.color_outset_1_drag = #2c2e35
mod.theme.color_outset_2_drag = #2c2e35
mod.theme.color_outset_disabled = #33353c
mod.theme.color_outset_1_disabled = #33353c
mod.theme.color_outset_2_disabled = #33353c

// Wells cut into the ground: fields, tracks, trays.
mod.theme.color_inset = #24262d
mod.theme.color_inset_1 = #24262d
mod.theme.color_inset_2 = #2b2d35
mod.theme.color_inset_hover = #26282f
mod.theme.color_inset_1_hover = #26282f
mod.theme.color_inset_2_hover = #2b2d35
mod.theme.color_inset_focus = #24262d
mod.theme.color_inset_1_focus = #24262d
mod.theme.color_inset_2_focus = #2b2d35
mod.theme.color_inset_active = #24262d
mod.theme.color_inset_1_active = #24262d
mod.theme.color_inset_2_active = #2b2d35
mod.theme.color_inset_down = #24262d
mod.theme.color_inset_1_down = #24262d
mod.theme.color_inset_2_down = #2b2d35
mod.theme.color_inset_drag = #24262d
mod.theme.color_inset_1_drag = #24262d
mod.theme.color_inset_2_drag = #2b2d35
mod.theme.color_inset_empty = #24262d
mod.theme.color_inset_1_empty = #24262d
mod.theme.color_inset_2_empty = #2b2d35
mod.theme.color_inset_disabled = #2e3038
mod.theme.color_inset_1_disabled = #2e3038
mod.theme.color_inset_2_disabled = #2e3038

// Every edge a stock face strokes is the black outline; the light comes from
// the one top line the faces draw, not from a bevel.
mod.theme.beveling = 0.34
mod.theme.color_bevel = #0a0a0c
mod.theme.color_bevel_hover = #0a0a0c
mod.theme.color_bevel_focus = #4f81b3
mod.theme.color_bevel_active = #0a0a0c
mod.theme.color_bevel_empty = #0a0a0c
mod.theme.color_bevel_down = #0a0a0c
mod.theme.color_bevel_drag = #0a0a0c
mod.theme.color_bevel_disabled = #1a1b20
mod.theme.color_bevel_inset_1 = #0a0a0c
mod.theme.color_bevel_inset_2 = #0a0a0c
mod.theme.color_bevel_outset_1 = #0a0a0c
mod.theme.color_bevel_outset_2 = #040405
mod.theme.color_bevel_inset_1_hover = #0a0a0c
mod.theme.color_bevel_inset_2_hover = #0a0a0c
mod.theme.color_bevel_outset_1_hover = #0a0a0c
mod.theme.color_bevel_outset_2_hover = #040405
mod.theme.color_bevel_inset_1_focus = #4f81b3
mod.theme.color_bevel_inset_2_focus = #4f81b3
mod.theme.color_bevel_outset_1_focus = #4f81b3
mod.theme.color_bevel_outset_2_focus = #4f81b3
mod.theme.color_bevel_inset_1_down = #0a0a0c
mod.theme.color_bevel_inset_2_down = #0a0a0c
mod.theme.color_bevel_outset_1_down = #0a0a0c
mod.theme.color_bevel_outset_2_down = #0a0a0c
mod.theme.color_bevel_inset_1_disabled = #1a1b20
mod.theme.color_bevel_inset_2_disabled = #1a1b20
mod.theme.color_bevel_outset_1_disabled = #1a1b20
mod.theme.color_bevel_outset_2_disabled = #1a1b20

// Ink. Caps carry #d4d7de; words on the ground a touch lighter, never past
// #e0e2e6 at rest. Dim and disabled ink is #5c5e66.
mod.theme.color_text = #d4d7de
mod.theme.color_text_hover = #dcdee3
mod.theme.color_text_focus = #dcdee3
mod.theme.color_text_active = #dcdee3
mod.theme.color_text_down = #d4d7de
mod.theme.color_text_val = #aeb1b9
mod.theme.color_text_disabled = #5c5e66
mod.theme.color_text_placeholder = #6a6c74
mod.theme.color_text_placeholder_hover = #74767e
mod.theme.color_text_meta = #7c7e86
mod.theme.color_text_cursor = #f0fbff
mod.theme.color_cursor = #f0fbff
mod.theme.color_label = #dcdee3
mod.theme.color_label_hover = #e0e2e6
mod.theme.color_label_focus = #e0e2e6
mod.theme.color_label_active = #e0e2e6
mod.theme.color_label_down = #dcdee3
mod.theme.color_label_disabled = #5c5e66
mod.theme.color_label_inner = #d4d7de
mod.theme.color_label_inner_hover = #dcdee3
mod.theme.color_label_inner_focus = #d4d7de
mod.theme.color_label_inner_active = #f4f6f8
mod.theme.color_label_inner_down = #c4c7ce
mod.theme.color_label_inner_drag = #c4c7ce
mod.theme.color_label_inner_inactive = #7c7e86
mod.theme.color_label_inner_disabled = #5c5e66
mod.theme.color_label_outer = #dcdee3
mod.theme.color_label_outer_off = #9a9ca4
mod.theme.color_label_outer_hover = #e0e2e6
mod.theme.color_label_outer_focus = #dcdee3
mod.theme.color_label_outer_active = #e0e2e6
mod.theme.color_label_outer_active_focus = #e0e2e6
mod.theme.color_label_outer_down = #dcdee3
mod.theme.color_label_outer_drag = #dcdee3
mod.theme.color_label_outer_disabled = #5c5e66
mod.theme.color_icon = #c4c7ce
mod.theme.color_icon_hover = #dcdee3
mod.theme.color_icon_focus = #c4c7ce
mod.theme.color_icon_active = #f4f6f8
mod.theme.color_icon_down = #c4c7ce
mod.theme.color_icon_disabled = #5c5e66

// The light. The LED's rim and the focus ring are #4f81b3; lit words and
// check marks #3aa7f6; value fills #3baeff.
mod.theme.color_focus = #4f81b3
mod.theme.color_ctrl_active = #3aa7f6
mod.theme.color_val = #3baeff
mod.theme.color_val_hover = #3baeff
mod.theme.color_val_focus = #3baeff
mod.theme.color_val_drag = #3baeff
mod.theme.color_val_disabled = #3a4a63
mod.theme.color_mark_active = #3aa7f6
mod.theme.color_mark_active_hover = #3aa7f6
mod.theme.color_mark_focus = #3aa7f6
mod.theme.color_mark_disabled = #4b4e57
// The accent seed: the primary, secondary and tertiary families are
// grown from it, and nothing else in this file reaches them. It is the
// selected row of a menu, the one place this family fills with colour.
mod.theme.color_ctrl_selected = #3a7fc0
mod.theme.color_bg_highlight = #33363e
mod.theme.color_bg_highlight_inline = #2c4a6a
mod.theme.color_text_on_accent = #ffffff
// Selected text: the accent at a third over the well while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #00000000
mod.theme.color_selection_down = #2c4a6a
mod.theme.color_selection_focus = #2c4a6a

// SPACING. Rows of 24 points, gaps of 8, panels padded 12. The base theme
// froze everything it derives from space_factor when it was built, so every
// rung this sheet depends on is stated again here.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 20.0
mod.theme.size_control_m = 24.0
mod.theme.size_control_l = 28.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 24.0
// Stock shaders draw a corner twice the number written: 1 is the 2 point
// corner of a cap, 2 the 4 point corner of a panel.
mod.theme.corner_radius = 1.0
mod.theme.container_corner_radius = 2.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs written in true points: caps 2, panels and cards 4.
mod.theme.radius_s = 2.0
mod.theme.radius_m = 2.0
mod.theme.radius_l = 4.0

// TYPE. The library's own neutral grotesque. Cap and field labels at 8
// points, so the cap height is a third of the 24 point cap (12 dp); the
// group captions and a lit legend use its bold.
mod.theme.font_size_p = 8.0
mod.theme.font_size_base = 8.0
// The whole ladder, restated: the base theme froze its rungs from its own
// 10 point base, so "small" came out larger than a cap label and panel text
// larger than both. Small 7.5, body 8, titles 9 to 11.
mod.theme.type_label_l_size = 8.0
mod.theme.type_label_m_size = 7.5
mod.theme.type_label_s_size = 7.0
mod.theme.type_body_l_size = 8.5
mod.theme.type_body_m_size = 8.0
mod.theme.type_body_s_size = 7.5
mod.theme.type_title_s_size = 9.0
mod.theme.type_title_m_size = 10.0
mod.theme.type_title_l_size = 11.0
// The heading rung a card title takes (H4), on the same ladder.
mod.theme.font_size_4 = 10.0
// The styles built from those rungs, and the two plain faces a label takes
// when it names no size (the base draws them at 10). Only the size changes;
// each keeps the base theme's family with all its members.
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.0}
mod.theme.font_bold = mod.theme.font_bold{font_size: 8.5}
mod.theme.font_title_l = mod.theme.font_bold{font_size: 11.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.0 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.0 line_spacing: 1.2}
mod.theme.font_body_l = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.0 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 7.5 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.0 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.0 line_spacing: 1.2}

// No surface material: every face that matters is drawn by the sheet, and
// the rest stay flat rather than take a relief that is not this family's.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #4f81b3
true
