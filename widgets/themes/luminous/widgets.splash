// The combo box: a well one types in, in its bezel, the chevron at its
// right behind an engraved joint.
mod.widgets.ComboBoxFlat.padding = mod.turtle.Inset{left: 12.0 right: 34.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBoxFlat.input.min_height = 0.0
mod.widgets.ComboBoxFlat.clip_x = false
mod.widgets.ComboBoxFlat.clip_y = false
mod.widgets.ComboBoxFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    var res = lm_field(p, lo, hi, o, px, self.hover, 0.0, self.focus, self.disabled, 1.0)
    let jx = lm_snap(size.x - 26.0, o.x, px)
    let iny = step(5.5, p.y) * step(p.y, size.y - 5.5)
    let jd = step(jx - px, p.x) * step(p.x, jx) * iny
    let jl = step(jx, p.x) * step(p.x, jx + px) * iny
    res = Finish.over(res, vec4(0.0, 0.0, 0.0, 0.9 * jd))
    res = Finish.over(res, vec4(vec3(0.16, 0.18, 0.2) * jl, jl))
    res = lm_chevron(res, p, vec2(size.x - 14.0, size.y * 0.5), vec3(0.788, 0.808, 0.831), self.focus, self.disabled, px)
    return res * lm_fade(self.pos, size, m)
}

// Open lists: a slab with its top line; rows lift a little under the hand,
// the chosen row in a lit frame.
let lm_menu = fn(p: vec2, size: vec2, px: float) -> vec4 {
    let r = min(7.0, min(size.x, size.y) * 0.5)
    let res = lm_slab(p, vec2(0.0, 0.0), size, r, px, 0.0, 0.0, 0.0)
    let d = Material.sd_box(p, size * 0.5, size * 0.5, r)
    let e = Finish.band(d, 0.0, px, px) * 0.5
    return Finish.over(res, vec4(vec3(0.25, 0.27, 0.3) * e, e) * step(p.y, size.y - px))
}
let lm_row = fn(p: vec2, size: vec2, px: float, hover: float, active: float, dis: float) -> vec4 {
    let lo = vec2(3.0, 1.5)
    let hi = size - vec2(3.0, 1.5)
    let r = min(4.0, (hi.y - lo.y) * 0.5)
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, r)
    let a = Finish.cover(d, px)
    let wash = 0.06 * hover * (1.0 - dis) * a
    var res = vec4(vec3(0.788, 0.808, 0.831) * wash, wash)
    if active > 0.001 {
        var sel = Finish.over(vec4(0.0, 0.0, 0.0, 0.0), vec4(vec3(0.075, 0.082, 0.094) * a, a))
        sel = lm_frame(sel, p, lo, hi, r, px, 1.0)
        res = mix(res, sel, active)
    }
    return res
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    return lm_menu(self.pos * self.rect_size, self.rect_size, px)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    return lm_row(self.pos * self.rect_size, self.rect_size, px, self.hover, self.active, self.disabled)
}
