use mod.prelude.widgets_internal.*

// Milled dark panels lit from inside. One blue-black material at three
// heights -- the ground, the slabs standing on it, the wells punched into
// the slabs -- and one orange light, thin and hot and close to an edge.
// Every control is a face set into a bezel that is part of its own box, so
// nothing a control draws reaches a neighbour: only the slab's short
// shadow (gone within 4 points) falls outside the box, onto the ground,
// and the soft light a chosen cell spills (gone within about 8).
// Every face is drawn in true points; `px` is one device pixel.

// ---------------------------------------------------------------- helpers

let lm_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let lm_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let lm_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// Which way the outline of a rounded box faces at p.
let lm_normal = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// Anything drawn in a grown quad fades out over its last points, so a
// shadow never ends on a hard edge where the quad stops.
let lm_fade = fn(pos: vec2, size: vec2, m: float) -> float {
    let q = pos * (size + vec2(2.0 * m, 2.0 * m))
    let e = min(min(q.x, q.y), min(size.x + 2.0 * m - q.x, size.y + 2.0 * m - q.y))
    return smoothstep(0.0, min(m, 4.0), e)
}

// The palette. The ground, and the light: body, deep, pale core, glow.
let lm_ground = fn() -> vec3 {
    return vec3(0.067, 0.086, 0.106)
}
let lm_orange = fn() -> vec3 {
    return vec3(1.0, 0.416, 0.118)
}
let lm_deep = fn() -> vec3 {
    return vec3(0.722, 0.204, 0.039)
}
let lm_core = fn() -> vec3 {
    return vec3(1.0, 0.776, 0.565)
}
let lm_glowc = fn() -> vec3 {
    return vec3(1.0, 0.353, 0.078)
}

// ---------------------------------------------------------------- heights

// A SLAB: a bezel or a panel standing on the ground. #1b1f25 with a quiet
// fall, a one-pixel lighter line along its top (#363c44), a dark line along
// its foot (#0a0c0f), the sides between; its short soft shadow falls on the
// ground under it (1.2 down, gone within 4 points). `sh` scales the shadow.
let lm_slab = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, sh: float, hover: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lm_normal(p, c, h, r)
    let s = Finish.drop(p, c, h, r, vec2(0.0, 1.2), 1.3) * 0.62 * sh * (1.0 - a) * (1.0 - 0.5 * dis)
    let res = vec4(0.0, 0.0, 0.0, s)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.118, 0.133, 0.157), vec3(0.094, 0.110, 0.133), t)
    let ring = Finish.band(d, 0.0, px, px)
    let up = smoothstep(-0.25, 0.75, -n.y)
    let dn = smoothstep(-0.25, 0.75, n.y)
    col = mix(col, vec3(0.141, 0.157, 0.184) + vec3(0.05, 0.052, 0.055) * hover, ring * (1.0 - up) * (1.0 - dn))
    col = mix(col, vec3(0.212, 0.235, 0.267) + vec3(0.1, 0.105, 0.11) * hover, ring * up)
    col = mix(col, vec3(0.039, 0.047, 0.059), ring * dn)
    col = mix(col, lm_ground(), 0.35 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// A WELL punched into a slab: floor #0b0d10, an inner shadow under its top
// edge that fades over about 5 points, a near-black top line and a faint
// light line along its lower inner edge. `deep` scales the inner shadow.
let lm_well = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, deep: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lm_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = vec3(0.043, 0.051, 0.063) + vec3(0.012, 0.013, 0.016) * t
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 1.8), 2.2)
    col = mix(col, vec3(0.0, 0.0, 0.0), clamp(0.8 * ins * deep, 0.0, 0.9))
    let ring = Finish.band(d, 0.0, px, px)
    let up = smoothstep(-0.25, 0.75, -n.y)
    let dn = smoothstep(-0.1, 0.8, n.y)
    col = mix(col, vec3(0.012, 0.014, 0.017), ring * up)
    col = mix(col, vec3(0.165, 0.184, 0.208), ring * dn * 0.85)
    col = mix(col, vec3(0.075, 0.086, 0.1), 0.45 * dis)
    return vec4(col * a, a)
}

// A TRACK: a long well a segmented group's answers stand in. Its floor a
// little lighter than a well's, an inner shadow under its upper wall, and
// its lower wall a 1.3 point band facing up, lit a shade from above.
let lm_track = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lm_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.058, 0.067, 0.08), vec3(0.068, 0.078, 0.092), t)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 1.8), 2.0)
    col = mix(col, vec3(0.0, 0.0, 0.0), clamp(0.75 * ins, 0.0, 0.85))
    let x = max(-d, 0.0)
    let dn = smoothstep(0.2, 0.9, n.y)
    col = mix(col, vec3(0.098, 0.11, 0.128), (1.0 - smoothstep(0.9, 1.4, x)) * dn)
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, vec3(0.012, 0.014, 0.017), ring * smoothstep(-0.25, 0.75, -n.y))
    col = mix(col, vec3(0.17, 0.188, 0.212), ring * dn * 0.8)
    return vec4(col * a, a)
}

// A FACE set into its bezel: a dark key (#202428 falling to #15181d) with a
// one-pixel outline (#3a4048) lighter on top (#4d545d). Round it a dark cut
// seats it in the slab; a raised face throws a short shadow into the cut
// under its foot. Hover brightens the outline; held, the face sinks: darker,
// a shade under its top edge, the top line gone.
let lm_face = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, raise: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lm_normal(p, c, h, r)
    let live = 1.0 - dis
    let up = raise * (1.0 - down * live)
    let seat = Finish.ring_out(d, 0.0, px, px) * (0.5 + 0.4 * smoothstep(0.0, 0.9, n.y))
    let sh = Finish.drop(p, c, h, r, vec2(0.0, 1.1 * up), 0.8 + 0.4 * up) * (0.3 + 0.4 * up) * (1.0 - a)
    var res = Finish.over(dst, vec4(0.0, 0.0, 0.0, max(seat, sh) * (1.0 - 0.5 * dis)))
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.125, 0.141, 0.161), vec3(0.082, 0.094, 0.114), t)
    col = col + vec3(0.018, 0.02, 0.022) * hover * live * (1.0 - down)
    let ins = Finish.inset(p, c, h, r, vec2(0.0, 1.6), 1.8)
    col = mix(col, col * 0.7, down * live)
    col = mix(col, vec3(0.0, 0.0, 0.0), clamp(ins * 0.7, 0.0, 0.8) * down * live)
    let upper = smoothstep(-0.3, 0.7, -n.y)
    // A faint light just under the top line of a raised face.
    col = col + vec3(0.028, 0.03, 0.034) * Finish.band(d, px, px * 2.0, px) * upper * up
    let ring = Finish.band(d, 0.0, px, px)
    var oc = mix(vec3(0.227, 0.251, 0.282), vec3(0.302, 0.329, 0.365), upper)
    oc = oc + vec3(0.1, 0.105, 0.11) * hover * live * (1.0 - down)
    oc = mix(oc, mix(vec3(0.36, 0.39, 0.425), vec3(0.47, 0.5, 0.54), upper), down * live)
    oc = mix(oc, col, 0.55 * dis)
    col = mix(col, oc, ring)
    col = mix(col, vec3(0.09, 0.1, 0.115), 0.45 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// The outline of a well or a face brightened: what an unlit control shows
// under the hand (a little) and held (more). One device pixel, lighter on top.
let lm_edge = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, amt: float) -> vec4 {
    if amt < 0.001 {
        return dst
    }
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let n = lm_normal(p, c, h, r)
    let e = Finish.band(d, 0.0, px, px) * min(amt, 1.0)
    let col = mix(vec3(0.35, 0.384, 0.42), vec3(0.52, 0.553, 0.592), smoothstep(-0.3, 0.7, -n.y))
    return Finish.over(dst, vec4(col * e, e))
}

// ---------------------------------------------------------------- light

// 1. THE LIT FRAME: a line 1.5 to 2 points wide just inside the face's
// edge, orange with a pale core; the face turns near black with a dark
// orange-brown rim (#3a1a0c) that falls off within 6 to 9 points; a hot
// spill just inside the line; outward on the bezel about 0.4 of the line
// one device pixel out, gone to a tenth by 2.5 points. `s` 1 is lit; up to
// 1.5 is brighter (hover, held); under 1 a partial light.
let lm_frame = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, s: float) -> vec4 {
    if s < 0.001 {
        return dst
    }
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = min(hi.y - lo.y, hi.x - lo.x)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let x = max(-d, 0.0)
    let lw = clamp(0.085 * hh, 1.2, 2.0)
    let k = clamp(0.13 * hh, 1.0, 3.0)
    let sv = min(s, 1.0)
    let hot = clamp((s - 1.0) * 2.0, 0.0, 1.0)
    var res = Finish.over(dst, vec4(0.0, 0.0, 0.0, 0.3 * sv * a))
    let bleed = exp(-max(x - lw, 0.0) / k) * a * sv * 0.62
    res = Finish.over(res, vec4(vec3(0.36, 0.13, 0.04) * bleed, bleed))
    let inl = Finish.band(d, 0.0, lw, px)
    let spill = exp(-max(x - lw, 0.0) / 0.7) * a * (0.3 + 0.15 * hot) * sv * (1.0 - inl)
    res = Finish.over(res, vec4(lm_glowc() * spill, spill * 0.35))
    let od = max(d, 0.0)
    let g = (0.42 + 0.1 * hot) * exp(-(od * od) / (2.0 * 1.45 * 1.45)) * (1.0 - a) * sv
    res = Finish.over(res, vec4(lm_glowc() * g, g * 0.45))
    let lc = mix(lm_orange(), mix(lm_orange(), lm_core(), 0.35), hot)
    let line = inl * sv
    res = Finish.over(res, vec4(lc * line, line))
    let core = Finish.band(d, lw * 0.3, lw * 0.7, px) * sv * (0.8 + 0.2 * hot)
    return Finish.over(res, vec4(lm_core() * core, core))
}

// FOCUS on a control that is not lit: a lit line round the OUTSIDE of the
// whole control -- its bezel's edge -- with a pale core and a close halo
// (gone within 3 points), the face left as it stands (still raised, not
// darkened). Chosen is lit inside the face; focus rings the bezel: the two
// never read alike.
let lm_focus = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, s: float) -> vec4 {
    if s < 0.001 {
        return dst
    }
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let x = max(-d, 0.0)
    let lw = clamp(0.06 * min(hi.y - lo.y, hi.x - lo.x), 1.0, 1.4)
    let od = max(d, 0.0)
    let g = 0.4 * exp(-(od * od) / (2.0 * 1.2 * 1.2)) * (1.0 - a) * s
    var res = Finish.over(dst, vec4(lm_glowc() * g, g * 0.45))
    let inl = Finish.band(d, 0.0, lw, px)
    let spill = 0.22 * exp(-max(x - lw, 0.0) / 0.8) * a * s * (1.0 - inl)
    res = Finish.over(res, vec4(lm_glowc() * spill, spill * 0.3))
    let line = inl * s
    res = Finish.over(res, vec4(lm_orange() * line, line))
    let core = Finish.band(d, lw * 0.3, lw * 0.7, px) * s * 0.6
    return Finish.over(res, vec4(lm_core() * core, core))
}

// 2. THE UNDER-LIGHT: a raised key throws a thin line of light at its foot,
// a pool on the bezel's rim below it, and the pool runs on past the bezel's
// foot onto the ground for about 3 points, gone by 4 (half the 8 point gap
// to a row below). `foot` is where the bezel ends under the face.
let lm_under = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, s: float, foot: float) -> vec4 {
    if s < 0.001 {
        return dst
    }
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let w = hi.x - lo.x
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let dx = (p.x - c.x) / max(0.34 * w, 2.0)
    let along = exp(-dx * dx)
    // On the rim: bright under the face, a little less at the bezel's foot.
    let rimy = clamp((p.y - hi.y) / max(foot - hi.y, 0.5), 0.0, 1.0)
    let past = max(p.y - foot, 0.0) / 1.9
    let fy = step(hi.y, p.y) * (1.0 - 0.35 * rimy) * exp(-past * past)
    // Across, it keeps to the face's width: full in the middle, gone at
    // the face's ends, so it never runs past the bezel toward a neighbour.
    let ax = abs(p.x - c.x) / max(h.x, 1.0)
    let pool = (1.0 - smoothstep(0.3, 1.0, ax)) * fy * (1.0 - a) * 0.72 * s
    var res = Finish.over(dst, vec4(lm_glowc() * pool, pool * 0.6))
    let low = smoothstep(0.35, 0.95, (p.y - c.y) / max(h.y, 0.01))
    let foot = Finish.band(d, 0.0, px * 1.5, px) * low * along * min(s, 1.0)
    let fc = mix(lm_orange(), lm_core(), smoothstep(0.55, 1.0, along) * 0.75)
    res = Finish.over(res, vec4(fc * foot, foot))
    // The light also warms the face just above its foot.
    let warm = exp(-max(-d, 0.0) / 1.2) * low * along * a * 0.18 * min(s, 1.0)
    return Finish.over(res, vec4(lm_glowc() * warm, warm * 0.3))
}

// 2b. THE LIT CELL: the chosen cell, the tab in use and the chosen radio
// tab. The face stays DARK: a deep red-brown glass (#3c140b), darkest in
// its upper middle. The light is a thin line just inside the edge, 1.15
// points on top and sides, 1.6 along the foot, orange with a pale hot core
// that is brightest along the foot. From the line a red glow bleeds inward:
// a point or so under the top, about 3 at the sides, and from the foot a
// deep red that rises over the lower third. A faint gloss lies over the
// upper part. Outward the light spills red on the bezel and the track for a
// few points, a little more under the foot. The label is lit orange on it.
// `s` 1 is lit, more under the hand, less held.
let lm_lit = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, s: float, dis: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let x = max(-d, 0.0)
    let od = max(d, 0.0)
    let live = 1.0 - dis
    let sv = clamp(s, 0.0, 1.3) * live
    // Where p lies: -1 at the top edge, 1 at the foot. The weights are
    // taken from position, not from the outline's normal, so no seam runs
    // in from a corner.
    let vy = (p.y - c.y) / max(h.y, 0.5)
    let foot = smoothstep(0.25, 0.95, vy)
    // The spill outside: red, strongest against the line, gone by 7.
    let near = 0.5 * exp(-od / 0.7) + 0.36 * exp(-(od * od) / (2.0 * 2.8 * 2.8))
    let g = near * (0.75 + 0.6 * foot) * (1.0 - a) * sv * (1.0 - smoothstep(5.0, 8.0, od))
    let gc = mix(vec3(0.8, 0.2, 0.05), vec3(0.42, 0.05, 0.015), smoothstep(0.3, 3.0, od))
    var res = Finish.over(dst, vec4(gc * g, g * 0.55))
    // The face: dark maroon glass.
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let lv = min(sv, 1.0)
    var col = vec3(0.235, 0.078, 0.042)
    // The deep red rising from the foot over the lower part.
    let rise = smoothstep(0.3, 1.0, t)
    col = mix(col, vec3(0.64, 0.05, 0.0), rise * rise * 0.88 * lv)
    // The glow the line bleeds inward from each edge: short under the
    // top, longer from the sides, strong over the foot.
    let lwt = 1.15
    let lwb = 1.6
    let dtop = max(p.y - lo.y - lwt, 0.0)
    let dbot = max(hi.y - p.y - lwb, 0.0)
    let dsid = max(min(p.x - lo.x, hi.x - p.x) - lwt, 0.0)
    let gt = 0.5 * exp(-dtop / 1.1)
    let gs = 0.5 * exp(-dsid / 2.2)
    let gb = 0.85 * exp(-dbot / 1.8)
    let ig = (1.0 - (1.0 - gt) * (1.0 - gs) * (1.0 - gb)) * lv
    col = mix(col, vec3(0.86, 0.2, 0.02), ig)
    // A faint gloss over the upper part.
    let gl = (1.0 - smoothstep(0.12, 0.5, t)) * smoothstep(0.8, 2.6, x)
    col = col + vec3(0.035, 0.022, 0.018) * gl
    col = col * (1.0 + Finish.grain(p / px, 0.02))
    // The line, orange; its pale core brightest along the foot.
    let lw = mix(lwt, lwb, foot)
    let inl = Finish.band(d, 0.0, lw, px) * min(sv, 1.15)
    let lc = mix(vec3(0.88, 0.48, 0.3), vec3(1.0, 0.56, 0.24), foot)
    col = mix(col, lc, clamp(inl, 0.0, 1.0))
    let core = Finish.band(d, lw * 0.3, lw * 0.72, px) * mix(0.18, 1.0, foot) * min(sv, 1.15)
    col = mix(col, vec3(1.0, 0.87, 0.64), clamp(core, 0.0, 1.0))
    col = mix(col, vec3(0.2, 0.2, 0.215), 0.75 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// 2c. THE LIT ROW: the lit cell drawn for a chosen row of a list, a face
// taller than a key. The same thin line with its pale core brightest along
// the foot; the face a darker, browner glass (#2d1914) the light bleeds into
// over fixed points, not over a share of the height: about 4 under the top,
// 5 in from the sides and 6 up from the foot. Outward its red light reaches
// `room` points and is gone there.
let lm_litrow = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, s: float, room: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let x = max(-d, 0.0)
    let od = max(d, 0.0)
    let sv = clamp(s, 0.0, 1.3)
    let lv = min(sv, 1.0)
    let vy = (p.y - c.y) / max(h.y, 0.5)
    let foot = smoothstep(0.25, 0.95, vy)
    let near = 0.5 * exp(-od / 0.9) + 0.34 * exp(-(od * od) / (2.0 * 2.3 * 2.3))
    let g = near * (0.75 + 0.5 * foot) * (1.0 - a) * sv * (1.0 - smoothstep(room * 0.45, room, od))
    let gc = mix(vec3(0.8, 0.2, 0.05), vec3(0.42, 0.05, 0.015), smoothstep(0.3, 3.0, od))
    var res = Finish.over(dst, vec4(gc * g, g * 0.55))
    var col = vec3(0.176, 0.098, 0.078)
    let lwt = 1.15
    let lwb = 1.6
    let dtop = max(p.y - lo.y - lwt, 0.0)
    let dbot = max(hi.y - p.y - lwb, 0.0)
    let dsid = max(min(p.x - lo.x, hi.x - p.x) - lwt, 0.0)
    let gt = 0.5 * exp(-dtop / 1.6)
    let gs = 0.55 * exp(-dsid / 3.5)
    let gb = 0.62 * exp(-dbot / 2.6)
    let ig = (1.0 - (1.0 - gt) * (1.0 - gs) * (1.0 - gb)) * lv
    col = mix(col, vec3(0.62, 0.14, 0.02), ig)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let gl = (1.0 - smoothstep(0.1, 0.45, t)) * smoothstep(0.8, 2.6, x)
    col = col + vec3(0.03, 0.02, 0.016) * gl
    col = col * (1.0 + Finish.grain(p / px, 0.02))
    let lw = mix(lwt, lwb, foot)
    let inl = Finish.band(d, 0.0, lw, px) * min(sv, 1.15)
    let lc = mix(vec3(0.88, 0.48, 0.3), vec3(1.0, 0.56, 0.24), foot)
    col = mix(col, lc, clamp(inl, 0.0, 1.0))
    let core = Finish.band(d, lw * 0.3, lw * 0.72, px) * mix(0.75, 1.0, foot) * min(sv, 1.15)
    col = mix(col, vec3(1.0, 0.87, 0.64), clamp(core, 0.0, 1.0))
    return Finish.over(res, vec4(col * a, a))
}

// 6. A LAMP: a dot `r` across the middle, orange with a pale centre and a
// halo of 2 to 3 points; off, a dark lens in a dark ring.
let lm_lamp = fn(dst: vec4, p: vec2, c: vec2, r: float, px: float, lit: float, dis: float) -> vec4 {
    let d = length(p - c) - r
    let a = Finish.cover(d, px)
    let od = max(d, 0.0)
    let li = lit * (1.0 - 0.7 * dis)
    let g = 0.45 * exp(-(od * od) / (2.0 * 1.1 * 1.1)) * (1.0 - a) * li
    var res = Finish.over(dst, vec4(lm_glowc() * g, g * 0.5))
    let rr = length(p - c) / max(r, 0.5)
    let body = mix(lm_orange(), lm_core(), (1.0 - smoothstep(0.0, 0.75, rr)) * 0.8)
    let off = mix(vec3(0.078, 0.086, 0.098), vec3(0.2, 0.216, 0.24), Finish.band(d, 0.0, px, px))
    var col = mix(off, body, li)
    col = mix(col, vec3(0.3, 0.2, 0.15), dis * lit * 0.6)
    return Finish.over(res, vec4(col * a, a))
}

// 4. A LIT TUBE in a groove: a thin line `tw` points across, lying along
// the middle of the well `wlo`..`whi` (corner `wr`) from `u0` to `u1` along
// it (x, or y where `vert` is 1). The line is orange (#f7873b) with a pale
// core (#ffb066). Its light turns the well's floor a dark red (#450300)
// over the lit stretch, orange right against the line and gone to the red
// within 2 points; it burns the well's rim a pale orange-brown (#944832)
// there and warms the slab round the well, gone within 4 points. Past the
// lit stretch the groove stays black.
let lm_tube = fn(dst: vec4, p: vec2, u0: float, u1: float, tw: float, px: float, dis: float, hot: float, wlo: vec2, whi: vec2, wr: float, vert: float) -> vec4 {
    let live = 1.0 - dis
    let wc = (wlo + whi) * 0.5
    let u = mix(p.x, p.y, vert)
    let v = mix(p.y - wc.y, p.x - wc.x, vert)
    let len = u1 - u0
    let on = step(0.3, len)
    let tr = max(min(tw * 0.5, len * 0.5), 0.01)
    let hl = max(len * 0.5 - tr, 0.0)
    let d = length(vec2(max(abs(u - (u0 + u1) * 0.5) - hl, 0.0), v)) - tr
    let a = Finish.cover(d, px) * on
    let od = max(d, 0.0)
    let hk = 1.0 + 0.25 * hot
    // Along the lit stretch, soft at its two ends.
    let am = smoothstep(u0 - 1.2, u0 + 1.2, u) * (1.0 - smoothstep(u1 - 1.2, u1 + 1.2, u)) * on * live
    let dw = Material.sd_box(p, wc, (whi - wlo) * 0.5, wr)
    let inw = Finish.cover(dw, px)
    // The floor: dark red over the stretch, orange against the line.
    let fl = 0.85 * am * inw
    var res = Finish.over(dst, vec4(vec3(0.27, 0.012, 0.0) * fl, fl))
    let near = exp(-od / 0.7) * inw * (1.0 - a) * on * live * hk
    res = Finish.over(res, vec4(vec3(1.0, 0.4, 0.08) * near, near * 0.3))
    // The rim of the well, lit along the stretch, the lower lip brighter.
    let rim = Finish.band(dw, 0.0, px, px) * am
    let rc = mix(vec3(0.58, 0.282, 0.196), vec3(0.65, 0.337, 0.24), step(0.0, v)) * hk
    res = Finish.over(res, vec4(rc * rim, rim))
    // The warm light on the slab past the rim.
    let ow = max(dw, 0.0)
    let wide = smoothstep(u0 - 3.0, u0 + 1.0, u) * (1.0 - smoothstep(u1 - 1.0, u1 + 3.0, u)) * on * live
    let og = 0.42 * exp(-ow / 1.5) * (1.0 - smoothstep(3.0, 4.5, ow)) * (1.0 - inw) * wide * hk
    res = Finish.over(res, vec4(vec3(0.47, 0.1, 0.012) * og, og))
    // The tube: a flat bright body, its pale core along the middle.
    let q = abs(v) / tr
    var col = mix(vec3(0.97, 0.53, 0.2), vec3(1.0, 0.69, 0.4), exp(-q * q * 4.0) * (0.85 + 0.15 * hot))
    col = mix(col, vec3(0.24, 0.22, 0.21), dis)
    return Finish.over(res, vec4(col * a, a))
}

// The three-quarter arc a waiting button turns in place of its label.
let lm_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// A screw head in a slab's corner, 6 points across: a dark counterbore
// with a light lip on its lower edge, a domed head lit from the top left
// with a bright rim above, and a slot across it.
let lm_screw = fn(dst: vec4, p: vec2, c: vec2, px: float) -> vec4 {
    let q = p - c
    let d0 = length(q) - 3.0
    let a0 = Finish.cover(d0, px)
    var res = Finish.over(dst, vec4(vec3(0.016, 0.02, 0.024) * a0, a0))
    // The counterbore's lower lip catches the light.
    let lip = Finish.band(d0, 0.0, px, px) * smoothstep(0.0, 0.8, q.y / 3.0)
    res = Finish.over(res, vec4(vec3(0.25, 0.27, 0.3) * lip * 0.8, lip * 0.8))
    let d1 = length(q) - 2.3
    let a1 = Finish.cover(d1, px)
    let lit = clamp(0.55 - 0.65 * (q.x * 0.45 + q.y * 0.9) / 2.3, 0.0, 1.0)
    var col = mix(vec3(0.12, 0.13, 0.15), vec3(0.38, 0.4, 0.43), lit)
    let rim = Finish.band(d1, 0.0, px, px) * smoothstep(0.2, -0.8, q.y / 2.3)
    col = mix(col, vec3(0.5, 0.53, 0.57), rim * 0.8)
    let sl = abs((q.x - q.y) * 0.7071) - 0.4
    col = mix(col, vec3(0.03, 0.035, 0.04), Finish.cover(sl, px) * step(length(q), 1.9))
    return Finish.over(res, vec4(col * a1, a1))
}

// ---------------------------------------------------------------- buttons

// Every button is a face set into its own bezel: a slab 28 points tall
// with a 7 point corner, the face 3 points in. Padding 14 each side (the
// bezel's 3 and 11 of room), the label on a 12 point line.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 28.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonXs.min_height = 20.0
mod.widgets.ButtonSm.min_height = 24.0
mod.widgets.ButtonLg.min_height = 32.0
mod.widgets.ButtonXl.min_height = 36.0
mod.widgets.ButtonFlat.draw_bg.border_radius = 3.5
mod.widgets.ButtonFlat.draw_bg.border_size = 0.34
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The bezel and its face for a box lo..hi: the rim, the corner of each.
let lm_rim = fn(hh: float) -> float {
    return clamp(0.125 * hh, 3.2, 4.0)
}

// The button and its variants share one face; `kind` picks it:
// 0 flat plate seated in its bezel, 1 raised key, 2 lit key (the lit
// frame and the light under it), 3 raised key with the light under it,
// 4 raised key with a lit legend, 5 danger, 6 outline (an empty bezel),
// 7 flatter (a face only under the hand).
let lm_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, dis: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 6.0
    let px = lm_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let rim = lm_rim(hh)
    let flo = vec2(lm_snap(rim, o.x, px), lm_snap(rim, o.y, px))
    let fhi = vec2(lm_snap(size.x - rim, o.x, px), lm_snap(size.y - rim, o.y, px))
    let rb = min(7.0, 0.3 * hh)
    let rf = max(rb - rim + 0.5, 2.0)
    let live = 1.0 - dis
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    var ink = vec3(0.788, 0.808, 0.831)
    if kind > 5.5 {
        let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, rb)
        let a = Finish.cover(d, px)
        let n = lm_normal(p, (lo + hi) * 0.5, (hi - lo) * 0.5, rb)
        if kind < 6.5 {
            // Outline: the bezel's edge alone, one device pixel, lighter on top.
            var ring = Finish.band(d, 0.0, px, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let col = mix(vec3(0.227, 0.251, 0.282), vec3(0.33, 0.357, 0.392), smoothstep(-0.3, 0.7, -n.y)) + vec3(0.1, 0.105, 0.11) * hover * live
            let ra = ring * mix(1.0, 0.45, dis)
            res = vec4(col * ra, ra)
            let wash = (0.05 * hover + 0.08 * down) * live * a * (1.0 - ring)
            res = Finish.over(res, vec4(vec3(0.0, 0.0, 0.0), wash * 2.0))
            res = Finish.over(res, vec4(vec3(0.788, 0.808, 0.831) * wash * 0.3, wash * 0.3))
        } else {
            // Flatter: a face comes up under the hand and sinks when held.
            let show = max(hover, down) * live
            if show > 0.001 {
                res = lm_face(res, p, flo, fhi, rf, px, 0.0, down, dis, 0.0) * show
            }
        }
        res = lm_focus(res, p, lo, hi, rb, px, focus * live)
    } else {
        res = lm_slab(p, lo, hi, rb, px, 1.0, hover * live, dis)
        var raise = 1.0
        if kind < 0.5 {
            raise = 0.0
        }
        res = lm_face(res, p, flo, fhi, rf, px, hover, down, dis, raise)
        // The light under a raised key: at rest on the lit and the
        // secondary key, a trace of it under the hand on any raised key,
        // none while held (the key is down in its bezel).
        var under = 0.32 * hover * raise
        if kind > 1.5 && kind < 3.5 {
            under = 0.85 + 0.15 * hover
        }
        under = under * live * (1.0 - 0.85 * down)
        res = lm_under(res, p, flo, fhi, rf, px, under, hi.y)
        // The lit frame on the lit key, brighter under the hand, held and
        // focused; any other key shows focus as the frame's line alone.
        if kind > 1.5 && kind < 2.5 {
            res = lm_frame(res, p, flo, fhi, rf, px, (1.0 + 0.2 * hover + 0.4 * down + 0.25 * focus) * live)
        } else {
            res = lm_focus(res, p, lo, hi, rb, px, focus * live)
        }
    }
    if loading > 0.001 {
        let c = (lo + hi) * 0.5
        let rad = max(min(hh, size.x) * 0.5 - rim - 5.0, 2.0)
        res = lm_spinner(res, p, c, rad, anim, loading, 1.5, vec3(1.0, 0.541, 0.235))
    }
    return res * lm_fade(pos, size, m)
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0, 0.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0, 0.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0, 0.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0, 0.0)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0, self.border_dash)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return lm_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0, 0.0)
}

