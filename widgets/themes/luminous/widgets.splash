// The segmented control: one bezel with a track punched along it, the
// answers standing in the track; the chosen answer is lit from within.
mod.widgets.SegmentedControl.segment_height = 24.0
mod.widgets.SegmentedControlFlat.segment_height = 24.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    let rb = min(7.0, 0.3 * (hi.y - lo.y))
    var res = lm_slab(p, lo, hi, rb, px, 1.0, 0.0, 0.0)
    // The track: a sunken ridge punched along the bezel, 1 point in. Its
    // floor dark, the shade of its upper wall under the top edge, and its
    // lower wall a band facing up that catches what light there is.
    let tlo = vec2(lm_snap(1.0, o.x, px), lm_snap(1.0, o.y, px))
    let thi = vec2(lm_snap(size.x - 1.0, o.x, px), lm_snap(size.y - 1.0, o.y, px))
    res = Finish.over(res, lm_track(p, tlo, thi, max(rb - 1.0, 2.0), px))
    return res * lm_fade(self.pos, size, m)
}
// The chosen answer: its cell of the track lit from within, filling the
// segment's box less half a point either side; its light spills on the
// track's floor beside it, the rim and a little on the ground.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    let m = 13.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let m = 13.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let clo = vec2(lm_snap(1.5, o.x, px), lm_snap(1.5, o.y, px))
    let chi = vec2(lm_snap(size.x - 1.5, o.x, px), lm_snap(size.y - 1.5, o.y, px))
    let res = lm_lit(vec4(0.0, 0.0, 0.0, 0.0), p, clo, chi, 4.5, px, 1.0, 0.0)
    return res * lm_fade(self.pos, size, m)
}
mod.widgets.SegmentedControlFlat.draw_text.text_style.font_size = 9.0
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style.font_size = 9.0
