// Tabs: the strip is one bezel; each quiet tab a raised face in it, the
// tab in use lit from within, its word lit orange on the dark glass.
mod.widgets.Tabs.height = 28.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    return lm_slab(p, lo, hi, min(7.0, 0.3 * (hi.y - lo.y)), px, 1.0, 0.0, 0.0) * lm_fade(self.pos, size, m)
}
// A tab's close cross, drawn by the tab's own face so it can burn orange on
// the tab in use: where the strip puts its mark (15 points square, 5 in
// from the right, centred in height), two strokes 1.4 points thick. The
// strip shows it on the tab in use, the one under the pointer, and on every
// tab 108 points wide or more; the mark the strip draws there itself is
// left empty (below).
let lm_cross = fn(dst: vec4, p: vec2, size: vec2, px: float, ink: vec3, lit: float, show: float) -> vec4 {
    if show < 0.5 {
        return dst
    }
    let cc = vec2(size.x - 12.5, size.y * 0.5)
    let k = 2.76
    let dk = min(lm_seg(p, cc - vec2(k, k), cc + vec2(k, k)), lm_seg(p, cc + vec2(k, -k), cc + vec2(-k, k))) - 0.7
    let hb = 0.4 * exp(-max(dk, 0.0) / 0.9) * (1.0 - Finish.cover(dk, px)) * lit
    var res = Finish.over(dst, vec4(lm_glowc() * hb, hb * 0.45))
    let a = Finish.cover(dk, px)
    return Finish.over(res, vec4(ink * a, a))
}
let lm_tab = fn(p: vec2, size: vec2, o: vec2, dpi: float, hover: float, active: float) -> vec4 {
    let px = lm_px(dpi)
    let lo = vec2(lm_snap(1.0, o.x, px), lm_snap(3.0, o.y, px))
    let hi = vec2(lm_snap(size.x - 1.0, o.x, px), lm_snap(size.y - 3.0, o.y, px))
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if active > 0.5 {
        // The tab in use: its face lit from within, the light spilling on
        // the strip's bezel round it.
        res = lm_lit(res, p, lo, hi, 4.0, px, 1.0, 0.0)
        res = lm_cross(res, p, size, px, vec3(1.0, 0.706, 0.486), 1.0, 1.0)
    } else {
        res = lm_face(res, p, lo, hi, 4.0, px, hover, 0.0, 0.0, 1.0)
        res = lm_under(res, p, lo, hi, 4.0, px, 0.28 * hover, hi.y + 3.0)
        let ink = mix(vec3(0.604, 0.639, 0.682), vec3(0.894, 0.91, 0.925), hover)
        res = lm_cross(res, p, size, px, ink, 0.0, max(hover, step(108.0, size.x)))
    }
    return res
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return lm_tab(self.pos * self.rect_size, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    return lm_tab(self.pos * self.rect_size, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 1.0, 0.0)
}
// The tab in use grows its quad downward for the light under it.
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let m = 12.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return lm_tab(p, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 1.0) * lm_fade(self.pos, self.rect_size, m)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
// The strip's own mark: the add plus in the grey line drawing; its close
// cross is drawn by the tab faces above, so here it draws nothing.
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let cc = self.rect_size * 0.5
    let r = min(self.rect_size.x, self.rect_size.y) * 0.26
    let dk = min(lm_seg(p, cc - vec2(r, 0.0), cc + vec2(r, 0.0)), lm_seg(p, cc - vec2(0.0, r), cc + vec2(0.0, r))) - 0.7
    let a = Finish.cover(dk, px) * step(0.5, self.plus)
    return vec4(vec3(0.604, 0.639, 0.682) * a, a)
}
mod.widgets.Tabs.draw_mark.color = #9aa3ae
mod.widgets.Tabs.draw_text.color = #aab2bc
mod.widgets.Tabs.draw_text_active.color = #ffb47c
mod.widgets.Tabs.draw_text.text_style.font_size = 9.0
mod.widgets.Tabs.draw_text_active.text_style.font_size = 9.0

// ---------------------------------------------------------------- feedback

// The progress bar: a slab 10 points tall with a 6 point well, the lit
// fill in it.
mod.widgets.ProgressBarFlat.height = 10.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(10.0, self.rect_size.y)
    let y0 = lm_snap((self.rect_size.y - th) * 0.5, o.y, px)
    let x0 = lm_snap(self.rect_size.x * self.start, o.x, px)
    let x1 = lm_snap(self.rect_size.x * self.end, o.x, px)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    let wlo = vec2(x0 + 1.333, y0 + 1.333)
    let whi = vec2(x1 - 1.333, y0 + th - 1.333)
    if self.track > 0.5 {
        res = lm_slab(p, vec2(x0, y0), vec2(x1, y0 + th), th * 0.5, px, 1.0, 0.0, 0.0)
        res = Finish.over(res, lm_well(p, wlo, whi, (whi.y - wlo.y) * 0.5, px, 1.0, 0.0))
    }
    let span = whi.x - wlo.x - 2.0
    var f0 = wlo.x + 1.0
    var f1 = f0 + span * clamp((self.value - self.start) / max(self.end - self.start, 0.001), 0.0, 1.0)
    if self.value < 0.0 {
        // Still: the sweep would need the pass clock, which a sheet may not
        // read, so the unknown amount is a lit stretch standing in the
        // middle with its ends fading.
        f0 = wlo.x + 1.0 + span * 0.3
        f1 = wlo.x + 1.0 + span * 0.7
    }
    var fill = lm_tube(vec4(0.0, 0.0, 0.0, 0.0), p, f0, f1, 2.0, px, 0.0, 0.0, wlo, whi, (whi.y - wlo.y) * 0.5, 0.0)
    // An intent other than the plain one tints the light with its colour.
    let ic = self.fill_color()
    let tint = step(0.5, self.intent)
    fill = vec4(mix(fill.rgb, fill.rgb * ic.rgb * 1.1, tint * 0.8), fill.a)
    if self.value < 0.0 {
        fill = fill * smoothstep(f0 - 1.0, f0 + span * 0.12, p.x) * smoothstep(f1 + 1.0, f1 - span * 0.12, p.x)
    }
    res = Finish.over(res, fill)
    return res * self.opacity * lm_fade(self.pos, self.rect_size, m)
}

// The level meter: cells 3 points long with 1.5 point gaps in a well in a
// slab; the light deep at the foot, orange, then hot, red-orange past the
// clip point; unlit cells dark; the clip lamp a lamp.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    let wa = min(across, 10.0)
    let wb0 = (across - wa) * 0.5
    let blo0 = mix(vec2(0.0, wb0), vec2(wb0, sz.y - bar), v)
    let bhi0 = mix(vec2(bar, wb0 + wa), vec2(wb0 + wa, sz.y), v)
    let blo = vec2(lm_snap(blo0.x, o.x, px), lm_snap(blo0.y, o.y, px))
    let bhi = vec2(lm_snap(bhi0.x, o.x, px), lm_snap(bhi0.y, o.y, px))
    var res = lm_slab(p, blo, bhi, 3.5, px, 0.0, 0.0, 0.0)
    res = Finish.over(res, lm_well(p, blo + vec2(2.0, 2.0), bhi - vec2(2.0, 2.0), 1.5, px, 1.0, 0.0))
    let pad = 3.0
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.5
    let ca = a - pad
    let cell = Finish.cover(abs(fract(ca / pitch) * pitch - 1.5) - 1.5, px)
    let share = clamp((floor(ca / pitch) * pitch + 1.5) / span, 0.0, 1.0)
    let inb = step(pad, a) * step(a, bar - pad) * step(wb0 + 3.0, b) * step(b, wb0 + wa - 3.0)
    let ha = max(self.hot_at, 0.7)
    let ht = max(self.hot_to, 0.9)
    var lit = mix(lm_deep(), lm_orange(), smoothstep(0.0, 1.0, share / ha))
    lit = mix(lit, vec3(1.0, 0.56, 0.3), step(ha, share))
    lit = mix(lit, vec3(1.0, 0.24, 0.1), step(ht, share))
    let qm = (b - (wb0 + wa * 0.5)) / max(0.3 * (wa - 6.0), px * 0.8)
    lit = mix(lit, lm_core(), exp(-qm * qm) * 0.5 * (1.0 - step(ht, share)))
    let on = step(share, self.level) * step(0.001, self.level)
    // The lit cells warm the floor between them the dark red a lit tube
    // gives its groove.
    let lit_to = pad + span * self.level
    let wfl = Finish.cover(Material.sd_box(p, (blo + bhi) * 0.5, (bhi - blo) * 0.5 - vec2(2.0, 2.0), 1.5), px)
    let fl = (1.0 - smoothstep(lit_to - 0.5, lit_to + 1.5, a)) * step(0.001, self.level) * wfl * 0.8 * self.opacity
    res = Finish.over(res, vec4(vec3(0.27, 0.012, 0.0) * fl, fl))
    let ghost = vec3(0.1, 0.11, 0.125)
    let col = mix(ghost, lit, on)
    res = Finish.over(res, vec4(col, 1.0) * cell * inb * self.opacity)
    let hold_at = floor((span * self.hold) / pitch) * pitch
    let hc = step(abs(floor(ca / pitch) * pitch - hold_at), 0.1) * step(0.002, self.hold)
    res = Finish.over(res, vec4(lm_orange(), 1.0) * hc * cell * inb * 0.85)
    if self.lamp > 0.5 {
        let lc = mix(vec2(bar + 3.0 + across * 0.5, sz.y * 0.5), vec2(sz.x * 0.5, across * 0.5), v)
        let rl = max(across * 0.5 - 3.0, 1.5)
        res = lm_lamp(res, p, lc, rl, px, step(0.5, self.over), 0.0)
    }
    return res * self.opacity
}

// The spinner keeps the library's own turning face and takes the orange.
mod.widgets.SpinnerFlat.draw_bg.color = #ff6a1e
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.18

// The rings, the arc and the stock bars keep their own faces; the plain
// intent reads orange, so the page has one accent.
mod.widgets.ProgressRingFlat.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressRing.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressArc.draw_bg.color_primary = #ff6a1e
mod.widgets.ActivityRings.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressBar.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressBarGradientX.draw_bg.color_primary = #ff6a1e
mod.widgets.ProgressBarGradientY.draw_bg.color_primary = #ff6a1e

// Words in the error intent beside a check box or a toggle: red-orange.
mod.widgets.CheckBoxFlat.draw_text.color_error = #ff6a4a
mod.widgets.ToggleFlat.draw_text.color_error = #ff6a4a

// ---------------------------------------------------------------- surfaces

// The scroll bar: no gutter; the thumb a slim dark slab with its outline,
// lighter under the hand.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 1.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.is_vertical
    let t0 = mix(sz.x * self.norm_scroll, sz.y * self.norm_scroll, v)
    let t1 = t0 + mix(sz.x * self.norm_handle, sz.y * self.norm_handle, v)
    let mid = mix(sz.y * 0.5, sz.x * 0.5, v)
    let tlo = mix(vec2(t0, mid - 3.0), vec2(mid - 3.0, t0), v)
    let thi = mix(vec2(t1, mid + 3.0), vec2(mid + 3.0, t1), v)
    let lo = vec2(lm_snap(tlo.x, o.x, px), lm_snap(tlo.y, o.y, px))
    let hi = vec2(lm_snap(thi.x, o.x, px), lm_snap(thi.y, o.y, px))
    let res = lm_face(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, 3.0, px, max(self.hover, self.drag), 0.0, 0.0, 0.0)
    return res * self.opacity
}

// The faint free grain a slab carries, in its own device pixels.
let lm_grain = fn(p: vec2, px: float) -> float {
    return Finish.grain(p / px, 0.014)
}

// A PANEL: a slab. A large one carries a screw in each corner.
let lm_panel = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, hover: float) -> vec4 {
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    var res = lm_slab(p, lo, hi, r, px, 1.4, hover, 0.0)
    let a = res.w
    let g = lm_grain(p, px) * a
    res = vec4(res.rgb + vec3(g, g, g) * step(0.99, a), res.w)
    if size.x > 120.0 && size.y > 70.0 {
        res = lm_screw(res, p, lo + vec2(7.0, 7.0), px)
        res = lm_screw(res, p, vec2(hi.x - 7.0, lo.y + 7.0), px)
        res = lm_screw(res, p, vec2(lo.x + 7.0, hi.y - 7.0), px)
        res = lm_screw(res, p, hi - vec2(7.0, 7.0), px)
    }
    return res
}
// 3. A PUNCHED PANEL with its LIT RIM: a bezel 3 points wide, a well in it,
// light leaking from behind the well's edge: a thin bright line along its
// inner rim, strongest along the top and in the corners, fading into the
// floor within 8 to 12 points; the middle stays dark.
let lm_tray = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, lit: float) -> vec4 {
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    var res = lm_slab(p, lo, hi, r, px, 1.4, 0.0, 0.0)
    let wlo = vec2(lm_snap(3.0, o.x, px), lm_snap(3.0, o.y, px))
    let whi = vec2(lm_snap(size.x - 3.0, o.x, px), lm_snap(size.y - 3.0, o.y, px))
    let wr = max(r - 2.5, 2.0)
    res = Finish.over(res, lm_well(p, wlo, whi, wr, px, 1.4, 0.0))
    let c = (wlo + whi) * 0.5
    let h = (whi - wlo) * 0.5
    let d = Material.sd_box(p, c, h, wr)
    let a = Finish.cover(d, px)
    let x = max(-d, 0.0)
    // Strongest along the top edge and in the corners, weak down the sides
    // and weakest along the foot. Which edge a point belongs to is read off
    // the nearest edge's direction, so the light keeps its strength all the
    // way into the panel from the top edge and fades by distance alone.
    let n = lm_normal(p, c, h, wr)
    let top = smoothstep(-0.3, 0.7, -n.y)
    let qx = abs(p.x - c.x) - (h.x - 14.0)
    let qy = abs(p.y - c.y) - (h.y - 14.0)
    let corner = smoothstep(0.0, 14.0, min(qx, qy))
    let foot = smoothstep(-0.3, 0.7, n.y)
    let strength = max(max(top, corner), 0.3 - 0.18 * foot) * lit
    let rimline = Finish.band(d, px, px * 2.5, px) * a * strength
    // Falls into the floor by distance: a tenth of the line by about 8
    // points, near nothing by 12; the middle of the panel stays dark.
    let fall = exp(-max(x - px * 2.0, 0.0) / 7.5) * a * strength * 0.62 * (1.0 - Finish.band(d, 0.0, px * 2.5, px))
    res = Finish.over(res, vec4(mix(lm_deep(), lm_glowc(), 0.35) * fall, fall * 0.8))
    let rc = mix(lm_orange(), lm_core(), 0.35 * max(top, corner))
    res = Finish.over(res, vec4(rc * rimline, rimline))
    let g = lm_grain(p, px) * 0.5 * a
    return vec4(res.rgb + vec3(g, g, g), res.w)
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 12.0 bottom: 12.0}
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    if self.sunken > 0.5 {
        return lm_tray(p, self.rect_size, self.rect_pos, px, 7.0, 1.0) * lm_fade(self.pos, self.rect_size, m)
    }
    return lm_panel(p, self.rect_size, self.rect_pos, px, 7.0, 0.0) * lm_fade(self.pos, self.rect_size, m)
}

// The rounded view keeps the colour its caller gives it, with a true
// corner and, when it is opaque, a one device pixel edge lighter on top.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let n = lm_normal(p, c, h, r)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    var ink = self.border_color
    if self.border_size < 0.01 {
        ink = vec4(mix(vec3(0.141, 0.157, 0.184), vec3(0.212, 0.235, 0.267), smoothstep(-0.25, 0.75, -n.y)), fill.a)
    }
    let a = Finish.cover(d, px)
    let bd = Finish.band(d, 0.0, max(self.border_size, px), px)
    let col = mix(fill.rgb, ink.rgb, bd * ink.a)
    return vec4(col * a * fill.a, a * fill.a) + vec4(ink.rgb * ink.a, ink.a) * bd * a * (1.0 - fill.a)
}

// The card: a slab. Elevated it throws a longer shadow; outlined it is the
// bezel's edge alone; under the hand its top line brightens.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 10.0 bottom: 10.0}
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let fade = lm_fade(self.pos, self.rect_size, m)
    let o = self.rect_pos
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(self.rect_size.x, o.x, px), lm_snap(self.rect_size.y, o.y, px))
    if self.border_size > 0.01 {
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 7.0)
        let n = lm_normal(p, c, h, 7.0)
        let ring = Finish.band(d, 0.0, px, px)
        let col = mix(vec3(0.227, 0.251, 0.282), vec3(0.33, 0.357, 0.392), smoothstep(-0.3, 0.7, -n.y)) + vec3(0.08, 0.08, 0.08) * self.hover
        return vec4(col * ring, ring) * fade
    }
    var res = lm_slab(p, lo, hi, 7.0, px, 1.4 + 0.3 * step(0.01, self.shadow_radius), self.hover, 0.0)
    let g = lm_grain(p, px) * res.w
    return vec4(res.rgb + vec3(g, g, g) * step(0.99, res.w), res.w) * fade
}

// A LIST SHARES ONE BEZEL. A scroll view the size of a list (under 320
// points tall; a page-sized one stays the ground) is a slab with a well
// punched in it, 3 points in, and its rows lie on the well's floor. The view
// gets a draw object of its own first, so the face written here reaches no
// other view.
mod.widgets.ScrollYView.draw_bg = mod.widgets.SolidView.draw_bg{}
mod.widgets.ScrollYView.show_bg = true
mod.widgets.ScrollYView.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    if sz.y > 320.0 || sz.x < 40.0 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let p = self.pos * sz
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(sz.x, o.x, px), lm_snap(sz.y, o.y, px))
    var res = lm_slab(p, lo, hi, 7.0, px, 0.0, 0.0, 0.0)
    let wlo = vec2(lm_snap(3.0, o.x, px), lm_snap(3.0, o.y, px))
    let whi = vec2(lm_snap(sz.x - 3.0, o.x, px), lm_snap(sz.y - 3.0, o.y, px))
    return Finish.over(res, lm_well(p, wlo, whi, 4.5, px, 1.2, 0.0))
}

// List rows: 10 points in, a device pixel divider (#232a31) under each;
// under the hand the row lifts a little; the chosen row sinks deeper in a
// lit frame, held 5 points in from the left so it clears a list bezel's rim.
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 0.0 bottom: 0.0}
// The row's quad grows 6 points for the light a chosen row spills.
mod.widgets.ListItem.clip_x = false
mod.widgets.ListItem.clip_y = false
mod.widgets.ListItem.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let m = 6.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - self.disabled
    let yb = lm_snap(self.rect_size.y, o.y, px)
    let div = step(yb - px, p.y) * step(p.y, yb) * step(10.0, p.x) * step(p.x, self.rect_size.x - 10.0)
    var res = vec4(0.137, 0.165, 0.192, 1.0) * div * (1.0 - self.selected)
    let lo = vec2(lm_snap(5.0, o.x, px), lm_snap(2.0, o.y, px))
    // Held clear of the scroll bar that stands over a list's right edge.
    let hi = vec2(lm_snap(self.rect_size.x - 11.0, o.x, px), yb - px * 2.0)
    let wash = (0.045 * self.hover + 0.03 * self.down) * live
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 4.0)
    let wa = Finish.cover(d, px) * wash
    res = Finish.over(res, vec4(vec3(0.788, 0.808, 0.831) * wa, wa))
    if self.selected > 0.001 {
        // Chosen: the row lit from within, as the chosen answer and the tab
        // in use are.
        let sl = lm_litrow(vec4(0.0, 0.0, 0.0, 0.0), p, lo, hi, 4.0, px, 1.0 + 0.12 * self.hover, 6.0)
        res = mix(res, sl, self.selected)
    }
    return res
}
mod.widgets.ListItem.draw_text.color = #d0d5db
mod.widgets.ListItem.draw_text_2.color = #8b95a1

// A chip is a small key in its bezel, cornered like every bezel (not a
// pill); keyed, its frame is lit.
mod.widgets.ChipFlat.draw_text.text_style.font_size = 9.0
mod.widgets.ChipFlat.palette.on_neutral = #c9ced4
mod.widgets.ChipFlat.palette.on_neutral_container = #c9ced4
mod.widgets.ChipFlat.palette.neutral = #c9ced4
mod.widgets.ChipFlat.palette.on_primary = #ff8a3c
mod.widgets.ChipFlat.palette.on_primary_container = #ff8a3c
mod.widgets.ChipFlat.palette.primary = #ff8a3c
mod.widgets.ChipFlat.palette.on_secondary_container = #c9ced4
mod.widgets.ChipFlat.palette.on_tertiary_container = #c9ced4
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 5.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 5.0
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(size.x, o.x, px), lm_snap(size.y, o.y, px))
    let hh = hi.y - lo.y
    let rim = 3.0
    let flo = vec2(lm_snap(rim, o.x, px), lm_snap(rim, o.y, px))
    let fhi = vec2(lm_snap(size.x - rim, o.x, px), lm_snap(size.y - rim, o.y, px))
    let rb = min(7.0, 0.3 * hh)
    let rf = max(rb - rim + 0.5, 2.0)
    var res = lm_slab(p, lo, hi, rb, px, 1.0, self.hover, 0.0)
    res = lm_face(res, p, flo, fhi, rf, px, self.hover, self.down, 0.0, 1.0)
    res = lm_under(res, p, flo, fhi, rf, px, 0.28 * self.hover * (1.0 - self.down), hi.y)
    return lm_frame(res, p, flo, fhi, rf, px, self.keyed) * lm_fade(self.pos, size, m)
}

// A count is a small dark face with orange figures.
mod.widgets.BadgePalette.neutral = #1d2127
mod.widgets.BadgePalette.on_neutral = #ff8a3c
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(lm_snap(0.0, o.x, px), lm_snap(0.0, o.y, px))
    let hi = vec2(lm_snap(self.rect_size.x - px * 0.49, o.x, px), lm_snap(self.rect_size.y - px * 0.49, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(min(h.x, h.y), 3.5)
    let d = Material.sd_box(p, c, h, r)
    let n = lm_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = self.color.rgb + vec3(0.02, 0.02, 0.02) * (1.0 - t) - vec3(0.02, 0.02, 0.02) * t
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(0.227, 0.251, 0.282), vec3(0.33, 0.357, 0.392), smoothstep(-0.3, 0.7, -n.y)), ring)
    let a = Finish.cover(d, px) * max(self.color.a, ring)
    return vec4(col * a, a)
}

// Dividers never glow: one device pixel, #232a31.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    return vec4(0.137, 0.165, 0.192, 1.0) * step(y, p.y) * step(p.y, y + px)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    return vec4(0.137, 0.165, 0.192, 1.0) * step(x, p.x) * step(p.x, x + px)
}

// ---------------------------------------------------------------- own faces

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.BurgerButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFlatterIcon.draw_icon.color = #c9ced4
mod.widgets.BurgerButton.draw_bg.bar_color = #c9ced4
mod.widgets.BurgerButton.draw_bg.bar_color_hover = #ff8a3c
mod.widgets.BurgerButton.draw_bg.bar_color_disabled = #5b636d
mod.widgets.CloseButton.draw_bg.cross_color_hover = #ff8a3c

// ---------------------------------------------------------------- field row

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it.
// Fields and buttons share the one 28 point row, bezel included.
let field_height = 28.0
let field_pad_v = 4.0
// Stock faces draw the corner doubled: 3.5 is a 7 point corner.
let field_radius = 3.5
// One device pixel; the faces written above draw their own edges.
let field_border = 0.34

// The room a Fit field takes. A minimum height rather than a height,
// because a line of text is shorter than a row, and the padding with it:
// where a field is Fit, the padding IS its height, and two fields padded
// differently part company again the moment the type grows.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box, and because writing a corner onto a
// draw struct that has no corner would add a slot its shader never reads.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: a number
// with a stepper, a date, a time. The height is all these take. A padding
// here would NOT hold the line off the box -- each of them measures its
// parts against the turtle's whole rect and draws them from the content
// origin, so the padding displaces the line instead of insetting it, and the
// number came out sitting on the bottom edge with its arrows split around it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
// The number's box strokes its own hairline and declares no border size.
mod.widgets.NumberField.draw_bg.border_radius = field_radius
// The drag-number's corner is written into its own shader, so it takes the
// room and keeps the box it draws.
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
// A picker is a date field in an anchor: the field inside fills the frame.
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own. It is
// a TextInput, so it inherits the minimum above, and a minimum as tall as the
// whole field, applied inside a well already that tall, pushed the line out
// through the bottom of the box.
mod.widgets.WellInput.min_height = 0.0

// ---------------------------------------------------------------- ground

// Plain views stop clipping so a slab's short shadow can fall past their
// edge; scroll views keep clipping their content.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false
mod.widgets.Window.pass.clear_color = #11161b
// The window's ground: blue-black #11161b, matte, a shade lighter toward
// the middle and darker at the corners, under a free grain (sd about
// 0.006, one value per device pixel: no lattice, nothing that repeats).
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = lm_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let q = (p - sz * 0.5) / max(sz * 0.62, vec2(1.0, 1.0))
    let v = smoothstep(0.0, 1.2, length(q))
    var col = mix(vec3(0.071, 0.09, 0.11), vec3(0.047, 0.062, 0.078), v)
    let g = Finish.grain(p / px, 0.016)
    return vec4(col + vec3(g, g, g), 1.0)
}

// ---------------------------------------------------------------- states

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
true
