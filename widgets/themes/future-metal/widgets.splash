use mod.prelude.widgets_internal.*

// Futuristic brushed metal with lit circuit traces cut into it. Raised parts
// are gunmetal caps with cut corners, brushed along their length, lit on a
// narrow shoulder from above and edged in black, casting a short shadow on
// the steel. Wells are cut into the plate with a steel lip under them.
// Knobs are spun steel in a dark bezel whose groove carries the value as a
// glowing cyan ring; thumbs are chrome balls. The one cyan is light: LED
// dashes under the legends, lit traces, rings and values. Every rim is one
// device pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 2.0 bottom: 6.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 26.
let field_height = 26.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #38424b

// Plain views stop clipping, so a part's shadow and light may fall into the
// gap beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let fm_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A box with its four corners cut at 45 degrees, `k` along each edge.
let fm_cbox = fn(p: vec2, c: vec2, h: vec2, k: float) -> float {
    return Finish.sd_chamfer(p, c, h, clamp(k, 0.0, min(h.x, h.y)))
}

// The outward normal of the cut box, by central differences.
let fm_norm = fn(p: vec2, c: vec2, h: vec2, k: float) -> vec2 {
    let e = 0.35
    let gx = fm_cbox(p + vec2(e, 0.0), c, h, k) - fm_cbox(p - vec2(e, 0.0), c, h, k)
    let gy = fm_cbox(p + vec2(0.0, e), c, h, k) - fm_cbox(p - vec2(0.0, e), c, h, k)
    return vec2(gx, gy) / max(length(vec2(gx, gy)), 0.0001)
}

// A segment's distance.
let fm_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroked chevron's distance: `w` wide, `hgt` tall, pointing down
// (`flip` 1 points up).
let fm_chevron = fn(p: vec2, c: vec2, w: float, hgt: float, flip: float) -> float {
    let s = mix(1.0, -1.0, flip)
    let a = c + vec2(-w * 0.5, -hgt * 0.5 * s)
    let b = c + vec2(0.0, hgt * 0.5 * s)
    let e = c + vec2(w * 0.5, -hgt * 0.5 * s)
    return min(fm_seg(p, a, b), fm_seg(p, b, e))
}

// A disc laid on the pixel grid: a whole number of device pixels across.
// `c` is quad-local; returns (centre.x, centre.y, radius).
let fm_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// The one accent: the white-hot core, the lit body, the dim glass.
let fm_core = fn() -> vec3 {
    return vec3(0.447, 0.973, 1.0)
}
let fm_cyan = fn() -> vec3 {
    return vec3(0.184, 0.776, 0.878)
}
let fm_dim = fn() -> vec3 {
    return vec3(0.063, 0.180, 0.212)
}
let fm_red = fn() -> vec3 {
    return vec3(1.0, 0.353, 0.392)
}
// The accent as disabled parts show it: unlit steel.
let fm_off = fn() -> vec3 {
    return vec3(0.216, 0.243, 0.263)
}
// The black edge every part stands in.
let fm_edge = fn() -> vec3 {
    return vec3(0.039, 0.055, 0.071)
}
let fm_ink = fn() -> vec3 {
    return vec3(0.016, 0.024, 0.035)
}
// The light comes from above and a little left.
let fm_light = fn() -> vec2 {
    return vec2(-0.26, -0.966)
}

// Signed grain, one value per device pixel (pass `p / px`); two hashes on
// displaced lattices, so no shift lines them up again.
let fm_grain = fn(q: vec2, amount: float) -> float {
    let i = floor(q)
    let h = Finish.hash(i)
    let a = Finish.hash(i + vec2(h * 397.13, h * 211.71))
    let b = Finish.hash(vec2(i.y * 0.7548 + h * 157.3, i.x * 1.1698 + h * 89.9))
    return (a + b - 1.0) * amount
}

// Brushed streaks along x, window space: fine streaks over long slow ones,
// -1..1 roughly.
let fm_brush = fn(q: vec2, px: float) -> float {
    let fine = Finish.brushed(q, vec2(1.0, 0.0), max(px, 0.7)) - 0.5
    let rowh = Finish.hash(vec2(floor(q.y / px) * 1.371 + 3.1, 17.9))
    let long = Finish.noise(vec2(q.x / 140.0 + rowh * 53.0, q.y / (px * 1.5))) - 0.5
    return fine * 0.8 + long * 0.9
}

// Gunmetal by height t 0..1: #4f5f69 at the top, #3d4a54 at the waist,
// #2b353d at the foot.
let fm_gun = fn(t: float) -> vec3 {
    let top = vec3(0.430, 0.488, 0.528)
    let mid = vec3(0.322, 0.370, 0.406)
    let foot = vec3(0.245, 0.285, 0.318)
    return mix(mix(top, mid, clamp(t * 2.0, 0.0, 1.0)), foot, clamp(t * 2.0 - 1.0, 0.0, 1.0))
}

// Light steel for plates and pads: #56646e to #38444d.
let fm_steel = fn(t: float) -> vec3 {
    return mix(vec3(0.420, 0.478, 0.518), vec3(0.290, 0.338, 0.375), t)
}

// A steel cap: the cut box lo..hi, gunmetal (tone 0) or light steel (1),
// brushed, lit on a narrow shoulder from above, a black edge. `press`
// sinks it: the fall turns over, the top wall shades the face and the
// shoulder takes its light from below.
let fm_cap = fn(p: vec2, o: vec2, lo: vec2, hi: vec2, k: float, px: float, hov: float, press: float, dis: float, tone: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fm_cbox(p, c, h, k)
    let n = fm_norm(p, c, h, k)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var face = mix(fm_gun(t), fm_steel(t), tone)
    // a soft sheen high on the face
    let st = (t - 0.08) / 0.09
    face = face + g3(0.08 * exp(-st * st) * (1.0 - press))
    face = face + g3(0.045 * hov)
    // pressed: a darker face, lit a little at the foot
    let sunk = mix(vec3(0.118, 0.145, 0.169), vec3(0.176, 0.212, 0.239), t)
    face = mix(face, sunk, press)
    let q = p + o
    face = face + g3(fm_brush(q, px) * 0.045 + fm_grain(q / px, 0.010))
    // the top wall's shade inside a pressed cap
    let ish = Finish.inset(p, c, h, k * 0.6, vec2(0.0, 1.6), 1.4) * press
    face = mix(face, fm_edge(), clamp(ish, 0.0, 1.0) * 0.8)
    // disabled: a flat unlit plate
    face = mix(face, vec3(0.200, 0.227, 0.251) + g3(fm_brush(q, px) * 0.012), dis * 0.9)
    // the shoulder
    let sh = Finish.bevel(d + px, n, 2.2, fm_light())
    let lit = mix(sh * (1.0 + 0.3 * hov), -sh * 0.55, press) * mix(1.0, 0.3, dis)
    face = Finish.lift(face, clamp(lit, -1.0, 1.0) * mix(0.85, 0.55, step(lit, 0.0)))
    // the black edge
    face = mix(face, fm_edge(), Finish.band(d, 0.0, px, px) * 0.95)
    let a = Finish.cover(d, px)
    return vec4(face * a, a)
}

// An LED dash: `lit` 0 is the dark lens in its slot, 1 the lit body with a
// white-hot core; returns the dash premultiplied.
let fm_dash = fn(p: vec2, c: vec2, hw: float, hh: float, px: float, ink: vec3, lit: float) -> vec4 {
    let d = fm_rbox(p, c, vec2(hw, hh), hh)
    let a = Finish.cover(d, px)
    let across = abs(p.y - c.y) / max(hh, 0.001)
    let along = abs(p.x - c.x) / max(hw, 0.001)
    let hot = (1.0 - smoothstep(0.0, 1.1, across)) * (1.0 - smoothstep(0.5, 1.0, along))
    let body = mix(mix(ink, vec3(1.0, 1.0, 1.0), 0.25), mix(ink, vec3(1.0, 1.0, 1.0), 0.75), hot * clamp(lit, 0.0, 1.0))
    let off = mix(vec3(0.035, 0.051, 0.063), ink * 0.22, 0.6)
    let col = mix(off, body, clamp(lit, 0.0, 1.0))
    return vec4(col * a, a)
}

// A well cut into the plate: the floor, the plate's shadow falling in from
// the top wall, a dark mouth darkest on top.
let fm_well = fn(p: vec2, c: vec2, h: vec2, k: float, px: float, fill: vec3, depth: float) -> vec3 {
    let d = fm_cbox(p, c, h, k)
    let sh = Finish.inset(p, c, h, max(k * 0.6, 0.5), vec2(0.0, depth * 0.5), max(depth * 0.4, px * 0.6))
    var col = mix(fill, fm_edge(), clamp(sh, 0.0, 1.0) * 0.85)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, fm_edge(), Finish.band(d, 0.0, px, px) * mix(0.55, 0.95, up))
    return col
}

// The steel lip under a well's lower rim, outside it: premultiplied white.
let fm_lip = fn(p: vec2, c: vec2, h: vec2, k: float, px: float, a: float) -> vec4 {
    let d = fm_cbox(p, c, h, k)
    let foot = smoothstep(c.y + h.y - max(k, 1.0) - 1.5, c.y + h.y, p.y)
    let l = Finish.ring_out(d, 0.0, px, px) * foot * a
    return vec4(l, l, l, l)
}

// Focus: one device pixel of cyan two device pixels out, with a soft
// breath of light round it.
let fm_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * 0.85 * focus
    let g = Finish.glow(max(d - 2.5 * px, 0.0), 1.0) * step(0.0, d) * 0.22 * focus
    let k = fm_cyan()
    let fa = clamp(f + g * (1.0 - f), 0.0, 1.0)
    let col = mix(k, fm_core(), f)
    return vec4(col * fa, fa)
}

// A chrome ball standing on the plate: its cast shadow, a sky above the
// horizon line, the steel below with a cyan bounce, a hot spot at the
// upper left, a dark rim.
let fm_ball = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = fm_ink()
    let cast = Finish.drop(p, c, vec2(rad, rad), rad, vec2(rad * 0.12, rad * 0.30), rad * 0.28) * 0.6 * mix(1.0, 0.4, dis)
    out = Finish.over(out, vec4(ink * cast, cast))
    let q = (p - c) / max(rad, 0.001)
    let r2 = dot(q, q)
    let z = sqrt(max(1.0 - r2, 0.0))
    let ry = 2.0 * z * q.y
    let sky = mix(vec3(0.94, 0.97, 0.99), vec3(0.60, 0.68, 0.73), smoothstep(-0.95, -0.05, ry))
    let gnd = mix(vec3(0.24, 0.28, 0.32), vec3(0.52, 0.60, 0.65), smoothstep(0.1, 0.9, ry))
    var col = mix(sky, gnd, smoothstep(-0.30, 0.20, ry))
    col = col + fm_cyan() * 0.22 * smoothstep(0.35, 1.0, q.y) * z * (1.0 - dis)
    col = col * mix(0.5, 1.0, smoothstep(0.0, 0.5, z))
    let sq = q - vec2(-0.30, -0.42)
    col = col + g3(0.55 * exp(-dot(sq, sq) / 0.025))
    col = col + g3(0.12 * hover - 0.08 * press)
    col = mix(col, g3(0.30) + 0.12 * col, dis * 0.8)
    let d = length(p - c) - rad
    col = mix(col, fm_edge(), Finish.band(d, 0.0, px, px) * 0.75)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(col * a, a))
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// A line of light at `at` across v, `wd` wide.
let fm_hl = fn(v: float, at: float, wd: float, px: float) -> float {
    return clamp((wd * 0.5 - abs(v - at)) / px + 0.5, 0.0, 1.0)
}

// ---------------------------------------------------------------------------
// THE CIRCUIT. A dark teal-black board with traces on it, built from cell
// grids at three scales. Every edge between two cells hashes whether a trace
// crosses it and where along it, so both cells agree and a trace runs on
// unbroken; inside a cell the traces meet at a hub, arriving straight and
// turning at 45 degrees. A slow density field makes busy clusters and quiet
// ground, a slow direction field lays them in bundles running mostly one way.
// A trace that ends stops in a ring via; an empty cell may hold a chip or a
// small part. Some traces are lit where a slow field says so, brightening and
// fading along their length.

// The port on one cell edge: `e` the edge's middle in cell units, `horiz` 1
// for an edge a horizontal trace crosses. Returns (1 if there is one, its
// place along the edge in points).
let fm_port = fn(e: vec2, horiz: float, s: float, seed: float, dens: float) -> vec2 {
    let dn = Finish.noise(e / 4.3 + vec2(seed * 7.13, seed * 3.31))
    let dir = Finish.noise(e / 7.1 + vec2(seed * 2.91 + 40.0, seed * 5.77 + 11.0))
    let busy = smoothstep(0.40 - dens, 0.56 - dens, dn)
    let pref = smoothstep(0.35, 0.65, mix(1.0 - dir, dir, horiz))
    let pr = busy * mix(0.05, 0.96, pref)
    // on or off by runs of about three edges along the trace, the runs of
    // neighbouring rows staggered, with a rare single break
    let along = mix(e.y, e.x, horiz)
    let across = mix(e.x, e.y, horiz)
    let rk = floor((along + Finish.hash(vec2(across * 1.37 + seed, horiz * 5.1 + 2.0)) * 3.0) / 3.0)
    let h1 = Finish.hash(vec2(rk * 1.731 + seed * 13.1 + horiz * 71.3, across * 2.117 + seed * 5.9 + 0.7)) * step(0.05, Finish.hash(e * vec2(2.71, 1.61) + vec2(seed * 2.3, horiz * 9.7)))
    let h2 = Finish.hash(e * vec2(3.173, 1.291) + vec2(seed * 3.7 + horiz * 19.1, 8.3))
    let t = 0.5 + (h2 - 0.5) * 0.46
    return vec2(step(1.0 - pr, h1), t * s)
}

// One cell of a layer: `l` the point in the cell (0..s). Returns (distance to
// the trace centre lines, distance to the centre of a via, signed distance
// to a part, kind of part: 0 none, 1 chip with pins, 2 small part; plus
// 0.5 where a chip's pin is).
let fm_cell = fn(l: vec2, cell: vec2, s: float, seed: float, dens: float) -> vec4 {
    let pl = fm_port(vec2(cell.x, cell.y + 0.5), 1.0, s, seed, dens)
    let pr = fm_port(vec2(cell.x + 1.0, cell.y + 0.5), 1.0, s, seed, dens)
    let pt = fm_port(vec2(cell.x + 0.5, cell.y), 0.0, s, seed, dens)
    let pb = fm_port(vec2(cell.x + 0.5, cell.y + 1.0), 0.0, s, seed, dens)
    let n = pl.x + pr.x + pt.x + pb.x
    let hc = Finish.hash(cell * vec2(1.93, 2.71) + vec2(seed * 9.1, 4.4))
    let hd = Finish.hash(cell * vec2(2.37, 1.13) + vec2(seed * 3.3, 7.9))
    let nv = pt.x + pb.x
    let nh = pl.x + pr.x
    // the hub: on the line of the ports, moved in toward the odd one so a
    // corner is cut at 45 degrees
    let k = s * (0.07 + 0.07 * hc)
    let hx = mix(s * (0.3 + 0.4 * hc), (pt.x * pt.y + pb.x * pb.y) / max(nv, 1.0), step(0.5, nv)) + k * (pr.x - pl.x)
    let hy = mix(s * (0.3 + 0.4 * hd), (pl.x * pl.y + pr.x * pr.y) / max(nh, 1.0), step(0.5, nh)) + k * (pb.x - pt.x)
    let hub = vec2(hx, hy)
    let big = 1000.0
    let al = vec2(clamp(hx - abs(hy - pl.y), 0.0, s), pl.y)
    let ar = vec2(clamp(hx + abs(hy - pr.y), 0.0, s), pr.y)
    let at = vec2(pt.y, clamp(hy - abs(hx - pt.y), 0.0, s))
    let ab = vec2(pb.y, clamp(hy + abs(hx - pb.y), 0.0, s))
    var d = big
    d = min(d, mix(big, min(fm_seg(l, vec2(0.0, pl.y), al), fm_seg(l, al, hub)), pl.x))
    d = min(d, mix(big, min(fm_seg(l, vec2(s, pr.y), ar), fm_seg(l, ar, hub)), pr.x))
    d = min(d, mix(big, min(fm_seg(l, vec2(pt.y, 0.0), at), fm_seg(l, at, hub)), pt.x))
    d = min(d, mix(big, min(fm_seg(l, vec2(pb.y, s), ab), fm_seg(l, ab, hub)), pb.x))
    // a via where a trace ends, now and then where traces meet
    let viaon = max(step(0.5, n) * step(n, 1.5) * step(0.35, hd), step(2.5, n) * step(0.55, hd))
    let dp = mix(big, length(l - hub), viaon)
    // an empty cell may hold a chip (pins along two sides) or a small part
    var dc = big
    var kind = 0.0
    if n < 0.5 {
        let hk = Finish.hash(cell * vec2(3.71, 2.93) + vec2(seed * 1.7, 2.2))
        let hr = step(0.5, Finish.hash(cell * vec2(1.17, 3.39) + vec2(seed * 4.1, 6.6)))
        let cc = vec2(s * (0.42 + 0.16 * hc), s * (0.42 + 0.16 * hd))
        let rel = l - cc
        let rl = mix(rel, vec2(rel.y, rel.x), hr)
        if hk > 0.45 {
            let hh = vec2(s * 0.20, s * 0.11)
            dc = fm_rbox(rl, vec2(0.0, 0.0), hh, s * 0.02)
            kind = 1.0
            let pitch = s * 0.065
            let pin = step(hh.y, abs(rl.y)) * step(abs(rl.y), hh.y + s * 0.045) * step(abs(rl.x), hh.x - s * 0.03) * step(fract(rl.x / pitch + 0.25), 0.5)
            kind = kind + 0.5 * pin
        }
        if hk > 0.15 && hk < 0.45 {
            dc = fm_rbox(rl, vec2(0.0, 0.0), vec2(s * 0.08, s * 0.04), s * 0.01)
            kind = 2.0 + 0.5 * step(s * 0.05, abs(rl.x))
        }
    }
    return vec4(d, dp, dc, kind)
}

// A layer at cell size `s`: the cell under the point in full, and the
// traces and vias of the three neighbours toward it, so a glow runs on
// across a cell's edge.
let fm_layer = fn(q: vec2, s: float, seed: float, dens: float) -> vec4 {
    let cell = floor(q / s)
    let f = q / s - cell
    let ox = mix(-1.0, 1.0, step(0.5, f.x))
    let oy = mix(-1.0, 1.0, step(0.5, f.y))
    let r = fm_cell(q - cell * s, cell, s, seed, dens)
    let c1 = cell + vec2(ox, 0.0)
    let c2 = cell + vec2(0.0, oy)
    let c3 = cell + vec2(ox, oy)
    let a = fm_cell(q - c1 * s, c1, s, seed, dens)
    let b = fm_cell(q - c2 * s, c2, s, seed, dens)
    let c = fm_cell(q - c3 * s, c3, s, seed, dens)
    return vec4(min(r.x, min(a.x, min(b.x, c.x))), min(r.y, min(a.y, min(b.y, c.y))), r.z, r.w)
}

// How lit the traces of a layer are at q: a slow field, so a lit trace
// brightens and fades along its length; most of the board stays dim.
let fm_lit = fn(q: vec2, sc: float, seed: float, lo: float) -> float {
    let v = Finish.noise(q / sc + vec2(seed * 17.3, seed * 9.1)) * 0.7 + Finish.noise(q / (sc * 0.37) + vec2(seed * 3.9, 21.0)) * 0.3
    return smoothstep(lo, lo + 0.1, v)
}

// The board at q (points, anchored where the caller anchors it). `soft`
// widens every edge (the frost of the pane in front); `calm` 0..1 dims the
// lit traces (under text).
let fm_board = fn(q: vec2, px: float, soft: float, calm: float, frost: float) -> vec3 {
    let aa = px * soft
    // behind frost a lit trace spreads: a softer, wider glow, a paler core
    let hot = 1.0 - 0.8 * frost
    let bodyk = 1.0 - 0.45 * frost
    let spread = 1.0 + 0.6 * frost
    let gk = 1.0 - 0.3 * frost
    let cl = Finish.noise(q / 110.0) * 0.6 + Finish.noise(q / 31.0 + vec2(7.0, 3.0)) * 0.4
    var col = mix(vec3(0.031, 0.071, 0.094), vec3(0.071, 0.118, 0.141), cl)
    col = col + g3(fm_grain(q / px, 0.012))
    let quiet = 1.0 - calm
    // the fine signal lines: many, thin, never lit
    let qa = q + vec2(3.1, 5.7)
    let la = fm_cell(qa - floor(qa / 5.5) * 5.5, floor(qa / 5.5), 5.5, 1.0, -0.04)
    col = mix(col, vec3(0.106, 0.200, 0.235), Finish.cover(la.x - 0.33, aa) * 0.8)
    // the wide flat buses: a pale fill in a brighter outline
    let qc = q + vec2(17.3, 11.9)
    let lc = fm_layer(qc, 46.0, 3.0, 0.16)
    let litc = fm_lit(q, 240.0, 3.0, 0.52) * quiet * (1.0 - 0.3 * frost)
    let wc = 7.0
    let cfill = mix(vec3(0.120, 0.225, 0.262), vec3(0.110, 0.300, 0.350), litc * bodyk)
    col = mix(col, cfill, Finish.cover(lc.x - wc * 0.5, aa) * 0.9)
    col = col + fm_cyan() * Finish.glow(max(lc.x - wc * 0.5, 0.0), 4.0 * spread) * step(wc * 0.5, lc.x) * 0.40 * litc * gk
    let crim = Finish.cover(abs(lc.x - wc * 0.5 + 0.5) - 0.5, aa)
    col = mix(col, mix(vec3(0.380, 0.540, 0.590), mix(fm_cyan(), fm_core(), 0.55 * hot), litc * bodyk), crim * 0.95)
    // a part in an empty bus cell: a chip with its pins, a small part
    let kind = floor(lc.w)
    let pin = step(0.25, fract(lc.w))
    let body = Finish.cover(lc.z, aa)
    col = mix(col, vec3(0.200, 0.260, 0.285), pin * step(0.5, kind) * step(kind, 1.5))
    let chip = mix(vec3(0.028, 0.040, 0.048), vec3(0.070, 0.090, 0.100), smoothstep(-6.0, 0.0, lc.z))
    col = mix(col, mix(chip, vec3(0.200, 0.290, 0.320), Finish.cover(abs(lc.z + 0.6) - 0.4, aa) * 0.7), body * step(0.5, kind) * step(kind, 1.5))
    let smd = mix(vec3(0.060, 0.080, 0.090), vec3(0.330, 0.390, 0.410), step(0.25, fract(lc.w)))
    col = mix(col, smd, body * step(1.5, kind))
    // the signal bus: mid traces, some lit
    let qb = q + vec2(7.7, 2.3)
    let lb = fm_layer(qb, 19.0, 5.0, 0.0)
    let litb = fm_lit(q, 150.0, 5.0, 0.54) * quiet * (1.0 - 0.2 * frost)
    let wb = 2.4
    col = col + fm_cyan() * Finish.glow(max(lb.x - wb * 0.5, 0.0), 3.2 * spread) * step(wb * 0.5, lb.x) * 0.55 * litb * gk
    let tb = Finish.tube(lb.x, wb, aa)
    col = mix(col, mix(vec3(0.190, 0.320, 0.370), fm_cyan(), litb * bodyk), Finish.cover(lb.x - wb * 0.5, aa))
    col = mix(col, mix(fm_core(), vec3(1.0, 1.0, 1.0), 0.45), tb.x * litb * hot)
    // ring vias of both layers
    let rv = abs(lb.y - 2.5) - 0.8
    col = mix(col, mix(vec3(0.300, 0.430, 0.470), mix(fm_cyan(), fm_core(), 0.6 * hot), litb * bodyk), Finish.cover(rv, aa))
    col = mix(col, vec3(0.012, 0.024, 0.031), Finish.cover(lb.y - 1.6, aa))
    let rc = abs(lc.y - 5.6) - 1.6
    col = mix(col, mix(vec3(0.270, 0.390, 0.430), mix(fm_cyan(), fm_core(), 0.5 * hot), litc * bodyk), Finish.cover(rc, aa))
    col = mix(col, vec3(0.012, 0.024, 0.031), Finish.cover(lc.y - 3.8, aa))
    return col
}

// A pane of frosted blue-white plastic lying on the board: it lightens and
// softens what is behind it, tints it pale blue, and carries a soft diagonal
// reflection (`refl` 0..1 at this point).
let fm_pane = fn(board: vec3, q: vec2, px: float, refl: float, tint: float) -> vec3 {
    // the frost is a little uneven, as a moulded pane is
    let fz = Finish.noise(q / 70.0 + vec2(3.3, 8.1)) - 0.5
    var c = board * 0.82 + vec3(0.420, 0.540, 0.600) * (tint + 0.06 * fz)
    c = c + vec3(0.85, 0.93, 1.0) * refl
    c = c + g3(fm_grain(q / px + vec2(311.0, 97.0), 0.010))
    return c
}

// Union of two distances with the inner corner cut at 45 degrees, `r` deep.
let fm_uc = fn(a: float, b: float, r: float) -> float {
    return min(min(a, b), (a + b - r) * 0.7071)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing:
// 0 flat plate (no shadow, no dash), 1 raised with a standby dash,
// 2 raised with the dash lit and the face lit from its foot (primary),
// 3 raised with the dash half lit (secondary), 4 raised with a red dash
// (danger), 5 a steel frame round the ground (outline), 6 bare until
// touched, 7 a light steel pad (tertiary), 8 raised with no dash (chips).
// The quad is grown by `m` on every side for the shadow and the focus ring.
let fm_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, k: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live * (1.0 - press)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fm_cbox(p, c, h, k)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let outl = step(4.5, kind) * step(kind, 5.5)
    let pad = step(6.5, kind) * step(kind, 7.5)
    let flat = 1.0 - step(0.5, kind)
    let solid = 1.0 - bare - outl
    let raised = solid * (1.0 - flat)

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = fm_ink()
    // the soft layer: mostly below, faded within half the gap to a neighbour
    let soft = Finish.drop(p, c, h, k * 0.6, vec2(0.0, 2.0), 1.8) * 0.55 * raised * (1.0 - press) * live
    out = Finish.over(out, vec4(ink * soft, soft))
    let con = Finish.drop(p, c, h, k * 0.6, vec2(0.0, px), px * 1.2) * 0.7 * solid * mix(1.0, 0.3, press) * mix(1.0, 0.5, disabled)
    out = Finish.over(out, vec4(ink * con, con))

    // the cap
    var tone = pad
    var cap = fm_cap(p, o, lo, hi, k, px, hov, press, disabled, tone)
    if flat > 0.5 {
        // the flat plate: a darker slab with a gentler shoulder
        let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
        var face = mix(vec3(0.176, 0.212, 0.239), vec3(0.137, 0.165, 0.188), t)
        face = face + g3(0.035 * hov - 0.04 * press + fm_brush(p + o, px) * 0.02)
        face = mix(face, vec3(0.184, 0.208, 0.227), disabled * 0.8)
        let n = fm_norm(p, c, h, k)
        let sh = Finish.bevel(d + px, n, 1.0, fm_light()) * (1.0 - press) * mix(1.0, 0.3, disabled)
        face = Finish.lift(face, sh * 0.30)
        face = mix(face, fm_edge(), Finish.band(d, 0.0, px, px) * 0.9)
        let fa = Finish.cover(d, px)
        cap = vec4(face * fa, fa)
    }
    // the outline and the bare face: only a frame, or nothing, until touched
    var fa2 = 1.0
    if kind > 4.5 && kind < 6.5 {
        fa2 = mix(0.0, 0.5, hov) + 0.6 * press
    }
    out = Finish.over(out, cap * fa2)
    if outl > 0.5 {
        // dark glass inside the frame, so the legend reads on any ground
        let ga = Finish.cover(d, px) * 0.8 * (1.0 - fa2 * 0.5)
        let gt = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
        let gc = mix(vec3(0.090, 0.115, 0.135), vec3(0.060, 0.078, 0.094), gt) + g3(0.05 * hov)
        out = Finish.over(out, vec4(gc * ga, ga))
        // a steel frame two points wide, lit on its upper run
        let n = fm_norm(p, c, h, k)
        let fr = Finish.band(d, 0.0, 2.0, px)
        let lt = clamp(dot(n, fm_light()), -1.0, 1.0)
        var fc = mix(vec3(0.290, 0.337, 0.373), vec3(0.62, 0.69, 0.73), clamp(lt, 0.0, 1.0))
        fc = mix(fc, vec3(0.16, 0.19, 0.21), clamp(-lt, 0.0, 1.0))
        fc = mix(fc, vec3(0.25, 0.28, 0.30), disabled)
        fc = mix(fc, fm_edge(), max(Finish.band(d, 0.0, px, px), Finish.band(d, 2.0 - px, 2.0, px)) * 0.9)
        out = Finish.over(out, vec4(fc * fr, fr))
    }

    // the dash under the legend
    let has_dash = step(0.5, kind) * step(kind, 4.5) + pad + outl
    if has_dash > 0.5 {
        let hw = clamp(h.x * 0.26, 5.0, 11.0)
        let dy = Finish.snap(o.y + hi.y - 5.0, px) - o.y
        let dc = vec2(Finish.snap(o.x + c.x, px) - o.x, dy)
        let is_red = step(3.5, kind) * step(kind, 4.5)
        var base = 0.72
        if kind > 1.5 && kind < 2.5 {
            base = 1.0
        }
        if kind > 2.5 && kind < 3.5 {
            base = 0.85
        }
        if is_red > 0.5 {
            base = 0.85
        }
        if outl > 0.5 {
            base = 0.3
        }
        let lit = clamp(base + 0.3 * hov + press, 0.0, 1.0) * live
        let dink = mix(fm_cyan(), fm_red(), is_red)
        let a_cap = Finish.cover(d, px)
        // the light it throws on the metal round it, inside the cap
        let dd = fm_rbox(p, dc, vec2(hw, px * 2.0), px * 2.0)
        let gl = Finish.glow(max(dd, 0.0) + 0.6, 3.2 + 1.2 * hov) * step(0.0, dd) * lit * (0.62 + 0.3 * hov) * a_cap
        out = vec4(out.rgb + dink * gl, out.a)
        // the primary's face takes the light rising from its foot
        if kind > 1.5 && kind < 2.5 {
            let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
            let rise = smoothstep(0.35, 1.0, t) * 0.16 * lit * a_cap * (1.0 - Finish.band(d, 0.0, px, px))
            out = vec4(out.rgb + fm_cyan() * rise, out.a)
        }
        let dash = fm_dash(p, dc, hw, px * 2.0, px, dink, lit)
        out = Finish.over(out, dash)
    }

    out = Finish.over(out, fm_focus(d, px, focus * live))

    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        let kk = fm_cyan()
        sdf.fill(vec4(kk * loading, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The drop-down face: the cap with an engraved split 22 points from its
// right end and a stroked chevron behind it; `held` is pressed.
let fm_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, disabled: float, m: float) -> vec4 {
    var out = fm_button(pos, size, o, px, hover, held, focus, disabled, 0.0, 0.0, 3.0, 8.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.22, p.y) * step(p.y, size.y * 0.78)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * 0.9
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.5 * (1.0 - held)
    let bz = fm_edge()
    out = Finish.over(out, vec4(bz * div_d, div_d))
    let hl = vec3(0.45, 0.52, 0.57)
    out = Finish.over(out, vec4(hl * div_l, div_l))
    let cc = vec2(size.x - 11.0, Finish.snap(o.y + size.y * 0.5, px) - o.y + held * live * px)
    let ch = Finish.cover(fm_chevron(p, cc, 6.0, 3.5, 0.0) - 0.7, px)
    let ink = mix(mix(vec3(0.75, 0.80, 0.84), fm_core(), hover * live * 0.6), vec3(0.36, 0.40, 0.43), disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the raised faces grow their quad for the shadow and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fm_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 3.0, 0.0, 0.0)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fm_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 3.0, 6.0, 0.0)
}
mod.widgets.Button.draw_bg.vertex = fn() {
    let g = grow_vertex(self.rect_pos, self.rect_size, 8.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fm_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 3.0, 1.0, 8.0)
}
