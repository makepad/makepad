mod.theme = mod.themes.dark

// Futuristic brushed metal with lit circuit traces cut into it. Brushed
// steel plates with cut corners and engraved panel lines; caps of gunmetal
// with a lit shoulder; one cyan, drawn as lit lines, LED dashes and glowing
// rings. Every state of a family is spelled out, because the base derived
// its states once, from its own colours.

// The plate: a cool blue steel.
mod.theme.color_bg_app = #38424b
mod.theme.color_fg_app = #343e46
mod.theme.color_bg_container = #343e46
mod.theme.color_surface_container_lowest = #1a2229

// Raised faces: gunmetal caps, lit at the top, falling to the foot.
mod.theme.color_outset = #3d4a54
mod.theme.color_outset_1 = #4f5f69
mod.theme.color_outset_2 = #2b353d
mod.theme.color_outset_hover = #44525c
mod.theme.color_outset_1_hover = #566771
mod.theme.color_outset_2_hover = #313c45
mod.theme.color_outset_down = #252e35
mod.theme.color_outset_1_down = #252e35
mod.theme.color_outset_2_down = #252e35
mod.theme.color_outset_focus = #3d4a54
mod.theme.color_outset_1_focus = #4f5f69
mod.theme.color_outset_2_focus = #2b353d
mod.theme.color_outset_active = #3d4a54
mod.theme.color_outset_1_active = #4f5f69
mod.theme.color_outset_2_active = #2b353d
mod.theme.color_outset_disabled = #333b42
mod.theme.color_outset_1_disabled = #333b42
mod.theme.color_outset_2_disabled = #333b42

// Wells: fields, tracks and boxes cut into the plate.
mod.theme.color_inset = #182028
mod.theme.color_inset_1 = #182028
mod.theme.color_inset_2 = #182028
mod.theme.color_inset_hover = #1c252d
mod.theme.color_inset_1_hover = #1c252d
mod.theme.color_inset_2_hover = #1c252d
mod.theme.color_inset_focus = #1a232b
mod.theme.color_inset_1_focus = #1a232b
mod.theme.color_inset_2_focus = #1a232b
mod.theme.color_inset_active = #182028
mod.theme.color_inset_1_active = #182028
mod.theme.color_inset_2_active = #182028
mod.theme.color_inset_down = #141b21
mod.theme.color_inset_1_down = #141b21
mod.theme.color_inset_2_down = #141b21
mod.theme.color_inset_drag = #141b21
mod.theme.color_inset_1_drag = #141b21
mod.theme.color_inset_2_drag = #141b21
mod.theme.color_inset_empty = #182028
mod.theme.color_inset_1_empty = #182028
mod.theme.color_inset_2_empty = #182028
mod.theme.color_inset_disabled = #262e35
mod.theme.color_inset_1_disabled = #262e35
mod.theme.color_inset_2_disabled = #262e35

// The edge a stock face still draws: the lit top line over the dark foot.
mod.theme.color_bevel = #6a7a85
mod.theme.color_bevel_hover = #7d8e99
mod.theme.color_bevel_focus = #30c8e2
mod.theme.color_bevel_down = #0e1317
mod.theme.color_bevel_active = #6a7a85
mod.theme.color_bevel_empty = #6a7a85
mod.theme.color_bevel_disabled = #3b454d
mod.theme.color_bevel_inset_1 = #0c1115
mod.theme.color_bevel_inset_2 = #5a6974
mod.theme.color_bevel_outset_1 = #8394a0
mod.theme.color_bevel_outset_2 = #0c1115
mod.theme.beveling = 0.5

// Ink: a cool pale steel legend; a dimmer steel for idle marks.
mod.theme.color_text = #f2f6f9
mod.theme.color_text_hover = #ffffff
mod.theme.color_text_focus = #f2f6f9
mod.theme.color_text_active = #f2f6f9
mod.theme.color_text_down = #bcc8d0
mod.theme.color_text_disabled = #6b777f
mod.theme.color_text_placeholder = #7f8c95
mod.theme.color_text_placeholder_hover = #909ca5
mod.theme.color_text_val = #eef3f6
mod.theme.color_text_hl = #f2f6f9
mod.theme.color_text_meta = #e2e9ee
mod.theme.color_text_cursor = #30c8e2
mod.theme.color_cursor = #30c8e2
mod.theme.color_label = #f2f6f9
mod.theme.color_label_hover = #ffffff
mod.theme.color_label_focus = #f2f6f9
mod.theme.color_label_active = #f2f6f9
mod.theme.color_label_down = #bcc8d0
mod.theme.color_label_disabled = #2e373e
mod.theme.color_label_inner = #f2f6f9
mod.theme.color_label_inner_hover = #ffffff
mod.theme.color_label_inner_focus = #f2f6f9
mod.theme.color_label_inner_active = #f2f6f9
mod.theme.color_label_inner_down = #bcc8d0
mod.theme.color_label_inner_disabled = #6b777f
mod.theme.color_label_outer = #f2f6f9
mod.theme.color_label_outer_hover = #ffffff
mod.theme.color_label_outer_focus = #f2f6f9
mod.theme.color_label_outer_active = #f2f6f9
mod.theme.color_label_outer_down = #bcc8d0
mod.theme.color_label_outer_disabled = #2e373e
mod.theme.color_icon = #f2f6f9
mod.theme.color_icon_hover = #f0f6fa
mod.theme.color_icon_focus = #dce4ea
mod.theme.color_icon_active = #dce4ea
mod.theme.color_icon_down = #bcc8d0
mod.theme.color_icon_disabled = #6b777f

// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`. One cyan, for light and what is on.
mod.theme.color_ctrl_selected = #30c8e2
mod.theme.color_focus = #30c8e2
mod.theme.color_ctrl_active = #30c8e2
mod.theme.color_val = #30c8e2
mod.theme.color_selection_focus = #30c8e240
mod.theme.color_bg_highlight_inline = #30c8e240

mod.theme.color_terminal_bg = #182028
mod.theme.color_terminal_text = #dce4ea

// The instruments: cyan digits in a dark glass well, dark lamp lenses.
mod.theme.color_screen = #10171d
mod.theme.color_screen_ink = #5fe6f6
mod.theme.screen_ghost = 0.12
mod.theme.color_lamp_off = #1b242b
mod.theme.lamp_halo = 0.28

// The surface ladder in steel, so every widget built on the roles stays in
// the family, with ink that reads on the brightest rung.
mod.theme.color_surface = #2f383f
mod.theme.color_surface_dim = #283037
mod.theme.color_surface_bright = #4a5660
mod.theme.color_surface_container_low = #343e46
mod.theme.color_surface_container = #38424a
mod.theme.color_surface_container_high = #3c464f
mod.theme.color_surface_container_highest = #414c55
mod.theme.color_on_surface = #f2f6f9
mod.theme.color_on_surface_variant = #f2f6f9
mod.theme.color_outline = #8a98a2
mod.theme.color_outline_variant = #4a5660
mod.theme.color_inverse_surface = #dce4ea
mod.theme.color_inverse_on_surface = #2f383f

// Slim: a 26 point control row, 6 point gaps inside a group, cut corners of
// 3 points on controls and 8 on plates.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.space_4 = 12.0
mod.theme.space_5 = 18.0
mod.theme.space_6 = 24.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 3.0 bottom: 0.0 left: 3.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 3.0 right: 0.0 bottom: 3.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 6.0 right: 6.0 bottom: 6.0 left: 6.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 6.0 bottom: 0.0 left: 6.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 6.0 right: 0.0 bottom: 6.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 9.0 right: 9.0 bottom: 9.0 left: 9.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 9.0 bottom: 0.0 left: 9.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 9.0 right: 0.0 bottom: 9.0 left: 0.0}
// The rungs the base froze at its own space factor, restated at ours.
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 24.0
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
mod.theme.textselection_corner_radius = 1.0
mod.theme.radius_xs = 1.5
mod.theme.radius_s = 2.0
mod.theme.radius_m = 3.0
mod.theme.radius_l = 4.0

// The base grotesque. A font size draws 1.333 layout points per unit, so
// 8.25 is the 11 point legend of a 26 point row (cap 0.3 of the row).
mod.theme.font_size_base = 8.25
mod.theme.font_size_p = 8.25
mod.theme.font_size_code = 8.25
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.25}
mod.theme.font_label = mod.theme.font_label{font_size: 8.25}
mod.theme.font_bold = mod.theme.font_bold{font_size: 8.25}
mod.theme.font_italic = mod.theme.font_italic{font_size: 8.25}
mod.theme.font_bold_italic = mod.theme.font_bold_italic{font_size: 8.25}
mod.theme.font_code = mod.theme.font_code{font_size: 8.25}
mod.theme.type_title_l_size = 12.0
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_s_size = 9.0
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.0 line_spacing: 1.2}
mod.theme.type_body_l_size = 9.0
mod.theme.type_body_m_size = 8.25
mod.theme.type_body_s_size = 7.5
mod.theme.type_label_l_size = 8.25
mod.theme.type_label_m_size = 7.5
mod.theme.type_label_s_size = 6.75
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.25 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 7.5 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.25 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 6.75 line_spacing: 1.2}
true
