// ---------------------------------------------------------------------------
// TABS. A row of caption caps; the tab in use is pushed in, dark, its lamp
// lit under its lit word.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.draw_bg.color = #00000000
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
let pa_tab = fn(pos: vec2, size: vec2, o: vec2, px: float, chosen: float, hover: float) -> vec4 {
    let m = 3.0
    let b = 2.0 * px
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size - vec2(b, 0.0), b)
    return pa_caption(p, o, sb, b, chosen, hover, 0.0, 0.0, 0.0, 3.0)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return pa_tab(self.pos, self.rect_size, self.rect_pos, px, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return pa_tab(self.pos, self.rect_size, self.rect_pos, px, 0.0, 1.0)
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return pa_tab(self.pos, self.rect_size, self.rect_pos, px, 1.0, 0.0)
}
mod.widgets.Tabs.draw_sep.color = #00000000
mod.widgets.Tabs.draw_mark.color = #0d2117
// The close mark is a stepped x in lit pixels (it stands on the dark tab in
// use), the add mark a plus in ink pixels.
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let is_plus = step(0.5, self.plus)
    let cx0 = mix(self.rect_size.x - 6.0, self.rect_size.x * 0.5, is_plus)
    let c = vec2(pa_snap(cx0, o.x, b), pa_snap(self.rect_size.y * 0.5, o.y, b))
    let pc = pa_cell(p, o, b)
    let q = floor((pc - c) / b)
    let r = mix(2.0, 4.0, is_plus)
    let inbox = step(abs(q.x + 0.5), r + 0.5) * step(abs(q.y + 0.5), r + 0.5)
    let cross = max(step(abs(q.x - q.y), 0.5), step(abs(q.x + q.y + 1.0), 0.5)) * inbox
    let plus = max(step(abs(q.x + 0.5), 1.0), step(abs(q.y + 0.5), 1.0)) * inbox
    let a = mix(cross, plus, is_plus) * self.color.a
    let col = mix(vec3(0.839, 0.878, 0.698), vec3(0.051, 0.129, 0.090), is_plus)
    return vec4(col * a, a)
}
mod.widgets.Tabs.draw_text.color = #0d2117
mod.widgets.Tabs.draw_text_active.color = #d6e0b2
mod.widgets.Tabs.draw_text.ink_centered = true
mod.widgets.Tabs.draw_text_active.ink_centered = true
let pa_tab_type = mod.theme.font_label{font_size: 8.0 line_spacing: 1.0}
mod.widgets.Tabs.draw_text.text_style = pa_tab_type
mod.widgets.Tabs.draw_text_active.text_style = pa_tab_type

// The segmented group: one raised strip; the chosen answer is pushed in,
// dark, framed in ink on both sides, its lamp lit under its word.
mod.widgets.SegmentedControlFlat.segment_height = 26.0
mod.widgets.SegmentedControlFlat.segment_padding = 10.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let pc = pa_cell(p, o, b)
    return pa_cap(pc, b, sb, 1.0, 1.0, pa_face(), pa_light(), pa_mute(), pa_deep(), pa_ink(), 0.30)
}
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let m = 2.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let sbs = vec4(sb.x, sb.y + b, sb.z, sb.w)
    let pc = pa_cell(p, o, b)
    return pa_sunk(pc, b, sbs, 0.0, pa_dark(), pa_ink(), 1.0, 3.0)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #0d2117
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #d6e0b2
mod.widgets.SegmentedControlFlat.draw_text.text_style = mod.theme.font_label{}
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_label{}
mod.widgets.SegmentedControlFlat.palette.on_neutral_container = #d6e0b2

// The dock's tabs: the tab in use is a light cap with an ink bar along its
// top; the others lay the checker under the pointer.
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let pc = pa_cell(p, o, b)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let da = pa_checker(p, o, b) * step(0.5, self.hover) * (1.0 - step(0.5, self.active))
    out = pa_lay(out, pa_light(), da)
    let act = step(0.5, self.active)
    out = pa_lay(out, pa_face(), act)
    let bar = step(pc.y, sb.y + 2.0 * b) * act
    let side = max(step(pc.x, sb.x + b), step(sb.z - b, pc.x)) * act
    out = pa_lay(out, pa_ink(), max(bar, side))
    return out
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let yb = pa_snap(self.rect_size.y, self.rect_pos.y, b)
    let la = step(yb - b, p.y) * step(p.y, yb)
    return vec4(pa_ink() * la, la)
}

// ---------------------------------------------------------------------------
// PROGRESS. A rail six pixels deep in an ink frame, dark inside, the done
// run lit with a light row along its top. The amount that is not known
// cannot move without a clock, so it stands still: a lit run across the
// middle third.
mod.widgets.ProgressBarFlat.height = 9.33
mod.widgets.ProgressBarFlat.draw_bg.thickness = 8.0
mod.widgets.ProgressBarFlat.draw_bg.border_radius = 0.0
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let hgt = 6.0 * b
    let y0 = pa_snap((size.y - hgt) * 0.5, o.y, b)
    let x0 = size.x * self.start
    let x1 = size.x * self.end
    let sb = vec4(pa_snap(x0, o.x, b), y0, pa_snap(x1, o.x, b), y0 + hgt)
    var lo = sb.x
    var hi = sb.x + clamp((self.value - self.start) / max(self.end - self.start, 0.0001), 0.0, 1.0) * (sb.z - sb.x)
    if self.value < 0.0 {
        lo = sb.x + (sb.z - sb.x) * 0.36
        hi = sb.x + (sb.z - sb.x) * 0.64
    }
    return pa_rail(p, o, b, sb, lo, hi, 0.0) * self.opacity
}

// LEVEL METERS. A dark rail in an ink frame holding segments two pixels
// long and one apart, lit to the level and dark beyond; the held peak a
// segment of ink-framed lit; the over lamp a small cap at the end, lit
// when the level has gone over.
mod.widgets.LevelMeter.height = 9.33
mod.widgets.LevelMeterColumn.width = 9.33
mod.widgets.LevelMeter.draw_bg.lamp_size = 8.0
mod.widgets.LevelMeter.draw_bg.lamp_gap = 3.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let vert = step(0.5, self.vertical)
    let pc = pa_cell(p, o, b)
    let along = mix(size.x, size.y, vert)
    let lamp_room = self.lamp * (self.lamp_size + self.lamp_gap)
    let bar = max(4.0 * b, along - lamp_room)
    // the rail's box in window space: horizontal runs from the left, a
    // column from the foot
    let sbh = pa_sbox(o, vec2(0.0, 0.0), vec2(bar, size.y), b)
    let sbv = pa_sbox(o, vec2(0.0, size.y - bar), size, b)
    let sb = mix(sbh, sbv, vert)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    // position along from the low end, in pixels from the rail's start
    let s = mix(pc.x - sb.x, sb.w - pc.y, vert)
    let len = mix(sb.z - sb.x, sb.w - sb.y, vert)
    let k = floor((s - b) / (3.0 * b))
    let within = s - b - k * 3.0 * b
    let n = floor((len - 2.0 * b + b) / (3.0 * b))
    let seg = step(within, 2.0 * b) * step(0.0, k) * step(k, n - 1.0) * step(b, s) * step(s, len - b)
    let lit = step((k + 0.5) / max(n, 1.0), self.level + 0.0001) * step(0.0001, self.level)
    let hk = floor(self.hold * n - 0.0001)
    let peak = step(abs(k - hk), 0.5) * step(0.002, self.hold)
    var col = pa_dark()
    col = mix(col, mix(pa_dark2(), pa_lit(), max(lit, peak)), seg)
    col = mix(col, pa_ink(), rim_a)
    var out = vec4(col * inside, inside)
    if self.lamp > 0.5 {
        let ls = floor(self.lamp_size / b + 0.5) * b
        let lh = pa_sbox(o, vec2(bar + self.lamp_gap, (size.y - ls) * 0.5), vec2(bar + self.lamp_gap + ls, (size.y + ls) * 0.5), b)
        let lv = pa_sbox(o, vec2((size.x - ls) * 0.5, size.y - bar - self.lamp_gap - ls), vec2((size.x + ls) * 0.5, size.y - bar - self.lamp_gap), b)
        let lb = mix(lh, lv, vert)
        let on = step(0.5, self.over)
        let lamp = pa_cap(pc, b, lb, 1.0, 0.0, mix(pa_dark2(), pa_lit(), on), mix(pa_dark2(), vec3(0.910, 0.933, 0.839), on), mix(pa_deep(), pa_light(), on), pa_deep(), pa_ink(), 0.0)
        out = pa_over(out, lamp)
    }
    return out * self.opacity
}

// SCROLL BARS. Ten points: a dark trough in an ink frame, the thumb a
// raised light cap a pixel inside it, lifted under the pointer and pushed
// in while dragged.
mod.widgets.ScrollBar.bar_size = 10.67
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.size = 10.67
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let vert = step(0.5, self.is_vertical)
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    var col = mix(pa_dark(), pa_dark2(), pa_quarter(p, o, b))
    col = mix(col, pa_ink(), rim_a)
    var out = vec4(col * inside, inside)
    let len = mix(size.x, size.y, vert)
    let t0 = len * self.norm_scroll
    let t1 = len * (self.norm_scroll + self.norm_handle)
    let th = mix(pa_sbox(o, vec2(t0, 0.0), vec2(t1, size.y), b), pa_sbox(o, vec2(0.0, t0), vec2(size.x, t1), b), vert)
    let tb = vec4(th.x, th.y, th.z, th.w)
    let hov = step(0.5, max(self.hover, self.drag))
    let dr = step(0.5, self.drag)
    let face = mix(mix(pa_light(), pa_lit(), hov), pa_down(), dr)
    let cap = pa_cap(pc, b, tb, 1.0, 0.0, face, mix(pa_lit(), pa_mute(), dr), pa_mute(), pa_deep(), pa_ink(), 0.0)
    out = pa_over(out, cap)
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// PANELS. A raised panel is a large cap: an ink frame with its corners
// stepped off twice, a light row along its top and left, a shade row along
// its right and above its foot, a dark thickness, a shadow a pixel to the
// lower right, and a face dithered in a checker of two mid greens. The
// inset is let in: an ink frame, two deep rows under its top and down its
// left, a light row inside its right and foot, and a lighter face with one
// pixel in four darkened.
let pa_panel = fn(p: vec2, o: vec2, size: vec2, b: float, sunk: float, card: float) -> vec4 {
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if sunk > 0.5 {
        let d = pa_dbox(pc, sb, 2.0, b)
        let inside = step(d, 0.0)
        let rim_a = inside * step(-b, d)
        let lip = pa_ring_out(d, 0.0, b) * max(step(sb.w, pc.y), step(sb.z, pc.x))
        out = pa_lay(out, pa_light(), lip)
        var col = mix(vec3(0.490, 0.576, 0.431), vec3(0.455, 0.537, 0.416), pa_quarter(p, o, b))
        let dt = min(pc.x - sb.x, pc.y - sb.y)
        let db = min(sb.z - pc.x, sb.w - pc.y)
        col = mix(col, pa_mid(), step(dt, 4.0 * b) * step(dt, db))
        col = mix(col, pa_dark2(), step(dt, 3.0 * b) * step(dt, db))
        col = mix(col, pa_deep(), step(dt, 2.0 * b) * step(dt, db))
        col = mix(col, vec3(0.604, 0.690, 0.529), step(db, 2.0 * b) * step(db, dt))
        col = mix(col, pa_ink(), rim_a)
        out = pa_lay(out, col, inside)
    } else {
        let face = mix(vec3(0.561, 0.647, 0.478), vec3(0.620, 0.706, 0.533), card)
        let face2 = mix(vec3(0.518, 0.604, 0.443), vec3(0.588, 0.675, 0.506), card)
        let f = mix(face, face2, pa_checker(p, o, b))
        out = pa_cap(pc, b, sb, 2.0, 1.0, f, pa_light(), pa_mute(), pa_deep(), pa_ink(), 0.32)
        // the checker stays inside the bevel: the bevel rows are solid
    }
    return out
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 3.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return pa_panel(p, self.rect_pos, self.rect_size, 2.0 * px, step(0.5, self.sunken), 0.0)
}

// The card: the raised panel with a lighter face; the pointer lays the
// light row's checker over it, a press darkens it a step.
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let m = 3.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = pa_panel(p, self.rect_pos, self.rect_size, b, 0.0, 1.0)
    let pc = pa_cell(p, self.rect_pos, b)
    let sb = pa_sbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, b)
    let d = pa_dbox(pc, sb, 2.0, b)
    let inner = step(d, -2.0 * b) * step(pc.y, sb.w - 3.0 * b)
    let la = inner * pa_quarter(p, self.rect_pos, b) * max(step(0.5, self.hover), step(0.5, self.down))
    return pa_lay(out, mix(pa_light(), pa_mute(), step(0.5, self.down)), la)
}

// The plain rounded view keeps the colours its caller gives it; its edge
// is stepped on the grid.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let sb = pa_sbox(o, lo, hi, b)
    let pc = pa_cell(p, o, b)
    let notch = clamp(floor(self.border_radius / 3.0 + 0.5), 0.0, 2.0)
    let d = pa_dbox(pc, sb, notch, b)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let inside = step(d, 0.0)
    var out = vec4(fill.rgb * fill.a * inside, fill.a * inside)
    if self.border_size > 0.0 {
        let la = inside * step(-b, d) * self.border_color.a
        out = pa_over(out, vec4(self.border_color.rgb * la, la))
    }
    return out
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points. The row's words have no chosen ink, so a chosen
// row cannot turn dark: it is a lit bar framed in ink with the pointer of a
// handheld's menu at its head. The pointer's row lays the light checker.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 18.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_text.color = #0d2117
mod.widgets.ListItem.draw_text_2.color = #1e3326
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - step(0.5, self.disabled)
    let sel = step(0.5, self.selected)
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(1.0, 1.0), self.rect_size - vec2(12.0, 1.0), b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ba = inside * pa_checker(p, o, b) * max(step(0.5, self.hover), step(0.5, self.down)) * live * (1.0 - sel)
    out = pa_lay(out, pa_light(), ba)
    // the chosen row
    var col = mix(pa_lit(), pa_light(), step(sb.w - 2.0 * b, pc.y))
    col = mix(col, pa_ink(), step(-b, d))
    out = pa_lay(out, col, inside * sel)
    // the menu pointer: a stepped triangle four pixels deep at the head
    let cy = pa_snap(self.rect_size.y * 0.5, o.y, b)
    let q = floor((pc - vec2(sb.x + 2.0 * b, cy)) / b)
    let tri = step(0.0, q.x) * step(q.x, 3.5) * step(abs(q.y + 0.5), 4.0 - q.x) * sel
    out = pa_lay(out, pa_ink(), tri)
    return out
}

// The open list of a drop-down: a light sheet in an ink frame with its
// corners stepped off; the pointer's row lays the checker, the chosen row
// is dark with lit words.
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sb = pa_sbox(o, vec2(0.0, 0.0), self.rect_size, b)
    let pc = pa_cell(p, o, b)
    return pa_cap(pc, b, sb, 1.0, 0.0, vec3(0.702, 0.773, 0.600), pa_lit(), pa_face(), pa_deep(), pa_ink(), 0.0)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - step(0.5, self.disabled)
    let inrow = step(1.0, p.x) * step(p.x, self.rect_size.x - 1.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ha = pa_checker(p, o, b) * step(0.5, self.hover) * live * (1.0 - step(0.5, self.active)) * inrow
    out = pa_lay(out, pa_light(), ha)
    let ia = step(0.5, self.active) * inrow
    out = pa_lay(out, pa_dark(), ia)
    return out
}
mod.widgets.PopupMenuItem.draw_text.color_active = #d6e0b2

// THE SPINNER. Eight blocks two pixels square round a circle: one in ink,
// the next ones stepping down through the dark and the mid to the mute. A
// sheet may not read the pass clock and the spinner carries no other, so
// it stands still.
mod.widgets.SpinnerFlat.size = 18.67
mod.widgets.SpinnerFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(pa_snap(self.rect_size.x * 0.5, o.x, b), pa_snap(self.rect_size.y * 0.5, o.y, b))
    let pc = pa_cell(p, o, b)
    let v = pc - c
    var th = atan2(v.x, -v.y)
    if th < 0.0 {
        th = th + 2.0 * PI
    }
    let k = floor(th / (PI * 0.25) + 0.5)
    let ang = k * PI * 0.25
    let rr = floor(min(self.rect_size.x, self.rect_size.y) * 0.5 / b - 1.0) * b
    let bc = c + vec2(sin(ang), -cos(ang)) * (rr - b)
    let q = abs(pc - vec2(pa_snap(bc.x, o.x, b), pa_snap(bc.y, o.y, b)))
    let a = step(max(q.x, q.y), b) * self.alpha
    var col = pa_mid()
    col = mix(col, pa_dark2(), step(abs(k - 6.0), 0.5))
    col = mix(col, pa_dark(), step(abs(k - 7.0), 0.5))
    col = mix(col, pa_ink(), step(abs(k - 8.0), 0.5) + step(k, 0.5))
    return vec4(col * a, a)
}

// Chips: a small raised cap 20 points tall inside the room its size rung
// takes; a chosen chip (light letters) is the dark pushed-in cap.
mod.widgets.ChipFlat.radius = 0.0
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let inset = max((self.rect_size.y - 21.33) * 0.5, 0.0)
    let sb = pa_sbox(o, vec2(0.0, inset), vec2(self.rect_size.x - b, self.rect_size.y - inset), b)
    let pc = pa_cell(p, o, b)
    let chosen = step(0.6, dot(self.ink.rgb, vec3(0.299, 0.587, 0.114)))
    let hov = step(0.5, self.hover)
    let held = step(0.5, self.down)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if chosen > 0.5 {
        out = pa_sunk(pc, b, vec4(sb.x, sb.y + b, sb.z, sb.w), 1.0, mix(pa_dark(), pa_dark2(), hov), pa_ink(), 1.0, 2.0)
    } else {
        let face = mix(mix(pa_face(), pa_hi(), hov), pa_down(), held)
        out = pa_cap(pc, b, vec4(sb.x, sb.y + held * b, sb.z, sb.w), 1.0, 0.0, face, mix(pa_light(), pa_mute(), held), pa_mute(), pa_deep(), pa_ink(), 0.3 * (1.0 - held))
    }
    let d = pa_dbox(pc, sb, 1.0, b)
    let kf = step(-3.0 * b, d) * step(d, -2.0 * b) * self.keyed
    out = pa_lay(out, mix(pa_ink(), pa_lit(), chosen), kf)
    return out
}
// Badges: a small light cell in an ink frame with ink digits.
mod.widgets.BadgePalette.neutral = #c0cf9f
mod.widgets.BadgePalette.on_neutral = #0d2117
mod.widgets.BadgePalette.neutral_container = #93a87e
mod.widgets.BadgePalette.on_neutral_container = #0d2117
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(17.33, self.rect_size.y)
    let sb = pa_sbox(o, vec2(0.0, (self.rect_size.y - bh) * 0.5), vec2(self.rect_size.x, (self.rect_size.y + bh) * 0.5), b)
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    var col = self.color.rgb
    col = mix(col, pa_ink(), step(-b, d))
    let a = inside * self.color.a
    return vec4(col * a, a)
}

// Rules between groups: one big pixel of ink.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let y = pa_snap(self.rect_size.y * 0.5, self.rect_pos.y, b)
    let a = step(y - b, p.y) * (1.0 - step(y, p.y))
    return vec4(pa_ink() * a, a)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let x = pa_snap(self.rect_size.x * 0.5, self.rect_pos.x, b)
    let a = step(x - b, p.x) * (1.0 - step(x, p.x))
    return vec4(pa_ink() * a, a)
}

// ---------------------------------------------------------------------------
// THE GROUND. The whole window is the glass: pale green, a faint dot
// matrix (one device pixel row and column of every big pixel a shade
// darker, so the glass shows its pixels), a sheen lighter to the upper
// left, and a grain one device pixel fine that never repeats.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let w = p + self.rect_pos
    let q = floor(w / px + vec2(0.01, 0.01))
    let gx = step(0.5, fract(q.x * 0.5))
    let gy = step(0.5, fract(q.y * 0.5))
    let grid = max(gx, gy)
    var col = vec3(0.627, 0.710, 0.533)
    col = col * (1.0 + 0.025 * (0.5 - self.pos.y) + 0.015 * (0.5 - self.pos.x))
    col = col * (1.0 - 0.012 * grid)
    col = col + pa_g3(Finish.grain(w / px, 0.02))
    return vec4(col, 1.0)
}
true
