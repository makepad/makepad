    return pa_slider(p, self.rect_pos, self.rect_size, px, 0.0, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled, self.label_size, self.rect_size.x - 36.0, 1.0)
}
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false

// FADERS. An ink slot two pixels wide, dotted ladders on both sides, a
// long dot every fifth step; the cap is a raised cap twelve pixels across
// and seven along, a grip line of ink across its middle, the line the
// value is read off.
mod.widgets.SliderFader.cap_size = 9.33
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFaderY.width = 24.0
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 3.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let m = 3.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let size = self.rect_size
    let vert = step(0.5, self.is_vertical)
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let pc = pa_cell(p, o, b)
    let along = mix(size.x, size.y, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    // the slot's middle line, on the grid
    let midx = pa_snap(size.x * 0.5, o.x, b)
    let midy = pa_snap(size.y * 0.5, o.y, b)
    // coordinates: `a` along from the low end, `c` across from the middle
    let a = mix(pc.x, size.y - pc.y, vert)
    let c = mix(pc.y - midy, pc.x - midx, vert)
    let icol = mix(pa_ink(), pa_mid(), dis)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the ladders: a dot every tenth of the travel, three pixels out from
    // the slot on both sides; the fifth ones two pixels long
    let st = travel / 10.0
    let kk = floor((a - foot) / st + 0.5)
    let ya = foot + kk * st
    let on_step = step(abs(a - ya), 0.5 * b) * step(-0.5, kk) * step(kk, 10.5)
    let major = step(fract(kk / 5.0 + 0.01), 0.1)
    let ac = abs(c)
    let dot_at = step(3.0 * b, ac) * step(ac, mix(4.0, 5.0, major) * b)
    out = pa_lay(out, icol, on_step * dot_at)
    // the slot: two pixels wide, dark with an ink frame a pixel wide
    let s0 = self.inset_px
    let s1 = along - self.inset_px
    let in_slot = step(s0, a) * step(a, s1) * step(ac, 1.51 * b)
    let slot_rim = in_slot * step(0.99 * b, ac)
    out = pa_lay(out, mix(pa_dark(), pa_mute(), dis), in_slot)
    out = pa_lay(out, icol, slot_rim * 0.0)
    out = pa_lay(out, icol, in_slot * (1.0 - step(abs(c + 0.5 * b), 0.51 * b)) * 0.0)
    // the cap, in window space
    let at = foot + self.slide_pos * travel
    let cw = 12.0 * b
    let chh = 7.0 * b
    let ccx = mix(at, size.x * 0.5, vert)
    let ccy = mix(size.y * 0.5, size.y - at, vert)
    let wx = mix(chh, cw, vert)
    let wy = mix(cw, chh, vert)
    let x0 = pa_snap(ccx - wx * 0.5, o.x, b)
    let y0 = pa_snap(ccy - wy * 0.5, o.y, b)
    let dr = step(0.5, self.drag) * live
    let hov = step(0.5, self.hover) * live
    let sb = vec4(x0, y0 + dr * b, x0 + wx, y0 + wy)
    let face = mix(mix(mix(pa_light(), pa_lit(), hov), pa_down(), dr), pa_mute(), dis)
    let hl = mix(mix(pa_lit(), pa_mute(), dr), pa_mute(), dis)
    let sh = mix(pa_mute(), pa_mute(), dis)
    let cap = pa_cap(pc, b, sb, 1.0, 1.0 - dr, face, hl, sh, mix(pa_deep(), pa_mid(), dis), icol, 0.32 * (1.0 - dr) * live)
    out = pa_over(out, cap)
    // the grip line across the cap's face, through its middle
    let gm = pa_snap((sb.y + sb.w - (1.0 - dr) * b) * 0.5, o.y, b)
    let gline_v = step(abs(pc.y - gm + 0.5 * b), 0.51 * b) * step(sb.x + 2.0 * b, pc.x) * step(pc.x, sb.z - 2.0 * b)
    let gmx = pa_snap((sb.x + sb.z) * 0.5, o.x, b)
    let gline_h = step(abs(pc.x - gmx + 0.5 * b), 0.51 * b) * step(sb.y + 2.0 * b, pc.y) * step(pc.y, sb.w - 3.0 * b)
    let gl = mix(gline_h, gline_v, vert)
    out = pa_lay(out, icol, gl)
    let kf = pa_focus(pa_dbox(pc, vec4(x0, y0, x0 + wx, y0 + wy), 1.0, b), p, o, b) * step(0.5, self.focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}

// ---------------------------------------------------------------------------
// KNOBS. A pixel disc: a shadow a pixel to the lower right, an ink ring, a
// dark bezel carrying the value as a lit arc, an ink ring, and a light face
// shaded from lit at its upper left to mute at its lower right by an
// ordered dither; an ink pointer one pixel wide from near the middle out
// to the bezel.
let pa_knob = fn(p: vec2, o: vec2, cx: float, cy: float, rad: float, px: float, slide: float, origin: float, arc_origin: float, gap: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let b = 2.0 * px
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let hov = step(0.5, hover) * live
    let dr = step(0.5, drag) * live
    let c = vec2(pa_snap(cx, o.x, b), pa_snap(cy, o.y, b))
    let rr = floor(rad / b) * b
    let pc = pa_cell(p, o, b)
    let v = pc - c
    let r = length(v)
    let bw = mix(2.0, 3.0, step(34.0, rr * 2.0)) * b
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the shadow
    let rs = length(v - vec2(b, b))
    let sa = step(rs, rr) * step(rr, r) * 0.32 * live
    out = pa_lay(out, pa_ink(), sa)
    let inside = step(r, rr)
    // the bezel and the value arc on it
    let start = gap * 0.5 * PI / 180.0
    let sweep = 2.0 * PI - gap * PI / 180.0
    var ta = atan2(-v.x, v.y)
    if ta < 0.0 {
        ta = ta + 2.0 * PI
    }
    let t = (ta - start) / sweep
    let lo = min(origin, slide) * arc_origin
    let hi = mix(slide, max(origin, slide), arc_origin)
    let on_arc = step(lo, t) * step(t, hi) * step(0.0, t) * step(t, 1.0)
    let in_bez = step(rr - b - bw, r) * step(r, rr - b)
    var bcol = mix(pa_dark(), pa_deep(), step(0.0, v.y + v.x))
    bcol = mix(bcol, mix(pa_lit(), pa_light(), dr), on_arc)
    bcol = mix(bcol, mix(pa_mute(), pa_mid(), step(0.5, on_arc)), dis)
    // the face: an ordered dither between four greens
    let fr = rr - 2.0 * b - bw
    let s = clamp(0.4 - 0.6 * dot(v / max(fr, 1.0), vec2(0.7071, 0.7071)), 0.0, 1.0) + 0.18 * hov - 0.2 * dr
    let lvl = clamp(floor(s * 3.0 + pa_bayer(p, o, b)), 0.0, 3.0)
    var fcol = mix(pa_mute(), pa_face(), step(0.5, lvl))
    fcol = mix(fcol, pa_light(), step(1.5, lvl))
    fcol = mix(fcol, pa_lit(), step(2.5, lvl))
    fcol = mix(fcol, mix(pa_mute(), vec3(0.541, 0.627, 0.494), pa_checker(p, o, b)), dis)
    let in_face = step(r, fr)
    var col = mix(pa_ink(), bcol, in_bez)
    col = mix(col, fcol, in_face)
    col = mix(col, pa_mid(), (1.0 - in_bez) * (1.0 - in_face) * dis)
    // the pointer
    let av = start + sweep * slide
    let dir = vec2(-sin(av), cos(av))
    let pd = pa_seg(v, dir * fr * 0.18, dir * (fr - 0.5 * b))
    let pa = step(pd, 0.62 * b) * in_face
    col = mix(col, mix(pa_ink(), pa_mid(), dis), pa)
    out = pa_lay(out, col, inside)
    // focus: a dotted ring a pixel out
    let kf = step(rr + b, r) * step(r, rr + 2.0 * b) * pa_checker(p, o, b) * step(0.5, focus) * live
    out = pa_lay(out, pa_ink(), kf)
    return out
}

mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let rad = dia * 0.5 - 1.5
    return pa_knob(p, self.rect_pos, self.rect_size.x * 0.5, self.rect_size.y - dia * 0.5, rad, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let dia = min(self.rect_size.x, self.rect_size.y - 24.0)
    let rad = dia * 0.5 - 2.0
    return pa_knob(p, self.rect_pos, self.rect_size.x * 0.5, 24.0 + dia * 0.5, rad, px, self.slide_pos, self.origin_pos, self.arc_origin, self.gap, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 4.0 right: 4.0 top: 1.0 bottom: 1.0}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.draw_text.text_style = pa_value_style

// ---------------------------------------------------------------------------
// FIELDS. A dark well let into the glass: an ink frame with its corners
// stepped off, a deep row under its top and down its left, a lit lip under
// its foot and down its right where the cut catches the light, lit words.
// Under the pointer the well lifts a shade; in focus a lit keyline runs
// inside the frame. Read only, the well is a dithered mute.
let pa_well = fn(p: vec2, o: vec2, sb: vec4, b: float, hover: float, focus: float, disabled: float) -> vec4 {
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let hov = step(0.5, hover) * live
    let foc = step(0.5, focus) * live
    let pc = pa_cell(p, o, b)
    let d = pa_dbox(pc, sb, 1.0, b)
    let inside = step(d, 0.0)
    let rim_a = inside * step(-b, d)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let lip = pa_ring_out(d, 0.0, b) * max(step(sb.w, pc.y), step(sb.z, pc.x))
    out = pa_lay(out, pa_light(), lip)
    var col = mix(pa_dark(), pa_dark2(), hov)
    let tl = step(min(pc.x - sb.x, pc.y - sb.y), 2.0 * b)
    col = mix(col, pa_deep(), tl)
    let r1 = step(-2.0 * b, d) * step(d, -b)
    col = mix(col, pa_lit(), r1 * foc)
    let dcol = mix(pa_mute(), vec3(0.435, 0.529, 0.408), pa_checker(p, o, b))
    col = mix(col, mix(dcol, pa_mid(), tl), dis)
    col = mix(col, mix(pa_ink(), pa_mid(), dis), rim_a)
    return pa_lay(out, col, inside)
}

mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    let m = 2.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sb = pa_sbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, b)
    let vis = step(0.001, self.border_size)
    return pa_well(p, self.rect_pos, sb, b, self.hover, self.focus, self.disabled) * vis
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 3.0 bottom: 3.0}
mod.widgets.TextInputFlat.draw_text.color = #d6e0b2
mod.widgets.TextInputFlat.draw_text.color_hover = #d6e0b2
mod.widgets.TextInputFlat.draw_text.color_focus = #e8eed6
mod.widgets.TextInputFlat.draw_text.color_down = #d6e0b2
mod.widgets.TextInputFlat.draw_text.color_disabled = #243a2b
mod.widgets.TextInputFlat.draw_text.color_empty = #a4b98c
mod.widgets.TextInputFlat.draw_text.color_empty_hover = #b0c296
mod.widgets.TextInputFlat.draw_text.color_empty_focus = #a4b98c
// The caret is a lit block a big pixel wide.
mod.widgets.TextInputFlat.draw_cursor.pixel = fn() {
    let a = (1.0 - self.blink) * self.focus * (1.0 - self.disabled)
    return vec4(vec3(0.910, 0.933, 0.839) * a, a)
}
mod.widgets.TextInputFlat.draw_selection.border_radius = 0.0
mod.widgets.TextInputFlat.draw_selection.pixel = fn() {
    let a = 0.36 * self.focus * (1.0 - self.disabled)
    return vec4(vec3(0.839, 0.878, 0.698) * a, a)
}

// The number field: the same dark well, its stepper a raised light cap at
// the right, split across its middle by an ink rule, a pixel arrow in each
// half; a half lifts under the pointer and drops while pressed.
mod.widgets.NumberField.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let m = 2.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let sb = pa_sbox(self.rect_pos, vec2(0.0, 0.0), self.rect_size, b)
    return pa_well(p, self.rect_pos, sb, b, self.hover, self.focus, self.disabled)
}
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.pad_left = 9.0
mod.widgets.NumberField.input.draw_text.color = #d6e0b2
mod.widgets.NumberField.input.draw_text.color_hover = #d6e0b2
mod.widgets.NumberField.input.draw_text.color_focus = #e8eed6
mod.widgets.NumberField.input.draw_text.color_down = #d6e0b2
mod.widgets.NumberField.input.draw_text.color_disabled = #243a2b
mod.widgets.NumberField.input.draw_text.color_empty = #a4b98c
mod.widgets.NumberField.input.draw_text.color_empty_hover = #b0c296
mod.widgets.NumberField.input.draw_text.color_empty_focus = #a4b98c
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let size = self.rect_size
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let pc = pa_cell(p, o, b)
    // the cap stands two pixels in from the well's frame
    let sb = pa_sbox(o, vec2(b * 0.0, 2.0 * b), vec2(size.x - 2.0 * b, size.y - 2.0 * b), b)
    let mid = pa_snap((sb.y + sb.w) * 0.5, o.y, b)
    let upper = step(pc.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    let face = mix(mix(mix(pa_light(), pa_lit(), step(0.5, hot)), pa_down(), step(0.5, dn)), pa_mute(), dis)
    var out = pa_cap(pc, b, sb, 1.0, 0.0, face, mix(pa_lit(), pa_mute(), dis), pa_mute(), pa_deep(), mix(pa_ink(), pa_mid(), dis), 0.0)
    let icol = mix(pa_ink(), pa_mid(), dis)
    // the rule across the middle
    let rule = step(abs(pc.y - mid), 0.51 * b) * step(sb.x, pc.x) * step(pc.x, sb.z)
    out = pa_lay(out, icol, rule)
    // the arrows: stepped triangles, five pixels across
    let cx = pa_snap((sb.x + sb.z) * 0.5, o.x, b)
    let qx = floor((pc.x - cx) / b)
    let yu = pa_snap((sb.y + mid) * 0.5, o.y, b)
    let yd = pa_snap((mid + sb.w) * 0.5, o.y, b)
    let ru = floor((pc.y - yu) / b) + 2.0
    let rd = 1.0 - floor((pc.y - yd) / b)
    let au = step(0.0, ru) * step(ru, 2.5) * step(abs(qx + 0.5), ru + 0.6)
    let ad = step(0.0, rd) * step(rd, 2.5) * step(abs(qx + 0.5), rd + 0.6)
    out = pa_lay(out, icol, max(au, ad))
    return out
}
// The printed arrow glyphs are hidden; the face draws the arrows.
mod.widgets.NumberSpin.draw_text.color = #0d211700
mod.widgets.NumberSpin.draw_text.color_disabled = #0d211700

// DROP-DOWNS. A raised cap with a cell twelve pixels wide split off at its
// right by an ink rule, a pixel chevron in it; open or held, the cap is
// pushed in.
let pa_choice = fn(p: vec2, o: vec2, size: vec2, b: float, hover: float, open: float, focus: float, disabled: float) -> vec4 {
    let dis = step(0.5, disabled)
    let live = 1.0 - dis
    let pc = pa_cell(p, o, b)
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    var out = pa_button_face(p, o, size, b, 0.0, 0.0, hover, open, focus, disabled)
    let held = step(0.5, open) * live
    let rx = pa_snap(size.x - 16.0, o.x, b)
    let icol = mix(pa_ink(), pa_mid(), dis)
    let rule = step(abs(pc.x - rx - 0.5 * b), 0.51 * b) * step(sb.y + (1.0 + held) * b, pc.y) * step(pc.y, sb.w - 2.0 * b)
    out = pa_lay(out, icol, rule)
    let cxc = pa_snap((rx + sb.z) * 0.5, o.x, b)
    let cyc = pa_snap(size.y * 0.5 - 2.0 * b + held * b, o.y, b)
    let ch = pa_chevron(pc, vec2(cxc + 0.5 * b, cyc + 0.5 * b), b)
    out = pa_lay(out, icol, ch)
    return out
}
