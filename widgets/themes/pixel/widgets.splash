// The value read out beside a slider: tabular digits in the ink.
let pa_value_style = mod.theme.font_regular{font_size: 8.0 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/jetbrains_mono_variable.ttf") weight: 700.0 asc: 0.0 desc: 0.0}}}
// The value beside a slider is printed on the glass, bare: no box, ink.
let pa_bare_value = fn(t) {
    t.draw_text.text_style = pa_value_style
    t.draw_text.color = #0d2117
    t.draw_text.color_hover = #0d2117
    t.draw_text.color_focus = #0d2117
    t.draw_text.color_down = #0d2117
    t.draw_text.color_disabled = #4f6a4c
    t.draw_text.color_empty = #1e3326
    t.draw_text.color_empty_hover = #1e3326
    t.draw_text.color_empty_focus = #1e3326
    t.draw_bg.pixel = fn() {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
}
pa_bare_value(mod.widgets.SliderMinimal.text_input)
