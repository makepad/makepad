// The combo box: the dark well with lit words, and at its right a small
// raised cap holding the chevron, pushed in while its list is open.
mod.widgets.ComboBoxFlat.draw_bg.vertex = fn() {
    let g = pa_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    let m = 2.0
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = 2.0 * px
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let size = self.rect_size
    let dis = step(0.5, self.disabled)
    let live = 1.0 - dis
    let sb = pa_sbox(o, vec2(0.0, 0.0), size, b)
    var out = pa_well(p, o, sb, b, self.hover, self.focus, self.disabled)
    let pc = pa_cell(p, o, b)
    let held = step(0.5, self.down * self.hover) * live
    let kb = vec4(pa_snap(size.x - 18.0, o.x, b), sb.y + 2.0 * b + held * b, sb.z - 2.0 * b, sb.w - 2.0 * b)
    let face = mix(mix(mix(pa_light(), pa_lit(), step(0.5, self.hover) * live), pa_down(), held), pa_mute(), dis)
    let cap = pa_cap(pc, b, kb, 1.0, 1.0 - held, face, mix(pa_lit(), pa_mute(), dis), pa_mute(), mix(pa_deep(), pa_mid(), dis), mix(pa_ink(), pa_mid(), dis), 0.0)
    out = pa_over(out, cap)
    let cxc = pa_snap((kb.x + kb.z) * 0.5, o.x, b)
    let cyc = pa_snap((kb.y + kb.w) * 0.5 - 2.5 * b, o.y, b)
    let ch = pa_chevron(pc, vec2(cxc + 0.5 * b, cyc + 0.5 * b), b)
    out = pa_lay(out, mix(pa_ink(), pa_mid(), dis), ch)
    return out
}
