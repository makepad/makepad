pa_capped(mod.widgets.ButtonGradientYIcon)
pa_capped(mod.widgets.ButtonXs)
pa_capped(mod.widgets.ButtonSm)
pa_capped(mod.widgets.ButtonLg)
pa_capped(mod.widgets.ButtonXl)
pa_capped(mod.widgets.ButtonCompound)

