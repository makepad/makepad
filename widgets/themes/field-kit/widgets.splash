// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point key with a short skirt, three points in from the
// row so its focus ring has room. Set: a flat orange square on the face, an
// indicator rather than a tick; mixed: an orange bar. Error: a red rim.
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 23.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.align.y = 0.5
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let x0 = mix(3.0, self.rect_size.x - sz - 3.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let h = (hi - lo) * 0.5
    let c = lo + h
    // the round box keeps its round key
    let r = mix(2.0, h.y, step(20.0, self.border_radius))
    let d = fk_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let press = self.down * live
    var out = fk_shade(p, c, h, r, px, 1.0 - press, self.disabled, mix(0.13, 0.19, self.hover * live))
    out = Finish.over(out, fk_cap(p, lo, hi, r, px, 2.0 * px, 0.0, self.hover * live, press, self.disabled, 0.06))
    // the indicator: a 6 point square of orange, its rim a shade deeper
    let fy = press * px - px
    let mc = c + vec2(0.0, fy)
    let sq = fk_rbox(p, mc, vec2(3.0, 3.0), mix(0.5, 3.0, step(20.0, self.border_radius)))
    let bar = fk_rbox(p, mc, vec2(3.5, 1.0), 0.5)
    let show = self.active * (1.0 - self.mixed)
    let md = mix(mix(1000.0, sq, show), bar, self.mixed)
    let lit = mix(vec3(0.933, 0.353, 0.141), vec3(0.83, 0.78, 0.76), self.disabled)
    var mk = mix(lit, lit * 0.85, Finish.band(md, 0.0, px, px))
    let ma = Finish.cover(md, px)
    out = Finish.over(out, vec4(mk * ma, ma))
    // error: the rim of the key turns red
    let er = Finish.band(d, 0.0, px, px) * self.error
    out = Finish.over(out, vec4(0.706 * er, 0.137 * er, 0.094 * er, er))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 30 by 16 track cut into the case in two flat tones, dark
// upper half over a lighter lower half (orange when on), and a 12 point
// square keycap riding in it two points from its ends.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 39.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 16.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.align.y = 0.5
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 1.875
mod.widgets.ToggleFlat.draw_bg.knob_inset = 2.0
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = mix(3.0, self.rect_size.x - sz.x - 3.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (self.rect_size.y - sz.y) * 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + x0 + sz.x, px), Finish.snap(o.y + (self.rect_size.y - sz.y) * 0.5 + sz.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = h.y
    let d = fk_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let on = self.active
    // the track: two flat tones split at mid-height
    let upper = step(p.y, Finish.snap(o.y + c.y, px) - o.y)
    let off_col = mix(vec3(0.216, 0.216, 0.216), vec3(0.125, 0.125, 0.125), upper)
    let on_col = mix(vec3(0.835, 0.251, 0.059), vec3(0.933, 0.353, 0.141), upper)
    var fill = mix(off_col, on_col, on)
    fill = fill + g3(0.035 * self.hover * live)
    fill = mix(fill, vec3(0.80, 0.792, 0.780), self.disabled * 0.75)
    var col = fk_well(p, c, h, r, px, fill, 0.30, vec3(0.0, 0.0, 0.0), 0.35 * live)
    // error: the rim of the track turns red
    col = mix(col, vec3(0.706, 0.137, 0.094), Finish.band(d, 0.0, px, px) * self.error)
    let a = Finish.cover(d, px)
    var out = fk_catch(p, c, h, r, px, 0.75)
    out = Finish.over(out, vec4(col * a, a))
    out = Finish.over(out, fk_focus(d, px, self.focus * live))
    // the thumb: a square keycap, its left edge on a pixel boundary
    let ki = self.knob_inset
    let kw = sz.y - 2.0 * ki
    let knob_t = mix(on, self.drag_pos, self.drag)
    let kx = Finish.snap(o.x + lo.x + ki + knob_t * (sz.x - 2.0 * ki - kw), px) - o.x
    let ky = Finish.snap(o.y + lo.y + ki, px) - o.y
    let klo = vec2(kx, ky)
    let khi = klo + vec2(Finish.snap(kw, px), Finish.snap(kw, px))
    let kh = (khi - klo) * 0.5
    let kc = klo + kh
    let kd = fk_rbox(p, kc, kh, 2.0)
    // the thumb is the white cap: hovered it lifts, its drop deepening
    let khov = self.hover * live
    let con = Finish.ring_out(kd, 0.0, px, px) * smoothstep(kc.y, khi.y, p.y) * mix(0.40, 0.50, khov)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, con))
    let kdr = Finish.drop(p, kc, kh, 2.0, vec2(0.3, 0.8), 1.2) * 0.22 * khov * (1.0 - self.down * live)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, kdr))
    out = Finish.over(out, fk_cap(p, klo, khi, 2.0, px, 2.0 * px, 0.0, khov, self.down * live, self.disabled, 0.26))
    return out
}

// ---------------------------------------------------------------------------
// RADIOS. A lamp in a collar: the collar a pale dish with a light line on
// its lower inner edge, the lens a flat grey dot off and flat LED orange
// on, its rim a shade deeper. Lit, never glowing.
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 23.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = 14.0
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.align.y = 0.5
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 3.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let rad = Finish.snap(sz, px) * 0.5
    let c = lo + vec2(rad, rad)
    let live = 1.0 - self.disabled
    let q = p - c
    let d = length(q) - rad
    // the collar: a shallow dish, shaded under its top, lit on its lower lip
    let v = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var collar = mix(vec3(0.800, 0.800, 0.800), vec3(0.867, 0.867, 0.867), smoothstep(0.1, 0.7, v))
    collar = collar + g3(0.03 * self.hover * live)
    collar = mix(collar, vec3(0.90, 0.894, 0.886), self.disabled * 0.6)
    let low = smoothstep(-0.2, 0.3, q.y / rad)
    collar = mix(collar, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * low * 0.9 * live)
    collar = mix(collar, vec3(0.62, 0.62, 0.62), Finish.band(d, 0.0, px, px) * (1.0 - low) * 0.6)
    let a = Finish.cover(d, px)
    var out = fk_catch(p, c, vec2(rad, rad), rad, px, 0.6)
    out = Finish.over(out, vec4(collar * a, a))
    // the lens, 8 points
    let lr = 4.0
    let ld = length(q) - lr
    let off = vec3(0.478, 0.475, 0.467)
    let lit = vec3(0.992, 0.518, 0.196)
    var lens = mix(off, lit, self.active)
    // hovered, the lens itself brightens (off #8c8b89), not only its collar
    lens = lens + g3(0.07 * self.hover * live * (1.0 - self.down))
    lens = lens - g3(0.08 * self.down * live)
    lens = mix(lens, vec3(0.80, 0.792, 0.780), self.disabled * 0.7)
    lens = mix(lens, lens * 0.84, Finish.band(ld, 0.0, px, px))
    let la = Finish.cover(ld, px)
    out = Finish.over(out, vec4(lens * la, la))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}

// Radio tabs: keys in a row; the chosen one is latched in, its legend in
// the deep signal orange.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 5.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.min_height = 24.0
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 5.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 5.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 2.0
    let d = fk_rbox(p, c, h, r)
    let live = 1.0 - self.disabled
    let press = max(self.active, self.down) * live
    var out = fk_shade(p, c, h, r, px, 1.0 - press, self.disabled, mix(0.13, 0.19, self.hover * live))
    out = Finish.over(out, fk_cap(p, lo, hi, r, px, 3.0 * px, 0.0, self.hover * live, press, self.disabled, 0.0))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #1d1d1d
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #b53c0b
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #a9a7a4

// ---------------------------------------------------------------------------
// TEXT FIELDS. A white well cut into the case: a grey hairline mouth, one
// pixel of shade under its top edge, the light catch on the last row of the
// box. Focus: the mouth turns signal orange with a second orange row inside
// it, drawn in the box so an inner field needs no room outside itself.
// The well fills its whole box; the light catch lies one device row BELOW
// it, outside, so a field whose quad is grown down (see `fk_field_vertex`)
// shows it and one that is not simply has none.
let fk_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    // the side rims land on whole pixels INSIDE the box: a rim rounded out
    // past it is cut by the field's own clip
    let lo = vec2(ceil(o.x / px - 0.001) * px, Finish.snap(o.y, px)) - o
    let hi = vec2(floor((o.x + size.x) / px + 0.001) * px, Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = fk_rbox(p, c, h, r)
    var col = mix(vec3(0.992, 0.992, 0.988), vec3(1.0, 1.0, 1.0), hover)
    col = mix(col, vec3(0.945, 0.941, 0.933), dis)
    // cut in: two rows of shade under the top rim, 16 % then 7 %
    let yt = p.y - lo.y
    let sh = fk_run(yt, px, 2.0 * px) * 0.16 + fk_run(yt, 2.0 * px, 3.0 * px) * 0.07
    col = mix(col, vec3(0.0, 0.0, 0.0), sh * mix(1.0, 0.4, dis))
    // the rim: the top edge dark (0.49), the sides and foot the pale edge
    // #a3a2a1, so the field reads as a recess lit from above
    let upper = 1.0 - smoothstep(lo.y + r, lo.y + r + px, p.y)
    let top_rim = mix(vec3(0.49, 0.486, 0.478), vec3(0.40, 0.396, 0.388), hover)
    let low_rim = mix(vec3(0.639, 0.635, 0.631), vec3(0.58, 0.576, 0.57), hover)
    var rim = mix(low_rim, top_rim, max(upper, fk_run(yt, 0.0, px)))
    rim = mix(rim, vec3(0.76, 0.755, 0.745), dis)
    col = mix(col, rim, Finish.band(d, 0.0, px, px))
    let orange = vec3(0.933, 0.353, 0.141)
    col = mix(col, orange, Finish.band(d, 0.0, px, px) * focus)
    col = mix(col, orange, Finish.band(d, px, 2.0 * px, px) * focus * 0.45)
    let a = Finish.cover(d, px)
    // the catch: one row of #fcfbf9 under the foot, outside the box
    let cl = fk_run(p.y, hi.y, hi.y + px) * step(abs(p.x - c.x), h.x - r) * 0.92
    let out = vec4(0.988 * cl, 0.984 * cl, 0.976 * cl, cl)
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
// The field's quad reaches 2 points below its box for the catch; the
// field stops clipping downward only (its text still clips at its sides).
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size + vec2(0.0, 2.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_field(self.pos * (self.rect_size + vec2(0.0, 2.0)), self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 1.5)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #72716f
mod.widgets.TextInputFlat.draw_text.color_disabled = #a9a7a4
mod.widgets.TextInputFlat.draw_cursor.color = #ee5a24

mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size + vec2(0.0, 2.0))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_field(self.pos * (self.rect_size + vec2(0.0, 2.0)), self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 1.5)
}
// The toolbar number: a small white well, the value's share a faint orange
// wash behind the digits, print ink.
mod.widgets.ValueInput.arrow_color = #5c5b59
mod.widgets.ValueInput.draw_text.color = #1d1d1d
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = fk_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 1.5)
    if self.fill >= 0.0 {
        let w = (self.rect_size.x - 2.0) * self.fill
        let f = fk_run(p.x, 1.0, 1.0 + w) * fk_run(p.y, 2.0 * px, self.rect_size.y - 2.0 * px) * 0.14
        out = Finish.over(out, vec4(0.933 * f, 0.353 * f, 0.141 * f, f))
    }
    return out
}

// The stepper: two small white keys stacked in the field's end, split by a
// seam; each half lights or presses on its own.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(px, px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(px, 2.0 * px)
    let live = 1.0 - self.disabled
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot_u = max(0.0, self.hot) * live
    let hot_d = max(0.0, -self.hot) * live
    let dn_u = max(0.0, self.down) * live
    let dn_d = max(0.0, -self.down) * live
    // each half the main key in small: the 3 pixel skirt, the white top line
    var out = Finish.over(vec4(0.0, 0.0, 0.0, 0.0), fk_cap(p, lo, vec2(hi.x, mid - px), 1.0, px, 3.0 * px, 0.0, hot_u, dn_u, self.disabled, 0.08) * upper)
    out = Finish.over(out, fk_cap(p, vec2(lo.x, mid + px), hi, 1.0, px, 3.0 * px, 0.0, hot_d, dn_d, self.disabled, 0.08) * (1.0 - upper))
    // the seam between them
    let seam = fk_run(p.y, mid - px, mid + px) * step(lo.x, p.x) * step(p.x, hi.x) * 0.45
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, seam))
    // the legends, plus above and minus below, 1.5 pixel strokes on the
    // pixel grid, centred on each face (the face sits above its skirt and
    // travels one pixel when pressed)
    let cx = Finish.snap(o.x + (lo.x + hi.x) * 0.5, px) - o.x
    let cu = Finish.snap(o.y + (lo.y + mid - px - 3.0 * px) * 0.5, px) - o.y + dn_u * px
    let cd = Finish.snap(o.y + (mid + px + hi.y - 3.0 * px) * 0.5, px) - o.y + dn_d * px
    let arm = 2.25
    let sw = 0.75 * px
    let hbar_u = step(abs(p.x - cx), arm) * step(abs(p.y - cu), sw)
    let vbar_u = step(abs(p.y - cu), arm) * step(abs(p.x - cx), sw)
    let hbar_d = step(abs(p.x - cx), arm) * step(abs(p.y - cd), sw)
    let g = max(max(hbar_u, vbar_u) * upper, hbar_d * (1.0 - upper))
    let gink = mix(vec3(0.114, 0.114, 0.114), vec3(0.663, 0.655, 0.643), self.disabled)
    out = Finish.over(out, vec4(gink * g, g))
    return out
}
// The stock triangles give way to the drawn plus and minus.
mod.widgets.NumberSpin.draw_text.color = #1d1d1d00
mod.widgets.NumberSpin.draw_text.color_disabled = #a9a7a400

// ---------------------------------------------------------------------------
// SLIDERS. A 3 point dark track with a light catch under it, the orange
// fill in it up to the handle, hairline ticks printed above at a 6 point
// pitch, and a narrow dark cap with a light index line across its middle.
// Every face of the slider file grows its quad by 6 points for the cap's
// drop and the focus ring.
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false

// The dark track `th` tall from lo, `w` long, filled orange from `f0` to
// `fx` (a fill from the origin runs either way).
let fk_track = fn(p: vec2, lo: vec2, w: float, th: float, px: float, f0: float, fx: float, dis: float) -> vec4 {
    let h = vec2(w * 0.5, th * 0.5)
    let c = lo + h
    let r = h.y
    let d = fk_rbox(p, c, h, r)
    let filled = step(p.x, max(f0, fx)) * step(min(f0, fx), p.x)
    var col = mix(vec3(0.173, 0.173, 0.173), vec3(0.933, 0.353, 0.141), filled)
    // the fill's top line, one pixel
    col = mix(col, vec3(0.984, 0.643, 0.365), filled * fk_run(p.y, lo.y, lo.y + px) * 0.6)
    col = mix(col, vec3(0.80, 0.792, 0.780), dis * 0.7)
    let a = Finish.cover(d, px)
    let out = fk_catch(p, c, h, r, px, 0.8)
    return Finish.over(out, vec4(col * a, a))
}

// A cap standing on a track: the drop and contact line, the dark face with
// its top light line, and the index line across it, orange while dragged.
let fk_slider_cap = fn(p: vec2, lo: vec2, hi: vec2, px: float, hover: float, drag: float, focus: float, dis: float, vert: float) -> vec4 {
    let h = (hi - lo) * 0.5
    let c = lo + h
    var out = fk_shade(p, c, h, 1.5, px, 1.0, dis, mix(0.18, 0.24, hover))
    out = Finish.over(out, fk_cap(p, lo, hi, 1.5, px, 2.0 * px, 2.0, hover, 0.0, dis, 0.0))
    // the index line: 1.5 points across the middle of the face
    let fc = c - vec2(0.0, px)
    let ix = mix(fk_run(p.y, fc.y - 0.75, fc.y + 0.75) * step(abs(p.x - c.x), h.x - 2.0), fk_run(p.x, c.x - 0.75, c.x + 0.75) * step(abs(p.y - fc.y), h.y - 2.5), vert)
    let ink = mix(mix(mix(vec3(0.812, 0.812, 0.812), vec3(1.0, 1.0, 1.0), hover), vec3(0.933, 0.353, 0.141), drag), vec3(0.6, 0.6, 0.6), dis)
    out = Finish.over(out, vec4(ink * ix, ix))
    let d = fk_rbox(p, c, h, 1.5)
    return Finish.over(out, fk_focus(d, px, focus))
}

mod.widgets.SliderFlat.height = 38.0
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let hw = 5.0
    let hh = 9.0
    let cy = size.y - hh - 1.0
    let th = 3.0
    let top = Finish.snap(o.y + cy - th * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let w = Finish.snap(o.x + size.x - 1.0, px) - o.x - x0
    let kx = x0 + hw + self.slide_pos * (w - 2.0 * hw)
    let f0 = mix(x0 - 1.0, x0 + hw + self.fill_lo * (w - 2.0 * hw), step(0.001, self.fill_lo))
    let f1 = x0 + hw + self.fill_hi * (w - 2.0 * hw)
    var out = fk_track(p, vec2(x0, top), w, th, px, f0, f1, self.disabled)
    // printed ticks above the track: a 6 point pitch, a longer one every
    // fifth, each one device-pixel column at half ink
    let span = w - 2.0 * hw
    let nt = max(floor(span / 6.0 + 0.5), 1.0)
    let pitch = span / nt
    let fi = floor((p.x - x0 - hw) / pitch + 0.5)
    let tx = Finish.snap(o.x + x0 + hw + fi * pitch, px) - o.x
    let major = 1.0 - step(0.3, abs(fract(fi / 5.0 + 0.5) - 0.5))
    let tl = mix(3.0, 4.5, major)
    let ty = Finish.snap(o.y + top - 2.0, px) - o.y
    let ty0 = Finish.snap(o.y + top - 2.0 - tl, px) - o.y
    let in_x = step(-0.5, fi) * step(fi, nt + 0.5)
    let tick = fk_run(p.x, tx, tx + px) * fk_run(p.y, ty0, ty) * in_x
    let ta = tick * mix(0.36, 0.5, major) * mix(1.0, 0.45, self.disabled)
    out = Finish.over(out, vec4(0.114 * ta, 0.114 * ta, 0.114 * ta, ta))
    // the cap, 10 by 18, on the pixel grid
    let clo = vec2(Finish.snap(o.x + kx - hw, px), Finish.snap(o.y + cy - hh, px)) - o
    let chi = clo + vec2(Finish.snap(2.0 * hw, px), Finish.snap(2.0 * hh, px))
    let lifted = max(self.hover, self.drag) * live
    out = Finish.over(out, fk_slider_cap(p, clo, chi, px, lifted, self.drag * live, self.focus * live, self.disabled, 0.0))
    return out
}
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 7.25}
mod.widgets.SliderFlat.text_input.draw_text.color = #4a4947
mod.widgets.SliderFlat.text_input.draw_text.color_hover = #1d1d1d
mod.widgets.SliderFlat.text_input.draw_text.color_focus = #1d1d1d

// The minimal slider is the stepped one: a printed hairline with a dot at
// every step, lit orange up to the value, and a small round white cap.
let fk_disc = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    var out = fk_shade(p, c, vec2(rad, rad), rad, px, 1.0 - press, dis, 0.16)
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var face = mix(vec3(0.969, 0.969, 0.969), vec3(0.902, 0.902, 0.902), t)
    face = face + g3(0.045 * hover * (1.0 - press)) - g3(0.05 * press)
    face = mix(face, vec3(0.925, 0.918, 0.906), dis * 0.6)
    let up = 1.0 - smoothstep(-0.55, -0.25, q.y / rad)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, 0.0, px, px) * up * (1.0 - press))
    face = mix(face, face * 0.78, Finish.band(d, 0.0, px, px) * (1.0 - up) * 0.8)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let tr = 5.0
    let cy = Finish.snap(o.y + size.y - 6.0, px) - o.y
    let span = size.x - 2.0 * tr
    let kx = tr + self.slide_pos * span
    let inx = step(0.0, p.x) * step(p.x, size.x)
    // the printed line: one dark pixel over one light
    let dk = fk_run(p.y, cy - px, cy) * inx * 0.30
    let lt = fk_run(p.y, cy, cy + px) * inx * 0.6
    var out = vec4(lt, lt, lt, lt)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dk))
    // the step dots, 2 points, every 8 points or so
    let nt = max(floor(span / 8.0 + 0.5), 1.0)
    let pitch = span / nt
    let fi = clamp(floor((p.x - tr) / pitch + 0.5), 0.0, nt)
    let dc = vec2(tr + fi * pitch, cy - 0.5 * px)
    let dd = length(p - dc) - 1.0
    let lit = step(fi * pitch, self.slide_pos * span + 0.01)
    var dcol = mix(vec3(0.639, 0.635, 0.631), vec3(0.933, 0.353, 0.141), lit)
    dcol = mix(dcol, vec3(0.80, 0.792, 0.780), self.disabled * 0.7)
    let da = Finish.cover(dd, px)
    out = Finish.over(out, vec4(dcol * da, da))
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy - 0.5 * px)
    out = Finish.over(out, fk_disc(p, kc, tr, px, self.hover * live, self.drag * live, self.disabled))
    return Finish.over(out, fk_focus(length(p - kc) - tr, px, self.focus * live))
}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_code{font_size: 7.25}

// The round slider is the slot slider: a 12 point dark slot beside its
// label, a groove along its middle lit orange up to the thumb, and the
// thumb a ring that fills white while held or hovered, a lamp in the slot.
mod.widgets.SliderRoundFlat.height = 14.0
mod.widgets.SliderRoundFlat.text_input.margin = mod.turtle.Inset{left: 0.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 7.25}
mod.widgets.SliderRoundFlat.text_input.draw_text.color = #d9d9d9
mod.widgets.SliderRoundFlat.text_input.draw_text.color_hover = #f0f0f0
mod.widgets.SliderRoundFlat.text_input.draw_text.color_focus = #f0f0f0
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let y0 = Finish.snap(o.y + 1.0, px) - o.y
    let hi = vec2(Finish.snap(o.x + size.x, px) - o.x, Finish.snap(o.y + size.y - 1.0, px) - o.y)
    let h = (hi - vec2(x0, y0)) * 0.5
    let c = vec2(x0, y0) + h
    let r = h.y
    let d = fk_rbox(p, c, h, r)
    var slot = mix(vec3(0.118, 0.118, 0.118), vec3(0.62, 0.615, 0.605), self.disabled)
    slot = slot + g3(0.03 * self.hover * live)
    var col = fk_well(p, c, h, r, px, slot, 0.40, vec3(0.0, 0.0, 0.0), 0.5)
    // the lower lip inside, a little lighter
    col = col + g3(0.04 * fk_run(p.y, hi.y - 2.0 * px, hi.y - px) * step(abs(p.x - c.x), h.x - r))
    // the thumb's travel, and the groove lit up to it
    let tr = 4.0
    let kx = x0 + r + self.slide_pos * (2.0 * h.x - 2.0 * r)
    let gy = Finish.snap(o.y + c.y, px) - o.y
    let groove = fk_run(p.y, gy - px, gy) * step(x0 + r * 0.6, p.x) * step(p.x, hi.x - r * 0.6)
    col = mix(col, vec3(0.0, 0.0, 0.0), groove * 0.6)
    let lit = fk_run(p.y, gy - px, gy + px) * step(x0 + r * 0.6, p.x) * step(p.x, kx)
    col = mix(col, mix(vec3(0.933, 0.353, 0.141), vec3(0.72, 0.71, 0.70), self.disabled), lit)
    let a = Finish.cover(d, px)
    var out = fk_catch(p, c, h, r, px, 0.8)
    out = Finish.over(out, vec4(col * a, a))
    // the thumb: a ring 1.5 pixels wide on the dark, filled while held
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, gy - 0.5 * px)
    let kd = length(p - kc) - tr
    let full = max(self.hover, self.drag) * live
    let ring = mix(Finish.band(kd, 0.0, 1.5 * px, px), Finish.cover(kd, px), full)
    let ink = mix(vec3(0.941, 0.941, 0.941), vec3(0.75, 0.745, 0.735), self.disabled)
    let dark = Finish.cover(kd, px) * (1.0 - full)
    out = Finish.over(out, vec4(0.09 * dark, 0.09 * dark, 0.09 * dark, dark))
    out = Finish.over(out, vec4(ink * ring, ring))
    return Finish.over(out, fk_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. A white cap on a grey skirt ring, a short crisp drop, a flat
// orange pointer bar, and round the cap a ring of fifteen dots lit orange up
// to the value: a meter drawn, not glowing.
let fk_knob = fn(p: vec2, c: vec2, rad: float, px: float, val: float, f0: float, f1: float, gap: float, hover: float, press: float, dis: float, dot_r: float, dot_gap: float) -> vec4 {
    let dia = rad * 2.0
    let q = p - c
    let live = 1.0 - dis
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // the dot ring
    let sweep = 2.0 * PI - gap
    var ang = atan2(-q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let fi = clamp(floor((ang - gap * 0.5) / sweep * 14.0 + 0.5), 0.0, 14.0)
    let da = gap * 0.5 + sweep * fi / 14.0
    let rs = rad + max(1.0, dia * 0.05)
    let rd = rs + dot_gap + dot_r
    let dc = c + vec2(-sin(da), cos(da)) * rd
    let dd = length(p - dc) - dot_r
    let lit = step(fi / 14.0, f1 + 0.02) * step(f0 - 0.02, fi / 14.0)
    var dcol = mix(vec3(0.784, 0.773, 0.757), vec3(0.933, 0.353, 0.141), lit)
    dcol = mix(dcol, vec3(0.84, 0.835, 0.825), dis * 0.7)
    let dca = Finish.cover(dd, px)
    out = Finish.over(out, vec4(dcol * dca, dca))
    // drop and contact
    let hh = vec2(rs, rs)
    let dr = Finish.drop(p, c, hh, rs, vec2(0.3, dia * 0.06), dia * 0.085) * 0.20 * (1.0 - press * 0.5) * mix(1.0, 0.3, dis)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dr))
    let sd = length(q) - rs
    let con = Finish.ring_out(sd, 0.0, px, px) * smoothstep(-0.2, 0.6, q.y / rs) * 0.30
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, con))
    // the skirt ring: grey, lit at the top, darker at the foot
    let st = clamp(q.y / rs * 0.5 + 0.5, 0.0, 1.0)
    var skirt = mix(vec3(0.678, 0.675, 0.667), vec3(0.451, 0.451, 0.447), smoothstep(0.15, 0.95, st))
    skirt = mix(skirt, vec3(0.82, 0.815, 0.805), dis * 0.6)
    skirt = mix(skirt, skirt * 0.72, Finish.band(sd, 0.0, px, px))
    let sa = Finish.cover(sd, px)
    out = Finish.over(out, vec4(skirt * sa, sa))
    // the cap: a vertical fall of -0.06, a pixel of light over its top third
    let d = length(q) - rad
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var face = mix(vec3(0.973, 0.973, 0.973), vec3(0.906, 0.906, 0.906), t)
    face = face + g3(0.035 * hover * live) - g3(0.035 * press * live)
    face = mix(face, vec3(0.925, 0.918, 0.906), dis * 0.5)
    let up = 1.0 - smoothstep(-0.55, -0.4, q.y / rad)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * live)
    face = mix(face, vec3(0.62, 0.62, 0.615), Finish.band(d, 0.0, px, px) * 0.55)
    // the pointer: a flat bar 0.05 D wide from 0.15 D to 0.45 D, round ends
    let pa = gap * 0.5 + sweep * val
    let dir = vec2(-sin(pa), cos(pa))
    let pl = fk_seg(p, c + dir * dia * 0.15, c + dir * dia * 0.43) - max(dia * 0.025, 0.75)
    let pink = mix(vec3(0.878, 0.337, 0.122), vec3(0.72, 0.71, 0.70), dis)
    face = mix(face, pink, Finish.cover(pl, px))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - rr, px) - o.y)
    let gap = self.gap * PI / 180.0
    // the ring's room scales with the knob; under 32 points the dots are
    // 1.5 points and stand 3 points clear of the cap's skirt, so the ring
    // and the skirt read as two edges, not one fuzzy one
    let small = 1.0 - step(16.0, rr)
    let dg = mix(clamp(rr * 0.16, 1.5, 4.0), 3.0, small)
    let dr = mix(clamp(rr * 0.045, 0.6, 1.0), 0.75, small)
    let rad = floor((rr - dg - 2.0 * dr - 0.5) / 1.1 / px) * px
    let lifted = max(self.hover, max(self.focus, self.drag)) * live
    var out = fk_knob(p, c, rad, px, self.slide_pos, self.fill_lo, self.fill_hi, gap, lifted, self.drag * live, self.disabled, dr, dg)
    return Finish.over(out, fk_focus(length(p - c) - rad - max(1.0, rad * 0.1), px, self.focus * live))
}

mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let room = vec2(size.x, size.y - 22.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 22.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let small = 1.0 - step(16.0, rr)
    let dg = mix(clamp(rr * 0.12, 1.5, 4.5), 3.0, small)
    let dr = mix(clamp(rr * 0.035, 0.6, 1.25), 0.75, small)
    let rad = floor((rr - dg - 2.0 * dr - 0.5) / 1.1 / px) * px
    let lifted = max(self.hover, max(self.focus, self.drag)) * live
    var out = fk_knob(p, c, rad, px, self.slide_pos, self.fill_lo, self.fill_hi, gap, lifted, self.drag * live, self.disabled, dr, dg)
    return Finish.over(out, fk_focus(length(p - c) - rad - max(1.0, rad * 0.1), px, self.focus * live))
}

// The dial's readout: a black display window. A pixel of light on the case
// under it, a dark rim, the glass with faint scanlines and one pixel of
// shade under its top edge, cool white monospace digits. No glow.
let fk_display = fn(p: vec2, size: vec2, o: vec2, px: float, r: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = fk_rbox(p, c, h, r)
    let row = floor((p.y + o.y) / px)
    var col = vec3(0.102, 0.102, 0.102) + g3(0.012 * (fract(row * 0.5) * 2.0 - 0.5))
    col = mix(col, vec3(0.0, 0.0, 0.0), fk_run(p.y, lo.y + px, lo.y + 2.0 * px) * 0.4)
    col = mix(col, vec3(0.184, 0.184, 0.184), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    let out = fk_catch(p, c, h, r, px, 0.75)
    return Finish.over(out, vec4(col * a, a))
}
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 5.0 right: 5.0 top: 3.0 bottom: 3.0}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_display(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 1.0)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #e5eff8
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #e5eff8
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #ffffff
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #767676
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_code{font_size: 8.25}

// ---------------------------------------------------------------------------
// FADERS. A 2 point black slot with a light catch on its lower side,
// printed ticks either side, a longer one every fourth, and a white cap
// with a skirt and a dark index line across it (orange while dragged).
// The cap: 16 points across the slot, 24 along the travel (0.61 H by
// 1.03 H), a 2 point skirt on its lower side.
mod.widgets.SliderFader.cap_size = 24.0
mod.widgets.SliderFader.draw_bg.cap_cross = 0.55
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    // track space: `a` along the travel from its zero, `b` across
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let ob = mix(o.y, o.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(ob + across * 0.5, px) - ob
    // the slot, 2 points, black
    let sw = 2.0
    let sh = vec2((along - self.inset_px * 2.0) * 0.5, sw * 0.5)
    let sc = vec2(self.inset_px + sh.x, mid)
    let q = vec2(a, b)
    let sd = fk_rbox(q, sc, sh, sh.y)
    var slot = mix(vec3(0.102, 0.102, 0.102), vec3(0.62, 0.615, 0.605), self.disabled)
    // the slot lit orange over the fill span, from the zero or the origin
    let lit_s = step(foot + self.fill_lo * travel, a) * step(a, foot + self.fill_hi * travel) * step(0.001, self.fill_hi - self.fill_lo)
    slot = mix(slot, mix(vec3(0.933, 0.353, 0.141), vec3(0.72, 0.71, 0.70), self.disabled), lit_s)
    let sa = Finish.cover(sd, px)
    let lip = Finish.ring_out(sd, 0.0, px, px) * step(sc.y, b) * 0.8
    var out = vec4(lip, lip, lip, lip)
    out = Finish.over(out, vec4(slot * sa, sa))
    // ticks either side: 16 steps, 4 points long, 6 at every fourth
    let f = (a - foot) / travel * 16.0
    let fi = floor(f + 0.5)
    let da = abs(a - (foot + fi / 16.0 * travel))
    let major = 1.0 - step(0.3, abs(fract(fi / 4.0 + 0.5) - 0.5))
    let tl = mix(3.0, 5.0, major)
    let off = abs(b - mid)
    let in_rng = step(-0.5, fi) * step(fi, 16.5)
    let tk = (1.0 - smoothstep(px * 0.5 - 0.01, px * 0.5 + 0.01, da)) * step(sw * 0.5 + 3.0, off) * step(off, sw * 0.5 + 3.0 + tl) * in_rng * 0.5 * mix(1.0, 0.45, self.disabled)
    out = Finish.over(out, vec4(0.114 * tk, 0.114 * tk, 0.114 * tk, tk))
    // the cap, laid out in screen space so its skirt is at its foot
    let cap_w = Finish.snap(min(16.0, across), px)
    let cap_l = Finish.snap(self.cap_px, px)
    let at = foot + self.slide_pos * travel
    let cc_ab = vec2(at, mid)
    let cc = mix(cc_ab, vec2(cc_ab.y, size.y - cc_ab.x), vert)
    let ch = mix(vec2(cap_l, cap_w), vec2(cap_w, cap_l), vert) * 0.5
    let clo = vec2(Finish.snap(o.x + cc.x - ch.x, px), Finish.snap(o.y + cc.y - ch.y, px)) - o
    let chi = clo + 2.0 * ch
    let cch = (chi - clo) * 0.5
    let ccc = clo + cch
    let lifted = max(self.hover, self.focus) * live
    out = Finish.over(out, fk_shade(p, ccc, cch, 1.5, px, 1.0, self.disabled, mix(0.16, 0.22, lifted)))
    out = Finish.over(out, fk_cap(p, clo, chi, 1.5, px, 3.0 * px, 0.0, lifted, 0.0, self.disabled, 0.10))
    // the index line across the face (the face ends above its skirt), 1.5
    // device pixels, on the pixel grid
    let fy = Finish.snap(o.y + (clo.y + chi.y - 3.0 * px) * 0.5, px) - o.y
    let fx = Finish.snap(o.x + ccc.x, px) - o.x
    let ix = mix(fk_run(p.x, fx - 0.5, fx + 0.5) * step(abs(p.y - fy), cch.y - 3.0), fk_run(p.y, fy - 0.5, fy + 0.5) * step(abs(p.x - ccc.x), cch.x - 2.0), vert)
    let ink = mix(mix(vec3(0.114, 0.114, 0.114), vec3(0.933, 0.353, 0.141), self.drag * live), vec3(0.7, 0.695, 0.685), self.disabled)
    out = Finish.over(out, vec4(ink * ix, ix))
    return Finish.over(out, fk_focus(fk_rbox(p, ccc, cch, 1.5), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// DROP-DOWNS. The white key with a readout: a seam 22 points from its right
// end (a dark pixel and a light one) and a solid marker triangle, 6 by 4.
let fk_marker = fn(p: vec2, c: vec2) -> float {
    let q = p - c
    // a downward triangle 6 wide, 4 tall, centred on c
    let e = max(abs(q.x) * 0.8 + (q.y + 2.0) * 0.6 - 2.4, -(q.y + 2.0))
    return max(e, q.y - 2.0)
}
let fk_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, dis: float) -> vec4 {
    let m = 6.0
    var out = fk_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(2.5, 2.5, 2.5, 2.5), 0.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let dn = held * live * px
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(4.0 + dn, p.y) * step(p.y, size.y - 6.0 + dn)
    let sd = fk_run(p.x, dx - px, dx) * in_y * 0.30
    let sl = fk_run(p.x, dx, dx + px) * in_y * 0.9
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, sd))
    out = Finish.over(out, vec4(sl, sl, sl, sl))
    let mc = vec2(dx + 11.0, (size.y - 2.0) * 0.5 + dn)
    let mk = Finish.cover(fk_marker(p, mc), px)
    let ink = mix(vec3(0.114, 0.114, 0.114), vec3(0.663, 0.655, 0.643), dis)
    return Finish.over(out, vec4(ink * mk, mk))
}
mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 10.0 right: 30.0 top: 3.0 bottom: 5.0}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let held = max(self.down * self.hover, self.active)
    return fk_dropdown(self.pos, self.rect_size, self.rect_pos, px, self.hover, held, self.focus, self.disabled)
}
mod.widgets.DropDown.draw_bg.color_disabled = #ecebe8
// The stock drop-down restates its own padding: its marker's room, again.
mod.widgets.DropDown.padding.left = 10.0
mod.widgets.DropDown.padding.right = 30.0

// The select wears a button of its own, built before this sheet: it is
// handed the drop-down's key, its grown quad and its room for the marker.
mod.widgets.Select.face.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Select.face.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_dropdown(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled)
}
mod.widgets.Select.face.clip_x = false
mod.widgets.Select.face.clip_y = false
mod.widgets.Select.face.padding.right = 30.0
