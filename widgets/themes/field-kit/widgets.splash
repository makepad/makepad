use mod.prelude.widgets_internal.*

// Minimal instrument hardware. Keys are square-ish caps standing on a pale
// case: a flat face with a hair of gradient, one device pixel of light on
// its top edge, a short skirt below it, a one-pixel contact line and a
// short, crisp drop. Wells are cut in: a shade under the top edge and a
// light catch under the lower one. The case is grained, not painted. Orange
// marks the main action, the chosen answer and the lit lamp; nothing glows.
mod.widgets.Button.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.0 bottom: 5.0}
mod.widgets.Button.draw_bg.border_radius = 2.5
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Keys take the same 26: 24 of face and a skirt
// of 2.
let field_height = 26.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 1.5
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #efedea

// Plain views stop clipping, so a key's drop and contact line may fall into
// the gap beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// A held state on the still states page must show: the stock hover and
// press arrive as snapped values, which a state held from the start never
// receives, so both are restated with plain values and a snapped entry.
let fk_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
fk_held_states(mod.widgets.ButtonFlat)
fk_held_states(mod.widgets.CheckBoxFlat)
fk_held_states(mod.widgets.ToggleFlat)
fk_held_states(mod.widgets.RadioButtonFlat)
fk_held_states(mod.widgets.RadioButtonTabFlat)
fk_held_states(mod.widgets.TextInputFlat)
fk_held_states(mod.widgets.DropDownFlat)

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. Colours are sRGB values.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let fk_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// The same with a radius per corner: (top left, top right, bottom right,
// bottom left).
let fk_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q = p - c
    let rt = mix(r4.x, r4.y, step(0.0, q.x))
    let rb = mix(r4.w, r4.z, step(0.0, q.x))
    return fk_rbox(p, c, h, mix(rt, rb, step(0.0, q.y)))
}

// A key's corners from the stock corner uniforms: -1 follows the key's own
// radius; a group squares its joints with 0; nothing rounder than the key.
let fk_corner = fn(v: float, r: float) -> float {
    return mix(min(max(v, 0.0), r), r, step(v, -0.5))
}
let fk_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(fk_corner(tl, r), fk_corner(tr, r), fk_corner(br, r), fk_corner(bl, r))
}

let fk_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A crisp horizontal or vertical run of device pixels: 1 inside a..b.
let fk_run = fn(v: float, a: float, b: float) -> float {
    return step(a, v) * (1.0 - step(b, v))
}

let fk_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The case: pale warm grey, one-pixel monochrome grain (sd about 0.005)
// and a paper fibre three pixels long and one and a half tall (sd about
// 0.006). No fall, no vignette. Two hashes of different lattices are mixed
// so no period shows.
let fk_grain = fn(q: vec2) -> float {
    let i = floor(q)
    let a = Finish.hash(i * 0.7548776662 + vec2(i.y * 0.5698402910, 13.71))
    let b = Finish.hash(vec2(i.y, i.x) * 1.3247179572 + vec2(41.3, i.x * 0.3819660113))
    return a - b
}
let fk_fibre = fn(q: vec2) -> float {
    let s = vec2(q.x / 3.0, q.y / 1.5)
    return Finish.noise(s + vec2(Finish.hash(vec2(floor(s.y), 7.0)) * 57.0, 0.0)) - 0.5
}
let fk_case = fn(base: vec3, p: vec2, px: float) -> vec3 {
    let q = p / px
    return base + g3(fk_grain(q) * 0.0115 + fk_fibre(q) * 0.021)
}
// A plate's face: the grain alone at the brief's sd 0.005 (window
// coordinates, so plates and ground share one lattice); no fibre, which
// began to structure on the smaller fields of a plate.
let fk_plate_grain = fn(base: vec3, w: vec2, px: float) -> vec3 {
    return base + g3(fk_grain(w / px) * 0.0125)
}

// The colours of a keycap by tone: 0 white, 1 signal orange, 2 black,
// 3 grey. `k` picks the part: 0 face top, 1 face foot, 2 roll-off at the
// very foot, 3 top light line, 4 skirt, 5 pressed top, 6 pressed foot.
let fk_tone = fn(tone: float, k: float) -> vec3 {
    let wh = step(tone, 0.5)
    let orng = step(0.5, tone) * step(tone, 1.5)
    let bk = step(1.5, tone) * step(tone, 2.5)
    let gr = step(2.5, tone)
    var w = vec3(0.961, 0.961, 0.961)
    var o = vec3(0.933, 0.353, 0.141)
    var b = vec3(0.220, 0.220, 0.220)
    var g = vec3(0.816, 0.800, 0.796)
    if k > 0.5 {
        w = vec3(0.922, 0.922, 0.922)
        o = vec3(0.925, 0.345, 0.137)
        b = vec3(0.208, 0.208, 0.208)
        g = vec3(0.796, 0.780, 0.776)
    }
    if k > 1.5 {
        w = vec3(0.900, 0.900, 0.898)
        o = vec3(0.863, 0.220, 0.094)
        b = vec3(0.150, 0.150, 0.150)
        g = vec3(0.720, 0.706, 0.702)
    }
    if k > 2.5 {
        w = vec3(1.0, 1.0, 1.0)
        o = vec3(0.984, 0.643, 0.365)
        b = vec3(0.624, 0.624, 0.624)
        g = vec3(0.961, 0.961, 0.961)
    }
    if k > 3.5 {
        w = vec3(0.831, 0.831, 0.831)
        o = vec3(0.761, 0.255, 0.059)
        b = vec3(0.110, 0.110, 0.110)
        g = vec3(0.690, 0.675, 0.671)
    }
    if k > 4.5 {
        w = vec3(0.871, 0.867, 0.867)
        o = vec3(0.835, 0.251, 0.059)
        b = vec3(0.180, 0.180, 0.180)
        g = vec3(0.741, 0.725, 0.722)
    }
    if k > 5.5 {
        w = vec3(0.918, 0.918, 0.918)
        o = vec3(0.835, 0.251, 0.059)
        b = vec3(0.196, 0.196, 0.196)
        g = vec3(0.788, 0.773, 0.769)
    }
    return w * wh + o * orng + b * bk + g * gr
}

// The shade a key throws on the case: a short drop down and a little to
// the right (reach under 6 points), the one-pixel contact line under its
// foot and a faint pixel round its sides. `lift` 1 at rest, 0 pressed.
let fk_shade = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, lift: float, dis: float, drop_a: float) -> vec4 {
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let dr = Finish.drop(p, c, h, r, vec2(0.45, 1.1), 2.0) * drop_a * 1.12 * lift * (1.0 - dis)
    out = Finish.over(out, vec4(0.0, 0.0, 0.0, dr))
    let d = fk_rbox(p, c, h, r)
    let foot = smoothstep(c.y + h.y - r - 0.5, c.y + h.y - 0.2, p.y)
    let ring = Finish.ring_out(d, 0.0, px, px)
    let con = ring * mix(0.09, mix(0.18, 0.32, lift), foot) * mix(1.0, 0.4, dis)
    return Finish.over(out, vec4(0.0, 0.0, 0.0, con))
}

// A keycap in the box lo..hi (quad-local, snapped): the skirt `sk` tall at
// the foot, the face above it with its gradient, its one-pixel top light
// line, a roll-off at the foot of coloured faces, and pressed in: the skirt
// gone, the face one pixel lower, its gradient turned and a shade under its
// top edge. `rim` the strength of a dark hairline round it.
let fk_cap4 = fn(p: vec2, lo: vec2, hi: vec2, r4: vec4, px: float, sk: float, tone: float, hover: float, press: float, dis: float, rim: float) -> vec4 {
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = fk_rbox4(p, c, h, r4)
    let flo = vec2(lo.x, lo.y + press * px)
    let fhi = vec2(hi.x, hi.y - sk * (1.0 - press))
    let fh = (fhi - flo) * 0.5
    let fc = flo + fh
    let fd = fk_rbox4(p, fc, fh, r4)
    let r = mix(mix(r4.x, r4.y, step(fc.x, p.x)), mix(r4.w, r4.z, step(fc.x, p.x)), step(fc.y, p.y))
    let t = clamp((p.y - flo.y) / max(fhi.y - flo.y, 1.0), 0.0, 1.0)
    // the face
    var face = mix(fk_tone(tone, 0.0), fk_tone(tone, 1.0), t)
    let roll = (1.0 - smoothstep(0.0, 4.0 * px, fhi.y - p.y)) * step(0.5, tone)
    face = mix(face, fk_tone(tone, 2.0), roll * 0.8)
    // hover lifts the face: +0.045 on the pale caps, +0.03 on orange,
    // +0.08 on black, so it reads at arm's length and not only in a probe
    let is_o = step(0.5, tone) * step(tone, 1.5)
    let is_b = step(1.5, tone) * step(tone, 2.5)
    let hv = mix(mix(0.045, 0.03, is_o), 0.08, is_b)
    face = face + g3(hv * hover * (1.0 - press))
    let pf = mix(fk_tone(tone, 5.0), fk_tone(tone, 6.0), t)
    face = mix(face, pf, press)
    // pressed in: a shade two pixels deep under the top edge
    let ytop = p.y - flo.y
    face = face - g3(0.10 * press * (1.0 - smoothstep(px, 2.0 * px, ytop)))
    // the top light line, inset by the corner at its ends
    let tl = fk_run(p.y, flo.y, flo.y + px) * step(abs(p.x - fc.x), fh.x - r + 0.5 * px)
    face = mix(face, fk_tone(tone, 3.0), tl * (1.0 - press) * (1.0 - dis))
    // wide caps catch the light on their left edge too, at half strength
    let ll = fk_run(p.x, flo.x, flo.x + px) * step(abs(p.y - fc.y), fh.y - r) * step(4.0 * fh.y, 2.0 * fh.x)
    face = mix(face, fk_tone(tone, 3.0), ll * 0.5 * (1.0 - press) * (1.0 - dis))
    var skirt = fk_tone(tone, 4.0)
    // disabled: the face most of the way to the case, the skirt paler
    face = mix(face, vec3(0.925, 0.918, 0.906), dis * 0.6)
    skirt = mix(skirt, vec3(0.878, 0.871, 0.859), dis)
    let rl = Finish.band(d, 0.0, px, px) * rim
    skirt = mix(skirt, vec3(0.0, 0.0, 0.0), rl)
    face = mix(face, face * (1.0 - rim * 0.9), Finish.band(fd, 0.0, px, px))
    let a = Finish.cover(d, px)
    var out = vec4(skirt * a, a)
    let fa = Finish.cover(fd, px)
    return Finish.over(out, vec4(face * fa, fa))
}
let fk_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, sk: float, tone: float, hover: float, press: float, dis: float, rim: float) -> vec4 {
    return fk_cap4(p, lo, hi, vec4(r, r, r, r), px, sk, tone, hover, press, dis, rim)
}

// The focus ring: one pixel of signal orange two pixels out. Never a glow.
let fk_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * focus
    return vec4(0.933 * f, 0.353 * f, 0.141 * f, f)
}

// A well cut into the case: the fill, a shade under the top edge `depth`
// deep, a hairline mouth darkest at the top, and a light catch under the
// lower rim, outside it (premultiplied, drawn first by the caller).
let fk_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, shade: float, mouth: vec3, mouth_a: float) -> vec3 {
    let d = fk_rbox(p, c, h, r)
    let top = c.y - h.y
    let sh = 1.0 - smoothstep(0.0, px, p.y - top - px)
    var col = mix(fill, vec3(0.0, 0.0, 0.0), sh * shade)
    let low = smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, mouth, Finish.band(d, 0.0, px, px) * mouth_a * mix(1.0, 0.7, low))
    return col
}
let fk_catch = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, a: float) -> vec4 {
    let d = fk_rbox(p, c, h, r)
    let l = Finish.ring_out(d, 0.0, px, px) * smoothstep(c.y + h.y - r - 0.5, c.y + h.y, p.y) * a
    return vec4(l, l, l, l)
}

// ---------------------------------------------------------------------------
// BUTTONS. One key for the family; `kind` picks the dressing: 0 white key,
// 1 orange key (the main action), 2 black key, 3 grey key, 4 engraved
// outline in the case, 5 bare until touched, 6 a flat printed key with no
// skirt. The quad grows by `m` (6 points) for the drop and the focus ring.
let fk_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r4: vec4, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = fk_rbox4(p, c, h, r4)
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    let raised = step(kind, 3.5)
    let flat = step(5.5, kind)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if kind < 3.5 {
        // hovered, the key lifts: its drop from 0.17 to 0.24
        out = fk_shade(p, c, h, r, px, 1.0 - press, disabled, mix(0.15, 0.215, hov))
        out = Finish.over(out, fk_cap4(p, lo, hi, r4, px, 3.0 * px, kind, hov, press, disabled, 0.0))
        // a joint in a group of keys: a seam pixel on each side of it
        let jl = step(r4.x + r4.w, 0.01) * fk_run(p.x, lo.x, lo.x + px)
        let jr = step(r4.y + r4.z, 0.01) * fk_run(p.x, hi.x - px, hi.x)
        let sm = (jl + jr) * fk_run(p.y, lo.y, hi.y) * 0.28
        out = Finish.over(out, vec4(0.0, 0.0, 0.0, sm))
    }
    if kind > 5.5 {
        // flat: a printed key with no skirt, a faint edge and contact line
        out = fk_shade(p, c, h, r, px, (1.0 - press) * 0.6, disabled, 0.0)
        out = Finish.over(out, fk_cap4(p, lo, hi, r4, px, 0.0, 0.0, hov, press, disabled, 0.10))
    }
    if kind > 3.5 && kind < 5.5 {
        let bare = step(4.5, kind)
        // the engraving: a dark pixel on the edge, a light one under it
        let dk = Finish.band(d, 0.0, px, px) * (1.0 - bare) * mix(0.24, 0.10, disabled)
        let d2 = fk_rbox4(p - vec2(0.0, px), c, h, r4)
        let lt = Finish.band(d2, 0.0, px, px) * (1.0 - Finish.band(d, 0.0, px, px)) * step(c.y, p.y) * (1.0 - bare) * 0.55
        out = Finish.over(out, vec4(lt, lt, lt, lt))
        // touched: a faint face comes up out of the case, pressed a shade
        let fa = Finish.cover(d, px) * (hov * (1.0 - press) * mix(0.55, 0.45, bare))
        out = Finish.over(out, vec4(fa, fa, fa, fa))
        let da = Finish.cover(d, px) * press * 0.07
        out = Finish.over(out, vec4(0.0, 0.0, 0.0, da))
        let ed = Finish.band(d, 0.0, px, px) * max(dk, bare * (hov + press) * 0.14)
        out = Finish.over(out, vec4(0.0, 0.0, 0.0, ed))
    }
    // focus: one orange pixel two pixels out
    out = Finish.over(out, fk_focus(d, px, focus * live))
    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y - 1.0, rr, a0, a0 + 1.5 * PI, 1.5)
        var ink = vec3(0.114, 0.114, 0.114)
        if kind > 0.5 && kind < 2.5 {
            ink = vec3(1.0, 1.0, 1.0)
        }
        sdf.fill(vec4(ink, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The root is the flat printed key; the sizes and the compound button are
// handed the standard key's draw object below, so they stand as keys.
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, fk_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 6.0, 6.0)
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlatter.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, fk_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 5.0, 6.0)
}
mod.widgets.Button.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, fk_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 0.0, 6.0)
}
mod.widgets.ButtonPrimary.draw_bg.vertex = fn() {
    let g = fk_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return fk_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, fk_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 2.5), 1.0, 6.0)
}
