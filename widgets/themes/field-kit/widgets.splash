// ---------------------------------------------------------------------------
// ENGRAVED PRINT. A label printed on the case carries one device pixel of
// light under each glyph, read from the glyph one pixel above: one more
// sample and nothing else. One literal per template.
mod.widgets.Label.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var s = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.sdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.msdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    let e = s * 0.6 * c.a * (1.0 - step(0.35, Finish.lum(c.rgb)))
    return main + vec4(e, e, e, e) * (1.0 - main.a)
}
// The small heading (a card's title) is engraved like the labels; it was
// built from Label before this sheet ran, so it takes its own literal.
mod.widgets.H4.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    let c = self.get_color()
    let dxt = length(dFdx(self.t))
    let dyt = length(dFdy(self.t))
    var s = 0.0
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.sdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        s = self.msdf((dxt + dyt) * tex_size.x * 0.5, ps, c)
    }
    let e = s * 0.6 * c.a * (1.0 - step(0.45, Finish.lum(c.rgb)))
    return main + vec4(e, e, e, e) * (1.0 - main.a)
}
