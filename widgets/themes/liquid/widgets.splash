// The primary is blue glass, throwing a blue pool; its label stays black.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, vec4(lq_blue(), 1.0), 1.0, 0.0, 0.0)
}
// Secondary is plain clear glass; tertiary is smoked glass lying down.
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
