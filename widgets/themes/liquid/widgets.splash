// SLIDERS. Every slider face draws its handle and its shadows past its own
// box, so the family's root grows the quad and stops clipping.
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false

// A value fill laid in a well: the accent at three quarters over the well,
// with the well's own dark line kept along its top.
let lq_fill = fn(acc: vec4, p: vec2, c: vec2, h: vec2, px: float, x0: float, x1: float, col: vec3, k: float) -> vec4 {
    let r = min(h.x, h.y)
    let fc = vec2((x0 + x1) * 0.5, c.y)
    let fh = vec2(max((x1 - x0) * 0.5, 0.0), h.y)
    let fd = Material.sd_box(p, fc, fh, min(r, fh.x))
    let wd = Material.sd_box(p, c, h, r)
    let top = step(p.y, c.y - h.y + px) * 0.35
    let fcol = mix(col, vec3(0.165, 0.192, 0.251), top)
    let a = Finish.cover(fd, px) * Finish.cover(wd, px) * k * step(0.01, x1 - x0)
    return Finish.over(acc, vec4(fcol * a, a))
}

// The bar slider's well and fill, drawn once where they lie and once more
// as the lens shows them, magnified.
let lq_bar_track = fn(p: vec2, gc: vec2, gh: vec2, px: float, f0: float, f1: float, fcol: vec3, dis: float) -> vec4 {
    let acc = lq_well(p, gc, gh, gh.y, px, vec3(0.737, 0.749, 0.773), dis)
    return lq_fill(acc, p, gc, gh, px, f0, f1, fcol, 0.8)
}
// The bar slider: a 6 point well under the label row, the accent fill from
// the stop (or from the default) to the handle, and a 16 point lens through
// which the well and its fill show magnified.
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let dis = mix(1.0, 0.35, self.disabled)
    let top = 20.0
    let cy = Finish.snap(org.y + top + (self.rect_size.y - top) * 0.5, px) - org.y
    let kr = 8.0
    let x0 = kr
    let x1 = self.rect_size.x - kr
    let hx = mix(x0, x1, self.slide_pos)
    let gc = vec2(self.rect_size.x * 0.5, cy)
    let gh = vec2(self.rect_size.x * 0.5, 3.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, hi, self.arc_origin)
    let f0 = mix(gc.x - gh.x, mix(x0, x1, from), step(0.0001, from))
    let f1 = mix(x0, x1, to)
    let fcol = mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled)
    let acc = lq_bar_track(pq, gc, gh, px, f0, f1, fcol, dis)
    let kc = vec2(Finish.snap(org.x + hx, px) - org.x, cy)
    let under = lq_bar_track(lq_mag(pq, kc, 1.12 + 0.06 * self.drag), gc, gh, px, f0, f1, fcol, dis)
    let lens = lq_lens(acc, under, pq, kc, kr, px, dis, max(self.hover, self.focus * 0.5), self.drag, vec4(0.0, 0.0, 0.0, 0.0))
    let hd = length(pq - kc) - kr
    return Finish.over(lens, lq_focus(hd, px, self.focus * (1.0 - self.disabled)))
}

// The minimal slider's line and fill, drawn where they lie and as the lens
// shows them.
let lq_line_track = fn(pq: vec2, w: float, cy: float, px: float, fx0: float, fx1: float, fcol: vec3, dis: float) -> vec4 {
    let inx = step(0.0, pq.x) * step(pq.x, w)
    let dk = step(cy - px, pq.y) * step(pq.y, cy) * inx * 0.5 * dis
    let lt = step(cy, pq.y) * step(pq.y, cy + px) * inx * 0.8 * dis
    var acc = vec4(vec3(0.427, 0.443, 0.478) * dk, dk)
    acc = Finish.over(acc, vec4(lt, lt, lt, lt))
    let fd = Material.sd_box(pq, vec2((fx0 + fx1) * 0.5, cy), vec2((fx1 - fx0) * 0.5 + 1.0, 1.0), 1.0)
    let fa = Finish.cover(fd, px) * 0.85
    return Finish.over(acc, vec4(fcol * fa, fa))
}

// The minimal slider: an engraved line, dark over light, a 2 point fill
// and a 12 point lens.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let dis = mix(1.0, 0.35, self.disabled)
    let top = self.offset_y
    let cy = Finish.snap(org.y + top + (self.rect_size.y - top) * 0.5, px) - org.y
    let kr = 6.0
    let x0 = kr
    let x1 = self.rect_size.x - kr
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, hi, self.arc_origin)
    let fx0 = mix(x0, x1, from)
    let fx1 = mix(x0, x1, to)
    let fcol = mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled)
    let acc = lq_line_track(pq, self.rect_size.x, cy, px, fx0, fx1, fcol, dis)
    let hx = mix(x0, x1, self.slide_pos)
    let kc = vec2(Finish.snap(org.x + hx, px) - org.x, cy)
    let under = lq_line_track(lq_mag(pq, kc, 1.12), self.rect_size.x, cy, px, fx0, fx1, fcol, dis)
    let lens = lq_lens(acc, under, pq, kc, kr, px, dis, self.hover, self.drag, vec4(0.0, 0.0, 0.0, 0.0))
    let hd = length(pq - kc) - kr
    return Finish.over(lens, lq_focus(hd, px, self.focus * (1.0 - self.disabled)))
}

// The round slider is the readout slider: a glass capsule beside its label
// holding a 6 point well, the fill up to an upright glass bar handle.
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let sx0 = self.label_size
    let sx1 = self.rect_size.x - 40.0
    let hgt = min(self.rect_size.y, 18.0)
    let b = lq_snap(org, vec2(sx0, self.rect_size.y * 0.5 - hgt * 0.5), vec2(sx1, self.rect_size.y * 0.5 + hgt * 0.5), px)
    let sc = (b.xy + b.zw) * 0.5
    let sh = (b.zw - b.xy) * 0.5
    var acc = lq_cast(pq, sc, sh, sh.y, px, hgt, 0.26 * dis, 1.0, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.3 * en)
    acc = Finish.over(acc, lq_body(pq, sc, sh, sh.y, px, hgt, lq_clear() + vec3(0.02 * self.hover, 0.02 * self.hover, 0.02 * self.hover), 1.0, 0.88, mix(1.0, 0.5, self.disabled), 1.0, 0.06 * hgt + px, 1.5, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988)))
    let wc = vec2(sc.x, sc.y)
    let wh = vec2(sh.x - 6.0, 3.0)
    acc = Finish.over(acc, lq_well(pq, wc, wh, 3.0, px, vec3(0.737, 0.749, 0.773), dis))
    let x0 = wc.x - wh.x + 2.0
    let x1 = wc.x + wh.x - 2.0
    let hx = mix(x0, x1, self.slide_pos)
    acc = lq_fill(acc, pq, wc, wh, px, wc.x - wh.x, hx, mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled), 0.8)
    // The handle: an upright clear bar, 4 by 14, lit on its left edge and
    // dark on its right, with a tight contact shadow.
    let hc = vec2(Finish.snap(org.x + hx, px) - org.x, sc.y)
    let hh = vec2(2.0, 7.0)
    let hd = Material.sd_box(pq, hc, hh, 2.0)
    let cs = Finish.drop(pq, hc, hh, 2.0, vec2(0.5, 1.2), 1.2) * 0.3 * dis * (1.0 - Finish.cover(hd, px))
    acc = Finish.over(acc, vec4(vec3(0.165, 0.192, 0.251) * cs, cs))
    var hcol = vec3(0.945, 0.953, 0.969) + vec3(0.02, 0.02, 0.02) * self.hover - vec3(0.03, 0.03, 0.03) * self.drag
    hcol = mix(hcol, vec3(1.0, 1.0, 1.0), step(pq.x, hc.x - hh.x + px) * 0.8)
    hcol = mix(hcol, vec3(0.247, 0.255, 0.314), step(hc.x + hh.x - px, pq.x) * 0.45)
    hcol = mix(hcol, vec3(0.604, 0.616, 0.651), Finish.band(hd, 0.0, px, px) * 0.7)
    let ha = Finish.cover(hd, px)
    acc = Finish.over(acc, vec4(hcol * ha, ha))
    let sd = Material.sd_box(pq, sc, sh, sh.y)
    return Finish.over(acc, lq_focus(sd, px, self.focus * en))
}

// The fader: a 4 point slot, the accent out of the origin, a 20 by 10
// clear glass cap across it with one black centre line, and printed ticks
// beside the slot, one tenth apart, longer at the middle. Lying down or
// standing up; the light stays above.
mod.widgets.SliderFader.cap_size = 10.0
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let v = self.is_vertical
    let en = 1.0 - self.disabled
    let dis = mix(1.0, 0.35, self.disabled)
    let along = mix(self.rect_size.x, self.rect_size.y, v)
    let across = mix(self.rect_size.y, self.rect_size.x, v)
    let q = vec2(mix(pq.x, self.rect_size.y - pq.y, v), mix(pq.y, pq.x, v))
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mb = floor(across * 0.5)
    let tp = (q.x - foot) / travel * 10.0
    let near = abs(tp - floor(tp + 0.5)) * travel / 10.0
    let tk = step(near, px * 0.5) * step(-0.05, tp) * step(tp, 10.05)
    let mid = step(abs(tp - 5.0), 0.5)
    let len = mix(4.0, 6.0, mid)
    let side = step(14.0, abs(q.y - mb)) * step(abs(q.y - mb), 14.0 + len)
    let ta = tk * side * 0.35 * dis
    var acc = vec4(vec3(0.110, 0.118, 0.133) * ta, ta)
    // the slot, drawn in screen space so its lip stays below
    let gc_t = vec2(along * 0.5, mb)
    let gc = vec2(mix(gc_t.x, gc_t.y, v), mix(gc_t.y, self.rect_size.y - gc_t.x, v))
    let gh = vec2(mix(along * 0.5 - self.inset_px, 2.0, v), mix(2.0, along * 0.5 - self.inset_px, v))
    acc = Finish.over(acc, lq_well(pq, gc, gh, 2.0, px, vec3(0.737, 0.749, 0.773), dis))
    let lo = foot + self.fill_lo * travel
    let hi = foot + self.fill_hi * travel
    let fd = Material.sd_box(q, vec2((lo + hi) * 0.5, mb), vec2((hi - lo) * 0.5, 2.0), 2.0)
    let fa = Finish.cover(fd, px) * 0.8 * step(0.01, hi - lo)
    acc = Finish.over(acc, vec4(mix(lq_accent(), vec3(0.643, 0.651, 0.671), self.disabled) * fa, fa))
    // the cap
    let at = foot + self.slide_pos * travel
    let cap_t = vec2(at, mb)
    let cap_s = vec2(mix(cap_t.x, cap_t.y, v), mix(cap_t.y, self.rect_size.y - cap_t.x, v))
    let ch = vec2(mix(self.cap_px * 0.5, 10.0, v), mix(10.0, self.cap_px * 0.5, v))
    let cr = 3.0
    let hov = self.hover * en * (1.0 - self.drag)
    acc = Finish.over(acc, lq_cast(pq, cap_s, ch, cr, px, 10.0, 0.26 * dis, 1.0 - 0.5 * self.drag, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.0))
    let face = lq_clear() + vec3(0.06 + 0.03 * hov - 0.03 * self.drag, 0.06 + 0.03 * hov - 0.03 * self.drag, 0.06 + 0.03 * hov - 0.03 * self.drag)
    acc = Finish.over(acc, lq_body(pq, cap_s, ch, cr, px, 10.0, face, 1.0, 0.92, mix(1.0, 0.5, self.disabled), 1.0, 1.2, 1.0, vec4(0.620, 0.631, 0.659, 0.9), vec3(0.965, 0.973, 0.988)))
    let cd = Material.sd_box(pq, cap_s, ch, cr)
    let cl = step(abs(q.x - at), px * 0.5) * step(abs(q.y - mb), 7.0) * Finish.cover(cd + 1.0, px) * 0.5
    acc = Finish.over(acc, vec4(vec3(0.110, 0.118, 0.133) * cl, cl))
    return Finish.over(acc, lq_focus(cd, px, self.focus * en))
}

// KNOBS. A clear glass disc with the rim of every other part, a black
// pointer line, and round it a dark ring with the value laid into it as an
// accent core, the glass family's value arc: ink, not light.
let lq_arc = fn(p: vec2, c: vec2, rr: float, a0: float, a1: float, w: float) -> float {
    let q = p - c
    var ap = atan2(-q.x, q.y)
    if ap < 0.0 {
        ap = ap + 2.0 * PI
    }
    let rel = ap - a0 - floor((ap - a0) / (2.0 * PI)) * 2.0 * PI
    let on = step(rel, a1 - a0)
    let band = abs(length(q) - rr) - 0.5 * w
    let e0 = length(q - vec2(-sin(a0), cos(a0)) * rr) - 0.5 * w
    let e1 = length(q - vec2(-sin(a1), cos(a1)) * rr) - 0.5 * w
    return mix(min(e0, e1), band, on)
}

let lq_knob = fn(p: vec2, c: vec2, r: float, px: float, start: float, sweep: float, a0: float, a1: float, val: float, hover: float, drag: float, focus: float, disabled: float) -> vec4 {
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.35, disabled)
    let dd = 2.0 * r
    let hov = hover * en * (1.0 - drag)
    // The ring, a little outside the cap: a pale hairline, then the dark
    // band with the value's accent core laid into it.
    let gap = clamp(0.1 * r, 1.5, 3.0)
    let rr = r + gap
    let pale = Finish.cover(lq_arc(p, c, rr + gap * 0.5 + 1.0, start, start + sweep, px), px) * 0.45 * dis
    var acc = vec4(pale, pale, pale, pale)
    let ta = Finish.cover(lq_arc(p, c, rr, start, start + sweep, 2.0), px) * 0.85 * dis
    acc = Finish.over(acc, vec4(vec3(0.196, 0.271, 0.400) * ta, ta))
    let va = Finish.cover(lq_arc(p, c, rr, a0, max(a1, a0 + 0.001), 1.1), px) * step(0.0005, a1 - a0) * dis
    acc = Finish.over(acc, vec4(mix(vec3(0.439, 0.620, 0.949), vec3(0.643, 0.651, 0.671), disabled) * va, va))
    let h = vec2(r, r)
    acc = Finish.over(acc, lq_cast(p, c, h, r, px, dd, 0.3 * dis, 1.0 - 0.4 * drag, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.32 * en * (1.0 - 0.5 * drag)))
    let face = lq_clear() + vec3(0.03 * hov - 0.02 * drag, 0.03 * hov - 0.02 * drag, 0.03 * hov - 0.02 * drag)
    acc = Finish.over(acc, lq_body(p, c, h, r, px, dd, face, 1.0, 0.9, mix(0.95, 1.0, hov) * mix(1.0, 0.5, disabled), 1.0, 0.06 * dd + px, 1.5, vec4(0.620, 0.631, 0.659, 0.9), vec3(0.965, 0.973, 0.988)))
    // The pointer: a black line 1.5 points wide, a fifth of the disc long,
    // set in from the rim.
    let dir = vec2(-sin(val), cos(val))
    let pd = lq_seg(p, c + dir * (r - 2.5 - 0.2 * dd), c + dir * (r - 2.5)) - 0.75
    let pa = Finish.cover(pd, px) * mix(1.0, 0.35, disabled)
    acc = Finish.over(acc, vec4(vec3(0.110, 0.118, 0.133) * pa, pa))
    return Finish.over(acc, lq_focus(length(p - c) - r, px, focus * en))
}

// The panel knob: the disc in the biggest circle the box holds, pinned to
// the bottom under its legend, its ring round it.
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px) - self.rect_pos.y)
    let r = dia * 0.5 - clamp(0.15 * dia, 3.5, 6.5)
    let one = PI / 180.0
    let sweep = 2.0 * PI - self.gap * one
    let start = self.gap * one * 0.5
    let val = start + sweep * self.slide_pos
    let org_a = start + sweep * self.origin_pos
    let a0 = mix(start, min(org_a, val), self.arc_origin)
    let a1 = mix(val, max(org_a, val), self.arc_origin)
    return lq_knob(pq, c, r, px, start, sweep, a0, a1, val, self.hover, self.drag, self.focus, self.disabled)
}
mod.widgets.RotaryKnob.width = 44.0
mod.widgets.RotaryKnob.height = 60.0
// The legend over a knob is a small caption in the dim ink.
mod.widgets.RotaryKnob.draw_text.color = #4a4e56
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}
mod.widgets.RotaryFlat.text_input.draw_bg.color = #00000000
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding.top = 0.0
mod.widgets.RotaryFlat.text_input.padding.bottom = 0.0
mod.widgets.Rotary.text_input.min_height = 0.0
mod.widgets.Rotary.text_input.padding.top = 0.0
mod.widgets.Rotary.text_input.padding.bottom = 0.0
mod.widgets.RotaryFlat.label_walk.margin.top = 4.0
// The value a bar slider carries beside its label sits on the label's
// line: its field takes no row height of its own (its padding is nil).
mod.widgets.SliderFlat.text_input.min_height = 0.0
mod.widgets.Slider.text_input.min_height = 0.0
mod.widgets.SliderMinimal.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.Rotary.label_walk.margin.top = 4.0

// The dial: the same knob, larger, under its legend and readout.
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let top = 24.0
    let dia = min(self.rect_size.x, self.rect_size.y - top)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x, Finish.snap(self.rect_pos.y + top + dia * 0.5, px) - self.rect_pos.y)
    let r = min(dia * 0.5 - 7.0, 28.0)
    let one = PI / 180.0
    let sweep = 2.0 * PI - self.gap * one
    let start = self.gap * one * 0.5
    let val = start + sweep * self.slide_pos
    let org_a = start + sweep * self.origin_pos
    let a0 = mix(start, min(org_a, val), self.arc_origin)
    let a1 = mix(val, max(org_a, val), self.arc_origin)
    return lq_knob(pq, c, r, px, start, sweep, a0, a1, val, self.hover, self.drag, self.focus, self.disabled)
}

// PROGRESS. A 6 point well; the fill is blue glass, paler along its top
// with a pale hairline and a bright exit pixel along its foot. Without a
// value the bar holds one still segment in its middle: a face may not read
// the clock, so the sweep cannot move.
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let w = self.rect_size.x
    let t = min(6.0, self.rect_size.y)
    let cy = Finish.snap(org.y + self.rect_size.y * 0.5, px) - org.y
    let x0 = w * self.start
    let x1 = w * self.end
    let gc = vec2((x0 + x1) * 0.5, cy)
    let gh = vec2((x1 - x0) * 0.5, t * 0.5)
    var acc = lq_well(p, gc, gh, t * 0.5, px, vec3(0.737, 0.749, 0.773), 1.0) * step(0.5, self.track)
    let xv = w * clamp(self.value, self.start, self.end)
    let det = step(0.0, self.value)
    let fa0 = mix(x0 + (x1 - x0) * 0.35, x0, det)
    let fa1 = mix(x0 + (x1 - x0) * 0.65, xv, det)
    let fr = t * 0.5
    let fd = Material.sd_box(p, vec2((fa0 + fa1) * 0.5, cy), vec2(max((fa1 - fa0) * 0.5, 0.0), fr), min(fr, max((fa1 - fa0) * 0.5, 0.0)))
    let v = clamp((p.y - cy + fr) / (2.0 * fr), 0.0, 1.0)
    let glass = mix(vec3(0.498, 0.608, 0.769), lq_accent(), smoothstep(0.1, 0.9, v))
    var fcol = mix(glass, self.fill_color().rgb, step(0.5, self.intent))
    fcol = mix(fcol, vec3(0.839, 0.886, 0.980), Finish.band(fd, 0.0, px, px) * step(p.y, cy - fr + px) * 0.8)
    fcol = mix(fcol, vec3(0.839, 0.886, 0.980), Finish.band(fd, 0.0, px, px) * step(cy + fr - px, p.y) * 0.5)
    let show = mix(1.0, step(x0 + 0.5, xv), det)
    let fA = Finish.cover(fd, px) * show
    acc = Finish.over(acc, vec4(fcol * fA, fA))
    return acc * self.opacity
}
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = 6.0

// LEVEL METER. A readout window of dark glass cut into the ground: a black
// rim, a pale lip on its lower edge, and cells three points long with a
// point between, flat colour, accent to seven tenths, amber to nine,
// red above; unlit cells show a tenth of their colour. The held peak is the
// one lit mark allowed a short halo. The clip lamp is a bead of dark glass that lights red, no glow.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let v = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, v)
    let across = mix(self.rect_size.y, self.rect_size.x, v)
    let q = vec2(mix(p.x, self.rect_size.y - p.y, v), mix(p.y, p.x, v))
    let lamp_room = self.lamp * (6.0 + self.lamp_gap)
    let bar = max(4.0, along - lamp_room)
    let r = min(3.0, across * 0.5)
    let gc = vec2(bar * 0.5, across * 0.5)
    let gh = vec2(bar * 0.5, across * 0.5)
    let gd = Material.sd_box(q, gc, gh, r)
    let tv = clamp(q.y / max(across, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.071, 0.094, 0.169), vec3(0.110, 0.137, 0.251), smoothstep(0.0, 0.6, tv))
    let pad = 1.5
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((q.x - pad) / span, 0.0, 1.0)
    var zone = vec3(0.310, 0.498, 0.820)
    zone = mix(zone, vec3(0.851, 0.643, 0.255), step(0.7, share))
    zone = mix(zone, vec3(0.816, 0.337, 0.310), step(0.9, share))
    let cell = step(0.25, fract((q.x - pad) / 4.0))
    let inside = step(pad, q.x) * step(q.x, bar - pad) * step(abs(q.y - across * 0.5), across * 0.5 - pad)
    let lit = step(q.x, pad + span * self.level)
    col = mix(col, zone, cell * inside * mix(0.10, 1.0, lit))
    let hx = pad + span * self.hold
    let hd = abs(q.x - hx) - 0.75
    let hm = Finish.cover(hd, px) * inside * step(0.002, self.hold)
    let hz = mix(vec3(0.310, 0.498, 0.820), vec3(0.816, 0.337, 0.310), step(0.9, self.hold))
    col = mix(col, hz, hm)
    col = col + hz * (1.0 - smoothstep(0.0, 2.0, hd)) * 0.3 * inside * step(0.002, self.hold) * (1.0 - hm)
    col = mix(col, vec3(0.051, 0.067, 0.110), Finish.band(gd, 0.0, px, px) * 0.9)
    let ga = Finish.cover(gd, px)
    var acc = vec4(col * ga, ga)
    let lip = Finish.ring_out(gd, 0.0, px, px) * step(across * 0.5, q.y) * 0.45
    acc = Finish.over(acc, vec4(lip, lip, lip, lip))
    // The clip lamp: a 5 point bead of dark glass (not a hole), a white
    // hairline on its crown and a dark rim; lit, the same bead in red.
    let lc = vec2(along - 3.0, across * 0.5)
    let lr = min(2.5, across * 0.5)
    let ld = length(q - lc) - lr
    var lcol = mix(vec3(0.278, 0.294, 0.333), vec3(0.816, 0.337, 0.310), self.over)
    lcol = mix(lcol, vec3(0.051, 0.067, 0.110), Finish.band(ld, 0.0, px, px) * 0.6)
    lcol = mix(lcol, vec3(1.0, 1.0, 1.0), Finish.band(ld, px, 2.0 * px, px) * smoothstep(0.1, -0.6, (q.y - lc.y) / lr) * 0.45)
    let la = Finish.cover(ld, px) * self.lamp
    acc = Finish.over(acc, vec4(lcol * la, la))
    return acc * self.opacity
}
mod.widgets.LevelMeter.height = 6.0
mod.widgets.LevelMeterColumn.width = 6.0

// SCROLL BAR. No track: a 6 point glass capsule thumb, its outline and a
// hairline on its upper end, no shadow; the pointer darkens it.
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let v = self.is_vertical
    let along = mix(self.rect_size.x, self.rect_size.y, v)
    let across = mix(self.rect_size.y, self.rect_size.x, v)
    let q = vec2(mix(p.x, p.y, v), mix(p.y, p.x, v))
    let mb = across * 0.5
    let s0 = along * self.norm_scroll + 1.0
    let s1 = along * (self.norm_scroll + self.norm_handle) - 1.0
    let hc = vec2((s0 + s1) * 0.5, mb)
    let hh = vec2(max((s1 - s0) * 0.5, 3.0), 3.0)
    let hd = Material.sd_box(q, hc, hh, 3.0)
    let k = max(self.hover, self.drag)
    let g = -0.04 - 0.04 * k
    var col = lq_ground() + vec3(g, g, g)
    col = mix(col, vec3(0.965, 0.973, 0.988), Finish.band(hd, px, 2.0 * px, px) * (1.0 - smoothstep(hc.x - hh.x + 3.0, hc.x - hh.x + 8.0, q.x)) * 0.9)
    col = mix(col, vec3(0.682, 0.690, 0.714), Finish.band(hd, 0.0, px, px) * mix(0.7, 1.0, k))
    let ha = Finish.cover(hd, px) * mix(0.85, 1.0, k)
    return vec4(col * ha, ha) * self.opacity
}
mod.widgets.ScrollBar.bar_size = 8.0

// SEGMENTED CONTROL. One standing glass capsule round every segment; the
// chosen one is blue glass inside it, with its hairline and no outline.
mod.widgets.SegmentedControlFlat.segment_height = 26.0
mod.widgets.SegmentedControlFlat.segment_padding = 14.0
mod.widgets.SegmentedControlFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = lq_snap(self.rect_pos, vec2(0.0, 0.0), self.rect_size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let s = min(self.rect_size.y, 32.0)
    var acc = lq_cast(pq, c, h, h.y, px, s, 0.36, 1.0, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), 0.32)
    return Finish.over(acc, lq_body(pq, c, h, h.y, px, s, lq_clear(), 1.0, 0.88, 0.95, 1.0, 0.05 * s + px, 1.5, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988)))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = lq_snap(self.rect_pos, vec2(1.0, 1.0), self.rect_size - vec2(1.0, 1.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    return lq_body(p, c, h, h.y, px, self.rect_size.y, lq_blue(), 2.2, 0.8, 1.0, 0.7, 0.05 * self.rect_size.y + px, 1.0, vec4(0.478, 0.561, 0.690, 0.0), vec3(0.957, 0.969, 1.0))
}
mod.widgets.SegmentedControlFlat.draw_text.color = #1c1e22
mod.widgets.SegmentedControlFlat.draw_text.text_style.font_size = 8.75
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style.font_size = 8.75
mod.widgets.SegmentedControlFlat.intent = mod.widgets.BadgeIntent.Primary
mod.widgets.SegmentedControlFlat.palette.on_primary_container = #0d0f14
mod.widgets.SegmentedControl.palette.on_primary_container = #0d0f14
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #0d0f14

// TABS. The strip is one glass capsule lying on the ground; the tab in use
// is marked the way a tab bar is here, by a 1.5 point accent line under
// its word, with a faint lift of the glass; a hairline divider stands
// between the quiet ones.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = lq_snap(self.rect_pos, vec2(0.0, 0.0), vec2(self.rect_size.x, self.rect_size.y - 0.7), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, h.y)
    var acc = lq_body(p, c, h, h.y, px, self.rect_size.y, lq_clear(), 0.6, 0.85, 0.95, 0.8, 0.05 * self.rect_size.y + px, 1.5, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988))
    let ct = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, h.y, p.y - c.y) * 0.25
    return Finish.over(acc, vec4(0.0, 0.0, 0.0, ct))
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5 - vec2(3.0, 3.0)
    let d = Material.sd_box(p, c, h, h.y)
    let a = Finish.cover(d, px) * 0.22
    return vec4(a, a, a, a)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5 - vec2(3.0, 3.0)
    let d = Material.sd_box(p, c, h, h.y)
    let lift = Finish.cover(d, px) * 0.3
    var acc = vec4(lift, lift, lift, lift)
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y - 5.0, px) - self.rect_pos.y
    let ld = Material.sd_box(p, vec2(c.x, yb), vec2(max(h.x - 8.0, 4.0), 0.75), 0.75)
    let la = Finish.cover(ld, px)
    return Finish.over(acc, vec4(vec3(0.278, 0.463, 0.804) * la, la))
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let inset = self.rect_size.y * 0.25
    let a = step(x - px, p.x) * step(p.x, x) * step(inset, p.y) * step(p.y, self.rect_size.y - inset) * 0.6
    return vec4(0.682 * a, 0.690 * a, 0.714 * a, a)
}
// Close and add: 7 point marks at the family's 1.5 point icon stroke.
mod.widgets.Tabs.draw_mark.color = #3d4048
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let e = 2.75
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = e * mix(1.4142, 1.0, self.plus)
    let ax = cos(a) * r
    let ay = sin(a) * r
    let d = min(lq_seg(p, c - vec2(ax, ay), c + vec2(ax, ay)), lq_seg(p, c + vec2(ay, -ax), c + vec2(-ay, ax)))
    let k = Finish.cover(d - 0.75, px) * self.color.w
    return vec4(self.color.rgb * k, k)
}
mod.widgets.Tabs.draw_text.color = #1c1e22
mod.widgets.Tabs.draw_text_active.color = #0d0f14

// RADIO TABS. Glass capsules lying on the ground, lifted by the pointer;
// the one in use is blue glass.
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0), vec4(lq_blue(), self.active), self.active, 0.0, 0.0)
}
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 6.0 bottom: 6.0}
mod.widgets.RadioButtonTabFlat.draw_text.color = #1c1e22
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #0d0f14

// The dock's tabs: the tab in use is a pane of glass rising from the bar
// with its hairline on top and the accent line along its foot; the bar
// ends in a hairline pair.
mod.widgets.Tab.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = lq_snap(self.rect_pos, vec2(0.0, 3.0), vec2(self.rect_size.x, self.rect_size.y + 6.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 6.0)
    let body = lq_body(p, c, h, 6.0, px, 26.0, lq_clear() + vec3(0.02, 0.02, 0.02), 0.5, 0.9, 1.0, 0.7, 1.4, 1.0, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988)) * self.active
    let lift = Finish.cover(d, px) * 0.18 * self.hover * (1.0 - self.active)
    var acc = Finish.over(vec4(lift, lift, lift, lift), body)
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y - 1.0, px) - self.rect_pos.y
    let ld = Material.sd_box(p, vec2(c.x, yb), vec2(max(h.x - 6.0, 4.0), 0.75), 0.75)
    let la = Finish.cover(ld, px) * self.active
    return Finish.over(acc, vec4(vec3(0.278, 0.463, 0.804) * la, la))
}
mod.widgets.Tab.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * 0.18
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.5
    let acc = vec4(0.165 * dk, 0.192 * dk, 0.251 * dk, dk)
    return Finish.over(acc, vec4(lt, lt, lt, lt))
}

// CHIPS. A small glass capsule standing on the ground; pressed, it settles;
// a keyed chip wears the focus ring.
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let ch = min(22.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let b = lq_snap(self.rect_pos, vec2(0.0, dy), vec2(self.rect_size.x, dy + ch), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(pq, c, h, h.y)
    let press = self.down
    let hov = self.hover * (1.0 - press)
    var acc = lq_cast(pq, c, h, h.y, px, ch, 0.3, 1.0 - press, vec3(0.165, 0.192, 0.251), vec3(1.0, 1.0, 1.0), mix(0.3, 0.45, hov) * (1.0 - 0.6 * press))
    let lift = 0.03 * hov - 0.04 * press
    acc = Finish.over(acc, lq_body(pq, c, h, h.y, px, ch, lq_clear() + vec3(lift, lift, lift), 1.0, 0.88, mix(1.0, 0.62, press), 1.0 + 0.5 * press, 0.06 * ch + px, 1.0, vec4(0.682, 0.690, 0.714, 0.9), vec3(0.965, 0.973, 0.988)))
    return Finish.over(acc, lq_focus(d, px, self.keyed))
}
mod.widgets.ChipFlat.draw_text.color = #1c1e22
mod.widgets.ChipFlat.draw_text.text_style.font_size = 8.25

// SURFACES. A panel is a thick slab of glass on the ground: its outline, a
// bright-dark-bright triple line along its top edge leaning a little cyan
// as a thick slab's edge does, an exit line along its foot, a face just
// lighter than the ground falling gently to its foot, and a soft cool
// shadow. The large panel wears a small clear bead in each corner. The
// sunken panel is a tray cut into the ground: its top edge in shade, a
// white lip along its foot. Both carry the ground's own grain.
let lq_panel = fn(pq: vec2, size: vec2, org: vec2, px: float, r: float, raised: float, sunken: float, lift: float, beads: float) -> vec4 {
    let b = lq_snap(org, vec2(0.0, 0.0), size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let rr = min(r, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    let n = lq_norm(pq, c, h, rr)
    let t = -d
    let up = smoothstep(0.15, 0.85, -n.y)
    let low = smoothstep(0.3, 0.9, n.y)
    let right = clamp(n.x, 0.0, 1.0)
    // The raised slab's shadow: 5 points down, a 7 point blur, and a tight
    // contact line under the foot.
    let sh = Finish.drop(pq, c + vec2(0.5, 0.0), h - vec2(2.0, 2.0), max(rr - 2.0, 0.0), vec2(0.0, 5.0 + lift), 6.0) * (0.13 + 0.03 * lift) * raised
    var acc = vec4(vec3(0.165, 0.192, 0.251) * sh, sh)
    let ct = Finish.drop(pq, c, h, rr, vec2(0.0, 0.8), 0.7) * 0.3 * smoothstep(c.y, c.y + h.y, pq.y) * raised
    acc = Finish.over(acc, vec4(0.0, 0.0, 0.0, ct))
    acc = acc * (1.0 - Finish.cover(d, px))
    // The slab: the ground two hundredths up, three up at the top and three
    // down at the foot over its first and last 60 points.
    let ft = smoothstep(0.0, 60.0, pq.y - b.y)
    let fb = smoothstep(0.0, 60.0, b.w - pq.y)
    let g = 0.02 + 0.03 * (1.0 - ft) - 0.03 * (1.0 - fb) + 0.006 * lift
    var col = lq_ground() + vec3(g, g, g + 0.006)
    col = col + vec3(lq_grain(org + pq, px))
    // A cool shade just inside the rim, heavier to the lower right.
    col = mix(col, vec3(0.165, 0.192, 0.251), (1.0 - smoothstep(0.0, 3.0, t)) * 0.06 * mix(0.6, 1.4, max(low, right)))
    let edge = vec3(0.729, 0.839, 0.882)
    let hi = mix(vec3(0.965, 0.973, 0.988), edge, 0.3)
    col = mix(col, hi, Finish.band(d, px, 2.0 * px, px) * max(up, 0.35) * 0.95)
    col = mix(col, mix(vec3(0.600, 0.624, 0.671), edge * 0.7, 0.3), Finish.band(d, 2.0 * px, 3.0 * px, px) * up * 0.8)
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, 3.0 * px, 4.0 * px, px) * up * 0.4)
    col = mix(col, mix(vec3(0.945, 0.957, 0.980), edge, 0.3), Finish.band(d, px, 2.5 * px, px) * low * 0.9)
    col = mix(col, vec3(0.620, 0.631, 0.659), Finish.band(d, 0.0, px, px) * 0.9)
    // The beads: 4 point clear glass, 7 points in from each corner, a white
    // point on the upper left, a faint shade to the lower right.
    let bx = min(pq.x - b.x, b.z - pq.x)
    let by = min(pq.y - b.y, b.w - pq.y)
    let bq = vec2(bx, by) - vec2(7.0, 7.0)
    let bsx = step(c.x, pq.x) * 2.0 - 1.0
    let bsy = step(c.y, pq.y) * 2.0 - 1.0
    let bp = vec2(bq.x * -bsx, bq.y * -bsy)
    let bd = length(bq) - 2.0
    let bsh = (1.0 - smoothstep(-0.5, 1.2, length(bp - vec2(0.6, 0.8)) - 2.0)) * 0.18 * beads * (1.0 - Finish.cover(bd, px))
    col = mix(col, vec3(0.165, 0.192, 0.251), bsh)
    var bc = mix(lq_ground() + vec3(0.06, 0.06, 0.066), lq_ground() - vec3(0.02, 0.02, 0.02), clamp(bp.y / 4.0 + 0.5, 0.0, 1.0))
    bc = mix(bc, vec3(1.0, 1.0, 1.0), Finish.cover(length(bp - vec2(-0.7, -0.7)) - 0.5, px))
    bc = mix(bc, vec3(0.620, 0.631, 0.659), Finish.band(bd, 0.0, px, px) * 0.6)
    col = mix(col, bc, Finish.cover(bd, px) * beads)
    // The tray: the ground three hundredths down, the ground's shade
    // falling in over its top edge, a white lip under its foot.
    var tc = lq_ground() - vec3(0.025, 0.025, 0.02)
    tc = tc + vec3(lq_grain(org + pq, px))
    let ins = Finish.inset(pq, c, h, rr, vec2(0.0, 1.5), 2.0)
    tc = mix(tc, vec3(0.165, 0.192, 0.251), ins * 0.22)
    tc = mix(tc, vec3(0.427, 0.443, 0.478), Finish.band(d, 0.0, px, px) * up * 0.45)
    tc = mix(tc, vec3(0.580, 0.600, 0.635), Finish.band(d, 0.0, px, px) * (1.0 - up) * 0.35)
    col = mix(col, tc, sunken)
    let a = Finish.cover(d, px)
    acc = Finish.over(acc, vec4(col * a, a))
    let lip = Finish.ring_out(d, 0.0, px, px) * low * 0.8 * sunken
    return Finish.over(acc, vec4(lip, lip, lip, lip))
}
mod.widgets.RoundedView.clip_x = false
mod.widgets.RoundedView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 16.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    // Beads only on a large slab: a small panel would read as screwed down.
    let big = step(320.0, self.rect_size.x) * step(120.0, self.rect_size.y)
    return lq_panel(pq, self.rect_size, self.rect_pos, px, mix(12.0, 10.0, self.sunken), 1.0 - self.sunken, self.sunken, 0.0, big * (1.0 - self.sunken))
}

// A card is the slab too; a pressable one lifts a little under the pointer.
mod.widgets.Card.radius = 12.0
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 16.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let lift = self.hover * (1.0 - self.down)
    let outlined = step(0.01, self.border_size)
    let raised = max(clamp(self.shadow_radius / 4.0, 0.0, 1.0), 0.6 * lift) * (1.0 - self.down)
    let sunk = (1.0 - clamp(self.shadow_radius / 4.0, 0.0, 1.0)) * (1.0 - outlined) * 0.7 * (1.0 - lift)
    return lq_panel(pq, self.rect_size, self.rect_pos, px, self.border_radius, max(raised, 0.35 * outlined), sunk, lift, 0.0)
}

// The rounded view keeps whatever colour it is given, with a true corner,
// the glass hairline along its top and its border if it has one.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var fill = self.color
    if self.color_2.x > -0.5 {
        let dir = if self.gradient_fill_horizontal > 0.5 self.pos.x else self.pos.y
        fill = mix(self.color, self.color_2, dir)
    }
    let lower = vec2(self.border_inset.x, self.border_inset.y)
    let upper = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lower + upper) * 0.5
    let h = max((upper - lower) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px) * fill.w
    var col = fill.rgb
    let top = 1.0 - smoothstep(0.0, r + 2.0, p.y - lower.y)
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, 0.0, px, px) * top * 0.45 * step(0.5, Finish.lum(fill.rgb)))
    var acc = vec4(col * a, a)
    let bd = Finish.band(d, 0.0, max(self.border_size, 0.0), px) * step(0.001, self.border_size) * self.border_color.w
    return Finish.over(acc, vec4(self.border_color.rgb * bd, bd))
}

// LIST ROWS. Rows of 24, no separators. Under the pointer the row brightens
// a little; the chosen row is a pane of blue glass at a fifth, with its
// own hairline on top.
mod.widgets.ListItemOne.height = 24.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 12.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let b = lq_snap(self.rect_pos, vec2(3.0, 1.0), self.rect_size - vec2(12.0, 1.0), px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 6.0)
    let en = 1.0 - self.disabled
    let a = Finish.cover(d, px)
    let lift = a * (0.2 * self.hover - 0.06 * self.down) * en * (1.0 - self.selected)
    var acc = vec4(max(lift, 0.0), max(lift, 0.0), max(lift, 0.0), abs(lift))
    let sa = a * 0.24 * self.selected
    acc = Finish.over(acc, vec4(lq_accent() * sa, sa))
    let top = Finish.band(d, 0.0, px, px) * smoothstep(0.1, -0.5, (p.y - c.y) / max(h.y, 1.0)) * 0.55 * self.selected
    acc = Finish.over(acc, vec4(top, top, top, top))
    let bot = Finish.band(d, 0.0, px, px) * smoothstep(0.1, 0.8, (p.y - c.y) / max(h.y, 1.0)) * 0.3 * self.selected
    return Finish.over(acc, vec4(0.204 * bot, 0.282 * bot, 0.431 * bot, bot))
}
mod.widgets.ListItem.draw_text.color = #1c1e22

// BADGE. A small pill of clear glass lying on the ground, dark digits; a
// coloured badge keeps its colour behind the same rim.
let lq_badge = fn(pq: vec2, size: vec2, org: vec2, px: float, fill: vec4, radius: float) -> vec4 {
    let b = lq_snap(org, vec2(0.0, 0.0), size, px)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let r = min(radius, min(h.x, h.y))
    let light = step(0.6, Finish.lum(fill.rgb))
    let face = mix(fill.rgb, lq_clear() + vec3(0.02, 0.02, 0.02), light)
    return lq_body(pq, c, h, r, px, size.y, face, 1.0, mix(1.0, 0.9, light) * fill.w, 1.0, 1.0, 0.06 * size.y + px, 1.0, vec4(0.620, 0.631, 0.659, 0.9), vec3(0.965, 0.973, 0.988))
}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_badge(pq, self.rect_size, self.rect_pos, px, self.color, self.radius)
}
mod.widgets.Badge.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_badge(pq, self.rect_size, self.rect_pos, px, self.color, self.radius)
}
mod.widgets.BadgePalette.neutral = #d6d8dd
mod.widgets.BadgePalette.on_neutral = #1c1e22
mod.widgets.BadgeFlat.draw_text.text_style.font_size = 7.5
mod.widgets.Badge.draw_text.text_style.font_size = 7.5

// THE OPEN LIST. A slab of glass, radius 10; the row under the pointer is
// a pane of blue glass at a quarter with its hairline; the chosen row
// carries a black check at its right end.
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return lq_panel(pq, self.rect_size, self.rect_pos, px, 10.0, 0.0, 0.0, 1.0, 0.0)
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5 - vec2(2.0, 1.0)
    let d = Material.sd_box(p, c, h, 6.0)
    let k = self.hover * (1.0 - self.disabled)
    let a = Finish.cover(d, px) * 0.25 * k
    var acc = vec4(lq_accent() * a, a)
    let top = Finish.band(d, 0.0, px, px) * smoothstep(0.1, -0.5, (p.y - c.y) / max(h.y, 1.0)) * 0.5 * k
    acc = Finish.over(acc, vec4(top, top, top, top))
    let cx = self.rect_size.x - 12.0
    let cy = c.y
    let ck = Finish.cover(min(lq_seg(p, vec2(cx - 3.5, cy), vec2(cx - 1.0, cy + 2.5)), lq_seg(p, vec2(cx - 1.0, cy + 2.5), vec2(cx + 3.5, cy - 2.5))) - 0.75, px) * self.active
    return Finish.over(acc, vec4(vec3(0.110, 0.118, 0.133) * ck, ck))
}
mod.widgets.PopupMenuItem.draw_text.color_active = #0d0f14

// Rules between groups: the seam of the family, one device pixel of shade
// over one of light, never a grey line.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let dk = step(y - px, p.y) * (1.0 - step(y, p.y)) * 0.12
    let lt = step(y, p.y) * (1.0 - step(y + px, p.y)) * 0.4
    return Finish.over(vec4(0.165 * dk, 0.192 * dk, 0.251 * dk, dk), vec4(lt, lt, lt, lt))
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let dk = step(x - px, p.x) * (1.0 - step(x, p.x)) * 0.12
    let lt = step(x, p.x) * (1.0 - step(x + px, p.x)) * 0.4
    return Finish.over(vec4(0.165 * dk, 0.192 * dk, 0.251 * dk, dk), vec4(lt, lt, lt, lt))
}

// The spinner turns on the pass clock of its own; it keeps the stock face
// and takes the accent.
mod.widgets.SpinnerFlat.draw_bg.color = #4f7fd1

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.BurgerButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}

// THE GROUND. Plain grey, lit like a studio backdrop: a broad soft pool of
// light from the upper left, the long fall to the foot, and the dither.
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var col = lq_ground()
    let fall = 0.02 - 0.05 * self.pos.y
    let pool = 1.0 - smoothstep(0.0, 1.0, length((self.pos - vec2(0.2, 0.0)) * vec2(0.9, 1.2)))
    let g = fall + 0.018 * pool
    col = col + vec3(g, g, g + 0.003 * pool)
    col = col + vec3(lq_grain(self.rect_pos + p, px))
    return vec4(col, 1.0)
}

// Every held state is written as a plain value that cuts in at once (the
// library writes some as snap() values, which a state held as a default --
// the states page -- never applies). Live, the cut is the same as the snap.
mod.widgets.ButtonFlat.animator.hover.on.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.ButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.ButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.CheckBoxFlat.animator.hover.down.from = {all: Snap}
mod.widgets.CheckBoxFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.RadioButtonFlat.animator.hover.down.from = {all: Snap}
mod.widgets.RadioButtonFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.on.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.TextInputFlat.animator.hover.down.from = {all: Snap}
mod.widgets.TextInputFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.on.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.on.apply = {draw_bg: {down: 0.0 hover: 1.0} draw_text: {down: 0.0 hover: 1.0}}
mod.widgets.DropDownFlat.animator.hover.down.from = {all: Snap}
mod.widgets.DropDownFlat.animator.hover.down.apply = {draw_bg: {down: 1.0 hover: 1.0} draw_text: {down: 1.0 hover: 1.0}}

// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Twenty-six, the row the buttons stand in; a
// capsule corner, half of it.
let field_height = 26.0
let field_pad_v = 6.0
let field_radius = 13.0
let field_border = 0.67

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #cfd0d4
true
