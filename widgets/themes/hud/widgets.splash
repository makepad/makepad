// ---------------------------------------------------------------------------
// PROGRESS. The outline, a device pixel of ground, the well, and the fill
// in the intent's ink with a bright leading pixel and a short bloom that
// crosses the frame. The unknown amount is the family's hatch held still:
// 45 degree hairlines across the well (a face may not read the pass clock,
// so it does not sweep).
let h_hues = fn(i: float) -> vec3 {
    var h = vec3(0.212, 0.784, 0.863)
    if i > 0.5 { h = vec3(0.373, 0.878, 0.627) }
    if i > 1.5 { h = vec3(0.945, 0.937, 0.227) }
    if i > 2.5 { h = vec3(1.0, 0.376, 0.408) }
    if i > 3.5 { h = vec3(0.212, 0.784, 0.863) }
    if i > 4.5 { h = vec3(0.435, 0.663, 0.702) }
    return h
}
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    let o = self.rect_pos
    let hue = h_hues(self.intent)
    let th = min(max(self.thickness, 6.0), self.rect_size.y)
    let y0 = Finish.snap(o.y + (self.rect_size.y - th) * 0.5, px) - o.y
    let y1 = y0 + Finish.snap(th, px)
    let x0 = Finish.snap(o.x + self.rect_size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + self.rect_size.x * self.end, px) - o.x
    let lo = vec2(x0, y0)
    let hi = vec2(x1, y1)
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    let inside = Finish.cover(d, px) * self.track
    var out = vec4(h_well() * inside, inside)
    out = mix(out, vec4(h_ink3(ny, h_side(), h_foot(), h_foot() * 0.85), 1.0), Finish.band(d, 0.0, px, px) * self.track)
    let fi = d + 2.0 * px
    if self.value >= 0.0 {
        let xv = mix(x0 + 2.0 * px, x1 - 2.0 * px, clamp((self.value - self.start) / max(self.end - self.start, 0.0001), 0.0, 1.0))
        let fd = max(fi, p.x - xv)
        let fa = Finish.cover(fd, px) * step(x0 + 2.5 * px, xv)
        let lead = step(xv - px, p.x)
        let g = h_glow(fd, 0.18, 2.6) * (1.0 - fa) * step(p.x, xv + 2.0)
        out = h_add(out, h_halo_ink(fd) * (hue / vec3(0.212, 0.784, 0.863)) * 0.5 + hue * 0.1, g)
        out = mix(out, vec4(mix(hue, mix(hue, vec3(1.0, 1.0, 1.0), 0.45), lead), 1.0), fa)
    } else {
        let u = p.x + (p.y - y0)
        let pitch = 6.0 * 1.4142
        let hl = Finish.cover(abs(fract(u / pitch) * pitch - pitch * 0.5) - 0.5 * px * 1.4142, px)
        out = mix(out, vec4(hue * 0.45, 1.0), hl * Finish.cover(fi, px))
    }
    return out * self.opacity
}

// RINGS, ARCS AND GAUGES. The family's ring gauge: a slim stroke with
// square ends, round(0.07 D) device pixels with D in points (2 at 24
// points, 3 at 48, at most 6), the unlit arc #0b2c34 under it, the lit arc
// in the accent (an intent's ink only where a caller sets one) with a
// bright device pixel at its head, and no halo. A ring sweeps 270 degrees
// from the lower left; where there is room, 21 ticks in the dim line stand
// inside it, every fifth a little longer. The unknown amount is a still
// quarter arc fading toward its tail (a face may not read the pass clock).
let h_ang = fn(q: vec2) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    return a
}
// Distance to the part f0..f1 of a ring (centre radius rc, stroke w), cut
// square at both ends; f is the point's fraction along the sweep.
let h_ring_seg = fn(rl: float, f: float, f0: float, f1: float, rc: float, w: float, sweep: float) -> float {
    let dr = abs(rl - rc) - w * 0.5
    let da = max(f0 - f, f - f1) * sweep * rl
    return max(dr, da)
}
let h_ring_stroke = fn(dia: float, px: float) -> float {
    return clamp(floor(0.07 * dia + 0.5), 2.0, 6.0) * px
}
let h_ring_ticks = fn(rl: float, f: float, f0: float, f1: float, r1: float, rad: float, sweep: float, px: float) -> vec2 {
    let tq = f * 20.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * sweep / 20.0 * rl
    let major = step(fract(ti / 5.0 + 0.01), 0.05)
    let r0 = r1 - mix(0.06, 0.10, major) * rad
    let tk = Finish.cover(tx - 0.5 * px, px) * step(r0, rl) * step(rl, r1) * step(-0.5, ti) * step(ti, 20.5) * step(f0 - 0.001, ti / 20.0) * step(ti / 20.0, f1 + 0.001)
    return vec2(tk, major)
}
let h_ring = fn(q: vec2, rad: float, inset: float, px: float, sweep: float, dir: float, f0: float, f1: float, value: float, ink: vec3, track: float, ticks: float) -> vec4 {
    let w = h_ring_stroke(2.0 * rad, px)
    let rc = rad - inset - w * 0.5 - px
    let rl = length(q)
    let a0 = (6.2831853 - sweep) * 0.5
    var f = (h_ang(q) - a0) / max(sweep, 0.001)
    f = mix(f, 1.0 - f, step(dir, 0.0))
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let tk = h_ring_ticks(rl, f, f0, f1, rc - w * 0.5 - 2.0 * px, rad, sweep, px)
    out = mix(out, vec4(mix(h_dim(), h_foot(), tk.y * 0.5), 1.0), tk.x * ticks)
    let td = h_ring_seg(rl, f, f0, f1, rc, w, sweep)
    out = mix(out, vec4(0.043, 0.173, 0.204, 1.0), Finish.cover(td, px) * track)
    if value >= 0.0 {
        let v = clamp(value, f0, f1)
        let on = step(0.0005, v - f0)
        let ld = h_ring_seg(rl, f, f0, v, rc, w, sweep)
        let head = step((v - f) * sweep * rl, px)
        let lit = mix(ink, mix(ink, vec3(1.0, 1.0, 1.0), 0.45), head)
        out = mix(out, vec4(lit, 1.0), Finish.cover(ld, px) * on)
    } else {
        let qe = f0 + 0.25 * (f1 - f0)
        let ld = h_ring_seg(rl, f, f0, qe, rc, w, sweep)
        let k = clamp((f - f0) / max(qe - f0, 0.001), 0.0, 1.0)
        out = mix(out, vec4(ink * mix(0.25, 1.0, k * k), 1.0), Finish.cover(ld, px))
    }
    return out
}
mod.widgets.ProgressRingFlat.draw_bg.sweep = 4.712389
mod.widgets.ProgressRingFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = vec2(self.rect_size.x * 0.5, self.rect_size.y * self.center_y)
    let rad = min(self.rect_size.x * 0.5, self.rect_size.y * self.center_y)
    let ink = mix(h_hues(self.intent), h_foot(), step(4.5, self.intent))
    let ticks = step(44.0, 2.0 * rad) * step(self.inset, 0.01)
    return h_ring(p - c, rad, self.inset, px, self.sweep, self.direction, self.start, self.end, self.value, ink, self.track, ticks) * self.opacity
}
// Nested rings are one reading each, in the one accent: the unlit arcs
// keep them apart, not three hues.
mod.widgets.ActivityRings.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = vec2(self.rect_size.x * 0.5, self.rect_size.y * self.center_y)
    let rad = min(self.rect_size.x * 0.5, self.rect_size.y * self.center_y)
    let ink = mix(h_acc(), h_foot(), step(4.5, self.intent))
    return h_ring(p - c, rad, self.inset, px, self.sweep, self.direction, self.start, self.end, self.value, ink, self.track, 0.0) * self.opacity
}

// The gauge: the same ring over 270 degrees, lit in the accent to the
// warning mark, caution yellow to the critical one, the red role above;
// the unreached warning and critical parts keep a fifth of their ink.
// The needle is a device pixel of the text ink to just inside the ticks
// with a bright 2 by 2 tip, on a 3 point hollow square pivot. Laid flat, a
// 6 point bar in the progress bar's frame with a needle across it.
let h_zone = fn(f: float, warn: float, crit: float) -> vec3 {
    var z = vec3(0.212, 0.784, 0.863)
    if f > warn {
        z = vec3(0.945, 0.937, 0.227)
    }
    if f > crit {
        z = vec3(1.0, 0.376, 0.408)
    }
    return z
}
let h_gauge_arc = fn(q: vec2, rad: float, px: float, sweep: float, v: float, warn: float, crit: float, needle: float) -> vec4 {
    let w = h_ring_stroke(2.0 * rad, px)
    let rc = rad - w * 0.5 - px
    let rl = length(q)
    let a0 = (6.2831853 - sweep) * 0.5
    let f = (h_ang(q) - a0) / max(sweep, 0.001)
    let z = h_zone(f, warn, crit)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let r1 = rc - w * 0.5 - 2.0 * px
    let tk = h_ring_ticks(rl, f, 0.0, 1.0, r1, rad, sweep, px)
    out = mix(out, vec4(mix(h_dim(), h_foot(), tk.y * 0.5), 1.0), tk.x)
    let td = h_ring_seg(rl, f, 0.0, 1.0, rc, w, sweep)
    let unlit = mix(vec3(0.043, 0.173, 0.204), z * 0.2, step(warn, f))
    out = mix(out, vec4(unlit, 1.0), Finish.cover(td, px))
    let ld = h_ring_seg(rl, f, 0.0, v, rc, w, sweep)
    let head = step((v - f) * sweep * rl, px)
    out = mix(out, vec4(mix(z, mix(z, vec3(1.0, 1.0, 1.0), 0.45), head), 1.0), Finish.cover(ld, px) * step(0.001, v))
    let av = a0 + v * sweep
    let dir = vec2(0.0 - sin(av), cos(av))
    let tip = dir * (r1 - 0.12 * rad)
    let nd = h_seg(q, dir * 2.5, tip)
    let pv = abs(max(abs(q.x), abs(q.y)) - 1.5 + 0.5 * px) - 0.5 * px
    out = mix(out, vec4(0.722, 0.933, 0.961, 1.0), Finish.cover(min(nd - 0.5 * px, pv), px) * needle)
    let sq = max(abs(q.x - tip.x), abs(q.y - tip.y)) - px
    out = mix(out, vec4(h_bright(), 1.0), Finish.cover(sq, px) * needle)
    return out
}
let h_gauge_bar = fn(p: vec2, o: vec2, s: vec2, px: float, v: float, warn: float, crit: float, needle: float) -> vec4 {
    let bh = Finish.snap(min(6.0, s.y), px)
    let y0 = Finish.snap(o.y + (s.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x, px) - o.x, y0)
    let hi = vec2(floor((o.x + s.x) / px) * px - o.x, y0 + bh)
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 0.0)
    let f = clamp((p.x - lo.x) / max(hi.x - lo.x, 1.0), 0.0, 1.0)
    let z = h_zone(f, warn, crit)
    let inside = Finish.cover(d, px)
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    var out = vec4(h_well() * inside, inside)
    out = mix(out, vec4(h_ink3(ny, h_side(), h_foot(), h_foot() * 0.85), 1.0), Finish.band(d, 0.0, px, px))
    let fi = d + 2.0 * px
    let xv = mix(lo.x + 2.0 * px, hi.x - 2.0 * px, v)
    out = mix(out, vec4(z * 0.2, 1.0), Finish.cover(fi, px) * step(warn, f) * step(xv, p.x))
    out = mix(out, vec4(z, 1.0), Finish.cover(max(fi, p.x - xv), px) * step(0.001, v))
    let nx = Finish.snap(o.x + xv, px) - o.x
    let nl = Finish.cover(abs(p.x - nx - 0.5 * px) - 0.5 * px, px) * step(lo.y - 4.0, p.y) * step(p.y, hi.y + 4.0)
    out = mix(out, vec4(0.722, 0.933, 0.961, 1.0), nl * needle)
    let sq = max(abs(p.x - nx - 0.5 * px), abs(p.y - lo.y + 4.0)) - px
    return mix(out, vec4(h_bright(), 1.0), Finish.cover(sq, px) * needle)
}
mod.widgets.Gauge.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let v = clamp(self.value, 0.0, 1.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if self.linear > 0.5 {
        out = h_gauge_bar(p, self.rect_pos, self.rect_size, px, v, self.zone_warn, self.zone_critical, self.needle)
    } else {
        let c = self.rect_size * 0.5
        let rad = min(self.rect_size.x, self.rect_size.y) * 0.5
        out = h_gauge_arc(p - c, rad, px, self.sweep, v, self.zone_warn, self.zone_critical, self.needle)
    }
    return out * self.opacity
}
mod.widgets.Gauge.draw_range.color = #52868e

// LEVEL METERS. A cell ladder in the frame: 3 point cells with a 1 point
// gap, the accent up to 80 %, caution yellow to 90 %, the red role above;
// an unlit cell keeps 8 % of its ink; the held peak burns bright; the over
// lamp stands beside the ladder.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * self.rect_size
    let along = mix(self.rect_size.x, self.rect_size.y, self.vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.vertical)
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.vertical), mix(p0.y, p0.x, self.vertical))
    let lamp_room = self.lamp * (self.lamp_size + self.lamp_gap)
    let bar = max(4.0, along - lamp_room)
    let lo = vec2(0.0, 0.0)
    let hi = vec2(Finish.snap(bar, px), Finish.snap(across, px))
    let d = Material.sd_box(p, hi * 0.5, hi * 0.5, 0.0)
    let inside = Finish.cover(d, px)
    var out = vec4(h_well() * inside, inside)
    out = mix(out, vec4(h_foot(), 1.0), Finish.band(d, 0.0, px, px))
    let pad = 3.0 * px
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.0
    let n = max(floor((span + 1.0) / pitch), 1.0)
    let ci = floor((p.x - pad) / pitch)
    let cx0 = pad + ci * pitch
    let share = (ci + 0.5) / n
    var hue = vec3(0.212, 0.784, 0.863)
    if share > 0.8 {
        hue = vec3(0.945, 0.937, 0.227)
    }
    if share > 0.9 {
        hue = vec3(1.0, 0.376, 0.408)
    }
    let cell = Material.sd_box(p, vec2(cx0 + 1.5, across * 0.5), vec2(1.5, across * 0.5 - pad), 0.0)
    let inbar = step(0.0, ci) * step(ci, n - 1.0)
    let lit = step(share, self.level)
    let held = step(abs(share - self.hold), 0.5 / n) * step(0.002, self.hold)
    let k = max(lit, held)
    let ink = mix(hue * 0.08 + h_well(), mix(hue, mix(hue, vec3(1.0, 1.0, 1.0), 0.4), held), k)
    out = mix(out, vec4(ink, 1.0), Finish.cover(cell, px) * inbar)
    if self.lamp > 0.5 {
        let lc = vec2(bar + self.lamp_gap + self.lamp_size * 0.5, across * 0.5)
        let ld = Material.sd_box(p, lc, vec2(self.lamp_size * 0.5, across * 0.5), 0.0)
        let on = step(0.5, self.over)
        var lcol = mix(vec3(0.08, 0.03, 0.035), vec3(1.0, 0.376, 0.408), on)
        out = mix(out, vec4(lcol, 1.0), Finish.cover(ld, px))
        out = mix(out, vec4(mix(vec3(0.24, 0.10, 0.12), vec3(1.0, 0.6, 0.62), on), 1.0), Finish.band(ld, 0.0, px, px))
    }
    return out * self.opacity
}

// SCROLL BARS. A dim hairline track with end ticks; the thumb a 2 point
// accent bar at 0.6, full and 3 points wide under the hand.
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * self.rect_size
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    let p = vec2(mix(p0.x, p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let o = mix(self.rect_pos.y, self.rect_pos.x, self.is_vertical)
    let mid = Finish.snap(o + across * 0.5, px) - o
    let rail = Finish.cover(abs(p.y - mid - 0.5 * px) - 0.5 * px, px) * step(2.0, p.x) * step(p.x, along - 2.0)
    var out = vec4(h_dim() * rail, rail)
    let ends = Finish.cover(abs(abs(p.x - along * 0.5) - (along * 0.5 - 2.0)) - 0.5 * px, px) * step(abs(p.y - mid - 0.5 * px), 1.5)
    out = mix(out, vec4(h_foot(), 1.0), ends)
    let a = along * self.norm_scroll
    let b = a + along * self.norm_handle
    let warm = max(self.hover, self.drag)
    let w = mix(1.0, 1.5, warm)
    let d = Material.sd_box(p, vec2((a + b) * 0.5, mid + 0.5 * px), vec2(max((b - a) * 0.5 - 1.0, 2.0), w), 0.0)
    out = mix(out, vec4(h_acc() * mix(0.6, 1.0, warm), 1.0), Finish.cover(d, px))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// TABS. A dim baseline under the strip; a quiet tab is its dim title and
// nothing else; the pointer lifts its face a little; the tab in use has a
// lifted face, corner brackets, a 2 point accent underline with its short
// bloom and a pale pixel line under it.
let h_tab = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, focus: float, active: float, down: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let inside = step(lo.x, p.x) * step(p.x, hi.x) * step(lo.y, p.y) * step(p.y, hi.y)
    let wash = (0.45 * hover * (1.0 - active) + 0.9 * active) * inside
    var face = mix(vec3(0.051, 0.122, 0.153), vec3(0.063, 0.149, 0.184), active)
    face = mix(face, vec3(0.055, 0.184, 0.216), down * (1.0 - active))
    var out = vec4(face * wash, wash)
    let br = h_brackets(p, lo, hi - vec2(0.0, 4.0 * px), 5.0, px) * max(active, hover * 0.6)
    out = mix(out, vec4(mix(h_foot(), h_side(), active), 1.0), br)
    // The underline: three device pixels of accent, one pale pixel below.
    let ul = step(hi.y - 4.0 * px, p.y) * step(p.y, hi.y - px) * step(lo.x, p.x) * step(p.x, hi.x) * active
    let pale = step(hi.y - px, p.y) * step(p.y, hi.y) * step(lo.x, p.x) * step(p.x, hi.x) * active
    let ud = max(max(lo.x - p.x, p.x - hi.x), max(hi.y - 4.0 * px - p.y, 0.0))
    // The underline is a lit line of the design: a bloom the eye can see,
    // about 30 % one device pixel out, 15 % at 2 points, gone at 5.
    let g = h_glow(ud, 0.32 * active, 5.0) * (1.0 - ul) * (1.0 - pale) * step(p.y, hi.y)
    out = h_add(out, h_halo_ink(ud), g)
    out = mix(out, vec4(h_acc(), 1.0), ul)
    out = mix(out, vec4(0.373, 0.561, 0.592, 1.0), pale)
    // Focus brackets stand off the box above and at the sides; the lower
    // arms sit on the tab's own last device row, because a strip or a
    // matrix that ends with its tabs clips at their foot.
    return h_focus(out, p, lo, hi - vec2(0.0, 4.0 * px), px, focus * (1.0 - active))
}
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return h_tab(p, self.rect_pos, self.rect_size, px, 0.0, 0.0, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return h_tab(self.pos * self.rect_size, self.rect_pos, self.rect_size, px, 1.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let rail = step(y - px, p.y) * step(p.y, y)
    return vec4(h_foot() * rail, rail)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let l = Finish.cover(abs(p.x - self.rect_size.x * 0.5) - px * 0.5, px) * step(6.0, p.y) * step(p.y, self.rect_size.y - 6.0)
    return vec4(h_dim() * l, l)
}
mod.widgets.Tabs.draw_text.color = #7fb3bc
mod.widgets.Tabs.draw_text_active.color = #e6fdff
mod.widgets.Tabs.draw_text_active.text_style = mod.theme.font_regular{font_size: mod.theme.font_size_p}
mod.widgets.Tabs.draw_mark.color = #52868e

// The dock's tab: the same face.
mod.widgets.Tab.clip_x = false
mod.widgets.Tab.clip_y = false
mod.widgets.Tab.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return h_tab(p, self.rect_pos, self.rect_size, px, self.hover, 0.0, self.active, 0.0)
}
mod.widgets.Tab.draw_text.color = #7fb3bc
mod.widgets.Tab.draw_text.color_hover = #b8eef5
mod.widgets.Tab.draw_text.color_active = #e6fdff

// The radio tab reads as a tab.
mod.widgets.RadioButtonTabFlat.clip_x = false
mod.widgets.RadioButtonTabFlat.clip_y = false
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let live = 1.0 - self.disabled
    // A disabled tab is its dim title and nothing else.
    return h_tab(p, self.rect_pos, self.rect_size, px, self.hover * live, self.focus * live, self.active * live, self.down * live)
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #7fb3bc
mod.widgets.RadioButtonTabFlat.draw_text.color_hover = #b8eef5
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #e6fdff
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #33545b

// SEGMENTED. One frame cut at the top left and the bottom right round the
// row; the chosen segment gets a lifted face and the accent underline.
mod.widgets.SegmentedControl.segment_height = 24.0
mod.widgets.SegmentedControlFlat.segment_height = 24.0
mod.widgets.SegmentedControlFlat.segment_padding = 10.0
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    // Both far edges are floored to a device pixel, so the lower and the
    // right line stay inside the quad.
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(floor((o.x + self.rect_size.x) / px) * px, floor((o.y + self.rect_size.y) / px) * px) - o
    let k = Finish.snap(clamp(0.3 * (hi.y - lo.y), 3.0, 8.0), px)
    let kq = vec4(k, 0.0, k, 0.0)
    let d = Finish.sd_notch(p, (lo + hi) * 0.5, (hi - lo) * 0.5, kq)
    let ny = h_facing(p, lo, hi, kq, px)
    let inside = Finish.cover(d, px)
    var out = vec4(vec3(0.043, 0.102, 0.129) * 0.7 * inside, 0.7 * inside)
    return mix(out, vec4(h_ink3(ny, h_top(), h_side(), h_foot()), 1.0), Finish.band(d, 0.0, px, px))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(2.0 * px, 2.0 * px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(2.0 * px, 2.0 * px)
    let inb = step(lo.x, p.x) * step(p.x, hi.x) * step(lo.y, p.y) * step(p.y, hi.y)
    var out = vec4(vec3(0.063, 0.149, 0.184) * inb, inb)
    let ul = step(hi.y - 3.0 * px, p.y) * inb
    out = mix(out, vec4(h_acc(), 1.0), ul)
    return out
}
mod.widgets.SegmentedControlFlat.draw_text.color = #7fb3bc
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #e6fdff
mod.widgets.SegmentedControlFlat.draw_text_selected.text_style = mod.theme.font_regular{}

// ---------------------------------------------------------------------------
// THE GROUND under everything: the window's own face. The ground ink with
// a faint lift at the centre, a quiet dot grid (one device pixel every 16
// points), a small cross at every fourth node, corner brackets at the
// window's corners, and a one-level dither against banding.
let h_ground = fn(p: vec2, size: vec2, px: float) -> vec3 {
    var col = vec3(0.012, 0.035, 0.059)
    let hd = max(length(size * 0.5), 1.0)
    let r = length(p - size * vec2(0.5, 0.42)) / hd
    col = col + vec3(0.006, 0.020, 0.026) * (1.0 - smoothstep(0.0, 0.85, r))
    col = col * (0.99 + 0.02 * (p.y / max(size.y, 1.0)))
    let ix = floor(p.x / px)
    let iy = floor(p.y / px)
    let dot = step(fract(ix / 24.0 + 0.001), 0.01) * step(fract(iy / 24.0 + 0.001), 0.01)
    let mx = ix - 96.0 * floor(ix / 96.0 + 0.5)
    let my = iy - 96.0 * floor(iy / 96.0 + 0.5)
    // Dots and crosses at one strength (+0.05): the 16 point grid reads,
    // and a cross with 2 point arms marks every fourth node without
    // standing out of the grid as a stray tick.
    let cross = max(step(abs(mx), 0.5) * step(abs(my), 3.5), step(abs(my), 0.5) * step(abs(mx), 3.5))
    col = col + vec3(0.030, 0.056, 0.063) * max(dot, cross)
    // Corner brackets 24 points long, 8 points in from each window corner.
    // Counted in device pixels, so each arm is exactly one pixel wide.
    let ins = floor(8.0 / px)
    let arm = floor(24.0 / px)
    let wx = floor(size.x / px) - 1.0 - ins
    let wy = floor(size.y / px) - 1.0 - ins
    let bx = min(ix - ins, wx - ix)
    let by = min(iy - ins, wy - iy)
    let bk = max(step(abs(bx), 0.5) * step(-0.5, by) * step(by, arm), step(abs(by), 0.5) * step(-0.5, bx) * step(bx, arm))
    col = mix(col, vec3(0.114, 0.227, 0.259), bk)
    return col + vec3(1.0, 1.0, 1.0) * Finish.grain(p / px, 1.0 / 255.0)
}
mod.widgets.Window.show_bg = true
mod.widgets.Window.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return vec4(h_ground(self.pos * self.rect_size, self.rect_size, px), 1.0)
}

// DIVIDERS: one dim device pixel with a brighter tick at each end.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let line = step(y - px, p.y) * step(p.y, y)
    let tick = step(min(p.x, self.rect_size.x - p.x), 3.0)
    return vec4(mix(h_dim(), h_foot(), tick) * line, line)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let line = step(x - px, p.x) * step(p.x, x)
    let tick = step(min(p.y, self.rect_size.y - p.y), 3.0)
    return vec4(mix(h_dim(), h_foot(), tick) * line, line)
}

// ---------------------------------------------------------------------------
// SURFACES. A panel is a translucent tint over the ground (the dot grid
// shows through), its top third lifted, in a frame cut at the top left and
// bottom right with a bright run and its bloom on the top line, stepped
// notches on the long sides, a filled accent tab hanging from the top line
// and a pair of marks in the lower left corner. The inset panel is a screen
// well: darker than the ground, lifted at the centre, a neutral grid.
let h_panel = fn(p: vec2, o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let ww = hi.x - lo.x
    let hh = hi.y - lo.y
    let k = Finish.snap(min(12.0, 0.2 * min(ww, hh)), px)
    let kq = vec4(k, 0.0, k, 0.0)
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, kq)
    let yn = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let inside = Finish.cover(d, px)
    var face = vec3(0.039, 0.102, 0.133) + vec3(0.016, 0.026, 0.030) * (1.0 - smoothstep(0.0, 0.3, yn))
    var out = vec4(face * 0.85 * inside, 0.85 * inside)
    let ny = h_facing(p, lo, hi, kq, px)
    let edge = Finish.band(d, 0.0, px, px)
    out = mix(out, vec4(h_ink3(ny, h_top(), h_side(), h_foot()), 1.0), edge)
    // The run and its bloom on the top line.
    let x0 = lo.x + k
    let rl = 0.3 * (ww - k)
    let rx = smoothstep(x0 - px, x0 + 2.0, p.x) * (1.0 - smoothstep(x0 + rl - 10.0, x0 + rl, p.x))
    out = mix(out, vec4(0.749, 0.914, 0.937, 1.0), edge * step(p.y, lo.y + 1.5 * px) * rx)
    let above = 1.0 - smoothstep(lo.y - px, lo.y + px, p.y)
    out = h_add(out, h_halo_ink(d), h_glow(d, 0.40, 4.5) * rx * above * (1.0 - inside))
    out = h_add(out, h_halo_ink(d), h_glow(0.0 - d - px, 0.14, 2.5) * rx * inside * (1.0 - edge) * step(p.y, lo.y + 4.0))
    // Notches: a 20 point step 2 points in on each long side, halfway down.
    let ny0 = c.y
    let side = step(abs(p.y - ny0), 10.0)
    let nl = Finish.cover(abs(p.x - lo.x - 2.0 - 0.5 * px) - 0.5 * px, px) * side
    let nr = Finish.cover(abs(hi.x - p.x - 2.0 - 0.5 * px) - 0.5 * px, px) * side
    let stubs = Finish.cover(abs(abs(p.y - ny0) - 10.0) - 0.5 * px, px) * max(step(p.x, lo.x + 2.5), step(hi.x - 2.5, p.x)) * inside
    out = mix(out, vec4(h_foot(), 1.0), max(max(nl, nr), stubs) * step(40.0, hh))
    // The filled tab: a third of the width, 45 degree ends,
    // two points under the top line at the right, 4 points tall.
    let tw = min(0.36 * ww, 110.0)
    let tx1 = hi.x - 10.0
    let ty0 = lo.y + 2.0
    let tq = p - vec2(tx1 - tw * 0.5, ty0 + 2.0)
    let tab = max(abs(tq.y) - 2.0, abs(tq.x) + (tq.y + 2.0) - tw * 0.5)
    let tf = Finish.cover(tab, px)
    out = h_add(out, h_halo_ink(tab), h_glow(tab, 0.32, 5.0) * (1.0 - tf) * inside)
    out = mix(out, vec4(h_acc(), 1.0), tf)
    // Two marks in the lower left corner.
    let mq = p - vec2(lo.x + 5.0, hi.y - 5.0)
    let m1 = max(abs(mq.x), abs(mq.y)) - 0.75
    let m2 = max(abs(mq.x - 3.5), abs(mq.y)) - 0.75
    out = mix(out, vec4(h_acc() * 0.72, 1.0), Finish.cover(min(m1, m2), px) * step(40.0, hh))
    return out
}
let h_screen = fn(p: vec2, o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let kq = vec4(4.0, 0.0, 0.0, 0.0)
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, kq)
    let hd = max(length((hi - lo) * 0.5), 1.0)
    let r = length(p - c) / hd
    var col = vec3(0.008, 0.027, 0.043) + vec3(0.012, 0.030, 0.036) * (1.0 - smoothstep(0.0, 1.0, r))
    // The neutral screen grid, every 26 points from the centre.
    let gq = p - c
    let gx = abs(gq.x - 26.0 * floor(gq.x / 26.0 + 0.5))
    let gy = abs(gq.y - 26.0 * floor(gq.y / 26.0 + 0.5))
    let grid = max(Finish.cover(gx - 0.5 * px, px), Finish.cover(gy - 0.5 * px, px))
    col = col + vec3(0.050, 0.055, 0.058) * grid
    let inside = Finish.cover(d, px)
    var out = vec4(col * inside, inside)
    out = mix(out, vec4(0.03, 0.06, 0.075, 1.0), Finish.band(d, px, 2.0 * px, px) * step(p.y, lo.y + 2.5 * px))
    let ny = h_facing(p, lo, hi, kq, px)
    return mix(out, vec4(h_ink3(ny, h_side(), h_foot(), h_foot()), 1.0), Finish.band(d, 0.0, px, px))
}
mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    if self.sunken > 0.5 {
        return h_screen(p, self.rect_pos, self.rect_size, px)
    }
    return h_panel(p, self.rect_pos, self.rect_size, px)
}

// Cards are tiles: a dim square frame with bright corner brackets, the
// panel's translucent face, a small filled tab under the top line at the
// right, and the dark contact line along the foot.
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = self.shadow_radius
    let p = self.pos * self.rect_size3 - vec2(m, m) - self.rect_shift
    let o = self.rect_pos
    let s = self.rect_size
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    let inside = Finish.cover(d, px)
    let hv = self.hover
    // The appearance the card hands in: Outlined draws a line (a border
    // size), Filled has the highest container fill, Elevated the low one.
    let outlined = step(0.01, self.border_size)
    let filled = step(0.1, Finish.lum(self.color.rgb)) * (1.0 - outlined)
    var face = vec3(0.039, 0.102, 0.133) + vec3(0.016, 0.026, 0.030) * (1.0 - smoothstep(0.0, 0.3, yn))
    face = mix(face, self.color.rgb, filled)
    face = face + vec3(0.016, 0.022, 0.026) * hv
    face = mix(face, face * 0.7, self.down)
    // Outlined has no face at all: the ground and its grid show; the
    // pointer brings a faint one.
    let fa = mix(mix(0.85, 0.97, filled), 0.5 * hv, outlined)
    var out = vec4(face * fa * inside, fa * inside)
    out = mix(out, vec4(0.020, 0.047, 0.063, 1.0), Finish.band(d, px, 2.0 * px, px) * step(hi.y - 2.5 * px, p.y) * (1.0 - outlined))
    // The frame: the dim line on Elevated, none on Filled (the face is the
    // edge), the foot line all round on Outlined.
    let fc = mix(h_dim(), Finish.lift(h_foot(), 0.1 * hv), outlined)
    out = mix(out, vec4(fc, 1.0), Finish.band(d, 0.0, px, px) * (1.0 - filled))
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    let arm = min(0.25 * min(hi.x - lo.x, hi.y - lo.y), 8.0)
    let br = h_brackets(p, lo, hi, arm, px)
    out = mix(out, vec4(Finish.lift(h_ink3(ny, h_top(), h_side(), h_foot()), 0.2 * hv), 1.0), br)
    let tq = p - vec2(hi.x - 14.0 - 12.0, lo.y + 2.0 + 1.5)
    let tab = max(abs(tq.y) - 1.5, abs(tq.x) + (tq.y + 1.5) - 12.0)
    let tf = Finish.cover(tab, px)
    out = h_add(out, h_halo_ink(tab), h_glow(tab, 0.32, 5.0) * (1.0 - tf) * inside)
    return mix(out, vec4(h_acc(), 1.0), tf)
}

// A card's title is a surface caption like a panel's: bold at the label
// size in the dim legend ink, so every surface is headed one way.
mod.widgets.H4.draw_text.color = #7fb3bc
mod.widgets.H4.draw_text.text_style = mod.theme.font_bold{font_size: 8.25}

// LIST ROWS. 22 points tall; a dim separator under each row; the pointer
// lifts the face; the chosen row takes the accent at an eighth, a line of
// the accent round it and a 2 point bar at its left.
mod.widgets.ListItem.height = 22.0
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(floor((o.x + self.rect_size.x) / px) * px, floor((o.y + self.rect_size.y) / px) * px) - o
    let wash = (0.5 * self.hover + 0.7 * self.down) * (1.0 - self.selected) * live
    var out = vec4(vec3(0.051, 0.122, 0.153) * wash, wash)
    let sep = step(hi.y - px, p.y) * step(p.y, hi.y)
    out = mix(out, vec4(0.055, 0.106, 0.125, 1.0), sep * (1.0 - self.selected))
    let sel = self.selected * live
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 0.0)
    out = mix(out, vec4(0.031, 0.114, 0.141, 1.0), sel * Finish.cover(d, px))
    out = mix(out, vec4(h_acc() * 0.7, 1.0), sel * Finish.band(d, 0.0, px, px))
    let bar = step(lo.x, p.x) * step(p.x, lo.x + 3.0 * px) * sel
    out = mix(out, vec4(h_acc(), 1.0), bar)
    return out
}
mod.widgets.ListItem.draw_text.color = #b8eef5

// The rounded view keeps its caller's colours, but its corners are cut at
// 45 degrees at the top left and bottom right, and its edge is a true
// device pixel.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let lower = vec2(self.border_inset.x, self.border_inset.y)
    let upper = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lower + upper) * 0.5
    let h = max((upper - lower) * 0.5, vec2(0.5, 0.5))
    let k = min(self.border_radius * 1.5, min(min(h.x, h.y), 8.0))
    let d = Finish.sd_notch(p, c, h, vec4(k, 0.0, k, 0.0))
    var fill = self.color
    if self.color_2.x > -0.5 {
        let dir = if self.gradient_fill_horizontal > 0.5 self.pos.x else self.pos.y
        fill = mix(self.color, self.color_2, dir)
    }
    var stroke = self.border_color
    if self.border_color_2.x > -0.5 {
        let dir = if self.gradient_border_horizontal > 0.5 self.pos.x else self.pos.y
        stroke = mix(self.border_color, self.border_color_2, dir)
    }
    var col = vec4(fill.rgb * fill.a, fill.a)
    let bw = max(self.border_size, px) * step(0.001, self.border_size)
    let edge = Finish.band(d, 0.0, bw, px) * stroke.a
    col = mix(col, vec4(stroke.rgb, 1.0), edge)
    return col * Finish.cover(d, px)
}

// CHIPS. A small frame cut at two corners with the rest face; the pointer
// lifts it, a press arms it.
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(floor((o.x + self.rect_size.x) / px) * px, Finish.snap(o.y + self.rect_size.y - 2.0, px)) - o
    let kq = vec4(4.0, 0.0, 4.0, 0.0)
    let d = Finish.sd_notch(p, (lo + hi) * 0.5, (hi - lo) * 0.5, kq)
    let yn = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.051, 0.114, 0.145), vec3(0.039, 0.090, 0.118), yn)
    face = face + vec3(0.016, 0.022, 0.026) * self.hover
    face = mix(face, vec3(0.055, 0.184, 0.216), self.down)
    let inside = Finish.cover(d, px)
    var out = vec4(face * 0.9 * inside, 0.9 * inside)
    let ny = h_facing(p, lo, hi, kq, px)
    let lc = Finish.lift(h_ink3(ny, h_top(), h_side(), h_foot()), 0.16 * max(self.hover, self.down))
    return mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
}

// BADGES. A count is a data chip: a solid block of the intent's ink cut at
// two corners with ground-dark figures, as the family's label chips are.
mod.widgets.BadgePalette.neutral = #36c8dc
mod.widgets.BadgePalette.on_neutral = #03090f
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(14.0, self.rect_size.y)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px)) - o
    let hi = vec2(floor((o.x + self.rect_size.x) / px) * px - o.x, lo.y + Finish.snap(bh, px))
    let k = 3.0
    let d = Finish.sd_notch(p, (lo + hi) * 0.5, (hi - lo) * 0.5, vec4(k, 0.0, k, 0.0))
    let a = Finish.cover(d, px) * self.color.a
    var out = vec4(self.color.rgb * a, a)
    if self.border_size > 0.0 {
        out = mix(out, vec4(self.border_color.rgb, 1.0), Finish.band(d, 0.0, px, px) * self.border_color.a)
    }
    return out
}

// SPINNERS: the bars face, the family's segments; the stock face turns on
// the pass clock, which only the library's own shader may read.
mod.widgets.SpinnerFlat.face = mod.widgets.SpinnerFace.Bars
true
