use mod.prelude.widgets_internal.*

// Line frames of a head-up display over a dark ground.
// A control is drawn, not built: a one-device-pixel frame in the cyan ink,
// brightest on its top edge, cut at 45 degrees on two opposite corners,
// around a face that is a dark tint of the ground lit from inside. One run
// of each top line burns at full with a short bloom (a pale core, a
// saturated body, a soft halo); the rest of the frame never glows. On is a
// solid accent block; focus is four corner brackets standing off the box.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 0.0
mod.widgets.Button.draw_bg.border_size = 0.34
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same 26 point row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 0.0
let field_border = 0.34

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #03090f

// Light and focus marks leave the layout box: plain views stop clipping so
// a bloom or a bracket can fall into the gap beside a control. Scroll views
// still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. The inks, darkest first:
// ground #03090f, well #050d13, dim line #1d3a42, foot line #2e6570, side
// line #3f7f8a, top line #6fa9b3, accent #36c8dc, bright #6af0f5, run
// #bfe9ef, text #b8eef5, hot #e6fdff. Halo body: the accent at 0.45.

// The halo of a lit line, x points out from it: a gaussian near part over
// an exponential tail, cut to nothing at `reach`. 0.77 of `amp` one device
// pixel out, 0.38 at 2 points, 0.15 at 3 (reach 3.5).
let h_glow = fn(x: float, amp: float, reach: float) -> float {
    let t = max(x, 0.0)
    let n = 0.6 * exp(0.0 - t * t / (0.35 * reach * reach)) + 0.4 * exp(0.0 - 3.0 * t / reach)
    return amp * n * (1.0 - smoothstep(0.7 * reach, reach, t))
}
// Halo colour: the saturated accent close to the line, its deep body
// further out.
let h_halo_ink = fn(x: float) -> vec3 {
    return mix(vec3(0.10, 0.42, 0.47), vec3(0.212, 0.784, 0.863), exp(0.0 - max(x, 0.0) / 0.8))
}
// Light added over a premultiplied colour.
let h_add = fn(under: vec4, ink: vec3, g: float) -> vec4 {
    return vec4(under.rgb + ink * g, min(under.a + g * 0.6, 1.0))
}

// Which way the edge under a frame pixel faces: -1 up, +1 down, 0 sideways,
// the cut corners between. `k` are the cuts (tl, tr, br, bl).
let h_facing = fn(p: vec2, lo: vec2, hi: vec2, k: vec4, px: float) -> float {
    var ny = 0.0
    ny = mix(ny, -1.0, step(p.y, lo.y + 1.5 * px))
    ny = mix(ny, 1.0, step(hi.y - 1.5 * px, p.y))
    let tl = step(p.x - lo.x + p.y - lo.y, k.x + 1.5 * px) * step(0.01, k.x)
    let tr = step(hi.x - p.x + p.y - lo.y, k.y + 1.5 * px) * step(0.01, k.y)
    let br = step(hi.x - p.x + hi.y - p.y, k.z + 1.5 * px) * step(0.01, k.z)
    let bl = step(p.x - lo.x + hi.y - p.y, k.w + 1.5 * px) * step(0.01, k.w)
    ny = mix(ny, -0.7, max(tl, tr))
    ny = mix(ny, 0.7, max(br, bl))
    return ny
}
// Light from above, told by line brightness only: the top ink on an edge
// facing up, the side ink sideways, the foot ink facing down.
let h_ink3 = fn(ny: float, top: vec3, side: vec3, foot: vec3) -> vec3 {
    return mix(mix(side, top, max(0.0 - ny, 0.0)), foot, max(ny, 0.0))
}
// The rest ladder of a frame.
let h_top = fn() -> vec3 { return vec3(0.435, 0.663, 0.702) }
let h_side = fn() -> vec3 { return vec3(0.247, 0.498, 0.541) }
let h_foot = fn() -> vec3 { return vec3(0.180, 0.396, 0.439) }
let h_dim = fn() -> vec3 { return vec3(0.114, 0.227, 0.259) }
let h_acc = fn() -> vec3 { return vec3(0.212, 0.784, 0.863) }
let h_bright = fn() -> vec3 { return vec3(0.416, 0.941, 0.961) }
let h_well = fn() -> vec3 { return vec3(0.020, 0.051, 0.075) }

// Corner brackets on a square frame: 1 dpx arms `arm` long at the four
// corners of the box lo..hi. Returns coverage.
let h_brackets = fn(p: vec2, lo: vec2, hi: vec2, arm: float, px: float) -> float {
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let ex = min(p.x - lo.x, hi.x - p.x)
    let ey = min(p.y - lo.y, hi.y - p.y)
    return Finish.band(d, 0.0, px, px) * step(ex, arm) * step(ey, arm)
}
// The focus mark: brackets 2 points outside the box, 5 point arms, the
// accent, with the short bloom the one focused thing may have. Laid over
// `under`.
let h_focus = fn(under: vec4, p: vec2, lo: vec2, hi: vec2, px: float, focus: float) -> vec4 {
    let off = 3.0 * px
    let a = lo - vec2(off, off)
    let b = hi + vec2(off, off)
    let br = h_brackets(p, a, b, 5.0, px) * focus
    let c = (a + b) * 0.5
    let d = Material.sd_box(p, c, (b - a) * 0.5, 0.0)
    let ex = min(p.x - a.x, b.x - p.x)
    let ey = min(p.y - a.y, b.y - p.y)
    let near = (1.0 - smoothstep(4.0, 7.0, ex)) * (1.0 - smoothstep(4.0, 7.0, ey))
    let x = abs(d + 0.5 * px) - 0.5 * px
    let g = h_glow(x, 0.30 * focus, 3.0) * near * (1.0 - br)
    let o = h_add(under, h_halo_ink(x), g)
    return mix(o, vec4(h_acc(), 1.0), br)
}

// Distance to a segment.
let h_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    return length(pa - ba * t)
}

// A hexagon with flat top and bottom, `r` from the centre to a flat side.
let h_hex = fn(q: vec2, r: float) -> float {
    var p = abs(q)
    let t = 2.0 * min(-0.866025404 * p.x + 0.5 * p.y, 0.0)
    p = p - vec2(t * -0.866025404, t * 0.5)
    let cx = clamp(p.x, -0.577350269 * r, 0.577350269 * r)
    let e = vec2(p.x - cx, p.y - r)
    let l = length(e)
    return mix(l, 0.0 - l, step(e.y, 0.0))
}

// The wait mark a replaced face draws itself: twelve short ticks on a ring
// where the label was, a bright head turning once a second on the button's
// own animation clock and a fading tail.
let h_wait = fn(under: vec4, p: vec2, lo: vec2, hi: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let r = clamp((hi.y - lo.y) * 0.3, 3.0, 8.0)
    let q = p - c
    let a = fract(atan2(q.y, q.x) / 6.2831853 + 0.25)
    let slot = floor(a * 12.0 + 0.5)
    let ang = slot / 12.0 * 6.2831853 - 1.5707963
    let dir = vec2(cos(ang), sin(ang))
    let s = h_seg(q, dir * (r - 2.5), dir * r)
    let head = fract(slot / 12.0 - t)
    let lit = mix(0.25, 1.0, pow(1.0 - head, 3.0))
    let cov = Finish.cover(s - 0.5 * px, px) * loading
    return mix(under, vec4(mix(h_dim(), h_bright(), lit), 1.0), cov)
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `style` picks the dressing:
// 0 standard, 1 primary (double line, the one bloom), 2 secondary (armed:
// the face at a fifth of the accent, the line in the accent), 3 danger (the
// red role), 4 outline (line and no face), 5 flat (a foot line only until
// the pointer comes), 6 flatter (nothing until the pointer comes),
// 7 tertiary (a dim square frame with bright corner brackets), 8 dashed
// (the outline in 3 point dashes).
// The quad is grown by 6 points for the bloom and the focus brackets.
let h_button = fn(p: vec2, o: vec2, s: vec2, px: float, cuts: vec4, hover: float, down: float, focus: float, disabled: float, style: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let hh = hi.y - lo.y
    let ww = hi.x - lo.x
    let tile = step(6.5, style) * step(style, 7.5)
    let dashed = step(7.5, style)
    let k = Finish.snap(clamp(0.38 * hh, 3.0, 12.0), px)
    let kq = cuts * k * (1.0 - tile)
    let c = (lo + hi) * 0.5
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, kq)
    let yn = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    let hv = hover * live
    let dn = down * live
    let hero = step(0.5, style) * step(style, 1.5)
    let armed = step(1.5, style) * step(style, 2.5)
    let danger = step(2.5, style) * step(style, 3.5)
    let outline = max(step(3.5, style) * step(style, 4.5), dashed)
    let flat = step(4.5, style) * step(style, 6.5)
    let flatter = step(5.5, style) * step(style, 6.5)

    // The face: flat within a few percent at rest, lit from below on the
    // primary and the armed face, turned over and darker while held.
    var ft = vec3(0.051, 0.114, 0.145)
    var fb = vec3(0.039, 0.090, 0.118)
    ft = mix(ft, vec3(0.055, 0.125, 0.161), hero)
    fb = mix(fb, vec3(0.078, 0.180, 0.224), hero)
    ft = mix(ft, vec3(0.035, 0.122, 0.153), armed)
    fb = mix(fb, vec3(0.063, 0.220, 0.275), armed)
    ft = mix(ft, vec3(0.239, 0.047, 0.071), danger)
    fb = mix(fb, vec3(0.271, 0.078, 0.102), danger)
    var face = mix(ft, fb, yn) + vec3(0.022, 0.030, 0.036) * hv * (1.0 - dn)
    // Held, the face lights from inside as an active one does: dark at the
    // head, the accent's deep ink at the foot.
    let lit_face = mix(vec3(0.0, 0.094, 0.133), vec3(0.0, 0.227, 0.302), yn * yn)
    face = mix(face, mix(lit_face, mix(fb, ft, yn) * 1.4, danger), dn)
    face = mix(face, vec3(0.027, 0.071, 0.102), disabled)
    let rest_a = 0.9 * (1.0 - outline) * (1.0 - flat) * mix(1.0, 0.45, tile)
    var fa = max(rest_a, (outline + flat) * max(0.45 * hv, 0.8 * dn))
    fa = mix(fa, 0.6 * rest_a, disabled)
    let inside = Finish.cover(d, px)
    var out = vec4(face * fa * inside, fa * inside)

    // The contact line: one dark device row inside the foot, gone while held.
    let foot = Finish.band(d, px, 2.0 * px, px) * step(hi.y - 2.5 * px, p.y)
    out = mix(out, vec4(0.020, 0.047, 0.063, 1.0), foot * step(0.5, fa) * (1.0 - dn))

    // The frame, top bright, sides three quarters, foot half.
    let ny = h_facing(p, lo, hi, kq, px)
    var top = h_top()
    var side = h_side()
    var bot = h_foot()
    top = mix(top, vec3(0.557, 0.639, 0.631), hero)
    side = mix(side, vec3(0.624, 0.812, 0.831), hero)
    bot = mix(bot, vec3(0.518, 0.596, 0.600), hero)
    top = mix(top, vec3(0.300, 0.860, 0.930), armed)
    side = mix(side, h_acc() * 0.72, armed)
    bot = mix(bot, h_acc() * 0.55, armed)
    top = mix(top, vec3(0.510, 0.149, 0.200), danger)
    side = mix(side, vec3(0.560, 0.150, 0.230), danger)
    bot = mix(bot, vec3(0.612, 0.145, 0.263), danger)
    var lc = h_ink3(ny, top, side, bot)
    lc = Finish.lift(lc, 0.24 * max(hv, dn))
    // The tile's own frame is the dim line; its brackets carry the ink.
    lc = mix(lc, mix(h_dim(), h_foot(), hv), tile)
    lc = mix(lc, h_dim(), disabled)
    let edge = Finish.band(d, 0.0, px, px)
    // Flat: a foot line alone at rest; flatter: nothing. Both frame up
    // under the pointer and when held.
    let footline = step(hi.y - 1.5 * px, p.y) * (1.0 - flatter)
    var shown = mix(1.0, max(max(footline * 0.8, 0.6 * hv), dn), flat)
    // Dashes counted in window pixels along the edge, so they run on
    // unbroken round the corners.
    let run_len = p.x + p.y + o.x + o.y
    let dash = step(fract(run_len / 4.5), 0.62)
    shown = shown * mix(1.0, dash, dashed)
    out = mix(out, vec4(lc, 1.0), edge * shown)

    // The primary's second line, 0.11 of the height in, at half the light.
    let ins = max(Finish.snap(0.11 * hh, px), 2.0 * px)
    let inner = Finish.band(d + ins, 0.0, px, px) * hero
    let ic = Finish.lift(mix(vec3(0.353, 0.541, 0.565), vec3(0.420, 0.561, 0.580), yn), 0.12 * max(hv, dn))
    out = mix(out, vec4(mix(ic, h_dim(), disabled), 1.0), inner)

    // The tile's corner brackets.
    let arm = min(0.3 * min(ww, hh), 8.0)
    let brk = h_brackets(p, lo, hi, arm, px) * tile
    let bc = Finish.lift(h_ink3(ny, h_top(), h_side(), h_foot()), 0.12 + 0.2 * max(hv, dn))
    out = mix(out, vec4(mix(bc, h_dim(), disabled), 1.0), brk)

    // The bright run on the top line: from the cut corner along 30 % of the
    // width (40 % on the primary), longer under the pointer, fading into
    // the dim line at its far end. It carries the only bloom of a control:
// amp 0.40 over 4.5 points, the primary's 0.60 over 5.
    let runs = (1.0 - flat) * (1.0 - tile) * (1.0 - dashed) * live
    let x0 = lo.x + kq.x
    let avail = ww - kq.x - kq.y - 4.0
    let rl = min(max((mix(0.30, 0.40, hero) + mix(0.30, 0.20, hero) * hv) * ww, 22.0 + 10.0 * hv), avail)
    let rx = smoothstep(x0 - px, x0 + 2.0, p.x) * (1.0 - smoothstep(x0 + rl * 0.65, x0 + rl, p.x)) * runs
    let topline = edge * step(p.y, lo.y + 1.5 * px)
    var rc = vec3(0.749, 0.914, 0.937)
    rc = mix(rc, vec3(0.902, 0.992, 1.0), hero)
    rc = mix(rc, vec3(0.659, 0.969, 0.980), armed)
    rc = mix(rc, vec3(0.961, 0.412, 0.424), danger)
    out = mix(out, vec4(rc, 1.0), topline * rx)
    let amp = (mix(0.40, 0.60, hero) + 0.14 * hv) * (1.0 - dn * 0.6)
    var hink = h_halo_ink(d)
    hink = mix(hink, vec3(0.45, 0.10, 0.12), danger)
    let above = 1.0 - smoothstep(lo.y - px, lo.y + px, p.y)
    let gout = h_glow(d, amp, mix(4.5, 5.0, hero)) * rx * above * (1.0 - inside)
    out = h_add(out, hink, gout)
    // The same light falls a little way into the face below the run.
    let gin = h_glow(0.0 - d - px, amp * 0.35, 2.5) * rx * inside * (1.0 - edge) * step(p.y, lo.y + 4.0)
    out = h_add(out, hink, gin)
    // The primary's whole outer line throws a faint bloom.
    let gb = h_glow(d, (0.10 + 0.06 * hv) * hero * live * (1.0 - dn), 2.5) * (1.0 - inside)
    out = h_add(out, h_halo_ink(d), gb)

    return h_focus(out, p, lo, hi, px, focus * live)
}

mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk = Walk{width: 13.0, height: Fit}
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(6.0)
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 5.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 0.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
// The size rungs and the compound are standard buttons. They share the
// flat button's draw object, so they are handed one of their own.
mod.widgets.ButtonXs.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonSm.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonLg.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonXl.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonCompound.draw_bg = mod.widgets.Button.draw_bg{}
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 32.0
mod.widgets.ButtonXl.min_height = 38.0
mod.widgets.ButtonSm.padding = mod.turtle.Inset{left: 9.0 right: 9.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonXs.padding = mod.turtle.Inset{left: 7.0 right: 7.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonLg.padding = mod.turtle.Inset{left: 16.0 right: 16.0 top: 0.0 bottom: 0.0}
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}

mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 1.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 2.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(0.0, 0.0, 0.0, 0.0), self.hover, self.down, self.focus, self.disabled, 7.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 3.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 0.0, 0.0), self.hover, self.down, self.focus, self.disabled, 4.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonDashed.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 0.0, 0.0), self.hover, self.down, self.focus, self.disabled, 8.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = h_button(p, self.rect_pos, self.rect_size, px, vec4(1.0, 0.0, 1.0, 0.0), self.hover, self.down, self.focus, self.disabled, 6.0)
    return h_wait(f, p, vec2(0.0, 0.0), self.rect_size, px, self.loading, self.anim_time)
}

