// HELD STATES. The stock tracks write the pointer's hover and the press as
// snapped values, and a snapped value never arrives when a state is held
// from the start (a still page, a restored screen). The same states with
// plain values and a snapped entry look and move the same under a live
// pointer, and hold.
let h_held_states = fn(w) {
    w.animator.hover.on.from = {all: Snap}
    w.animator.hover.on.apply = {draw_bg: {down: 0.0, hover: 1.0} draw_text: {down: 0.0, hover: 1.0}}
    w.animator.hover.down.from = {all: Snap}
    w.animator.hover.down.apply = {draw_bg: {down: 1.0, hover: 1.0} draw_text: {down: 1.0, hover: 1.0}}
}
h_held_states(mod.widgets.ButtonFlat)
h_held_states(mod.widgets.CheckBoxFlat)
h_held_states(mod.widgets.ToggleFlat)
h_held_states(mod.widgets.RadioButtonFlat)
h_held_states(mod.widgets.RadioButtonTabFlat)
h_held_states(mod.widgets.TextInputFlat)
h_held_states(mod.widgets.DropDownFlat)

// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point square: the frame, a device pixel of ground, then
// the mark as a solid accent block 0.7 of the box. No tick: the block is the
// mark. Mixed is the block at half light cut by a dark bar; error takes the
// red role; held arms the well at a fifth of the accent; focus brackets it.
let h_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let live = 1.0 - disabled
    let hv = hover * live
    let on = max(active, mixed)
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    var lc = h_ink3(ny, h_top(), h_side(), h_foot())
    lc = mix(lc, h_ink3(ny, h_bright(), h_acc(), h_acc() * 0.8), on)
    lc = mix(lc, h_ink3(ny, vec3(0.961, 0.412, 0.424), vec3(0.80, 0.30, 0.33), vec3(0.612, 0.145, 0.263)), err)
    lc = Finish.lift(lc, 0.26 * max(hv, down * live))
    lc = mix(lc, h_dim(), disabled)
    let inside = Finish.cover(d, px)
    let well = mix(mix(h_well(), vec3(0.055, 0.184, 0.216), down * live), h_well() + h_acc() * 0.06, hv * (1.0 - down))
    var out = vec4(mix(well, vec3(0.012, 0.035, 0.059), disabled) * inside, inside)
    out = mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
    // The mark, 3 device pixels in from the frame.
    let md = d + 3.0 * px
    let mk = Finish.cover(md, px)
    var ink = mix(h_acc(), h_bright(), hv)
    ink = mix(ink, vec3(1.0, 0.376, 0.408), err)
    let block = mix(ink, ink * 0.55, mixed * (1.0 - active))
    let lit = mk * on * live
    out = mix(out, vec4(block, 1.0), lit)
    // A device pixel of dark bar through the mixed block.
    let bar = Finish.cover(abs(p.y - c.y) - 0.5 * px, px) * step(abs(p.x - c.x), 2.5) * mixed * (1.0 - active) * live
    out = mix(out, vec4(0.020, 0.075, 0.102, 1.0), bar)
    // Off and on, a disabled mark is only a line.
    let ghost = Finish.band(md, 0.0, px, px) * on * disabled
    out = mix(out, vec4(h_dim(), 1.0), ghost)
    return h_focus(out, p, lo, hi, px, focus * live)
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 16.0
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 0.0
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    return h_check(p, self.rect_pos, self.rect_size, px, self.size, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}
mod.widgets.CheckBoxFlat.draw_text.color_error = #ff9aa0

// RADIOS. A hexagon with flat top and bottom, the frame's light from above;
// on, a smaller solid hexagon in the accent.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 16.0
mod.widgets.RadioButtonFlat.draw_bg.size = 14.0
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    let o = self.rect_pos
    // Points up and down, the flat sides on whole device pixels.
    let r = Finish.snap(self.size * 0.46, px)
    let rr = r * 1.1547
    let c = vec2(Finish.snap(o.x + self.size * 0.5 - r, px) + r - o.x, Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y)
    let d = h_hex(vec2(p.y - c.y, p.x - c.x), r)
    let live = 1.0 - self.disabled
    let hv = self.hover * live
    let dn = self.down * live
    let q = p - c
    let ny = clamp(q.y / rr, -1.0, 1.0)
    var lc = h_ink3(ny, h_top(), h_side(), h_foot())
    lc = mix(lc, h_ink3(ny, h_bright(), h_acc(), h_acc() * 0.8), self.active)
    lc = Finish.lift(lc, 0.26 * max(hv, dn))
    lc = mix(lc, h_dim(), self.disabled)
    let inside = Finish.cover(d, px)
    let well = mix(mix(h_well(), vec3(0.055, 0.184, 0.216), dn), h_well() + h_acc() * 0.06, hv * (1.0 - dn))
    var out = vec4(mix(well, vec3(0.012, 0.035, 0.059), self.disabled) * inside, inside)
    out = mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
    let md = h_hex(vec2(q.y, q.x), r * 0.58)
    out = mix(out, vec4(mix(h_acc(), h_bright(), hv), 1.0), Finish.cover(md, px) * self.active * live)
    out = mix(out, vec4(h_dim(), 1.0), Finish.band(md, 0.0, px, px) * self.active * self.disabled)
    let lo = c - vec2(r, rr)
    let hi = c + vec2(r, rr)
    return h_focus(out, p, lo, hi, px, self.focus * live)
}

// TOGGLES. A 34 by 14 track cut at two corners, a well inside a device
// pixel of ground, and a square thumb block: off, the dim block at the left
// and three dim ticks in the empty half; on, the accent block at the right
// with a keep-out line round it and the ticks in the half it left.
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.label_walk.margin.left = 37.0
mod.widgets.ToggleFlat.draw_bg.size = 14.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.4286
// A knob icon is a 7 point mark in the middle of the thumb. The widget
// places it for the stock knob (its centre half the size plus 0.34 in, the
// travel less 0.34 and a 1.5 inset, 0.6 of that knob wide), and a sheet's
// writes to those values do not reach where it reads them; so the icon's
// own point hook scales the mark about its centre and moves it onto this
// thumb: 2.16 points right while off, 1 point left while on.
let h_knob_icon = fn(pos: vec2, rs: vec2, dx: float) -> vec2 {
    let c = rs * 0.5
    let k = 7.0 / max(min(rs.x, rs.y), 1.0)
    return c + (pos - c) * k + vec2(dx, 0.0)
}
mod.widgets.ToggleFlat.draw_icon_off.transform_svg_point = fn(pos: vec2) -> vec2 {
    return h_knob_icon(pos, self.rect_size, 2.16)
}
mod.widgets.ToggleFlat.draw_icon_on.transform_svg_point = fn(pos: vec2) -> vec2 {
    return h_knob_icon(pos, self.rect_size, -1.0)
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(5.0, 5.0), self.rect_size + vec2(10.0, 10.0))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(10.0, 10.0)) - vec2(5.0, 5.0)
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = (self.rect_size.x - sz.x) * self.mark_at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let kq = vec4(3.0, 0.0, 3.0, 0.0)
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, kq)
    let live = 1.0 - self.disabled
    let hv = self.hover * live
    let dn = self.down * live
    let t = mix(self.active, self.drag_pos, self.drag)
    let on = self.active * live
    let ny = h_facing(p, lo, hi, kq, px)
    var lc = h_ink3(ny, h_top(), h_side(), h_foot())
    lc = mix(lc, h_ink3(ny, h_acc() * 0.95, h_acc() * 0.72, h_acc() * 0.6), on)
    lc = Finish.lift(lc, 0.26 * max(hv, dn))
    lc = mix(lc, h_dim(), self.disabled)
    let inside = Finish.cover(d, px)
    var out = vec4(mix(h_well(), vec3(0.012, 0.035, 0.059), self.disabled) * inside, inside)
    out = mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
    // The thumb: 15 by 10 at the 14 point size, scaled with the size, its
    // centre 2.5 points past half the size from either end.
    let tw = self.size * 15.0 / 14.0
    let th = Finish.snap(self.size * 10.0 / 14.0, px)
    let tcx = self.size * 0.5 + 2.5 + (sz.x - self.size - 5.0) * t
    let tx = lo.x + tcx - tw * 0.5
    let tlo = vec2(Finish.snap(o.x + tx, px) - o.x, Finish.snap(o.y + c.y - th * 0.5, px) - o.y)
    let thi = tlo + vec2(Finish.snap(tw, px), th)
    let tc = (tlo + thi) * 0.5
    let td = Material.sd_box(p, tc, (thi - tlo) * 0.5, 0.0)
    // Three ticks in the empty half.
    let ex = lo.x + mix(sz.x - self.size * 0.5 - 3.5, self.size * 0.5 + 3.5, t)
    let tq = p.x - ex
    let tick = Finish.cover(abs(abs(tq) - 3.0 * step(1.0, abs(tq))) - 0.5 * px, px) * step(abs(tq), 3.5) * step(abs(p.y - c.y), 2.0)
    out = mix(out, vec4(mix(h_dim(), h_foot(), on), 1.0), tick * inside)
    var thumb = mix(h_dim(), mix(h_acc(), h_bright(), hv), t * live)
    thumb = Finish.lift(thumb, 0.12 * hv * (1.0 - self.active))
    thumb = mix(thumb, h_foot(), dn * (1.0 - self.active))
    // The keep-out line round a lit block, then the block with a hotter top.
    out = mix(out, vec4(0.012, 0.035, 0.059, 1.0), Finish.ring_out(td, 0.0, px, px) * t * live)
    let topl = Finish.band(td, 0.0, px, px) * step(p.y, tlo.y + 1.5 * px)
    var blk = mix(thumb, Finish.lift(thumb, 0.3), topl)
    blk = mix(blk, h_dim() * 0.8, self.disabled)
    out = mix(out, vec4(blk, 1.0), Finish.cover(td, px))
    return h_focus(out, p, lo, hi, px, self.focus * live)
}

// ---------------------------------------------------------------------------
// SLIDERS. The track is the family's outline, gap and fill: a 6 point bar
// of one device pixel, a device pixel of ground, then the value as a solid
// accent fill with a bright leading pixel. The handle is a bright bar with
// two bracket stubs; a tick ruler runs under the track.
let h_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, pad: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float, ruler: float) -> vec4 {
    let live = 1.0 - disabled
    let touch = max(max(hover, drag), focus) * live
    let yc = Finish.snap(o.y + cy, px) - o.y
    let x0 = Finish.snap(o.x + pad, px) - o.x
    let x1 = Finish.snap(o.x + rs.x - pad, px) - o.x
    let hh = 6.0 * px * 1.5
    let lo = vec2(x0, yc - Finish.snap(3.0, px))
    let hi = vec2(x1, lo.y + Finish.snap(6.0, px))
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    var lc = h_ink3(ny, h_side(), h_foot(), h_foot() * 0.85)
    lc = Finish.lift(lc, 0.12 * touch)
    lc = mix(lc, h_dim(), disabled)
    let inside = Finish.cover(d, px)
    var out = vec4(h_well() * inside, inside)
    out = mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
    // The fill.
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    let fa = min(xf, xv)
    let fb = max(xf, xv)
    let fd = max(d + 2.0 * px, max(fa - p.x, p.x - fb))
    let fill = Finish.cover(fd, px) * step(0.5 * px, fb - fa)
    var ink = mix(h_acc() * 0.92, h_acc(), touch)
    ink = mix(ink, mix(h_acc(), h_bright(), 0.35), drag * live)
    ink = mix(ink, h_dim(), disabled)
    let lead = step(fb - px, p.x) * step(xf, xv)
    out = mix(out, vec4(mix(ink, h_bright() * live + h_dim() * disabled, lead), 1.0), fill)
    // The ruler: a tick every tenth, a longer one every half.
    let tq = (p.x - x0) / max(x1 - x0, 1.0) * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * (x1 - x0) / 10.0
    let major = step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti)
    let tl = mix(3.0, 5.0, min(major, 1.0))
    let ty = p.y - hi.y - 2.0
    let tick = Finish.cover(tx - 0.5 * px, px) * step(0.0, ty) * step(ty, tl) * step(-0.5, ti) * step(ti, 10.5) * ruler
    out = mix(out, vec4(mix(h_dim(), h_foot(), min(major, 1.0)) * mix(1.0, 0.7, disabled), 1.0), tick)
    // The handle: a 3 by 14 bright bar with a keep-out pixel, and two
    // bracket stubs above and below it.
    let hx = Finish.snap(o.x + xv, px) - o.x
    let hd = Material.sd_box(p, vec2(hx, c.y), vec2(1.5, 7.0), 0.0)
    out = mix(out, vec4(0.012, 0.035, 0.059, 1.0), Finish.ring_out(hd, 0.0, px, px) * live)
    let hink = mix(mix(h_bright(), vec3(0.80, 0.99, 1.0), touch), h_foot(), disabled)
    out = mix(out, vec4(hink, 1.0), Finish.cover(hd, px))
    let sy = abs(p.y - c.y) - 9.0
    let stub = Finish.cover(abs(sy) - 0.5 * px, px) * step(abs(p.x - hx), 3.5)
    out = mix(out, vec4(mix(mix(h_acc(), h_bright(), drag), h_dim(), disabled), 1.0), stub)
    // The handle may glow while it is the one thing touched.
    let g = h_glow(hd, (0.28 * focus + 0.4 * drag) * live, 3.0) * (1.0 - Finish.cover(hd, px))
    return h_add(out, h_halo_ink(hd), g)
}

mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.height = 36.0
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    return h_slider(p, self.rect_pos, self.rect_size, px, 24.0, 2.0, to, from, self.hover, self.focus, self.drag, self.disabled, 1.0)
}
// The minimal slider: a hairline rail, the value as two device pixels of
// accent, a small bright square for a handle.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let touch = max(max(self.hover, self.drag), self.focus) * live
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y
    let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
    let rail = Finish.cover(abs(p.y - y - 0.5 * px) - 0.5 * px, px) * inx
    var out = vec4(vec3(0.106, 0.337, 0.388) * mix(1.0, 0.5, self.disabled) * rail, rail)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(0.0, lo, self.arc_origin) * self.rect_size.x
    let b = mix(self.slide_pos, hi, self.arc_origin) * self.rect_size.x
    let fill = Finish.cover(abs(p.y - y - 0.5 * px) - px, px) * step(a, p.x) * step(p.x, b)
    out = mix(out, vec4(mix(h_acc(), h_dim(), self.disabled), 1.0), fill)
    let hx = Finish.snap(o.x + self.slide_pos * self.rect_size.x, px) - o.x
    let hd = Material.sd_box(p, vec2(hx, y + 0.5 * px), vec2(3.0, 3.0), 0.0)
    out = mix(out, vec4(0.012, 0.035, 0.059, 1.0), Finish.ring_out(hd, 0.0, px, px) * live)
    out = mix(out, vec4(mix(mix(h_bright(), vec3(0.80, 0.99, 1.0), touch), h_foot(), self.disabled), 1.0), Finish.cover(hd, px))
    let g = h_glow(hd, 0.28 * max(self.drag, self.focus) * live, 3.0) * (1.0 - Finish.cover(hd, px))
    return h_add(out, h_halo_ink(hd), g)
}
// The round slider is the segmented meter: a frame, a device pixel of
// ground, and 5 point cells with 2.5 point gaps lit up to the value; unlit
// cells are hairline outlines, the last lit cell burns bright.
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let touch = max(max(self.hover, self.drag), self.focus) * live
    // The frame stops short of the value, which stands to its right.
    let bh = min(self.rect_size.y - 4.0, 12.0)
    let lo = vec2(Finish.snap(o.x + self.label_size, px), Finish.snap(o.y + self.rect_size.y * 0.5 - bh * 0.5, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 38.0, px) - o.x, lo.y + Finish.snap(bh, px))
    let c = (lo + hi) * 0.5
    let kq = vec4(3.0, 0.0, 3.0, 0.0)
    let d = Finish.sd_notch(p, c, (hi - lo) * 0.5, kq)
    let ny = h_facing(p, lo, hi, kq, px)
    var lc = h_ink3(ny, h_side(), h_foot(), h_foot() * 0.85)
    lc = Finish.lift(lc, 0.12 * touch)
    lc = mix(lc, h_dim(), self.disabled)
    let inside = Finish.cover(d, px)
    var out = vec4(h_well() * inside, inside)
    out = mix(out, vec4(lc, 1.0), Finish.band(d, 0.0, px, px))
    // Cells.
    let ci0 = lo.x + 3.0 * px
    let span = hi.x - 3.0 * px - ci0
    let pitch = 7.5
    let n = max(floor((span + 2.5) / pitch), 1.0)
    let used = n * pitch - 2.5
    let start = ci0 + (span - used) * 0.5
    let ci = floor((p.x - start) / pitch)
    let cx0 = start + ci * pitch
    let incell = step(0.0, ci) * step(ci, n - 1.0)
    let cd = Material.sd_box(p, vec2(Finish.snap(o.x + cx0, px) - o.x + 2.5, c.y), vec2(2.5, (hi.y - lo.y) * 0.5 - 3.0 * px), 0.0)
    let lit = step((ci + 0.5) / n, self.slide_pos + 0.0001)
    let head = lit * (1.0 - step((ci + 1.5) / n, self.slide_pos + 0.0001))
    var ink = mix(h_acc(), h_bright(), head)
    ink = mix(ink, h_foot(), self.disabled)
    out = mix(out, vec4(ink, 1.0), Finish.cover(cd, px) * lit * incell)
    out = mix(out, vec4(h_dim(), 1.0), Finish.band(cd, 0.0, px, px) * (1.0 - lit) * incell)
    let g = h_glow(cd, 0.25 * head * touch, 2.5) * (1.0 - Finish.cover(cd, px)) * incell * inside
    return h_add(out, h_halo_ink(cd), g)
}

// FADERS. The slot is two rails 3 points apart closed by cross bars, the
// value fills between them at 0.6 of the accent, a tick ladder stands on
// one side, and the cap is a 14 by 6 bright block cut by a dark centre line
// inside a keep-out pixel and an accent frame.
mod.widgets.SliderFader.cap_size = 6.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    // Track space: a runs from the value's zero, b across.
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let live = 1.0 - self.disabled
    let touch = max(max(self.hover, self.drag), self.focus) * live
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(across * 0.5, px) + 0.5 * px
    let a0 = foot - 2.0
    let a1 = foot + travel + 2.0
    let inrun = step(a0, p.x) * step(p.x, a1)
    let rails = Finish.cover(abs(abs(p.y - mid) - 2.0) - 0.5 * px, px) * inrun
    let ends = Finish.cover(abs(abs(p.x - (a0 + a1) * 0.5) - (a1 - a0) * 0.5) - 0.5 * px, px) * step(abs(p.y - mid), 2.0 + 0.5 * px)
    let rl = mix(mix(h_foot(), h_side(), touch * 0.5), h_dim(), self.disabled)
    var out = vec4(rl * max(rails, ends), max(rails, ends))
    // Ticks on one side: every tenth 3 points, every half 5 points.
    let tq = (p.x - foot) / travel * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * travel / 10.0
    let major = min(step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti), 1.0)
    let tl = mix(3.0, 5.0, major)
    let tb = mid - 5.5 - p.y
    let tick = Finish.cover(tx - 0.5 * px, px) * step(0.0, tb) * step(tb, tl) * step(-0.5, ti) * step(ti, 10.5)
    out = mix(out, vec4(mix(h_dim(), h_foot(), major), 1.0), tick)
    // The fill between the rails.
    let fa = foot + self.fill_lo * travel
    let fb = foot + self.fill_hi * travel
    let fill = Finish.cover(abs(p.y - mid) - 1.5 + 0.5 * px, px) * step(fa, p.x) * step(p.x, fb)
    out = mix(out, vec4(mix(h_acc() * 0.6, h_dim(), self.disabled), 1.0), fill)
    // The cap.
    let at = foot + self.slide_pos * travel
    let cap = Material.sd_box(p, vec2(at, mid), vec2(self.cap_px * 0.5, 7.0), 0.0)
    let frame = Finish.band(cap + 2.0 * px, 0.0, px, px)
    let keep = Finish.band(cap + px, 0.0, px, px)
    let body = Finish.cover(cap + 2.0 * px, px)
    out = mix(out, vec4(mix(mix(h_acc(), h_bright(), touch), h_foot(), self.disabled), 1.0), frame)
    out = mix(out, vec4(0.012, 0.035, 0.059, 1.0), keep)
    let centre = Finish.cover(abs(p.x - at) - 0.5 * px, px)
    var cc = mix(mix(h_bright(), vec3(0.80, 0.99, 1.0), touch), h_dim(), self.disabled)
    cc = mix(cc, vec3(0.020, 0.075, 0.102), centre)
    out = mix(out, vec4(cc, 1.0), body)
    let g = h_glow(cap, 0.25 * max(self.drag, self.focus) * live, 3.0) * (1.0 - Finish.cover(cap, px))
    return h_add(out, h_halo_ink(cap), g)
}

// ROTARIES. A tick ring outside, the value arc inside it over a dim track,
// and a small dark face disc with the top-bright line and a pointer that
// ends in a bright square.
let h_arc = fn(q: vec2, r: float, a0: float, a1: float) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let ring = abs(length(q) - r)
    let e0 = vec2(0.0 - sin(a0), cos(a0)) * r
    let e1 = vec2(0.0 - sin(a1), cos(a1)) * r
    let ends = min(length(q - e0), length(q - e1))
    return mix(ends, ring, step(a0, a) * step(a, a1))
}
let h_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let touch = max(max(hover, drag), focus) * live
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let q = p - c
    let rl = length(q)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    // Twenty-one ticks over the sweep, every fifth longer and brighter.
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let tq = (a - a0) / span * 20.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * span / 20.0 * rl
    let major = step(fract(ti / 5.0 + 0.01), 0.05)
    let r1 = rad
    let r0 = rad - clamp(0.13 * rad, 1.5, 3.0) * mix(1.0, 1.5, major)
    let tk = Finish.cover(tx - 0.5 * px, px) * step(r0, rl) * step(rl, r1) * step(-0.5, ti) * step(ti, 20.5)
    let tlit = step(ti, (pos * 20.0) + 0.01) * live
    var tc = mix(h_dim(), h_foot(), major)
    tc = mix(tc, mix(h_foot(), h_side(), major), tlit * 0.6)
    out = mix(out, vec4(tc, 1.0), tk)
    // The track and the value arc, two device pixels wide.
    let ra = rad - max(0.3 * rad, 3.5)
    let track = Finish.cover(h_arc(q, ra, a0, a0 + span) - 0.5 * px, px)
    out = mix(out, vec4(vec3(0.043, 0.173, 0.204), 1.0), track)
    let arc = h_arc(q, ra, s0, s1)
    let ak = Finish.cover(arc - px, px)
    let ink = mix(mix(h_acc(), vec3(0.30, 0.86, 0.93), touch), h_foot(), disabled)
    let g = h_glow(arc - px, 0.30 * max(focus, drag) * live, 3.0) * (1.0 - ak)
    out = h_add(out, h_halo_ink(arc - px), g)
    out = mix(out, vec4(ink, 1.0), ak)
    // The face disc: dark, its line bright on the upper half.
    let br = ra - max(0.17 * rad, 2.5)
    let dd = rl - br
    let fa = Finish.cover(dd, px)
    let face = vec3(0.043, 0.102, 0.129) + vec3(0.016, 0.022, 0.026) * hover * live
    out = mix(out, vec4(face * 0.95, 0.95), fa)
    let ny = clamp(q.y / max(br, 1.0), -1.0, 1.0)
    var lc = h_ink3(ny, h_top(), h_side(), h_foot())
    lc = Finish.lift(lc, 0.15 * touch)
    lc = mix(lc, h_dim(), disabled)
    out = mix(out, vec4(lc, 1.0), Finish.band(dd, 0.0, px, px))
    // The pointer: a device pixel from a fifth of the face to its rim, and
    // a bright square at its tip.
    let dir = vec2(0.0 - sin(av), cos(av))
    let pt = h_seg(q, dir * br * 0.25, dir * (br - 2.0))
    out = mix(out, vec4(mix(vec3(0.722, 0.933, 0.961), h_dim(), disabled), 1.0), Finish.cover(pt - 0.5 * px, px))
    let tip = dir * (br - 2.0)
    let sq = max(abs(q.x - tip.x), abs(q.y - tip.y)) - px
    out = mix(out, vec4(mix(h_bright(), h_dim(), disabled), 1.0), Finish.cover(sq, px))
    return out
}
mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 22.0 + dia * 0.5, px)) - self.rect_pos
    return h_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let dia = min(self.rect_size.x, self.rect_size.y)
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - dia * 0.5, px)) - self.rect_pos
    return h_knob(p, c, dia * 0.5 - 2.0, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_text.color = #7fb3bc
mod.widgets.RotaryKnob.draw_text.color_hover = #b8eef5
mod.widgets.RotaryKnob.draw_text.color_focus = #b8eef5
mod.widgets.RotaryKnob.draw_text.color_drag = #e6fdff
mod.widgets.RotaryKnob.draw_text.color_disabled = #33545b
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 6.5}

// READOUTS. The value beside a dial or a slider is a data readout: a well
// darker than the ground, its frame lit on the top edge, one cut corner.
let h_readout = fn(p: vec2, o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let kq = vec4(3.0, 0.0, 0.0, 0.0)
    let d = Finish.sd_notch(p, (lo + hi) * 0.5, (hi - lo) * 0.5, kq)
    let ny = h_facing(p, lo, hi, kq, px)
    let inside = Finish.cover(d, px)
    var out = vec4(vec3(0.008, 0.027, 0.043) * inside, inside)
    out = mix(out, vec4(0.03, 0.06, 0.075, 1.0), Finish.band(d, px, 2.0 * px, px) * step(p.y, lo.y + 2.5 * px))
    out = mix(out, vec4(h_ink3(ny, h_side(), h_foot(), h_foot()), 1.0), Finish.band(d, 0.0, px, px))
    return out
}
mod.widgets.RotaryFlat.text_input.min_height = 0.0
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 5.0 right: 5.0 top: 2.0 bottom: 2.0}
mod.widgets.RotaryFlat.text_input.draw_text.color = #b8eef5
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.0}
mod.widgets.RotaryFlat.text_input.draw_selection.color = #0000
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return h_readout(self.pos * self.rect_size, self.rect_pos, self.rect_size, px)
}
// The value inside a slider is bare data in the accent: the field row's
// height must not reach it, or its text drops below the track's line.
mod.widgets.SliderMinimal.text_input.min_height = 0.0
mod.widgets.SliderFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderFlat.text_input.draw_text.color = #36c8dc
mod.widgets.SliderMinimal.text_input.draw_text.color = #36c8dc
mod.widgets.SliderRoundFlat.text_input.draw_text.color = #36c8dc
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.0}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.0}
mod.widgets.ComboBoxFlat.input.min_height = 0.0

// ---------------------------------------------------------------------------
// TEXT FIELDS. A well below the ground in a square frame of the dim line,
// its top edge a step brighter, and four corner brackets 6 points long that
// carry the state: the side line at rest, the top line under the pointer,
// the accent on focus with the short bloom of the one focused thing.
let h_field = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, disabled: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, 0.0)
    let live = 1.0 - disabled
    let hv = hover * live
    let fc = focus * live
    let inside = Finish.cover(d, px)
    let dn = down * live
    // Held, the well lifts a step toward the accent's deep ink.
    let wc = mix(h_well() + vec3(0.004, 0.008, 0.01) * hv * (1.0 - dn) + vec3(0.014, 0.042, 0.050) * dn, vec3(0.012, 0.035, 0.059), disabled)
    var out = vec4(wc * 0.95 * inside, 0.95 * inside)
    let ny = h_facing(p, lo, hi, vec4(0.0, 0.0, 0.0, 0.0), px)
    var lc = h_ink3(ny, h_dim() * 1.3, h_dim(), h_dim() * 0.9)
    lc = Finish.lift(lc, 0.08 * hv)
    lc = mix(lc, h_ink3(ny, h_acc() * 0.5, h_acc() * 0.3, h_acc() * 0.3), dn)
    lc = mix(lc, h_ink3(ny, h_acc() * 0.62, h_acc() * 0.36, h_acc() * 0.36), fc)
    lc = mix(lc, h_dim() * 0.8, disabled)
    let edge = Finish.band(d, 0.0, px, px)
    out = mix(out, vec4(lc, 1.0), edge)
    let br = h_brackets(p, lo, hi, 6.0, px)
    var bc = mix(Finish.lift(h_side(), 0.08), Finish.lift(h_top(), 0.18), hv)
    // Held, the brackets take the accent before the focus lands.
    bc = mix(bc, h_acc(), dn)
    bc = mix(bc, h_acc(), fc)
    bc = mix(bc, h_dim(), disabled)
    out = mix(out, vec4(bc, 1.0), br)
    let ex = min(p.x - lo.x, hi.x - p.x)
    let ey = min(p.y - lo.y, hi.y - p.y)
    let near = (1.0 - smoothstep(5.0, 8.0, ex)) * (1.0 - smoothstep(5.0, 8.0, ey))
    let g = h_glow(d, 0.30 * fc, 3.0) * near * (1.0 - inside)
    return h_add(out, h_halo_ink(d), g)
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(4.0, 4.0), self.rect_size + vec2(8.0, 8.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.border_size < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(8.0, 8.0)) - vec2(4.0, 4.0)
    return h_field(p, self.rect_pos, self.rect_size, px, self.hover, self.down, self.focus, self.disabled)
}
