    return h_field(p, self.rect_pos, self.rect_size, px, self.hover, 0.0, self.focus, self.disabled)
}
// The stepper: its own cell behind a dim divider, split across the middle;
// the half under the pointer takes the accent at a tenth, the held half at
// a fifth, and the arrows are the accent.
mod.widgets.NumberSpin.draw_text.color = #36c8dc
mod.widgets.NumberSpin.draw_text.text_style = mod.theme.font_regular{font_size: 5.5 line_spacing: 1.0}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let mid = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let upper = step(p.y, mid)
    let live = 1.0 - self.disabled
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let down = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let wash = 0.10 * hot + 0.22 * down
    var out = vec4(h_acc() * wash, wash)
    let x0 = Finish.snap(self.rect_pos.x, px) - self.rect_pos.x
    let groove = Finish.cover(abs(p.y - mid - 0.5 * px) - 0.5 * px, px) * step(x0 + 3.0, p.x) * step(p.x, self.rect_size.x - 3.0)
    let side = Finish.cover(abs(p.x - x0 - 0.5 * px) - 0.5 * px, px) * step(4.0, p.y) * step(p.y, self.rect_size.y - 4.0)
    return mix(out, vec4(h_dim(), 1.0), max(groove, side))
}

// DROP-DOWNS. The button's frame and face, cut at the top left only, a dim
// divider 20 points from the right edge and an outlined down triangle in
// the accent in the cell it makes; open, the frame takes the accent and the
// triangle fills.
let h_dropdown = fn(p: vec2, o: vec2, s: vec2, px: float, hover: float, down: float, focus: float, open: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    var f = h_button(p, o, s, px, vec4(1.0, 0.0, 0.0, 0.0), max(hover, open), down * hover, focus, disabled, mix(0.0, 2.0, open))
    let dx = Finish.snap(o.x + s.x - 20.0, px) - o.x
    let div = Finish.cover(abs(p.x - dx - 0.5 * px) - 0.5 * px, px) * step(5.0, p.y) * step(p.y, s.y - 5.0)
    f = mix(f, vec4(mix(h_dim(), h_foot(), hover * live), 1.0), div)
    let c = vec2(s.x - 10.0, Finish.snap(o.y + s.y * 0.5, px) - o.y + 0.5)
    // An outlined triangle 7 wide and 4.5 tall, point down.
    let a = c + vec2(-3.5, -2.25)
    let b = c + vec2(3.5, -2.25)
    let e = c + vec2(0.0, 2.25)
    let t = min(min(h_seg(p, a, b), h_seg(p, b, e)), h_seg(p, e, a))
    let q = p - c
    let inner = step(-2.25, q.y) * step(abs(q.x) * 0.643 + q.y, 2.25 - 0.1)
    let ink = mix(mix(h_acc(), h_bright(), max(hover, open) * live), h_dim(), disabled)
    f = mix(f, vec4(ink, 1.0), Finish.cover(t - 0.5 * px, px))
    return mix(f, vec4(ink, 1.0), inner * open * live)
}
