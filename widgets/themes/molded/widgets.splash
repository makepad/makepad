mod.widgets.Tabs.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
