use mod.prelude.widgets_internal.*

// Light-grey matte moulded plastic, lit from straight above. A control is a
// raised CAP (button, thumb, knob, toggle knob) or a recessed WELL (field,
// track, check box, channel). Caps: a one device pixel hairline, light at the
// top and near black at the foot, a white line just inside the top, a convex
// face and a darker foot. Wells: a dark rim and a shade under the top edge.
// Both sit in a shallow seat: a thin shade above, a crisp white lip below,
// drawn outside the layout box. Every line is one device pixel, snapped.

// A ROW OF FIELDS IS ONE HEIGHT. Left to themselves the library's fields each
// come out at a size of their own -- in the widget catalogue's toolbar the
// search box, the number beside it and the drop down after it stood at three
// different heights -- and a sheet that reshapes the text box alone widens
// that gap instead of closing it. So the box metrics are stated ONCE here and
// handed to each field below, and a field added to the library later joins
// the row by being named here rather than by having these numbers copied
// into it. A field is a WELL and draws its seat (one device row above) and
// its lip (two below) inside its own box, since it clips its own text; so
// the box is 28 and the visible well 26, the height of a button's cap,
// whose seat falls outside its box.
let field_height = 28.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 4.0
// A hairline, for the few stock fields the faces below do not redraw.
let field_border = 0.34

// The room a Fit field takes. A minimum height rather than a height,
// because a line of text is shorter than a row, and the padding with it:
// where a field is Fit, the padding IS its height, and two fields padded
// differently part company again the moment the type grows.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box, and because writing a corner onto a
// draw struct that has no corner would add a slot its shader never reads.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it: a number
// with a stepper, a date, a time. The height is all these take. A padding
// here would NOT hold the line off the box -- each of them measures its
// parts against the turtle's whole rect and draws them from the content
// origin, so the padding displaces the line instead of insetting it, and the
// number came out sitting on the bottom edge with its arrows split around it.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
// The number's box strokes its own hairline and declares no border size.
mod.widgets.NumberField.draw_bg.border_radius = field_radius
// The drag-number's corner is written into its own shader, so it takes the
// room and keeps the box it draws.
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
// A picker is a date field in an anchor: the field inside fills the frame.
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own. It is
// a TextInput, so it inherits the minimum above, and a minimum as tall as the
// whole field, applied inside a well already that tall, pushed the line out
// through the bottom of the box.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #dadbdd

// Plain views stop clipping, so a seat, a lip or a contact shadow may fall
// into the gap beside its control. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points. Ink #1c1e22 is the family's shadow.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let md_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A rounded box with a radius per corner (tl, tr, br, bl).
let md_rbox4 = fn(p: vec2, c: vec2, h: vec2, r4: vec4) -> float {
    let q0 = p - c
    let rt = mix(r4.y, r4.x, step(q0.x, 0.0))
    let rb = mix(r4.z, r4.w, step(q0.x, 0.0))
    let r = clamp(mix(rb, rt, step(q0.y, 0.0)), 0.0, min(h.x, h.y))
    let q = abs(q0) - h + vec2(r, r)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - r
}

// The corners a button group asks for: a corner written as 0 is a square
// join, any other the family's radius.
let md_corners = fn(tl: float, tr: float, br: float, bl: float, r: float) -> vec4 {
    return vec4(mix(r, step(0.5, tl) * r, step(0.0, tl)), mix(r, step(0.5, tr) * r, step(0.0, tr)), mix(r, step(0.5, br) * r, step(0.0, br)), mix(r, step(0.5, bl) * r, step(0.0, bl)))
}

let md_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

let md_grow = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// The housing's texture, in window device pixels: a 45 degree pin-stripe of
// three device pixels rising to the right (sd 0.009) under a free mono grain
// (sd 0.004). `w` is a point in window space.
let md_tex = fn(w: vec2, px: float) -> float {
    let q = w / px
    return 0.013 * cos((floor(q.x) + floor(q.y)) * 2.0943951) + Finish.grain(q, 0.010)
}

// The seat round a cap or a well, outside its edge: a thin shade over the
// upper half, a crisp white lip (one device pixel at 0.9, one at 0.35) under
// the lower half, both fading out toward the middle of the sides.
let md_seat = fn(d: float, yrel: float, hy: float, px: float, shade: float, lip: float) -> vec4 {
    let up = smoothstep(0.0, hy * 0.85, -yrel)
    let low = smoothstep(0.0, hy * 0.85, yrel)
    let sh = (Finish.ring_out(d, 0.0, px, px) + Finish.ring_out(d, px, 1.5, px) * 0.4) * shade * up
    let li = (Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.ring_out(d, px, 2.0 * px, px) * 0.35) * lip * low
    return vec4(0.110 * sh + li, 0.118 * sh + li, 0.133 * sh + li, sh + li)
}

// A cap's face, premultiplied: the hairline (light at the top, near black at
// the foot), the white line inside the top fading over the corner arcs, the
// convex face and the darker foot band. Pressed, the face turns inside out
// and a shade falls in under its top edge.
let md_cap = fn(p: vec2, c: vec2, h: vec2, r4: vec4, px: float, hover: float, press: float, dis: float, tint: vec4) -> vec4 {
    let d = md_rbox4(p, c, h, r4)
    let r = max(max(r4.x, r4.y), max(r4.z, r4.w))
    let yin = p.y - (c.y - h.y)
    let t = clamp(yin / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = mix(mix(vec3(0.961, 0.965, 0.969), vec3(0.886, 0.890, 0.898), clamp(t * 2.0, 0.0, 1.0)), vec3(0.796, 0.800, 0.812), clamp(t * 2.0 - 1.0, 0.0, 1.0))
    let foot = max(2.0, h.y * 0.2)
    face = mix(face, vec3(0.663, 0.671, 0.682), smoothstep(2.0 * h.y - foot, 2.0 * h.y, yin) * 0.6)
    let pf = mix(vec3(0.749, 0.753, 0.765), vec3(0.890, 0.894, 0.902), smoothstep(0.0, 1.0, t))
    face = mix(face, pf, press)
    // a coloured cap is the same plastic dyed: the grey's shading over the hue
    face = mix(face, tint.rgb * (Finish.lum(face) / 0.886), tint.a)
    face = mix(face, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.0), 1.2), 0.0, 1.0) * 0.20 * press)
    face = Finish.lift(face, 0.36 * hover * (1.0 - press))
    face = mix(face, vec3(0.902, 0.906, 0.910), dis)
    let across = 1.0 - smoothstep(h.x - r, h.x - r * 0.15, abs(p.x - c.x))
    let hl = Finish.band(d, px, 2.0 * px, px) * mix(1.0, across, step(0.5, r)) * step(yin, max(r, 2.0 * px))
    face = mix(face, vec3(1.0, 1.0, 1.0), hl * mix(mix(0.85, 0.35, press), 0.4, dis) * mix(1.0, 0.6, tint.a))
    var olc = mix(vec3(0.557, 0.565, 0.576), vec3(0.212, 0.220, 0.231), smoothstep(0.15, 0.85, t))
    olc = mix(olc, tint.rgb * mix(0.62, 0.30, smoothstep(0.15, 0.85, t)), tint.a)
    face = mix(face, olc, Finish.band(d, 0.0, px, px) * mix(1.0, 0.45, dis))
    let a = Finish.cover(d, px)
    return vec4(face * a, a)
}

// The two contact shadows under a riding cap: a tight one and a soft one,
// both cast straight down and gone within three points.
let md_contact = fn(p: vec2, c: vec2, h: vec2, r: float, amt: float) -> vec4 {
    let t = Finish.drop(p, c, h, r, vec2(0.0, 0.8), 0.5) * 0.30 * amt
    let s = Finish.drop(p, c, h, r, vec2(0.0, 1.2), 0.8) * 0.12 * amt
    let a = t + s * (1.0 - t)
    return vec4(0.110 * a, 0.118 * a, 0.133 * a, a)
}

// Focus: one device pixel of lamp orange two points outside the edge.
let md_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0, 2.0 + px, px) * 0.85 * focus
    return vec4(0.918 * f, 0.353 * f, 0.067 * f, f)
}

// The inside of a well: its fill, the shade falling in under the top edge,
// a dark line just inside the top, and the hairline rim.
let md_well_s = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, shade: float, rim: vec3, sigma: float) -> vec3 {
    let d = md_rbox(p, c, h, r)
    let sh = clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.0), sigma), 0.0, 1.0)
    var col = mix(fill, vec3(0.110, 0.118, 0.133), sh * shade)
    let yin = p.y - (c.y - h.y)
    col = mix(col, vec3(0.110, 0.118, 0.133), Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(0.0, h.y, yin)) * 0.35)
    col = mix(col, rim, Finish.band(d, 0.0, px, px))
    return col
}
let md_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, shade: float, rim: vec3) -> vec3 {
    let d = md_rbox(p, c, h, r)
    let sh = clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.0), 1.0), 0.0, 1.0)
    var col = mix(fill, vec3(0.110, 0.118, 0.133), sh * shade)
    let yin = p.y - (c.y - h.y)
    col = mix(col, vec3(0.110, 0.118, 0.133), Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(0.0, h.y, yin)) * 0.35)
    col = mix(col, rim, Finish.band(d, 0.0, px, px))
    return col
}

// An indicator lamp set into a cap or the housing: the plain lamp colour, a
// shade lighter at the centre, a darker rim, a light socket lip under it.
// Unlit it is a grey dimple. `glow` is the halo one device pixel out (held
// at 0.30 or less); it is gone within two points.
let md_led = fn(p: vec2, lc: vec2, rad: float, px: float, ink: vec3, lit: float, glow: float) -> vec4 {
    let q = p - lc
    let d = length(q) - rad
    let k = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let v = clamp(q.y / max(rad, 0.001) * 0.5 + 0.5, 0.0, 1.0)
    let on = mix(Finish.lift(ink, 0.10), ink * 0.80, smoothstep(0.35, 1.0, k))
    let off = mix(vec3(0.540, 0.549, 0.565), vec3(0.620, 0.627, 0.643), v)
    var col = mix(off, on, lit)
    let rim = mix(vec3(0.290, 0.298, 0.314), ink * 0.55, lit)
    col = mix(col, rim, Finish.band(d, 0.0, px, px) * mix(0.9, 0.5, v))
    let a = Finish.cover(d, px)
    let ha = glow * lit * exp(-max(d - px, 0.0) / 0.55) * step(0.0, d) * (1.0 - a)
    var out = vec4(ink * ha, ha)
    let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(-0.2, 0.5, q.y / max(rad, 0.001)) * 0.7
    out = Finish.over(out, vec4(lip, lip, lip, lip))
    return Finish.over(out, vec4(col * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing:
// 0 the seated cap, 1 the cap with a lit orange lamp (primary), 2 the cap
// with its lamp dark (secondary), 4 the cap with a lit red lamp (danger),
// 5 an engraved frame that becomes a cap under the pointer (outline),
// 6 bare until touched (flatter). The quad is grown by `m` for the seat,
// the lip and the focus ring.
let md_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, dis: float, loading: float, anim: float, r4: vec4, kind: float, m: float, tint: vec4) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - dis
    let press = down * live
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = md_rbox4(p, c, h, r4)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if kind < 4.5 {
        out = md_seat(d, p.y - c.y, h.y, px, mix(0.16, 0.08, dis), mix(1.0, 0.5, dis))
        out = Finish.over(out, md_cap(p, c, h, r4, px, hover * live, press, dis, tint))
        if kind > 0.5 {
            let lc = vec2(lo.x + 9.5, c.y)
            let red = step(3.5, kind)
            let ink = mix(vec3(0.918, 0.353, 0.067), vec3(0.910, 0.098, 0.059), red)
            let lit = (1.0 - step(1.5, kind) * step(kind, 2.5)) * live
            out = Finish.over(out, md_led(p, lc, 2.5, px, ink, lit, 0.28))
        }
    } else {
        let bare = step(5.5, kind)
        let show = clamp(hover * live * 0.7 + press, 0.0, 1.0)
        out = md_seat(d, p.y - c.y, h.y, px, 0.16 * show, show)
        out = Finish.over(out, md_cap(p, c, h, r4, px, 0.0, press, dis, tint) * show)
        if bare < 0.5 {
            // at rest an engraved frame: a dark hairline, a white line
            // under its lower half and inside its upper half
            let rest = 1.0 - show
            let fr = Finish.band(d, 0.0, px, px) * mix(0.85, 0.4, dis) * rest
            out = Finish.over(out, vec4(0.416 * fr, 0.424 * fr, 0.439 * fr, fr))
            let li = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.0, h.y * 0.85, p.y - c.y) * 0.85 * rest
            let hl = Finish.band(d, px, 2.0 * px, px) * smoothstep(0.0, h.y * 0.85, c.y - p.y) * 0.6 * rest
            out = Finish.over(out, vec4(li + hl, li + hl, li + hl, li + hl))
        }
    }
    out = Finish.over(out, md_focus(d, px, focus * live))
    // The wait spinner, which the stock face drew and this one must too.
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        sdf.fill(vec4(0.333, 0.341, 0.357, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// Every button template: the root and the sizes share its draw object, so
// they wear the plain cap; the roles are specialised below.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 0.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.Button.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 0.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 1.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 2.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 0.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 4.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 5.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, md_corners(self.border_radius_tl, self.border_radius_tr, self.border_radius_br, self.border_radius_bl, 5.0), 6.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CloseButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.BurgerButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}

// Geometry: one 26 point row, 12 points either side of the label; the lamp
// takes its room from the left padding of the faces that carry one.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
