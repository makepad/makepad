// ---------------------------------------------------------------------------
// CHECK BOXES. A 14 point cap in a seat, white and convex while clear; set,
// it is pressed in and carries an engraved check, dark with a light line
// under it. The quad grows four points for the seat and the focus ring.
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.CheckBoxFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.CheckBoxFlat.draw_bg.size = 14.0
mod.widgets.CheckBoxFlat.min_height = 24.0
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let live = 1.0 - self.disabled
    let x0 = mix(1.0, size.x - sz - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - sz) * 0.5, px)) - o
    let h = vec2(sz * 0.5, sz * 0.5)
    let c = lo + h
    let r = mix(3.0, h.y, step(20.0, self.border_radius))
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / sz, 0.0, 1.0)
    let on = max(self.active, self.mixed)
    let sunk = clamp(on + self.down * live * 0.7, 0.0, 1.0)
    var face = mix(vec3(1.0, 1.0, 1.0), vec3(0.831, 0.835, 0.847), smoothstep(0.0, 1.0, t))
    face = mix(face, mix(vec3(0.722, 0.725, 0.737), vec3(0.863, 0.867, 0.878), t), sunk)
    face = mix(face, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, r, vec2(0.0, 0.8), 0.9), 0.0, 1.0) * 0.22 * sunk)
    face = Finish.lift(face, (0.55 * (1.0 - sunk) + 0.18 * sunk) * self.hover * live)
    face = mix(face, vec3(0.910, 0.914, 0.918), self.disabled * 0.8)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (lo.y + r))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * 0.85 * (1.0 - sunk) * live)
    let rim = mix(mix(vec3(0.478, 0.486, 0.502), vec3(0.290, 0.298, 0.314), t), vec3(0.290, 0.298, 0.314), self.hover * live)
    face = mix(face, rim, Finish.band(d, 0.0, px, px) * mix(1.0, 0.45, self.disabled))
    face = mix(face, vec3(0.784, 0.196, 0.184), Finish.band(d, 0.0, 2.0 * px, px) * self.error)
    // the check, or the mixed dash: a 1.5 point stroke with a light line
    // one device pixel under it
    let k = sz / 14.0
    let m0 = lo + vec2(3.6, 7.2) * k
    let m1 = lo + vec2(6.0, 9.7) * k
    let m2 = lo + vec2(10.5, 4.4) * k
    let ck = min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.75 * k
    let ck_lit = min(md_seg(p - vec2(0.0, px), m0, m1), md_seg(p - vec2(0.0, px), m1, m2)) - 0.75 * k
    let d0 = lo + vec2(4.0, 7.0) * k
    let d1 = lo + vec2(10.0, 7.0) * k
    let dash = md_seg(p, d0, d1) - 0.75 * k
    let dash_lit = md_seg(p - vec2(0.0, px), d0, d1) - 0.75 * k
    let show_ck = self.active * (1.0 - self.mixed)
    let mk = mix(Finish.cover(ck, px) * show_ck, Finish.cover(dash, px), self.mixed)
    let mk_lit = mix(Finish.cover(ck_lit, px) * show_ck, Finish.cover(dash_lit, px), self.mixed)
    face = mix(face, vec3(1.0, 1.0, 1.0), mk_lit * 0.5 * live)
    let ink = mix(mix(vec3(0.204, 0.216, 0.231), vec3(0.784, 0.196, 0.184), self.error), vec3(0.627, 0.635, 0.651), self.disabled)
    face = mix(face, ink, mk)
    let a = Finish.cover(d, px)
    var out = md_seat(d, p.y - c.y, h.y, px, mix(0.16 + 0.12 * self.hover * live, 0.08, self.disabled), mix(1.0, 0.5, self.disabled))
    out = Finish.over(out, vec4(face * a, a))
    return Finish.over(out, md_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// TOGGLES. A 38 by 9 point pill well, grey while off and lit lamp orange
// while on, carrying a 22 by 14 point dished knob that rides on it with its
// contact shadow and an engraved dot toward the free end.
mod.widgets.ToggleFlat.label_walk.margin = mod.turtle.Inset{left: 46.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.ToggleFlat.draw_bg.size = 14.0
mod.widgets.ToggleFlat.min_height = 24.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 2.7143
mod.widgets.ToggleFlat.draw_bg.knob_inset = 7.0
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let tw = 38.0
    let x0 = mix(1.0, size.x - tw - 1.0, self.mark_at_end)
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + (size.y - 14.0) * 0.5, px)) - o
    // the well
    let c = lo + vec2(tw * 0.5, 7.0)
    let h = vec2(tw * 0.5, 4.5)
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let on = self.active
    let grey = mix(vec3(0.659, 0.663, 0.678), vec3(0.800, 0.804, 0.812), self.disabled)
    let lamp = mix(vec3(0.918, 0.353, 0.067), vec3(0.851, 0.694, 0.612), self.disabled)
    var fill = mix(grey, lamp, on)
    // the lit well is a shade deeper in its upper band
    fill = mix(fill, mix(fill, vec3(0.824, 0.325, 0.047), on), 1.0 - smoothstep(-2.5, 0.0, p.y - c.y))
    fill = Finish.lift(fill, 0.26 * self.hover * live)
    let rimc = mix(mix(vec3(0.416, 0.424, 0.439), vec3(0.478, 0.196, 0.047), on), vec3(0.784, 0.196, 0.184), self.error)
    let col = md_well(p, c, h, r, px, fill, mix(0.30, 0.12, self.disabled), rimc)
    let a = Finish.cover(d, px)
    var out = md_seat(d, p.y - c.y, h.y, px, 0.16, mix(1.0, 0.5, self.disabled))
    out = Finish.over(out, vec4(col * a, a))
    // the knob
    let kt = clamp(mix(on, self.drag_pos, self.drag), 0.0, 1.0)
    let kh = vec2(11.0, 7.0)
    let kx = Finish.snap(o.x + lo.x + kt * (tw - 22.0), px) - o.x
    let kc = vec2(kx + 11.0, lo.y + 7.0)
    let kd = md_rbox(p, kc, kh, 7.0)
    let press = self.down * live
    // under the pointer the knob stands a little prouder: its shadow deepens
    out = Finish.over(out, md_contact(p, kc, kh, 7.0, (1.0 + 0.5 * self.hover * live - press * 0.8) * mix(1.0, 0.35, self.disabled)))
    let kt2 = clamp((p.y - (kc.y - 7.0)) / 14.0, 0.0, 1.0)
    // dished: darker at the top, a convex rim ring round it
    var face = mix(vec3(0.776, 0.780, 0.788), vec3(0.933, 0.937, 0.945), smoothstep(0.1, 0.9, kt2))
    let rim_ring = Finish.band(kd, px, px + 1.0, px)
    face = mix(face, mix(vec3(0.980, 0.980, 0.984), vec3(0.878, 0.882, 0.890), kt2), rim_ring)
    face = Finish.lift(face, 0.45 * self.hover * live * (1.0 - press) - 0.10 * press)
    face = mix(face, vec3(0.902, 0.906, 0.910), self.disabled * 0.7)
    // the engraved dot toward the free end
    let dc = kc + vec2(mix(5.5, -5.5, kt), 0.0)
    let dd = length(p - dc) - 1.4
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.ring_out(dd, 0.0, px, px) * step(dc.y, p.y) * 0.8 * live)
    face = mix(face, mix(vec3(0.478, 0.486, 0.502), vec3(0.745, 0.749, 0.761), smoothstep(-1.4, 1.4, p.y - dc.y)), Finish.cover(dd, px) * live)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (kc.y - 3.0))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(kd, px, 2.0 * px, px) * up * 0.85 * live)
    let olc = mix(vec3(0.557, 0.565, 0.576), vec3(0.212, 0.220, 0.231), smoothstep(0.15, 0.85, kt2))
    face = mix(face, olc, Finish.band(kd, 0.0, px, px) * mix(1.0, 0.45, self.disabled))
    let ka = Finish.cover(kd, px)
    out = Finish.over(out, vec4(face * ka, ka))
    return Finish.over(out, md_focus(d, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// RADIOS. The check box made round: a convex white cap while clear; chosen,
// it is pressed in with a dark dot at its centre, lit from below.
let md_radio = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, focus: float, active: float, dis: float) -> vec4 {
    let live = 1.0 - dis
    let q = p - c
    let d = length(q) - rad
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    let sunk = clamp(active + down * live * 0.7, 0.0, 1.0)
    var face = mix(vec3(1.0, 1.0, 1.0), vec3(0.831, 0.835, 0.847), smoothstep(0.0, 1.0, t))
    face = mix(face, mix(vec3(0.722, 0.725, 0.737), vec3(0.863, 0.867, 0.878), t), sunk)
    face = mix(face, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, vec2(rad, rad), rad, vec2(0.0, 0.8), 0.9), 0.0, 1.0) * 0.22 * sunk)
    face = Finish.lift(face, (0.55 * (1.0 - sunk) + 0.18 * sunk) * hover * live)
    face = mix(face, vec3(0.910, 0.914, 0.918), dis * 0.8)
    let up = 1.0 - smoothstep(-0.3, 0.1, q.y / rad)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * 0.85 * (1.0 - sunk) * live)
    // the dot: 0.36 of the diameter, a light line under it
    let dr = rad * 0.36
    let dd = length(q) - dr
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.ring_out(dd, 0.0, px, px) * step(0.0, q.y) * 0.6 * active * live)
    face = mix(face, mix(vec3(0.204, 0.216, 0.231), vec3(0.627, 0.635, 0.651), dis), Finish.cover(dd, px) * active)
    let rim = mix(mix(vec3(0.478, 0.486, 0.502), vec3(0.290, 0.298, 0.314), t), vec3(0.290, 0.298, 0.314), hover * live)
    face = mix(face, rim, Finish.band(d, 0.0, px, px) * mix(1.0, 0.45, dis))
    let a = Finish.cover(d, px)
    var out = md_seat(d, q.y, rad, px, mix(0.16 + 0.12 * hover * live, 0.08, dis), mix(1.0, 0.5, dis))
    out = Finish.over(out, vec4(face * a, a))
    return Finish.over(out, md_focus(d, px, focus * live))
}

mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.RadioButtonFlat.padding = mod.turtle.Inset{left: 0.0 right: 3.0 top: 3.0 bottom: 3.0}
mod.widgets.RadioButtonFlat.label_walk.margin = mod.turtle.Inset{left: 22.0 right: 3.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonFlat.draw_bg.size = 14.0
mod.widgets.RadioButtonFlat.min_height = 24.0
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x + 1.0, px), Finish.snap(o.y + (self.rect_size.y - sz) * 0.5, px)) - o
    let c = lo + vec2(sz * 0.5, sz * 0.5)
    return md_radio(p, c, sz * 0.5, px, self.hover, self.down, self.focus, self.active, self.disabled)
}
// The flatter radio is its word alone: chosen, the word sits in a shallow
// pressed-in pocket; under the pointer the housing lifts behind it.
mod.widgets.RadioButtonFlatter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x - 3.0, px), Finish.snap(o.y + 1.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x + 3.0, px), Finish.snap(o.y + self.rect_size.y - 1.0, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, 4.0)
    let lift = Finish.cover(d, px) * 0.25 * self.hover * live * (1.0 - self.active)
    var out = vec4(lift, lift, lift, lift)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.765, 0.769, 0.780), vec3(0.851, 0.855, 0.863), t)
    col = mix(col, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, 4.0, vec2(0.0, 1.0), 1.0), 0.0, 1.0) * 0.18)
    col = mix(col, vec3(0.416, 0.424, 0.439), Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px) * self.active
    out = Finish.over(out, md_seat(d, p.y - c.y, h.y, px, 0.0, self.active))
    out = Finish.over(out, vec4(col * a, a))
    return Finish.over(out, md_focus(d, px, self.focus * live))
}

// Radio tabs: each a cap of its own; the chosen one is held pressed in.
// The label lays out from the top of the 26 point cap: 6 above it puts
// the capitals on the cap's middle.
mod.widgets.RadioButtonTabFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 6.0 bottom: 2.0}
mod.widgets.RadioButtonTabFlat.label_walk.margin = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.RadioButtonTabFlat.min_height = 26.0
mod.widgets.RadioButtonTabFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RadioButtonTabFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let held = clamp(max(self.active, self.down), 0.0, 1.0)
    return md_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, held, self.focus, self.disabled, 0.0, 0.0, vec4(5.0, 5.0, 5.0, 5.0), 0.0, 4.0, vec4(0.0, 0.0, 0.0, 0.0))
}
mod.widgets.RadioButtonTabFlat.draw_text.color = #4a4d52
mod.widgets.RadioButtonTabFlat.draw_text.color_active = #25282c
mod.widgets.RadioButtonTabFlat.draw_text.color_disabled = #a0a2a6

// ---------------------------------------------------------------------------
// SLIDERS. A 6 point pill well in a seat, the graphite fill inside it, and
// a 22 by 14 point riding thumb with five engraved grip ridges. The quad of
// every slider grows four points for the thumb's contact shadow, the seat
// and the focus ring.
mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}

// The riding pill thumb: contact shadows, two-tone hairline, the white line
// inside the top, a convex face and the grip ridges (a dark and a light
// device pixel on a two point pitch, over the middle 60 % of its height).
let md_thumb = fn(p: vec2, c: vec2, h: vec2, o: vec2, px: float, hover: float, press: float, dis: float, ridges: float) -> vec4 {
    let live = 1.0 - dis
    let r = min(h.x, h.y)
    var out = md_contact(p, c, h, r, (1.0 + 0.5 * hover * live - press * 0.75) * mix(1.0, 0.35, dis))
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - (c.y - h.y)) / (2.0 * h.y), 0.0, 1.0)
    var face = mix(vec3(0.973, 0.976, 0.984), vec3(0.851, 0.855, 0.863), smoothstep(0.05, 1.0, t))
    face = mix(face, vec3(0.690, 0.694, 0.706), smoothstep(0.82, 1.0, t) * 0.45)
    face = mix(face, mix(vec3(0.776, 0.780, 0.792), vec3(0.910, 0.914, 0.922), t), press)
    face = Finish.lift(face, 0.45 * hover * live * (1.0 - press))
    face = mix(face, vec3(0.902, 0.906, 0.910), dis * 0.7)
    if ridges > 0.5 {
        let fi = clamp(floor((p.x - c.x) / 2.0 + 0.5), -(ridges - 1.0) * 0.5, (ridges - 1.0) * 0.5)
        let rx = Finish.snap(o.x + c.x + fi * 2.0 - px, px) - o.x
        let iny = step(abs(p.y - c.y), h.y * 0.6)
        let dk = step(rx, p.x) * step(p.x, rx + px) * iny
        let lt = step(rx + px, p.x) * step(p.x, rx + 2.0 * px) * iny
        face = mix(face, vec3(0.776, 0.780, 0.792), dk * live)
        face = mix(face, vec3(1.0, 1.0, 1.0), lt * 0.6 * live)
    }
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (c.y - h.y * 0.4))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * mix(0.85, 0.35, press) * live)
    let olc = mix(vec3(0.557, 0.565, 0.576), vec3(0.212, 0.220, 0.231), smoothstep(0.15, 0.85, t))
    face = mix(face, olc, Finish.band(d, 0.0, px, px) * mix(1.0, 0.45, dis))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// The track: a pill well in its seat, filled with graphite between `f0`
// and `f1`, the fill a convex strip one device pixel in from the rim.
let md_track = fn(p: vec2, c: vec2, h: vec2, px: float, f0: float, f1: float, well: vec3, dis: float, pale: float) -> vec4 {
    let r = h.y
    let d = md_rbox(p, c, h, r)
    var col = md_well(p, c, h, r, px, well, mix(0.30, 0.12, dis), vec3(0.416, 0.424, 0.439))
    let fh = vec2((f1 - f0) * 0.5 + h.y - px, h.y - px)
    let fc = vec2((f0 + f1) * 0.5, c.y)
    let fd = md_rbox(p, fc, fh, fh.y)
    let ft = clamp((p.y - (fc.y - fh.y)) / max(2.0 * fh.y, 0.5), 0.0, 1.0)
    var fcol = mix(vec3(0.549, 0.557, 0.573), vec3(0.333, 0.341, 0.357), ft)
    fcol = mix(fcol, mix(vec3(0.851, 0.855, 0.867), vec3(0.639, 0.647, 0.663), ft), pale)
    fcol = mix(fcol, vec3(0.200, 0.204, 0.212), Finish.band(fd, 0.0, px, px) * smoothstep(0.5, 0.9, ft))
    fcol = mix(fcol, vec3(1.0, 1.0, 1.0), Finish.band(fd, 0.0, px, px) * (1.0 - smoothstep(0.1, 0.5, ft)) * 0.25)
    fcol = mix(fcol, vec3(0.760, 0.765, 0.776), dis * 0.8)
    col = mix(col, fcol, Finish.cover(fd, px) * step(0.01, f1 - f0 + 0.02))
    let a = Finish.cover(d, px)
    var out = md_seat(d, p.y - c.y, h.y, px, 0.16, mix(1.0, 0.5, dis))
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.SliderFlat.height = 32.0
mod.widgets.SliderFlat.clip_x = false
mod.widgets.SliderFlat.clip_y = false
mod.widgets.SliderFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 8.0, px) - o.y
    let x0 = Finish.snap(o.x + 1.0, px) - o.x
    let x1 = Finish.snap(o.x + size.x - 1.0, px) - o.x
    let w = x1 - x0
    let span = w - 22.0
    let kx = x0 + 11.0 + self.slide_pos * span
    let ox = x0 + 11.0 + self.origin_pos * span
    let f0 = mix(x0 + 3.0, min(ox, kx), self.arc_origin)
    let f1 = mix(kx, max(ox, kx), self.arc_origin)
    let tc = vec2((x0 + x1) * 0.5, cy)
    // under the pointer the well lightens a shade with the thumb
    let well = Finish.lift(vec3(0.659, 0.663, 0.678), 0.22 * max(self.hover, self.drag) * live)
    var out = md_track(p, tc, vec2(w * 0.5, 3.0), px, f0, f1, well, self.disabled, 0.0)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy)
    let kh = vec2(11.0, 7.0)
    out = Finish.over(out, md_thumb(p, kc, kh, o, px, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled, 5.0))
    return Finish.over(out, md_focus(md_rbox(p, kc, kh, 7.0), px, self.focus * live))
}
mod.widgets.SliderFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.75}

// The minimal slider: an engraved hairline groove (a dark device pixel over
// a light one), a graphite thread in it and a small round riding cap.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + size.y - 6.0, px) - o.y
    let kr = 5.0
    let kx = kr + self.slide_pos * (size.x - 2.0 * kr)
    let inx = step(0.0, p.x) * step(p.x, size.x)
    let dark = step(cy - px, p.y) * step(p.y, cy) * inx
    let light = step(cy, p.y) * step(p.y, cy + px) * inx
    let thread = step(cy - 2.0 * px, p.y) * step(p.y, cy) * step(p.x, kx) * inx
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    out = Finish.over(out, vec4(light * 0.8, light * 0.8, light * 0.8, light * 0.8))
    let da = dark * 0.45 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(0.110 * da, 0.118 * da, 0.133 * da, da))
    let tcol = mix(vec3(0.333, 0.341, 0.357), vec3(0.690, 0.694, 0.706), self.disabled)
    out = Finish.over(out, vec4(tcol * thread, thread))
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, cy - 0.5 * px)
    let kh = vec2(kr, kr)
    out = Finish.over(out, md_thumb(p, kc, kh, o, px, self.hover, self.drag * live, self.disabled, 0.0))
    return Finish.over(out, md_focus(length(p - kc) - kr, px, self.focus * live))
}
mod.widgets.SliderMinimal.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.75}

// The round slider: a light pill channel beside its label, a graphite
// capsule in it and a small round riding cap on the capsule's end; the value
// reads on the channel.
mod.widgets.SliderRoundFlat.height = 16.0
mod.widgets.SliderRoundFlat.clip_x = false
mod.widgets.SliderRoundFlat.clip_y = false
mod.widgets.SliderRoundFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderRoundFlat.text_input.margin = mod.turtle.Inset{left: 0.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.width = 30.0
mod.widgets.SliderRoundFlat.text_input.min_height = 0.0
mod.widgets.SliderRoundFlat.text_input.padding = mod.turtle.Inset{left: 0.0 right: 0.0 top: 0.0 bottom: 0.0}
mod.widgets.SliderRoundFlat.text_input.draw_text.text_style = mod.theme.font_regular{font_size: 7.75}
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let y0 = Finish.snap(o.y + 1.0, px) - o.y
    // the channel ends before the value's column (30 wide, 8 from the end)
    let x1 = Finish.snap(o.x + size.x - 44.0, px) - o.x
    let y1 = Finish.snap(o.y + size.y - 1.0, px) - o.y
    let h = vec2((x1 - x0) * 0.5, (y1 - y0) * 0.5)
    let c = vec2(x0, y0) + h
    let ins = 2.0
    let kr = h.y - ins
    let kx = x0 + ins + kr + self.slide_pos * (2.0 * h.x - 2.0 * ins - 2.0 * kr)
    let well = Finish.lift(vec3(0.910, 0.910, 0.914), 0.3 * self.hover * live)
    var out = md_track(p, c, h, px, x0 + ins, kx + kr, well, self.disabled, 1.0)
    let kc = vec2(Finish.snap(o.x + kx, px) - o.x, c.y)
    out = Finish.over(out, md_thumb(p, kc, vec2(kr, kr), o, px, self.hover, self.drag * live, self.disabled, 0.0))
    return Finish.over(out, md_focus(md_rbox(p, c, h, h.y), px, self.focus * live))
}

// ---------------------------------------------------------------------------
// FADERS. A black slot three points wide with a light lip on its lower (or
// right) side, engraved ticks either side, and a riding cap 22 points across
// and 12 along the travel, banded light at the top, a centre line engraved
// across it.
mod.widgets.SliderFader.cap_size = 12.0
mod.widgets.SliderFader.clip_x = false
mod.widgets.SliderFader.clip_y = false
mod.widgets.SliderFader.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let vert = self.is_vertical
    // track space: `a` along the travel from its zero, `b` across
    let a = mix(p.x, size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(size.x, size.y, vert)
    let across = mix(size.y, size.x, vert)
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = floor(across * 0.5 / px) * px
    // the slot
    let sw = 3.0
    let q = vec2(a, b)
    let sc = vec2(along * 0.5, mid)
    let sh = vec2(along * 0.5 - self.inset_px, sw * 0.5)
    let sd = md_rbox(q, sc, sh, 0.5)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let lip = Finish.ring_out(sd, 0.0, px, px) * step(sc.y, b) * 0.6
    out = Finish.over(out, vec4(lip, lip, lip, lip))
    let sa = Finish.cover(sd, px)
    let scol = mix(vec3(0.165, 0.173, 0.188), vec3(0.500, 0.506, 0.518), self.disabled)
    out = Finish.over(out, vec4(scol * sa, sa))
    // the value: a one point graphite line in the slot, from the origin
    // (or the foot) to the cap; flat, no halo
    let va0 = foot + self.fill_lo * travel
    let va1 = foot + self.fill_hi * travel
    let vl = step(va0, a) * step(a, va1) * (1.0 - smoothstep(0.5 - px * 0.5, 0.5 + px * 0.5, abs(b - mid))) * sa * live
    out = Finish.over(out, vec4(0.333 * vl, 0.341 * vl, 0.357 * vl, vl))
    // ticks: a long one every quarter of the travel, a short one between,
    // two points off the slot on both sides
    // three short ones between two long ones, whatever the travel
    let nt = 16.0
    let f = (a - foot) / travel * nt
    let fi = floor(f + 0.5)
    let da = abs(a - (foot + fi / nt * travel))
    let major = 1.0 - step(0.1, abs(fi * 0.25 - floor(fi * 0.25 + 0.5)))
    let tl = mix(3.0, 5.0, major)
    let off = abs(b - mid) - sw * 0.5 - 2.0
    let in_rng = step(-0.5, fi) * step(fi, nt + 0.5)
    let tk = (1.0 - smoothstep(px * 0.5 - 0.01, px * 0.5 + 0.01, da)) * step(0.0, off) * step(off, tl) * in_rng * 0.55 * mix(1.0, 0.5, self.disabled)
    out = Finish.over(out, vec4(0.204 * tk, 0.216 * tk, 0.231 * tk, tk))
    // the cap, drawn in screen space so its light stays on top
    let at = foot + self.slide_pos * travel
    let cw = min(22.0, across)
    let cs = mix(vec2(at, mid), vec2(mid, size.y - at), vert)
    let ch = mix(vec2(self.cap_px * 0.5, cw * 0.5), vec2(cw * 0.5, self.cap_px * 0.5), vert)
    let cc = vec2(Finish.snap(o.x + cs.x, px) - o.x, Finish.snap(o.y + cs.y, px) - o.y)
    let cd = md_rbox(p, cc, ch, 2.0)
    let press = self.drag * live
    out = Finish.over(out, md_contact(p, cc, ch, 2.0, (1.0 - press * 0.6) * mix(1.0, 0.35, self.disabled)))
    let t = clamp((p.y - (cc.y - ch.y)) / (2.0 * ch.y), 0.0, 1.0)
    var face = mix(vec3(0.941, 0.945, 0.949), vec3(0.827, 0.831, 0.843), t)
    face = mix(face, vec3(0.984, 0.984, 0.988), 1.0 - step(0.15, t))
    face = mix(face, vec3(0.749, 0.753, 0.765), step(0.8, t))
    face = Finish.lift(face, 0.25 * max(self.hover, self.focus * 0.5) * live * (1.0 - press) - 0.05 * press)
    face = mix(face, vec3(0.902, 0.906, 0.910), self.disabled * 0.7)
    // the centre line across the cap, engraved
    let ly = Finish.snap(o.y + cc.y, px) - o.y
    let lx = Finish.snap(o.x + cc.x, px) - o.x
    let lin_h = step(ly - px, p.y) * step(p.y, ly) * step(abs(p.x - cc.x), ch.x - 1.0)
    let lit_h = step(ly, p.y) * step(p.y, ly + px) * step(abs(p.x - cc.x), ch.x - 1.0)
    let lin_v = step(lx - px, p.x) * step(p.x, lx) * step(abs(p.y - cc.y), ch.y - 1.0)
    let lit_v = step(lx, p.x) * step(p.x, lx + px) * step(abs(p.y - cc.y), ch.y - 1.0)
    face = mix(face, vec3(0.110, 0.118, 0.133), mix(lin_h, lin_v, 1.0 - vert) * 0.55)
    face = mix(face, vec3(1.0, 1.0, 1.0), mix(lit_h, lit_v, 1.0 - vert) * 0.5)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (cc.y - ch.y + 2.0))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(cd, px, 2.0 * px, px) * up * 0.85 * live)
    let olc = mix(vec3(0.557, 0.565, 0.576), vec3(0.212, 0.220, 0.231), smoothstep(0.15, 0.85, t))
    face = mix(face, olc, Finish.band(cd, 0.0, px, px) * mix(1.0, 0.45, self.disabled))
    let ca = Finish.cover(cd, px)
    out = Finish.over(out, vec4(face * ca, ca))
    return Finish.over(out, md_focus(cd, px, self.focus * live))
}

// ---------------------------------------------------------------------------
// KNOBS. A matte riding cap with its two contact shadows, a two-tone
// hairline, a white arc over its top, a linear face falling from light to
// mid grey with a darker foot, and a concave dimple for the index, turned
// with the value. Round it, a 2 point value arc: the track a faint engraving,
// the value lamp orange, flat, never lit.
let md_knob = fn(p: vec2, c: vec2, rad: float, px: float, ang: float, hover: float, press: float, dis: float) -> vec4 {
    let dia = rad * 2.0
    let hh = vec2(rad, rad)
    let live = 1.0 - dis
    let fade = mix(1.0, 0.35, dis)
    let tight = Finish.drop(p, c, hh, rad, vec2(0.0, max(dia * 0.04, 0.8)), max(dia * 0.02, 0.5)) * 0.30 * fade * (1.0 - press * 0.5)
    let soft = Finish.drop(p, c, hh, rad, vec2(0.0, max(dia * 0.05, 1.2)), max(dia * 0.045, 0.9)) * 0.16 * fade
    let sa = tight + soft * (1.0 - tight)
    var out = vec4(0.110 * sa, 0.118 * sa, 0.133 * sa, sa)
    let q = p - c
    let d = length(q) - rad
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    var face = mix(vec3(0.941, 0.941, 0.945), vec3(0.698, 0.702, 0.714), clamp((t - 0.05) / 0.9, 0.0, 1.0))
    face = mix(face, vec3(0.498, 0.498, 0.498), Finish.band(d, 0.0, dia * 0.06, px) * smoothstep(0.55, 0.95, t) * 0.5)
    face = Finish.lift(face, 0.22 * hover * live * (1.0 - press) - 0.05 * press)
    face = mix(face, vec3(0.890, 0.894, 0.898), dis * 0.7)
    // the dimple: 0.16 of the diameter, 0.33 of it out from the centre
    let dir = vec2(-sin(ang), cos(ang))
    let dc = c + dir * dia * 0.33
    let dr = max(dia * 0.08, 1.5)
    let dq = p - dc
    let dd = length(dq) - dr
    let dim = mix(vec3(0.784, 0.788, 0.796), vec3(0.863, 0.867, 0.875), smoothstep(-dr, dr, dq.y))
    face = mix(face, mix(face, dim, 0.85), Finish.cover(dd, px) * live)
    face = mix(face, vec3(0.557, 0.565, 0.576), Finish.band(dd, 0.0, px, px) * (1.0 - smoothstep(-0.3, 0.3, dq.y / dr)) * 0.7 * live)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.ring_out(dd, 0.0, px, px) * smoothstep(-0.2, 0.4, dq.y / dr) * 0.6 * live)
    // the white arc over the top 120 degrees
    let up = smoothstep(-0.2, -0.6, q.y / rad)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * 0.85 * live)
    let olc = mix(vec3(0.592, 0.592, 0.592), vec3(0.161, 0.161, 0.161), smoothstep(0.15, 0.85, t))
    face = mix(face, olc, Finish.band(d, 0.0, px, px) * mix(1.0, 0.45, dis))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// The value arc: `ar` its middle radius, `aw` its width; the gap is centred
// at the bottom and the value runs clockwise from its left end, or from the
// origin when the knob is bipolar.
let md_arc = fn(p: vec2, c: vec2, ar: float, aw: float, px: float, v0: float, v1: float, gap: float, dis: float) -> vec4 {
    let start = gap * 0.5
    let sweep = 2.0 * PI - gap
    let q = p - c
    var ang = atan2(-q.x, q.y)
    if ang < 0.0 {
        ang = ang + 2.0 * PI
    }
    let rd = abs(length(q) - ar) - aw * 0.5
    let in_arc = step(start, ang) * step(ang, start + sweep)
    let e0 = c + vec2(-sin(start), cos(start)) * ar
    let e1 = c + vec2(-sin(start + sweep), cos(start + sweep)) * ar
    let track_d = min(mix(1000.0, rd, in_arc), min(length(p - e0), length(p - e1)) - aw * 0.5)
    let a0 = start + sweep * v0
    let a1 = start + sweep * v1
    let l0 = c + vec2(-sin(a0), cos(a0)) * ar
    let l1 = c + vec2(-sin(a1), cos(a1)) * ar
    let lit_in = step(a0, ang) * step(ang, a1)
    let lit_d = min(mix(1000.0, rd, lit_in), min(length(p - l0), length(p - l1)) - aw * 0.5)
    let ta = Finish.cover(track_d, px) * 0.13
    var out = vec4(0.110 * ta, 0.118 * ta, 0.133 * ta, ta)
    let lt = Finish.ring_out(track_d, 0.0, px, px) * step(0.0, q.y) * 0.5 * step(length(q), ar + aw)
    out = Finish.over(out, vec4(lt, lt, lt, lt))
    // the value at 0.85: the knob group is the page's accent, not its loudest
    let la = Finish.cover(lit_d, px) * 0.85
    let ink = mix(vec3(0.918, 0.353, 0.067), vec3(0.749, 0.690, 0.659), dis)
    return Finish.over(out, vec4(ink * la, la))
}

mod.widgets.RotaryKnob.clip_x = false
mod.widgets.RotaryKnob.clip_y = false
mod.widgets.RotaryKnob.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let dia = min(size.x, size.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + size.y - dia * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let aw = 2.0
    let ar = floor((rr - aw * 0.5) / px) * px
    let rad = floor(ar / 1.18 / px) * px
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    var out = md_arc(p, c, ar, aw, px, v0, v1, gap, self.disabled)
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, md_knob(p, c, rad, px, ang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, md_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}
// Knob captions are hardware labels: small semibold words in a mid grey.
mod.widgets.RotaryKnob.draw_text.color = #56595d
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_bold{font_size: 7.1}

mod.widgets.RotaryFlat.clip_x = false
mod.widgets.RotaryFlat.clip_y = false
mod.widgets.RotaryFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let room = vec2(size.x, size.y - 24.0)
    let dia = min(room.x, room.y)
    let rr = dia * 0.5 - 1.0
    let c = vec2(Finish.snap(o.x + size.x * 0.5, px) - o.x, Finish.snap(o.y + 24.0 + room.y * 0.5, px) - o.y)
    let gap = self.gap * PI / 180.0
    let aw = 2.0
    let ar = floor((rr - aw * 0.5) / px) * px
    let rad = floor(ar / 1.18 / px) * px
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let v0 = mix(0.0, lo, self.arc_origin)
    let v1 = mix(self.slide_pos, hi, self.arc_origin)
    var out = md_arc(p, c, ar, aw, px, v0, v1, gap, self.disabled)
    let ang = gap * 0.5 + (2.0 * PI - gap) * self.slide_pos
    out = Finish.over(out, md_knob(p, c, rad, px, ang, max(self.hover, self.focus * 0.5), self.drag * live, self.disabled))
    return Finish.over(out, md_focus(length(p - c) - ar - aw * 0.5, px, self.focus * live))
}

// The dial's readout: a small positive liquid-crystal window cut into the
// housing: a dark bezel line, a white glass edge inside it, the grey-green
// glass falling darker toward its foot, and dark digits with no glow.
let md_lcd = fn(p: vec2, size: vec2, o: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, 2.0 * px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = 3.0
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = mix(mix(vec3(0.890, 0.898, 0.882), vec3(0.812, 0.820, 0.800), clamp(t * 2.0, 0.0, 1.0)), vec3(0.706, 0.714, 0.694), clamp(t * 2.0 - 1.0, 0.0, 1.0))
    // a weak sheen across the upper left, cut hard on its diagonal
    let sheen = step((p.x - lo.x) * 0.35 + (p.y - lo.y), h.y * 0.9)
    col = mix(col, vec3(1.0, 1.0, 1.0), sheen * 0.10)
    col = mix(col, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * 0.70)
    col = mix(col, vec3(0.110, 0.118, 0.133), Finish.band(d, 0.0, px, px) * 0.75)
    let a = Finish.cover(d, px)
    var out = md_seat(d, p.y - c.y, h.y, px, 0.16, 1.0)
    return Finish.over(out, vec4(col * a, a))
}
mod.widgets.RotaryFlat.text_input.padding = mod.turtle.Inset{left: 5.0 right: 5.0 top: 2.0 bottom: 2.0}
mod.widgets.RotaryFlat.text_input.min_height = 20.0
mod.widgets.RotaryFlat.text_input.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_lcd(self.pos * self.rect_size, self.rect_size, self.rect_pos, px)
}
mod.widgets.RotaryFlat.text_input.draw_text.color = #3a3d3f
mod.widgets.RotaryFlat.text_input.draw_text.color_hover = #3a3d3f
mod.widgets.RotaryFlat.text_input.draw_text.color_focus = #3a3d3f
mod.widgets.RotaryFlat.text_input.draw_text.color_empty = #6c6f73
mod.widgets.RotaryFlat.text_input.draw_text.text_style = mod.theme.font_label{font_size: 9.25}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A white well: a dark rim (darker along the top), a shade
// falling in under the top edge, a dark line inside the top. A field clips
// its own text, so its seat and lip are drawn in its own first and last
// device rows, and the focus ring lies inside the rim.
let md_field = fn(p: vec2, size: vec2, o: vec2, px: float, hover: float, focus: float, dis: float, r: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, 2.0 * px)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let well = mix(Finish.lift(vec3(0.969, 0.969, 0.973), 0.6 * hover), vec3(0.933, 0.937, 0.941), dis)
    var rim = mix(vec3(0.306, 0.314, 0.329), vec3(0.416, 0.424, 0.439), smoothstep(0.0, 0.6, t))
    rim = mix(rim, vec3(0.337, 0.345, 0.361), hover * (1.0 - dis))
    rim = mix(rim, vec3(0.306, 0.314, 0.329), focus)
    rim = mix(rim, vec3(0.663, 0.671, 0.682), dis)
    // the shade falls about four device rows in, as in the reference well
    var col = md_well_s(p, c, h, r, px, well, mix(0.32, 0.10, dis), rim, 1.5)
    col = mix(col, vec3(0.918, 0.353, 0.067), Finish.band(d, px, 2.0 * px, px) * focus * 0.85)
    let a = Finish.cover(d, px)
    var out = md_seat(d, p.y - c.y, h.y, px, 0.16, mix(1.0, 0.5, dis))
    return Finish.over(out, vec4(col * a, a))
}

mod.widgets.TextInputFlat.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    // The value field inside a slider or a well draws no box of its own.
    if self.color.a < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 4.0)
}
mod.widgets.TextInputFlat.draw_text.color_empty = #6c6f73
mod.widgets.TextInputFlat.draw_text.color_disabled = #a0a2a6
mod.widgets.TextInputFlat.draw_cursor.color = #34373b

// NUMBER FIELDS. The white well, and on its right a 14 point cap column,
// split by an engraved line, each half with a small engraved triangle; the
// half under the pointer lifts, the held half is pressed in.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_field(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, self.hover, self.focus, self.disabled, 4.0)
}
mod.widgets.NumberField.pad_left = 8.0
mod.widgets.NumberSpin.width = 14.0
mod.widgets.NumberSpin.draw_text.color = #00000000
mod.widgets.NumberSpin.draw_text.color_disabled = #00000000
let md_tri = fn(p: vec2, c: vec2, hw: float, hh: float, dir: float) -> float {
    // a triangle hw wide either side, 2 hh tall, apex up (dir -1) or down (1)
    let y = (p.y - c.y) * dir
    let e = (abs(p.x - c.x) * 2.0 * hh + hw * (y - hh)) / sqrt(4.0 * hh * hh + hw * hw)
    return max(-hh - y, e)
}
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o - vec2(0.0, 2.0 * px)
    let mid = Finish.snap(o.y + (lo.y + hi.y) * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), upper) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), upper) * live
    // each half is a cap of its own, square where it meets the well
    let hc = vec2((lo.x + hi.x) * 0.5, mix((mid + hi.y) * 0.5, (lo.y + mid) * 0.5, upper))
    let hh = vec2((hi.x - lo.x) * 0.5, mix((hi.y - mid) * 0.5, (mid - lo.y) * 0.5, upper))
    let cap = md_cap(p, hc, hh, vec4(0.0, 0.0, 0.0, 0.0), px, hot, dn, self.disabled, vec4(0.0, 0.0, 0.0, 0.0))
    // the outer corners follow the field's radius
    let outer = md_rbox(p, (lo + hi) * 0.5 - vec2(3.0, 0.0), (hi - lo) * 0.5 + vec2(3.0, 0.0), 4.0)
    var out = cap * Finish.cover(outer, px)
    // the engraved triangles, 6 by 3.5 points, a light line under each
    let cx = (lo.x + hi.x) * 0.5
    let tu = md_tri(p, vec2(cx, (lo.y + mid) * 0.5 + dn * px * upper), 3.0, 1.75, -1.0)
    let td = md_tri(p, vec2(cx, (mid + hi.y) * 0.5 + dn * px * (1.0 - upper)), 3.0, 1.75, 1.0)
    let tl = Finish.cover(min(md_tri(p - vec2(0.0, px), vec2(cx, (lo.y + mid) * 0.5), 3.0, 1.75, -1.0), md_tri(p - vec2(0.0, px), vec2(cx, (mid + hi.y) * 0.5), 3.0, 1.75, 1.0)), px) * 0.5 * live
    out = Finish.over(out, vec4(tl, tl, tl, tl))
    let ti = Finish.cover(min(tu, td), px)
    let ink = mix(vec3(0.420, 0.427, 0.443), vec3(0.690, 0.694, 0.706), self.disabled)
    return Finish.over(out, vec4(ink * ti, ti))
}

// The drag-number: the white well, its track a pale wash behind dark digits.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var out = md_field(p, self.rect_size, self.rect_pos, px, max(self.hover, self.drag), self.focus, 0.0, 4.0)
    let d = md_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(2.0 * px, 2.0 * px), 3.0)
    let wx = 2.0 * px + (self.rect_size.x - 4.0 * px) * max(self.fill, 0.0)
    let wash = step(0.0, self.fill) * step(p.x, wx) * Finish.cover(d, px) * 0.10
    return Finish.over(out, vec4(0.110 * wash, 0.118 * wash, 0.133 * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #34373b
mod.widgets.ValueInput.draw_text.text_style = mod.theme.font_label{font_size: 8.5 line_spacing: 1.0}
mod.widgets.ValueInput.arrow_color = #707377
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// ---------------------------------------------------------------------------
// DROP-DOWNS. The button stack with a 22 point arrow cell on the right, set
// off by an engraved divider; the arrow is a small engraved triangle. Open,
// the cap is held pressed in.
// `ins` 1: the drop-down stands in the field row, whose box is two points
// taller than a cap for the seat and lip a well keeps inside; its cap takes
// the well's rows (one device pixel in at the top, two at the foot), so it
// stands as tall as the fields and the buttons beside it.
let md_dropdown = fn(pos0: vec2, size0: vec2, o0: vec2, px: float, hover: float, held: float, focus: float, dis: float, ins: float) -> vec4 {
    let m = 4.0
    let p = pos0 * (size0 + vec2(2.0 * m, 2.0 * m)) - vec2(m, m) - vec2(0.0, px * ins)
    let size = size0 - vec2(0.0, 3.0 * px * ins)
    let o = o0 + vec2(0.0, px * ins)
    let pos = (p + vec2(m, m)) / (size + vec2(2.0 * m, 2.0 * m))
    var out = md_button(pos, size, o, px, hover, held, focus, dis, 0.0, 0.0, vec4(5.0, 5.0, 5.0, 5.0), 0.0, m, vec4(0.0, 0.0, 0.0, 0.0))
    let live = 1.0 - dis
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.15, p.y) * step(p.y, size.y * 0.85)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * mix(0.75, 0.35, dis)
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.8
    out = Finish.over(out, vec4(0.416 * div_d, 0.416 * div_d, 0.424 * div_d, div_d))
    out = Finish.over(out, vec4(0.886 * div_l, 0.886 * div_l, 0.894 * div_l, div_l))
    let dn = held * live * px
    let cc = vec2(Finish.snap(o.x + size.x - 11.0, px) - o.x, size.y * 0.5 + dn)
    let lit = Finish.cover(md_tri(p - vec2(0.0, px), cc, 3.5, 2.0, 1.0), px) * 0.5 * live
    out = Finish.over(out, vec4(lit, lit, lit, lit))
    let tri = Finish.cover(md_tri(p, cc, 3.5, 2.0, 1.0), px)
    let ink = mix(vec3(0.420, 0.427, 0.443), vec3(0.690, 0.694, 0.706), dis)
    return Finish.over(out, vec4(ink * tri, tri))
}

mod.widgets.DropDownFlat.padding = mod.turtle.Inset{left: 8.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.DropDown.padding = mod.turtle.Inset{left: 8.0 right: 30.0 top: 4.0 bottom: 4.0}
