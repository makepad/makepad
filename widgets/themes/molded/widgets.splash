mod.widgets.Select.face.padding.right = 30.0
mod.widgets.MultiSelect.face.padding.right = 30.0

// The combo box: the white well one types into, with a cap for its arrow
// joined at the right end behind an engraved divider.
mod.widgets.ComboBox.padding = mod.turtle.Inset{left: 8.0 right: 30.0 top: 4.0 bottom: 4.0}
mod.widgets.ComboBox.input.min_height = 0.0
mod.widgets.ComboBox.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let size = self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    var out = md_field(p, size, o, px, self.hover, self.focus, self.disabled, 4.0)
    let lo = vec2(Finish.snap(o.x + size.x - 22.0, px), Finish.snap(o.y, px)) - o + vec2(0.0, px)
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o - vec2(0.0, 2.0 * px)
    let kh = (hi - lo) * 0.5
    let kc = lo + kh
    let held = self.down * self.hover * live
    let cap = md_cap(p, kc, kh, vec4(0.0, 0.0, 0.0, 0.0), px, self.hover * live, held, self.disabled, vec4(0.0, 0.0, 0.0, 0.0))
    let outer = md_rbox(p, kc - vec2(3.0, 0.0), kh + vec2(3.0, 0.0), 4.0)
    out = Finish.over(out, cap * Finish.cover(outer, px))
    let cc = vec2(kc.x, kc.y + held * px)
    let lit = Finish.cover(md_tri(p - vec2(0.0, px), cc, 3.5, 2.0, 1.0), px) * 0.5 * live
    out = Finish.over(out, vec4(lit, lit, lit, lit))
    let tri = Finish.cover(md_tri(p, cc, 3.5, 2.0, 1.0), px)
    let ink = mix(vec3(0.420, 0.427, 0.443), vec3(0.690, 0.694, 0.706), self.disabled)
    return Finish.over(out, vec4(ink * tri, tri))
}

// ---------------------------------------------------------------------------
// SEGMENTS AND TABS. One cap across the strip; the chosen segment is pressed
// in, with an engraved line at each side where it meets its neighbours.
let md_strip = fn(p: vec2, size: vec2, o: vec2, px: float, m: float) -> vec4 {
    let q = p
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = md_rbox(q, c, h, 5.0)
    var out = md_seat(d, q.y - c.y, h.y, px, 0.16, 1.0)
    return Finish.over(out, md_cap(q, c, h, vec4(5.0, 5.0, 5.0, 5.0), px, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0)))
}
// The chosen cell of a strip: pressed in, filling the strip from one device
// pixel under its top outline to one above its foot, square at its sides
// (the joins with its neighbours), no outline of its own; each side is the
// strip's engraved divider pair, a mid grey device column and a pale one.
// `lo` and `hi` are the cell's corners in the quad's own points.
let md_cell = fn(p: vec2, lo: vec2, hi: vec2, px: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = md_rbox(p, c, h, 0.0)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.722, 0.725, 0.737), vec3(0.882, 0.886, 0.894), smoothstep(0.0, 1.0, t))
    // the shade under the top edge only: the sides are joins, not walls
    let top = clamp(Finish.inset(p, c + vec2(0.0, 0.0), h + vec2(4.0, 0.0), 0.0, vec2(0.0, 1.0), 1.2), 0.0, 1.0)
    face = mix(face, vec3(0.110, 0.118, 0.133), top * 0.20)
    let a = Finish.cover(d, px)
    let lx = p.x - lo.x
    let rx = hi.x - p.x
    let dk = (step(0.0, lx) * step(lx, px) + step(px, rx) * step(rx, 2.0 * px)) * a
    let lt = (step(px, lx) * step(lx, 2.0 * px) + step(0.0, rx) * step(rx, px)) * a
    face = mix(face, vec3(0.702, 0.706, 0.714), dk)
    face = mix(face, vec3(0.859, 0.863, 0.871), lt)
    return vec4(face * a, a)
}

mod.widgets.SegmentedControlFlat.segment_height = 22.0
mod.widgets.SegmentedControlFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_strip(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 0.0)
}
// The pill is the segment's own box, two points in from the strip on every
// side: its quad grows two points up and down so the cell reaches the
// strip's outline. The widget does not say which segment is first or last,
// so the cell keeps the segment's width and its sides stay square.
mod.widgets.SegmentedControlFlat.draw_pill.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(0.0, 2.0), self.rect_size + vec2(0.0, 4.0))
}
mod.widgets.SegmentedControlFlat.draw_pill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let p = self.pos * (size + vec2(0.0, 4.0)) - vec2(0.0, 2.0)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y - 2.0, px) + px) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y + 2.0, px) - px) - o
    return md_cell(p, lo, hi, px)
}
mod.widgets.SegmentedControlFlat.draw_text.color = #4a4d52
mod.widgets.SegmentedControlFlat.draw_text_selected.color = #25282c

// The tab strip: the same cap; the tab in use is the pressed-in segment,
// a hovered tab lifts a little, the quiet ones are split by engraved lines.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return md_strip(self.pos * self.rect_size, self.rect_size, self.rect_pos, px, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let h = self.rect_size * 0.5 - vec2(px, 2.0 * px)
    let d = md_rbox(p, self.rect_size * 0.5, h, 3.0)
    let a = Finish.cover(d, px) * 0.22
    return vec4(a, a, a, a)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let o = self.rect_pos
    let size = self.rect_size
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px) + px) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px) - px) - o
    return md_cell(self.pos * size, lo, hi, px)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let x = self.pos.x * self.rect_size.x
    // the strip's divider pair, the same as at the sides of the chosen cell
    let dk = step(x, px)
    let lt = step(px, x) * step(x, 2.0 * px)
    return vec4(0.702 * dk + 0.859 * lt, 0.706 * dk + 0.863 * lt, 0.714 * dk + 0.871 * lt, dk + lt)
}
mod.widgets.Tabs.draw_mark.color = #4a4d52
mod.widgets.Tabs.draw_mark.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let c = vec2(Finish.snap(o.x + self.rect_size.x * 0.5, px), Finish.snap(o.y + self.rect_size.y * 0.5, px)) - o
    // 7 points across, a 1 point stroke; the plus is the cross turned
    let a = mix(0.7853981634, 0.0, self.plus)
    let r = mix(3.4, 3.5, self.plus)
    let u = vec2(cos(a), sin(a)) * r
    let v = vec2(-sin(a), cos(a)) * r
    let dd = min(md_seg(p, c - u, c + u), md_seg(p, c - v, c + v)) - 0.5
    let dl = min(md_seg(p - vec2(0.0, px), c - u, c + u), md_seg(p - vec2(0.0, px), c - v, c + v)) - 0.5
    let l = Finish.cover(dl, px) * 0.5 * self.color.a
    let k = Finish.cover(dd, px) * self.color.a
    return Finish.over(vec4(l, l, l, l), vec4(self.color.rgb * k, k))
}
mod.widgets.Tabs.draw_text.color = #4a4d52
mod.widgets.Tabs.draw_text_active.color = #25282c
// The strip centres a 14 point line box, which leaves the capitals high in
// a 26 point cap: they are dropped to the cap's middle.
mod.widgets.Tabs.draw_text.text_style.top_drop = 0.22
mod.widgets.Tabs.draw_text_active.text_style.top_drop = 0.22

// ---------------------------------------------------------------------------
// PROGRESS. An 8 point pill channel lighter than the housing, in its seat;
// the value a convex graphite strip with a dark foot line. The unknown value
// is a still 45 degree hatch across the whole channel: a face may not run a
// clock.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.draw_bg.thickness = 8.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 2.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 2.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let th = min(self.thickness, size.y)
    let top = Finish.snap(o.y + (size.y - th) * 0.5, px) - o.y
    let bot = Finish.snap(o.y + (size.y + th) * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + size.x * self.start, px) - o.x
    let x1 = Finish.snap(o.x + size.x * self.end, px) - o.x
    let h = vec2((x1 - x0) * 0.5, (bot - top) * 0.5)
    let c = vec2(x0, top) + h
    let r = h.y
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - top) / max(bot - top, 1.0), 0.0, 1.0)
    let dis = step(4.5, self.intent)
    // the channel
    var col = mix(vec3(0.910, 0.910, 0.914), vec3(0.933, 0.937, 0.941), dis)
    col = mix(col, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, r, vec2(0.0, 0.6), 0.6), 0.0, 1.0) * 0.15)
    let rim = mix(vec3(0.557, 0.565, 0.576), vec3(0.690, 0.698, 0.710), smoothstep(0.2, 0.8, t))
    col = mix(col, rim, Finish.band(d, 0.0, px, px))
    // the value
    var v0 = x0
    var v1 = x0 + (x1 - x0) * clamp(self.value, 0.0, 1.0)
    var hatch = 0.0
    var pale = 0.0
    if self.value < 0.0 {
        v1 = x1
        pale = 1.0
        hatch = Finish.stripes(p + o, 0.785398, 7.0, 0.5, px)
    }
    let fh = vec2(max((v1 - v0) * 0.5 - px, 0.0), h.y - px)
    let fc = vec2((v0 + v1) * 0.5, c.y)
    let fd = md_rbox(p, fc, fh, min(fh.y, fh.x + fh.y))
    var ink = mix(vec3(0.655, 0.659, 0.667), vec3(0.267, 0.271, 0.278), smoothstep(0.0, 1.0, t))
    if self.intent > 0.5 {
        let ic = self.fill_color().rgb
        ink = mix(Finish.lift(ic, 0.25), ic * 0.8, t)
    }
    ink = mix(ink, vec3(0.780, 0.784, 0.792), dis)
    ink = mix(ink, mix(vec3(0.886, 0.890, 0.898), vec3(0.753, 0.757, 0.765), hatch), pale)
    ink = mix(ink, vec3(0.200, 0.204, 0.212), Finish.band(fd, 0.0, px, px) * smoothstep(0.55, 0.9, t))
    ink = mix(ink, vec3(1.0, 1.0, 1.0), Finish.band(fd, 0.0, px, px) * (1.0 - smoothstep(0.1, 0.45, t)) * 0.25)
    col = mix(col, ink, Finish.cover(fd, px) * step(0.01, v1 - v0))
    let a = Finish.cover(d, px) * self.track
    var out = md_seat(d, p.y - c.y, h.y, px, 0.14 * self.track, self.track)
    out = Finish.over(out, vec4(col * a, a))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// LEVEL METERS. A 6 point well of cells 4 points long with a point between:
// unlit cells the dark track grey, lit ones flat green, then orange from 70 %
// and red from 90 %, a faint light line along their top; no halo. The hold
// is a dark hairline pair; the over lamp a red lamp, a grey dimple until it
// latches.
mod.widgets.LevelMeter.height = 8.0
mod.widgets.LevelMeterColumn.width = 8.0
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.vertical
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let a = mix(p.x, self.rect_size.y - p.y, vert)
    let b = mix(p.y, p.x, vert)
    let q = vec2(a, b)
    let th = min(6.0, across - 2.0)
    let lamp_room = self.lamp * (th + 4.0)
    let bar = max(4.0, along - lamp_room)
    let h = vec2(bar * 0.5, th * 0.5)
    let c = vec2(h.x, across * 0.5)
    let r = 1.5
    let d = md_rbox(q, c, h, r)
    let pad = 1.0
    let span = max(1.0, bar - pad * 2.0)
    let share = clamp((a - pad) / span, 0.0, 1.0)
    let pitch = 5.0
    let cell = fract((a - pad) / pitch)
    let in_cell = step(cell, 4.0 / pitch)
    let lit = step(a, pad + span * self.level) * step(pad, a) * in_cell
    let ramp = mix(mix(vec3(0.247, 0.749, 0.353), vec3(0.918, 0.353, 0.067), step(0.7, share)), vec3(0.949, 0.361, 0.345), step(0.9, share))
    let well = vec3(0.659, 0.663, 0.678)
    var fill = mix(well, ramp, lit)
    let cell_row = in_cell * step(pad, a) * step(a, pad + span)
    fill = mix(fill, well * 0.93, (1.0 - cell_row) * (1.0 - lit))
    let bt = b - (c.y - h.y)
    fill = mix(fill, vec3(1.0, 1.0, 1.0), lit * step(px, bt) * step(bt, 2.0 * px) * 0.25)
    var col = md_well(q, c, h, r, px, fill, 0.25, vec3(0.416, 0.424, 0.439))
    if self.hold > 0.002 {
        let at = pad + span * self.hold
        let hm = step(abs(a - at), px) * step(abs(b - c.y), h.y)
        col = mix(col, vec3(0.200, 0.204, 0.212), hm)
    }
    let ca = Finish.cover(d, px)
    var out = md_seat(d, b - c.y, h.y, px, 0.14, 1.0)
    out = Finish.over(out, vec4(col * ca, ca))
    if self.lamp > 0.5 {
        let la = bar + 2.0 + th * 0.5 + 1.0
        let lc = vec2(mix(la, across * 0.5, vert), mix(across * 0.5, self.rect_size.y - la, vert))
        out = Finish.over(out, md_led(p, lc, 2.5, px, vec3(0.910, 0.098, 0.059), step(0.5, self.over), 0.28))
    }
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// SCROLL BARS. A 10 point well the length of the view, and an 8 point
// riding pill thumb in it with three engraved grip ridges across its middle.
mod.widgets.ScrollBar.bar_size = 10.0
mod.widgets.ScrollBar.bar_side_margin = 0.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let vert = self.is_vertical
    let a = mix(p.x, p.y, vert)
    let b = mix(p.y, p.x, vert)
    let along = mix(self.rect_size.x, self.rect_size.y, vert)
    let across = mix(self.rect_size.y, self.rect_size.x, vert)
    let q = vec2(a, b)
    let sh = vec2(along * 0.5, across * 0.5 - px * 0.5)
    let sc = sh
    let sd = md_rbox(q, sc, sh, sh.y)
    var col = vec3(0.812, 0.816, 0.827)
    col = mix(col, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(q, sc, sh, sh.y, vec2(0.0, 0.5), 0.6), 0.0, 1.0) * 0.18)
    col = mix(col, vec3(0.557, 0.565, 0.576), Finish.band(sd, 0.0, px, px) * 0.6)
    let sa = Finish.cover(sd, px)
    var out = vec4(col * sa, sa)
    // the thumb
    let t0 = along * self.norm_scroll
    let tl = along * self.norm_handle
    let th = vec2(max(tl * 0.5 - 1.0, 4.0), 4.0)
    let tc = vec2(t0 + tl * 0.5, sc.y)
    let td = md_rbox(q, tc, th, 4.0)
    let con = Finish.drop(q, tc, th, 4.0, vec2(0.0, 0.5), 0.35) * 0.30
    out = Finish.over(out, vec4(0.110 * con, 0.118 * con, 0.133 * con, con))
    let tt = clamp((b - (tc.y - th.y)) / 8.0, 0.0, 1.0)
    var face = mix(vec3(0.957, 0.961, 0.965), vec3(0.839, 0.843, 0.855), tt)
    face = Finish.lift(face, 0.3 * self.hover - 0.06 * self.drag)
    // grip: three ridges across the middle, on a two point pitch
    let fi = clamp(floor((a - tc.x) / 2.0 + 0.5), -1.0, 1.0)
    let rx = floor((tc.x + fi * 2.0) / px) * px
    let inb = step(abs(b - tc.y), 2.5)
    face = mix(face, vec3(0.776, 0.780, 0.792), step(rx - px, a) * step(a, rx) * inb)
    face = mix(face, vec3(1.0, 1.0, 1.0), step(rx, a) * step(a, rx + px) * inb * 0.6)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(td, px, 2.0 * px, px) * (1.0 - tt) * 0.8)
    let olc = mix(vec3(0.557, 0.565, 0.576), vec3(0.212, 0.220, 0.231), smoothstep(0.15, 0.85, tt))
    face = mix(face, olc, Finish.band(td, 0.0, px, px))
    let ta = Finish.cover(td, px)
    out = Finish.over(out, vec4(face * ta, ta))
    return out * self.opacity
}

// ---------------------------------------------------------------------------
// VIEWS AND PANELS. A raised plate: a two-tone hairline, the white line
// inside its top, a face a shade above the housing with the housing's own
// texture, and a tight contact shadow under it. The sunken panel is a flush
// well: its seat and lip, a shade under its top edge, a quiet rim.
let md_plate = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, sunken: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    if sunken > 0.5 {
        out = md_seat(d, p.y - c.y, h.y, px, 0.16, 1.0)
        var face = vec3(0.827, 0.831, 0.839) + g3(md_tex(p + o, px))
        face = mix(face, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, r, vec2(0.0, 1.2), 1.6), 0.0, 1.0) * 0.20)
        face = mix(face, vec3(0.110, 0.118, 0.133), Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(0.0, 0.3, t)) * 0.25)
        face = mix(face, mix(vec3(0.494, 0.502, 0.518), vec3(0.604, 0.612, 0.627), t), Finish.band(d, 0.0, px, px))
        let a = Finish.cover(d, px)
        return Finish.over(out, vec4(face * a, a))
    }
    let tight = Finish.drop(p, c, h, r, vec2(0.0, 1.0), 0.5) * 0.22
    let soft = Finish.drop(p, c, h, r, vec2(0.0, 1.6), 1.2) * 0.09
    let sa = tight + soft * (1.0 - tight)
    out = vec4(0.110 * sa, 0.118 * sa, 0.133 * sa, sa)
    var face = mix(vec3(0.894, 0.898, 0.906), vec3(0.859, 0.863, 0.871), t) + g3(md_tex(p + o, px))
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - (lo.y + r))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * up * 0.7)
    face = mix(face, mix(vec3(0.639, 0.647, 0.659), vec3(0.490, 0.502, 0.518), smoothstep(0.1, 0.9, t)), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    return md_plate(p, self.rect_size, self.rect_pos, px, 6.0, self.sunken)
}

// The card is the raised plate too; its palette and shadow numbers from
// Rust are not read. It lifts a little under the pointer.
mod.widgets.Card.radius = 6.0
mod.widgets.Card.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    return self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    var out = md_plate(p, self.rect_size, self.rect_pos, px, 6.0, 0.0)
    let d = md_rbox(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(px, px), 6.0)
    let l = Finish.cover(d, px) * (0.12 * self.hover - 0.04 * self.down)
    return Finish.over(out, vec4(max(l, 0.0), max(l, 0.0), max(l, 0.0), abs(l)))
}

// The plain rounded view keeps the colours its caller gives it; the edge is
// a snapped hairline at the true radius.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, max(self.border_radius, 1.0))
    var col = fill
    if self.border_size > 0.0 {
        col = mix(col, self.border_color, Finish.band(d, 0.0, max(self.border_size, px), px) * self.border_color.a)
    }
    let a = Finish.cover(d, px) * col.a
    return vec4(col.rgb * a, a)
}

// ---------------------------------------------------------------------------
// LISTS. Rows of 22 points on the housing, split by a faint hairline; a
// hovered row darkens a shade; the chosen row is pressed into the housing,
// a grey strip with a shade under its top edge, ending short of the scroll
// bar.
mod.widgets.ListItemOne.height = 22.0
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 8.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o
    let lay = (self.hover * 0.035 + self.down * 0.05) * live
    var out = vec4(0.110 * lay, 0.118 * lay, 0.133 * lay, lay)
    if self.selected > 0.5 {
        let h = vec2((hi.x - lo.x) * 0.5 - 6.0, (hi.y - lo.y) * 0.5 - px)
        let c = vec2(lo.x + h.x + 1.0, (lo.y + hi.y) * 0.5)
        let d = md_rbox(p, c, h, 3.0)
        let t = clamp((p.y - (c.y - h.y)) / (2.0 * h.y), 0.0, 1.0)
        var col = mix(vec3(0.800, 0.804, 0.812), vec3(0.753, 0.757, 0.765), t)
        col = mix(col, vec3(0.110, 0.118, 0.133), clamp(Finish.inset(p, c, h, 3.0, vec2(0.0, 1.0), 1.0), 0.0, 1.0) * 0.18)
        col = mix(col, mix(vec3(0.439, 0.447, 0.463), vec3(0.557, 0.565, 0.576), t), Finish.band(d, 0.0, px, px) * 0.8)
        let a = Finish.cover(d, px)
        out = Finish.over(out, md_seat(d, p.y - c.y, h.y, px, 0.0, 0.9))
        out = Finish.over(out, vec4(col * a, a))
    }
    let yb = hi.y
    let dk = step(yb - px, p.y) * step(p.y, yb) * 0.07 * (1.0 - self.selected)
    out = Finish.over(out, vec4(0.110 * dk, 0.118 * dk, 0.133 * dk, dk))
    return out
}
mod.widgets.ListItem.draw_text.color = #34373b

// The open list of a drop-down: a raised plate with a soft drop shadow; the
// row under the pointer takes the grey pair, the chosen row an engraved
// check.
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 6.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 6.0
    let size = self.rect_size
    let p = self.pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, 5.0)
    let sh = Finish.drop(p, c, h, 5.0, vec2(0.0, 2.0), 2.0) * 0.16
    var out = vec4(0.110 * sh, 0.118 * sh, 0.133 * sh, sh)
    var face = vec3(0.890, 0.894, 0.902) + g3(md_tex(p + o, px))
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(-0.5, 0.5, p.y - (lo.y + 5.0))) * 0.7)
    face = mix(face, vec3(0.416, 0.424, 0.439), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let h = c - vec2(2.0, 0.5)
    let d = md_rbox(p, c, h, 3.0)
    let live = 1.0 - self.disabled
    let t = clamp(self.pos.y, 0.0, 1.0)
    let row = mix(vec3(0.800, 0.804, 0.812), vec3(0.753, 0.757, 0.765), t)
    let wa = Finish.cover(d, px) * self.hover * live
    var out = vec4(row * wa, wa)
    let m0 = vec2(6.0, c.y)
    let m1 = vec2(8.5, c.y + 2.5)
    let m2 = vec2(12.5, c.y - 3.0)
    let lit = Finish.cover(min(md_seg(p - vec2(0.0, px), m0, m1), md_seg(p - vec2(0.0, px), m1, m2)) - 0.75, px) * self.active * 0.5
    out = Finish.over(out, vec4(lit, lit, lit, lit))
    let mk = Finish.cover(min(md_seg(p, m0, m1), md_seg(p, m1, m2)) - 0.75, px) * self.active
    return Finish.over(out, vec4(0.204 * mk, 0.216 * mk, 0.231 * mk, mk))
}

// The dock's tabs: the bar is the housing with an engraved line at its foot;
// the tab in use is a cap rounded at the top and open at the foot, where it
// joins the panel below; the others lift a little under the pointer.
mod.widgets.Tab.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Tab.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + 2.0, px)) - o
    let hi = vec2(Finish.snap(o.x + self.rect_size.x, px), Finish.snap(o.y + self.rect_size.y, px)) - o + vec2(0.0, 6.0)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let d = md_rbox(p, c, h, 5.0)
    let t = clamp((p.y - lo.y) / max(self.rect_size.y - 2.0, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.961, 0.965, 0.969), vec3(0.886, 0.890, 0.898), t)
    face = mix(face, vec3(1.0, 1.0, 1.0), Finish.band(d, px, 2.0 * px, px) * (1.0 - smoothstep(-0.5, 0.5, p.y - (lo.y + 5.0))) * 0.85)
    face = mix(face, mix(vec3(0.557, 0.565, 0.576), vec3(0.416, 0.424, 0.439), t), Finish.band(d, 0.0, px, px))
    let a = Finish.cover(d, px) * self.active
    let lift = Finish.cover(d, px) * 0.18 * self.hover * (1.0 - self.active)
    return Finish.over(vec4(lift, lift, lift, lift), vec4(face * a, a))
}
mod.widgets.TabBar.draw_fill.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let yb = Finish.snap(self.rect_pos.y + self.rect_size.y, px) - self.rect_pos.y
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * 0.30
    let lt = step(yb - px, p.y) * step(p.y, yb) * 0.6
    var out = vec4(0.110 * dk, 0.118 * dk, 0.133 * dk, dk)
    return Finish.over(out, vec4(lt, lt, lt, lt))
}

// ---------------------------------------------------------------------------
// CHIPS AND BADGES. A chip is a small seated cap (pressed in while chosen);
// a badge is a small raised cap with semibold digits.
mod.widgets.ChipFlat.size = mod.widgets.ChipSize.Small
mod.widgets.Chip.size = mod.widgets.ChipSize.Small
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let g = md_grow(self.rect_pos, self.rect_size, 4.0)
    self.vertex_pos = self.clip_and_transform_vertex(g.xy, g.zw)
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let m = 4.0
    let ch = min(22.0, self.rect_size.y)
    let dy = (self.rect_size.y - ch) * 0.5
    let sz = vec2(self.rect_size.x, ch)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let pp = (p - vec2(0.0, dy) + vec2(m, m)) / (sz + vec2(2.0 * m, 2.0 * m))
    // A filled chip (light ink) is a cap dyed its role's colour; a tonal one
    // the grey cap faintly dyed; an outlined one the engraved frame; a ghost
    // bare until touched.
    let light_ink = step(0.6, Finish.lum(self.ink.rgb))
    let has_fill = step(0.05, self.color.a)
    let kind = mix(mix(6.0, 5.0, step(0.01, self.border_size)), 0.0, has_fill)
    let tint = vec4(self.color.rgb, has_fill * mix(0.35, 1.0, light_ink))
    return md_button(pp, sz, self.rect_pos + vec2(0.0, dy), px, self.hover, self.down, self.keyed, 0.0, 0.0, 0.0, vec4(5.0, 5.0, 5.0, 5.0), kind, m, tint)
}
mod.widgets.BadgePalette.neutral = #55585c
mod.widgets.BadgePalette.on_neutral = #f4f5f6
mod.widgets.BadgeFlat.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.Badge.draw_text.text_style = mod.theme.font_bold{font_size: 6.5}
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let bh = min(16.0, self.rect_size.y - 2.0)
    let y0 = Finish.snap(o.y + (self.rect_size.y - bh) * 0.5, px) - o.y
    let lo = vec2(Finish.snap(o.x + 1.0, px) - o.x, y0)
    let hi = vec2(Finish.snap(o.x + self.rect_size.x - 1.0, px) - o.x, Finish.snap(o.y + y0 + bh, px) - o.y)
    let h = (hi - lo) * 0.5
    let c = lo + h
    let r = mix(4.0, h.y, step(self.rect_size.x, self.rect_size.y + 0.5) * step(self.rect_size.y, 12.5))
    let d = md_rbox(p, c, h, r)
    var out = md_seat(d, p.y - c.y, h.y, px, 0.16, 1.0)
    let dyed = step(0.06, length(self.color.rgb - vec3(0.886, 0.890, 0.898)))
    out = Finish.over(out, md_cap(p, c, h, vec4(r, r, r, r), px, 0.0, 0.0, 0.0, vec4(self.color.rgb, dyed)) * self.color.a)
    return out
}

// The spinner keeps its stock turning face (it runs on the pass clock, which
// a face may not read), in graphite with a two point stroke on a visible
// track ring, so a still frame reads as a working indicator.
mod.widgets.SpinnerFlat.draw_bg.color = #55575b
mod.widgets.SpinnerFlat.draw_bg.stroke_width = 3.0
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.22

// Rules between groups: engraved, one dark device row over one light one.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    let dk = step(y - px, p.y) * (1.0 - step(y, p.y)) * 0.14
    let lt = step(y, p.y) * (1.0 - step(y + px, p.y)) * 0.6
    return Finish.over(vec4(0.110 * dk, 0.118 * dk, 0.133 * dk, dk), vec4(lt, lt, lt, lt))
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let dk = step(x - px, p.x) * (1.0 - step(x, p.x)) * 0.14
    let lt = step(x, p.x) * (1.0 - step(x + px, p.x)) * 0.6
    return Finish.over(vec4(0.110 * dk, 0.118 * dk, 0.133 * dk, dk), vec4(lt, lt, lt, lt))
}

// ---------------------------------------------------------------------------
// ENGRAVED WORDS. A word on a cap is cut into it: the ink with a white line
// one device pixel under every glyph, read from the glyph one device pixel
// above, so it costs one more sample and nothing else.
mod.widgets.ButtonFlat.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let c = self.get_color()
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.55 * c.a
        return main + vec4(s, s, s, s) * (1.0 - main.a)
    }
    return main
}
mod.widgets.DropDownFlat.draw_text.pixel = fn() {
    let main = self.sample_text_pixel()
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let dxt = length(dFdx(self.t))
        let dyt = length(dFdy(self.t))
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let ps = clamp(self.t.xy - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let c = self.get_color()
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0)) * 0.55 * c.a
        return main + vec4(s, s, s, s) * (1.0 - main.a)
    }
    return main
}
