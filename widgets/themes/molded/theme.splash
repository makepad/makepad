mod.theme = mod.themes.light

// Moulded grey plastic: the classic kit. A warm mid-grey housing with caps
// that stand off it as real objects -- a round shoulder catching a hard
// light, a firm shadow underneath -- and wells cut into it with a crisp
// hairline. The one ground, and every control is the same plastic.
mod.theme.color_bg_app = #d8dad6
mod.theme.color_fg_app = #d8dad6
mod.theme.color_bg_container = #d8dad6
mod.theme.color_outset = #d8dad6
mod.theme.color_outset_1 = #d8dad6
mod.theme.color_outset_2 = #d8dad6
mod.theme.color_outset_hover = #dddfdb
mod.theme.color_outset_1_hover = #dddfdb
mod.theme.color_outset_2_hover = #dddfdb
mod.theme.color_outset_down = #cfd1cd
mod.theme.color_outset_1_down = #cfd1cd
mod.theme.color_outset_2_down = #cfd1cd
mod.theme.color_outset_disabled = #d8dad6
mod.theme.color_outset_1_disabled = #d8dad6
mod.theme.color_outset_2_disabled = #d8dad6
// The wells are a shade darker than the housing, and opaque in every state:
// the light base derives the states as translucent overlays, which read as
// black to a contrast check.
mod.theme.color_inset = #cdcfcb
mod.theme.color_inset_1 = #cdcfcb
mod.theme.color_inset_2 = #cdcfcb
mod.theme.color_inset_hover = #c8cac6
mod.theme.color_inset_1_hover = #c8cac6
mod.theme.color_inset_2_hover = #c8cac6
mod.theme.color_inset_focus = #c8cac6
mod.theme.color_inset_1_focus = #c8cac6
mod.theme.color_inset_2_focus = #c8cac6
mod.theme.color_inset_active = #c8cac6
mod.theme.color_inset_1_active = #c8cac6
mod.theme.color_inset_2_active = #c8cac6
mod.theme.color_inset_down = #c8cac6
mod.theme.color_inset_1_down = #c8cac6
mod.theme.color_inset_2_down = #c8cac6
mod.theme.color_inset_drag = #cdcfcb
mod.theme.color_inset_1_drag = #cdcfcb
mod.theme.color_inset_2_drag = #cdcfcb
mod.theme.color_inset_empty = #cdcfcb
mod.theme.color_inset_1_empty = #cdcfcb
mod.theme.color_inset_2_empty = #cdcfcb
mod.theme.color_inset_disabled = #d3d5d1
mod.theme.color_inset_1_disabled = #d3d5d1
mod.theme.color_inset_2_disabled = #d3d5d1

// The bevel colours are the old fake-depth stroke: matched to the ground so
// they disappear, the relief replaces them.
mod.theme.color_bevel = #d8dad6
mod.theme.color_bevel_inset_1 = #d8dad6
mod.theme.color_bevel_inset_2 = #d8dad6
mod.theme.color_bevel_outset_1 = #d8dad6
mod.theme.color_bevel_outset_2 = #d8dad6
mod.theme.beveling = 0.0

mod.theme.color_text = #2c3033
mod.theme.color_label = #2c3033
mod.theme.color_label_inner = #2c3033
mod.theme.color_label_outer = #2c3033
mod.theme.color_icon = #2c3033
// The kit's red indicator: the focus ring and the value ink.
mod.theme.color_focus = #d24b3a
mod.theme.color_ctrl_active = #d24b3a
mod.theme.color_val = #d24b3a

mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.corner_radius = 5.0
mod.theme.container_corner_radius = 10.0

// THE MATERIAL
// Tier 2: a round moulded shoulder (curve 0.85) under a fairly hard light,
// a little specular and a whisper of gloss. Plastic, not chrome.
mod.theme.material_level = 2.0
mod.theme.material_light_x = -0.30
mod.theme.material_light_y = -0.62
mod.theme.material_light_z = 0.72
mod.theme.material_light_intensity = 0.85
mod.theme.material_bevel_width = 3.5
mod.theme.material_bevel_curve = 0.85
mod.theme.material_ao = 0.42
mod.theme.material_rim = 0.55
mod.theme.material_specular = 0.12
mod.theme.material_roughness = 0.60
mod.theme.material_gloss = 0.10
mod.theme.material_raise = 3.0
mod.theme.material_sink = 3.0
mod.theme.material_face_gradient = 0.42
mod.theme.material_hairline = 0.30
mod.theme.material_ao_reach = 1.0

// THE PRESS DEEPENS. Moulded plastic flexes, it does not turn inside out:
// a held cap drops two of its three points and keeps its convex face, so
// the shadow closes up and the specular dims. That is image 4's contract.
mod.theme.material_press_depth = -2.0
mod.theme.material_press_invert = 0.0

// A firm shadow with a soft edge, a real contact ring, no ground lip: these
// caps rest ON the housing.
mod.theme.material_shadow = 0.60
mod.theme.material_shadow_blur = 12.0
mod.theme.material_shadow_falloff = 1.0
mod.theme.material_contact_ao = 0.35
mod.theme.material_ground_lip = 0.0
mod.theme.material_inner_shadow = 0.50
mod.theme.material_inner_radius = 7.0
mod.theme.material_margin = 9.0
mod.theme.color_material_light = #f6f6f3
mod.theme.color_material_shadow = #6b7176
mod.theme.color_material_glow = #d24b3a
true
