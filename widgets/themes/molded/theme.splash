mod.theme = mod.themes.light

// Light-grey matte moulded plastic, lit from straight above. Every control
// is a raised cap or a recessed well cut into one housing; colour lives only
// in small places: a lamp, a lit toggle well, a value arc, the focus ring.
// Every state of a family is spelled out, because the base derived its states
// once, from its own colours.
use mod.res.*
use mod.text.*

// The housing.
mod.theme.color_bg_app = #dadbdd
mod.theme.color_fg_app = #dadbdd
mod.theme.color_bg_container = #dadbdd

// Raised faces the sheet does not redraw: the cap's middle, top and foot.
mod.theme.color_outset = #e2e3e5
mod.theme.color_outset_1 = #f4f5f6
mod.theme.color_outset_2 = #cfd0d3
mod.theme.color_outset_hover = #e7e8ea
mod.theme.color_outset_1_hover = #f8f9fa
mod.theme.color_outset_2_hover = #d6d7da
mod.theme.color_outset_down = #d1d2d5
mod.theme.color_outset_1_down = #bfc0c3
mod.theme.color_outset_2_down = #e3e4e6
mod.theme.color_outset_focus = #e2e3e5
mod.theme.color_outset_1_focus = #f4f5f6
mod.theme.color_outset_2_focus = #cfd0d3
mod.theme.color_outset_active = #d1d2d5
mod.theme.color_outset_1_active = #bfc0c3
mod.theme.color_outset_2_active = #e3e4e6
mod.theme.color_outset_disabled = #e6e7e8
mod.theme.color_outset_1_disabled = #e6e7e8
mod.theme.color_outset_2_disabled = #e6e7e8

// Wells: the white field well, opaque in every state (a translucent well
// reads as black to a contrast check).
mod.theme.color_inset = #f7f7f8
mod.theme.color_inset_1 = #f7f7f8
mod.theme.color_inset_2 = #f7f7f8
mod.theme.color_inset_hover = #fbfbfc
mod.theme.color_inset_1_hover = #fbfbfc
mod.theme.color_inset_2_hover = #fbfbfc
mod.theme.color_inset_focus = #fbfbfc
mod.theme.color_inset_1_focus = #fbfbfc
mod.theme.color_inset_2_focus = #fbfbfc
mod.theme.color_inset_active = #f7f7f8
mod.theme.color_inset_1_active = #f7f7f8
mod.theme.color_inset_2_active = #f7f7f8
mod.theme.color_inset_down = #f1f1f2
mod.theme.color_inset_1_down = #f1f1f2
mod.theme.color_inset_2_down = #f1f1f2
mod.theme.color_inset_drag = #f1f1f2
mod.theme.color_inset_1_drag = #f1f1f2
mod.theme.color_inset_2_drag = #f1f1f2
mod.theme.color_inset_empty = #f7f7f8
mod.theme.color_inset_1_empty = #f7f7f8
mod.theme.color_inset_2_empty = #f7f7f8
mod.theme.color_inset_disabled = #eeeff0
mod.theme.color_inset_1_disabled = #eeeff0
mod.theme.color_inset_2_disabled = #eeeff0

// One hairline edge, the grey of a well's rim, on every stock part the
// faces do not redraw.
mod.theme.color_bevel = #6a6c70
mod.theme.color_bevel_hover = #56585c
mod.theme.color_bevel_focus = #c24a0e
mod.theme.color_bevel_down = #56585c
mod.theme.color_bevel_active = #56585c
mod.theme.color_bevel_empty = #6a6c70
mod.theme.color_bevel_disabled = #a9abae
mod.theme.color_bevel_inset_1 = #6a6c70
mod.theme.color_bevel_inset_2 = #6a6c70
mod.theme.color_bevel_outset_1 = #8e9093
mod.theme.color_bevel_outset_2 = #36383b
mod.theme.beveling = 0.5

// Working ink: a deep neutral grey, 8:1 on the housing.
mod.theme.color_text = #34373b
mod.theme.color_text_hover = #25282c
mod.theme.color_text_focus = #25282c
mod.theme.color_text_active = #25282c
mod.theme.color_text_down = #25282c
mod.theme.color_text_disabled = #a0a2a6
mod.theme.color_text_placeholder = #6c6f73
mod.theme.color_text_placeholder_hover = #62656a
mod.theme.color_text_val = #34373b
mod.theme.color_text_meta = #54575b
mod.theme.color_text_cursor = #34373b
mod.theme.color_cursor = #34373b
mod.theme.color_label = #34373b
mod.theme.color_label_hover = #25282c
mod.theme.color_label_focus = #25282c
mod.theme.color_label_active = #25282c
mod.theme.color_label_down = #25282c
mod.theme.color_label_disabled = #a0a2a6
mod.theme.color_label_inner = #34373b
mod.theme.color_label_inner_hover = #25282c
mod.theme.color_label_inner_focus = #34373b
mod.theme.color_label_inner_down = #25282c
mod.theme.color_label_inner_drag = #25282c
mod.theme.color_label_inner_active = #25282c
mod.theme.color_label_inner_inactive = #34373b
mod.theme.color_label_inner_disabled = #a0a2a6
mod.theme.color_label_outer = #34373b
mod.theme.color_label_outer_off = #34373b
mod.theme.color_label_outer_hover = #25282c
mod.theme.color_label_outer_down = #25282c
mod.theme.color_label_outer_drag = #25282c
mod.theme.color_label_outer_focus = #25282c
mod.theme.color_label_outer_active = #25282c
mod.theme.color_label_outer_active_focus = #25282c
mod.theme.color_label_outer_disabled = #a0a2a6
mod.theme.color_icon = #34373b
mod.theme.color_icon_hover = #25282c
mod.theme.color_icon_focus = #34373b
mod.theme.color_icon_active = #25282c
mod.theme.color_icon_down = #25282c
mod.theme.color_icon_disabled = #a0a2a6
// The inks on the surface ladder hold 4.5:1 (body) and 3:1 (second voice)
// even on the darkest rung.
mod.theme.color_on_surface = #2e3135
mod.theme.color_on_surface_variant = #4a4d52

// The accent seed: the primary, secondary and tertiary families are grown
// from it. A deep burnt orange, so the grown roles keep their contrast; the
// bright lamp orange of the lit wells is drawn by the faces themselves.
mod.theme.color_ctrl_selected = #a3400c
mod.theme.color_focus = #ea5a11
mod.theme.color_ctrl_active = #a3400c
// Fills are graphite: the value is a darker plastic, not a colour.
mod.theme.color_val = #6b6d71
mod.theme.color_val_hover = #6b6d71
mod.theme.color_val_focus = #6b6d71
mod.theme.color_val_drag = #5f6165
mod.theme.color_mark = #34373b
mod.theme.color_mark_active = #34373b
mod.theme.color_selection_hover = #88abbe4d
mod.theme.color_selection_focus = #88abbe73
mod.theme.color_selection_down = #88abbe73
mod.theme.color_bg_highlight_inline = #88abbe4d
mod.theme.color_handle = #eeeff1
mod.theme.color_handle_hover = #f4f5f6
mod.theme.color_handle_1 = #f4f5f6
mod.theme.color_handle_2 = #d6d7da

// SLIM. Rows of 26, gaps of 8, a panel's padding 12. The rungs below were
// frozen as numbers when the base was read, so they are stated again here.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 20.0
mod.theme.space_6 = 24.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 32.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 26.0
mod.theme.data_item_height = 22.0
mod.theme.corner_radius = 5.0
mod.theme.container_corner_radius = 6.0
mod.theme.textselection_corner_radius = 1.5
mod.theme.radius_xs = 2.0
mod.theme.radius_s = 3.0
mod.theme.radius_m = 5.0
mod.theme.radius_l = 6.0

// A neo-grotesque: regular for working text, medium on caps, semibold for
// captions. A font size draws 1.333 layout points per unit, so 8.5 sets a
// cap of about 8.2 points, 0.32 of a 26 point row.
mod.theme.font_size_p = 8.5
mod.theme.type_title_l_size = 12.0
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_s_size = 9.25
mod.theme.type_body_l_size = 9.25
mod.theme.type_body_m_size = 8.5
mod.theme.type_body_s_size = 7.75
mod.theme.type_label_l_size = 8.5
mod.theme.type_label_m_size = 7.75
mod.theme.type_label_s_size = 7.0
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.5 font_family: mod.theme.font_regular.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Inter.ttf") weight: 400.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_label = mod.theme.font_label{font_size: 8.5 font_family: mod.theme.font_label.font_family{ibm_plex_text := FontMember{res: crate_resource("self:resources/Inter.ttf") weight: 500.0 asc: 0.0 desc: 0.0}}}
mod.theme.font_bold = mod.theme.font_bold{font_size: 8.5 font_family: mod.theme.font_bold.font_family{ibm_plex_semibold := FontMember{res: crate_resource("self:resources/Inter.ttf") weight: 600.0 asc: 0.0 desc: 0.0}}}
// The type roles were frozen from the base's faces; stated again so every
// role reads in the one family.
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.25 line_spacing: 1.2}
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.25 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.5 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 7.75 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.5 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 7.75 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 7.0 line_spacing: 1.2}
true
