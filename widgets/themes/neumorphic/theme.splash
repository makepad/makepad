mod.theme = mod.themes.light

// Neumorphism has one ground colour and no borders: every edge you can see is
// light falling on a shoulder, not ink. So the face, the inset and the page
// are all the same near-white lilac, and the contrast that usually comes from
// a border comes from the material instead.
mod.theme.color_bg_app = #eef0f6
mod.theme.color_fg_app = #eef0f6
mod.theme.color_bg_container = #eef0f6
mod.theme.color_outset = #eef0f6
mod.theme.color_outset_1 = #eef0f6
mod.theme.color_outset_2 = #eef0f6
mod.theme.color_inset = #eef0f6
mod.theme.color_inset_1 = #eef0f6
mod.theme.color_inset_2 = #eef0f6
// The wells' states too. The light base derives them as translucent
// overlays on whatever is under them, and a translucent well reads as
// black to a contrast check; a neumorphic well changes by a hair of tone,
// the relief carries the rest.
mod.theme.color_inset_hover = #e6e9f1
mod.theme.color_inset_1_hover = #e6e9f1
mod.theme.color_inset_2_hover = #e6e9f1
mod.theme.color_inset_focus = #e6e9f1
mod.theme.color_inset_1_focus = #e6e9f1
mod.theme.color_inset_2_focus = #e6e9f1
mod.theme.color_inset_active = #e6e9f1
mod.theme.color_inset_1_active = #e6e9f1
mod.theme.color_inset_2_active = #e6e9f1
mod.theme.color_inset_down = #e6e9f1
mod.theme.color_inset_1_down = #e6e9f1
mod.theme.color_inset_2_down = #e6e9f1
mod.theme.color_inset_drag = #eef0f6
mod.theme.color_inset_1_drag = #eef0f6
mod.theme.color_inset_2_drag = #eef0f6
mod.theme.color_inset_empty = #eef0f6
mod.theme.color_inset_1_empty = #eef0f6
mod.theme.color_inset_2_empty = #eef0f6
mod.theme.color_inset_disabled = #f3f4f8
mod.theme.color_inset_1_disabled = #f3f4f8
mod.theme.color_inset_2_disabled = #f3f4f8

// The bevel colours are the old fake-depth stroke. Matched to the ground so
// they disappear; the relief replaces them.
mod.theme.color_bevel = #eef0f6
mod.theme.color_bevel_inset_1 = #eef0f6
mod.theme.color_bevel_inset_2 = #eef0f6
mod.theme.color_bevel_outset_1 = #eef0f6
mod.theme.color_bevel_outset_2 = #eef0f6
mod.theme.beveling = 0.0

mod.theme.color_text = #3a4052
mod.theme.color_label = #3a4052
mod.theme.color_label_inner = #3a4052
mod.theme.color_label_outer = #3a4052
mod.theme.color_icon = #3a4052
mod.theme.color_focus = #7c4dff
mod.theme.color_ctrl_active = #7c4dff
mod.theme.color_val = #7c4dff

// Shadows need somewhere to fall. A neumorphic control sits in whitespace,
// and the relief is drawn INSIDE the control's own rect, so the spacing
// carries the look as much as the shader does.
mod.theme.space_factor = 9.0
mod.theme.space_1 = 4.5
mod.theme.space_2 = 9.0
mod.theme.space_3 = 13.5
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.5 right: 4.5 bottom: 4.5 left: 4.5}
mod.theme.corner_radius = 8.0
mod.theme.container_corner_radius = 16.0

// THE MATERIAL
// Tier 1: relief, no gloss and no rim sweep. A fully pillowed shoulder
// (curve 0) under a dialled-down light is what separates neumorphism from
// moulded plastic: soft material, soft light, narrow shoulder.
mod.theme.material_level = 1.0
mod.theme.material_light_intensity = 0.70
mod.theme.material_bevel_width = 4.0
mod.theme.material_bevel_curve = 0.0
mod.theme.material_ao = 0.5
mod.theme.material_rim = 0.4
mod.theme.material_specular = 0.06
mod.theme.material_roughness = 0.85
mod.theme.material_raise = 4.0
mod.theme.material_sink = 4.0
// Past -material_raise, so a press crosses zero and INVERTS: the lit and
// shaded shoulders swap and the control reads as pushed into the page.
mod.theme.material_press_depth = -9.0
// The one style where a press dishes the FACE as well as lowering it. That is
// the neumorphic illustration convention, and it only reads where the control
// is the page rather than an object resting on it -- which is exactly the
// condition this sheet sets up.
mod.theme.material_press_invert = 1.0

// The broad gradient across a face, and the hard line on its boundary. Both
// stay low here: neumorphism is a soft material under a soft light, and a
// crisp hairline is the first thing that makes it look like moulded plastic
// instead. The occlusion reaches slightly past the shoulder.
mod.theme.material_face_gradient = 0.3
mod.theme.material_hairline = 0.1
mod.theme.material_ao_reach = 1.2

// OUTSIDE THE FACE. The signature pair: a dark shadow down-light and a light
// one up-light, both wide and soft. The ground lip is on -- and this is the
// only shipped sheet where it is -- because a neumorphic control is EXTRUDED
// FROM the page, one continuous surface, so its light side genuinely is the
// ground bending up into it. On a control resting on a panel the same effect
// reads as a button glowing for no reason.
mod.theme.material_shadow = 0.75
mod.theme.material_shadow_blur = 14.0
mod.theme.material_shadow_falloff = 1.0
mod.theme.material_contact_ao = 0.3
mod.theme.material_ground_lip = 0.7
mod.theme.material_inner_shadow = 0.55
mod.theme.material_inner_radius = 10.0
// Not black. A neumorphic shadow is a cool grey-lilac, which is what keeps
// the page reading as one soft material rather than as dirt on white.
mod.theme.color_material_light = #ffffff
mod.theme.color_material_shadow = #a7aec4
mod.theme.color_material_glow = #7c4dff
true
