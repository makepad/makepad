// The borderless button shows nothing until the pointer finds it, and then
// only a faint hollow.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
