use mod.prelude.widgets_internal.*

// THE MATERIAL. One pale ground, pushed up into raised parts or pressed into
// wells. Every face below is built from the same few pieces, written once
// here and handed what each template knows about itself. Light comes from
// the top left: dark falls down-right, white up-left. Distances are points,
// and a face's shadows are drawn OUTSIDE its layout box, in a quad grown in
// `vertex`, so they cost no padding.

// The page, and the grain every surface shares, so a face and the ground
// round it read as one material: one value per device pixel, about one
// level of 255, taken in window space.
let nm_grain = fn(q: vec2, px: float) -> float {
    return Finish.grain(q / px, 2.4 / 255.0)
}

let nm_ground = fn() -> vec3 {
    return vec3(0.914, 0.929, 0.941)
}

// What a raised part throws round itself, premultiplied: a white halo up
// and left, a broad blue-slate shadow down and right, and a tight contact
// shadow under the edge. `s` is the part's own height (the shadows keep its
// proportions), `k` their strength.
let nm_cast = fn(p: vec2, c: vec2, h: vec2, r: float, s: float, k: float) -> vec4 {
    let amb = Finish.drop(p, c, h, r, vec2(0.068, 0.085) * s, max(0.1 * s, 1.0)) * 0.5 * k
    let con = Finish.drop(p, c, h, r, vec2(0.02, 0.04) * s, max(0.024 * s, 0.5)) * 0.24 * k
    // Held at its resting peak, so a hovered part never turns it solid.
    let lit = min(Finish.drop(p, c, h, r, vec2(-0.058, -0.075) * s, max(0.08 * s, 0.8)) * 0.9 * k, 0.9)
    var acc = vec4(vec3(0.639, 0.694, 0.776) * amb, amb)
    acc = Finish.over(acc, vec4(vec3(0.561, 0.612, 0.698) * con, con))
    // The light side is laid last, so the dark one does not dull it.
    acc = Finish.over(acc, vec4(lit, lit, lit, lit))
    return acc
}

// A raised face: the ground a hair lighter at the top and a hair darker at
// the bottom, and one device-pixel light line along the top edge that fades
// out down the sides.
let nm_face = fn(p: vec2, c: vec2, h: vec2, d: float, px: float, lift: float, rim: float) -> vec3 {
    let v = clamp((p.y - (c.y - h.y)) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    var col = nm_ground() + vec3(mix(0.011, -0.005, v) + lift, mix(0.011, -0.005, v) + lift, mix(0.011, -0.005, v) + lift)
    let top = 1.0 - smoothstep(0.08, 0.6, v)
    col = mix(col, vec3(0.980, 0.984, 1.0), Finish.band(d, 0.0, px, px) * top * 0.9 * rim)
    return col
}

// A well: the surround's shadow falls in from the top left, light collects
// at the bottom right, and the last device pixel of the bottom edge is the
// lit lip. `k` is its depth, `s` the well's own height.
let nm_well = fn(col: vec3, p: vec2, c: vec2, h: vec2, r: float, d: float, px: float, s: float, k: float) -> vec3 {
    let dk = Finish.inset(p, c, h, r, vec2(0.04 * s, 0.06 * s), max(0.075 * s, 0.9))
    let lt = Finish.inset(p, c, h, r, vec2(-0.03 * s, -0.05 * s), max(0.07 * s, 0.8))
    var o = mix(col, vec3(0.639, 0.694, 0.776), dk * 0.72 * k)
    o = mix(o, vec3(1.0, 1.0, 1.0), lt * 0.75 * k)
    let low = smoothstep(c.y - 0.2 * h.y, c.y + h.y, p.y)
    o = mix(o, vec3(0.976, 0.980, 0.992), Finish.band(d, 0.0, px, px) * low * 0.8 * k)
    return o
}

// The focus mark: a one-pixel accent ring two points outside the face, and a
// short soft fall-off either side of it.
let nm_focus = fn(d: float, px: float, f: float) -> vec4 {
    let ring = Finish.ring_out(d, 2.0, 2.0 + px, px) * 0.6
    let soft = (1.0 - smoothstep(0.0, 2.0, abs(d - 2.0))) * 0.15 * step(0.0, d)
    let a = max(ring, soft) * f
    return vec4(vec3(0.290, 0.486, 0.965) * a, a)
}

// The distance to an arc of radius R about c, running clockwise from a0 to
// a1 measured from straight down, with round ends, w wide. Written here
// because the stock arc gives up on any sweep past half a turn.
let nm_arc = fn(p: vec2, c: vec2, R: float, a0: float, a1: float, w: float) -> float {
    let q = p - c
    var ap = atan2(-q.x, q.y)
    if ap < 0.0 {
        ap = ap + 2.0 * PI
    }
    let rel = ap - a0 - floor((ap - a0) / (2.0 * PI)) * 2.0 * PI
    let on = step(rel, a1 - a0)
    let band = abs(length(q) - R) - 0.5 * w
    let e0 = length(q - vec2(-sin(a0), cos(a0)) * R) - 0.5 * w
    let e1 = length(q - vec2(-sin(a1), cos(a1)) * R) - 0.5 * w
    return mix(min(e0, e1), band, on)
}

// BUTTONS. `rest` is how raised the face stands at rest (1 raised, 0 flat
// on the page), `ghost` draws an engraved line round a flat face, `hollow`
// shows nothing until the pointer asks, and `ring` is an accent line just
// inside the face edge. Held, any of them is the same shape pressed in, with
// a light lip left on its top-left edge.
let nm_button = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, ink: vec4, rest: float, ghost: float, hollow: float, ring: vec4) -> vec4 {
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + size.x, px), Finish.snap(org.y + size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = min(size.y, 28.0)
    let r = min(0.24 * size.y, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    let press = down * en
    // How far the face stands up: raised faces lift a little under the
    // hand, flat ones rise to half height, hollow ones stay down.
    let up = mix(mix(0.6 * hover, rest * (1.0 + 0.3 * hover), step(0.5, rest)), 0.0, hollow) * (1.0 - press)
    let k = up * mix(1.0, 0.35, disabled)
    var acc = nm_cast(pq, c, h, r, hh, k)
    let a = Finish.cover(d, px)
    var col = nm_face(pq, c, h, d, px, 0.018 * hover * en, step(0.5, rest) * en * (1.0 - press))
    // A flat face is the page itself until it rises.
    let flatness = (1.0 - step(0.5, rest)) * (1.0 - min(up * 1.8, 1.0))
    col = mix(col, nm_ground(), flatness)
    // Pressed, or the faint well a hollow face shows under the pointer.
    let sink = max(press, hollow * hover * 0.4 * en)
    col = mix(col, nm_well(col - vec3(0.013, 0.013, 0.013) * press, pq, c, h, r, d, px, hh, 1.0), sink)
    // The engraved line of a ghost face: dark on the upper left, light on the
    // lower right, one device pixel each.
    let upper = step(pq.y - c.y, (c.x - pq.x) * h.y / max(h.x, 1.0) + 0.0)
    let eng = Finish.band(d, 0.0, px, px) * ghost * (1.0 - up)
    let tl = step(0.0, (c.y - pq.y) / max(h.y, 1.0) + (c.x - pq.x) / max(h.x, 1.0) * 0.25)
    col = mix(col, mix(vec3(0.976, 0.980, 0.992), vec3(0.745, 0.776, 0.827), tl), eng * mix(0.9, 0.35, disabled))
    // The accent line inside a primary face.
    col = mix(col, ring.rgb, Finish.band(d, 1.5, 1.5 + px, px) * ring.a * en)
    col = col + vec3(nm_grain(org + pq, px))
    acc = Finish.over(acc, vec4(col * a, a))
    // Held: the white lip that stays on the pressed face's top-left rim.
    let lip = Finish.ring_out(d, 0.0, px, px) * press * smoothstep(0.1, -0.5, (pq.y - c.y) / max(h.y, 1.0) + (pq.x - c.x) / max(h.x, 1.0)) * 0.8
    acc = Finish.over(acc, vec4(vec3(0.961, 0.976, 0.996) * lip, lip))
    acc = Finish.over(acc, nm_focus(d, px, focus * en))
    // The wait spinner is drawn by the face, so a face that replaces the
    // stock one has to draw it again.
    let rr = max(min(h.x, h.y) - 5.0, 2.0)
    let a0 = anim * 2.0 * PI
    let sa = Finish.cover(nm_arc(pq, c, rr, a0, a0 + 1.5 * PI, 1.5), px) * ink.a * loading
    return Finish.over(acc, vec4(ink.rgb * sa, sa))
}

// The room round every button for its shadows and its focus ring.
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 8.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
// A view lets what it holds draw past its edge; scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// The flat button: the page until the pointer raises it.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 0.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
// The standard, sized and compound buttons stand up off the page.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = 8.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 1.0, 0.0, 0.0, vec4(0.0, 0.0, 0.0, 0.0))
}
