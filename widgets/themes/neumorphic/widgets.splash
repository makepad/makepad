    return nm_button(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, self.loading_color, 0.0, 0.0, 1.0, vec4(0.0, 0.0, 0.0, 0.0))
}

// Rows of 26: 5 above and below a 16 point line, 14 either side.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 14.0 right: 14.0 top: 5.0 bottom: 5.0}
// NOTHING PAINTS OVER A NEIGHBOUR, whatever row an app puts it in. The
// casts stay long and soft; instead every raised part keeps room for them
// as its own margin, so two parts set edge to edge, or rows wrapped with no
// gap between them, still stand 8 points apart: the shadow of one and the
// halo of the other may meet in that gap, and each has faded out before the
// other's face. The room is paid in layout: a 26 point row of buttons takes
// 34 points, and buttons on a page's 8 point spacing stand 16 apart.
mod.widgets.ButtonFlat.margin = mod.turtle.Inset{left: 4.0 right: 4.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.spacing = 6.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 5.0 bottom: 5.0}
mod.widgets.ButtonFlat.draw_bg.loading_color = #4a7cf6

// Label inks. The primary family speaks through its label: accent ink at a
// medium weight on the primary, the page's slate on the others, the error
// ink on the destructive one.
// The weight re-weights the theme family's first member and keeps its
// fallbacks.
let nm_medium = mod.theme.font_regular{font_family +: {ibm_plex_text := FontMember{res: crate_resource("self:resources/Inter.ttf") weight: 540.0 asc: 0.0 desc: 0.0}}}
mod.widgets.ButtonPrimary.draw_text.color = #3860d6
mod.widgets.ButtonPrimary.draw_text.color_hover = #2f55c8
mod.widgets.ButtonPrimary.draw_text.color_down = #2f55c8
mod.widgets.ButtonPrimary.draw_text.color_focus = #3860d6
mod.widgets.ButtonPrimary.draw_text.color_disabled = #b3bac6
mod.widgets.ButtonPrimary.draw_text.text_style = nm_medium
mod.widgets.ButtonPrimary.draw_icon.color = #3860d6
mod.widgets.ButtonSecondary.draw_text.color = #535a6a
mod.widgets.ButtonSecondary.draw_text.color_hover = #474e5e
mod.widgets.ButtonSecondary.draw_text.color_down = #474e5e
mod.widgets.ButtonSecondary.draw_text.color_focus = #535a6a
mod.widgets.ButtonSecondary.draw_icon.color = #535a6a
mod.widgets.ButtonTertiary.draw_text.color = #3860d6
mod.widgets.ButtonTertiary.draw_text.color_hover = #2f55c8
mod.widgets.ButtonTertiary.draw_text.color_down = #2f55c8
mod.widgets.ButtonTertiary.draw_text.color_focus = #3860d6
mod.widgets.ButtonTertiary.draw_text.text_style = mod.theme.font_regular
mod.widgets.ButtonTertiary.draw_icon.color = #3860d6
mod.widgets.ButtonDanger.draw_text.color = #bd3a31
mod.widgets.ButtonDanger.draw_text.color_hover = #a8322a
mod.widgets.ButtonDanger.draw_text.color_down = #a8322a
mod.widgets.ButtonDanger.draw_text.color_focus = #bd3a31
mod.widgets.ButtonDanger.draw_icon.color = #bd3a31
mod.widgets.ButtonOutline.draw_text.color = #3860d6
mod.widgets.ButtonOutline.draw_text.color_hover = #2f55c8
mod.widgets.ButtonOutline.draw_text.color_down = #2f55c8
mod.widgets.ButtonOutline.draw_text.color_focus = #3860d6
mod.widgets.ButtonOutline.draw_icon.color = #3860d6

// CHECK BOX. A 16 point well with a 4 point corner; the check is a round
// capped accent stroke, flat, with no glow.
let nm_check = fn(pq: vec2, size: vec2, org: vec2, px: float, box: float, hover: float, down: float, focus: float, active: float, disabled: float, mixed: float, error: float, round: float, at_end: float) -> vec4 {
    let y0 = Finish.snap(org.y + size.y * 0.5 - box * 0.5, px) - org.y
    let x0 = Finish.snap(org.x + (size.x - box) * at_end, px) - org.x
    let c = vec2(x0 + box * 0.5, y0 + box * 0.5)
    let h = vec2(box * 0.5, box * 0.5)
    let r = mix(4.0, box * 0.5, round)
    let d = Material.sd_box(pq, c, h, r)
    let en = 1.0 - disabled
    var col = vec3(0.918, 0.929, 0.957)
    col = nm_well(col, pq, c, h, r, d, px, 18.0, (1.25 + 0.38 * hover + 0.1 * down) * mix(1.0, 0.35, disabled))
    col = col + vec3(nm_grain(org + pq, px))
    let a = Finish.cover(d, px)
    var acc = vec4(col * a, a)
    // Under the error intent the well's rim takes the error ink.
    let er = Finish.band(d, 0.0, px, px) * error * 0.8
    acc = Finish.over(acc, vec4(vec3(0.741, 0.227, 0.192) * er, er))
    let ink = mix(mix(vec3(0.290, 0.486, 0.965), vec3(0.741, 0.227, 0.192), error), vec3(0.725, 0.776, 0.902), disabled)
    let sdf = Sdf2d.viewport(pq)
    sdf.clear(vec4(acc.rgb / max(acc.a, 0.0001), acc.a))
    sdf.move_to(c.x - box * 0.24, c.y + box * 0.01)
    sdf.line_to(c.x - box * 0.06, c.y + box * 0.19)
    sdf.line_to(c.x + box * 0.25, c.y - box * 0.17)
    sdf.stroke(vec4(ink, active * (1.0 - mixed)), 0.75)
    sdf.move_to(c.x - box * 0.22, c.y)
    sdf.line_to(c.x + box * 0.22, c.y)
    sdf.stroke(vec4(ink, mixed), 0.75)
    let f = nm_focus(d, px, focus * en)
    return Finish.over(sdf.result, f)
}
mod.widgets.CheckBoxFlat.draw_bg.vertex = fn() {
    let m = 4.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.draw_bg.pixel = fn() {
    let m = 4.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_check(pq, self.rect_size, self.rect_pos, px, 16.0, self.hover, self.down, self.focus, self.active, self.disabled, self.mixed, self.error, 0.0, self.mark_at_end)
}
mod.widgets.CheckBoxCircle.draw_bg.pixel = fn() {
    let m = 4.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_check(pq, self.rect_size, self.rect_pos, px, 16.0, self.hover, self.down, self.focus, self.active, self.disabled, self.mixed, self.error, 1.0, self.mark_at_end)
}
mod.widgets.CheckBoxFlat.draw_bg.size = 16.0
mod.widgets.CheckBoxFlat.padding = mod.turtle.Inset{left: 0.0 right: 4.0 top: 5.0 bottom: 5.0}
mod.widgets.CheckBoxFlat.label_walk.margin.left = 24.0

// TOGGLE. A 12 point pill well with an 18 point raised knob that overhangs
// it by 3 above and below; on, the well fills with the accent.
let nm_toggle = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, active: float, disabled: float, error: float, t: float, at_end: float) -> vec4 {
    let w = 34.0
    let kr = 9.0
    let x0 = (size.x - w) * at_end
    let cy = Finish.snap(org.y + size.y * 0.5, px) - org.y
    let tc = vec2(x0 + w * 0.5, cy)
    let th = vec2(w * 0.5 - 2.0, 6.0)
    let td = Material.sd_box(pq, tc, th, 6.0)
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.35, disabled)
    var col = vec3(0.918, 0.933, 0.945)
    col = nm_well(col, pq, tc, th, 6.0, td, px, 16.0, (1.05 + 0.32 * hover) * dis)
    // The fill: accent, a darker line along its top, a lighter one below.
    let fillc = mix(mix(vec3(0.290, 0.486, 0.965), vec3(0.741, 0.227, 0.192), error), vec3(0.725, 0.776, 0.902), disabled)
    let top = Finish.band(td, 0.0, px, px) * step(pq.y, cy)
    let bot = Finish.band(td, 0.0, px, px) * step(cy, pq.y)
    var fc = mix(fillc, fillc * 0.84, top)
    fc = mix(fc, min(fillc * 1.12, vec3(1.0, 1.0, 1.0)), bot)
    col = mix(col, fc, active)
    col = col + vec3(nm_grain(org + pq, px))
    let ta = Finish.cover(td, px)
    var acc = vec4(col * ta, ta)
    // The knob, and what it throws.
    let kc = vec2(x0 + mix(kr, w - kr, t), cy)
    let kh = vec2(kr, kr)
    let kd = length(pq - kc) - kr
    acc = Finish.over(acc, nm_cast(pq, kc, kh, kr, 18.0, (1.0 + 0.3 * hover) * dis))
    var kcol = nm_face(pq, kc, kh, kd, px, 0.018 * hover * en - 0.01 * down * en, en)
    kcol = kcol + vec3(nm_grain(org + pq, px))
    let ka = Finish.cover(kd, px)
    acc = Finish.over(acc, vec4(kcol * ka, ka))
    return Finish.over(acc, nm_focus(td, px, focus * en))
}
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let t = mix(self.active, self.drag_pos, self.drag)
    return nm_toggle(pq, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.active, self.disabled, self.error, t, self.mark_at_end)
}
mod.widgets.ToggleFlat.draw_bg.size = 18.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 1.889
mod.widgets.ToggleFlat.label_walk.margin.left = 42.0

// RADIO. Off, a 16 point well with a faint raised ring in its middle; on,
// the disc stands up and carries a flat accent dot half its width.
let nm_radio = fn(pq: vec2, size: vec2, org: vec2, px: float, hover: float, down: float, focus: float, active: float, disabled: float) -> vec4 {
    let rr = 8.0
    let cy = Finish.snap(org.y + size.y * 0.5, px) - org.y
    let c = vec2(rr, cy)
    let h = vec2(rr, rr)
    let d = length(pq - c) - rr
    let en = 1.0 - disabled
    let dis = mix(1.0, 0.35, disabled)
    let on = active
    var acc = nm_cast(pq, c, h, rr, 16.0, on * (1.0 + 0.3 * hover) * dis)
    // Off: the well and its faint inner ring.
    var wcol = nm_well(vec3(0.918, 0.929, 0.957), pq, c, h, rr, d, px, 18.0, (1.3 + 0.4 * hover + 0.1 * down) * dis)
    let ir = length(pq - c) - rr * 0.49
    let ring = Finish.band(ir, -px, px, px)
    wcol = mix(wcol, vec3(0.855, 0.875, 0.910), ring * smoothstep(-0.2, 0.6, (pq.y - c.y) / rr) * 0.8 * dis)
    wcol = mix(wcol, vec3(0.975, 0.980, 0.992), ring * smoothstep(0.2, -0.6, (pq.y - c.y) / rr) * 0.8 * dis)
    // On: the raised disc and its dot.
    var rcol = nm_face(pq, c, h, d, px, 0.018 * hover * en, en)
    let dd = length(pq - c) - rr * 0.49
    let dot = mix(vec3(0.290, 0.486, 0.965), vec3(0.725, 0.776, 0.902), disabled)
    let rimtop = Finish.band(dd, 0.0, px, px) * smoothstep(0.1, -0.6, (pq.y - c.y) / (rr * 0.49))
    rcol = mix(rcol, mix(dot, dot * 0.86, rimtop), Finish.cover(dd, px))
    var col = mix(wcol, rcol, on)
    col = col + vec3(nm_grain(org + pq, px))
    let a = Finish.cover(d, px)
    acc = Finish.over(acc, vec4(col * a, a))
    return Finish.over(acc, nm_focus(d, px, focus * en))
}
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
