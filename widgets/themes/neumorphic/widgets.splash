mod.widgets.RadioButtonTabFlat.draw_text.color_active = #3860d6


// CHIPS. A small raised pill, pressed in while held; a keyed chip wears the
// focus ring.
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5
    let r = min(self.radius, h.y)
    let d = Material.sd_box(pq, c, h, r)
    var acc = nm_cast(pq, c, h, r, 20.0, (1.0 + 0.3 * self.hover) * (1.0 - self.down))
    var col = nm_face(pq, c, h, d, px, 0.018 * self.hover, 1.0 - self.down)
    col = mix(col, nm_well(col - vec3(0.013, 0.013, 0.013), pq, c, h, r, d, px, 20.0, 0.75), self.down)
    col = col + vec3(nm_grain(self.rect_pos + pq, px))
    let a = Finish.cover(d, px)
    acc = Finish.over(acc, vec4(col * a, a))
    return Finish.over(acc, nm_focus(d, px, self.keyed))
}
mod.widgets.ChipFlat.draw_text.color = #636a7a
mod.widgets.ChipFlat.margin = mod.turtle.Inset{left: 4.0 right: 4.0 top: 4.0 bottom: 4.0}

// SURFACES. A panel is the page raised by a fixed, shallow step whatever
// its size, with a 12 point corner and the light line on its top edge; an
// inset panel is a tray pressed a step into the page, with a lit lip.
let nm_panel = fn(pq: vec2, size: vec2, org: vec2, px: float, face: vec3, r: float, raised: float, sunken: float, lift: float) -> vec4 {
    let c = size * 0.5
    let h = size * 0.5
    let rr = min(r, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    let dark = Finish.drop(pq, c, h, rr, vec2(2.4, 3.0), 3.8) * (0.33 + 0.05 * lift) * raised
    let light = Finish.drop(pq, c, h, rr, vec2(-2.4, -3.0), 3.4) * 0.8 * raised
    var acc = vec4(vec3(0.639, 0.694, 0.776) * dark, dark)
    acc = Finish.over(acc, vec4(light, light, light, light))
    var col = face + vec3(0.004 * lift, 0.004 * lift, 0.004 * lift)
    let top = 1.0 - smoothstep(0.0, 40.0, pq.y)
    col = mix(col, vec3(0.980, 0.984, 1.0), Finish.band(d, 0.0, px, px) * top * 0.6 * raised)
    // The tray: a step down, the page's shadow falling in along its top
    // and left, and the lit lip along its bottom.
    let tray = face - vec3(0.015, 0.015, 0.015)
    let dk = Finish.inset(pq, c, h, rr, vec2(1.0, 1.6), 2.2)
    var tcol = mix(tray, vec3(0.639, 0.694, 0.776), dk * 0.28)
    let low = smoothstep(c.y, size.y, pq.y)
    tcol = mix(tcol, vec3(0.976, 0.980, 0.992), Finish.band(d, 0.0, px, px) * low * 0.7)
    col = mix(col, tcol, sunken)
    col = col + vec3(nm_grain(org + pq, px))
    let a = Finish.cover(d, px)
    return Finish.over(acc, vec4(col * a, a))
}
mod.widgets.RoundedView.clip_x = false
mod.widgets.RoundedView.clip_y = false
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let r = mix(12.0, 10.0, self.sunken)
    return nm_panel(pq, self.rect_size, self.rect_pos, px, self.color.rgb, r, 1.0 - self.sunken, self.sunken, 0.0)
}
mod.widgets.PanelView.draw_bg.color = #e9edf0

// A card is a raised panel too; a pressable one lifts under the pointer.
mod.widgets.Card.radius = 12.0
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 12.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 12.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    // Elevated stands up; filled is a shallow tray; outlined lies flat
    // inside an engraved line. Under the pointer each rises a step.
    let lift = self.hover * (1.0 - self.down)
    let outlined = step(0.01, self.border_size)
    let raised = max(clamp(self.shadow_radius / 4.0, 0.0, 1.0), 0.6 * lift) * (1.0 - self.down)
    let sunk = max((1.0 - clamp(self.shadow_radius / 4.0, 0.0, 1.0)) * (1.0 - outlined) * 0.6 * (1.0 - lift), 0.6 * self.down)
    var acc = nm_panel(pq, self.rect_size, self.rect_pos, px, nm_ground(), self.border_radius, raised, sunk, lift)
    let c = self.rect_size * 0.5
    let d = Material.sd_box(pq, c, c, min(self.border_radius, min(c.x, c.y)))
    let tl = step(0.0, (c.y - pq.y) / max(c.y, 1.0) + (c.x - pq.x) / max(c.x, 1.0) * 0.25)
    let eng = Finish.band(d, 0.0, px, px) * outlined * (1.0 - raised) * 0.9
    return Finish.over(acc, vec4(mix(vec3(0.976, 0.980, 0.992), vec3(0.745, 0.776, 0.827), tl) * eng, eng))
}

// The rounded view keeps whatever colour it is given; a view the colour of
// the page is a surface of the page, and stands up off it like a panel.
mod.widgets.RoundedView.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var fill = self.color
    if self.color_2.x > -0.5 {
        let dir = if self.gradient_fill_horizontal > 0.5 self.pos.x else self.pos.y
        fill = mix(self.color, self.color_2, dir)
    }
    let lower = vec2(self.border_inset.x, self.border_inset.y)
    let upper = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lower + upper) * 0.5
    let h = max((upper - lower) * 0.5, vec2(0.5, 0.5))
    // The corner as the stock face draws it, so a view keeps its shape.
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, r)
    let near = (1.0 - smoothstep(0.02, 0.06, abs(Finish.lum(fill.rgb) - 0.927))) * step(0.99, fill.w)
    let dark = Finish.drop(pq, c, h, r, vec2(1.8, 2.3), 3.0) * 0.3 * near
    let light = Finish.drop(pq, c, h, r, vec2(-1.8, -2.3), 2.6) * 0.75 * near
    var acc = vec4(vec3(0.639, 0.694, 0.776) * dark, dark)
    acc = Finish.over(acc, vec4(light, light, light, light))
    let a = Finish.cover(d, px)
    var col = fill.rgb
    let top = 1.0 - smoothstep(0.0, 24.0, pq.y - lower.y)
    col = mix(col, vec3(0.980, 0.984, 1.0), Finish.band(d, 0.0, px, px) * top * 0.6 * near)
    acc = Finish.over(acc, vec4(col * a * fill.w, a * fill.w))
    let bd = Finish.band(d, 0.0, max(self.border_size, 0.0), px) * step(0.001, self.border_size) * self.border_color.w
    return Finish.over(acc, vec4(self.border_color.rgb * bd, bd))
}

// LIST ROWS. No shadow per row. Between rows an engraved line, inset 8;
// under the pointer a shallow well; the selected row a deeper well with a
// 2 point accent bar at its left end.
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let org = self.rect_pos
    let w = self.rect_size.x
    let h = self.rect_size.y
    let c = vec2(w * 0.5, h * 0.5)
    let hh = vec2(w * 0.5 - 4.0, min(h * 0.5 - 4.0, 12.0))
    let d = Material.sd_box(p, c, hh, 6.0)
    let en = 1.0 - self.disabled
    let k = max(self.selected * 0.6, max(self.hover * 0.35, self.down * 0.5)) * en
    var col = nm_well(vec3(0.910, 0.925, 0.945), p, c, hh, 6.0, d, px, 24.0, 1.0)
    col = col + vec3(nm_grain(org + p, px))
    let wa = Finish.cover(d, px) * min(k * 2.5, 1.0)
    var acc = vec4(col * wa, wa)
    let bar = Material.sd_box(p, vec2(c.x - hh.x + 5.0, c.y), vec2(1.0, hh.y - 4.0), 1.0)
    let ba = Finish.cover(bar, px) * self.selected * en
    acc = Finish.over(acc, vec4(vec3(0.290, 0.486, 0.965) * ba, ba))
    let yb = Finish.snap(org.y + h, px) - org.y
    let inx = step(8.0, p.x) * step(p.x, w - 8.0) * (1.0 - self.selected) * 0.8
    let dk = step(yb - 2.0 * px, p.y) * step(p.y, yb - px) * inx
    let lt = step(yb - px, p.y) * step(p.y, yb) * inx
    acc = Finish.over(acc, vec4(vec3(0.827, 0.851, 0.886) * dk, dk))
    acc = Finish.over(acc, vec4(vec3(0.965, 0.973, 0.984) * lt, lt))
    return acc
}
mod.widgets.ListItem.draw_text.color = #4f5666

// THE OPEN LIST. A raised panel with an 8 point corner; the row under the
// pointer is a shallow well, the chosen row carries its label in the accent
// ink and a check at its right end.
mod.widgets.PopupMenuFlat.draw_bg.vertex = fn() {
    let m = 10.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PopupMenuFlat.draw_bg.pixel = fn() {
    let m = 10.0
    let pq = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_panel(pq, self.rect_size, self.rect_pos, px, nm_ground(), 8.0, 1.0, 0.0, 0.0)
}
mod.widgets.PopupMenuFlat.clip_x = false
mod.widgets.PopupMenuFlat.clip_y = false
mod.widgets.PopupMenuItem.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let c = self.rect_size * 0.5
    let h = self.rect_size * 0.5 - vec2(0.0, 1.0)
    let d = Material.sd_box(p, c, h, 5.0)
    let k = self.hover * 0.5 * (1.0 - self.disabled)
    let col = nm_well(vec3(0.910, 0.925, 0.945), p, c, h, 5.0, d, px, 24.0, 1.0)
    let wa = Finish.cover(d, px) * min(k * 2.5, 1.0)
    var acc = vec4(col * wa, wa)
    let cx = self.rect_size.x - 12.0
    let cy = c.y
    let ck = Finish.cover(min(nm_seg(p, vec2(cx - 3.5, cy), vec2(cx - 1.0, cy + 2.5)), nm_seg(p, vec2(cx - 1.0, cy + 2.5), vec2(cx + 3.5, cy - 2.5))) - 0.75, px) * self.active
    return Finish.over(acc, vec4(vec3(0.290, 0.486, 0.965) * ck, ck))
}
mod.widgets.PopupMenuItem.draw_text.color_active = #3860d6

