// A distance to a segment, for the few strokes the faces draw by hand.
let nm_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A 7 by 4 point chevron, 1.5 point round-capped stroke, pointing down.
let nm_chevron = fn(p: vec2, cx: float, cy: float, px: float) -> float {
    let d = min(nm_seg(p, vec2(cx - 3.5, cy - 2.0), vec2(cx, cy + 2.0)), nm_seg(p, vec2(cx, cy + 2.0), vec2(cx + 3.5, cy - 2.0)))
    return Finish.cover(d - 0.75, px)
}

// TEXT FIELDS. A well with a 6 point corner: the shadow falls in along the
// top, light gathers along the bottom and ends in a one-pixel lip.
let nm_field = fn(pq: vec2, size: vec2, org: vec2, px: float, r: float, hover: float, focus: float, disabled: float) -> vec4 {
    let lo = vec2(Finish.snap(org.x, px), Finish.snap(org.y, px)) - org
    let hi = vec2(Finish.snap(org.x + size.x, px), Finish.snap(org.y + size.y, px)) - org
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let rr = min(r, min(h.x, h.y))
    let d = Material.sd_box(pq, c, h, rr)
    var col = vec3(0.918, 0.929, 0.957)
    col = nm_well(col, pq, c, h, rr, d, px, 26.0, (1.0 + 0.3 * hover) * mix(1.0, 0.35, disabled))
    col = col + vec3(nm_grain(org + pq, px))
    // Focused, a one-pixel accent line on the rim of the well. It stays
    // inside the field's own box: a field clips what it draws, and a long
    // line of text must not spill past it.
    col = mix(col, vec3(0.290, 0.486, 0.965), Finish.band(d, 0.0, px, px) * 0.6 * focus)
    let a = Finish.cover(d, px)
    return vec4(col * a, a)
}
// The inputs a slider, a combo box, a number or a well carries inside
// themselves draw nothing: the control round them is the box.
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.color.w < 0.01 || self.border_radius < 0.5 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_field(pq, self.rect_size, self.rect_pos, px, self.border_radius, self.hover, self.focus, self.disabled)
}
mod.widgets.TextInputFlat.padding.left = 10.0
mod.widgets.TextInputFlat.padding.right = 10.0

// The number field: the same well, with its stepper cut into the right end
// by an engraved line, one pixel dark over one pixel light.
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return nm_field(pq, self.rect_size, self.rect_pos, px, 6.0, self.hover, self.focus, self.disabled)
}
mod.widgets.NumberField.pad_left = 10.0
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let w = self.rect_size.x
    let h = self.rect_size.y
    let mid = floor(h * 0.5)
    let live = 1.0 - self.disabled
    let up = step(p.y, mid)
    let hot = mix(max(0.0, -self.hot), max(0.0, self.hot), up) * live
    let dn = mix(max(0.0, -self.down), max(0.0, self.down), up) * live
    let lift = 0.3 * hot * (1.0 - dn)
    var acc = vec4(lift, lift, lift, lift)
    let sink = 0.2 * dn
    acc = Finish.over(acc, vec4(vec3(0.639, 0.694, 0.776) * sink, sink))
    let inx = step(3.0, p.x) * step(p.x, w - 3.0)
    let iny = step(5.0, p.y) * step(p.y, h - 5.0)
    let dk = max(step(mid - px, p.y) * step(p.y, mid) * inx, step(p.x, px) * iny) * 0.9
    let lt = max(step(mid, p.y) * step(p.y, mid + px) * inx, step(px, p.x) * step(p.x, 2.0 * px) * iny) * 0.9
    acc = Finish.over(acc, vec4(vec3(0.827, 0.851, 0.886) * dk, dk))
    acc = Finish.over(acc, vec4(vec3(0.965, 0.973, 0.984) * lt, lt))
    return acc
}
mod.widgets.NumberSpin.draw_text.color = #636a7a

// The drag-number: the field's well, its track a wash of light over the
// well rather than an accent, and slate digits.
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let pq = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var acc = nm_field(pq, self.rect_size, self.rect_pos, px, 5.0, max(self.hover, self.drag), self.focus, 0.0)
    let d = Material.sd_box(pq, self.rect_size * 0.5, self.rect_size * 0.5, 5.0)
    let wash = step(0.0, self.fill) * step(pq.x, 1.0 + (self.rect_size.x - 2.0) * max(self.fill, 0.0)) * Finish.cover(d + 1.0, px) * 0.4
    return Finish.over(acc, vec4(wash, wash, wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #4f5666
mod.widgets.ValueInput.arrow_color = #7f8796
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// DROP-DOWN. Raised like a button, with a chevron ten points in from the
// right; open, it is pressed in.
