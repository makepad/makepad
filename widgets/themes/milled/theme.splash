mod.theme = mod.themes.dark

// Milled near-black metal lit from inside in orange. Flat machined faces
// with a hard hairline on every edge, shallow relief, tight shadows -- a
// dark panel shows its edges through occlusion, not through wide soft
// shadows -- and everything that is ON glows: the value, the focus, the
// held label. The light ink is a cool grey rather than white, because
// brushed metal never reads as a white highlight.
mod.theme.color_bg_app = #15171b
mod.theme.color_fg_app = #15171b
mod.theme.color_bg_container = #15171b
mod.theme.color_outset = #15171b
mod.theme.color_outset_1 = #15171b
mod.theme.color_outset_2 = #15171b
mod.theme.color_outset_hover = #191b20
mod.theme.color_outset_1_hover = #191b20
mod.theme.color_outset_2_hover = #191b20
mod.theme.color_outset_down = #121418
mod.theme.color_outset_1_down = #121418
mod.theme.color_outset_2_down = #121418
mod.theme.color_outset_disabled = #15171b
mod.theme.color_outset_1_disabled = #15171b
mod.theme.color_outset_2_disabled = #15171b
mod.theme.color_inset = #0e1013
mod.theme.color_inset_1 = #0e1013
mod.theme.color_inset_2 = #0e1013
mod.theme.color_inset_hover = #0b0d10
mod.theme.color_inset_1_hover = #0b0d10
mod.theme.color_inset_2_hover = #0b0d10
mod.theme.color_inset_focus = #0b0d10
mod.theme.color_inset_1_focus = #0b0d10
mod.theme.color_inset_2_focus = #0b0d10
mod.theme.color_inset_active = #0b0d10
mod.theme.color_inset_1_active = #0b0d10
mod.theme.color_inset_2_active = #0b0d10
mod.theme.color_inset_down = #0b0d10
mod.theme.color_inset_1_down = #0b0d10
mod.theme.color_inset_2_down = #0b0d10
mod.theme.color_inset_drag = #0e1013
mod.theme.color_inset_1_drag = #0e1013
mod.theme.color_inset_2_drag = #0e1013
mod.theme.color_inset_empty = #0e1013
mod.theme.color_inset_1_empty = #0e1013
mod.theme.color_inset_2_empty = #0e1013
mod.theme.color_inset_disabled = #121418
mod.theme.color_inset_1_disabled = #121418
mod.theme.color_inset_2_disabled = #121418

// The bevel colours are the old fake-depth stroke: matched to the ground so
// they disappear, the relief replaces them.
mod.theme.color_bevel = #15171b
mod.theme.color_bevel_inset_1 = #15171b
mod.theme.color_bevel_inset_2 = #15171b
mod.theme.color_bevel_outset_1 = #15171b
mod.theme.color_bevel_outset_2 = #15171b
mod.theme.beveling = 0.0

// A cool engraved grey, a shade brighter than the bench's #9aa3ad so it
// still reads on the brightest rung of the surface ladder, and on that rung
// blended with any other dark theme.
mod.theme.color_text = #aab3bd
mod.theme.color_label = #aab3bd
mod.theme.color_label_inner = #aab3bd
mod.theme.color_label_outer = #aab3bd
mod.theme.color_icon = #aab3bd
// Orange is the only colour that is ON.
mod.theme.color_focus = #ff7a18
mod.theme.color_ctrl_active = #ff7a18
mod.theme.color_val = #ff7a18

mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0

// THE MATERIAL
// Tier 2, machined: a narrow, almost square shoulder (curve 0.95), a hard
// hairline, a brushed specular (mid roughness) and almost no gloss sweep.
// The occlusion is strong and short: an edge cut into black metal.
mod.theme.material_level = 2.0
mod.theme.material_light_x = -0.28
mod.theme.material_light_y = -0.60
mod.theme.material_light_z = 0.74
mod.theme.material_light_intensity = 0.85
mod.theme.material_bevel_width = 2.0
mod.theme.material_bevel_curve = 0.95
mod.theme.material_ao = 0.62
mod.theme.material_rim = 0.48
mod.theme.material_specular = 0.30
mod.theme.material_roughness = 0.34
mod.theme.material_gloss = 0.06
mod.theme.material_raise = 2.0
mod.theme.material_sink = 2.5
mod.theme.material_face_gradient = 0.55
mod.theme.material_hairline = 0.70
mod.theme.material_ao_reach = 0.9

// THE PRESS ILLUMINATES, harder than the glossy kit: half a point of travel
// and a strong orange glow, on the face, in its halo and in the label.
mod.theme.material_press_depth = -0.5
mod.theme.material_press_invert = 0.0
mod.theme.material_glow = 0.85
mod.theme.material_ink_glow = 0.90
mod.theme.material_ink_lift = 1.8

mod.theme.material_shadow = 0.60
mod.theme.material_shadow_blur = 7.0
mod.theme.material_shadow_falloff = 1.0
mod.theme.material_contact_ao = 0.55
mod.theme.material_ground_lip = 0.0
mod.theme.material_inner_shadow = 0.66
mod.theme.material_inner_radius = 6.0
mod.theme.material_margin = 6.0
mod.theme.color_material_light = #9aa3ad
mod.theme.color_material_shadow = #000000
mod.theme.color_material_glow = #ff7a18
true
