mod.theme = mod.themes.dark

// Machined anthracite metal. Dark faces sit in thin black bezels and catch
// one device pixel of light on their top edge; wells are cut into the plate
// with a lip under them; caps and thumbs are turned metal. Colour lives only
// in a value and in what is on: one cyan, drawn as thin lines, LED dashes
// and lit faces. Every state of a family is spelled out, because the base
// derived its states once, from its own colours.

// The plate: a cool anthracite with a slight blue cast.
mod.theme.color_bg_app = #26282d
mod.theme.color_fg_app = #2a2c31
mod.theme.color_bg_container = #2a2c31
mod.theme.color_surface_container_lowest = #1c1d21

// Raised faces: a machined slab, lit at the top, falling 2:1 to its foot.
mod.theme.color_outset = #24252b
mod.theme.color_outset_1 = #2b2a30
mod.theme.color_outset_2 = #141319
mod.theme.color_outset_hover = #2a2b31
mod.theme.color_outset_1_hover = #312f36
mod.theme.color_outset_2_hover = #1a191f
mod.theme.color_outset_down = #15141a
mod.theme.color_outset_1_down = #15141a
mod.theme.color_outset_2_down = #15141a
mod.theme.color_outset_focus = #24252b
mod.theme.color_outset_1_focus = #2b2a30
mod.theme.color_outset_2_focus = #141319
mod.theme.color_outset_active = #24252b
mod.theme.color_outset_1_active = #2b2a30
mod.theme.color_outset_2_active = #141319
mod.theme.color_outset_disabled = #x1f1e24
mod.theme.color_outset_1_disabled = #x1f1e24
mod.theme.color_outset_2_disabled = #x1f1e24

// Wells: fields, tracks and boxes cut into the plate.
mod.theme.color_inset = #15141a
mod.theme.color_inset_1 = #15141a
mod.theme.color_inset_2 = #15141a
mod.theme.color_inset_hover = #18171d
mod.theme.color_inset_1_hover = #18171d
mod.theme.color_inset_2_hover = #18171d
mod.theme.color_inset_focus = #17161c
mod.theme.color_inset_1_focus = #17161c
mod.theme.color_inset_2_focus = #17161c
mod.theme.color_inset_active = #15141a
mod.theme.color_inset_1_active = #15141a
mod.theme.color_inset_2_active = #15141a
mod.theme.color_inset_down = #111016
mod.theme.color_inset_1_down = #111016
mod.theme.color_inset_2_down = #111016
mod.theme.color_inset_drag = #111016
mod.theme.color_inset_1_drag = #111016
mod.theme.color_inset_2_drag = #111016
mod.theme.color_inset_empty = #15141a
mod.theme.color_inset_1_empty = #15141a
mod.theme.color_inset_2_empty = #15141a
mod.theme.color_inset_disabled = #1b1a20
mod.theme.color_inset_1_disabled = #1b1a20
mod.theme.color_inset_2_disabled = #1b1a20

// The edge a stock face still draws: the lit top line over the dark foot.
mod.theme.color_bevel = #3b3a40
mod.theme.color_bevel_hover = #434248
mod.theme.color_bevel_focus = #x03e5fb
mod.theme.color_bevel_down = #0b0a10
mod.theme.color_bevel_active = #3b3a40
mod.theme.color_bevel_empty = #3b3a40
mod.theme.color_bevel_disabled = #28272d
mod.theme.color_bevel_inset_1 = #0a090f
mod.theme.color_bevel_inset_2 = #x29282e
mod.theme.color_bevel_outset_1 = #3b3a40
mod.theme.color_bevel_outset_2 = #08080a
mod.theme.beveling = 0.5

// Ink: a cool light grey legend, never white; a dimmer grey for idle marks.
mod.theme.color_text = #b4b5ba
mod.theme.color_text_hover = #c8cacf
mod.theme.color_text_focus = #b4b5ba
mod.theme.color_text_active = #b4b5ba
mod.theme.color_text_down = #9a9aa0
mod.theme.color_text_disabled = #5c5b62
mod.theme.color_text_placeholder = #6b6d75
mod.theme.color_text_placeholder_hover = #7a7c84
mod.theme.color_text_val = #9fa0a6
mod.theme.color_text_meta = #x8e9097
mod.theme.color_text_cursor = #x03e5fb
mod.theme.color_cursor = #x03e5fb
mod.theme.color_label = #aaaaac
mod.theme.color_label_hover = #c8cacf
mod.theme.color_label_focus = #aaaaac
mod.theme.color_label_active = #aaaaac
mod.theme.color_label_down = #8a8990
mod.theme.color_label_disabled = #5c5b62
mod.theme.color_label_inner = #aaaaac
mod.theme.color_label_inner_hover = #c8cacf
mod.theme.color_label_inner_focus = #aaaaac
mod.theme.color_label_inner_active = #aaaaac
mod.theme.color_label_inner_down = #8a8990
mod.theme.color_label_inner_disabled = #5c5b62
mod.theme.color_label_outer = #aaaaac
mod.theme.color_label_outer_hover = #c8cacf
mod.theme.color_label_outer_focus = #aaaaac
mod.theme.color_label_outer_active = #aaaaac
mod.theme.color_label_outer_down = #8a8990
mod.theme.color_label_outer_disabled = #5c5b62
mod.theme.color_icon = #aaaaac
mod.theme.color_icon_hover = #c8cacf
mod.theme.color_icon_focus = #aaaaac
mod.theme.color_icon_active = #aaaaac
mod.theme.color_icon_down = #8a8990
mod.theme.color_icon_disabled = #5c5b62

// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`. One cyan, for values and what is on.
mod.theme.color_ctrl_selected = #x03e5fb
mod.theme.color_focus = #x03e5fb
mod.theme.color_ctrl_active = #x03e5fb
mod.theme.color_val = #x02c3ec
mod.theme.color_selection_focus = #x03e5fb40
mod.theme.color_bg_highlight_inline = #x03e5fb40

mod.theme.color_terminal_bg = #15141a
mod.theme.color_terminal_text = #b4b5ba

// The instruments: emissive cyan digits in a dark well, dark lamp lenses.
mod.theme.color_screen = #0f1113
mod.theme.color_screen_ink = #3fc9dc
mod.theme.screen_ghost = 0.12
mod.theme.color_lamp_off = #1a1c21
mod.theme.lamp_halo = 0.22

// The surface ladder in anthracite, so every widget built on the roles stays
// in the family, with ink that reads on the brightest rung.
mod.theme.color_surface = #26282d
mod.theme.color_surface_dim = #202226
mod.theme.color_surface_bright = #3a3c42
mod.theme.color_surface_container_low = #2a2c31
mod.theme.color_surface_container = #2d2f35
mod.theme.color_surface_container_high = #313339
mod.theme.color_surface_container_highest = #x36383e
mod.theme.color_on_surface = #c4c6cc
mod.theme.color_on_surface_variant = #x8e9097
mod.theme.color_outline = #x7c7e86
mod.theme.color_outline_variant = #3a3c42
mod.theme.color_inverse_surface = #xd7d9de
mod.theme.color_inverse_on_surface = #26282d

// Slim: a 26 point control row, 6 point gaps inside a group, true radii of
// 2 points on controls and 4 on panels.
mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.space_4 = 12.0
mod.theme.space_5 = 18.0
mod.theme.space_6 = 24.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 3.0 bottom: 0.0 left: 3.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 3.0 right: 0.0 bottom: 3.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 6.0 right: 6.0 bottom: 6.0 left: 6.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 6.0 bottom: 0.0 left: 6.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 6.0 right: 0.0 bottom: 6.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 9.0 right: 9.0 bottom: 9.0 left: 9.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 9.0 bottom: 0.0 left: 9.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 9.0 right: 0.0 bottom: 9.0 left: 0.0}
// The rungs the base froze at its own space factor, restated at ours.
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 24.0
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
mod.theme.textselection_corner_radius = 1.0
mod.theme.radius_xs = 1.5
mod.theme.radius_s = 2.0
mod.theme.radius_m = 3.0
mod.theme.radius_l = 4.0

// The base grotesque. A font size draws 1.333 layout points per unit, so
// 8.25 is the 11 point legend of a 26 point row (cap 0.3 of the row).
mod.theme.font_size_base = 8.25
mod.theme.font_size_p = 8.25
mod.theme.font_size_code = 8.25
mod.theme.font_regular = mod.theme.font_regular{font_size: 8.25}
mod.theme.font_label = mod.theme.font_label{font_size: 8.25}
mod.theme.font_bold = mod.theme.font_bold{font_size: 8.25}
mod.theme.font_italic = mod.theme.font_italic{font_size: 8.25}
mod.theme.font_bold_italic = mod.theme.font_bold_italic{font_size: 8.25}
mod.theme.font_code = mod.theme.font_code{font_size: 8.25}
mod.theme.type_title_l_size = 12.0
mod.theme.type_title_m_size = 10.5
mod.theme.type_title_s_size = 9.0
mod.theme.font_title_l = mod.theme.font_bold{font_size: 12.0 line_spacing: 1.2}
mod.theme.font_title_m = mod.theme.font_bold{font_size: 10.5 line_spacing: 1.2}
mod.theme.font_title_s = mod.theme.font_bold{font_size: 9.0 line_spacing: 1.2}
mod.theme.type_body_l_size = 9.0
mod.theme.type_body_m_size = 8.25
mod.theme.type_body_s_size = 7.5
mod.theme.type_label_l_size = 8.25
mod.theme.type_label_m_size = 7.5
mod.theme.type_label_s_size = 6.75
mod.theme.font_body_l = mod.theme.font_regular{font_size: 9.0 line_spacing: 1.35}
mod.theme.font_body_m = mod.theme.font_regular{font_size: 8.25 line_spacing: 1.35}
mod.theme.font_body_s = mod.theme.font_regular{font_size: 7.5 line_spacing: 1.35}
mod.theme.font_label_l = mod.theme.font_bold{font_size: 8.25 line_spacing: 1.2}
mod.theme.font_label_m = mod.theme.font_bold{font_size: 7.5 line_spacing: 1.2}
mod.theme.font_label_s = mod.theme.font_bold{font_size: 6.75 line_spacing: 1.2}
true
