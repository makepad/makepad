use mod.prelude.widgets_internal.*

// Machined anthracite metal. Raised parts are dark slabs set in a two
// device-pixel black bezel, lit by one device pixel along their top edge,
// with a tight contact shadow and one soft layer drawn outside their boxes.
// Wells are cut into the plate: a dark top wall and a faint lip under the
// lower rim. Caps and thumbs are turned metal. The one cyan is a value, a
// lit dash or a lit face, never a tint on the metal. Every rim is one device
// pixel, snapped.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 3.0 bottom: 3.0}
mod.widgets.Button.draw_bg.border_radius = 2.0
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below. Buttons take the same 26.
let field_height = 26.0
let field_pad_v = mod.theme.mspace_1.top
let field_radius = 2.0
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #26282d

// Plain views stop clipping, so a part's shadow may fall into the gap
// beside it. Scroll views keep their own clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// SHARED PARTS. Distances in points, negative inside, y down; `px` is one
// device pixel in points.

let g3 = fn(v: float) -> vec3 {
    return vec3(v, v, v)
}

// A rounded box, true radius.
let ml_rbox = fn(p: vec2, c: vec2, h: vec2, r: float) -> float {
    let rr = clamp(r, 0.0, min(h.x, h.y))
    let q = abs(p - c) - h + vec2(rr, rr)
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0, 0.0))) - rr
}

// A segment's distance.
let ml_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let k = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * k)
}

// A stroked chevron's distance: `w` wide, `hgt` tall, pointing down
// (`flip` 1 points up).
let ml_chevron = fn(p: vec2, c: vec2, w: float, hgt: float, flip: float) -> float {
    let s = mix(1.0, -1.0, flip)
    let a = c + vec2(-w * 0.5, -hgt * 0.5 * s)
    let b = c + vec2(0.0, hgt * 0.5 * s)
    let e = c + vec2(w * 0.5, -hgt * 0.5 * s)
    return min(ml_seg(p, a, b), ml_seg(p, b, e))
}

// A disc laid on the pixel grid: a whole number of device pixels across,
// its edge on a pixel boundary, so its one-pixel rings are one pixel.
// `c` is quad-local; returns (centre.x, centre.y, radius).
let ml_fit = fn(c: vec2, o: vec2, rad: float, px: float) -> vec3 {
    let dn = max(floor(2.0 * rad / px + 0.5), 2.0)
    let r2 = dn * px * 0.5
    let ex = Finish.snap(o.x + c.x - r2, px) - o.x
    let ey = Finish.snap(o.y + c.y - r2, px) - o.y
    return vec3(ex + r2, ey + r2, r2)
}

// The one accent: the lit core, the fill's core, its light and dark rims.
let ml_acc = fn() -> vec3 {
    return vec3(0.012, 0.898, 0.984)
}
let ml_fill = fn() -> vec3 {
    return vec3(0.008, 0.765, 0.925)
}
let ml_rim_hi = fn() -> vec3 {
    return vec3(0.471, 0.863, 0.922)
}
let ml_rim_lo = fn() -> vec3 {
    return vec3(0.231, 0.514, 0.612)
}
// The accent as disabled parts show it: an unlit grey.
let ml_off = fn() -> vec3 {
    return vec3(0.180, 0.180, 0.192)
}
let ml_bezel = fn() -> vec3 {
    return vec3(0.043, 0.039, 0.063)
}
let ml_shadow_ink = fn() -> vec3 {
    return vec3(0.020, 0.016, 0.031)
}

// Signed grain, -amount..amount with a triangular spread, one value per
// device pixel (pass `p / px`). The library hash nearly repeats every 97
// pixels (0.1031 x 97 is almost a whole number), which the eye finds on a
// wide ground; a first hash scaled far up displaces the lattice of the two
// that are summed, so no shift lines them up again.
let ml_grain = fn(q: vec2, amount: float) -> float {
    let i = floor(q)
    let h = Finish.hash(i)
    let a = Finish.hash(i + vec2(h * 397.13, h * 211.71))
    let b = Finish.hash(vec2(i.y * 0.7548 + h * 157.3, i.x * 1.1698 + h * 89.9))
    return (a + b - 1.0) * amount
}

// The plate: a top-lit fall of eight levels over the window, a faint
// darkening toward the far corners, and a bead-blasted surface: one grain
// value per device pixel with a rare brighter speck.
let ml_ground = fn(p: vec2, size: vec2, px: float) -> vec3 {
    let t = clamp(p.y / max(size.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.165, 0.173, 0.192), vec3(0.133, 0.141, 0.161), t)
    let q = (p / max(size, vec2(1.0, 1.0)) - vec2(0.5, 0.42)) * vec2(1.0, 1.15)
    col = col * (1.0 - 0.16 * smoothstep(0.35, 0.9, length(q)))
    col = col + g3(ml_grain(p / px, 0.030))
    let i = floor(p / px)
    let sp = step(0.9975, Finish.hash(vec2(i.x + 71.3, i.y + 19.7 + Finish.hash(i) * 613.7)))
    return col + g3(0.028 * sp)
}

// The face of a raised part by height t 0..1: #2b2a30 at the top, #1f2229
// at the waist, #141319 at the foot, a 2:1 fall.
let ml_face = fn(t: float) -> vec3 {
    let top = vec3(0.169, 0.165, 0.188)
    let mid = vec3(0.122, 0.133, 0.161)
    let foot = vec3(0.078, 0.075, 0.098)
    return mix(mix(top, mid, clamp(t * 2.0, 0.0, 1.0)), foot, clamp(t * 2.0 - 1.0, 0.0, 1.0))
}

// A lit face: a dark cyan ramp under the bezel, the lit body, rising paler
// toward the foot.
let ml_lit_face = fn(t: float, yi: float) -> vec3 {
    let body = mix(vec3(0.004, 0.902, 0.992), vec3(0.510, 0.886, 0.980), smoothstep(0.45, 1.0, t))
    return mix(vec3(0.0, 0.208, 0.255), body, smoothstep(0.0, 3.0, yi))
}

// An LED dash: `lit` 0 shows the unlit bead `off` in its engraved slot, 1
// the lit core, white-hot over its middle third, with a halo of 0.25 at
// one device pixel that is gone within three.
let ml_dash = fn(p: vec2, c: vec2, hw: float, hh: float, px: float, ink: vec3, lit: float, off: vec3) -> vec4 {
    let d = ml_rbox(p, c, vec2(hw, hh), hh)
    let a = Finish.cover(d, px)
    let across = abs(p.y - c.y) / max(hh, 0.001)
    let hot = 1.0 - smoothstep(0.15, 0.6, across)
    let core = mix(ink, vec3(1.0, 1.0, 1.0), 0.55 * hot)
    let col = mix(off, core, lit)
    var out = vec4(col * a, a)
    // the slot's lip under an unlit dash
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y, p.y) * 0.07 * (1.0 - lit)
    out = Finish.over(vec4(lip, lip, lip, lip), out)
    let ha = 0.25 * lit * exp(-max(d - px, 0.0) / (0.6 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A lamp bead: a round lens, lit with a white-hot centre and a tight halo,
// or unlit at a third of its light in a darker hue.
let ml_bead = fn(p: vec2, c: vec2, rad: float, px: float, ink: vec3, lit: float) -> vec4 {
    let q = p - c
    let d = length(q) - rad
    let a = Finish.cover(d, px)
    let rr = clamp(length(q) / max(rad, 0.001), 0.0, 1.0)
    let on = mix(mix(ink, vec3(1.0, 1.0, 1.0), 0.55), ink * 0.8, smoothstep(0.0, 1.0, rr))
    let off = mix(ink * 0.30, ink * 0.18, rr) + g3(0.03)
    var col = mix(off, on, lit)
    col = mix(col, ml_bezel(), Finish.band(d, 0.0, px, px) * 0.6 * (1.0 - lit))
    var out = vec4(col * a, a)
    // the socket: a dark ring outside the lens
    let sock = Finish.ring_out(d, 0.0, px, px) * 0.55
    out = Finish.over(vec4(0.0, 0.0, 0.0, sock * (1.0 - lit)), out)
    let ha = 0.25 * lit * exp(-max(d - px, 0.0) / (0.6 * px)) * (1.0 - a) * step(0.0, d)
    return Finish.over(vec4(ink * ha, ha), out)
}

// A well cut into the plate: the fill, the plate's shadow falling in from
// the top wall, a dark mouth darkest on top. Its lip is `ml_lip`.
let ml_well = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, fill: vec3, depth: float) -> vec3 {
    let d = ml_rbox(p, c, h, r)
    let sh = Finish.inset(p, c, h, r, vec2(0.0, depth * 0.5), max(depth * 0.4, px * 0.6))
    var col = mix(fill, vec3(0.039, 0.035, 0.059), clamp(sh, 0.0, 1.0) * 0.85)
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    col = mix(col, vec3(0.039, 0.035, 0.059), Finish.band(d, 0.0, px, px) * mix(0.5, 0.95, up))
    return col
}

// The lip under a well's lower rim, outside it, confined to the foot and
// the lower corners: premultiplied white.
let ml_lip = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, a: float) -> vec4 {
    let d = ml_rbox(p, c, h, r)
    let foot = smoothstep(c.y + h.y - max(r, 1.0) - 1.5, c.y + h.y, p.y)
    let l = Finish.ring_out(d, 0.0, px, px) * foot * a
    return vec4(l, l, l, l)
}

// Focus: one device pixel of the accent, two device pixels out; no halo.
let ml_focus = fn(d: float, px: float, focus: float) -> vec4 {
    let f = Finish.ring_out(d, 2.0 * px, 3.0 * px, px) * 0.7 * focus
    let k = ml_acc()
    return vec4(k * f, f)
}

// Turned metal: a conic sheen with two bright lobes at twelve and six
// o'clock and two dark ones at three and nine, over lathe rings one device
// pixel apart. `lo` and `hi` are the dark and bright lobes' luminance.
// Returns a luminance.
let ml_conic = fn(q: vec2, px: float, lo: float, hi: float, turn: float) -> float {
    let r = max(length(q), 0.0001)
    let cs = q.x / r
    let sn = q.y / r
    let c1 = cs * cos(turn) - sn * sin(turn)
    let s1 = sn * cos(turn) + cs * sin(turn)
    // cos of twice the angle from vertical: +1 top and bottom, -1 sides
    let c2 = s1 * s1 - c1 * c1
    let k = c2 * 0.5 + 0.5
    var l = mix(lo, hi, k * k * (3.0 - 2.0 * k))
    let rings = Finish.noise(vec2(r / px, 0.37)) - 0.5
    l = l + rings * 0.016 * smoothstep(0.0, 2.0, r)
    // the pinprick where the lobes meet
    l = l + 0.04 * (1.0 - smoothstep(0.0, px * 1.2, r))
    return l
}

// A turned thumb standing on the plate: contact ring, a cast shadow to the
// lower right, a bright chamfer ring, a groove, the spun face. `hover`,
// `press` and `dis` are its states.
let ml_disc = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, press: float, dis: float) -> vec4 {
    let hh = vec2(rad, rad)
    let dia = 2.0 * rad
    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let cast = Finish.drop(p, c, hh, rad, vec2(dia * 0.06, dia * 0.08), dia * 0.14) * 0.6 * (1.0 - 0.5 * press) * mix(1.0, 0.4, dis)
    let ink = ml_shadow_ink()
    out = Finish.over(out, vec4(ink * cast, cast))
    let q = p - c
    let d = length(q) - rad
    let con = Finish.ring_out(d, 0.0, px, px) * 0.7
    out = Finish.over(out, vec4(vec3(0.027, 0.024, 0.047) * con, con))
    var face = g3(ml_conic(q, px, 0.50, 0.80, 0.12 * hover))
    face = face * vec3(0.98, 0.99, 1.0)
    face = face + g3(0.08 * hover - 0.05 * press)
    face = mix(face, mix(g3(0.28), face * 0.45, 0.5), dis)
    // chamfer: a bright ring two device pixels wide, brightest at the foot
    let t = clamp(q.y / rad * 0.5 + 0.5, 0.0, 1.0)
    let ch = mix(vec3(0.78, 0.79, 0.80), vec3(0.96, 0.97, 0.97), smoothstep(0.35, 1.0, t))
    face = mix(face, vec3(0.349, 0.365, 0.369), Finish.band(d, 2.0 * px, 3.0 * px, px) * 0.9)
    face = mix(face, mix(ch, g3(0.32), dis), Finish.band(d, 0.0, 2.0 * px, px) * 0.9)
    face = mix(face, vec3(0.42, 0.43, 0.45), Finish.band(d, 0.0, px, px) * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(out, vec4(face * a, a))
}

// ---------------------------------------------------------------------------
// BUTTONS. One face for the family; `kind` picks the dressing:
// 0 flat plate (no soft layer), 1 raised, 2 raised with a lit dash (primary),
// 3 raised with the dash unlit (secondary), 4 raised with a dark red bead
// (danger), 5 engraved outline, 6 bare until touched, 7 pad (a lighter
// plate with no bezel). The quad is grown by `m` on every side for the
// shadow and the focus ring.
let ml_button = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, down: float, focus: float, disabled: float, loading: float, anim: float, r: float, kind: float, m: float) -> vec4 {
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let press = down * live
    let hov = hover * live * (1.0 - press)
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + size.x, px), Finish.snap(o.y + size.y, px)) - o
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = ml_rbox(p, c, h, r)
    let bare = step(5.5, kind) * step(kind, 6.5)
    let outl = step(4.5, kind) * step(kind, 5.5)
    let pad = step(6.5, kind)
    let solid = 1.0 - bare - outl
    let bez = 2.0 * px * (1.0 - pad)
    let soft_on = step(0.5, kind) * solid

    var out = vec4(0.0, 0.0, 0.0, 0.0)
    let ink = ml_shadow_ink()
    // the soft layer: a little right, mostly below, read at arm's length
    // and faded within the 8 point gap to the next row
    let soft = Finish.drop(p, c, h, r, vec2(0.5, 3.0), 3.2) * 0.40 * soft_on * (1.0 - press) * live
    out = Finish.over(out, vec4(ink * soft, soft))
    // the contact line right under the edge
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px * 1.2) * 0.6 * solid * mix(1.0, 0.25, press) * mix(1.0, 0.5, disabled)
    out = Finish.over(out, vec4(ink * con, con))

    // the face
    let t = clamp((p.y - lo.y) / max(2.0 * h.y, 1.0), 0.0, 1.0)
    let yi = p.y - lo.y - bez
    var face = ml_face(t)
    if pad > 0.5 {
        face = mix(vec3(0.184, 0.188, 0.208), vec3(0.141, 0.149, 0.169), t)
    }
    face = face + g3(0.026 * hov)
    // pressed: a flat well-dark face with the bezel's shadow inside its top
    let sunk = mix(vec3(0.051, 0.047, 0.067), vec3(0.082, 0.078, 0.102), smoothstep(0.0, 2.0 * px + 0.6, yi))
    face = mix(face, sunk, press)
    face = mix(face, vec3(0.122, 0.118, 0.141), disabled)
    face = face + g3(ml_grain((p + o) / px, 0.012))
    // the top highlight: one device pixel, then a short ramp into the face
    let up = 1.0 - smoothstep(-0.5, 0.5, p.y - c.y)
    let topw = 1.0 - smoothstep(lo.y + bez + r + 0.5, lo.y + bez + r + 1.5, p.y)
    let botw = smoothstep(hi.y - bez - r - 1.5, hi.y - bez - r - 0.5, p.y)
    let hl_row = Finish.band(d, bez, bez + px, px) * topw
    let ramp = (1.0 - smoothstep(0.0, 2.0, yi - px)) * step(0.0, yi) * 0.30
    let hl = mix(vec3(0.231, 0.227, 0.251), vec3(0.263, 0.259, 0.282), hov)
    let lit_top = max(hl_row, ramp) * (1.0 - press) * live
    face = mix(face, mix(hl, vec3(0.30, 0.30, 0.32), pad * 0.5), lit_top)
    // the bottom line
    let low = smoothstep(-0.5, 0.5, p.y - c.y)
    face = mix(face, vec3(0.031, 0.031, 0.039), Finish.band(d, bez, bez + px, px) * botw * (1.0 - press) * (1.0 - pad))
    // the bezel, or the pad's single dark edge
    face = mix(face, ml_bezel(), Finish.band(d, 0.0, max(bez, px), px) * mix(1.0, 0.75, pad))

    // the dash of the primary, secondary and danger faces
    if kind > 1.5 && kind < 4.5 {
        let hw = clamp(h.x * 0.42, 5.0, 14.0)
        let dy = Finish.snap(o.y + hi.y - bez - 3.0, px) - o.y
        let is_red = step(3.5, kind)
        let lit = step(kind, 2.5) * live
        let dink = mix(ml_acc(), vec3(0.918, 0.392, 0.431), is_red)
        let doff = mix(vec3(0.035, 0.035, 0.047), vec3(0.227, 0.078, 0.090), is_red)
        let dash = ml_dash(p, vec2(c.x, dy + px), hw, px, px, mix(dink, ml_off(), disabled), lit, mix(doff, vec3(0.06, 0.06, 0.07), disabled))
        face = face * (1.0 - dash.a) + dash.rgb
    }

    var fa = 1.0
    if kind > 4.5 && kind < 6.5 {
        fa = mix(0.0, 0.55, hov) + 0.45 * press
    }
    let a = Finish.cover(d, px) * fa
    out = Finish.over(out, vec4(face * a, a))

    // the engraved outline: a dark line on the edge, light below its top
    // run and under its foot
    if outl > 0.5 {
        let dk = Finish.band(d, 0.0, px, px) * mix(0.85, 0.4, disabled)
        out = Finish.over(out, vec4(ml_bezel() * dk, dk))
        let li = (Finish.band(d, px, 2.0 * px, px) * up + Finish.ring_out(d, 0.0, px, px) * low) * 0.07 * live
        out = Finish.over(out, vec4(li, li, li, li))
    }

    out = Finish.over(out, ml_focus(d, px, focus * live))

    // the wait spinner, which the stock face drew and this one must too
    if loading > 0.0 {
        let sdf = Sdf2d.viewport(p)
        let rr = max(min(h.x, h.y) - 5.0, 2.0)
        let a0 = anim * 2.0 * PI
        sdf.arc_round_caps(c.x, c.y, rr, a0, a0 + 1.5 * PI, 1.2)
        let k = ml_acc()
        sdf.fill(vec4(k * loading, loading))
        out = Finish.over(out, sdf.result)
    }
    return out
}

// The drop-down face: the raised face with an engraved split 22 points
// from its right end (1 dpx dark, 1 dpx light, inset a fifth of the height)
// and a stroked chevron 6 by 3.5 points behind it; `held` is pressed.
let ml_dropdown = fn(pos: vec2, size: vec2, o: vec2, px: float, hover: float, held: float, focus: float, disabled: float, m: float) -> vec4 {
    var out = ml_button(pos, size, o, px, hover, held, focus, disabled, 0.0, 0.0, 2.0, 1.0, m)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let live = 1.0 - disabled
    let dx = Finish.snap(o.x + size.x - 22.0, px) - o.x
    let in_y = step(size.y * 0.2, p.y) * step(p.y, size.y * 0.8)
    let div_d = step(dx - px, p.x) * step(p.x, dx) * in_y * 0.9
    let div_l = step(dx, p.x) * step(p.x, dx + px) * in_y * 0.9 * (1.0 - held)
    let bz = ml_bezel()
    out = Finish.over(out, vec4(bz * div_d, div_d))
    let hl = vec3(0.231, 0.227, 0.251)
    out = Finish.over(out, vec4(hl * div_l, div_l))
    let cc = vec2(size.x - 11.0, Finish.snap(o.y + size.y * 0.5, px) - o.y + held * live * px)
    let ch = Finish.cover(ml_chevron(p, cc, 6.0, 3.5, 0.0) - 0.65, px)
    let ink = mix(mix(vec3(0.667, 0.667, 0.675), vec3(0.784, 0.792, 0.812), hover * live), vec3(0.29, 0.286, 0.314), disabled)
    return Finish.over(out, vec4(ink * ch, ch))
}

let grow_vertex = fn(rp: vec2, rs: vec2, m: float) -> vec4 {
    return vec4(rp.x - m, rp.y - m, rs.x + 2.0 * m, rs.y + 2.0 * m)
}

// Button faces. The flat root and the bare face keep to their own box, so
// every template derived from them with a face of its own is left as it is;
// the raised faces grow their quad for the shadow and the focus ring.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    return ml_button(self.pos, self.rect_size, self.rect_pos, px, self.hover, self.down, self.focus, self.disabled, self.loading, self.anim_time, 2.0, 0.0, 0.0)
}
