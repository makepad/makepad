    let f = fp_button(p, self.rect_pos, self.rect_size, px, vec4(4.0, 4.0, 4.0, 4.0), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_rimc(), 0.0, wd)
