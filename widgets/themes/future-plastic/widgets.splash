use mod.prelude.widgets_internal.*

// Futuristic plastic: slabs of translucent blue-grey plastic standing on a
// dark slate ground traced with faint circuits.
// A slab has thickness: a lit shoulder along its head, a frost sheen over
// its top third, one device pixel of pale rim, and along its foot the light
// that lives inside the plastic: a pale cyan edge that glows up into the
// face and leaks a little onto the ground under it. A dark drop and that
// cyan underglow fall outside the layout box and are gone within half the
// gap to the next control. Pushed in, the slab settles, its head goes dark
// and its light dims. What is on is lit from within.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 3.5
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 3.5
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #121a22

// Shadows and light leave the layout box: plain views stop clipping so a
// shadow can fall into the gap under a control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// THE INKS.
// Shadow ink #03070c; cool white; the accent cyan #56d4f2; the light's pale
// core #c8f4ff; the lit edge #9ff0ff; the halo blue-cyan #3fb6e0.
let fp_ink = fn() -> vec3 { return vec3(0.012, 0.027, 0.047) }
let fp_white = fn() -> vec3 { return vec3(0.94, 0.97, 0.99) }
let fp_acc = fn() -> vec3 { return vec3(0.337, 0.831, 0.949) }
let fp_acc_rim = fn() -> vec3 { return vec3(0.784, 0.957, 1.0) }
let fp_acc_line = fn() -> vec3 { return vec3(0.624, 0.941, 1.0) }
let fp_acc_glow = fn() -> vec3 { return vec3(0.247, 0.714, 0.878) }
// Rose, for error and danger only.
let fp_rose = fn() -> vec3 { return vec3(0.941, 0.416, 0.541) }

// Grain that does not repeat: the library's hash nearly repeats every 97
// cells along an axis, so it is fed a skewed lattice on which no short
// shift lines up again. Signed, triangular, one value per cell.
let fp_grain = fn(p: vec2, amount: float) -> float {
    let i = floor(p)
    let q = vec2(i.x + i.y * 0.4142, i.y - i.x * 0.2718)
    return (Finish.hash(q) - Finish.hash(q.yx * 1.3107 + vec2(17.13, 3.71))) * amount
}

// ---------------------------------------------------------------------------
// THE PLASTIC. Distances in points, negative inside; px is one device pixel.

// The box snapped to device pixels, as (lo, hi) relative to the quad's
// layout origin, so every rim lands on one pixel row.
let fp_snap = fn(o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    return vec4(lo, hi)
}

// Rounded box with a corner per quadrant: (tl, tr, br, bl).
let fp_box = fn(p: vec2, c: vec2, h: vec2, rr: vec4) -> float {
    let q = p - c
    var r = rr.x
    if q.x > 0.0 {
        r = rr.y
        if q.y > 0.0 {
            r = rr.z
        }
    } else {
        if q.y > 0.0 {
            r = rr.w
        }
    }
    return Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
}

// Distance to a segment (a zero-length segment is its point).
let fp_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.000001), 0.0, 1.0)
    return length(pa - ba * t)
}

// ---------------------------------------------------------------------------
// THE CIRCUIT. One function draws the traces on the window's ground and,
// softened, behind every frosted face, both at the same window position, so
// a trace seems to run on under the plastic.

// Where the traces gather: the lower half of the window and its corners,
// stirred by a slow cloud. 0..1. `q` and `ws` in window points.
let fp_dens = fn(q: vec2, ws: vec2) -> float {
    let s = max(ws, vec2(200.0, 200.0))
    let lower = smoothstep(0.30, 0.90, q.y / s.y)
    let dx = min(q.x, s.x - q.x)
    let dy = min(q.y, s.y - q.y)
    let corner = 1.0 - smoothstep(0.0, 0.34 * min(s.x, s.y), length(vec2(dx, dy)))
    let edge = 1.0 - smoothstep(0.0, 0.10 * s.x, dx)
    let cloud = Finish.fbm(q / 260.0 + vec2(1.7, 4.3))
    let base = max(lower, max(corner, edge * 0.55))
    return clamp(base * 0.85 + (cloud - 0.5) * mix(0.35, 0.9, base) + 0.06, 0.0, 1.0)
}
// Whether cell (i, j) of a bus carries its run; the density lowers the bar.
let fp_cell = fn(i: float, j: float, cw: float, rh: float, seed: float, ws: vec2, vert: float) -> float {
    let cc = vec2((i + 0.5) * cw, (j + 0.5) * rh)
    let q = mix(cc, cc.yx, vert)
    let dn = fp_dens(q, ws)
    return step(mix(0.975, 0.40, dn * dn), Finish.hash(vec2(i * 0.917 + seed * 1.31, j * 1.531 + seed * 0.77 + 7.7)))
}
// The lane's height at the left edge of cell i: one of seven steps of 4 points.
let fp_lane_y = fn(i: float, j: float, rh: float, seed: float) -> float {
    return (j + 0.5) * rh + (floor(Finish.hash(vec2(i * 1.371 + seed, j * 2.113 - seed * 0.53)) * 7.0) - 3.0) * 4.0
}
// A run from (x0, yl) to (x1, yr) that changes height by a 45 degree jog at xm.
let fp_jog = fn(p: vec2, x0: float, x1: float, xm: float, yl: float, yr: float) -> float {
    let dd = abs(yr - yl) * 0.5
    let a = vec2(x0, yl)
    let b = vec2(max(xm - dd, x0), yl)
    let c = vec2(min(xm + dd, x1), yr)
    let e = vec2(x1, yr)
    return min(fp_seg(p, a, b), min(fp_seg(p, b, c), fp_seg(p, c, e)))
}
// A bus of one to three parallel traces along u, in rows `rh` tall cut into
// cells `cw` long; a run ends in ring pads, some cells carry a via. Returns
// (distance to a line, distance to a ring, brightness, 0).
let fp_bus = fn(u0: float, v: float, cw: float, rh: float, seed: float, ws: vec2, vert: float) -> vec4 {
    let j = floor(v / rh)
    // Each row's cells are slid by their own amount, so run ends never line
    // up down the page.
    let u = u0 + Finish.hash(vec2(j * 0.37 + seed, 4.2)) * cw
    let i = floor(u / cw)
    let on = fp_cell(i, j, cw, rh, seed, ws, vert)
    let onl = fp_cell(i - 1.0, j, cw, rh, seed, ws, vert)
    let onr = fp_cell(i + 1.0, j, cw, rh, seed, ws, vert)
    let nb = floor(Finish.hash(vec2(j * 0.713 + seed, seed * 1.37 + 2.9)) * 2.99)
    let s = 3.0
    let yl = fp_lane_y(i, j, rh, seed) - nb * s * 0.5
    let yr = fp_lane_y(i + 1.0, j, rh, seed) - nb * s * 0.5
    let x0 = i * cw + mix(4.0, -0.5, onl)
    let x1 = (i + 1.0) * cw - mix(4.0, -0.5, onr)
    let xm = (i + 0.32 + 0.36 * Finish.hash(vec2(i * 3.17 + seed, j * 0.61 + 1.9))) * cw
    let q = vec2(u, v)
    let d0 = fp_jog(q, x0, x1, xm, yl, yr)
    let d1 = mix(99.0, fp_jog(q - vec2(0.0, s), x0, x1, xm, yl, yr), step(0.5, nb))
    let d2 = mix(99.0, fp_jog(q - vec2(0.0, 2.0 * s), x0, x1, xm, yl, yr), step(1.5, nb))
    let dl = mix(99.0, min(d0, min(d1, d2)), on)
    let kl = clamp(floor((v - yl) / s + 0.5), 0.0, nb)
    let pl = abs(length(vec2(u - x0, v - yl - kl * s)) - 1.4) + (1.0 - on * (1.0 - onl)) * 99.0
    let kr = clamp(floor((v - yr) / s + 0.5), 0.0, nb)
    let pr = abs(length(vec2(u - x1, v - yr - kr * s)) - 1.4) + (1.0 - on * (1.0 - onr)) * 99.0
    let vh = Finish.hash(vec2(i * 2.31 + seed, j * 1.77 + 3.3))
    let pv = abs(length(vec2(u - (x1 - 8.0), v - yr)) - 1.2) + (1.0 - on * step(0.70, vh)) * 99.0
    let t = u / cw - i
    let bi = Finish.hash(vec2(i * 0.53 + seed, j * 0.29 + 1.1))
    let bn = Finish.hash(vec2((i + 1.0) * 0.53 + seed, j * 0.29 + 1.1))
    let bp = Finish.hash(vec2((i - 1.0) * 0.53 + seed, j * 0.29 + 1.1))
    let bb = mix(mix(bp, bi, t + 0.5), mix(bi, bn, t - 0.5), step(0.5, t))
    let hot = step(0.80, Finish.hash(vec2(j * 0.37 + seed * 2.1, 8.8)))
    return vec4(dl, min(pl, min(pr, pv)), 0.28 + 0.42 * bb * bb + 0.35 * hot, 0.0)
}
// The traces at window point w: (line, ring pads, glow, light spot), each
// 0..1. `soft` 1 blurs them, as seen through frosted plastic.
let fp_circuit = fn(w: vec2, ws: vec2, px: float, soft: float) -> vec4 {
    let h = fp_bus(w.x, w.y, 84.0, 56.0, 1.0, ws, 0.0)
    let v = fp_bus(w.y, w.x, 90.0, 64.0, 7.0, ws, 1.0)
    let k = 0.50 + 0.50 * fp_dens(w, ws)
    let hw = 0.42
    let lh = mix(Finish.cover(h.x - hw, px), exp(0.0 - h.x * h.x / 2.2), soft) * h.z
    let lv = mix(Finish.cover(v.x - hw, px), exp(0.0 - v.x * v.x / 2.2), soft) * v.z
    let rh = mix(Finish.cover(h.y - 0.40, px), exp(0.0 - h.y * h.y / 1.6), soft) * h.z
    let rv = mix(Finish.cover(v.y - 0.40, px), exp(0.0 - v.y * v.y / 1.6), soft) * v.z
    let gh = (0.45 * exp(0.0 - h.x / 0.8) + 0.14 * exp(0.0 - h.x / 3.0)) * h.z
    let gv = (0.45 * exp(0.0 - v.x / 0.8) + 0.14 * exp(0.0 - v.x / 3.0)) * v.z
    // Soft spots of light far behind: one in some cells of a loose lattice.
    let bc = floor(w / 110.0)
    let bh = Finish.hash(bc * 1.137 + vec2(2.9, 5.3))
    let bp = (bc + vec2(0.2, 0.2) + 0.6 * vec2(Finish.hash(bc + vec2(7.1, 1.3)), Finish.hash(bc + vec2(3.7, 9.9)))) * 110.0
    let bd = length(w - bp)
    let br = 7.0 + 9.0 * Finish.hash(bc + vec2(5.5, 2.2))
    let spot = exp(0.0 - bd * bd / (br * br)) * step(0.55, bh) * (0.5 + 0.5 * k)
    return vec4(max(lh, lv) * k, max(rh, rv) * k, max(gh, gv) * k, spot)
}
// Where a face stands in the window: (window position of the face's own
// origin, window size), from the pass's projection.
let fp_wd = fn(world: vec4, p: vec2, a: vec4, b: vec4) -> vec4 {
    let ws = vec2(2.0 / max(abs(b.x - a.x), 0.000001), 2.0 / max(abs(b.y - a.y), 0.000001))
    return vec4(world.xy - p, ws)
}

// The plastic's face down a slab: pale frosted blue-grey, #9fb8ca at the
// head, #90abbe in the middle, #7d98ac at the foot (T10 reads #8faabd).
let fp_body = fn(yn: float) -> vec3 {
    let a = mix(vec3(0.624, 0.722, 0.792), vec3(0.561, 0.667, 0.741), smoothstep(0.0, 0.55, yn))
    return mix(a, vec3(0.490, 0.596, 0.675), smoothstep(0.55, 1.0, yn))
}
// The frost white alpha a panel's head carries, for the chips and keys.
let fp_lift = fn(yn: float) -> float {
    return mix(mix(0.20, 0.13, clamp(yn * 2.0, 0.0, 1.0)), 0.09, clamp(yn * 2.0 - 1.0, 0.0, 1.0))
}
// The rim's alpha round the edge, as a share of `top`.
let fp_rim = fn(yn: float, xn: float, top: float) -> float {
    let k = top / 0.60
    let v = mix(0.60, 0.30, smoothstep(0.0, 1.0, yn))
    let side = (1.0 - abs(yn * 2.0 - 1.0)) * (0.0 - 0.03 - 0.06 * xn)
    return (v + side) * k
}
// The rim's pale tint, #e0f2fb.
let fp_rimc = fn() -> vec3 { return vec3(0.878, 0.949, 0.984) }

// A slab of frosted plastic on the snapped box b = (lo, hi), premultiplied.
// It stands up: a top face with a bright rounded head edge, and under it a
// wall `wt` tall, the thickness of the slab, where the light inside the
// plastic comes out: pale cyan, brightest at the foot, glowing onto what
// lies under it. A soft shadow falls below. Pressed, the face sinks into
// the wall, its head shades and its light dims.
//   face  the plastic's strength (1 a button, 0 an outline)
//   amb   the shadow's strength
//   rim   the rim's strength
//   tone  a tint laid over the body, premultiplied (a = its share)
//   edge  the colour of the light inside, and cau its strength
//   hero  lit from within: a cyan plastic, its edge lit all round
//   lit   on: the rim turns cyan all round with a halo
//   wd    where the face stands in the window (fp_wd)
let fp_plate = fn(p: vec2, b: vec4, rr: vec4, px: float, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, tone: vec4, rim_col: vec3, edge: vec3, cau: float, hero: float, lit: float, wd: vec4) -> vec4 {
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fp_box(p, c, h, rr)
    let r = min(max(max(rr.x, rr.y), max(rr.z, rr.w)), min(h.x, h.y))
    let live = 1.0 - disabled
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    let hv = hover * (1.0 - down)
    let up = 1.0 - down
    // The wall under the top face; a press sinks the face into it.
    let wt = Finish.snap(min(3.0, h.y * 0.24) * min(face * 1.5, 1.0) * mix(0.55, 1.0, clamp(amb, 0.0, 1.0)), px)
    let sink = wt * 0.8 * down
    let flo = lo + vec2(0.0, sink)
    let fhi = hi - vec2(0.0, wt - sink)
    let fc = (flo + fhi) * 0.5
    let fh = max((fhi - flo) * 0.5, vec2(0.5, 0.5))
    let df = fp_box(p, fc, fh, rr)
    let fin = Finish.cover(df, px)
    let yn = clamp((p.y - flo.y) / max(fhi.y - flo.y, 1.0), 0.0, 1.0)
    // The light inside the plastic.
    let el = (0.62 + 0.45 * hv + 0.55 * hero + 0.35 * lit) * cau * live * (1.0 - 0.65 * down)
    // OUTSIDE. A soft shadow two points down, the dark contact line, the
    // light from the lit foot pooling on the ground below it, and a focus
    // or lit halo all round; each gone within three points to the side.
    let fa = Finish.drop(p, c, h, r, vec2(0.0, mix(2.2, 0.6, down)), mix(2.6, 1.2, down)) * amb * 0.70 * live
    let ct = Finish.ring_out(d, 0.0, px, px) * 0.45 * min(rim, 1.0) * mix(1.0, 0.5, disabled)
    let sh = (1.0 - (1.0 - fa) * (1.0 - ct)) * outside
    var o = vec4(fp_ink() * sh, sh)
    let ug = Finish.drop(p, vec2(c.x, hi.y - 1.5), vec2(max(h.x - 4.0, 1.0), 1.5), 1.5, vec2(0.0, 2.0), 3.8) * el * 2.2 * outside
    let hk = max(focus * 0.80, max(lit * 0.55, hero * 0.50)) * live
    let halo = Finish.drop(p, c, h, r, vec2(0.0, 0.4), 1.5) * hk * outside
    let gl = min(ug + halo, 0.9)
    o = Finish.over(o, vec4(mix(edge, vec3(0.85, 0.97, 1.0), 0.30) * gl, gl))
    // THE TOP FACE: pale frost, lighter above, with what lies behind
    // showing through it softly (the same traces, blurred, a point lower as
    // if bent by the plastic's thickness).
    var col = fp_body(yn)
    col = mix(col, tone.rgb / max(tone.a, 0.001), tone.a)
    col = mix(col, vec3(0.60, 0.85, 0.94), hero * 0.50)
    let wp = wd.xy + p + vec2(0.0, 1.0)
    let cb = fp_circuit(wp, wd.zw, px, 1.0)
    let mott = (Finish.fbm(wp / 16.0) - 0.5) * 0.09
    col = col * (1.0 + mott)
    col = col + vec3(0.20, 0.62, 0.78) * (cb.x * 0.42 + cb.y * 0.30 + cb.z * 0.22) * face
    col = col + vec3(0.45, 0.80, 0.92) * cb.w * 0.24 * face
    col = col * (1.0 + 0.07 * hv - 0.11 * down)
    // The bright rounded head edge: a soft highlight rolling in from the
    // face's head, and a sheen over its upper part.
    let fdep = max(0.0 - df, 0.0)
    let headw = 1.0 - smoothstep(0.15, 0.60, yn)
    col = mix(col, vec3(0.90, 0.96, 0.99), exp(0.0 - fdep / 0.8) * headw * 0.38 * up)
    col = mix(col, vec3(1.0, 1.0, 1.0), (1.0 - smoothstep(0.0, 0.40, yn)) * 0.05 * up)
    // The frame: the slab's rounded shoulder, a band two points wide round
    // a very slightly sunk plateau, paler on the head than down the sides;
    // the plateau's edge is a soft shade on its head side and a pale line
    // on its foot side, as light crossing thick frosted plastic does.
    let bw = min(2.0, fh.y * 0.3)
    let pl = Finish.cover(bw - fdep, px)
    let band = (1.0 - pl) * up * min(face * 1.2, 1.0)
    col = mix(col, vec3(0.80, 0.89, 0.94), band * mix(0.50, 0.22, smoothstep(0.1, 0.8, yn)))
    let pe = Finish.band(fdep - bw, 0.0, px, px) * up * min(face * 1.2, 1.0)
    col = mix(col, vec3(0.36, 0.47, 0.56), pe * headw * 0.35)
    col = mix(col, vec3(0.88, 0.95, 0.99), pe * smoothstep(0.55, 0.9, yn) * 0.40)
    // Light rising into the face from the lit wall below it.
    col = col + edge * exp(0.0 - max(fhi.y - p.y, 0.0) / 3.0) * el * 0.16
    // Pressed: a shadow falls inside from the head.
    let ish = Finish.inset(p, fc, fh, r, vec2(0.0, 1.8), 2.2) * down
    col = mix(col, vec3(0.04, 0.07, 0.10), ish * 0.60)
    // The face's rim: pale on the head, quieter down the sides, a darker
    // line along its foot where it stands over the wall.
    let rb = Finish.band(df, 0.0, px, px)
    let footf = smoothstep(0.55, 0.9, yn)
    let ra = mix(1.0, 0.45, smoothstep(0.1, 0.6, yn)) * (1.0 - footf) * rim * mix(1.0, 0.45, down) * (1.0 + 0.3 * hv)
    col = mix(col, mix(rim_col, vec3(1.0, 1.0, 1.0), 0.5), rb * min(ra, 1.0) * 0.95)
    col = mix(col, vec3(0.30, 0.40, 0.48), rb * footf * 0.40 * step(0.3, wt))
    // THE WALL: plastic seen edge-on, the light inside coming out of it,
    // pale cyan and brightest at the foot.
    let wy = clamp((p.y - fhi.y) / max(hi.y - fhi.y, 0.5), 0.0, 1.0)
    var wc = mix(vec3(0.46, 0.59, 0.68), vec3(0.58, 0.72, 0.80), wy)
    wc = mix(wc, mix(edge, vec3(1.0, 1.0, 1.0), 0.50), min(el * 1.15, 1.0) * mix(0.45, 0.95, smoothstep(0.0, 0.8, wy)))
    wc = mix(wc, vec3(0.08, 0.12, 0.16), step(p.y, fc.y))
    col = mix(col, wc, 1.0 - fin)
    col = mix(col, vec3(0.16, 0.20, 0.24), disabled * 0.78)
    let fa2 = min(face, 1.0) * mix(1.0, 0.60, disabled)
    var f = vec4(col * fa2, fa2)
    // The slab's outline: a thin pale line up the sides, and along the foot
    // the lit core of the edge.
    let ob = Finish.band(d, 0.0, px, px)
    let sidew = (1.0 - footf) * (1.0 - headw)
    f = Finish.over(f, vec4(rim_col * ob * sidew * 0.35 * rim, ob * sidew * 0.35 * rim))
    let core = mix(edge, vec3(1.0, 1.0, 1.0), 0.60)
    f = mix(f, vec4(core, 1.0), ob * smoothstep(0.5, 0.9, (p.y - lo.y) / max(hi.y - lo.y, 1.0)) * min(el * 1.4, 1.0))
    // A focus, a lit state or the hero rings the whole edge in cyan light.
    let fr = ob * max(max(focus, lit * 0.95), hero * 0.85) * live
    f = mix(f, vec4(fp_acc_rim(), 1.0), fr)
    let g = fp_grain(p / px, 0.9 / 255.0) * f.a
    f = vec4(f.rgb + vec3(g, g, g), f.a) * inside
    return Finish.over(o, f)
}

// A recessed well of darker plastic on the shape d: black at `a` over what
// is under it, a dark pixel along its head, a light pixel along its foot
// and quieter light up its sides. Premultiplied.
let fp_well_h = fn(d: float, yn: float, px: float, a: float, foot: float, side: float, hd: float) -> vec4 {
    let inside = Finish.cover(d, px)
    let rb = Finish.band(d, 0.0, px, px)
    let head = rb * (1.0 - smoothstep(0.25, 0.5, yn))
    let low = rb * smoothstep(0.5, 0.75, yn)
    let mid = rb * (1.0 - max(1.0 - smoothstep(0.25, 0.5, yn), smoothstep(0.5, 0.75, yn)))
    var o = vec4(0.0, 0.0, 0.0, a)
    o = Finish.over(o, vec4(0.0, 0.0, 0.0, hd * head))
    let l = foot * low + side * mid
    o = Finish.over(o, vec4(vec3(0.75, 0.88, 0.95) * l, l))
    return o * inside
}
let fp_well = fn(d: float, yn: float, px: float, a: float, foot: float, side: float) -> vec4 {
    return fp_well_h(d, yn, px, a, foot, side, 0.4)
}


// A lit line along the segment a..b, w points across: a near-white core,
// the saturated cyan body and a halo in two parts, a bright near glow and a
// soft far one gone by about eight points, lighting what is round it.
// Premultiplied, laid over `under`.
let fp_beam = fn(under: vec4, p: vec2, a: vec2, b: vec2, w: float, px: float, k: float, hue: vec3) -> vec4 {
    let d = fp_seg(p, a, b) - w * 0.5
    let dd = max(d, 0.0)
    let hg = min(exp(0.0 - dd / 1.1) * 0.62 + exp(0.0 - dd * dd / 18.0) * 0.30, 0.85) * k * (1.0 - Finish.cover(d, px))
    var o = Finish.over(under, vec4(mix(hue, vec3(0.16, 0.55, 0.80), 0.30) * hg, hg))
    let body = Finish.cover(d, px) * k
    o = Finish.over(o, vec4(mix(hue, vec3(0.75, 0.97, 1.0), 0.25) * body, body))
    let cd = fp_seg(p, a, b) - max(w * 0.5 - 0.9, px * 0.6)
    let cr = Finish.cover(cd, px) * k
    return Finish.over(o, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.80) * cr, cr))
}

// A glass bead: a handle, a thumb or a lamp. Its own drop, a pale sphere
// lit from the upper left with a specular spot, cyan light caught in its
// lower half and a thin pale rim. Lit, it glows: a white core, a cyan body
// and a halo round it. Premultiplied, laid over `under`.
let fp_bead = fn(under: vec4, p: vec2, c: vec2, r: float, px: float, hover: float, down: float, disabled: float, lit: float) -> vec4 {
    let d = length(p - c) - r
    let q = (p - c) / max(r, 0.5)
    let live = 1.0 - disabled
    let outside = 1.0 - Finish.cover(d, px)
    let amb = Finish.drop(p, c, vec2(r, r), r, vec2(0.0, 1.0), 1.2) * 0.45 * live * outside * (1.0 - 0.7 * lit)
    var o = Finish.over(under, vec4(fp_ink() * amb, amb))
    let dd = max(d, 0.0)
    let hg = (exp(0.0 - dd / 1.2) * 0.55 + exp(0.0 - dd * dd / (r * 2.0 + 6.0)) * 0.35) * lit * live * outside
    o = Finish.over(o, vec4(fp_acc_glow() * hg, hg))
    let hv = hover * (1.0 - down)
    let l = length(q)
    var col = mix(vec3(0.86, 0.92, 0.95), vec3(0.42, 0.53, 0.61), smoothstep(-0.9, 0.9, q.y))
    col = col * (1.0 - 0.28 * smoothstep(0.55, 1.0, l))
    col = col + fp_acc() * 0.30 * smoothstep(0.1, 0.9, q.y) * smoothstep(0.35, 0.95, l)
    col = col * (1.0 + 0.06 * hv - 0.10 * down)
    // Lit: the bead is a lamp, white at its core.
    let lamp = mix(fp_acc(), vec3(0.94, 0.99, 1.0), 1.0 - smoothstep(0.0, 0.85, l))
    col = mix(col, lamp, lit * live)
    let spec = exp(0.0 - dot(q - vec2(-0.30, -0.42), q - vec2(-0.30, -0.42)) / 0.05) * 0.85 * (1.0 - 0.5 * lit)
    col = mix(col, vec3(1.0, 1.0, 1.0), spec)
    let rb = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(0.92, 0.97, 1.0), fp_acc_rim(), smoothstep(-0.2, 0.8, q.y)), rb * 0.6)
    col = mix(col, vec3(0.30, 0.35, 0.40), disabled * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(o, vec4(col * a, a))
}

// The wait spinner a replaced face draws itself: a pale cyan comet turning
// once a second on a ring where the label was.
let fp_wait = fn(under: vec4, p: vec2, size: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = size * 0.5
    let r = max(min(size.x, size.y) * 0.5 - 6.0, 3.0)
    let q = p - c
    let ring = abs(length(q) - r)
    let a = fract(atan2(q.y, q.x) / 6.2831853 - t)
    let body = Finish.cover(ring - 0.75, px) * a * a * loading
    let track = Finish.cover(ring - 0.5, px) * 0.15 * loading
    let o = Finish.over(under, vec4(fp_white() * track, track))
    return mix(o, vec4(fp_acc_rim(), 1.0), body)
}

// A plastic button: the slab on the snapped box.
let fp_button = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, edge: vec3, hero: float, wd: vec4) -> vec4 {
    let b = fp_snap(o, s, px)
    return fp_plate(p, b, rr, px, hover, down, focus, disabled, face, amb, rim, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), edge, 1.0, hero, 0.0, wd)
}

// ---------------------------------------------------------------------------
// BUTTONS. Slabs 26 points tall, corners of 3.5. The drop and the light
// fall outside the box: the quad grows by `glow_room` and the button stops
// clipping.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.icon_walk = Walk{width: 14.0, height: Fit}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.draw_bg.border_radius = 3.5
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(6.0)
mod.widgets.ButtonFlat.draw_bg.corners = fn() -> vec4 {
    let r = self.border_radius
    return vec4(
        mix(r, self.border_radius_tl, step(0.0, self.border_radius_tl)),
        mix(r, self.border_radius_tr, step(0.0, self.border_radius_tr)),
        mix(r, self.border_radius_br, step(0.0, self.border_radius_br)),
        mix(r, self.border_radius_bl, step(0.0, self.border_radius_bl))
    )
}
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The flat button lies on the ground: the slab without its drop. The size
// ladder wears it too.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.85, 0.3, 0.9, fp_acc_line(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The standard button: the whole slab.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_acc_line(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The one hero: the slab lit from within, cyan through its body.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.1, fp_acc_line(), 1.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The second voice: the standard slab.
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_acc_line(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Tonal: thinner plastic, a lighter drop.
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.8, 0.6, 0.85, fp_acc_line(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Danger: the standard slab with rose light inside it.
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_rose(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Outline: the rim and the lit edge alone over a faint film; the hand
// fills it in.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let face = 0.18 + 0.5 * max(self.hover, self.down)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, face, 0.0, 1.2, fp_acc_line(), 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Flatter: a thin frosted film at rest, lying flat without a wall or a
// shadow (it shares the flat button's dark ink); the slab rises with the
// pointer.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let k = max(max(self.hover, self.down), self.focus)
    let b = fp_snap(self.rect_pos, self.rect_size, px)
    let f = fp_plate(p, b, self.corners(), px, self.hover, self.down, self.focus, self.disabled, 0.66 + 0.34 * max(self.hover, self.down), 0.5 * k, 0.5 + 0.5 * k, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), fp_acc_line(), 0.3 + 0.7 * k, 0.0, 0.0, wd)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}

// Button inks. The faces are pale frosted plastic, so their words are a
// deep blue-grey (#13212d reads 6.6 on the #8faabd middle, 5.4 on the
// #7d98ac foot), darker under the hand; the primary's pale cyan plastic
// takes a deep sea blue, the danger slab a deep wine. The outline has no
// plastic at rest and keeps the near-white. The flatter button shares the
// flat one's ink, so it lies as a thin frosted film even at rest.
let fp_dark_ink = fn(t) {
    t.color = #13212d
    t.color_hover = #0b1720
    t.color_down = #0b1720
    t.color_focus = #0b1720
    t.color_disabled = #6a7885
}
fp_dark_ink(mod.widgets.ButtonFlat.draw_text)
fp_dark_ink(mod.widgets.ButtonSecondary.draw_text)
fp_dark_ink(mod.widgets.ButtonTertiary.draw_text)
fp_dark_ink(mod.widgets.ButtonPrimary.draw_text)
mod.widgets.ButtonPrimary.draw_text.color = #0c2230
mod.widgets.ButtonPrimary.draw_icon.color = #0c2230
fp_dark_ink(mod.widgets.ButtonDanger.draw_text)
mod.widgets.ButtonDanger.draw_text.color = #3a1020
mod.widgets.ButtonDanger.draw_text.color_hover = #2c0a17
mod.widgets.ButtonDanger.draw_text.color_down = #2c0a17
mod.widgets.ButtonDanger.draw_text.color_focus = #2c0a17
mod.widgets.ButtonDanger.draw_icon.color = #3a1020
mod.widgets.ButtonSecondary.draw_icon.color = #13212d
mod.widgets.ButtonTertiary.draw_icon.color = #13212d
mod.widgets.ButtonOutline.draw_text.color = #eef6fb
mod.widgets.ButtonOutline.draw_text.color_hover = #ffffff
mod.widgets.ButtonOutline.draw_text.color_down = #ffffff
mod.widgets.ButtonOutline.draw_text.color_focus = #eef6fb
mod.widgets.ButtonOutline.draw_text.color_disabled = #5d6b78
mod.widgets.ButtonPrimary.draw_bg.loading_color = #c8f4ff
mod.widgets.ButtonFlat.draw_icon.color = #13212d
mod.widgets.ButtonOutline.draw_icon.color = #e2edf4
// The faces built before the sheet (the select's) by their own path.
fp_dark_ink(mod.widgets.Select.face.draw_text)
fp_dark_ink(mod.widgets.MultiSelect.face.draw_text)

// The glint on a top rim: full over the middle 35 % of the width.
let fp_glint = fn(xn: float) -> float {
    let e = clamp((abs(xn - 0.5) - 0.175) / 0.25, 0.0, 1.0)
    return 0.5 + 0.5 * cos(3.14159265 * e)
}

// Templates that draw a face of their own on top of these roots keep the
// plain quad: the grown one is only for the faces written here.
mod.widgets.CopyButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloating.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.ButtonFloatingSm.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.CheckBoxCustom.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.CutButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.RadioButton.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.Toggle.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
mod.widgets.glass.Slider.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos, self.rect_size)
}
