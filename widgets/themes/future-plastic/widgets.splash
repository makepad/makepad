// wash of accent light across it, the digits near-white.
mod.widgets.ValueInput.clip_x = false
mod.widgets.ValueInput.clip_y = false
mod.widgets.ValueInput.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let wd = fp_wd(self.world, p, self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(0.0, 0.0, 0.0, 1.0)), self.draw_pass.camera_projection * (self.draw_pass.camera_view * vec4(1.0, 1.0, 0.0, 1.0)))
    let f = fp_field(p, self.rect_pos, self.rect_size, px, 4.0, max(self.hover, self.drag), self.focus, 0.0, wd)
    let d = Material.sd_box(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(px, px), 4.0)
    let wash = step(0.0, self.fill) * step(p.x, (self.rect_size.x) * max(self.fill, 0.0)) * Finish.cover(d, px) * 0.20
    return Finish.over(f, vec4(fp_acc() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #13212d
mod.widgets.ValueInput.arrow_color = #2a3c4a
fp_field_ink(mod.widgets.ValueInput.text_input.draw_text)
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// DROP-DOWNS. The button's frost at a 4 point corner, with a chevron 8 by
// 4.5 in a 1.25 point stroke, 10 points in from the right; open, the foot
// lights as a focus does.
let fp_chevron = fn(under: vec4, p: vec2, s: vec2, px: float, live: float) -> vec4 {
    let c = vec2(s.x - 14.0, s.y * 0.5)
    let ch = min(fp_seg(p, c + vec2(-4.0, -1.75), c + vec2(0.0, 1.75)), fp_seg(p, c + vec2(0.0, 1.75), c + vec2(4.0, -1.75)))
    let a = Finish.cover(ch - 0.625, px) * mix(0.4, 1.0, live)
    return Finish.over(under, vec4(vec3(0.075, 0.129, 0.176) * a, a))
}
fp_dark_ink(mod.widgets.DropDownFlat.draw_text)
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.padding.left = 10.0
mod.widgets.DropDownFlat.padding.right = 26.0
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
