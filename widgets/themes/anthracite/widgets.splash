use mod.prelude.widgets_internal.*

// Glossy anthracite: blue-grey metal under a light from the top. Caps with
// a deep gloss fall and a specular sheen, polished metal knobs and slider
// balls, brushed plates, blue-white lamps. Every face here is drawn in true
// points (one device pixel is `px`), and every shadow, lip and glow is drawn
// OUTSIDE the layout box: the quad is grown in `vertex`, the templates that
// throw a shadow stop clipping, and no padding is spent on relief.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let an_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let an_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let an_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// A hash that does not line up: the library's hash nearly repeats every 97
// cells, so each cell is first sent to a far cell picked by its own hash.
let an_hash = fn(i: vec2) -> float {
    let j = i + vec2(Finish.hash(i) * 419.0, Finish.hash(i + vec2(5.31, 9.17)) * 263.0)
    return Finish.hash(j)
}
// Value noise on that hash, one unit per cell.
let an_noise = fn(q: vec2) -> float {
    let i = floor(q)
    let f = q - i
    let u = f * f * (vec2(3.0, 3.0) - f * 2.0)
    let a = an_hash(i)
    let b = an_hash(i + vec2(1.0, 0.0))
    let c = an_hash(i + vec2(0.0, 1.0))
    let d = an_hash(i + vec2(1.0, 1.0))
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}
// Horizontal brush streaks, -0.5..0.5: fine lines `s` points apart across,
// long along, over a slower wander so no two strokes run the same.
let an_brush = fn(q: vec2, s: float) -> float {
    let a = an_noise(vec2(q.x / (s * 60.0), q.y / s))
    let b = an_noise(vec2(q.x / (s * 260.0) + 3.1, q.y / (s * 5.0) + 7.7))
    return a * 0.7 + b * 0.3 - 0.5
}
// Grain, one value per device pixel, sd about 0.004 per 0.01 of `amt`.
let an_grain_at = fn(q: vec2, px: float, amt: float) -> float {
    let i = floor(q / px)
    return (an_hash(i) - an_hash(i + vec2(17.13, 3.71))) * amt
}
// A brushed-metal plate's own texture, in the plate's coordinates so it
// moves with it: fine streaks across, the unrepeating grain over them.
let an_plate_tex = fn(p: vec2, px: float) -> float {
    return an_brush(p, 0.7) * 0.030 + an_grain_at(p, px, 0.012)
}

// The window ground at a window point `w` (points) in a window `ww` points
// wide: anthracite lit like a stage. A pool of light hangs over the top
// centre of the window (#5c6672 under it; the pictures measure #66707c at
// the page's top), falls to #2b333b over the middle of the page and to
// #1a1f25 in the lower corners.
let an_ground = fn(w: vec2, px: float, ww: float) -> vec3 {
    let dx = w.x - ww * 0.5
    let y = max(w.y, 0.0)
    // The long fall from the middle of the window to its sides.
    let hx = dx / 300.0
    let base = 0.112 + 0.088 * exp(-hx * hx)
    // The pool: a bright core 170 points to either side over a wide cone
    // of 420, both falling over 210 points down. Its brightest ground stays
    // at #5c6672, so light ink (#dde2e8) keeps 4.5:1 on it even under the
    // light.
    let px2 = dx / 170.0
    let px3 = dx / 420.0
    let py2 = y / 210.0
    let pool = (0.15 * exp(-px2 * px2) + 0.085 * exp(-px3 * px3)) * exp(-py2 * py2)
    // Soft shafts of the light falling through the pool, and a faint
    // brushing that only shows where the light lies.
    let rays = an_noise(vec2(dx / 34.0, y / 420.0 + 5.3)) - 0.5
    let br = an_brush(w, 0.8)
    let v = base * (1.0 + 0.05 * br) + pool * (1.0 + 0.2 * rays + 0.06 * br) + an_grain_at(w, px, 0.012)
    return mix(vec3(0.855, 1.0, 1.16), vec3(0.905, 1.0, 1.10), clamp(pool * 3.2, 0.0, 1.0)) * v
}

// A raised cap: the drop and contact shadows under it, the black outline,
// the quiet face gradient, the one top line, the faint side light, the
// bottom inner rim. `lift` 1 casts the drop shadow, 0 seats the cap on the
// ground with the contact shadow only. `rim` is the bottom inner rim's ink
// (the LED's spill on a lit cap). Premultiplied.
let an_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, disabled: float, focus: float, lift: float, tint: vec3, rim: vec4, gloss: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    // The shadow is sized by the cap's height up to a 24 point cap.
    let sh_h = min(hh, 24.0)
    let d = Material.sd_box(p, c, h, r)
    let up = (1.0 - down) * (1.0 - disabled)
    let small = 1.0 - step(23.5, hh)

    // What the cap throws: a slab standing off the ground. A dense shadow
    // right under the foot (0.9 at half a point, half at 2 points) over a
    // soft fall still a fifth dark 4.5 points down and gone by 9, as the
    // pictures measure it; to the sides both stay inside half an 8 point
    // gap.
    let drop1 = Finish.drop(p, c, h - vec2(0.06 * sh_h, 0.0), r, vec2(0.0, 0.06 * sh_h), 0.05 * sh_h) * 0.9
    let drop2 = Finish.drop(p, c, h - vec2(0.14 * sh_h, 0.02 * sh_h), r, vec2(0.0, 0.12 * sh_h), 0.15 * sh_h) * 0.78
    let drop = (1.0 - (1.0 - drop1) * (1.0 - drop2)) * lift * up
    let contact = Finish.drop(p, c, h, r, vec2(0.0, px), px * 0.6) * 0.9 * (1.0 - 0.6 * disabled)
    let sh = 1.0 - (1.0 - drop) * (1.0 - contact)
    var under = vec4(0.0, 0.0, 0.0, sh)
    // A held cap sits in the ground: a 1 dp lip #474c56 shows on the ground
    // right under its lower edge.
    let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y + h.y * 0.5, p.y) * down * (1.0 - disabled)
    under = Finish.over(under, vec4(0.36, 0.40, 0.45, 1.0) * lip)

    // The face: blue-grey metal lit from the top, #616a75 under the rim
    // falling fast to #23282e at the foot (luminance 0.41, 0.31 at a third,
    // 0.24 at half, 0.17 at the foot), brushed across.
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let ft = 1.0 - pow(1.0 - t, 1.6)
    var face = mix(vec3(0.380, 0.415, 0.458), vec3(0.137, 0.157, 0.180), ft) + tint
    let tx = an_plate_tex(p, px)
    face = face + vec3(tx, tx, tx * 1.05) * 0.8 * up
    // Under the hand the face lifts; a small cap (a check box, a radio, a
    // thumb, a handle) lifts twice as far, or the change is lost on it.
    face = face + vec3(0.050, 0.053, 0.060) * (1.0 + small) * hover * up
    // Held or chosen: sunk like the chosen cell of the segmented strip -- a
    // floor that falls a little, and a shade under the top edge that fades
    // over a fifth of the height. `tint` casts a chosen well blue.
    let shade = 0.55 * (1.0 - smoothstep(0.0, 0.22 * min(hh, 24.0), p.y - lo.y - px))
    let held = mix(mix(vec3(0.125, 0.145, 0.172), vec3(0.094, 0.110, 0.133), t) + tint, vec3(0.0, 0.0, 0.0), shade)
    face = mix(face, held, down * (1.0 - disabled))
    face = mix(face, mix(vec3(0.176, 0.196, 0.224), vec3(0.149, 0.165, 0.192), t), disabled)

    // Which way the outline faces here: the lines below follow it, so a
    // round cap gets an arc where a square one gets a straight line.
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    let r1 = Finish.band(d, px, px * 2.0, px)
    let r2 = Finish.band(d, px * 2.0, px * 3.0, px)
    let r3 = Finish.band(d, px * 3.0, px * 4.0, px)
    // Lacquer: a sheen across the upper part of a raised face, +0.06 at the
    // top, its lower edge rising toward the sides and gone before half the
    // height; `gloss` 1 (buttons, thumbs, the segmented caps) takes all of
    // it, 0 six tenths. A held or disabled cap is matte.
    let uv = clamp((p - lo) / max(hi - lo, vec2(1.0, 1.0)), vec2(0.0, 0.0), vec2(1.0, 1.0))
    face = face + vec3(0.060, 0.064, 0.070) * Finish.sheen(uv, 0.0, 0.46, 0.25) * up * (0.6 + 0.4 * gloss)
    // The specular: a pale bloom on the upper left of the lacquer, where the
    // light from the top left lands on every cap.
    let sw = max(min(0.26 * (hi.x - lo.x), 18.0), 2.0)
    let sq = (p - vec2(lo.x + min(0.22 * (hi.x - lo.x), 14.0), lo.y + 0.12 * hh)) / vec2(sw, max(0.22 * hh, 1.5))
    face = face + vec3(0.130, 0.136, 0.146) * exp(-dot(sq, sq)) * up * (0.55 + 0.45 * gloss)
    // The chamfer: a bevel of two device pixels inside the outline all the
    // way round, lit by the way it faces. Along the top a near-white row
    // (#e0e7ec, luminance 0.9 as measured on the pictures' caps), two rows
    // under it fading into the face; the top-left corner catches a white
    // spot; the sides a light line; the foot the lip's light.
    let topw = smoothstep(0.45, 0.97, -n.y)
    let botw = smoothstep(0.45, 0.97, n.y)
    let sidew = smoothstep(0.6, 1.0, abs(n.x))
    let hot = mix(vec3(0.780, 0.810, 0.840), vec3(0.880, 0.905, 0.925), max(gloss, hover))
    face = mix(face, hot, r1 * topw * up)
    face = mix(face, hot * 0.62, r2 * topw * up)
    face = mix(face, hot * 0.52, r3 * topw * up * 0.45)
    let nl = dot(n, vec2(-0.62, -0.78))
    face = mix(face, vec3(0.97, 0.98, 1.0), (r1 + 0.6 * r2) * smoothstep(0.93, 0.995, nl) * up * 0.9)
    let sidec = mix(vec3(0.440, 0.470, 0.510), vec3(0.240, 0.262, 0.292), t)
    face = mix(face, sidec, (r1 + 0.4 * r2) * sidew * (0.35 + 0.65 * up))
    // The bottom rim: the slab's lower edge catching the light (the LED's
    // spill on a lit cap).
    face = mix(face, rim.rgb, (r1 + 0.35 * r2) * botw * rim.a * (1.0 - disabled))
    // The outline, black at the top, blacker at the bottom.
    let ol = mix(vec3(0.039, 0.039, 0.047), vec3(0.012, 0.012, 0.016), t)
    face = mix(face, mix(ol, vec3(0.035, 0.043, 0.055), disabled), Finish.band(d, 0.0, px, px))

    let a = Finish.cover(d, px)
    var o = Finish.over(under, vec4(face * a, a))
    // Focus: a thin ring of the LED's rim colour just outside the outline,
    // and a 2 point breath of it.
    let ring = Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.glow(d - px, 0.7) * 0.3 * (1.0 - Finish.cover(d, px))
    o = Finish.over(o, vec4(0.290, 0.560, 0.930, 1.0) * clamp(ring, 0.0, 1.0) * focus * (1.0 - disabled))
    return o
}

// An LED bar or dot laid over `dst`: a white-hot core, a 1 dp saturated rim
// and a short halo when lit (`halo` scales it; 0 for a light that shows a
// value); a dark lens when not (a bar: one dark glass). `hs` is the half
// size; the ends are round.
let an_led = fn(dst: vec4, p: vec2, c: vec2, hs: vec2, lit: float, halo: float, px: float, core: vec3, rimc: vec3) -> vec4 {
    let d = Finish.sd_pill(p, c, hs)
    let slot = Finish.cover(d, px)
    // Unlit: a dark lens, not a hole -- a black rim, near-black glass that
    // catches a little of the light on its upper half, and on a dot large
    // enough to show it a small catch-light up and to the left.
    let tl = clamp((p.y - (c.y - hs.y)) / max(2.0 * hs.y, px), 0.0, 1.0)
    var lens = mix(vec3(0.165, 0.176, 0.200), vec3(0.071, 0.078, 0.090), smoothstep(0.2, 0.9, tl))
    let sp = p - (c + vec2(-0.3 * hs.x, -0.35 * hs.y))
    lens = lens + vec3(0.16, 0.17, 0.19) * exp(-dot(sp, sp) / max(2.0 * 0.09 * hs.y * hs.y, 0.001)) * step(1.5, hs.y)
    // A bar has no room for a rim, a light row and a catch-light: unlit it
    // is one glass of three device pixels, falling #1e2127 -> #15171a with a
    // faint cast of the lamp's blue, its top row lifted 0.03.
    let bar = step(hs.y * 2.5, hs.x)
    let gc = c + vec2(0.0, px * 0.5)
    let gd = Finish.sd_pill(p, gc, vec2(hs.x + px * 0.5, px * 1.5))
    let gt = clamp((p.y - (gc.y - px * 1.5)) / (px * 3.0), 0.0, 1.0)
    var glass = mix(vec3(0.118, 0.129, 0.153), vec3(0.082, 0.090, 0.102), gt)
    glass = mix(glass, vec3(0.290, 0.560, 0.930), 0.08) + vec3(0.03, 0.03, 0.03) * (1.0 - step(gc.y - px * 0.5, p.y))
    var o = Finish.over(dst, vec4(0.024, 0.024, 0.031, 1.0) * Finish.ring_out(d, 0.0, px, px) * 0.55 * (1.0 - lit) * (1.0 - bar))
    o = Finish.over(o, vec4(lens, 1.0) * slot * (1.0 - lit) * (1.0 - bar))
    o = Finish.over(o, vec4(glass, 1.0) * Finish.cover(gd, px) * (1.0 - lit) * bar)
    // Lit: the halo first, under the core. Two falls: a thin one that is
    // gone in a device pixel or two, and a wide weak one that lies a little
    // light on the floor round the lamp.
    let x = max(d - px, 0.0)
    let g = (0.45 * exp(-(x * x) / (2.0 * 0.5 * 0.5)) + 0.22 * exp(-(x * x) / (2.0 * 1.4 * 1.4))) * (1.0 - slot)
    o = Finish.over(o, vec4(rimc, 1.0) * g * 0.8 * halo * lit)
    // The saturated rim, one device pixel round the core.
    let rim = Finish.ring_out(d, 0.0, px, px)
    o = Finish.over(o, vec4(rimc, 1.0) * rim * lit)
    // A hot top on the core.
    let hot = 1.0 - smoothstep(0.0, hs.y * 1.2, p.y - (c.y - hs.y))
    let col = mix(core, vec3(1.0, 1.0, 1.0), hot * 0.5)
    o = Finish.over(o, vec4(col, 1.0) * slot * lit)
    return o
}

// The lamp under a chosen label -- the chosen segment's, the tab in use's,
// the Primary's -- counted in whole device pixels. Its core is two rows
// between `xs.x` and `xs.y` (snapped), from the row at `y0` (snapped): the
// top row `core`, the lower one tinted toward `glow`, and one light-blue
// column at either end. Round it the halo lies on the floor in two layers:
// a tight one -- a pale row just above the core (brightest over its
// middle), a blue row under it, two blue-grey rows fading after that, and
// at the ends a pale fall gone three columns out -- over a soft wide one
// that rises three rows above the core, lies faintly along its sides and
// runs on down to the foot of the well. What lies above the core stays
// under an eighth of its light past the pale row, so a descender keeps its
// well. `halo` scales the light round the core; premultiplied over `dst`.
let an_lamp = fn(dst: vec4, p: vec2, xs: vec2, y0: float, px: float, lit: float, halo: float, core: vec3, glow: vec3) -> vec4 {
    // Which row from the core's top, and how many columns past its ends
    // (0 inside, 0.5 on the first column out).
    let k = floor((p.y - y0) / px)
    let e = max(max(xs.x - p.x, p.x - xs.y), 0.0) / px
    let hw = max((xs.y - xs.x) * 0.5, px)
    let dx = clamp(abs(p.x - (xs.x + xs.y) * 0.5) / hw, 0.0, 1.0)
    let pale = mix(glow, core, 0.5)
    let dim = mix(glow, vec3(0.56, 0.58, 0.64), 0.45)
    let m4 = step(-4.5, k) * step(k, -3.5)
    let m3 = step(-3.5, k) * step(k, -2.5)
    let m2 = step(-2.5, k) * step(k, -1.5)
    let m1 = step(-1.5, k) * step(k, -0.5)
    let body = step(-0.5, k) * step(k, 1.5)
    let p1 = step(1.5, k) * step(k, 2.5)
    let p2 = step(2.5, k) * step(k, 3.5)
    let p3 = step(3.5, k) * step(k, 4.5)
    let p4 = step(4.5, k) * step(k, 5.5)
    let p5 = step(5.5, k) * step(k, 6.5)
    // The soft wide layer.
    let wide = exp(-(e * e) / (2.0 * 3.4 * 3.4)) * (1.0 - 0.3 * dx * dx)
    let wa = (0.12 * m4 + 0.22 * m3 + 0.32 * m2 + 0.15 * m1 + 0.20 * body + 0.08 * (p1 + p2 + p3) + 0.25 * p4 + 0.15 * p5) * wide
    var o = Finish.over(dst, vec4(dim, 1.0) * clamp(wa * halo, 0.0, 1.0) * lit)
    // The tight layer.
    let top = exp(-(e * e) / (2.0 * 1.6 * 1.6)) * (1.0 - 0.3 * dx * dx)
    let side = exp(-(e * e) / (2.0 * 2.2 * 2.2))
    let ce = max(e - 1.5, 0.0)
    let ends = 0.5 * exp(-(ce * ce) / (2.0 * 0.75 * 0.75)) * step(1.0, e) * (1.0 - 0.4 * step(0.5, k))
    var a = 0.72 * top * m1 + ends * body
    a = a + (0.50 * p1 + 0.46 * p2 + 0.36 * p3 + 0.10 * p4) * side
    let hc = mix(mix(pale, glow, p1), dim, p2 + p3 + p4)
    o = Finish.over(o, vec4(hc, 1.0) * clamp(a * halo, 0.0, 1.0) * lit)
    // The core and its two end columns; the lower row takes a little of
    // the glow's own hue.
    let hue = glow / max(max(glow.x, glow.y), max(glow.z, 0.001))
    let lower = core * mix(vec3(1.0, 1.0, 1.0), hue, 0.35)
    let inside = 1.0 - step(0.25, e)
    let endc = step(0.25, e) * (1.0 - step(1.0, e))
    let cc = mix(mix(core, lower, step(0.5, k)), mix(core, glow, 0.4), endc)
    return Finish.over(o, vec4(cc, 1.0) * (inside + 0.95 * endc) * body * lit)
}

// A lamp lying in the bottom rim of a lit cap, as the pictures light the
// Primary, the chosen segment and the tab in use: a white-hot bar three
// device pixels tall and `hw` half wide whose last row is `yb` (the row above
// the outline), the glow's colour on the face round it (over 2 points up
// and 4 to either side), a pale halo hugging the bar, and a spill that runs
// out past the outline onto the ground under the cap, a tenth left 8 points
// down. `inside` is the cap's cover, `below` 1 on the ground under it.
// Premultiplied over `dst`.
let an_rim_lamp = fn(dst: vec4, p: vec2, cx: float, hw: float, yb: float, px: float, lit: float, halo: float, core: vec3, glow: vec3, inside: float, below: float) -> vec4 {
    let cy = yb - px
    let d = Finish.sd_pill(p, vec2(cx, cy), vec2(hw, px * 1.5))
    let ex = max(abs(p.x - cx) - hw, 0.0)
    let dy = max(cy - p.y, 0.0)
    let fg = exp(-ex / 4.0) * exp(-dy / 2.0)
    var o = Finish.over(dst, vec4(glow, 1.0) * clamp(fg * 0.6 * halo, 0.0, 1.0) * inside * lit)
    let x = max(d, 0.0)
    let tight = exp(-(x * x) / (2.0 * 0.7 * 0.7)) * (1.0 - Finish.cover(d, px))
    o = Finish.over(o, vec4(mix(glow, core, 0.55), 1.0) * tight * 0.85 * halo * lit * max(inside, below))
    let sy = max(p.y - yb, 0.0)
    let sp = exp(-(ex * ex) / (2.0 * 5.0 * 5.0)) * (0.35 * exp(-sy / 1.6) + 0.30 * exp(-sy / 5.0))
    o = Finish.over(o, vec4(glow * 0.75, 1.0) * sp * below * halo * lit)
    return Finish.over(o, vec4(core, 1.0) * Finish.cover(d, px) * lit)
}

// The three-quarter arc a waiting button turns in place of its label.
let an_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(0.94, 0.98, 1.0, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is the same slim cap: 26 points on a 13 point line, 10
// points either side. Its shadow falls outside the box, so the box is the
// outline and nothing is paid in padding.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
// Glyphs sit at 14 points so an icon never makes a cap taller than the row;
// an icon alone gets a square cap.
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
// The caps that carry a lamp lift their label one device pixel, so the lamp
// can stand two rows off the bottom rim and still clear the descenders.
mod.widgets.ButtonPrimary.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.3333 bottom: 4.6667}
mod.widgets.ButtonSecondary.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.3333 bottom: 4.6667}
mod.widgets.ButtonDanger.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 3.3333 bottom: 4.6667}
// The short rungs keep their own heights under the row minimum.
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
// The smallest rung's label one step down, so its cap height is a third of
// its cap like every other rung's.
mod.widgets.ButtonXs.draw_text.text_style.font_size = 7.0
mod.widgets.ButtonFlat.draw_bg.border_radius = 1.0
mod.widgets.ButtonFlat.draw_bg.border_size = 0.34
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The cap and its states, shared by every button template; `kind` picks the
// variant: 0 seated cap, 1 raised cap, 2 primary (lit LED), 3 secondary (dark
// LED slot), 4 tonal (tinted face), 5 danger (red LED), 6 outline, 7 flatter.
let an_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, disabled: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 14.0
    let px = an_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(an_snap(0.0, o.x, px), an_snap(0.0, o.y, px))
    let hi = vec2(an_snap(size.x, o.x, px), an_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = 4.0
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if kind > 5.5 {
        // Outline: no face, the black ring cut into the ground with its lip;
        // under the hand a faint cap shows, held it sinks.
        let d = Material.sd_box(p, c, h, r)
        if kind > 6.5 {
            // Flatter: nothing at rest.
            if hover + down + focus > 0.001 {
                res = an_cap(p, lo, hi, r, px, hover, down, disabled, 0.0, 0.0, vec3(0.0, 0.0, 0.0), vec4(0.270, 0.298, 0.330, 1.0), 1.0) * clamp(max(hover, down), 0.0, 1.0)
            }
        } else {
            var ring = Finish.band(d, 0.0, px, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let lip = Finish.ring_out(d, 0.0, px, px) * step(c.y + h.y * 0.5, p.y)
            let inner = Finish.band(d, px, px * 2.0, px) * step(p.y, c.y - h.y * 0.5)
            res = vec4(0.36, 0.40, 0.45, 1.0) * lip * 0.9
            res = Finish.over(res, vec4(0.0, 0.0, 0.0, 1.0) * inner * 0.25)
            res = Finish.over(res, vec4(0.039, 0.039, 0.047, 1.0) * ring)
            if hover + down > 0.001 {
                res = Finish.over(res, an_cap(p, lo, hi, r, px, hover, down, disabled, 0.0, 0.0, vec3(0.0, 0.0, 0.0), vec4(0.270, 0.298, 0.330, 1.0), 1.0) * clamp(max(hover, down), 0.0, 1.0) * 0.85)
            }
        }
        let fr = Finish.ring_out(d, 0.0, px, px) * 0.9 + Finish.glow(d - px, 0.7) * 0.3 * (1.0 - Finish.cover(d, px))
        res = Finish.over(res, vec4(0.290, 0.560, 0.930, 1.0) * clamp(fr, 0.0, 1.0) * focus * (1.0 - disabled))
    } else {
        var tint = vec3(0.0, 0.0, 0.0)
        var rim = vec4(0.270, 0.298, 0.330, 1.0)
        let lit = 1.0 - disabled
        if kind > 3.5 && kind < 4.5 {
            // The tonal cap: the face a breath toward the LED's blue, no
            // more than 4 steps of blue over the family's face.
            tint = vec3(-0.004, 0.0, 0.012)
        }
        if kind > 1.5 && kind < 2.5 {
            // Primary: the face a little blue, the rim the lamp's.
            rim = vec4(0.290, 0.560, 0.930, 0.6 * lit)
            tint = vec3(-0.008, 0.014, 0.045) * lit
        }
        if kind > 4.5 {
            rim = vec4(0.56, 0.22, 0.18, 0.45 * lit)
        }
        var lift = 1.0
        if kind < 0.5 {
            lift = 0.0
        }
        res = Finish.over(res, an_cap(p, lo, hi, r, px, hover, down, disabled, focus, lift, tint, rim, 1.0))
        let dp = Material.sd_box(p, c, h, r)
        let inside = Finish.cover(dp, px)
        if kind > 1.5 && kind < 2.5 {
            // Primary is lit from within: a blue-white bloom fills the top
            // of the face under the rim (luminance 0.75 there, 0.45 a
            // quarter down, as the picture's Primary measures) and fades
            // toward the ends.
            let top = max(p.y - lo.y - px * 2.0, 0.0)
            let ux = (p.x - c.x) / max(h.x, 1.0)
            let bloom = exp(-top / (0.24 * (hi.y - lo.y))) * (1.0 - 0.4 * ux * ux) * Finish.cover(dp + px * 2.0, px)
            let on = lit * (1.0 - down * 0.6)
            res = Finish.over(res, vec4(0.640, 0.760, 0.920, 1.0) * bloom * 0.68 * on)
        }
        if kind > 1.5 && kind < 3.5 || kind > 4.5 {
            // The lamp lies in the bottom rim: a white-hot bar three device
            // pixels tall on the row above the outline, 15 points long,
            // lighting the face round it and spilling onto the ground under
            // the cap. Held, its light halves. Unlit (Secondary, or
            // disabled) it is the dark glass.
            let yb = an_snap(hi.y, o.y, px) - px
            let hw = min(6.0, h.x * 0.36)
            var on = lit
            var core = vec3(0.960, 0.985, 1.0)
            var glow = vec3(0.330, 0.600, 0.980)
            if kind > 2.5 && kind < 3.5 {
                on = 0.0
            }
            if kind > 4.5 {
                // Danger: the same lamp, red.
                core = vec3(1.0, 0.86, 0.82)
                glow = vec3(0.92, 0.26, 0.2)
            }
            let below = (1.0 - inside) * step(hi.y - px, p.y)
            let dark = an_led(res, p, vec2(c.x, yb - px * 1.5), vec2(hw, px), 0.0, 0.0, px, core, glow)
            let lamp = an_rim_lamp(res, p, c.x, hw, yb, px, 1.0, 1.0 - down * 0.5, core, glow, inside, below)
            res = mix(dark, lamp, on)
        }
    }
    if loading > 0.001 {
        // The arc ends two device pixels or more above where a lamp's rim
        // stands: a smaller ring, lifted one device pixel.
        let rad = max(min(h.x, h.y) - 7.25, 2.0)
        res = an_spinner(res, p, c - vec2(0.0, px), rad, anim, loading, 1.5)
    }
    return res
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return an_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0)
}
