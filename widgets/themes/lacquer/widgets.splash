    let dyt = length(dFdy(self.t))
    if self.texture_index < 0.5 {
        let tex_size = self.grayscale_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let pm = clamp(self.t.xy - nudge, self.t_min + half_texel, self.t_max - half_texel)
        let main = self.sdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
        let ps = clamp(self.t.xy - nudge - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let s = self.sdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0))
        return main + vec4(0.0, 0.0, 0.0, s * 0.5 * c.a) * (1.0 - main.a)
    }
    if self.texture_index > 1.5 && self.texture_index < 2.5 {
        let tex_size = self.msdf_texture.size()
        let scale = (dxt + dyt) * tex_size.x * 0.5
        let half_texel = vec2(0.5 / tex_size.x, 0.5 / tex_size.y)
        let pm = clamp(self.t.xy - nudge, self.t_min + half_texel, self.t_max - half_texel)
        let main = self.msdf(scale, pm, c) * vec4(c.rgb * c.a, c.a)
        let ps = clamp(self.t.xy - nudge - dFdy(self.t.xy), self.t_min + half_texel, self.t_max - half_texel)
        let s = self.msdf(scale, ps, vec4(0.0, 0.0, 0.0, 1.0))
        return main + vec4(0.0, 0.0, 0.0, s * 0.5 * c.a) * (1.0 - main.a)
    }
    return self.sample_text_pixel()
}
