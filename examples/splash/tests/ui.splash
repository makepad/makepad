use mod.std.assert
use mod.test

test.configure({
    launch: "splash_run_item"
    visible_run_item: "makepad-example-splash"
    headless_run_item: "makepad-example-splash-headless-test"
})

test.case("splash_buttons_press_hook_smoke", || {
    let buttons_tab = {id: "buttons_tab" text_exact: "Buttons"}
    test.wait_visible(buttons_tab)
    test.click(buttons_tab)
    test.wait_checked(buttons_tab, true)
    test.wait_text({id: "press_status"}, "Last press: none")
    test.click({id: "press_demo_button"})
    test.wait_text({id: "press_status"}, "Last press: Run on_press")
})

test.case("splash_modal_and_slide_panel_smoke", || {
    let modal_tab = {id: "modal_tab" text_exact: "Modal"}
    let slidepanel_tab = {id: "slidepanel_tab" text_exact: "SlidePanel"}

    test.wait_visible(modal_tab)
    test.click(modal_tab)
    test.wait_checked(modal_tab, true)
    test.click({id: "open_modal_btn"})
    test.wait_text({id: "modal_status"}, "Modal status: Basic Modal Open")
    test.click({id: "close_modal_btn"})
    test.wait_text({id: "modal_status"}, "Modal status: Closed via button")

    test.wait_visible(slidepanel_tab)
    test.click(slidepanel_tab)
    test.wait_checked(slidepanel_tab, true)
    test.click({id: "slide_left_btn"})
    test.wait_text({id: "slide_status"}, "Slide status: Left open")
    test.click({id: "close_left_panel_btn"})
    test.wait_text({id: "slide_status"}, "Slide status: Left closed")
})

test.case("splash_toggle_radio_and_dropdown_smoke", || {
    let toggles_tab = {id: "toggles_tab" text_exact: "Toggles"}

    test.wait_visible(toggles_tab)
    test.click(toggles_tab)
    test.wait_checked(toggles_tab, true)
    test.click({id: "checkbox"})
    test.wait_checked({id: "checkbox"}, true)
    test.click({id: "toggle"})
    test.wait_checked({id: "toggle"}, true)
    test.click({id: "radio2"})
    test.wait_checked({id: "radio2"}, true)
    test.wait_text({id: "smoke_dropdown"}, "Option A")
})

test.case("text_input_smoke", || {
    test.wait_visible({id: "open_text_tab_btn"})
    test.click({id: "open_text_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Text")
    test.wait_visible({id: "username"})
    test.fill({id: "username"}, "alice")
    test.wait_value({id: "username"}, "alice")
    test.fill({id: "password"}, "hunter2")
    test.wait_value({id: "password"}, "hunter2")
})

test.case("dropdown_selection_smoke", || {
    test.wait_visible({id: "open_dropdowns_tab_btn"})
    test.click({id: "open_dropdowns_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Selects")
    test.wait_visible({id: "dropdown"})
    test.wait_text({id: "dropdown_status"}, "Dropdown status: Option A")
    test.click({id: "dropdown"})
    test.press_key("ArrowDown")
    test.wait_text({id: "dropdown_status"}, "Dropdown status: Option B")
})

test.case("slider_value_smoke", || {
    test.wait_visible({id: "open_sliders_tab_btn"})
    test.click({id: "open_sliders_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Sliders")
    test.wait_visible({id: "slider"})
    test.wait_text({id: "slider_status"}, "Slider status: 50")
    test.drag({id: "slider"}, 10000, 0)
    test.wait_text({id: "slider_status"}, "Slider status: 100")
})

test.case("tooltip_popup_smoke", || {
    let buttons_tab = {id: "buttons_tab" text_exact: "Buttons"}

    test.wait_visible(buttons_tab)
    test.click(buttons_tab)
    test.wait_checked(buttons_tab, true)
    test.wait_text({id: "overlay_status"}, "Overlay status: idle")
    test.click({id: "normal_tooltip_button"})
    test.wait_text({id: "overlay_status"}, "Overlay status: Normal tooltip shown")
    test.click({id: "callout_tooltip_button"})
    test.wait_text({id: "overlay_status"}, "Overlay status: Callout tooltip shown")
    test.click({id: "show_popup_btn"})
    test.wait_text({id: "overlay_status"}, "Overlay status: Popup shown")
    test.click({id: "hide_popup_btn"})
    test.wait_text({id: "overlay_status"}, "Overlay status: Popup hidden")
})

test.case("fold_header_smoke", || {
    test.wait_visible({id: "open_folds_tab_btn"})
    test.click({id: "open_folds_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Folds")
    test.wait_visible({id: "settings_fold_button"})
    test.wait_text({id: "fold_status"}, "Fold status: Settings closed")
})

test.case("expandable_panel_smoke", || {
    test.wait_visible({id: "open_expandable_tab_btn"})
    test.click({id: "open_expandable_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Expandable")
    test.wait_visible({id: "reset_btn"})
    test.click({id: "reset_btn"})
    test.wait_text({id: "expandable_status"}, "Expandable status: reset")
    test.drag({id: "expandable"}, 0, -180)
    test.wait_text({id: "expandable_status"}, "Expandable status: moved")
})

test.case("slides_navigation_smoke", || {
    test.wait_visible({id: "open_slides_tab_btn"})
    test.click({id: "open_slides_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: Slides")
    test.wait_visible({id: "slides"})
    test.wait_text({id: "slides_status"}, "Slides status: 0 - Welcome to Makepad")
})

test.case("file_tree_smoke", || {
    test.wait_visible({id: "open_filetree_tab_btn"})
    test.click({id: "open_filetree_tab_btn"})
    test.wait_text({id: "nav_status"}, "Navigation: FileTree")
})
