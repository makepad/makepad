// The pixel of a fused pass (pass.rs `fuse`): the colour at the pixel
// through its members' pixels, in order. A member's pixel takes the colour
// so far (`self.f<k>_pixel(c)`, see the shader compiler's fn namespaces).
use mod.pod.*
use mod.math.*
use mod.shader.*
use mod.shared.*
use mod.draw
{
    fuse_2: fn() -> vec4 {
        var c = self.color.sample(self.uv())
        c = self.f0_pixel(c)
        c = self.f1_pixel(c)
        return c
    }
