use mod.flow.*

/** Genre, tempo, mood, vocals, and arrangement. */
let prompt = Input{ type: @text  default: "slow dub techno, 92 BPM, deep chord echoes, instrumental"  at: vec2(40, 80) }

/** Optional section-tagged lyrics; leave empty for instrumental music. */
let lyrics = Input{ type: @text  default: "[Instrumental]"  at: vec2(40, 240) }

let request = Fn{
    in: { prompt: prompt.text()  lyrics: lyrics.text() }
    out: [@text]
    run: |i| { {text: i.prompt + "\n\nLyrics:\n" + i.lyrics} }
    at: vec2(360, 160)
}

let music = Music{
    prompt: request.text()
    seconds: 180
    at: vec2(680, 160)
}

/** The generated song. */
let song = Output{ type: @audio  value: music.audio()  at: vec2(1000, 160) }

Flow{
    label: "Music"
    brief: "Generates a three-minute song from a production brief and optional structured lyrics."
    prompt, lyrics, request, music, song
}
