use mod.flow.*

/** The image to create and refine. */
let prompt = Input{ type: @text  default: "a weathered fantasy creature portrait"  at: vec2(40, 120) }

let expand = Llm{
    system: "Rewrite the prompt as a clean high-detail image brief. Preserve identity, silhouette, and composition."
    prompt: prompt.text()
    at: vec2(360, 120)
}

let image = Image{
    prompt: expand.text()
    width: 512
    height: 512
    steps: 20
    at: vec2(680, 120)
}

let enhance = ImageEdit{
    prompt: expand.text()
    image: image.image()
    strength: 1.0
    model: "flux2-dev"
    at: vec2(1000, 120)
}

/** The high-detail image. */
let picture = Output{ type: @image  value: enhance.image()  at: vec2(1320, 120) }

Flow{
    label: "Image enhance"
    brief: "Expands a prompt, paints a source image, and refines it with the creator's high-detail edit model."
    prompt, expand, image, enhance, picture
}
