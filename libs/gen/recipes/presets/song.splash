use mod.flow.*

/** The song: genre, mood, voice, instruments. */
let prompt = Input{ type: @text default: "upbeat indie pop, bright female vocal, handclaps" }
/** The words, section-tagged: [verse], [chorus], [bridge]. */
let lyrics = Input{ type: @text default: "" }
let song = Music{ prompt: prompt.text() lyrics: lyrics.text() model: "minimax-music3-q4" seconds: 120 }
let published = Publish{ value: song.out(@audio) tags: ["music", "song"] }

Flow{
    label: "Song"
    brief: "A song with sung lyrics to length (5 to 300 seconds)."
    prompt, lyrics, song, published
}
