// Stereo soft clip, hard clip, fold or asymmetric saturation at 4x.
// The tone and DC filters keep their cutoff in Hz at every node rate.
rate(4)
let amount = param(0.5, 0, 1)
let mode = param(0, 0, 3)
let tone = param(9000, 500, 18000)
let blend = param(1, 0, 1)
let level = param(0.8, 0, 2)

var tl = OnePole{}
var tr = OnePole{}
var dl = OnePole{}
var dr = OnePole{}
var pre = 1.0
var post = 1.0

fn block() {
    onepole_set(tl, tone)
    onepole_set(tr, tone)
    onepole_set(dl, 10.0)
    onepole_set(dr, 10.0)
    pre = exp2(amount * 5.0)
    post = 1.0 / soft_clip(pre)
}

fn shape(x) {
    match int(mode) {
        0 => soft_clip(x),
        1 => hard_clip(x),
        2 => fold(x),
        _ => asym_clip(x, 0.3),
    }
}

fn effect(l, r) {
    let yl = onepole_hp(dl, onepole_lp(tl, shape(l * pre) * post))
    let yr = onepole_hp(dr, onepole_lp(tr, shape(r * pre) * post))
    vec2(mix(l, yl * level, blend), mix(r, yr * level, blend))
}
