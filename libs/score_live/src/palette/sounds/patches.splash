    dark_drone: {family: @pad roles: "pad texture" tags: "dark drone ambient cinematic cold minimal" mono: false volume: 0.85
        about: "a dark slow drone of filtered saws and noise"
        layers: analog(Analog{wave: @saw wave2: @saw detune: 14 osc2: 0.9 sub: 0.4 noise: 0.15 cutoff: 600 env: 400 fdecay: 3 res: 1.8 a: 1.5 d: 2 s: 0.9 r: 2.5 level: 0.15})}
    house_organ: {family: @organ roles: "chords bass" tags: "house organ 90s stab percussive" mono: false volume: 2.00
        about: "the 90s house organ stab: percussive drawbars with a click"
        layers: organ(Organ{bars: [0.8 1.0 0.2 0.7 0.5] click: 0.3 vib: 0 vib_depth: 0 a: 0.002 d: 0.25 s: 0.2 r: 0.08 level: 0.18})}
    chord_stab: {family: @pluck roles: "chords hits" tags: "house deep_house chord stab 90s dub_techno short" mono: false volume: 1.8
        about: "a short dark chord stab for deep house and dub techno"
        layers: analog(Analog{wave: @saw wave2: @saw detune: 9 osc2: 0.9 sub: 0 cutoff: 600 env: 2400 fdecay: 0.14 res: 1.6 a: 0.002 d: 0.22 s: 0 r: 0.12 level: 0.2})}
    fm_epiano: {family: @keys roles: "chords" tags: "electric_piano fm 80s ballad city_pop glassy tine" mono: false volume: 1.10
        about: "a glassy 80s FM electric piano"
        layers: fm(Fm{ratio: 1 index: 2.2 index_to: 0.3 idecay: 1.2 ratio2: 14 index2: 2.2 decay2: 0.12 level2: 0.35 partial: 0.1 a: 0.002 d: 2.2 s: 0.15 r: 0.5 level: 0.28})}
    fm_bell: {family: @bell roles: "lead hits" tags: "bell fm metallic glassy chime 80s ambient" mono: false volume: 0.59
        about: "a long inharmonic FM bell"
        layers: fm(Fm{ratio: 3.5 index: 4 index_to: 0.2 idecay: 2.5 ratio2: 7.1 index2: 1.2 decay2: 0.6 level2: 0.3 partial: 0 a: 0.001 d: 3 s: 0 r: 1 level: 0.26})}
    fm_mallet: {family: @bell roles: "lead arp" tags: "mallet marimba fm wooden soft percussive" mono: false volume: 0.91
        about: "a woody FM mallet"
        layers: fm(Fm{ratio: 4 index: 2 index_to: 0 idecay: 0.08 ratio2: 10 index2: 0.6 decay2: 0.03 level2: 0.3 partial: 0 a: 0.001 d: 0.6 s: 0 r: 0.2 level: 0.4})}
    synth_pluck: {family: @pluck roles: "arp chords" tags: "pluck analog edm tropical synthwave bright short" mono: false volume: 4.00
        about: "a bright analog pluck with a fast filter envelope"
        layers: analog(Analog{wave: @saw wave2: @square detune: 7 osc2: 0.5 sub: 0 cutoff: 500 env: 6000 fdecay: 0.15 res: 1.3 a: 0.001 d: 0.3 s: 0 r: 0.15 level: 0.22})}
    string_pluck: {family: @pluck roles: "arp lead" tags: "pluck string physical guitar_like harp soft" mono: false volume: 1.68
        about: "a physical plucked string, warm and short"
        layers: pluck(Pluck{damping: 0.25 decay: 1.4 pick: 0.15 bright: 4000 body: 0.25 level: 0.5})}
    poly_brass: {family: @brass roles: "chords hits" tags: "synth_brass analog 80s synthpop stab swell bright" mono: false volume: 1.14
        about: "a poly analog brass with a swelling filter"
        layers: analog(Analog{wave: @saw wave2: @saw detune: 9 osc2: 0.9 sub: 0 filter: @ladder cutoff: 1200 env: 3500 fdecay: 0.25 res: 1 a: 0.04 d: 0.3 s: 0.75 r: 0.18 drive: 1 level: 0.2})}
    string_machine: {family: @strings roles: "pad chords" tags: "string_machine synth_strings 70s disco ensemble lush" mono: false volume: 0.80
        about: "a 70s string machine: bright detuned saws with chorus-like spread"
        layers: supersaw(Supersaw{spread: 14 width: 0.7 cutoff: 5000 env: 0 res: 0.7 body: 0 a: 0.25 d: 0.8 s: 0.9 r: 0.8 vib: 5 vib_depth: 0.05 level: 0.09})}
    laser: {family: @fx roles: "fx hits" tags: "fx laser zap sci_fi retro game" mono: false volume: 1.97
        about: "a falling laser zap"
        layers: [{osc: @square freq: 3520 to: 220 glide: 0.18 lp: 6000 a: 0.001 d: 0.2 s: 0 r: 0.05 gain: 0.2}]}
    riser: {family: @fx roles: "fx texture" tags: "fx riser noise build transition edm" mono: false volume: 2.92
        about: "a long rising filtered noise sweep (hold it for the build's length)"
        layers: [
        {noise: @white bp: 300 cutoff_to: 9000 glide: 8 q: 2 a: 4 d: 6 s: 1 r: 0.3 gain: 0.3}
        {osc: @saw freq: 220 to: 880 glide: 8 lp: 3000 a: 4 d: 6 s: 1 r: 0.3 gain: 0.05}
        ]}
}
