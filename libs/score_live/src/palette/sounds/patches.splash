        {osc: @saw freq: 440 detune: 14 a: 0.01 d: 0.4 s: 0.8 r: 0.12 gain: 0.28 lp: 900 q: 1.5}
        {osc: @saw freq: 440 detune: -14 a: 0.01 d: 0.4 s: 0.8 r: 0.12 gain: 0.28 lp: 900 q: 1.5}
        {osc: @sine freq: 220 a: 0.01 d: 0.3 s: 0.9 r: 0.1 gain: 0.3}
        ]}
