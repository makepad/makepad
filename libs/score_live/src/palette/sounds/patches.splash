// The synth patch library: each patch a set of recipe layers, written directly or as a point of a
// voice architecture (synths.splash). `Synth{preset: @name}` plays one; family, roles, tags
// and about are what instrument_search reads; mono is the patch's default.

let patches = {
    acid: {family: @bass roles: "bass" tags: "acid squelchy resonant 80s 90s acid_house techno rave" mono: false volume: 2.88
        about: "resonant squelchy mono saw bass through a screaming ladder filter"
        layers: [
        {osc: @saw freq: 440 a: 0.002 d: 0.2 s: 0.35 r: 0.06 gain: 0.45 ladder: 700 q: 7 drive: 1.6}
        ]}
    sub: {family: @bass roles: "bass" tags: "sub deep clean modern edm trap dnb dubstep" mono: false volume: 0.51
        about: "a clean sine sub with a hint of upper harmonic"
        layers: [
        {osc: @sine freq: 440 a: 0.004 d: 0.3 s: 0.85 r: 0.08 gain: 0.7}
        {osc: @tri freq: 880 a: 0.004 d: 0.2 s: 0.3 r: 0.05 gain: 0.06}
        ]}
    reese: {family: @bass roles: "bass" tags: "reese detuned dark dnb jungle neurofunk 90s growl" mono: false volume: 0.83
        about: "two detuned saws beating under a low-pass, a sine an octave down"
