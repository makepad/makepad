// An expressive lead for a keyboard that sends per-note pressure and slide:
// pressure swells the level and opens the filter, slide narrows the pulse,
// the mod wheel adds vibrato, the bend also brightens, and letting a key go
// fast shortens the release.
let cutoff = param(900, 60, 12000, {unit: hz curve: log})
let res = param(0.35, 0, 0.95, {unit: percent curve: linear})
let vib_rate = param(5.5, 0.5, 12, {unit: hz curve: log})
let wave = param(0, {choices: [pulse saw]})

var p = 0.0
var lfo = 0.0
var f = Svf{}
var env = Adsr{}

fn block() {
    let open = cutoff * (1.0 + 3.0 * pressure) * exp2(bend / 24.0)
    svf_set(f, open, 0.7 + res * 4.0)
}

fn voice() {
    lfo = advance(lfo, vib_rate / sample_rate)
    let wobble = mod_wheel * 0.3 * sin(TAU * lfo)
    let dt = freq * exp2(wobble / 12.0) / sample_rate
    p = advance(p, dt)
    let osc = if wave == 0.0 { pulse_blep(p, dt, 0.5 - 0.4 * slide) } else { saw_blep(p, dt) }
    let release = mix(0.6, 0.08, release_velocity)
    let e = adsr(env, 0.01, 0.3, 0.7, release)
    probe(envelope, e)
    let level = e * (0.16 + 0.24 * velocity) * (0.7 + 0.5 * pressure)
    if e == 0.0 && gate == 0.0 {
        stop()
    }
    svf_lp(f, osc) * level
}
