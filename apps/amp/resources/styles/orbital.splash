// ---- knob: a white moulded dome, a red pointer, a fine LED arc ----
mod.widgets.HwKnobFace.depth = 6.0
mod.widgets.HwKnobFace.draw_bg.ground = #xf2f2ef
mod.widgets.HwKnobFace.draw_bg.light_ink = vec4(1.0, 1.0, 1.0, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow_ink = vec4(0.30, 0.32, 0.34, 1.0)
mod.widgets.HwKnobFace.draw_bg.relief = vec4(14.0, 0.9, 6.0, 0.18)
mod.widgets.HwKnobFace.draw_bg.knob = vec4(1.0, 0.62, 0.0, 0.0)
mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.07, 0.075, 0.08, 1.0)
mod.widgets.HwKnobFace.draw_bg.ptr_ink = vec4(0.78, 0.80, 0.83, 1.0)
mod.widgets.HwKnobFace.draw_bg.spill = vec2(0.7, 0.4)
mod.widgets.HwKnobFace.draw_bg.ring = vec4(25.0, 1.26, 1.2, 2.35619)
mod.widgets.HwKnobFace.draw_bg.led_off = vec4(0.72, 0.73, 0.72, 1.0)
mod.widgets.HwKnobFace.draw_bg.glow_ink = vec4(1.0, 0.30, 0.12, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow = vec4(0.40, 14.0, 1.0, 0.35)
mod.widgets.HwKnobFace.emissive = vec4(1.0, 0.28, 0.10, 0.45)
// The cap is the station's eye: a black lens with a red glow at its heart.
mod.widgets.HwKnobFace.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let lum = dot(base, vec3(0.3, 0.59, 0.11))
    if lum > 0.25 {
        return base
    }
    let c = self.rect_size * 0.5
    let r = (min(c.x, c.y) - self.inset) * self.knob.y
    let t = length(p - c) / max(r, 1.0)
    let g = exp(-t * t * 7.0)
    let core = exp(-t * t * 40.0)
    var col = base + vec3(0.85, 0.10, 0.03) * g * 0.95 + vec3(1.0, 0.72, 0.35) * core * 0.9
    // A glassy lens ring and a small catch-light.
    let ring = exp(-abs(t - 0.93) * 30.0) * 0.10
    let hl = exp(-length((p - c) / max(r, 1.0) - vec2(-0.38, -0.42)) * 14.0) * 0.35
    return col + vec3(ring + hl, ring + hl, ring + hl)
}

