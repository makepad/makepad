// ---- keys: flush white caps, a light pipe round the edge ----
mod.widgets.HwKey.radius = 11
mod.widgets.HwKey.depth = 1.2
mod.widgets.HwKey.press = -1.4
mod.widgets.HwKey.draw_bg.ground = #xf4f4f1
mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 1.0, 1.0, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.60, 0.63, 0.66, 1.0)
mod.widgets.HwKey.draw_bg.pattern = vec4(0.0, 1.0, 0.0, 0.0)
mod.widgets.HwKey.draw_bg.relief = vec4(2.4, 0.20, 1.5, 0.15)
mod.widgets.HwKey.draw_bg.finish = vec4(0.40, 0.30, 0.15, 0.5)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.18, 6.0, 1.0, 0.15)
mod.widgets.HwKey.draw_bg.inner = vec4(0.72, 9.0, 0.0, 0.35)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.30, 0.13, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(2.6, 0.45)
mod.widgets.HwKey.draw_bg.pipe_ink = vec4(0.52, 0.76, 1.0, 1.0)
mod.widgets.HwKey.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    var o = self.layer(self.key_face(p, self.ground.xyz))
    // The light pipe: the moulding's gap round the cap glows, a thin
    // bright line with a soft halo on the white either side.
    let d = self.sd(p)
    let lit = clamp(self.lit, 0.0, 1.0)
    let ink = mix(self.pipe_ink.xyz, self.glow_ink.xyz, lit)
    let line = 1.0 - smoothstep(0.3, 1.1, abs(d - 0.6))
    let qe = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y))
    let halo_out = exp(-max(d - 0.6, 0.0) / 2.6) * step(0.6, d) * 0.40 * smoothstep(0.0, max(self.inset, 1.0), qe)
    let halo_in = exp(-max(0.6 - d, 0.0) / 2.0) * step(d, 0.6) * 0.30
    let a = clamp(line * 0.85 + (halo_out + halo_in) * self.pipe_ink.w, 0.0, 1.0)
    let core = mix(ink, vec3(1.0, 1.0, 1.0), line * 0.35)
    o = vec4(core * a, a) + o * (1.0 - a)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
mod.widgets.HwKeyButton.draw_text.color = #x2a2d31
mod.widgets.HwKeyButton.draw_text.color_hover = #xff4a22
