mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 0.99, 0.95, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.25, 0.23, 0.20, 1.0)
mod.widgets.HwPlate.draw_bg.pattern = vec4(4.0, 0.30, 0.08, 0.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(5.0, 1.0, 2.5, 0.25)
mod.widgets.HwPlate.draw_bg.finish = vec4(0.6, 0.3, 0.25, 0.8)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.55, 10.0, 1.0, 0.5)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(0.30, 0.95, 0.50, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(2.4, 0.55)
mod.widgets.HwPlate.radius = 16

// Recessed panels: a darker grey moulding stepped into the front.
mod.widgets.HwPanel.draw_bg.ground = #x5b5852
mod.widgets.HwPanel.draw_bg.light_ink = vec4(0.95, 0.93, 0.88, 1.0)
mod.widgets.HwPanel.draw_bg.shadow_ink = vec4(0.10, 0.10, 0.09, 1.0)
mod.widgets.HwPanel.draw_bg.pattern = vec4(4.0, 0.30, 0.10, 0.0)
mod.widgets.HwPanel.draw_bg.relief = vec4(4.0, 1.0, 2.0, 0.2)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.75, 10.0, 0.0, 0.55)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(0.30, 0.95, 0.50, 1.0)
mod.widgets.HwPanel.draw_bg.spill = vec2(1.6, 0.5)
mod.widgets.HwPanel.radius = 14

// The screen's surround: charcoal plastic, a chrome trim on the lip.
mod.widgets.HwBezel.draw_bg.ground = #x2a2927
mod.widgets.HwBezel.draw_bg.light_ink = vec4(0.92, 0.93, 0.95, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwBezel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // Charcoal stipple, a bright chrome trim band round the lip.
    let w = self.world.xy
    let stip = self.hw_noise(w * 0.9) * 0.6 + self.hw_hash(floor(w * 2.0)) * 0.4
    var col = base * (1.0 + (stip - 0.5) * 0.12)
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let band = smoothstep(0.0, 0.8, e) * (1.0 - smoothstep(4.2, 5.2, e))
    let v = p.y / max(self.rect_size.y, 1.0)
    let chrome = mix(vec3(0.93, 0.94, 0.95), vec3(0.52, 0.53, 0.55), v) + vec3(0.25, 0.25, 0.25) * (1.0 - smoothstep(0.0, 1.8, abs(e - 1.6)))
    col = mix(col, chrome, band)
    return col
}
mod.widgets.HwBezel.draw_bg.relief = vec4(3.0, 1.0, 2.0, 0.9)
mod.widgets.HwBezel.draw_bg.inner = vec4(0.95, 12.0, 0.0, 0.55)
mod.widgets.HwBezel.draw_bg.spill = vec2(1.3, 0.4)

