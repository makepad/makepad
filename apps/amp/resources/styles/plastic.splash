// Plates: stipple and the era's printed stripe decal along the foot.
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let stip = self.hw_noise(w * 0.9) * 0.6 + self.hw_hash(floor(w * 2.0)) * 0.4
    var col = base * (1.0 + (stip - 0.5) * 0.06)
    // A thin chrome pinstripe moulded in just inside the rounded edge.
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let pin = smoothstep(6.2, 6.8, e) * (1.0 - smoothstep(8.0, 8.6, e))
    let v = p.y / max(self.rect_size.y, 1.0)
    col = mix(col, mix(vec3(0.95, 0.96, 0.97), vec3(0.55, 0.56, 0.58), v), pin * 0.9)
    return col
}
