// Moulded Plastic — an 80s tape deck / boombox: a warm grey moulded ABS
// front with a fine spark-eroded texture, cream piano-key transport caps
// with bold dark glyphs, a charcoal moulded screen surround with a thin
// chrome trim, smoky display windows, red and green LEDs.
//
// Assignments only, over the base templates in `src/hw.rs`
// (see local/agent_state/skeuomorph/music/STYLE_GUIDE.md).
use mod.prelude.widgets_internal.*

// ---- palette: the lists, the spectrum, the bars ----
mod.widgets.hw_palette.screen_bg = #x171816
mod.widgets.hw_palette.screen_text = #xe9e6dc
mod.widgets.hw_palette.screen_muted = #x9a968a
mod.widgets.hw_palette.accent = #x46e07a

// ---- the front: warm grey ABS, spark-eroded texture ----
mod.widgets.HwChassis.draw_bg.ground = #xa7a193
mod.widgets.HwChassis.draw_bg.light_ink = vec4(1.0, 0.98, 0.94, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.22, 0.21, 0.19, 1.0)
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // Spark-eroded stipple plus fine moulded grip ribs.
    let w = self.world.xy
    let stip = self.hw_noise(w * 0.9) * 0.6 + self.hw_hash(floor(w * 2.0)) * 0.4
    var col = base * (1.0 + (stip - 0.5) * 0.08)
    let rib = 0.5 + 0.5 * sin(w.y * 2.0944)
    col = col * (1.0 + (rib - 0.5) * 0.09)
    // The era's printed stripe decal along the foot of the front.
    let y = self.rect_size.y - p.y
    let s1 = smoothstep(4.0, 4.6, y) * (1.0 - smoothstep(6.4, 7.0, y))
    let s2 = smoothstep(7.6, 8.2, y) * (1.0 - smoothstep(10.0, 10.6, y))
    let s3 = smoothstep(11.2, 11.8, y) * (1.0 - smoothstep(13.6, 14.2, y))
    col = mix(col, vec3(0.80, 0.18, 0.11), s1)
    col = mix(col, vec3(0.93, 0.50, 0.12), s2)
    col = mix(col, vec3(0.95, 0.76, 0.22), s3)
    return col
}
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(0.30, 0.95, 0.50, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(2.0, 0.6)
mod.widgets.Window.pass.clear_color = #xa7a193

