mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.96, 0.74, 0.11, 1.0)
mod.widgets.HwKnobFace.draw_bg.ptr_ink = vec4(0.07, 0.065, 0.06, 1.0)
mod.widgets.HwKnobFace.draw_bg.ring = vec4(12.0, 1.30, 3.2, 2.35619)
mod.widgets.HwKnobFace.draw_bg.led_off = vec4(0.80, 0.77, 0.70, 1.0)
mod.widgets.HwKnobFace.draw_bg.glow_ink = vec4(0.90, 0.20, 0.12, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow = vec4(0.7, 8.0, 1.0, 0.7)
