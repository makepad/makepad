// ---- meter: a Bauhaus sunburst. Two quarter fans of painted wedges
// rise from a heavy black base rule, left channel to the left, right to
// the right: blue, then yellow, then red toward the top. ----
mod.widgets.HwMeterFace.depth = -1.5
mod.widgets.HwMeterFace.radius = 2
mod.widgets.HwMeterFace.draw_bg.ground = #xf2ecdc
mod.widgets.HwMeterFace.draw_bg.meter = vec4(0.0, 9.0, 1.0, 0.8)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(0.14, 0.31, 0.66, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(0.84, 0.18, 0.12, 1.0)
mod.widgets.HwMeterFace.draw_bg.led_off = vec4(0.87, 0.84, 0.76, 1.0)
mod.widgets.HwMeterFace.draw_bg.shadow_ink = vec4(0.10, 0.09, 0.08, 1.0)
mod.widgets.HwMeterFace.draw_bg.inner = vec4(0.6, 6.0, 0.0, 0.0)
mod.widgets.HwMeterFace.emissive = vec4(1.0, 0.22, 0.10, 0.4)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let s = self.rect_size
    let p = self.pos * s
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let w = self.world.xy
    var o = self.layer(self.ground.xyz * (1.0 + (self.hw_noise(vec2(w.x * 0.01, w.y * 0.12)) - 0.5) * 0.05))
    let blk = vec3(0.07, 0.065, 0.06)
    let piv = vec2(s.x * 0.5, s.y - 9.0)
    let rx = s.x * 0.5 - 12.0
    let ry = s.y - 16.0
    let q = (p - piv) / vec2(rx, ry)
    let r = length(q)
    let ang = atan2(0.0 - q.y, abs(q.x) + 0.00001)
    let t = 1.0 - ang / 1.5708
    let left = 1.0 - step(0.0, q.x)
    let lv = mix(self.level.y, self.level.x, left)
    let n = max(self.meter.y, 2.0)
    let seg = floor(t * n)
    let ft = fract(t * n)
    // Angular gap of about 1.6 pt at the rim, whatever the radius.
    let gap = 1.6 / max(r * min(rx, ry) * 1.5708 / n, 0.5)
    let wedge = smoothstep(gap * 0.5, gap * 0.5 + 0.08, ft) * (1.0 - smoothstep(1.0 - gap * 0.5 - 0.08, 1.0 - gap * 0.5, ft))
    let ring = smoothstep(0.30, 0.30 + px * 2.0 / ry, r) * (1.0 - smoothstep(1.0 - px * 2.0 / ry, 1.0, r))
    let above = 1.0 - step(0.0, q.y)
    let cell = wedge * ring * above * step(0.0, t) * step(t, 1.0)
    let on = step((seg + 0.5) / n, lv)
    let u = (seg + 0.5) / n
    var lit = self.glow_ink.xyz
    if u > 0.55 { lit = vec3(0.96, 0.74, 0.11) }
    if u > 0.82 { lit = self.hot_ink.xyz }
    let col = mix(self.led_off.xyz, lit, on)
    o = vec4(mix(o.xyz, col, cell), o.w)
    // Hairline black outline round each off wedge: painted, not printed.
    // The hub: a black half disc; the heavy base rule under the fan.
    let hub = (1.0 - smoothstep(0.22 - px / ry, 0.22 + px / ry, r)) * above
    o = vec4(mix(o.xyz, blk, hub), o.w)
    let base_y = abs(p.y - piv.y - 1.5) - 1.8
    let base_x = abs(p.x - piv.x) - (rx + 4.0)
    let base_r = (1.0 - smoothstep(-px, px, base_y)) * (1.0 - smoothstep(-px, px, base_x))
    o = vec4(mix(o.xyz, blk, base_r), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- spectrum: stacks of square painted blocks, each capped with a disc,
// cycling red, yellow, blue across the bands; an off-white peak bar ----
// Parts by `self.part` (1 well, 2 rule, 3 slot, 4 bar, 5 peak, 6 midline).
mod.widgets.HwSpectrum.draw_round.pixel = fn() {
    let s = self.rect_size
    let p = self.pos * s
    let c = self.color
    if self.part > 0.5 && self.part < 1.5 {
        // The well: black enamel with a faint square grid.
        let g = abs(fract(p / 24.0) - vec2(0.5, 0.5)) * 24.0
        let grid = 1.0 - smoothstep(11.0, 11.8, max(g.x, g.y))
        let col = vec3(0.075, 0.07, 0.065) + vec3(0.03, 0.03, 0.028) * grid
        let sdf = Sdf2d.viewport(p)
        sdf.box(0.0, 0.0, s.x, s.y, 3.0)
        sdf.fill(vec4(col, 1.0))
        return sdf.result
    }
    if (self.part > 1.5 && self.part < 3.5) || (self.part > 5.5 && self.part < 6.5) {
        if (self.part > 1.5 && self.part < 2.5) || (self.part > 5.5 && self.part < 6.5) {
            // Level rules: dashed off-white.
            let d = step(0.5, fract(p.x / 8.0))
            return vec4(0.9, 0.87, 0.8, 1.0) * 0.10 * d
        }
        // A bar's empty slot: a column of faint square outlines.
        let pitch = s.x + 2.0
        let k = fract((s.y - p.y) / pitch) * pitch
        let box = step(k, s.x)
        return vec4(0.9, 0.87, 0.8, 1.0) * 0.045 * box
    }
    if self.part > 4.5 && self.part < 5.5 {
        // The peak mark: a heavy off-white bar.
        return vec4(0.95, 0.92, 0.85, 1.0)
    }
    // A lit bar: square blocks from the foot, the top one a disc.
    let pitch = s.x + 2.0
    let band = floor((self.rect_pos.x + 1.0) / pitch)
    let tri = band - 3.0 * floor(band / 3.0)
    var ink = vec3(0.88, 0.20, 0.13)
    if tri > 0.5 { ink = vec3(0.98, 0.76, 0.12) }
    if tri > 1.5 { ink = vec3(0.22, 0.42, 0.85) }
    let y = s.y - p.y
    let nblk = max(floor((s.y + 2.0) / pitch), 1.0)
    let idx = floor(y / pitch)
    let k = y - idx * pitch
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var a = 0.0
    if idx < nblk - 1.0 {
        a = step(k, s.x) * step(0.0, k)
    } else {
        if idx < nblk {
            let d = length(vec2(p.x - s.x * 0.5, k - s.x * 0.5)) - s.x * 0.5
            a = 1.0 - smoothstep(-px, px, d)
        }
    }
    // A painted face: a touch lighter at the top-left of every block.
    let shade = 1.0 + 0.10 * (0.5 - p.x / s.x)
    return vec4(ink * shade * a, a)
}
// The waveform: a heavy tricolour rope, a third of a band each colour.
mod.widgets.HwSpectrum.draw_line.pixel = fn() {
    let p = self.pos * self.rect_size
    let a = self.seg_a
    let b = self.seg_b
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let d = length(pa - ba * h)
    let aa = 1.0 - smoothstep(1.2, 2.2, d)
    let x = self.rect_pos.x + p.x
    let band = floor(x / 36.0)
    let tri = band - 3.0 * floor(band / 3.0)
    var ink = vec3(0.88, 0.20, 0.13)
    if tri > 0.5 { ink = vec3(0.98, 0.76, 0.12) }
    if tri > 1.5 { ink = vec3(0.22, 0.42, 0.85) }
    return vec4(ink * aa, aa)
}

// ---- no album art: a Bauhaus poster, not a record ----
mod.widgets.HwArtBlank.draw_bg.pixel = fn() {
    let s = self.rect_size
    let p = self.pos * s
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let u = p / max(s.x, s.y)
    let w = self.world.xy
    var col = vec3(0.94, 0.91, 0.84) * (1.0 + (self.hw_noise(vec2(w.x * 0.01, w.y * 0.12)) - 0.5) * 0.06)
    let e = px / max(s.x, 1.0)
    // Blue square, lower right.
    let sq = step(0.46, u.x) * step(u.x, 0.90) * step(0.46, u.y) * step(u.y, 0.90)
    col = mix(col, vec3(0.14, 0.31, 0.66), sq)
    // Red circle, upper left, over the square's corner.
    let rc = 1.0 - smoothstep(0.26 - e, 0.26 + e, length(u - vec2(0.40, 0.40)))
    col = mix(col, vec3(0.84, 0.18, 0.12), rc)
    // Yellow triangle, lower left.
    let tri = step(0.10, u.x) * step(u.y, 0.92) * step(0.62 + (u.x - 0.10), u.y) * step(u.x, 0.40)
    col = mix(col, vec3(0.96, 0.74, 0.11), tri)
    // A heavy black rule across the top and a thin one down the right.
    let bar = step(0.08, u.y) * step(u.y, 0.13) * step(0.10, u.x) * step(u.x, 0.92)
    col = mix(col, vec3(0.07, 0.065, 0.06), bar)
    let bar2 = step(0.86, u.x) * step(u.x, 0.88) * step(0.08, u.y) * step(u.y, 0.92)
    col = mix(col, vec3(0.07, 0.065, 0.06), bar2)
    return vec4(col + self.dither(), 1.0)
}

