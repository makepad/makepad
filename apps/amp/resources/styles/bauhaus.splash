// title: Bauhaus
// Bauhaus — Dessau, 1926: an off-white enamel front like heavy paper,
// laid on a strict grid of heavy black rules; key caps and plates painted
// with the primary triad (red circle, yellow bar, blue square); a bold
// geometric sans; a black enamel screen well. Tactile painted enamel:
// brush-stroke texture, a soft gloss, chipped hard edges.
//
// Assignments only, over the base templates in `src/hw.rs`
// (see local/agent_state/skeuomorph/music/STYLE_GUIDE.md).
use mod.prelude.widgets_internal.*

// ---- palette ----
mod.widgets.hw_palette.screen_bg = #x151412
mod.widgets.hw_palette.screen_text = #xf1ebdb
mod.widgets.hw_palette.screen_muted = #x8f8878
mod.widgets.hw_palette.accent = #xe23b26
mod.widgets.hw_palette.panel_text = #x14130f
mod.widgets.hw_palette.panel_muted = #x4a463d
mod.widgets.hw_palette.menu_bg = #xefe9da
mod.widgets.hw_palette.spill_knee = 1.2
mod.widgets.hw_palette.caption_bg = #x100f0d
mod.widgets.hw_palette.caption_text = #xf1ebdb

// ---- the front: off-white enamel on a strict grid ----
mod.widgets.HwChassis.draw_bg.ground = #xe8e1cf
mod.widgets.HwChassis.draw_bg.light_ink = vec4(1.0, 0.99, 0.95, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.10, 0.09, 0.08, 1.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.30, 0.18, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(3.0, 0.7)
mod.widgets.HwChassis.draw_bg.vignette = vec4(0.5, 0.35, 0.10, 1.03)
mod.widgets.Window.pass.clear_color = #xe8e1cf
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Brushed-on enamel: long soft strokes plus a fine tooth.
    let stroke = self.hw_noise(vec2(w.x * 0.004, w.y * 0.09)) - 0.5
    let tooth = self.hw_hash(floor(w * 1.7)) - 0.5
    var col = base * (1.0 + stroke * 0.05 + tooth * 0.025)
    // A faint pencilled construction grid every 24 pt.
    let g = abs(fract(w / 24.0 + vec2(0.5, 0.5)) - vec2(0.5, 0.5)) * 24.0
    let grid = 1.0 - smoothstep(0.0, 0.6, min(g.x, g.y))
    col = mix(col, col * 0.93, grid * 0.5)
    // The heavy black rules and the triad blocks along the foot.
    let y = self.rect_size.y - p.y
    let x = p.x / max(self.rect_size.x, 1.0)
    let foot = 1.0 - smoothstep(9.5, 10.5, y)
    var ink = vec3(0.07, 0.065, 0.06)
    if x < 0.12 { ink = vec3(0.83, 0.17, 0.12) }
    if x > 0.12 && x < 0.18 { ink = vec3(0.95, 0.72, 0.10) }
    if x > 0.88 { ink = vec3(0.13, 0.30, 0.64) }
    col = mix(col, ink, foot)
    let rule = smoothstep(12.5, 13.5, y) * (1.0 - smoothstep(15.5, 16.5, y))
    col = mix(col, vec3(0.07, 0.065, 0.06), rule)
    // The heavy rule under the caption.
    let top = smoothstep(29.5, 30.5, p.y) * (1.0 - smoothstep(33.5, 34.5, p.y))
    col = mix(col, vec3(0.07, 0.065, 0.06), top)
    return col
}

// ---- plates: off-white enamel slabs, a heavy black frame, a primary bar ----
mod.widgets.HwPlate.draw_bg.ground = #xf2ecdc
mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 1.0, 0.97, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.12, 0.11, 0.09, 1.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(2.0, 0.6, 2.5, 0.45)
mod.widgets.HwPlate.draw_bg.finish = vec4(0.6, 0.4, 0.45, 0.5)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.60, 8.0, 1.0, 0.6)
mod.widgets.HwPlate.draw_bg.sheen = vec4(0.05, 0.35, 0.30, 0.3)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.30, 0.18, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(3.2, 0.6)
mod.widgets.HwPlate.radius = 2
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let stroke = self.hw_noise(vec2(w.x * 0.004, w.y * 0.09)) - 0.5
    var col = base * (1.0 + stroke * 0.045 + (self.hw_hash(floor(w * 1.7)) - 0.5) * 0.02)
    let s = self.rect_size
    let e = min(min(p.x, p.y), min(s.x - p.x, s.y - p.y)) - self.inset
    // A heavy black frame just inside the edge.
    let frame = smoothstep(2.5, 3.2, e) * (1.0 - smoothstep(6.0, 6.7, e))
    col = mix(col, vec3(0.07, 0.065, 0.06), frame)
    // A composition in the plate's free foot on the right wing:
    // a red circle, a yellow square and a blue quarter disc on a black bar.
    // The display wing (plate 2) wherever the layout puts it.
    if self.plate_id > 1.5 && self.plate_id < 2.5 && s.y > 200.0 {
        let fy = s.y - self.inset - 12.0
        let cx0 = self.inset + 14.0
        let q = p - vec2(cx0, fy)
        // Black base rule.
        let base_r = step(0.0, q.y) * (1.0 - step(5.0, q.y)) * step(0.0, q.x) * step(q.x, s.x - self.inset * 2.0 - 28.0)
        let red_d = length(q - vec2(34.0, -30.0)) - 28.0
        let red = 1.0 - smoothstep(-0.6, 0.6, red_d)
        let sq = step(58.0, q.x) * step(q.x, 104.0) * step(-46.0, q.y) * step(q.y, 0.0)
        let qd = length(q - vec2(104.0, 0.0))
        let quarter = (1.0 - smoothstep(49.4, 50.6, qd)) * step(104.0, q.x) * step(q.y, 0.0)
        col = mix(col, vec3(0.96, 0.74, 0.11), sq)
        col = mix(col, vec3(0.84, 0.18, 0.12), red)
        col = mix(col, vec3(0.14, 0.31, 0.66), quarter)
        col = mix(col, vec3(0.07, 0.065, 0.06), base_r)
    }
    return col
}

// ---- recessed panels: Bauhaus blue enamel ----
mod.widgets.HwPanel.draw_bg.ground = #x22469a
mod.widgets.HwPanel.draw_bg.light_ink = vec4(0.85, 0.90, 1.0, 1.0)
mod.widgets.HwPanel.draw_bg.shadow_ink = vec4(0.02, 0.03, 0.08, 1.0)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.80, 8.0, 0.0, 0.5)
mod.widgets.HwPanel.draw_bg.sheen = vec4(0.04, 0.30, 0.20, 0.3)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(1.0, 0.30, 0.18, 1.0)
mod.widgets.HwPanel.draw_bg.spill = vec2(1.6, 0.5)
mod.widgets.HwPanel.radius = 2
mod.widgets.HwPanel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let stroke = self.hw_noise(vec2(w.x * 0.004, w.y * 0.09)) - 0.5
    return base * (1.0 + stroke * 0.07 + (self.hw_hash(floor(w * 1.7)) - 0.5) * 0.03)
}

// ---- the screen: black enamel well, a yellow inner rule ----
mod.widgets.HwBezel.draw_bg.ground = #x121110
mod.widgets.HwBezel.draw_bg.light_ink = vec4(0.95, 0.93, 0.88, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwBezel.draw_bg.relief = vec4(2.0, 0.6, 2.0, 0.8)
mod.widgets.HwBezel.draw_bg.inner = vec4(0.90, 12.0, 0.0, 0.5)
mod.widgets.HwBezel.draw_bg.spill = vec2(1.4, 0.4)
mod.widgets.HwBezel.radius = 3
mod.widgets.HwBezel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    var col = base * (1.0 + (self.hw_noise(vec2(w.x * 0.004, w.y * 0.09)) - 0.5) * 0.25)
    let s = self.rect_size
    let e = min(min(p.x, p.y), min(s.x - p.x, s.y - p.y)) - self.inset
    let band = smoothstep(4.0, 4.6, e) * (1.0 - smoothstep(7.0, 7.6, e))
    col = mix(col, vec3(0.95, 0.72, 0.10), band)
    return col
}
// No dark rim or bulge over the picture: it reads clean and bright.
mod.widgets.HwGlass.draw_bg.glass = vec4(0.0, 0.07, 0.0, 0.0)
mod.widgets.HwGlass.draw_bg.tint = vec4(1.0, 0.98, 0.92, 0.0)
mod.widgets.HwGlass.draw_bg.radius = 2.0

// ---- keys: painted enamel caps, each with its primary geometry ----
mod.widgets.HwKey.draw_bg.ground = #xf3eddd
mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 1.0, 0.97, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.10, 0.09, 0.08, 1.0)
mod.widgets.HwKey.draw_bg.relief = vec4(2.2, 0.5, 3.0, 0.5)
mod.widgets.HwKey.draw_bg.finish = vec4(0.6, 0.4, 0.5, 0.45)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.70, 5.0, 1.0, 0.7)
mod.widgets.HwKey.draw_bg.sheen = vec4(0.06, 0.30, 0.28, 0.4)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.30, 0.18, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(3.0, 0.5)
mod.widgets.HwKey.draw_bg.led = vec4(8.0, 8.0, 2.0, 0.0)
mod.widgets.HwKey.radius = 2
mod.widgets.HwKey.depth = 3.5
mod.widgets.HwKey.press = -3.5
mod.widgets.HwKey.draw_bg.key_face = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let stroke = self.hw_noise(vec2(w.x * 0.01, w.y * 0.12)) - 0.5
    var col = base * (1.0 + stroke * 0.04)
    let s = self.rect_size
    let i = self.inset
    let f = s - vec2(i * 2.0, i * 2.0)
    let q = p - vec2(i, i)
    let org = w - p
    let kk = floor(org.x / 31.0) + floor(org.y / 31.0) * 2.0
    let h = (kk - 3.0 * floor(kk / 3.0)) / 3.0 + 0.1
    let red = vec3(0.84, 0.18, 0.12)
    let yel = vec3(0.96, 0.74, 0.11)
    let blu = vec3(0.14, 0.31, 0.66)
    let blk = vec3(0.07, 0.065, 0.06)
    if self.critical > 0.5 {
        if s.y < 46.0 {
            // PRESETS: a black enamel cap with a red top rule; its word is
            // printed in the accent when lit and grey when not.
            col = blk * (1.0 + stroke * 0.3) + vec3(0.02, 0.02, 0.02)
            let top = 1.0 - smoothstep(4.0, 4.7, q.y)
            col = mix(col, red, top)
            return col
        }
        // Play: a full red cap with a black foot rule.
        col = red * (1.0 + stroke * 0.06)
        let foot = smoothstep(f.y - 5.5, f.y - 4.8, q.y)
        col = mix(col, blk, foot)
        return col
    }
    if f.x > f.y * 1.8 {
        // A wide word key: a yellow cap, a black foot rule, a red square
        // stamped at the left end.
        col = yel * (1.0 + stroke * 0.06)
        let foot = smoothstep(f.y - 4.0, f.y - 3.3, q.y)
        col = mix(col, blk, foot)
        let sq = (1.0 - smoothstep(6.0, 6.6, q.x)) * (1.0 - smoothstep(f.y - 4.0, f.y - 3.3, q.y))
        col = mix(col, red, sq)
        return col
    }
    if h < 0.34 {
        // A red ring round the legend.
        let r = min(f.x, f.y) * 0.44
        let d = abs(length(q - f * 0.5) - r) - 2.2
        col = mix(col, red, 1.0 - smoothstep(-0.6, 0.6, d))
    } else {
        if h < 0.67 {
            // A yellow quarter disc in the top-left corner, a black foot rule.
            let qd = length(q) - f.y * 0.66
            col = mix(col, yel, 1.0 - smoothstep(-0.6, 0.6, qd))
            let foot = smoothstep(f.y - 4.0, f.y - 3.3, q.y)
            col = mix(col, blk, foot)
        } else {
            // A blue bar down the left edge, a thin black rule beside it.
            let bar = 1.0 - smoothstep(8.0, 8.8, q.x)
            col = mix(col, blu, bar)
            let rule = smoothstep(10.0, 10.6, q.x) * (1.0 - smoothstep(12.0, 12.6, q.x))
            col = mix(col, blk, rule)
        }
    }
    return col
}
