// Nostromo — the ship console from Alien (1979): putty and khaki panels
// bolted on with visible screws and seams, chunky off-white keys with
// stencilled black legends, and an amber monochrome CRT in a deep grey
// bezel: scanlines, phosphor bloom, a darkened curved rim. Used, industrial.
use mod.prelude.widgets_internal.*

// ---- palette: amber phosphor on near-black glass ----
mod.widgets.hw_palette.screen_bg = #x120d06
mod.widgets.hw_palette.screen_text = #xffb347
mod.widgets.hw_palette.screen_muted = #xd99d48
mod.widgets.hw_palette.accent = #xffa21f

// ---- the front: khaki putty, riveted plates, worn ----
mod.widgets.HwChassis.draw_bg.ground = #xa9a288
mod.widgets.HwChassis.draw_bg.light_ink = vec4(1.0, 0.97, 0.88, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.20, 0.19, 0.15, 1.0)
mod.widgets.HwChassis.draw_bg.pattern = vec4(6.0, 1.0, 0.8, 0.0)
mod.widgets.HwChassis.draw_bg.pattern_ink = vec4(0.30, 0.28, 0.22, 0.75)
mod.widgets.HwChassis.draw_bg.pattern_seam = vec4(282.0, 212.0, 1.2, 3.2)
mod.widgets.HwChassis.draw_bg.sheen = vec4(0.0, 0.3, 0.35, 0.25)
mod.widgets.HwChassis.draw_bg.grain = 0.03
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.62, 0.18, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(1.8, 0.6)
mod.widgets.Window.pass.clear_color = #xa9a288
// The hull front: seamed sheets on a grid, a screw at each sheet corner,
// blotchy grime and the odd scuff where boots and trays have hit it.
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let cell = vec2(282.0, 212.0)
    let f = fract(w / cell)
    let e = min(min(f.x, 1.0 - f.x) * cell.x, min(f.y, 1.0 - f.y) * cell.y)
    let seam = 1.0 - smoothstep(0.0, 1.8, e)
    let lip = (1.0 - smoothstep(1.8, 3.2, e)) * smoothstep(1.2, 1.8, e)
    let grime = self.hw_noise(w * 0.012) * 0.6 + self.hw_noise(w * 0.05) * 0.4
    var col = base * (0.93 + grime * 0.10)
    col = col * (1.0 + (self.hw_hash(floor(w * 1.5)) - 0.5) * 0.05)
    let stain = smoothstep(0.62, 0.9, self.hw_noise(w * 0.02 + vec2(31.0, 17.0)))
    col = mix(col, col * vec3(0.84, 0.79, 0.68), stain * 0.30)
    col = mix(col, vec3(0.20, 0.19, 0.15), seam * 0.85)
    col = col + vec3(0.10, 0.10, 0.08) * lip
    let corner = min(f, vec2(1.0, 1.0) - f) * cell
    let v = corner - vec2(10.0, 10.0)
    let r = length(v)
    let sink = (1.0 - smoothstep(4.8, 6.0, r)) * smoothstep(3.8, 4.8, r)
    col = col * (1.0 - sink * 0.45)
    let head = 1.0 - smoothstep(3.9, 4.5, r)
    col = mix(col, vec3(0.58, 0.56, 0.51), head)
    let a = self.hw_hash(floor(w / cell + vec2(0.5, 0.5))) * 3.14159
    let dist = abs(dot(v, vec2(0.0 - sin(a), cos(a))))
    let slot = (1.0 - smoothstep(0.45, 1.0, dist)) * (1.0 - smoothstep(2.9, 3.5, r))
    col = mix(col, vec3(0.10, 0.09, 0.07), slot * 0.9)
    return col
}

// Raised plates: off-white putty, bolted at the corners, seamed.
mod.widgets.HwPlate.draw_bg.ground = #xcfc8b0
mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 0.98, 0.92, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.18, 0.17, 0.13, 1.0)
mod.widgets.HwPlate.draw_bg.pattern_ink = vec4(0.36, 0.34, 0.27, 0.8)
mod.widgets.HwPlate.draw_bg.pattern_seam = vec4(120.0, 96.0, 1.0, 2.8)
mod.widgets.HwPlate.draw_bg.sheen = vec4(0.0, 0.3, 0.35, 0.25)
mod.widgets.HwPlate.draw_bg.relief = vec4(1.2, 0.3, 2.5, 0.15)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.55, 7.0, 1.0, 0.55)
mod.widgets.HwPlate.draw_bg.grain = 0.035
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.62, 0.18, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(2.2, 0.55)
// Each plate carries its own four slotted screws, countersunk at the corners,
// and the grime of forty years of hands.
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    var col = base * (1.0 + (self.hw_noise(w * 0.05) - 0.5) * 0.12 + (self.hw_hash(floor(w * 1.5)) - 0.5) * 0.05)
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    col = col * (1.0 - uv.y * 0.07)
    let m = self.inset + 9.0
    let qx = mix(m, self.rect_size.x - m, step(self.rect_size.x * 0.5, p.x))
    let qy = mix(m, self.rect_size.y - m, step(self.rect_size.y * 0.5, p.y))
    let v = p - vec2(qx, qy)
    let r = length(v)
    let sink = (1.0 - smoothstep(4.6, 6.0, r)) * smoothstep(3.6, 4.6, r)
    col = col * (1.0 - sink * 0.45)
    let head = 1.0 - smoothstep(3.7, 4.4, r)
    let shade = 1.05 - dot(v, vec2(0.7, 0.7)) * 0.06
    let metal = vec3(0.62, 0.60, 0.55) * shade
    col = mix(col, metal, head)
    let a = self.hw_hash(floor(w - v) + vec2(3.0, 7.0)) * 3.14159
    let dir = vec2(cos(a), sin(a))
    let dist = abs(dot(v, vec2(0.0 - dir.y, dir.x)))
    let slot = (1.0 - smoothstep(0.45, 1.0, dist)) * (1.0 - smoothstep(2.8, 3.4, r))
    col = mix(col, vec3(0.10, 0.09, 0.07), slot * 0.9)
    return col
}

