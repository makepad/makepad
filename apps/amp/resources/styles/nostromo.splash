// The CRT surround: dark gunmetal grey, deep.
mod.widgets.HwBezel.draw_bg.ground = #x2b2a26
mod.widgets.HwBezel.draw_bg.light_ink = vec4(0.70, 0.68, 0.60, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwBezel.draw_bg.pattern = vec4(7.0, 1.0, 0.0, 0.0)
mod.widgets.HwBezel.draw_bg.pattern_seam = vec4(22.0, 9.0, 0.0, 0.0)
mod.widgets.HwBezel.draw_bg.pattern_ink = vec4(0.80, 0.63, 0.14, 0.9)
mod.widgets.HwBezel.draw_bg.inner = vec4(0.95, 14.0, 0.0, 0.55)
mod.widgets.HwBezel.draw_bg.glow_ink = vec4(1.0, 0.62, 0.18, 1.0)
mod.widgets.HwBezel.draw_bg.spill = vec2(0.7, 0.4)

// The tube: amber phosphor wash, heavy scanlines, bloom, curved dark corners.
mod.widgets.HwGlass.draw_bg.glass = vec4(0.14, 0.06, 0.55, 0.35)
mod.widgets.HwGlass.draw_bg.tint = vec4(1.0, 0.52, 0.08, 0.50)
mod.widgets.HwGlass.draw_bg.radius = 18.0
mod.widgets.HwGlass.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, self.radius)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let cov = 1.0 - smoothstep(-px, px, d)
    // Scanlines: every other device row goes dark.
    // A CRT's rows: fine, even, with the screen filter only.
    let line = 0.5 + 0.5 * sin(p.y * 3.14159 * self.draw_pass.dpi_factor)
    // Vignette and curved-tube corners.
    let q = (self.pos - vec2(0.5, 0.5)) * 2.0
    let vig = clamp(dot(q, q) * 0.22 + dot(q * q, q * q) * self.glass.w, 0.0, 1.0)
    let edge = smoothstep(-40.0, 0.0, d) * self.glass.z
    let dark = clamp(line * self.glass.x * self.filter_on + vig + edge, 0.0, 0.95)
    // Amber phosphor: a constant wash that tints the picture (with the filter).
    let amb = self.tint.w * self.filter_on
    // Reflection: a soft sheet on the upper left.
    let r = smoothstep(0.55, 0.0, self.pos.y + (self.pos.x - 0.5) * 0.3) * self.glass.y
    let a = clamp(amb + dark * (1.0 - amb) + r, 0.0, 1.0)
    // Phosphor bloom: a faint amber haze hanging over the middle of the tube.
    let bloom = (1.0 - clamp(dot(q, q), 0.0, 1.0)) * 0.07 * self.filter_on
    let rgb = self.tint.xyz * (amb * (1.0 - dark) + bloom) + vec3(1.0, 0.9, 0.7) * r
    // Outside the rounded tube: the bezel's black mask.
    let inside = vec4(rgb, a) * cov
    return inside + vec4(0.035, 0.032, 0.028, 1.0) * (1.0 - cov)
}

