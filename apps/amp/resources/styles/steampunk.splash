// title: Steampunk
// Steampunk — a Victorian aether engine: riveted sheets of aged copper gone
// green with verdigris, antique brass escutcheons with rivet rows and
// engraved rules, oxblood leather wells with brass stitching, a porthole
// flange round a glass of glowing aether, valve-wheel volume, twin pressure
// gauges for the levels, glass gas tubes for the spectrum, and gaslight amber
// everywhere a lamp burns.
use mod.prelude.widgets_internal.*

// ---- palette: aether-dark glass, parchment type, gaslight amber ----
mod.widgets.hw_palette.screen_bg = #x0b1916
mod.widgets.hw_palette.screen_text = #xf2e2bc
mod.widgets.hw_palette.screen_muted = #x8fa593
mod.widgets.hw_palette.accent = #xffac3c
mod.widgets.hw_palette.panel_text = #xeccf8e
mod.widgets.hw_palette.panel_muted = #xb99462
mod.widgets.hw_palette.menu_bg = #x2a100c
mod.widgets.hw_palette.spill_knee = 1.2

// ---- the front: riveted sheets of aged copper, verdigris in the laps ----
mod.widgets.HwChassis.draw_bg.ground = #x7c4227
mod.widgets.HwChassis.draw_bg.light_ink = vec4(1.0, 0.86, 0.66, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.14, 0.06, 0.03, 1.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.62, 0.22, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(2.6, 0.7)
mod.widgets.HwChassis.draw_bg.vignette = vec4(0.5, 0.28, 0.42, 1.12)
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Hammered copper: broad mottling, soft dimples, fine speckle.
    let n = self.hw_noise(w * 0.018) * 0.55 + self.hw_noise(w * 0.07) * 0.3 + self.hw_noise(w * 0.3) * 0.15
    var col = base * (0.80 + 0.40 * n)
    col = col * (0.93 + 0.14 * self.hw_noise(w * 0.12))
    col = col * (1.0 + (self.hw_hash(floor(w * 1.4)) - 0.5) * 0.06)
    // Tarnish: dark brown clouds.
    let tar = smoothstep(0.5, 0.85, self.hw_noise(w * 0.009 + vec2(11.0, 5.0)))
    col = mix(col, vec3(0.22, 0.10, 0.05), tar * 0.5)
    // The sheets: lapped seams on a grid.
    let cell = vec2(340.0, 270.0)
    let f = fract(w / cell)
    let sx = (f.x - step(0.5, f.x)) * cell.x
    let sy = (f.y - step(0.5, f.y)) * cell.y
    let ex = abs(sx)
    let ey = abs(sy)
    let es = min(ex, ey)
    // Verdigris: blooms from the seams and in patches.
    let vn = self.hw_noise(w * 0.03 + vec2(3.0, 9.0)) * 0.6 + self.hw_noise(w * 0.13) * 0.3 + self.hw_noise(w * 0.6) * 0.1
    let pat = smoothstep(0.62, 0.9, vn + exp(-es / 14.0) * 0.36)
    let verd = mix(vec3(0.20, 0.42, 0.35), vec3(0.46, 0.72, 0.60), self.hw_noise(w * 0.45))
    col = mix(col, vec3(dot(col, vec3(0.3, 0.55, 0.15))), 0.18)
    col = mix(col, verd, pat * 0.72)
    // The lap: a dark gap and a lit edge on the overlapping sheet.
    let gap = 1.0 - smoothstep(0.3, 1.2, es)
    let edge = (1.0 - smoothstep(0.0, 1.2, abs(es - 1.8))) * 0.25
    col = col * (1.0 - gap * 0.75) + vec3(1.0, 0.75, 0.5) * edge * (1.0 - pat * 0.6)
    // A double row of rivets along every seam.
    let nearh = step(ey, ex)
    let qh = vec2((fract(w.x / 15.0) - 0.5) * 15.0, sy - sign(sy) * 6.5)
    let qv = vec2(sx - sign(sx) * 6.5, (fract(w.y / 15.0) - 0.5) * 15.0)
    let rq = mix(qv, qh, nearh)
    let rd = length(rq)
    let rr = 2.4
    let rm = 1.0 - smoothstep(rr - 0.5, rr + 0.4, rd)
    let hl = max(0.0, 1.0 - length(rq + vec2(0.8, 0.8)) / rr)
    let rsh = (1.0 - smoothstep(rr - 0.2, rr + 2.2, length(rq - vec2(0.9, 1.0)))) * (1.0 - rm)
    col = col * (1.0 - rsh * 0.55)
    let rivet = vec3(0.72, 0.40, 0.22) * (0.55 + 0.45 * (1.0 - rd / rr)) + vec3(1.0, 0.85, 0.65) * hl * hl * 0.8
    col = mix(col, rivet, rm)
    return col
}
mod.widgets.Window.pass.clear_color = #x2a1309

// Raised plates: antique brass escutcheons, engraved rules, a rivet row.
mod.widgets.HwPlate.draw_bg.ground = #xa9843f
mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 0.92, 0.70, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.14, 0.08, 0.02, 1.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(2.2, 0.9, 2.4, 0.55)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.7, 10.0, 1.0, 0.6)
mod.widgets.HwPlate.draw_bg.sheen = vec4(0.10, 0.25, 0.28, 0.5)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.62, 0.22, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(2.8, 0.6)
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Brass: faint polishing streaks, mottled wear.
    let row = floor(w.y * 1.3)
    let streak = self.hw_noise(vec2(w.x * 0.02 + row * 3.7, row * 0.31))
    let n = self.hw_noise(w * 0.02) * 0.6 + self.hw_noise(w * 0.09) * 0.4
    var col = base * (0.84 + 0.30 * n) * (1.0 + (streak - 0.5) * 0.10)
    let s = self.rect_size
    let cq = min(p, s - p) - vec2(self.inset, self.inset)
    let e = min(cq.x, cq.y)
    // Tarnish toward the edges, verdigris creeping from the corners.
    let tn = self.hw_noise(w * 0.035 + vec2(5.0, 2.0))
    col = mix(col, vec3(0.30, 0.19, 0.07), clamp(smoothstep(0.55, 0.9, tn) * 0.35 + exp(-e / 12.0) * 0.30, 0.0, 1.0))
    let vg = smoothstep(0.66, 0.9, self.hw_noise(w * 0.06) * 0.7 + exp(-length(cq) / 26.0) * 0.55)
    col = mix(col, vec3(0.30, 0.56, 0.46) * (0.8 + 0.4 * self.hw_noise(w * 0.5)), vg * 0.75)
    // Engraved double rule inside the rivets.
    let rule = (1.0 - smoothstep(0.25, 0.85, abs(e - 10.5))) + (1.0 - smoothstep(0.2, 0.6, abs(e - 12.5))) * 0.6
    col = col * (1.0 - rule * 0.5)
    // Engraved corner scrolls: a quarter ring in each corner.
    let sc = length(cq - vec2(10.5, 10.5))
    let scroll = (1.0 - smoothstep(0.3, 0.9, abs(sc - 7.0))) * step(10.5, cq.x) * step(10.5, cq.y)
    col = col * (1.0 - scroll * 0.45)
    // An engraved pair of gears in the empty foot of the right-hand wing.
    let gm = step(540.0, s.y) * step(1.5, self.plate_id) * step(self.plate_id, 2.5)
    if gm > 0.5 {
        let g1 = p - vec2(s.x * 0.34, s.y - 66.0)
        let g2 = p - vec2(s.x * 0.34 + 60.0, s.y - 46.0)
        let a1 = atan2(g1.y, g1.x)
        let a2 = atan2(g2.y, g2.x) + 0.2
        let t1 = smoothstep(0.35, 0.5, abs(fract(a1 * 12.0 / 6.28318) - 0.5) * 2.0)
        let t2 = smoothstep(0.35, 0.5, abs(fract(a2 * 8.0 / 6.28318) - 0.5) * 2.0)
        let d1 = length(g1) - (34.0 + 5.0 * t1)
        let d2 = length(g2) - (21.0 + 4.5 * t2)
        let h1 = abs(length(g1) - 20.0) - 6.5
        let h2 = abs(length(g2) - 12.0) - 3.5
        let sp1 = abs(fract(a1 * 6.0 / 6.28318) - 0.5) * 2.0 * length(g1) * 0.5 - 2.5
        let sp2 = abs(fract(a2 * 4.0 / 6.28318) - 0.5) * 2.0 * length(g2) * 0.5 - 2.0
        let win1 = max(h1, -sp1)
        let win2 = max(h2, -sp2)
        let gd = min(max(d1, -win1), max(d2, -win2))
        let groove = 1.0 - smoothstep(0.3, 1.0, abs(gd))
        let raised = 1.0 - smoothstep(-0.5, 0.5, gd)
        col = col * (1.0 + raised * 0.08) * (1.0 - groove * 0.5)
        let axle = min(length(g1), length(g2))
        col = mix(col, col * 0.5, 1.0 - smoothstep(3.0, 3.8, axle))
    }
    // Rivets round the edge.
    let alongx = step(cq.y, cq.x)
    let along = mix(p.y, p.x, alongx)
    let rq = vec2((fract(along / 16.0) - 0.5) * 16.0, e - 5.0)
    let rd = length(rq)
    let rr = 2.3
    let rm = 1.0 - smoothstep(rr - 0.5, rr + 0.4, rd)
    let rsh = (1.0 - smoothstep(rr, rr + 2.0, rd)) * (1.0 - rm)
    col = col * (1.0 - rsh * 0.45)
    let rivet = base * (0.55 + 0.55 * (1.0 - rd / rr)) + vec3(1.0, 0.92, 0.7) * pow(max(0.0, 1.0 - rd / (rr * 0.6)), 2.0) * 0.5
    col = mix(col, rivet, rm)
    return col
}

// Recessed wells: oxblood leather, brass-stitched round the edge.
mod.widgets.HwPanel.draw_bg.ground = #x340806
mod.widgets.HwPanel.draw_bg.light_ink = vec4(0.95, 0.55, 0.42, 1.0)
mod.widgets.HwPanel.draw_bg.shadow_ink = vec4(0.05, 0.01, 0.01, 1.0)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.9, 10.0, 0.0, 0.0)
mod.widgets.HwPanel.draw_bg.finish = vec4(0.7, 0.3, 0.04, 0.95)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(1.0, 0.62, 0.22, 1.0)
mod.widgets.HwPanel.draw_bg.spill = vec2(1.1, 0.5)
mod.widgets.HwPanel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Pebbled grain and soft creases.
    let g1 = self.hw_noise(w * 0.9)
    let g2 = self.hw_noise(w * 0.3)
    var col = base * (0.70 + 0.22 * g1 + 0.14 * g2)
    col = mix(vec3(dot(col, vec3(0.3, 0.55, 0.15))), col, 1.25)
    let cr = abs(self.hw_noise(w * vec2(0.018, 0.05)) - 0.5)
    col = col * (0.82 + 0.18 * smoothstep(0.0, 0.06, cr))
    col = col + vec3(0.16, 0.03, 0.02) * smoothstep(0.55, 0.9, self.hw_noise(w * 0.012)) * 0.4
    // Brass saddle stitching round the edge.
    let s = self.rect_size
    let cq = min(p, s - p)
    let e = min(cq.x, cq.y)
    let along = mix(p.y, p.x, step(cq.y, cq.x))
    let ph = fract(along / 6.0)
    let dash = smoothstep(0.1, 0.2, ph) * (1.0 - smoothstep(0.7, 0.8, ph))
    let line = 1.0 - smoothstep(0.45, 1.0, abs(e - 6.0))
    let hole = (1.0 - smoothstep(0.0, 0.8, length(vec2((ph - 0.9) * 6.0, e - 6.0)))) * 0.6
    col = col * (1.0 - hole) * (1.0 - (1.0 - smoothstep(0.0, 1.8, abs(e - 7.2))) * 0.25 * dash)
    col = mix(col, vec3(0.86, 0.68, 0.38), line * dash * 0.9)
    return col
}

// The porthole's seat: blackened bronze, hex bolts round it.
mod.widgets.HwBezel.draw_bg.ground = #x2a1d12
mod.widgets.HwBezel.draw_bg.light_ink = vec4(1.0, 0.82, 0.55, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwBezel.draw_bg.inner = vec4(0.95, 12.0, 0.0, 0.55)
mod.widgets.HwBezel.draw_bg.spill = vec2(2.0, 0.4)
mod.widgets.HwBezel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    var col = base * (0.8 + 0.4 * self.hw_noise(w * 0.1)) * (1.0 + (self.hw_hash(floor(w * 1.5)) - 0.5) * 0.1)
    let s = self.rect_size
    let cq = min(p, s - p)
    let e = min(cq.x, cq.y)
    let alongx = step(cq.y, cq.x)
    let along = mix(p.y, p.x, alongx)
    let pitch = 34.0
    let rq = vec2((fract(along / pitch) - 0.5) * pitch, e - 7.0)
    // Hex bolt heads.
    let a = abs(rq)
    let hex = max(a.x * 0.866 + a.y * 0.5, a.y) - 3.6
    let bm = 1.0 - smoothstep(-0.5, 0.5, hex)
    let bsh = (1.0 - smoothstep(0.0, 2.5, hex)) * (1.0 - bm)
    col = col * (1.0 - bsh * 0.5)
    let bolt = vec3(0.62, 0.46, 0.22) * (0.65 + 0.35 * (1.0 - length(rq) / 4.5)) + vec3(1.0, 0.9, 0.7) * (1.0 - smoothstep(0.0, 1.6, length(rq + vec2(1.0, 1.0)))) * 0.35
    col = mix(col, bolt, bm)
    return col
}

// The glass: a brass porthole flange, the opening a stadium, a faint aether
// haze creeping in from the rim and a warm reflection sheet.
// No dark rim or bulge over the picture: it reads clean and bright.
mod.widgets.HwGlass.draw_bg.glass = vec4(0.0, 0.10, 0.0, 0.0)
mod.widgets.HwGlass.draw_bg.tint = vec4(1.0, 0.85, 0.60, 0.22)
mod.widgets.HwGlass.draw_bg.radius = 58.0
mod.widgets.HwGlass.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let fw = 11.0
    let d = Material.sd_box(p, c, c - vec2(fw, fw), self.radius)
    // The flange: a rolled brass ring out to the quad's edge.
    let flange = smoothstep(-px, px, d)
    let t = clamp(d / fw, 0.0, 1.0)
    let prof = sin(t * 3.14159)
    let top = 1.0 - self.pos.y
    var brass = vec3(0.66, 0.48, 0.20) * (0.45 + 0.75 * prof * (0.55 + 0.45 * top))
    brass = brass + vec3(1.0, 0.9, 0.65) * pow(prof, 8.0) * 0.35 * top
    brass = brass * (1.0 - (1.0 - smoothstep(0.0, 1.2, d)) * 0.5)
    // Corner bolts in the flange's spandrels.
    let cq = min(p, self.rect_size - p)
    let bq = cq - vec2(14.0, 14.0)
    let bd = length(bq)
    let a = abs(bq)
    let hex = max(a.x * 0.866 + a.y * 0.5, a.y) - 5.0
    let bm = (1.0 - smoothstep(-0.5, 0.5, hex)) * step(0.0, d)
    brass = brass * (1.0 - (1.0 - smoothstep(4.5, 8.0, bd)) * (1.0 - bm) * 0.5)
    let boltc = vec3(0.70, 0.52, 0.24) * (0.6 + 0.5 * (1.0 - bd / 6.0)) + vec3(1.0, 0.9, 0.7) * (1.0 - smoothstep(0.0, 2.2, length(bq + vec2(1.4, 1.4)))) * 0.4
    let slot = (1.0 - smoothstep(0.3, 0.9, abs((bq.x - bq.y) * 0.707))) * step(bd, 3.2)
    brass = mix(brass, boltc, bm)
    brass = mix(brass, vec3(0.12, 0.08, 0.03), slot * bm)
    // Rivets round the flange, on its crown.
    let alongx = step(cq.y, cq.x)
    let along = mix(p.y, p.x, alongx)
    let rq = vec2((fract(along / 22.0) - 0.5) * 22.0, min(cq.x, cq.y) - fw * 0.5)
    let straight = step(34.0, min(max(cq.x, cq.y), 1000.0)) * step(self.radius + fw + 6.0, max(cq.x, cq.y))
    let rd = length(rq)
    let rm = (1.0 - smoothstep(1.6, 2.4, rd)) * straight * flange
    brass = mix(brass, vec3(0.80, 0.60, 0.28) * (0.7 + 0.5 * (1.0 - rd / 2.4)), rm)
    // Inside: the lip's shadow on the picture, the aether haze, the reflection.
    let lip = (1.0 - smoothstep(-9.0, 0.0, d)) * 0.0 + smoothstep(-9.0, 0.0, d) * 0.55
    let haze = smoothstep(-70.0, 0.0, d) * (1.0 - flange)
    let r = smoothstep(0.55, 0.0, self.pos.y + (self.pos.x - 0.5) * 0.3) * self.glass.y
    let glow = vec3(0.30, 0.95, 0.75) * haze * 0.05 + vec3(1.0, 0.62, 0.22) * haze * haze * 0.06
    let inner = vec4(self.tint.xyz * r + glow, clamp(r + lip * (1.0 - r), 0.0, 1.0))
    return mix(inner, vec4(brass, 1.0), flange)
}

// The picture lights the metal: strong spill, a soft ceiling.
mod.widgets.HwMilk.light = 2.4
mod.widgets.HwMilk.light_knee = 1.0
mod.widgets.HwSpectrum.light = 2.8

// ---- the spectrum: glass gas tubes over an aether graticule ----
// Parts by `self.part` (1 well, 2 rule, 3 slot, 4 bar, 5 peak, 6 midline).
mod.widgets.HwSpectrum.draw_round.pixel = fn() {
    let p = self.pos * self.rect_size
    let s = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let r = min(self.radius, min(s.x, s.y) * 0.5)
    let c = s * 0.5
    let d = Material.sd_box(p, c, c, r)
    let cov = 1.0 - smoothstep(-px, px, d)
    if self.part > 0.5 && self.part < 1.5 {
        // The well: aether glass, a teal bloom in the middle, a brass graticule.
        let uv = self.pos - vec2(0.5, 0.45)
        let bloom = exp(-dot(uv * vec2(1.4, 2.2), uv * vec2(1.4, 2.2)) * 3.0)
        var col = vec3(0.018, 0.045, 0.040) + vec3(0.01, 0.05, 0.04) * bloom
        let g = abs(fract((p - vec2(18.0, 16.0)) / 24.0 + vec2(0.5, 0.5)) - vec2(0.5, 0.5)) * 24.0
        let grid = (1.0 - smoothstep(0.2, 0.7, min(g.x, g.y))) * 0.5
        col = col * 0.8 + vec3(0.55, 0.40, 0.18) * grid * 0.06
        return vec4(col * cov, cov)
    }
    if (self.part > 1.5 && self.part < 2.5) || (self.part > 5.5 && self.part < 6.5) {
        // A level rule: a dotted engraved line.
        let dot = step(0.5, fract(p.x / 4.0))
        let a = self.color.a * 0.9 * dot
        return vec4(vec3(0.85, 0.66, 0.35) * a, a)
    }
    if self.part > 4.5 && self.part < 5.5 {
        // A peak: a brass float riding the column.
        let a = cov * 0.95
        let col = vec3(0.95, 0.78, 0.45) * (0.7 + 0.5 * (1.0 - self.pos.y))
        return vec4(col * a, a)
    }
    let u = self.pos.x * 2.0 - 1.0
    let wall = smoothstep(0.55, 1.0, abs(u))
    if self.part > 2.5 && self.part < 3.5 {
        // An empty tube: glass walls, a glint down the left, brass cap and foot.
        let glint = (1.0 - smoothstep(0.0, 0.16, abs(u + 0.5))) * 0.4
        let foot = step(s.y - 5.0, p.y) + step(p.y, 3.0)
        let a = cov * clamp(0.06 + wall * 0.35 + glint * 0.45 + foot, 0.0, 1.0)
        let col = mix(vec3(0.50, 0.78, 0.68), vec3(0.70, 0.50, 0.22) * (1.0 - abs(u) * 0.5), clamp(foot, 0.0, 1.0))
        return vec4(col * a, a)
    }
    // A lit column of gas: an orange glow, a hot filament core, a bright meniscus.
    let core = 1.0 - u * u
    let men = 1.0 - smoothstep(0.0, 4.0, p.y)
    let gas = mix(vec3(0.95, 0.36, 0.06), vec3(1.0, 0.62, 0.16), core)
    var col = gas * (0.45 + 0.75 * core) + vec3(1.0, 0.90, 0.65) * (pow(core, 6.0) * 0.45 + men * 0.55)
    col = col * (0.75 + 0.35 * (1.0 - self.pos.y)) * (0.6 + 0.6 * self.color.a)
    let tick = 1.0 - smoothstep(0.0, 0.14, fract((s.y - p.y) / 7.0))
    col = col * (1.0 - tick * 0.35 * step(4.0, p.y))
    col = mix(col, vec3(0.30, 0.45, 0.40), wall * 0.45)
    return vec4(col * cov, cov)
}
// The waveform: a glowing filament.
mod.widgets.HwSpectrum.draw_line.pixel = fn() {
    let p = self.pos * self.rect_size
    let a = self.seg_a
    let b = self.seg_b
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let d = length(pa - ba * h)
    let core = 1.0 - smoothstep(0.2, 0.9, d)
    let halo = exp(-d / 1.3) * 0.55
    let col = vec3(1.0, 0.93, 0.78) * core + self.color.rgb * halo
    let al = clamp(core + halo, 0.0, 1.0) * self.color.a
    return vec4(col * self.color.a, al)
}

// ---- keys: oxblood enamel caps in brass bezels; play wears verdigris ----
mod.widgets.HwKey.radius = 7
mod.widgets.HwKey.draw_bg.ground = #x5c1813
mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 0.85, 0.65, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.06, 0.01, 0.0, 1.0)
mod.widgets.HwKey.draw_bg.relief = vec4(2.6, 0.9, 2.6, 0.75)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.65, 6.0, 1.0, 0.6)
mod.widgets.HwKey.draw_bg.sheen = vec4(0.10, 0.22, 0.25, 0.3)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.62, 0.22, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(2.2, 0.5)
mod.widgets.HwKey.draw_bg.led = vec4(7.0, 7.0, 2.2, 1.0)
mod.widgets.HwKey.draw_bg.led_off = vec4(0.25, 0.12, 0.05, 1.0)
mod.widgets.HwKey.draw_bg.key_face = fn(p: vec2, base: vec3) -> vec3 {
    var b = base
    if self.critical > 0.5 {
        b = vec3(0.12, 0.30, 0.24)
    }
    let w = self.world.xy
    var col = b * (0.9 + 0.2 * self.hw_noise(w * 0.2))
    // Enamel: a deep glossy gradient.
    let uv = self.pos
    col = col * (1.15 - 0.35 * uv.y)
    // The brass bezel round the cap.
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let ring = 1.0 - smoothstep(2.6, 3.4, e)
    let rt = clamp(e / 3.0, 0.0, 1.0)
    let brass = vec3(0.72, 0.53, 0.24) * (0.6 + 0.6 * sin(rt * 3.14159)) * (1.05 - 0.3 * uv.y)
    col = mix(col, brass, ring)
    return col
}
