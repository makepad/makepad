// ---- volume: a brass valve wheel over a dark socket ----
mod.widgets.HwKnobFace.draw_bg.ground = #x1e1610
mod.widgets.HwKnobFace.draw_bg.light_ink = vec4(1.0, 0.92, 0.72, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.78, 0.57, 0.25, 1.0)
mod.widgets.HwKnobFace.draw_bg.ptr_ink = vec4(0.66, 0.10, 0.06, 1.0)
mod.widgets.HwKnobFace.draw_bg.ring = vec4(11.0, 1.28, 2.6, 2.35619)
mod.widgets.HwKnobFace.draw_bg.led_off = vec4(0.28, 0.17, 0.08, 1.0)
mod.widgets.HwKnobFace.draw_bg.glow_ink = vec4(1.0, 0.64, 0.24, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow = vec4(0.8, 10.0, 1.0, 0.7)
mod.widgets.HwKnobFace.emissive = vec4(1.0, 0.58, 0.18, 0.8)
mod.widgets.HwKnobFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let q = p - c
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let r = min(c.x, c.y) - self.inset
    var o = self.layer(self.surface(p, self.ground.xyz))
    let rq = length(q)
    let ang = atan2(q.x, -q.y)
    let inside = 1.0 - smoothstep(-px, px, rq - r)
    let lt = normalize(vec2(-0.6, -0.8))
    let nd = q / max(rq, 0.001)
    let brass = self.cap_ink.xyz
    let spin = (self.value * 2.0 - 1.0) * self.ring.w
    // The socket: dark, deeper at the centre, a verdigris stain.
    var face = self.ground.xyz * (0.5 + 0.7 * (rq / max(r, 1.0)))
    face = mix(face, vec3(0.14, 0.26, 0.21), smoothstep(0.55, 0.8, self.hw_noise(p * 0.15)) * 0.6)
    // The spokes' shadow on the socket.
    let r0 = r * 0.72
    let seg = 6.28318 / 5.0
    let qs = q - vec2(2.5, 3.0)
    let angs = atan2(qs.x, -qs.y) - spin
    let ks = angs - seg * floor(angs / seg + 0.5)
    let shs = 1.0 - smoothstep(-2.0, 2.0, abs(ks) * length(qs) - r * 0.08)
    face = face * (1.0 - shs * 0.6 * step(r * 0.2, length(qs)))
    // The wheel's rim: a rolled tube with grips.
    let tt = clamp((rq - (r0 + r) * 0.5) / ((r - r0) * 0.5), -1.0, 1.0)
    let rimm = smoothstep(r0 - px, r0 + px, rq) * inside
    let nz = sqrt(max(1.0 - tt * tt, 0.0))
    let dif = clamp(dot(nd * tt, lt) * 0.9 + nz * 0.55, 0.0, 1.5)
    let grip = 0.5 + 0.5 * cos((ang - spin) * 16.0)
    var rimc = brass * (0.30 + 0.75 * dif) * (0.88 + 0.16 * grip)
    rimc = rimc + self.light_ink.xyz * pow(max(dif - 0.85, 0.0) * 1.6, 2.0) * 0.8
    // Five spokes; the one at the value is enamelled red.
    let rel = ang - spin
    let idx = floor(rel / seg + 0.5)
    let k = rel - seg * idx
    let hw = r * 0.08
    let sdd = abs(k) * rq - hw
    let spm = (1.0 - smoothstep(-px, px, sdd)) * (1.0 - smoothstep(r0 - 1.0, r0 + 1.0, rq)) * inside
    let sw = clamp(k * rq / hw, -1.0, 1.0)
    let sdif = 0.45 + 0.55 * sqrt(max(1.0 - sw * sw, 0.0)) + sw * dot(vec2(nd.y, -nd.x), lt) * 0.35
    let idxw = idx - 5.0 * floor(idx / 5.0)
    let isptr = 1.0 - step(0.5, idxw)
    let spc = mix(brass * sdif, self.ptr_ink.xyz * (0.5 + 0.7 * sdif), isptr * step(r * 0.3, rq))
    // The hub and its hex nut.
    let hr = r * 0.26
    let hm = 1.0 - smoothstep(hr - px, hr + px, rq)
    let hubc = brass * (0.6 + 0.45 * dot(nd, lt) * (rq / hr)) + vec3(0.0, 0.0, 0.0)
    let a = abs(q)
    let hex = max(a.x * 0.866 + a.y * 0.5, a.y) - hr * 0.55
    let nut = 1.0 - smoothstep(-px, px, hex)
    let nutc = brass * 0.75 * (0.85 + 0.3 * dot(nd, lt) * step(hr * 0.2, rq))
    face = mix(face, rimc, rimm)
    face = mix(face, spc, spm)
    face = mix(face, hubc, hm)
    face = mix(face, nutc, nut)
    face = face + self.env_spill(vec3(0.0, 0.0, 1.0)) * 0.6 * (rimm + spm + hm)
    o = vec4(face * inside, inside) + o * (1.0 - inside)
    // Gaslight jewels round the wheel.
    let n = self.ring.x
    if n > 0.5 {
        let rr = r * self.ring.y
        let a0 = -self.ring.w
        let stepa = (self.ring.w * 2.0) / max(n - 1.0, 1.0)
        let fi = clamp(floor((ang - a0) / stepa + 0.5), 0.0, n - 1.0)
        let aa = a0 + fi * stepa
        let dc = q - vec2(sin(aa), -cos(aa)) * rr
        let dd = length(dc) - self.ring.z
        let on = step((fi + 0.5) / n, self.value + 0.001)
        let bez = 1.0 - smoothstep(-px, px, dd - 1.4)
        let dot_a = 1.0 - smoothstep(-px, px, dd)
        let jewel = mix(self.led_off.xyz, mix(self.glow_ink.xyz, vec3(1.0, 0.95, 0.8), 0.35), on) + vec3(1.0, 1.0, 1.0) * (1.0 - smoothstep(0.0, 1.2, length(dc + vec2(0.8, 0.8)))) * 0.3
        o = vec4(brass * 0.7 * bez, bez) + o * (1.0 - bez)
        o = vec4(jewel * dot_a, dot_a) + o * (1.0 - dot_a)
        let halo = exp(-max(dd, 0.0) / 3.0) * 0.6 * on * (1.0 - bez)
        o = o + vec4(self.glow_ink.xyz * halo, halo) * (1.0 - o.w)
    }
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- levels: twin brass pressure gauges, left and right ----
mod.widgets.HwMeterFace.draw_bg.ground = #x8e6a30
mod.widgets.HwMeterFace.draw_bg.light_ink = vec4(1.0, 0.9, 0.7, 1.0)
mod.widgets.HwMeterFace.draw_bg.shadow_ink = vec4(0.1, 0.05, 0.02, 1.0)
mod.widgets.HwMeterFace.draw_bg.dial_ink = vec4(0.93, 0.86, 0.68, 1.0)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(1.0, 0.62, 0.22, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(0.72, 0.10, 0.06, 1.0)
mod.widgets.HwMeterFace.emissive = vec4(1.0, 0.58, 0.18, 0.9)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let s = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let lane = step(s.x * 0.5, p.x)
    let ro = min(s.y * 0.5 - 3.0, s.x * 0.24)
    let cen = vec2(mix(s.x * 0.27, s.x * 0.73, lane), s.y * 0.5)
    let lv = clamp(mix(self.level.x, self.level.y, lane), 0.0, 1.0)
    let q = p - cen
    let rq = length(q)
    let nd = q / max(rq, 0.001)
    let lt = normalize(vec2(-0.6, -0.8))
    var col = o.xyz
    // The plate between: a rivet in each corner, a shadow round each gauge.
    let cq = min(p, s - p)
    let rv = length(cq - vec2(7.0, 7.0))
    col = mix(col, self.ground.xyz * (1.3 - rv * 0.15), 1.0 - smoothstep(1.8, 2.6, rv))
    col = col * (1.0 - (1.0 - smoothstep(ro, ro + 5.0, length(q - vec2(1.5, 2.5)))) * 0.45 * step(ro, rq))
    // A copper pipe joining the gauges, with a flange at each end.
    let pl = s.x * 0.27 + ro
    let pr = s.x * 0.73 - ro
    let py = (p.y - s.y * 0.5) / 3.6
    let inpipe = step(pl - 2.0, p.x) * step(p.x, pr + 2.0) * step(abs(py), 1.0)
    let pcol = vec3(0.72, 0.36, 0.18) * (0.45 + 0.7 * sqrt(max(1.0 - py * py, 0.0)) - 0.25 * py)
    let fl = step(abs(p.x - (pl + 5.0)), 2.0) + step(abs(p.x - (pr - 5.0)), 2.0)
    let inflange = fl * step(abs(py), 1.6)
    col = mix(col, col * 0.6, step(abs(py - 0.6), 1.2) * step(pl, p.x) * step(p.x, pr) * (1.0 - inpipe))
    col = mix(col, pcol, inpipe)
    col = mix(col, vec3(0.80, 0.60, 0.28) * (0.55 + 0.5 * (1.0 - abs(py) / 1.6)), clamp(inflange, 0.0, 1.0))
    // The bezel: a rolled brass ring.
    let rf = ro - 4.5
    let bz = (1.0 - smoothstep(ro - px, ro + px, rq)) * smoothstep(rf - px, rf + px, rq)
    let tt = clamp((rq - (rf + ro) * 0.5) / 2.25, -1.0, 1.0)
    let dif = clamp(dot(nd * tt, lt) * 0.9 + sqrt(max(1.0 - tt * tt, 0.0)) * 0.55, 0.0, 1.5)
    let bzc = vec3(0.80, 0.60, 0.28) * (0.3 + 0.8 * dif) + vec3(1.0, 0.92, 0.7) * pow(max(dif - 0.9, 0.0) * 1.7, 2.0)
    col = mix(col, bzc, bz)
    // The dial: aged enamel, warmed by the lamp as the pressure rises.
    let fm = 1.0 - smoothstep(rf - px, rf + px, rq)
    let fox = smoothstep(0.6, 0.9, self.hw_noise(p * 0.25 + vec2(lane * 17.0, 3.0)))
    var dial = self.dial_ink.xyz * (0.78 + 0.22 * (1.0 - rq / rf)) * (1.0 - fox * 0.18)
    dial = dial * (0.85 + 0.25 * lv) + vec3(1.0, 0.55, 0.15) * lv * 0.18
    // The scale: 270 degrees, major and minor ticks, a red zone.
    let ang = atan2(q.x, -q.y)
    let sweep = 2.35619
    let inarc = step(abs(ang), sweep + 0.02)
    let fa = (ang + sweep) / (sweep * 2.0)
    let mj = abs(fract(fa * 8.0 + 0.5) - 0.5) / 8.0 * sweep * 2.0 * rq
    let mn = abs(fract(fa * 32.0 + 0.5) - 0.5) / 32.0 * sweep * 2.0 * rq
    let major = (1.0 - smoothstep(0.35, 0.35 + px, mj)) * step(rf * 0.62, rq) * step(rq, rf * 0.9)
    let minor = (1.0 - smoothstep(0.2, 0.2 + px, mn)) * step(rf * 0.76, rq) * step(rq, rf * 0.9)
    let arcl = 1.0 - smoothstep(0.2, 0.2 + px, abs(rq - rf * 0.9))
    let red = step(0.75, fa) * step(rf * 0.78, rq) * step(rq, rf * 0.9)
    dial = mix(dial, vec3(0.16, 0.08, 0.04), clamp(major + minor * 0.8 + arcl, 0.0, 1.0) * inarc)
    dial = mix(dial, self.hot_ink.xyz, red * inarc * 0.85)
    // The telltale: a thin red hand left at the held peak.
    let pa = (clamp(self.level.z, 0.0, 1.0) * 2.0 - 1.0) * sweep
    let pdir = vec2(sin(pa), -cos(pa))
    let tp = clamp(dot(q, pdir), 0.0, rf * 0.88)
    let dp = length(q - pdir * tp) - 0.35
    dial = mix(dial, vec3(0.78, 0.12, 0.06), (1.0 - smoothstep(-px, px, dp)) * step(0.02, self.level.z))
    // The needle: blued steel, a counterweight tail, a brass pivot.
    let na = (lv * 2.0 - 1.0) * sweep
    let dir = vec2(sin(na), -cos(na))
    let perp = vec2(-dir.y, dir.x)
    let qsh = q - vec2(1.2, 1.6)
    let tsh = clamp(dot(qsh, dir), -rf * 0.25, rf * 0.85)
    let dsh = abs(dot(qsh, perp)) - mix(1.2, 0.3, clamp(tsh / (rf * 0.85), 0.0, 1.0))
    dial = dial * (1.0 - (1.0 - smoothstep(-0.5, 1.8, dsh)) * 0.3 * step(dot(qsh, dir), rf * 0.9) * step(-rf * 0.3, dot(qsh, dir)))
    let tn = clamp(dot(q, dir), -rf * 0.25, rf * 0.85)
    let dn = length(q - dir * tn) - mix(1.5, 0.45, clamp(tn / (rf * 0.85), 0.0, 1.0))
    dial = mix(dial, mix(vec3(0.06, 0.05, 0.08), vec3(0.75, 0.10, 0.05), step(rf * 0.55, tn)), 1.0 - smoothstep(-px, px, dn))
    let pv = 1.0 - smoothstep(2.4 - px, 2.4 + px, rq)
    dial = mix(dial, vec3(0.85, 0.65, 0.30) * (0.8 + 0.5 * dot(nd, lt) * rq / 2.4), pv)
    // The glass: a crescent glint top-left, a darker rim.
    let gl = (1.0 - smoothstep(0.0, 2.0, abs(length(q + vec2(rf * 0.18, rf * 0.22)) - rf * 0.72))) * step(q.y, -rf * 0.2) * step(q.x, rf * 0.2)
    dial = dial * (0.72 + 0.28 * smoothstep(rf, rf * 0.75, rq)) + vec3(1.0, 1.0, 0.95) * gl * 0.35
    col = mix(col, dial, fm)
    o = vec4(col, o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

