mod.widgets.HwPanel.draw_bg.pattern = vec4(4.0, 0.9, 0.16, 0.0)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.95, 11.0, 0.0, 0.6)
mod.widgets.HwPanel.draw_bg.finish = vec4(0.8, 0.3, 0.05, 0.9)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(1.0, 0.36, 0.08, 1.0)
mod.widgets.HwPanel.draw_bg.spill = vec2(1.6, 0.7)

// ---- the screen's surround: black crackle paint, very deep ----
mod.widgets.HwBezel.radius = 6
mod.widgets.HwBezel.depth = -6.0
mod.widgets.HwBezel.draw_bg.ground = #x1a1c1a
mod.widgets.HwBezel.draw_bg.light_ink = vec4(0.60, 0.62, 0.58, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwBezel.draw_bg.inner = vec4(1.0, 16.0, 0.0, 0.6)
mod.widgets.HwBezel.draw_bg.spill = vec2(1.9, 0.5)
mod.widgets.HwBezel.draw_bg.glow_ink = vec4(1.0, 0.36, 0.08, 1.0)
mod.widgets.HwBezel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // Crackle finish: wrinkled black paint, lit on its ridges.
    let w = self.world.xy
    let n = self.hw_noise(w * 0.5) * 0.5 + self.hw_noise(w * 1.3) * 0.5
    let ridge = 1.0 - abs(n - 0.5) * 2.0
    return base * (0.8 + 0.5 * smoothstep(0.7, 0.95, ridge))
}

// ---- the glass: a warm smoked pane with the faint mesh of a Nixie anode ----
mod.widgets.HwGlass.draw_bg.glass = vec4(0.0, 0.10, 0.55, 0.05)
mod.widgets.HwGlass.draw_bg.tint = vec4(1.0, 0.62, 0.35, 0.0)
mod.widgets.HwGlass.draw_bg.radius = 4.0
mod.widgets.HwGlass.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, self.radius)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let cov = 1.0 - smoothstep(-px, px, d)
    // Rim darkening and the tube's corners.
    let edge = smoothstep(-34.0, 0.0, d) * self.glass.z
    let qq = (self.pos - vec2(0.5, 0.5)) * 2.0
    let bulge = clamp(dot(qq * qq, qq * qq) * self.glass.w, 0.0, 1.0)
    let dark = clamp(edge + bulge, 0.0, 1.0)
    // A reflection of the lab's strip light across the top.
    let rl = (1.0 - smoothstep(0.0, 0.012, abs(self.pos.y - 0.10 + (self.pos.x - 0.5) * 0.06))) * 0.06 * (1.0 - smoothstep(0.3, 0.5, abs(self.pos.x - 0.45))) + smoothstep(0.55, 0.0, self.pos.y) * self.glass.y * 0.5
    let o = vec4(vec3(1.0, 0.92, 0.82) * rl, rl) * cov + vec4(0.0, 0.0, 0.0, dark * cov) * (1.0 - rl)
    return o
}

// ---- keys: brown bakelite, glossy, a red PUSK key ----
mod.widgets.HwKey.depth = 3.5
mod.widgets.HwKey.press = -3.0
mod.widgets.HwKey.radius = 3
mod.widgets.HwKey.draw_bg.ground = #x3b2519
mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 0.92, 0.82, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.02, 0.01, 0.0, 1.0)
mod.widgets.HwKey.draw_bg.relief = vec4(3.2, 0.6, 3.0, 0.55)
mod.widgets.HwKey.draw_bg.finish = vec4(0.7, 0.45, 0.45, 0.35)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.85, 6.0, 1.0, 0.8)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.36, 0.08, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(2.6, 0.6)
mod.widgets.HwKey.draw_bg.inner = vec4(0.72, 9.0, 0.0, 0.10)
mod.widgets.HwKey.emissive = vec4(1.0, 0.34, 0.06, 0.35)
mod.widgets.HwKey.draw_bg.led = vec4(7.0, 7.0, 2.6, 1.0)
mod.widgets.HwKey.draw_bg.led_off = vec4(0.22, 0.10, 0.05, 1.0)
mod.widgets.HwKey.draw_bg.critical_ink = vec4(0.62, 0.07, 0.04, 0.0)
mod.widgets.HwKey.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // Bakelite: a mottled, swirled phenolic brown.
    let w = self.world.xy
    let sw = self.hw_noise(w * 0.09 + vec2(self.hw_noise(w * 0.05) * 4.0, 0.0))
    var col = base * (0.82 + sw * 0.36)
    col = col + vec3(0.05, 0.02, 0.0) * smoothstep(0.6, 0.85, self.hw_noise(w * 0.2 + vec2(9.0, 2.0)))
    return col
}
mod.widgets.HwKey.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    // Critical keys (play, presets) are cast in red bakelite.
    let g = mix(self.ground.xyz, vec3(0.50, 0.07, 0.04), self.critical)
    var o = self.layer(self.key_face(p, g))
    o = self.key_marks(o, p)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
mod.widgets.HwKeyButton.draw_text.color = #xe6d8b8
mod.widgets.HwKeyButton.draw_text.color_hover = #xffb080
mod.widgets.HwKeyButton.draw_text.color_down = #xff7a30
mod.widgets.HwKeyText.draw_text.color = #xe6d8b8
mod.widgets.HwKeyText.draw_text.color_hover = #xffb080
mod.widgets.HwKeyText.draw_text.color_down = #xff7a30
mod.widgets.HwKeyText.draw_text.text_style = theme.font_bold{font_size: 9.0}

