// title: Soviet Lab
// Soviet Lab — a 1970s laboratory instrument set into a brutalist wall: a
// front of raw board-marked concrete with formwork tie holes and rust
// streaks, heavy grey-green hammertone plates held on by hex bolts, brown
// bakelite keys and knob, a red PUSK key, orange neon everywhere a light
// burns: Nixie-mesh displays, IN-9 bargraph tubes for the spectrum, neon
// indicator lamps, and a mirror-scale ammeter for the level.
use mod.prelude.widgets_internal.*

// ---- palette: neon orange on smoked glass ----
mod.widgets.hw_palette.screen_bg = #x0d0a08
mod.widgets.hw_palette.screen_text = #xffa060
mod.widgets.hw_palette.screen_muted = #x9a6440
mod.widgets.hw_palette.accent = #xff5a14
mod.widgets.hw_palette.panel_text = #xd9dccf
mod.widgets.hw_palette.panel_muted = #x8d968a
mod.widgets.hw_palette.menu_bg = #x1d221f
mod.widgets.hw_palette.spill_color = #xff6a20
mod.widgets.hw_palette.spill_mono = 0.45
mod.widgets.hw_palette.spill_knee = 1.1
mod.widgets.hw_palette.caption_bg = #x6e6d68
mod.widgets.hw_palette.caption_text = #x1a1a18

// ---- the front: board-marked cast concrete ----
mod.widgets.HwChassis.draw_bg.ground = #x72716b
mod.widgets.HwChassis.draw_bg.light_ink = vec4(0.96, 0.95, 0.90, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.10, 0.10, 0.09, 1.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.36, 0.08, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(2.8, 0.7)
mod.widgets.HwChassis.draw_bg.vignette = vec4(0.5, 0.30, 0.30, 1.06)
mod.widgets.Window.pass.clear_color = #x66655f
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Formwork boards: wide planks, each poured against a different board.
    let bh = 62.0
    let row = floor(w.y / bh)
    let fy = w.y - row * bh
    let tone = self.hw_hash(vec2(row, 3.0)) - 0.5
    var col = base * (1.0 + tone * 0.06)
    // The board's grain printed faintly into the concrete.
    let grain = self.hw_noise(vec2(w.x * 0.012 + row * 13.0, fy * 0.35 + self.hw_noise(vec2(w.x * 0.008, row)) * 3.0))
    col = col * (1.0 + (grain - 0.5) * 0.05)
    // Blotchy cement: large damp clouds, smaller mottling, sand.
    let cloud = self.hw_noise(w * 0.006) * 0.5 + self.hw_noise(w * 0.021) * 0.3 + self.hw_noise(w * 0.07) * 0.2
    col = col * (0.80 + cloud * 0.36)
    col = mix(col, col * vec3(0.96, 0.99, 1.03), smoothstep(0.4, 0.7, self.hw_noise(w * 0.01 + vec2(40.0, 9.0))))
    col = col * (1.0 + (self.hw_hash(floor(w * 1.7)) - 0.5) * 0.08)
    // Air pits: small dark holes in the pour.
    let pc = floor(w / 5.0)
    let ph = self.hw_hash(pc + vec2(7.0, 1.0))
    let pp = (pc + vec2(0.5, 0.5) + (vec2(self.hw_hash(pc), self.hw_hash(pc + vec2(3.0, 9.0))) - 0.5) * 2.5) * 5.0
    let pr = length(w - pp)
    let pit = (1.0 - smoothstep(0.5, 1.4, pr)) * step(0.91, ph)
    col = col * (1.0 - pit * 0.6) + vec3(0.05, 0.05, 0.05) * (1.0 - smoothstep(0.0, 0.8, abs(pr - 1.7))) * step(0.91, ph) * step(pp.y, w.y)
    // The joint between boards: a thin fin of cement, lit from above.
    let jn = min(fy, bh - fy)
    col = col * (1.0 - (1.0 - smoothstep(0.0, 1.4, jn)) * 0.16)
    col = col + vec3(0.05, 0.05, 0.047) * (1.0 - smoothstep(0.0, 1.0, abs(fy - 1.8)))
    // Precast panel joints: deep grooves, shadowed on the lit side's far wall.
    let pcell = vec2(472.0, 368.0)
    let pf = w - pcell * floor(w / pcell)
    let gx = min(pf.x, pcell.x - pf.x)
    let gy = min(pf.y, pcell.y - pf.y)
    let groove = 1.0 - smoothstep(1.6, 2.6, min(gx, gy))
    let lipd = smoothstep(2.4, 3.2, min(gx, gy)) * (1.0 - smoothstep(3.2, 4.6, min(gx, gy)))
    let gsh = mix(step(pcell.x * 0.5, pf.x), step(pcell.y * 0.5, pf.y), step(gy, gx))
    col = col * (1.0 - groove * 0.62)
    col = col * (1.0 + lipd * (gsh * 0.22 - 0.10))
    // Formwork tie holes on a grid, each weeping a rust streak down the wall.
    let cell = vec2(236.0, 184.0)
    let ci = floor(w / cell)
    let hc = (ci + vec2(0.5, 0.5)) * cell
    let v = w - hc
    let r = length(v)
    let streak = (1.0 - smoothstep(2.0, 6.0, abs(v.x + (self.hw_noise(vec2(w.y * 0.05, ci.x)) - 0.5) * 4.0))) * smoothstep(0.0, 8.0, v.y) * (1.0 - smoothstep(20.0, 130.0, v.y))
    let sn = 0.6 + 0.4 * self.hw_noise(vec2(w.x * 0.4, w.y * 0.03))
    col = mix(col, col * vec3(0.72, 0.56, 0.42), streak * sn * 0.55)
    let cone = (1.0 - smoothstep(6.0, 9.5, r))
    col = col * (1.0 - cone * 0.18 + cone * smoothstep(5.0, 8.0, r) * dot(normalize(v + vec2(0.0001, 0.0001)), vec2(0.5, 0.7)) * 0.25)
    let hole = 1.0 - smoothstep(4.2, 5.2, r)
    col = mix(col, vec3(0.13, 0.12, 0.11) + vec3(0.08, 0.07, 0.06) * clamp(v.y / 5.0, 0.0, 1.0), hole)
    return col
}

// ---- raised plates: grey-green hammertone enamel, hex-bolted ----
mod.widgets.HwPlate.depth = 3.5
mod.widgets.HwPlate.radius = 4
mod.widgets.HwPlate.draw_bg.ground = #x3e5048
mod.widgets.HwPlate.draw_bg.light_ink = vec4(0.74, 0.80, 0.75, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.02, 0.03, 0.02, 1.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(3.0, 0.2, 3.5, 0.35)
mod.widgets.HwPlate.draw_bg.finish = vec4(0.75, 0.40, 0.18, 0.7)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.85, 12.0, 1.0, 0.8)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.36, 0.08, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(1.7, 0.7)
// Stencil figures: a seven-segment glyph with the stencil's bridges
// left in. `q` from the glyph's top-left (pt, 12 x 22), `s1` = segments
// a b c d, `s2` = e f g.
mod.widgets.HwPlate.draw_bg.seg_box = fn(q: vec2, c: vec2, h: vec2) -> float {
    let d = abs(q - c) - h
    return 1.0 - smoothstep(-0.35, 0.35, max(d.x, d.y))
}
mod.widgets.HwPlate.draw_bg.glyph7 = fn(q: vec2, s1: vec4, s2: vec3) -> float {
    var m = self.seg_box(q, vec2(6.0, 1.5), vec2(3.6, 1.5)) * s1.x
    m = max(m, self.seg_box(q, vec2(10.5, 5.8), vec2(1.5, 3.7)) * s1.y)
    m = max(m, self.seg_box(q, vec2(10.5, 16.2), vec2(1.5, 3.7)) * s1.z)
    m = max(m, self.seg_box(q, vec2(6.0, 20.5), vec2(3.6, 1.5)) * s1.w)
    m = max(m, self.seg_box(q, vec2(1.5, 16.2), vec2(1.5, 3.7)) * s2.x)
    m = max(m, self.seg_box(q, vec2(1.5, 5.8), vec2(1.5, 3.7)) * s2.y)
    m = max(m, self.seg_box(q, vec2(6.0, 11.0), vec2(3.6, 1.5)) * s2.z)
    return m
}
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Hammertone: a dimpled metallic enamel, each dimple lit by the key light.
    let lt0 = normalize(self.light.xy + vec2(0.000001, 0.000001))
    let n1 = self.hw_noise(w * 0.16)
    let n1s = self.hw_noise((w - lt0 * 1.6) * 0.16)
    let n2 = self.hw_noise(w * 0.42 + vec2(17.0, 3.0))
    let n2s = self.hw_noise((w - lt0 * 0.8) * 0.42 + vec2(17.0, 3.0))
    var col = base * (0.92 + n1 * 0.12)
    col = col + vec3(0.30, 0.34, 0.31) * ((n1 - n1s) * 0.55 + (n2 - n2s) * 0.25)
    col = col * (1.0 + (self.hw_hash(floor(w * 2.0)) - 0.5) * 0.04)
    // Chips in the enamel near the edges, showing primer red.
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let chip = step(0.82, self.hw_noise(w * 0.22 + vec2(5.0, 11.0))) * (1.0 - smoothstep(2.0, 6.0, e))
    col = mix(col, vec3(0.42, 0.18, 0.12), chip * 0.8)
    // The right wing carries the instrument's type number, stencilled in
    // white paint, and the red OTK inspector's stamp.
    if self.rect_size.y > 380.0 && self.plate_id > 1.5 && self.plate_id < 2.5 {
        let o = vec2(self.rect_size.x * 0.5 - 52.0, self.rect_size.y - self.inset - 88.0)
        let q = (p - o) / 1.35
        var st = self.glyph7(q, vec4(1.0, 0.0, 0.0, 1.0), vec3(1.0, 1.0, 0.0))
        st = max(st, self.glyph7(q - vec2(16.0, 0.0), vec4(0.0, 1.0, 1.0, 0.0), vec3(0.0, 0.0, 0.0)))
        st = max(st, self.glyph7(q - vec2(30.0, 0.0), vec4(0.0, 0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0)))
        st = max(st, self.glyph7(q - vec2(46.0, 0.0), vec4(1.0, 1.0, 1.0, 0.0), vec3(0.0, 0.0, 0.0)))
        st = max(st, self.glyph7(q - vec2(62.0, 0.0), vec4(1.0, 1.0, 1.0, 1.0), vec3(0.0, 0.0, 1.0)))
        let wear = smoothstep(0.25, 0.45, self.hw_noise(w * 0.9) * 0.5 + self.hw_noise(w * 0.2) * 0.5)
        col = mix(col, vec3(0.86, 0.84, 0.76), st * wear * 0.9)
        // The stamp: an oval ring of red ink with smudged letters inside.
        let sc = vec2(self.rect_size.x * 0.5, self.rect_size.y - self.inset - 30.0)
        let sv = (p - sc) / vec2(22.0, 13.0)
        let sr = length(sv)
        let ring = 1.0 - smoothstep(0.08, 0.14, abs(sr - 0.92))
        let letters = step(abs(sv.y), 0.35) * step(abs(sv.x), 0.62) * step(0.5, fract(p.x / 4.2 + self.hw_noise(p * 0.5) * 0.3)) * step(0.3, self.hw_noise(p * 0.7))
        let ink = clamp(ring + letters * 0.8, 0.0, 1.0) * (0.55 + 0.45 * self.hw_noise(p * 0.6))
        col = mix(col, vec3(0.62, 0.10, 0.08), ink * 0.75)
    }
    // A hex bolt with a washer at each corner.
    let m = self.inset + 12.0
    let qx = mix(m, self.rect_size.x - m, step(self.rect_size.x * 0.5, p.x))
    let qy = mix(m, self.rect_size.y - m, step(self.rect_size.y * 0.5, p.y))
    let v = p - vec2(qx, qy)
    let r = length(v)
    let lt = normalize(self.light.xy + vec2(0.000001, 0.000001))
    // Washer: a turned steel ring.
    let washer = 1.0 - smoothstep(8.0, 8.8, r)
    let wsh = 0.5 + 0.5 * dot(v / max(r, 0.001), -lt)
    col = col * (1.0 - (1.0 - smoothstep(8.6, 11.5, r)) * smoothstep(8.0, 8.6, r) * 0.45)
    col = mix(col, vec3(0.36, 0.37, 0.35) * (0.75 + 0.5 * wsh), washer)
    // The hex head: six facets, each shaded by the key light, a flat top.
    let ang = atan2(v.y, v.x)
    let sec = floor(ang / 1.0472 + 0.5) * 1.0472
    let fn0 = vec2(cos(sec), sin(sec))
    let hd = dot(v, fn0)
    let hexm = 1.0 - smoothstep(5.6, 6.3, hd)
    let top = 1.0 - smoothstep(3.6, 4.4, r)
    let facet = 0.55 + 0.6 * dot(fn0, -lt)
    var bolt = vec3(0.30, 0.31, 0.30) * facet
    bolt = mix(bolt, vec3(0.40, 0.41, 0.39) * (1.0 + dot(v, -lt) * 0.05), top)
    col = mix(col, bolt, hexm)
    return col
}

// ---- recessed panels: a dark green-grey well ----
