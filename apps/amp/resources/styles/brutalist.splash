mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.26, 0.15, 0.09, 1.0)
mod.widgets.HwKnobFace.draw_bg.ptr_ink = vec4(0.93, 0.87, 0.72, 1.0)
