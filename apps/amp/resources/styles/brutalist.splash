// ---- meter: a mirror-scale panel ammeter ----
mod.widgets.HwMeterFace.depth = -3.0
mod.widgets.HwMeterFace.radius = 3
mod.widgets.HwMeterFace.draw_bg.ground = #x1b1d1b
mod.widgets.HwMeterFace.draw_bg.dial_ink = vec4(0.91, 0.87, 0.76, 1.0)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(1.0, 0.40, 0.10, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(0.75, 0.08, 0.04, 1.0)
mod.widgets.HwMeterFace.emissive = vec4(1.0, 0.45, 0.15, 0.35)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let a = vec2(6.0, 6.0)
    let b = self.rect_size - a
    let inside = step(a.x, p.x) * step(p.x, b.x) * step(a.y, p.y) * step(p.y, b.y)
    let u = (p - a) / max(b - a, vec2(1.0, 1.0))
    let h = b.y - a.y
    // A yellowed paper dial, lit a little warm from the neon behind.
    var dial = self.dial_ink.xyz * (0.92 + 0.08 * self.hw_noise(p * 0.3))
    dial = dial * (1.0 - 0.18 * u.y)
    // The pivot far below: a long flat arc across the dial.
    let piv = vec2(self.rect_size.x * 0.5, b.y + h * 2.3)
    let q = p - piv
    let rq = length(q)
    let ang = atan2(q.x, -q.y)
    let sw = 0.55
    let rr = piv.y - a.y - h * 0.30
    let insw = step(abs(ang), sw)
    // The mirror band under the scale, for reading without parallax.
    let mirror = step(rr - 7.5, rq) * step(rq, rr - 4.0) * insw
    let mref = 0.35 + 0.5 * smoothstep(-sw, sw, ang + sin(rq * 0.2) * 0.02)
    dial = mix(dial, vec3(0.62, 0.66, 0.68) * mref, mirror)
    // Ticks: fifty minor, ten major, a red zone at the top end.
    let arc = (1.0 - smoothstep(0.3, 0.3 + px, abs(rq - rr))) * insw
    let t = (ang + sw) / (sw * 2.0)
    let tm = abs(fract(t * 50.0 + 0.5) - 0.5) / 50.0 * (sw * 2.0) * rq
    let tM = abs(fract(t * 10.0 + 0.5) - 0.5) / 10.0 * (sw * 2.0) * rq
    let minor = (1.0 - smoothstep(0.35, 0.35 + px, tm)) * step(rr, rq) * step(rq, rr + 4.0) * insw
    let major = (1.0 - smoothstep(0.6, 0.6 + px, tM)) * step(rr - 3.0, rq) * step(rq, rr + 8.0) * insw
    let ink = vec3(0.08, 0.07, 0.06)
    dial = mix(dial, ink, clamp(arc + minor + major, 0.0, 1.0))
    let red = step(0.78, t) * insw * step(rr + 0.5, rq) * step(rq, rr + 3.2)
    dial = mix(dial, self.hot_ink.xyz, red)
    // The ammeter's letter A, printed under the scale.
    let ac = vec2(self.rect_size.x * 0.5, a.y + h * 0.80)
    let aq = p - ac
    let pa1 = aq - vec2(0.0, -5.0)
    let ba1 = vec2(-3.6, 10.0)
    let ba2 = vec2(3.6, 10.0)
    let d1 = length(pa1 - ba1 * clamp(dot(pa1, ba1) / dot(ba1, ba1), 0.0, 1.0))
    let d2 = length(pa1 - ba2 * clamp(dot(pa1, ba2) / dot(ba2, ba2), 0.0, 1.0))
    let d3 = max(abs(aq.y - 1.6) - 0.5, abs(aq.x) - 2.2)
    let glyph = 1.0 - smoothstep(0.65 - px, 0.65 + px, min(min(d1, d2), d3 + 0.65))
    dial = mix(dial, vec3(0.08, 0.07, 0.06), glyph * 0.9)
    // The knife-edge needle, and its shadow on the paper.
    let lv = clamp(max(self.level.x, self.level.y), 0.0, 1.05)
    let na = (lv * 2.0 - 1.0) * sw
    let dir = vec2(sin(na), -cos(na))
    let t0 = rr - h * 0.9
    let qs = q - vec2(2.0, 2.0)
    let ts = clamp(dot(qs, dir), t0, rr + 9.0)
    let sd = length(qs - dir * ts)
    dial = dial * (1.0 - (1.0 - smoothstep(0.0, 2.8, sd)) * 0.28 * inside)
    let tn = clamp(dot(q, dir), t0, rr + 9.0)
    let nd = length(q - dir * tn) - mix(0.9, 0.45, clamp((tn - t0) / (rr + 9.0 - t0), 0.0, 1.0))
    dial = mix(dial, vec3(0.05, 0.04, 0.03), 1.0 - smoothstep(-px, px, nd))
    // Glass: a strip of light across the top, a dark rim.
    dial = dial + vec3(1.0, 0.97, 0.9) * (1.0 - smoothstep(0.0, 0.3, u.y)) * 0.08
    let e = min(min(u.x, 1.0 - u.x) * (b.x - a.x), min(u.y, 1.0 - u.y) * h)
    dial = dial * (0.5 + 0.5 * smoothstep(0.0, 6.0, e))
    dial = dial + self.env_spill(vec3(0.0, 0.0, 1.0)) * 0.15
    o = vec4(mix(o.xyz, dial, inside), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- displays: Nixie windows, orange digits behind a hex mesh ----
mod.widgets.HwDisplay.radius = 3
mod.widgets.HwDisplay.draw_bg.ground = #x120c09
mod.widgets.HwDisplay.draw_bg.light_ink = vec4(0.60, 0.62, 0.58, 1.0)
mod.widgets.HwDisplay.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwDisplay.draw_bg.inner = vec4(1.0, 10.0, 0.0, 0.6)
mod.widgets.HwDisplay.draw_bg.spill = vec2(0.9, 0.4)
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let q = p / 4.0
    let s = vec2(1.0, 1.732)
    let a = q - s * floor(q / s) - s * 0.5
    let q2 = q - s * 0.5
    let b = q2 - s * floor(q2 / s) - s * 0.5
    let g = mix(a, b, step(dot(b, b), dot(a, a)))
    let ag = abs(g)
    let hd = max(ag.x * 0.5 + ag.y * 0.866, ag.x)
    let wire = 1.0 - smoothstep(0.04, 0.12, 0.5 - hd)
    return base + vec3(0.07, 0.035, 0.018) * wire
}
mod.widgets.HwDisplayText.draw_text.color = #xff7a2a
mod.widgets.HwDisplayText.draw_text.text_style = theme.font_code{font_size: 10.5}

// ---- the spectrum: a row of IN-9 neon bargraph tubes ----
mod.widgets.HwSpectrum.light = 9.0
// Parts by `self.part` (1 well, 2 rule, 3 slot, 4 bar, 5 peak, 6 midline).
mod.widgets.HwSpectrum.draw_round.pixel = fn() {
    let p = self.pos * self.rect_size
    let s = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    if self.part > 0.5 && self.part < 1.5 {
        // The well: smoked glass behind the tubes.
        let sdf = Sdf2d.viewport(p)
        sdf.box(0.0, 0.0, s.x, s.y, 4.0)
        let v = (self.pos.y - 0.5)
        let haze = vec3(0.06, 0.018, 0.002) * smoothstep(0.1, 0.75, self.pos.y) * (1.0 - smoothstep(0.75, 1.0, self.pos.y))
        sdf.fill(vec4(self.color.xyz * (1.0 - v * 0.3) + haze, self.color.w))
        return sdf.result
    }
    if (self.part > 1.5 && self.part < 2.5) || self.part > 4.5 {
        if self.part < 4.5 || self.part > 5.5 {
            // Graticule rules: dashed, like a printed scale.
            let dash = step(0.5, fract(p.x / 6.0))
            let ra = self.color.w * 1.8 * dash
            return vec4(self.color.xyz * ra, ra)
        }
        // Peak marks: the glowing cathode tip, left behind.
        let c = abs(p.x - s.x * 0.5) / max(s.x * 0.5, 0.5)
        let a = (1.0 - c * c) * 0.9
        return vec4(vec3(1.0, 0.62, 0.30) * a, a)
    }
    let x = abs(p.x - s.x * 0.5) / max(s.x * 0.5, 0.5)
    let base_h = 5.0
    if self.part > 2.5 && self.part < 3.5 {
        // An unlit IN-9 tube: a glass cylinder with a bright rim, a glint
        // down one side, the cathode wire in its axis, a round top and a
        // black socket at the foot.
        let top = clamp(1.0 - (p.y - s.x * 0.5) / max(s.x * 0.5, 0.5), 0.0, 1.0)
        let rr = length(vec2(x, max(top, 0.0)))
        let inside = 1.0 - smoothstep(0.92, 1.0, rr)
        let rim = smoothstep(0.55, 0.95, rr) * inside
        let glint = (1.0 - smoothstep(0.0, 0.12, abs(p.x - s.x * 0.28) / max(s.x, 1.0) * 2.0)) * inside
        let wire = (1.0 - smoothstep(0.0, 0.14, x)) * inside
        let gl = rim * 0.30 + glint * 0.22 + 0.05
        var col = vec3(0.70, 0.64, 0.56) * gl + vec3(0.55, 0.28, 0.12) * wire * 0.25
        var al = clamp(gl + wire * 0.2, 0.0, 1.0) * inside
        let sock = step(s.y - base_h, p.y)
        col = mix(col, vec3(0.13, 0.12, 0.11) * (0.6 + 0.6 * (1.0 - x)) + vec3(0.25, 0.22, 0.2) * (1.0 - smoothstep(0.0, 1.2, p.y - (s.y - base_h))), sock)
        al = mix(al, 1.0, sock)
        return vec4(col * al, al)
    }
    // A lit column of neon: a white-hot core in a saturated orange sheath
    // that fades to the glass, brightest at the glowing end.
    if p.y > s.y - base_h {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let neon = mix(vec3(1.0, 0.27, 0.04), self.color.xyz, 0.15)
    let core = exp(-x * x * 14.0)
    let sheath = exp(-x * x * 4.0)
    let tip = exp(-p.y / 3.0)
    let hot = clamp(core * 0.55 + tip * 0.9, 0.0, 1.0)
    let col = neon * (0.45 + sheath * 0.8) + vec3(1.0, 0.78, 0.50) * hot * 0.5
    let al = clamp(sheath * 0.92 + tip * 0.4 + 0.08, 0.0, 1.0)
    return vec4(col * al, al)
}
mod.widgets.HwSpectrum.draw_line.pixel = fn() {
    // The waveform: an oscilloscope trace with a neon bloom.
    let p = self.pos * self.rect_size
    let a = self.seg_a
    let b = self.seg_b
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let d = length(pa - ba * h)
    let core = 1.0 - smoothstep(0.2, 1.0, d)
    let glow = exp(-d * d / 3.0) * 0.55
    let al = clamp(core + glow, 0.0, 1.0)
    let col = mix(self.color.rgb, vec3(1.0, 0.86, 0.66), core * 0.6)
    return vec4(col * al, al)
}

