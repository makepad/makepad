// ---- chrome lettering: a sky-to-horizon gradient per glyph ----
mod.widgets.HwTitle.draw_text.color = #xe8f4ff
mod.widgets.HwTitle.draw_text.get_color = fn() {
    let y = self.pos.y
    let top = mix(vec3(0.55, 0.85, 1.0), vec3(1.0, 1.0, 1.0), smoothstep(0.15, 0.5, y))
    let bot = mix(vec3(0.30, 0.08, 0.40), vec3(1.0, 0.45, 0.85), smoothstep(0.52, 0.85, y))
    let col = mix(top, bot, step(0.52, y))
    return vec4(col, self.color.w)
}
mod.widgets.HwCaption.draw_text.color = #xff7fd6
mod.widgets.HwCaption.draw_text.text_style = theme.font_bold{font_size: 8.0}
mod.widgets.HwCaption.draw_text.get_color = fn() {
    let y = self.pos.y
    let col = mix(vec3(0.35, 0.95, 1.0), vec3(1.0, 0.35, 0.80), smoothstep(0.3, 0.75, y))
    return vec4(col, self.color.w)
}
mod.widgets.HwText.draw_text.color = #xd9c2ff
mod.widgets.HwPanelTitle.draw_text.color = #xffd0f4
