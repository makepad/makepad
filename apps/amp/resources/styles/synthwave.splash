// Small displays: black glass with a violet cast.
mod.widgets.HwDisplay.radius = 8
mod.widgets.HwDisplay.draw_bg.ground = #x08031a
mod.widgets.HwDisplay.draw_bg.light_ink = vec4(0.80, 0.60, 1.0, 1.0)
mod.widgets.HwDisplay.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwDisplay.draw_bg.inner = vec4(0.90, 9.0, 0.0, 0.55)
mod.widgets.HwDisplay.draw_bg.spill = vec2(0.8, 0.4)
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // Fine phosphor rows and a violet glow along the foot.
    let row = 0.5 + 0.5 * sin(p.y * 3.14159 * 0.8)
    let foot = exp(-(self.rect_size.y - self.inset - p.y) / 8.0)
    return base * (0.9 + 0.2 * row) + vec3(0.30, 0.05, 0.40) * foot * 0.35
}

mod.widgets.HwDropDown.draw_bg.well = vec4(0.05, 0.02, 0.12, 1.0)
mod.widgets.HwDropDown.draw_bg.rim = vec4(1.0, 0.3, 0.8, 0.45)
mod.widgets.HwDropDown.draw_bg.arrow = vec4(0.30, 0.95, 1.0, 1.0)
mod.widgets.HwDropDown.draw_text.color = #xffe3fb
mod.widgets.HwDropDown.draw_text.color_hover = #xffffff
mod.widgets.HwTextInput.draw_bg.well = vec4(0.05, 0.02, 0.12, 1.0)
mod.widgets.HwTextInput.draw_bg.rim = vec4(0.30, 0.95, 1.0, 0.45)
mod.widgets.HwTextInput.draw_text.color = #xffe3fb
mod.widgets.HwSplitter.draw_bg.groove = vec4(0.0, 0.0, 0.0, 0.45)
mod.widgets.HwSplitter.draw_bg.glint = vec4(1.0, 0.30, 0.80, 0.60)
mod.widgets.HwSegmented.draw_pill.glow = vec4(0.25, 0.95, 1.0, 1.0)

// Key legends are printed ink: the switch keys' palette recolouring
// (muted off, accent on) would vanish on the sunset caps, so the lit state
// reads from the LED and the glow instead.
mod.widgets.HwKeyButton.draw_text.get_color = fn() {
    let ink = vec4(0.10, 0.03, 0.20, 1.0).mix(vec4(0.24, 0.06, 0.36, 1.0), self.hover).mix(vec4(0.0, 0.0, 0.0, 1.0), self.down)
    return vec4(ink.rgb, ink.a * (1.0 - self.loading))
}
mod.widgets.HwKeyText.draw_text.get_color = fn() {
    let ink = vec4(0.10, 0.03, 0.20, 1.0).mix(vec4(0.24, 0.06, 0.36, 1.0), self.hover).mix(vec4(0.0, 0.0, 0.0, 1.0), self.down)
    return vec4(ink.rgb, ink.a * (1.0 - self.loading))
}

// ---- the meter: a setting sun whose slats light from the horizon up,
// left channel on the left half, right on the right; beneath it a neon
// floor that brightens with the loudness ----
mod.widgets.HwMeterFace.draw_bg.meter = vec4(0.0, 9.0, 0.9, 0.8)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let a = vec2(7.0, 7.0)
    let b = self.rect_size - a
    let inside = step(a.x, p.x) * step(p.x, b.x) * step(a.y, p.y) * step(p.y, b.y)
    let H = b.y - a.y
    let hy = a.y + H * 0.80
    let cx = self.rect_size.x * 0.5
    let lv = vec2(self.level.x, self.level.y)
    let loud = max(lv.x, lv.y)
    // Sky: black-violet over a magenta horizon haze.
    let sy = clamp((hy - p.y) / max(hy - a.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.42, 0.06, 0.40), vec3(0.03, 0.01, 0.08), smoothstep(0.0, 0.8, sy))
    // The sun: a half disc on the horizon cut into slats.
    let R = H * 0.78
    let q = p - vec2(cx, hy)
    let rq = length(q)
    let disc = (1.0 - smoothstep(R - px, R + px, rq)) * step(p.y, hy)
    let n = max(self.meter.y, 2.0)
    let h = (hy - p.y) / R
    let k = floor(h * n)
    let fr = fract(h * n)
    let gap = 0.34 - (k / n) * 0.30
    let slat = step(gap, fr)
    let row = (k + 0.5) / n
    let side = mix(lv.x, lv.y, step(cx, p.x))
    let on = step(row, side)
    let hot = mix(vec3(1.0, 0.12, 0.60), vec3(1.0, 0.86, 0.30), smoothstep(0.1, 0.95, row))
    let lit = mix(hot * 1.15, vec3(1.0, 1.0, 1.0), 0.12)
    let dim = mix(vec3(0.20, 0.05, 0.26), vec3(0.30, 0.12, 0.22), row)
    let sun = mix(dim, lit, on)
    col = mix(col, sun, disc * slat)
    col = mix(col, dim * 0.6, disc * (1.0 - slat))
    // The glow round the sun follows the louder channel.
    let halo = exp(-max(rq - R, 0.0) / 7.0) * (1.0 - disc) * step(p.y, hy) * (0.15 + 0.6 * loud)
    col = col + vec3(1.0, 0.25, 0.65) * halo * 0.55
    // Wings: each channel's level also streaks outward along the horizon.
    let wy = hy - p.y
    let avail = cx - a.x - R - 2.0
    let beyond = abs(q.x) - R - 2.0
    let w0 = (1.0 - smoothstep(0.5, 1.2, abs(wy - 2.5))) * step(beyond, side * avail)
    let w1 = (1.0 - smoothstep(0.5, 1.2, abs(wy - 7.0))) * step(beyond, side * avail * 0.72)
    let w2 = (1.0 - smoothstep(0.5, 1.2, abs(wy - 11.5))) * step(beyond, side * avail * 0.45)
    let wl = clamp(w0 + w1 * 0.8 + w2 * 0.6, 0.0, 1.0) * step(0.0, beyond)
    col = mix(col, vec3(0.25, 0.95, 1.0), wl * 0.95)
    // The floor: a small perspective grid under the horizon.
    let dy = p.y - hy
    if dy > 0.0 {
        let z = 1.0 / max(dy, 0.5)
        let gx = q.x * z * 0.16
        let ex = (0.5 - abs(fract(gx) - 0.5)) / max(z * 0.16, 0.001)
        let gz = z * 6.0
        let ez = (0.5 - abs(fract(gz) - 0.5)) * dy * dy / 6.0
        let grid = (1.0 - smoothstep(0.3, 1.0, ex)) + (1.0 - smoothstep(0.3, 1.0, ez))
        col = vec3(0.04, 0.01, 0.09) + vec3(1.0, 0.15, 0.70) * clamp(grid, 0.0, 1.0) * (0.25 + 0.75 * loud)
    }
    // The horizon line itself.
    let hl = 1.0 - smoothstep(0.3, 1.0, abs(p.y - hy))
    col = mix(col, vec3(1.0, 0.45, 0.85), hl * 0.9)
    // Glass: a sheen at the top, a dark rim.
    let u = (p - a) / max(b - a, vec2(1.0, 1.0))
    col = col + vec3(0.8, 0.7, 1.0) * (1.0 - smoothstep(0.0, 0.35, u.y)) * 0.06
    let e = min(min(p.x - a.x, b.x - p.x), min(p.y - a.y, b.y - p.y))
    col = col * (0.55 + 0.45 * smoothstep(0.0, 4.0, e))
    o = vec4(mix(o.xyz, col, inside), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- the spectrum: an Outrun sunset behind a wall of neon LED columns ----
// The bars' colour carries their level (Rust mixes the accent toward the
// screen text by 0.1 + 0.35 * level), so each bar can find its own height
// in the picture and light its LED rows by absolute height.
// Parts by `self.part` (1 well, 2 rule, 3 slot, 4 bar, 5 peak, 6 midline).
mod.widgets.HwSpectrum.draw_round = mod.widgets.DrawMusicRound{
    pixel: fn() {
        let p = self.pos * self.rect_size
        let sz = self.rect_size
        let r = min(self.radius, min(sz.x, sz.y) * 0.5)
        let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
        let d = Material.sd_box(p, sz * 0.5, sz * 0.5, r)
        let cov = 1.0 - smoothstep(-px, px, d)
        if self.part > 0.5 && self.part < 1.5 {
            // The well: sky, a striped sun sitting on the bars' baseline,
            // and a neon floor under it where the waveform runs.
            let base = 16.0 + floor((sz.y - 32.0) * 0.68 - 16.0)
            let sky_t = clamp(p.y / max(base, 1.0), 0.0, 1.0)
            var col = mix(vec3(0.03, 0.01, 0.09), vec3(0.24, 0.04, 0.30), sky_t * sky_t)
            let st = step(0.9975, fract(sin(dot(floor(p * 0.5), vec2(12.9898, 78.233))) * 43758.5453)) * (1.0 - sky_t)
            col = col + vec3(0.7, 0.75, 1.0) * st * 0.6
            let R = min(base * 0.82, sz.x * 0.22)
            let q = p - vec2(sz.x * 0.5, base)
            let rq = length(q)
            let h = (base - p.y) / R
            let disc = (1.0 - smoothstep(R - px, R + px, rq)) * step(0.0, h)
            let slat = step(0.42 * (1.0 - smoothstep(0.0, 0.55, h)), fract(h * 9.0))
            var sun = mix(vec3(0.85, 0.06, 0.55), vec3(1.0, 0.30, 0.45), smoothstep(0.0, 0.5, h))
            sun = mix(sun, vec3(1.0, 0.78, 0.35), smoothstep(0.5, 1.0, h))
            col = mix(col, sun * 0.50, disc * slat)
            let halo = exp(-max(rq - R, 0.0) / 26.0) * (1.0 - disc) * step(0.0, h)
            col = col + vec3(0.55, 0.08, 0.40) * halo * 0.30
            let dy = p.y - base
            if dy > 0.0 {
                let spx = dy / 1.1
                let gx = q.x / spx
                let ex = (0.5 - abs(fract(gx) - 0.5)) * spx
                let gz = 260.0 / dy
                let spz = dy * dy / 260.0
                let ez = (0.5 - abs(fract(gz) - 0.5)) * spz
                let lx = (1.0 - smoothstep(0.35, 1.1, ex) + exp(-ex / 2.5) * 0.3) * smoothstep(2.0, 9.0, spx)
                let lz = (1.0 - smoothstep(0.35, 1.1, ez) + exp(-ez / 2.5) * 0.3) * smoothstep(2.0, 9.0, spz)
                let grid = clamp(lx + lz, 0.0, 1.0) * smoothstep(0.0, 10.0, dy)
                col = vec3(0.05, 0.01, 0.10) + vec3(0.9, 0.12, 0.62) * grid * 0.42 + vec3(0.2, 0.8, 1.0) * grid * 0.06
                col = col + vec3(0.55, 0.08, 0.40) * exp(-dy / 10.0) * 0.35
            }
            let hl = 1.0 - smoothstep(0.4, 1.4, abs(p.y - base - 0.5))
            col = mix(col, vec3(1.0, 0.40, 0.85), hl * 0.85)
            return vec4(col * cov, cov)
        }
        if self.part > 3.5 && self.part < 4.5 {
            // A lit bar: LED rows on a 4.5 pt pitch, cyan at the floor
            // through magenta to a sunset orange at full scale.
            let level = clamp(self.level, 0.02, 1.0)
            let hb = (1.0 - self.pos.y) * sz.y
            let f = (1.0 - self.pos.y) * level
            let cell = step(fract(hb / 4.5), 0.70)
            var col = mix(vec3(0.15, 0.90, 1.0), vec3(0.62, 0.30, 1.0), smoothstep(0.0, 0.35, f))
            col = mix(col, vec3(1.0, 0.16, 0.66), smoothstep(0.30, 0.62, f))
            col = mix(col, vec3(1.0, 0.62, 0.20), smoothstep(0.62, 0.92, f))
            let core = 1.0 - abs(self.pos.x - 0.5) * 2.0
            col = col * (0.80 + 0.35 * core)
            let top = 1.0 - smoothstep(0.0, 4.5, p.y)
            col = mix(col, vec3(1.0, 0.95, 1.0), top * 0.55)
            let a = cov * mix(0.10, 1.0, cell)
            return vec4(col * a, a)
        }
        if self.part > 4.5 && self.part < 5.5 {
            // A peak mark: a hot white-cyan tick.
            let a = cov
            return vec4(vec3(0.75, 1.0, 1.0) * a, a)
        }
        if (self.part > 1.5 && self.part < 2.5) || (self.part > 5.5 && self.part < 6.5) {
            // The level rules and the waveform's centre line.
            let a = cov * 0.10
            return vec4(vec3(0.4, 0.8, 1.0) * a, a)
        }
        // An empty slot: the ghost of every LED row.
        let hb = (1.0 - self.pos.y) * sz.y
        let cell = step(fract(hb / 4.5), 0.70)
        let a = cov * cell * 0.10
        return vec4(vec3(0.55, 0.30, 0.90) * a, a)
    }
}
// The waveform: a neon tube, a white-hot core in a pink halo.
mod.widgets.HwSpectrum.draw_line.pixel = fn() {
    let p = self.pos * self.rect_size
    let pa = p - self.seg_a
    let ba = self.seg_b - self.seg_a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let d = length(pa - ba * h)
    let core = 1.0 - smoothstep(0.25, 0.9, d)
    let halo = exp(-d / 1.2) * 0.55
    let col = mix(vec3(1.0, 0.20, 0.72), vec3(1.0, 0.92, 1.0), core * 0.7)
    let a = clamp(core + halo, 0.0, 1.0)
    return vec4(col * a, a)
}
mod.widgets.HwSpectrum.light = 4.0
true

// ---- EQ (HwEqGraph: the graphic equalizer's era look, STYLE_GUIDE "Graphic EQ") ----
mod.widgets.HwEqGraph.draw_fader.fader = vec4(3.0, 0.50, 8.0, 3.0)
mod.widgets.HwEqGraph.draw_fader.track_ink = vec4(0.14, 0.05, 0.22, 1.0)
mod.widgets.HwEqGraph.draw_curve.curve = vec4(0.0, 1.8, 12.0, 0.10)
mod.widgets.HwEqGraph.draw_curve.curve_ink = vec4(0.25, 0.92, 1.0, 1.0)
mod.widgets.HwEqGraph.draw_grid.grid = vec4(0.0, 0.18, 0.40, 0.0)
mod.widgets.HwEqGraph.draw_grid.grid_ink = vec4(1.0, 0.18, 0.66, 1.0)
mod.widgets.HwEqGraph.draw_spectrum.spectrum = vec4(0.20, 1.0, 0.0, 0.0)
mod.widgets.HwEqGraph.light = 1.6
true
