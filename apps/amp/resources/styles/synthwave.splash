// title: Synthwave
// Synthwave — an 80s retro-future synth: a deep indigo body with a neon
// perspective grid receding to a magenta horizon, key caps poured in a
// sunset gradient (orange, pink, magenta) with the striped sun cut through
// them, chrome-gradient lettering, hot pink and electric cyan LEDs, and a
// VHS-sunset bezel round a tube with tracking noise and chroma fringes.
//
// Assignments only, over the base templates in `src/hw.rs`
// (see local/agent_state/skeuomorph/music/STYLE_GUIDE.md).
use mod.prelude.widgets_internal.*

// ---- palette: midnight glass, hot pink selection ----
mod.widgets.hw_palette.screen_bg = #x0c0620
mod.widgets.hw_palette.screen_text = #xffe3fb
mod.widgets.hw_palette.screen_muted = #xa98ad8
mod.widgets.hw_palette.accent = #xff2fa8
mod.widgets.hw_palette.panel_text = #xf8dcff
mod.widgets.hw_palette.panel_muted = #xa88cd6
mod.widgets.hw_palette.menu_bg = #x170a30
mod.widgets.hw_palette.spill_color = #xff4fc8
mod.widgets.hw_palette.spill_mono = 0.0
mod.widgets.hw_palette.spill_knee = 1.4
mod.widgets.hw_palette.caption_bg = #x0e0624
mod.widgets.hw_palette.caption_text = #xffb8ec

// ---- the front: deep indigo, a neon grid receding to the horizon ----
mod.widgets.HwChassis.draw_bg.ground = #x1a0b3d
mod.widgets.HwChassis.draw_bg.light_ink = vec4(0.95, 0.80, 1.0, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.02, 0.0, 0.06, 1.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.18, 0.66, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(2.2, 0.6)
mod.widgets.HwChassis.draw_bg.vignette = vec4(0.5, 0.45, 0.30, 1.10)
mod.widgets.Window.pass.clear_color = #x1a0b3d
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    let hz = 0.40
    // The sky: indigo deepening upward, a magenta haze on the horizon.
    let sky = mix(vec3(0.20, 0.05, 0.36), base * 0.7, clamp((hz - uv.y) / hz, 0.0, 1.0))
    let haze = exp(-abs(uv.y - hz) * 18.0)
    var col = sky + vec3(0.55, 0.08, 0.42) * haze * 0.40
    // Stars.
    let sp = floor(p * 0.5)
    let star = step(0.9965, self.hw_hash(sp)) * step(uv.y, hz - 0.02)
    col = col + vec3(0.8, 0.8, 1.0) * star * 0.55
    // The ground: a neon grid in perspective below the horizon, its
    // lines a constant hairline wide on screen, fading where they crowd.
    let dy = uv.y - hz
    if dy > 0.0 {
        let W = self.rect_size.x
        let H = self.rect_size.y
        let z = 0.10 / dy
        let gx = (uv.x - 0.5) * z * 9.0
        let gz = z * 3.0
        let sx = W / (9.0 * z)
        let sz = dy * dy * H / 0.3
        let ex = (0.5 - abs(fract(gx) - 0.5)) * sx
        let ez = (0.5 - abs(fract(gz) - 0.5)) * sz
        let lx = (1.0 - smoothstep(0.5, 1.4, ex) + exp(-ex / 3.5) * 0.35) * smoothstep(3.0, 14.0, sx)
        let lz = (1.0 - smoothstep(0.5, 1.4, ez) + exp(-ez / 3.5) * 0.35) * smoothstep(3.0, 14.0, sz)
        let fade = smoothstep(0.0, 0.08, dy)
        let floorc = mix(vec3(0.08, 0.02, 0.18), vec3(0.03, 0.01, 0.08), clamp(dy * 1.6, 0.0, 1.0))
        col = floorc + vec3(0.55, 0.08, 0.42) * haze * 0.40
        let grid = clamp(lx + lz, 0.0, 1.2) * fade
        col = col + vec3(1.0, 0.16, 0.72) * grid * 0.70 + vec3(0.2, 0.9, 1.0) * grid * 0.12
    }
    return col
}

// Raised plates: black-violet lacquer, a chrome lip, the sun's stripes
// printed along the foot.
mod.widgets.HwPlate.radius = 12
mod.widgets.HwPlate.draw_bg.ground = #x221047
mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 0.72, 0.96, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.01, 0.0, 0.04, 1.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(2.5, 0.6, 2.5, 0.55)
mod.widgets.HwPlate.draw_bg.finish = vec4(0.55, 0.55, 0.45, 0.2)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.75, 12.0, 1.0, 0.6)
mod.widgets.HwPlate.draw_bg.sheen = vec4(0.05, 0.25, 0.25, 0.4)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.18, 0.66, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(2.4, 0.55)
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    var col = mix(base * 1.15, base * 0.75, uv.y)
    // Sun stripes along the foot: thinning bands, orange to magenta.
    let y = self.rect_size.y - self.inset - p.y
    let stripe = step(0.0, y) * (1.0 - step(22.0, y))
    let t = clamp(y / 22.0, 0.0, 1.0)
    let period = 5.5
    let band = step(0.30 + (1.0 - t) * 0.35, fract(y / period))
    let sun = mix(vec3(1.0, 0.10, 0.55), vec3(1.0, 0.62, 0.18), t)
    col = mix(col, sun, stripe * band * 0.85)
    // Chrome hairline above the stripes.
    let hl = 1.0 - smoothstep(0.0, 1.0, abs(y - 25.0))
    col = mix(col, vec3(0.30, 0.95, 1.0), hl * 0.8)
    return col
}

// Recessed panels: near-black indigo wells, a faint cyan grid.
mod.widgets.HwPanel.radius = 10
mod.widgets.HwPanel.draw_bg.ground = #x0d0622
mod.widgets.HwPanel.draw_bg.light_ink = vec4(0.70, 0.60, 1.0, 1.0)
mod.widgets.HwPanel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.02, 1.0)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.85, 10.0, 0.0, 0.55)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(1.0, 0.18, 0.66, 1.0)
mod.widgets.HwPanel.draw_bg.spill = vec2(1.8, 0.5)
mod.widgets.HwPanel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    let g = abs(fract(w / 24.0) - vec2(0.5, 0.5))
    let line = 1.0 - smoothstep(0.0, 0.03, 0.5 - max(g.x, g.y))
    return base + vec3(0.10, 0.35, 0.55) * line * 0.18
}

// The screen's surround: a VHS-box sunset — striped sun bands falling
// from orange to magenta to violet, a chrome rim on the lip.
mod.widgets.HwBezel.radius = 16
mod.widgets.HwBezel.draw_bg.ground = #x14082c
mod.widgets.HwBezel.draw_bg.light_ink = vec4(1.0, 0.80, 0.95, 1.0)
mod.widgets.HwBezel.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.02, 1.0)
mod.widgets.HwBezel.draw_bg.relief = vec4(3.0, 0.8, 2.5, 0.8)
mod.widgets.HwBezel.draw_bg.inner = vec4(0.90, 12.0, 0.0, 0.55)
mod.widgets.HwBezel.draw_bg.glow_ink = vec4(1.0, 0.18, 0.66, 1.0)
mod.widgets.HwBezel.draw_bg.spill = vec2(0.9, 0.4)
mod.widgets.HwBezel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    let t = uv.y
    let c0 = vec3(1.0, 0.78, 0.22)
    let c1 = vec3(1.0, 0.36, 0.30)
    let c2 = vec3(0.96, 0.10, 0.58)
    let c3 = vec3(0.38, 0.06, 0.62)
    var sun = mix(c0, c1, smoothstep(0.0, 0.35, t))
    sun = mix(sun, c2, smoothstep(0.30, 0.65, t))
    sun = mix(sun, c3, smoothstep(0.60, 1.0, t))
    // Horizontal cuts thicken toward the bottom like the sun's slats.
    let period = 11.0
    let cut = step(1.0 - t * 0.55, fract(p.y / period) + 0.05)
    var col = mix(sun * 0.95, base, cut)
    // Chrome rim round the outer lip.
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let rim = smoothstep(0.0, 0.8, e) * (1.0 - smoothstep(2.6, 3.4, e))
    let chrome = mix(vec3(0.95, 0.97, 1.0), vec3(0.40, 0.30, 0.60), uv.y)
    col = mix(col, chrome, rim)
    return col
}

// The tube: VHS — soft scanlines, a chroma fringe at the edges, a tracking
// band near the foot, a violet reflection.
// No dark rim or bulge over the picture: it reads clean and bright.
mod.widgets.HwGlass.draw_bg.glass = vec4(0.10, 0.08, 0.0, 0.0)
mod.widgets.HwGlass.draw_bg.tint = vec4(0.85, 0.55, 1.0, 0.0)
mod.widgets.HwGlass.draw_bg.radius = 12.0
mod.widgets.HwGlass.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, self.radius)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let cov = 1.0 - smoothstep(-px, px, d)
    // A CRT's rows: fine, even, with the screen filter only.
    let line = 0.5 + 0.5 * sin(p.y * 3.14159 * self.draw_pass.dpi_factor)
    let q = (self.pos - vec2(0.5, 0.5)) * 2.0
    let bulge = clamp(dot(q * q, q * q) * self.glass.w, 0.0, 1.0)
    let edge = smoothstep(-34.0, 0.0, d) * self.glass.z
    let dark = clamp(line * self.glass.x * self.filter_on + edge + bulge, 0.0, 0.95)
    // Chroma fringe: cyan on the left edge, magenta on the right.
    let fl = exp(-p.x / 10.0) * 0.28
    let fr = exp(-(self.rect_size.x - p.x) / 10.0) * 0.28
    let r = smoothstep(0.55, 0.0, self.pos.y + (self.pos.x - 0.5) * 0.3) * self.glass.y
    let rgb = self.tint.xyz * r + vec3(0.2, 0.95, 1.0) * fl + vec3(1.0, 0.15, 0.7) * fr
    let add = clamp(r + fl + fr, 0.0, 1.0)
    let a = clamp(add + dark * (1.0 - add), 0.0, 1.0)
    return vec4(rgb, a) * cov
}
mod.widgets.HwGlass.draw_bg.hw_hash = fn(q: vec2) -> float {
    return fract(sin(dot(q, vec2(12.9898, 78.233))) * 43758.5453)
}

// ---- keys: sunset caps, the sun's slats cut through ----
mod.widgets.HwKey.radius = 7
mod.widgets.HwKey.draw_bg.ground = #xff5a8a
mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 0.92, 0.80, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.12, 0.0, 0.18, 1.0)
mod.widgets.HwKey.draw_bg.relief = vec4(3.0, 0.7, 3.0, 0.45)
mod.widgets.HwKey.draw_bg.finish = vec4(0.55, 0.45, 0.45, 0.3)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.75, 7.0, 1.0, 0.7)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(0.20, 0.95, 1.0, 1.0)
mod.widgets.HwKey.draw_bg.inner = vec4(0.72, 9.0, 0.0, 0.30)
mod.widgets.HwKey.draw_bg.spill = vec2(2.2, 0.45)
mod.widgets.HwKey.draw_bg.led = vec4(7.0, 7.0, 2.2, 1.0)
mod.widgets.HwKey.draw_bg.led_off = vec4(0.25, 0.05, 0.25, 1.0)
mod.widgets.HwKey.draw_bg.critical_ink = vec4(0.25, 0.95, 1.0, 0.0)
mod.widgets.HwKey.emissive = vec4(0.20, 0.95, 1.0, 1.4)
mod.widgets.HwKey.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    let t = clamp((p.y - self.inset) / max(self.rect_size.y - self.inset * 2.0, 1.0), 0.0, 1.0)
    let c0 = vec3(1.0, 0.80, 0.26)
    let c1 = vec3(1.0, 0.40, 0.32)
    let c2 = vec3(0.94, 0.12, 0.56)
    let c3 = vec3(0.55, 0.07, 0.62)
    var col = mix(c0, c1, smoothstep(0.0, 0.40, t))
    col = mix(col, c2, smoothstep(0.35, 0.75, t))
    col = mix(col, c3, smoothstep(0.72, 1.0, t))
    // The sun's slats in the lower half.
    let sy = (t - 0.55) / 0.45
    let slat = step(0.0, sy) * step(1.0 - sy * 0.55, fract(sy * 4.0) + 0.02)
    col = mix(col, vec3(0.16, 0.05, 0.30), slat * 0.85)
    return col
}
