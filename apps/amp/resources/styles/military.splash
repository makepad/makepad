mod.widgets.HwDisplay.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    // A segment readout's glass: a faint phosphor-green cell grid.
    let f = fract(p / vec2(3.0, 3.0))
    let cell = step(0.25, f.x) * step(0.25, f.y)
    return base + vec3(0.010, 0.030, 0.008) * cell
}
