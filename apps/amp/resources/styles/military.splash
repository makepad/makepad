// Military — hardened field equipment: an olive-drab powder-coated front with
// rubber bumpers at the corners, gunmetal plates, recessed guarded keys,
// hazard-striped edges on the control wings, night-vision green lights and a
// green segment-style readout on the displays.
use mod.prelude.widgets_internal.*

// ---- palette: phosphor-green lists and bars ----
mod.widgets.hw_palette.screen_bg = #x0a0e0a
mod.widgets.hw_palette.screen_text = #xb8f5a8
mod.widgets.hw_palette.screen_muted = #x5f8f58
mod.widgets.hw_palette.accent = #x5dff4a
// The device's floor is dark: display type sits on it bare.
mod.widgets.hw_palette.dark_floor = 1.0

// ---- the front: olive-drab powder coat, rubber bumpers at the corners ----
mod.widgets.HwChassis.draw_bg.ground = #x4a4f33
mod.widgets.HwChassis.draw_bg.light_ink = vec4(0.86, 0.88, 0.74, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.06, 0.07, 0.04, 1.0)
mod.widgets.HwChassis.draw_bg.pattern = vec4(4.0, 1.2, 0.20, 0.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(0.36, 1.0, 0.29, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(1.4, 0.6)
mod.widgets.HwChassis.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    var col = self.surface(p, self.ground.xyz)
    col = col * (1.0 + (self.hw_hash(floor(self.world.xy * 1.3)) - 0.5) * 0.06)
    let v = length((self.pos - vec2(0.5, 0.35)) * vec2(0.9, 1.3))
    col = col * (1.06 - 0.26 * v * v)
    // Rubber bumpers: a moulded black block over each corner.
    let s = self.rect_size
    let cq = min(p, s - p)
    // A moulded rubber block over each corner.
    let bq = cq - vec2(40.0, 40.0)
    let bd = length(max(bq, vec2(0.0, 0.0))) + min(max(bq.x, bq.y), 0.0) - 8.0
    let bump = 1.0 - smoothstep(-0.8, 0.8, bd)
    let rn = clamp(-bd / 8.0, 0.0, 1.0)
    let ridge = smoothstep(0.35, 0.65, 0.5 + 0.5 * sin((cq.x + cq.y) * 0.7))
    var rub = vec3(0.055, 0.056, 0.052) * (0.7 + 0.5 * rn) * (0.8 + 0.35 * ridge)
    rub = rub + vec3(0.30, 0.31, 0.28) * (1.0 - smoothstep(0.0, 1.8, abs(bd + 1.8))) * 0.55
    // A bolt through the corner block.
    let bolt = length(cq - vec2(17.0, 17.0))
    rub = mix(rub, vec3(0.42, 0.43, 0.40) * (1.25 - bolt * 0.09), 1.0 - smoothstep(4.0, 5.0, bolt))
    let lip = (1.0 - smoothstep(0.0, 10.0, bd)) * (1.0 - bump) * 0.65
    col = col * (1.0 - lip)
    col = mix(col, rub, bump)
    col = col * (1.0 - self.env_ao(0.0)) + self.env_spill(vec3(0.0, 0.0, 1.0))
    return vec4(col + self.dither(), 1.0)
}
mod.widgets.Window.pass.clear_color = #x3c402a

// Raised plates: gunmetal, bolted, a hazard band round the edge.
mod.widgets.HwPlate.draw_bg.ground = #x3a3d3c
mod.widgets.HwPlate.draw_bg.light_ink = vec4(0.80, 0.83, 0.80, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.02, 0.02, 0.02, 1.0)
mod.widgets.HwPlate.draw_bg.pattern = vec4(7.0, 1.0, 0.0, 0.0)
mod.widgets.HwPlate.draw_bg.pattern_ink = vec4(0.95, 0.74, 0.08, 1.0)
mod.widgets.HwPlate.draw_bg.pattern_seam = vec4(18.0, 7.0, 1.0, 2.5)
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Powder-coated gunmetal: soft cells and fine speckle.
    let n = self.hw_noise(w * 0.3) * 0.6 + self.hw_noise(w * 0.8) * 0.4
    var col = base * (1.0 + (n - 0.5) * 0.18)
    col = col * (1.0 + (self.hw_hash(floor(w * 1.6)) - 0.5) * 0.08)
    // Hazard band: yellow and black diagonals in the edge band.
    let band = self.pattern_seam.y
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    let inb = 1.0 - smoothstep(band - 0.6, band + 0.6, e)
    let t = fract((w.x + w.y) / max(self.pattern_seam.x, 2.0))
    let st = smoothstep(0.47, 0.53, t) * (1.0 - smoothstep(0.97, 1.0, t)) + (1.0 - smoothstep(0.0, 0.03, t))
    let chip = step(0.86, self.hw_noise(w * 0.25))
    let stripe = mix(vec3(0.06, 0.06, 0.05), self.pattern_ink.xyz, st) * (0.9 + 0.2 * self.hw_hash(floor(w * 2.0)))
    col = mix(col, stripe, inb * (1.0 - chip * 0.7))
    // A screw head inside each corner of the band.
    let cq = min(p, self.rect_size - p) - vec2(self.inset, self.inset)
    let sd = length(cq - vec2(band + 7.0, band + 7.0))
    let screw = 1.0 - smoothstep(3.2, 4.2, sd)
    let slot = (1.0 - smoothstep(0.4, 1.0, abs((cq.x - cq.y) * 0.707))) * screw
    col = mix(col, vec3(0.50, 0.52, 0.50) * (1.2 - sd * 0.12), screw)
    col = mix(col, vec3(0.08, 0.08, 0.08), slot)
    return col
}
