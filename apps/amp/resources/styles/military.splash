// ---- keys: recessed, guarded gunmetal caps with stencil glyphs ----
mod.widgets.HwKey.depth = 1.6
mod.widgets.HwKey.press = -2.6
mod.widgets.HwKey.radius = 4
mod.widgets.HwKey.draw_bg.ground = #x2d302e
mod.widgets.HwKey.draw_bg.light_ink = vec4(0.78, 0.80, 0.74, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwKey.draw_bg.pattern = vec4(4.0, 0.7, 0.16, 0.0)
mod.widgets.HwKey.draw_bg.relief = vec4(2.4, 0.4, 1.6, 0.20)
mod.widgets.HwKey.draw_bg.finish = vec4(0.7, 0.3, 0.08, 0.9)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.75, 5.0, 1.0, 0.75)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(0.36, 1.0, 0.29, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(2.0, 0.6)
// The guard: a gunmetal frame standing round each cap.
mod.widgets.HwKey.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    var o = self.layer(self.key_face(p, self.ground.xyz))
    if self.mech.x > 0.5 {
        o = self.mech_key()
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let d = self.sd(p)
    let c = self.rect_size * 0.5
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y))
    let g = smoothstep(2.4 - px, 2.4 + px, d) * (1.0 - smoothstep(-px, px, 1.2 - e))
    let lt = normalize(self.light.xy + vec2(0.000001, 0.000001))
    let side = dot(normalize(p - c + vec2(0.0001, 0.0001)), -lt)
    let gcol = vec3(0.20, 0.215, 0.20) * (0.8 + 0.45 * side) + self.env_spill(vec3(0.0, 0.0, 1.0)) * 0.5
    let groove = 1.0 - smoothstep(0.0, 1.4, abs(d - 3.2))
    let gc = gcol * (1.0 - groove * 0.5)
    o = vec4(gc * g, g) + o * (1.0 - g)
    o = self.key_marks(o, p)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
