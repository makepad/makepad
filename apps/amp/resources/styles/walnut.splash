// Smoked amber dial glass: a warm reflection, a darker rim.
// No dark rim or bulge over the picture: it reads clean and bright.
mod.widgets.HwGlass.draw_bg.glass = vec4(0.0, 0.09, 0.0, 0.0)
mod.widgets.HwGlass.draw_bg.tint = vec4(1.0, 0.78, 0.45, 0.16)
mod.widgets.HwGlass.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let d = Material.sd_box(p, c, c, self.radius)
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let cov = 1.0 - smoothstep(-px, px, d)
    // Smoked glass: a darker rim, a warm reflection sheet at the top.
    let edge = smoothstep(-34.0, 0.0, d) * self.glass.z
    let r = smoothstep(0.62, 0.0, self.pos.y + (self.pos.x - 0.5) * 0.25) * self.glass.y
    // The dial lamps: an amber glow creeping in from the rim (additive).
    let lamp = smoothstep(-60.0, 0.0, d) * (0.6 + 0.4 * smoothstep(0.3, 1.0, self.pos.y)) * self.tint.w
    let rgb = self.tint.xyz * r + vec3(1.0, 0.55, 0.15) * lamp
    let a = r + edge * (1.0 - r)
    return vec4(rgb * cov, a * cov)
}

