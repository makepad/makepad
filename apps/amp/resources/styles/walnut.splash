// Walnut & Brass — a 1970s hi-fi receiver: a brushed-brass faceplate set in
// an oiled walnut cabinet (the frame round the front), walnut-lined wells for
// the lists, dark bronze keys with brass legends, a knurled brass knob, a
// backlit amber VU needle, and a smoked amber dial glass over the picture.
use mod.prelude.widgets_internal.*

// ---- palette: a warm amber dial ----
mod.widgets.hw_palette.screen_bg = #x140d07
mod.widgets.hw_palette.screen_text = #xf3dcae
mod.widgets.hw_palette.screen_muted = #xa88a60
mod.widgets.hw_palette.accent = #xffa338

// ---- the front: brushed brass inside an oiled walnut frame ----
mod.widgets.HwChassis.draw_bg.ground = #xa9843c
mod.widgets.HwChassis.draw_bg.light_ink = vec4(1.0, 0.93, 0.74, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.22, 0.13, 0.05, 1.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(1.0, 0.62, 0.20, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(2.8, 0.6)
mod.widgets.HwChassis.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    // Brass: long streaks along x, row by row.
    let row = floor(w.y * 1.5)
    let streak = self.hw_noise(vec2(w.x * 0.012 + row * 7.13, row * 0.37))
    let fine = self.hw_hash(vec2(row, floor(w.x * 0.25)))
    var brass = base * (1.0 + (streak - 0.5) * 0.24 + (fine - 0.5) * 0.08)
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    let t = uv.x + (uv.y - 0.5) * 0.4 - 0.32
    brass = brass + vec3(1.0, 0.9, 0.6) * exp(-(t * t) / 0.05) * 0.10
    // Walnut: warped grain along x, dark late wood, open pores.
    let q = w
    let warp = self.hw_noise(q * vec2(0.005, 0.03)) * 16.0 + self.hw_noise(q * vec2(0.03, 0.2)) * 2.0
    let ring = fract((q.y + warp) * 0.085)
    let late = smoothstep(0.45, 0.95, ring)
    let fig = self.hw_noise(q * vec2(0.008, 0.12))
    var wood = mix(vec3(0.40, 0.235, 0.12), vec3(0.15, 0.075, 0.035), late * 0.85) * (0.82 + 0.36 * fig)
    wood = wood * (1.0 - step(0.9, self.hw_hash(floor(q * vec2(0.4, 2.5)))) * 0.3)
    // The cabinet frame round the faceplate, with a dark brass-to-wood reveal.
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y))
    let fw = 9.0
    let inwood = 1.0 - smoothstep(fw - 0.6, fw + 0.6, e)
    let reveal = (1.0 - smoothstep(0.0, 1.6, abs(e - fw - 1.0))) * 0.55
    let roundness = smoothstep(0.0, fw, e) * (1.0 - smoothstep(fw * 0.5, fw, e))
    wood = wood * (0.78 + 0.35 * roundness)
    var col = mix(brass, wood, inwood)
    col = col * (1.0 - reveal * (1.0 - inwood))
    return col
}
mod.widgets.Window.pass.clear_color = #x2a170b

// Raised plates: polished brass escutcheons, a warmer sheen.
mod.widgets.HwPlate.draw_bg.ground = #xbf9a52
mod.widgets.HwPlate.draw_bg.light_ink = vec4(1.0, 0.95, 0.78, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.18, 0.10, 0.03, 1.0)
mod.widgets.HwPlate.draw_bg.pattern = vec4(1.0, 1.0, 0.20, 1.0)
mod.widgets.HwPlate.draw_bg.sheen = vec4(0.14, 0.22, 0.30, 0.45)
mod.widgets.HwPlate.draw_bg.relief = vec4(1.8, 0.85, 2.0, 0.60)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.55, 9.0, 1.0, 0.5)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(1.0, 0.62, 0.20, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(3.0, 0.5)

// Recessed wells: lined with oiled walnut.
mod.widgets.HwPanel.draw_bg.ground = #x5a3519
mod.widgets.HwPanel.draw_bg.light_ink = vec4(1.0, 0.86, 0.62, 1.0)
mod.widgets.HwPanel.draw_bg.shadow_ink = vec4(0.06, 0.03, 0.01, 1.0)
mod.widgets.HwPanel.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let q = self.world.xy
    let warp = self.hw_noise(q * vec2(0.004, 0.02)) * 22.0 + self.hw_noise(q * vec2(0.025, 0.15)) * 2.5
    let ring = fract((q.y + warp) * 0.12)
    let late = smoothstep(0.35, 0.95, ring) * (0.5 + 0.5 * self.hw_noise(q * vec2(0.02, 0.3)))
    let fig = self.hw_noise(q * vec2(0.006, 0.06)) * 0.6 + self.hw_noise(q * vec2(0.02, 0.25)) * 0.4
    var wood = mix(vec3(0.25, 0.14, 0.07), vec3(0.12, 0.06, 0.027), late * 0.6) * (0.80 + 0.36 * fig)
    wood = wood * (1.0 - step(0.9, self.hw_hash(floor(q * vec2(0.4, 2.5)))) * 0.3)
    let uv = p / max(self.rect_size, vec2(1.0, 1.0))
    let t = uv.x + (uv.y - 0.5) * 0.3 - 0.3
    return wood + vec3(1.0, 0.8, 0.5) * exp(-(t * t) / 0.08) * 0.04
}
mod.widgets.HwPanel.draw_bg.inner = vec4(0.85, 9.0, 0.0, 0.55)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(1.0, 0.62, 0.20, 1.0)
