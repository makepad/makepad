mod.widgets.HwKnobFace.draw_bg.shadow_ink = vec4(0.14, 0.08, 0.02, 1.0)
mod.widgets.HwKnobFace.draw_bg.pattern = vec4(1.0, 1.0, 0.10, 1.0)
