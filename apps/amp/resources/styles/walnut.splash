// ---- the meter's bar form (a pocket player): a backlit amber strip under
// a printed scale, each channel's level a dark needle tip riding on it ----
mod.widgets.HwMeterBarFace.draw_bg.ground = #x1a0f07
mod.widgets.HwMeterBarFace.draw_bg.glow_ink = vec4(1.0, 0.68, 0.30, 1.0)
mod.widgets.HwMeterBarFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let pad = vec2(5.0, 3.0)
    let w = max(self.rect_size.x - pad.x * 2.0, 1.0)
    let h = max(self.rect_size.y - pad.y * 2.0, 1.0)
    let u = (p.x - pad.x) / w
    let v = (p.y - pad.y) / h
    let inside = step(0.0, u) * step(u, 1.0) * step(0.0, v) * step(v, 1.0)
    // The lamp behind the dial card: brightest in the middle.
    let lamp = 0.55 + 0.45 * (1.0 - pow(abs(u - 0.5) * 2.0, 2.0))
    var col = self.glow_ink.xyz * lamp * mix(0.55, 1.0, 1.0 - abs(v - 0.5) * 1.4)
    // The printed scale: a tick each tenth, the last fifth in red.
    let tick = 1.0 - smoothstep(0.0, px * 1.3, abs(fract(u * 10.0 + 0.5) - 0.5) * w / 10.0)
    col = mix(col, vec3(0.22, 0.12, 0.05), tick * step(0.62, v) * 0.8)
    col = mix(col, vec3(0.75, 0.16, 0.08), step(0.8, u) * step(0.78, v) * 0.7)
    // Two needle tips, left above right.
    let lane = step(0.5, v)
    let lv = mix(self.level.x, self.level.y, lane)
    let ly = mix(0.26, 0.74, lane)
    let tip = max(abs(u - lv) * w - (1.0 - abs(v - ly) * 4.0) * 2.2, abs(v - ly) * h - 3.0)
    col = mix(col, vec3(0.10, 0.05, 0.02), (1.0 - smoothstep(-px, px, tip)) * step(0.01, lv))
    o = mix(o, vec4(col, 1.0), inside)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
true
