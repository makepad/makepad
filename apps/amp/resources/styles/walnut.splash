mod.widgets.HwEqGraph.draw_fader.cap_ink = vec4(0.90, 0.78, 0.52, 1.0)
mod.widgets.HwEqGraph.draw_fader.track_ink = vec4(0.05, 0.03, 0.02, 1.0)
