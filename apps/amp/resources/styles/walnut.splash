// ---- meter: a backlit amber VU dial with a needle ----
mod.widgets.HwMeterFace.draw_bg.ground = #x1a1109
mod.widgets.HwMeterFace.draw_bg.meter = vec4(1.0, 16.0, 0.8, 0.95)
mod.widgets.HwMeterFace.draw_bg.dial_ink = vec4(1.0, 0.72, 0.30, 1.0)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(1.0, 0.62, 0.20, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(1.0, 0.25, 0.10, 1.0)
mod.widgets.HwMeterFace.draw_bg.led_off = vec4(0.12, 0.08, 0.04, 1.0)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let a = vec2(7.0, 7.0)
    let b = self.rect_size - a
    let inside = step(a.x, p.x) * step(p.x, b.x) * step(a.y, p.y) * step(p.y, b.y)
    let u = (p - a) / max(b - a, vec2(1.0, 1.0))
    // The lamp behind the dial: brightest low in the middle.
    let lamp = 1.05 - 0.6 * length((u - vec2(0.5, 0.9)) * vec2(0.9, 1.2))
    var dial = self.dial_ink.xyz * clamp(lamp, 0.3, 1.0)
    // The printed scale: an arc, eleven ticks, a red zone.
    let h = b.y - a.y
    let piv = vec2(self.rect_size.x * 0.5, b.y + h * 0.6)
    let q = p - piv
    let rq = length(q)
    let ang = atan2(q.x, -q.y)
    let rr = piv.y - a.y - h * 0.30
    let sweep = step(abs(ang), 0.8)
    let arc = (1.0 - smoothstep(0.35, 0.35 + px, abs(rq - rr))) * sweep
    let tk = abs(fract((ang + 0.8) / 0.16 + 0.5) - 0.5) * 0.16 * rq
    let tick = (1.0 - smoothstep(0.45, 0.45 + px, tk)) * step(rr - 5.0, rq) * step(rq, rr) * sweep
    let red = step(0.36, ang) * sweep * step(rr, rq) * step(rq, rr + 3.0)
    dial = mix(dial, vec3(0.16, 0.08, 0.03), clamp(arc + tick, 0.0, 1.0) * 0.9)
    dial = mix(dial, vec3(0.78, 0.13, 0.05), red)
    // The needle, with a soft shadow on the dial.
    let lv = max(self.level.x, self.level.y)
    let na = (lv - 0.5) * 1.6
    let dir = vec2(sin(na), -cos(na))
    let qs = q - vec2(1.5, 1.5)
    let ts = clamp(dot(qs, dir), 0.0, rr + 4.0)
    let sd = length(qs - dir * ts)
    dial = dial * (1.0 - (1.0 - smoothstep(0.0, 2.5, sd)) * 0.25)
    let t = clamp(dot(q, dir), 0.0, rr + 4.0)
    let nd = length(q - dir * t) - 0.6
    dial = mix(dial, vec3(0.08, 0.04, 0.02), 1.0 - smoothstep(-px, px, nd))
    // Glass over the dial: a sheen at the top, a dark rim.
    dial = dial + vec3(1.0, 0.95, 0.85) * (1.0 - smoothstep(0.0, 0.45, u.y)) * 0.10
    let e = min(min(u.x, 1.0 - u.x) * (b.x - a.x), min(u.y, 1.0 - u.y) * h)
    dial = dial * (0.55 + 0.45 * smoothstep(0.0, 5.0, e))
    o = vec4(mix(o.xyz, dial, inside), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
