mod.widgets.HwNavButton.draw_text.color_hover = #xffffff
mod.widgets.HwNavButton.draw_bg.plate = vec4(0.08, 0.94, 1.0, 0.04)
mod.widgets.HwNavButton.draw_bg.plate_hover = vec4(1.0, 0.12, 0.72, 0.14)
mod.widgets.HwNavButton.draw_bg.rim = vec4(0.08, 0.94, 1.0, 0.18)
mod.widgets.HwDisplayText.draw_text.color = #x14f0ff
mod.widgets.HwDisplayText.draw_text.text_style = theme.font_code{font_size: 10.0}

// Small displays: the progress strip, the equalizer. Black, a dot matrix.
mod.widgets.HwDisplay.radius = 10
mod.widgets.HwDisplay.draw_bg.ground = #x05060a
mod.widgets.HwDisplay.draw_bg.light_ink = vec4(0.6, 0.85, 1.0, 1.0)
mod.widgets.HwDisplay.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwDisplay.draw_bg.inner = vec4(1.0, 10.0, 0.0, 0.6)
mod.widgets.HwDisplay.draw_bg.spill = vec2(0.8, 0.4)
mod.widgets.HwDisplay.draw_bg.sd = fn(p: vec2) -> float {
    let c = self.rect_size * 0.5
    let h = max(c - vec2(self.inset, self.inset), vec2(0.5, 0.5))
    let s = p - c
    let q = abs(s) - h
    let box = length(max(q, vec2(0.0, 0.0))) + min(max(q.x, q.y), 0.0)
    let k = mix(self.radius * 0.3, self.radius, step(0.0, s.x * s.y))
    return max(box, (q.x + q.y + min(k, min(h.x, h.y))) * 0.7071)
}
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let f = fract(p / vec2(3.0, 3.0)) - vec2(0.5, 0.5)
    let dotm = 1.0 - smoothstep(0.18, 0.32, length(f))
    return base + vec3(0.0, 0.035, 0.045) * dotm
}

// Choosers and fields: black glass, cyan rim, magenta arrow.
mod.widgets.HwDropDown.draw_bg.well = vec4(0.02, 0.025, 0.035, 1.0)
mod.widgets.HwDropDown.draw_bg.rim = vec4(0.08, 0.94, 1.0, 0.45)
mod.widgets.HwDropDown.draw_bg.arrow = vec4(1.0, 0.16, 0.74, 1.0)
mod.widgets.HwDropDown.draw_text.color = #xc8faff
mod.widgets.HwDropDown.draw_text.color_hover = #xffffff
mod.widgets.HwTextInput.draw_bg.well = vec4(0.02, 0.025, 0.035, 1.0)
mod.widgets.HwTextInput.draw_bg.rim = vec4(0.08, 0.94, 1.0, 0.45)
mod.widgets.HwTextInput.draw_text.color = #xe6fbff

// The switches: a black slot, a magenta cap with a cyan light.
mod.widgets.HwSegmented.draw_bg.well = vec4(0.02, 0.025, 0.035, 1.0)
mod.widgets.HwSegmented.draw_bg.rim = vec4(0.08, 0.94, 1.0, 0.40)
mod.widgets.HwSegmented.draw_pill.cap = vec4(1.0, 0.12, 0.72, 0.30)
mod.widgets.HwSegmented.draw_pill.glow = vec4(0.10, 0.95, 1.0, 1.0)
mod.widgets.HwSegmented.draw_text.color = #x7f97ab
mod.widgets.HwSegmented.draw_text_selected.color = #xffffff

// Chamfered fields: the same cut as the plates, a magenta tick at the left.
mod.widgets.HwDropDown.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let q = abs(s) - (sz * 0.5 - vec2(0.5, 0.5))
    let k = mix(2.5, 8.0, step(0.0, s.x * s.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let top = 1.0 - smoothstep(0.0, 6.0, p.y) * 0.5
    var col = self.well.xyz * top
    let rim = 1.0 - smoothstep(0.3, 1.0, abs(d + 0.6))
    col = mix(col, self.rim.xyz, rim * self.rim.w)
    let x = sz.x - 13.0
    let y = sz.y * 0.5
    let a1 = vec2(x - 3.5, y - 1.8)
    let b1 = vec2(x, y + 1.8)
    let a2 = vec2(x + 3.5, y - 1.8)
    let pa = p - a1
    let ba = b1 - a1
    let d1 = length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0))
    let pb = p - a2
    let bb = b1 - a2
    let d2 = length(pb - bb * clamp(dot(pb, bb) / dot(bb, bb), 0.0, 1.0))
    let ar = 1.0 - smoothstep(0.35, 0.35 + px * 1.5, min(d1, d2))
    col = mix(col, self.arrow.xyz, ar * self.arrow.w)
    return vec4(col * cov, cov * self.well.w)
}
mod.widgets.HwTextInput.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let q = abs(s) - (sz * 0.5 - vec2(0.5, 0.5))
    let k = mix(2.5, 9.0, step(0.0, s.x * s.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let top = 1.0 - smoothstep(0.0, 7.0, p.y) * 0.5
    var col = self.well.xyz * top
    let rim = 1.0 - smoothstep(0.3, 1.0, abs(d + 0.6))
    col = mix(col, self.rim.xyz, rim * self.rim.w)
    return vec4(col * cov, cov * self.well.w)
}
mod.widgets.HwSegmented.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let q = abs(s) - (sz * 0.5 - vec2(0.5, 0.5))
    let k = mix(2.5, 9.0, step(0.0, s.x * s.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let top = 1.0 - smoothstep(0.0, 7.0, p.y) * 0.5
    var col = self.well.xyz * top
    let rim = 1.0 - smoothstep(0.3, 1.0, abs(d + 0.6))
    col = mix(col, self.rim.xyz, rim * self.rim.w)
    return vec4(col * cov, cov * self.well.w)
}
mod.widgets.HwSegmented.draw_pill.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let s = p - sz * 0.5
    let q = abs(s) - (sz * 0.5 - vec2(2.5, 2.5))
    let k = mix(2.0, 7.0, step(0.0, s.x * s.y))
    let d = max(max(q.x, q.y), (q.x + q.y + k) * 0.7071)
    let cov = 1.0 - smoothstep(-px, px, d)
    let shade = mix(1.25, 0.75, self.pos.y)
    let rim = 1.0 - smoothstep(0.3, 1.0, abs(d + 0.6))
    var col = self.cap.xyz * shade * 0.8
    col = mix(col, self.cap.xyz * 1.2, rim)
    let dash = (1.0 - smoothstep(0.0, 1.2, abs(p.y - (sz.y - 5.0)))) * step(8.0, p.x) * step(p.x, sz.x - 8.0)
    let a = cov * clamp(self.cap.w * 1.6 + rim * 0.6, 0.0, 1.0)
    return vec4(col * a, a) * (1.0 - dash) + vec4(self.glow.xyz * dash, dash)
}
mod.widgets.HwMenuLayer.draw_bg.border_color = vec4(0.08, 0.94, 1.0, 0.5)

mod.widgets.HwArtBlank.draw_bg.vinyl = vec4(0.03, 0.035, 0.045, 1.0)
mod.widgets.HwArtBlank.draw_bg.label_ink = vec4(1.0, 0.12, 0.72, 1.0)

mod.widgets.HwSplitter.draw_bg.groove = vec4(0.0, 0.0, 0.0, 0.5)
mod.widgets.HwSplitter.draw_bg.glint = vec4(0.08, 0.94, 1.0, 0.35)
true

