mod.widgets.HwKeyText.draw_text.color_hover = #x1e0c04
mod.widgets.HwKeyText.draw_text.color_down = #x8a2a10
mod.widgets.HwKeyText.draw_text.color_focus = #x3a1c0c

// ---- lamps: pilot-light orange ----
mod.widgets.HwDash.emissive = vec4(1.0, 0.5, 0.12, 6.0)
mod.widgets.HwDash.draw_bg.glow_ink = vec4(1.0, 0.55, 0.16, 1.0)
mod.widgets.HwDash.draw_bg.ground = #x2a1208
mod.widgets.HwLed.emissive = vec4(1.0, 0.5, 0.12, 3.5)
mod.widgets.HwLed.draw_bg.glow_ink = vec4(1.0, 0.55, 0.16, 1.0)

// ---- knob: fluted ivory, a gold ring, a domed cap over a printed scale ----
mod.widgets.HwKnobFace.draw_bg.ground = #xe8d8b2
mod.widgets.HwKnobFace.draw_bg.light_ink = vec4(1.0, 0.98, 0.92, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow_ink = vec4(0.18, 0.09, 0.03, 1.0)
mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.93, 0.86, 0.70, 1.0)
mod.widgets.HwKnobFace.draw_bg.ptr_ink = vec4(0.30, 0.12, 0.05, 1.0)
mod.widgets.HwKnobFace.draw_bg.ring = vec4(0.0, 1.3, 2.4, 2.35619)
mod.widgets.HwKnobFace.draw_bg.led_off = vec4(0.42, 0.28, 0.16, 1.0)
mod.widgets.HwKnobFace.draw_bg.glow_ink = vec4(1.0, 0.55, 0.16, 1.0)
mod.widgets.HwKnobFace.draw_bg.shadow = vec4(0.75, 10.0, 1.0, 0.7)
mod.widgets.HwKnobFace.emissive = vec4(1.0, 0.5, 0.12, 0.6)
mod.widgets.HwKnobFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let q = p - c
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let r = min(c.x, c.y) - self.inset
    var o = self.layer(self.surface(p, self.ground.xyz))
    let rq = length(q)
    let ang = atan2(q.x, -q.y)
    let inside = 1.0 - smoothstep(-px, px, rq - r)
    let lt = normalize(self.light.xy + vec2(0.000001, 0.000001))
    let nq = q / max(rq, 0.001)
    var face = o.xyz
    // Fluted skirt: thirty flutes catching the light on one flank.
    let fl = smoothstep(r * 0.80 - px, r * 0.80 + px, rq)
    let fa = ang * 30.0 / 6.28318
    let ff = fract(fa)
    let flank = sin(ff * 6.28318)
    face = face * (1.0 - fl * (0.16 + 0.14 * flank))
    // The gold ring, anisotropic, with dark grooves at its edges.
    let gr = smoothstep(r * 0.66 - px, r * 0.66 + px, rq) * (1.0 - smoothstep(r * 0.80 - px, r * 0.80 + px, rq))
    let aniso = 0.5 + 0.5 * cos((ang - atan2(lt.x, -lt.y)) * 2.0)
    let gold = vec3(0.80, 0.58, 0.22) * (0.7 + 0.55 * aniso) + vec3(1.0, 0.92, 0.7) * pow(aniso, 12.0) * 0.4
    face = mix(face, gold, gr)
    let groove = (1.0 - smoothstep(0.0, 1.0, abs(rq - r * 0.66))) + (1.0 - smoothstep(0.0, 1.0, abs(rq - r * 0.80)))
    face = face * (1.0 - groove * 0.45)
    // The domed ivory cap with a window highlight.
    let capm = 1.0 - smoothstep(r * 0.66 - px, r * 0.66 + px, rq)
    let hl = q / max(r, 1.0) - lt * 0.30
    let spec = exp(-dot(hl, hl) / 0.02) * 0.5
    let capcol = self.cap_ink.xyz * (1.08 - rq / max(r, 1.0) * 0.35 + dot(nq, -lt) * 0.08 * rq / max(r, 1.0)) + vec3(spec, spec, spec)
    face = mix(face, capcol, capm)
    // The pointer: an inlaid brown line on the cap and a gold dot on the skirt.
    let spin = (self.value * 2.0 - 1.0) * self.ring.w
    let dir = vec2(sin(spin), -cos(spin))
    let t = clamp(dot(q, dir), r * 0.16, r * 0.60)
    let pd = length(q - dir * t) - max(r * 0.035, 1.0)
    face = mix(face, self.ptr_ink.xyz, (1.0 - smoothstep(-px, px, pd)) * capm)
    let dd = length(q - dir * r * 0.90) - max(r * 0.05, 1.5)
    face = mix(face, vec3(0.95, 0.75, 0.32), (1.0 - smoothstep(-px, px, dd)))
    o = vec4(face * inside, inside) + o * (1.0 - inside)
    // The printed scale round it: ticks lit by the dial lamp up to the value.
    let n = 11.0
    let a0 = -self.ring.w
    let stepa = (self.ring.w * 2.0) / (n - 1.0)
    let fi = clamp(floor((ang - a0) / stepa + 0.5), 0.0, n - 1.0)
    let ta = a0 + fi * stepa
    let perp = abs(dot(q, vec2(cos(ta), sin(ta))))
    let major = step(0.5, fract(fi * 0.5 + 0.25))
    let r0 = r * 1.10
    let r1 = r * (1.20 + 0.08 * major)
    let tk = (1.0 - smoothstep(-px, px, perp - 0.9 - 0.4 * major)) * step(r0, rq) * step(rq, r1) * step(0.0, dot(q, vec2(sin(ta), -cos(ta))))
    let on = step((fi + 0.5) / n, self.value + 0.02)
    let tcol = mix(vec3(0.36, 0.20, 0.10), vec3(1.0, 0.62, 0.22), on)
    o = vec4(tcol * tk, tk) + o * (1.0 - tk)
    let halo = exp(-perp / 2.5) * step(r0 - 2.0, rq) * step(rq, r1 + 2.0) * on * 0.35 * (1.0 - tk)
    o = o + vec4(vec3(1.0, 0.5, 0.12) * halo, halo) * (1.0 - o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- meter: two magic-eye tubes ----
mod.widgets.HwMeterFace.draw_bg.ground = #x160904
mod.widgets.HwMeterFace.draw_bg.spill = vec2(0.7, 0.4)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(0.36, 1.0, 0.55, 1.0)
mod.widgets.HwMeterFace.draw_bg.light_ink = vec4(1.0, 0.85, 0.6, 1.0)
mod.widgets.HwMeterFace.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwMeterFace.radius = 12
mod.widgets.HwMeterFace.emissive = vec4(0.36, 1.0, 0.55, 0.8)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let rr = max(min(sz.y * 0.5 - 6.5, sz.x * 0.2), 6.0)
    // Left eye or right eye: whichever is nearer.
    let right = step(sz.x * 0.5, p.x)
    let ce = vec2(mix(sz.x * 0.29, sz.x * 0.71, right), sz.y * 0.5)
    let lv = clamp(mix(self.level.x, self.level.y, right), 0.0, 1.0)
    let q = p - ce
    let rq = length(q)
    let ang = atan2(q.x, -q.y)
    // A soft green glow on the bakelite round the tube.
    let halo = exp(-max(rq - rr, 0.0) / 6.0) * 0.30 * step(rr, rq)
    var col = o.xyz + vec3(0.36, 1.0, 0.55) * halo * o.w
    // Chrome escutcheon ring.
    let ring = smoothstep(rr - px, rr + px, rq) * (1.0 - smoothstep(rr + 3.2 - px, rr + 3.2 + px, rq))
    let lt = vec2(-0.6, -0.8)
    let chrome = vec3(0.55, 0.5, 0.45) + vec3(0.45, 0.42, 0.38) * dot(q / max(rq, 0.001), lt)
    col = mix(col, chrome, ring)
    // The glass: black-green, the fluorescent target round the cap.
    let gl = 1.0 - smoothstep(rr - px, rr + px, rq)
    var eye = vec3(0.01, 0.03, 0.018)
    let tr = rq / rr
    let target = smoothstep(0.30, 0.34, tr) * (1.0 - smoothstep(0.90, 0.95, tr))
    let stri = 0.82 + 0.18 * cos(ang * 36.0)
    var fluo = vec3(0.30, 0.95, 0.50) * (0.35 + 0.75 * tr) * stri
    // The shadow wedge at the top closes as the signal rises.
    let hw = mix(0.95, 0.04, lv)
    let wd = (abs(ang) - hw) * rq
    let lit = smoothstep(-px, px, wd)
    let crest = exp(-max(wd, 0.0) / 1.8) * lit * 0.8
    fluo = fluo * (lit * 0.94 + 0.06) + vec3(0.7, 1.0, 0.75) * crest * 0.6
    eye = eye + fluo * target
    // The cathode shield: a dark cap in the middle.
    let cap = 1.0 - smoothstep(0.30 * rr - px, 0.30 * rr + px, rq)
    eye = mix(eye, vec3(0.05, 0.05, 0.045) + vec3(0.2, 0.2, 0.18) * max(dot(q / max(rq, 0.001), lt), 0.0) * tr * 2.0, cap)
    // A reflection on the dome.
    let rh = (q / rr - vec2(-0.32, -0.38)) * vec2(1.0, 1.6)
    eye = eye + vec3(0.9, 1.0, 0.95) * exp(-dot(rh, rh) / 0.03) * 0.22
    col = mix(col, eye, gl)
    o = vec4(col, max(o.w, max(gl, ring)))
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

