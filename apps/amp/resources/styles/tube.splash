mod.widgets.HwTitle.draw_text.color = #x2a1206
mod.widgets.HwText.draw_text.color = #x2e1608
mod.widgets.HwPanelTitle.draw_text.color = #xf0dcb4
mod.widgets.HwPanelText.draw_text.color = #xc8a878
mod.widgets.HwNavButton.draw_text.color = #xf0dcb4
mod.widgets.HwDisplayText.draw_text.color = #xffcf8a
mod.widgets.HwDisplay.draw_bg.ground = #x1a0b04
mod.widgets.HwDisplay.draw_bg.light_ink = vec4(1.0, 0.85, 0.6, 1.0)
mod.widgets.HwDisplay.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwDisplay.draw_bg.inner = vec4(0.95, 9.0, 0.0, 0.55)
mod.widgets.HwDisplay.draw_bg.spill = vec2(1.2, 0.4)
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let e = min(min(p.x, p.y), min(self.rect_size.x - p.x, self.rect_size.y - p.y)) - self.inset
    // Dark bakelite with a thin gold trim.
    let tr = 1.0 - smoothstep(0.0, 0.7, abs(e - 2.2) - 1.0)
    return mix(base, vec3(0.78, 0.56, 0.22), tr * 0.8)
}
mod.widgets.HwSegmented.draw_bg.well = vec4(0.16, 0.07, 0.03, 1.0)
