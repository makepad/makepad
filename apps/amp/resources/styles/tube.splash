mod.widgets.HwKey.draw_bg.light_ink = vec4(1.0, 0.98, 0.92, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.20, 0.10, 0.04, 1.0)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.55, 0.18, 1.0)
mod.widgets.HwKey.draw_bg.pattern = vec4(5.0, 1.0, 0.03, 0.0)
mod.widgets.HwKey.draw_bg.sheen = vec4(0.10, 0.10, 0.25, 0.5)
mod.widgets.HwKey.draw_bg.relief = vec4(4.0, 1.0, 3.0, 0.9)
