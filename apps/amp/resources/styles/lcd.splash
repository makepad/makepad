// ---- the meter's bar form: two LCD segment rows over their ghosts ----
mod.widgets.HwMeterBarFace.draw_bg.ground = #x9dac92
mod.widgets.HwMeterBarFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    var o = self.layer(self.surface(p, self.ground.xyz))
    let pad = vec2(5.0, 3.0)
    let w = max(self.rect_size.x - pad.x * 2.0, 1.0)
    let h = max(self.rect_size.y - pad.y * 2.0, 1.0)
    let u = (p.x - pad.x) / w
    let v = (p.y - pad.y) / h
    let n = max(floor(w / 5.0), 8.0)
    let seg = floor(u * n)
    let fx = fract(u * n)
    let lane = step(0.5, v)
    let fy = fract(v * 2.0)
    let cell = step(0.18, fx) * step(fx, 0.82) * step(0.18, fy) * step(fy, 0.82) * step(0.0, u) * step(u, 1.0) * step(0.0, v) * step(v, 1.0)
    let lv = mix(self.level.x, self.level.y, lane)
    let on = step((seg + 0.5) / n, lv)
    let segc = mix(vec3(0.52, 0.59, 0.49), vec3(0.06, 0.08, 0.07), on)
    o = vec4(mix(o.xyz, segc, cell * mix(0.35, 1.0, on)), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
true
