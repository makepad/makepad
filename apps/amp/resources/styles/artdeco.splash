mod.widgets.HwDisplay.draw_bg.spill = vec2(1.0, 0.4)
mod.widgets.HwDisplay.radius = 3
mod.widgets.HwDisplay.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let ex = min(p.x, self.rect_size.x - p.x)
    let ey = min(p.y, self.rect_size.y - p.y)
    let e = max(max(min(ex, ey - 8.0), min(ex - 4.0, ey - 4.0)), min(ex - 8.0, ey))
    let line = 1.0 - smoothstep(0.35, 0.35 + px * 1.5, abs(e - 3.0))
    return mix(base, vec3(0.86, 0.66, 0.30), line * 0.9)
}
