// ---- meter: a sunrise dial in cream enamel; the rays light up to the level ----
mod.widgets.HwMeterFace.draw_bg.ground = #x0f0e0c
mod.widgets.HwMeterFace.draw_bg.dial_ink = vec4(0.93, 0.88, 0.74, 1.0)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(1.0, 0.78, 0.36, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(0.75, 0.12, 0.06, 1.0)
mod.widgets.HwMeterFace.draw_bg.led_off = vec4(0.20, 0.16, 0.10, 1.0)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let s = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    let a = vec2(6.0, 6.0)
    let b = s - a
    let inside = step(a.x, p.x) * step(p.x, b.x) * step(a.y, p.y) * step(p.y, b.y)
    let u = (p - a) / max(b - a, vec2(1.0, 1.0))
    let h = b.y - a.y
    // The pivot sits below the window: a wide sunrise over the horizon.
    let piv = vec2(s.x * 0.5, b.y + h * 0.95)
    let q = p - piv
    let rq = length(q)
    let ang = atan2(q.x, 0.0 - q.y)
    let span = 0.78
    let r0 = h * 0.95 + 4.0
    let r1 = piv.y - a.y - 5.0
    let rm = (r0 + r1) * 0.5
    // 26 rays; the outer band follows the left channel, the inner the right.
    let n = 26.0
    let fa = (ang + span) / (span * 2.0) * n
    let wi = floor(fa)
    let wf = fract(fa)
    let wv = (wi + 0.5) / n
    let alt = step(0.5, fract(wi * 0.5))
    let lvl = mix(self.level.y, self.level.x, step(rm, rq))
    let lit = step(wv, lvl) * step(0.0, fa) * step(fa, n)
    let hot = step(0.8, wv)
    var dial = self.dial_ink.xyz * (0.90 + alt * 0.10)
    let lamp = mix(vec3(1.0, 0.74, 0.28), vec3(0.88, 0.22, 0.08), hot) * (0.88 + alt * 0.18)
    let band = step(r0, rq) * step(rq, r1)
    dial = mix(dial, lamp, lit * band)
    // Hairlines between the rays and between the bands.
    let hl = min(wf, 1.0 - wf) * (span * 2.0 / n) * rq
    let hair = (1.0 - smoothstep(0.3, 0.3 + px * 1.5, hl)) * band
    dial = mix(dial, vec3(0.30, 0.22, 0.09), hair * 0.85)
    let mid = 1.0 - smoothstep(0.3, 0.3 + px * 1.5, abs(rq - rm))
    dial = mix(dial, vec3(0.30, 0.22, 0.09), mid * band * 0.85)
    // Black arcs close the scale; outside it, lacquer with a gold horizon.
    let arcs = (1.0 - smoothstep(0.5, 0.5 + px * 1.5, abs(rq - r1))) + (1.0 - smoothstep(0.5, 0.5 + px * 1.5, abs(rq - r0)))
    let off = 1.0 - band * step(abs(ang), span)
    dial = mix(dial, vec3(0.04, 0.035, 0.03), off)
    let rays = step(0.5, fract(ang / 6.28318 * 90.0)) * off * step(rq, r0)
    dial = dial + vec3(0.10, 0.07, 0.02) * rays
    dial = mix(dial, vec3(0.08, 0.06, 0.03), clamp(arcs, 0.0, 1.0) * step(abs(ang), span) * 0.9)
    // The needle: black, tapering, with a gold tip.
    let lv = max(self.level.x, self.level.y)
    let na = (lv * 2.0 - 1.0) * span
    let dir = vec2(sin(na), 0.0 - cos(na))
    let t = clamp(dot(q, dir), r0 - 6.0, r1 + 3.0)
    let nd = length(q - dir * t) - 0.7
    let tip = step(r1 - 3.0, t)
    dial = mix(dial, mix(vec3(0.05, 0.04, 0.03), vec3(1.0, 0.85, 0.45), tip), 1.0 - smoothstep(0.0 - px, px, nd))
    // A stepped gold frame, a warm lamp glow low in the window.
    let ex = min(p.x - a.x, b.x - p.x)
    let ey = min(p.y - a.y, b.y - p.y)
    let e = max(max(min(ex, ey - 6.0), min(ex - 3.0, ey - 3.0)), min(ex - 6.0, ey))
    let fr = 1.0 - smoothstep(0.5, 0.5 + px * 1.5, abs(e - 1.2))
    let fr2 = 1.0 - smoothstep(0.3, 0.3 + px * 1.5, abs(e - 3.4))
    dial = mix(dial, vec3(0.95, 0.76, 0.38), clamp(fr + fr2 * 0.6, 0.0, 1.0) * step(0.0, e))
    dial = dial * (0.78 + 0.22 * smoothstep(0.0, 0.6, u.y + 0.2))
    o = vec4(mix(o.xyz, dial, inside), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}
