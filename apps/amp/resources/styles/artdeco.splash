mod.widgets.HwKnobFace.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwKnobFace.draw_bg.knob = vec4(3.0, 0.70, 0.0, 0.0)
mod.widgets.HwKnobFace.draw_bg.cap_ink = vec4(0.86, 0.66, 0.30, 1.0)
