mod.widgets.HwArtBlank.draw_bg.vinyl = vec4(0.01, 0.03, 0.05, 1.0)
mod.widgets.HwArtBlank.draw_bg.groove = 0.25
// No art: a holographic data disc, light rings over black, a rainbow
// diffraction sheen across it and a lit hub.
mod.widgets.HwArtBlank.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let c = self.rect_size * 0.5
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var col = vec3(0.004, 0.012, 0.02)
    let r = min(c.x, c.y) - 5.0
    let q = p - c
    let d = length(q)
    let t = d / max(r, 1.0)
    let disc = 1.0 - smoothstep(r - px, r + px, d)
    let ang = atan2(q.y, q.x)
    let rings = 0.5 + 0.5 * sin(d * 2.4)
    let spec = pow(abs(cos(ang - 0.8)), 8.0)
    let h = t * 6.0 + ang * 0.5
    let irid = vec3(0.5 + 0.5 * sin(h + 3.6), 0.5 + 0.5 * sin(h + 1.2), 0.5 + 0.5 * sin(h))
    var dc = vec3(0.01, 0.03, 0.045) + vec3(0.03, 0.12, 0.16) * rings * 0.35 + irid * spec * 0.22 * smoothstep(0.3, 0.5, t)
    let rim = 1.0 - smoothstep(0.3, 0.3 + px * 1.5, abs(d - r + 0.6))
    let tr = 1.0 - smoothstep(0.3, 0.3 + px * 1.5, abs(d - r * 0.36))
    dc = dc + vec3(0.30, 0.90, 1.0) * (rim * 0.9 + tr * 0.6)
    let hub = exp(-d / 3.0) * 1.2 + exp(-d / 10.0) * 0.2
    dc = dc + vec3(0.40, 0.95, 1.0) * hub
    col = mix(col, dc, disc)
    return vec4(col + self.dither(), 1.0)
}
true

