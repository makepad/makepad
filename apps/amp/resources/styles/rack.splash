// Dark Rack — a black anodised studio rack: matte black front with rack
// ears and screws, black caps each carrying a status LED, a full LED ring
// round the volume encoder, a long VU ladder, cyan status light with amber
// warnings, stencilled white labels.
//
// Assignments only, over the base templates in `src/hw.rs`
// (see local/agent_state/skeuomorph/music/STYLE_GUIDE.md).
use mod.prelude.widgets_internal.*

// ---- palette: the lists, the spectrum, the bars ----
mod.widgets.hw_palette.screen_bg = #x06080a
mod.widgets.hw_palette.screen_text = #xe2eef2
mod.widgets.hw_palette.screen_muted = #x7f9098
mod.widgets.hw_palette.accent = #x27d9ff
// The device's floor is dark: display type sits on it bare.
mod.widgets.hw_palette.dark_floor = 1.0

// ---- the front: black anodised, rack ears with slotted screws ----
mod.widgets.HwChassis.draw_bg.ground = #x121316
mod.widgets.HwChassis.draw_bg.light_ink = vec4(0.62, 0.66, 0.70, 1.0)
mod.widgets.HwChassis.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwChassis.draw_bg.pattern = vec4(5.0, 0.6, 0.10, 0.0)
mod.widgets.HwChassis.draw_bg.glow_ink = vec4(0.15, 0.85, 1.0, 1.0)
mod.widgets.HwChassis.draw_bg.spill = vec2(1.5, 0.6)
mod.widgets.HwChassis.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let sz = self.rect_size
    var col = self.surface(p, self.ground.xyz)
    let v = length((self.pos - vec2(0.5, 0.30)) * vec2(0.9, 1.3))
    col = col * (1.10 - 0.30 * v * v)
    // Rack units: a faint seam every 1U (44 pt).
    let fu = fract(p.y / 44.0)
    let useam = (1.0 - smoothstep(0.0, 0.9, min(fu, 1.0 - fu) * 44.0)) * 0.35
    col = col * (1.0 - useam)
    // Rack ears: a brighter brushed strip 12 pt in from each side, a
    // chamfer where it meets the front, slotted screw holes every 3U.
    let ew = 12.0
    let ex = min(p.x, sz.x - p.x)
    let ear = 1.0 - smoothstep(ew - 0.6, ew + 0.6, ex)
    let brush = 1.0 + (self.hw_noise(vec2(p.x * 0.8, p.y * 0.02)) - 0.5) * 0.25
    let earcol = vec3(0.150, 0.156, 0.168) * brush * (1.05 - 0.25 * self.pos.y)
    col = mix(col, earcol, ear)
    let lip = 1.0 - smoothstep(0.0, 1.0, abs(ex - ew))
    col = mix(col, vec3(0.0, 0.0, 0.0), lip * 0.8)
    let hi = 1.0 - smoothstep(0.0, 0.8, abs(ex - 0.8))
    col = col + vec3(0.12, 0.13, 0.14) * hi
    let cy = (floor(p.y / 132.0) + 0.5) * 132.0
    let q = vec2(ex - ew * 0.5, p.y - cy)
    let hole = length(vec2(q.x, max(abs(q.y) - 3.5, 0.0)))
    let hm = 1.0 - smoothstep(2.3, 3.0, hole)
    let rim = (1.0 - smoothstep(0.0, 0.8, abs(hole - 3.3))) * clamp(q.y * 0.25 + 0.5, 0.0, 1.0)
    col = mix(col, vec3(0.0, 0.0, 0.0), hm * ear) + vec3(0.22, 0.23, 0.25) * rim * ear
    col = col * (1.0 - self.env_ao(0.0)) + self.env_spill(vec3(0.0, 0.0, 1.0))
    return vec4(col + self.dither(), 1.0)
}
mod.widgets.Window.pass.clear_color = #x121316

// Raised plates: rack modules, a crisp chamfer, a screw in each corner.
mod.widgets.HwPlate.draw_bg.ground = #x1a1b1f
mod.widgets.HwPlate.draw_bg.light_ink = vec4(0.70, 0.74, 0.78, 1.0)
mod.widgets.HwPlate.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwPlate.draw_bg.pattern = vec4(5.0, 0.6, 0.08, 0.0)
mod.widgets.HwPlate.draw_bg.relief = vec4(1.4, 0.95, 2.0, 0.55)
mod.widgets.HwPlate.draw_bg.shadow = vec4(0.75, 9.0, 1.0, 0.6)
mod.widgets.HwPlate.draw_bg.glow_ink = vec4(0.15, 0.85, 1.0, 1.0)
mod.widgets.HwPlate.draw_bg.spill = vec2(1.9, 0.55)
mod.widgets.HwPlate.radius = 4
mod.widgets.HwPlate.draw_bg.surface = fn(p: vec2, base: vec3) -> vec3 {
    let w = self.world.xy
    var col = base * (1.0 + (self.hw_hash(floor(w * 3.0)) - 0.5) * 0.06)
    // A screw near each corner: a cross-head with a rim.
    let a = vec2(self.inset + 9.0, self.inset + 9.0)
    let b = self.rect_size - a
    let cx = mix(a.x, b.x, step(self.rect_size.x * 0.5, p.x))
    let cy = mix(a.y, b.y, step(self.rect_size.y * 0.5, p.y))
    let q = p - vec2(cx, cy)
    let r = length(q)
    let head = 1.0 - smoothstep(3.0, 3.8, r)
    let dome = clamp(0.55 - (q.x + q.y) * 0.08, 0.0, 1.0)
    col = mix(col, vec3(0.30, 0.31, 0.33) * (0.6 + dome), head)
    let cross = min(abs(q.x - q.y), abs(q.x + q.y))
    let slot = (1.0 - smoothstep(0.35, 0.9, cross)) * (1.0 - smoothstep(2.0, 2.8, r))
    col = mix(col, vec3(0.02, 0.02, 0.02), slot)
    col = col * (1.0 - (1.0 - smoothstep(3.6, 5.0, r)) * (1.0 - head) * 0.5)
    // Module status LEDs beside the top-right screw: power (cyan), signal
    // (amber), each in a black bezel.
    let l1 = vec2(self.rect_size.x - self.inset - 24.0, self.inset + 9.0)
    let l2 = l1 - vec2(12.0, 0.0)
    let d1 = length(p - l1)
    let d2 = length(p - l2)
    let bez = (1.0 - smoothstep(3.3, 4.0, d1)) + (1.0 - smoothstep(3.3, 4.0, d2))
    col = mix(col, vec3(0.01, 0.01, 0.012), clamp(bez, 0.0, 1.0))
    let c1 = 1.0 - smoothstep(1.9, 2.5, d1)
    let c2 = 1.0 - smoothstep(1.9, 2.5, d2)
    col = mix(col, vec3(0.55, 0.95, 1.0), c1) + vec3(0.15, 0.85, 1.0) * exp(-d1 / 3.0) * 0.5 * (1.0 - c1)
    col = mix(col, vec3(1.0, 0.80, 0.40), c2) + vec3(1.0, 0.62, 0.10) * exp(-d2 / 3.0) * 0.5 * (1.0 - c2)
    return col
}

