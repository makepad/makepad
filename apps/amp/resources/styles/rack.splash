// ---- keys: black rubber-topped caps, each with a status LED ----
mod.widgets.HwKey.radius = 3
mod.widgets.HwKey.draw_bg.ground = #x202226
mod.widgets.HwKey.draw_bg.light_ink = vec4(0.75, 0.80, 0.85, 1.0)
mod.widgets.HwKey.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwKey.draw_bg.pattern = vec4(5.0, 0.5, 0.06, 0.0)
mod.widgets.HwKey.draw_bg.relief = vec4(2.0, 0.9, 2.5, 0.45)
mod.widgets.HwKey.draw_bg.shadow = vec4(0.85, 6.0, 1.0, 0.7)
mod.widgets.HwKey.draw_bg.glow_ink = vec4(1.0, 0.66, 0.16, 1.0)
mod.widgets.HwKey.draw_bg.spill = vec2(2.4, 0.45)
mod.widgets.HwKey.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.key_face(p, self.ground.xyz))
    if self.mech.x > 0.5 {
        o = self.mech_key()
    }
    // The status LED: top-left of the face, amber.
    let lp = vec2(self.inset + 6.0, self.inset + 5.5)
    let d = length(p - lp) - 1.7
    let core = 1.0 - smoothstep(-px, px, d)
    // Lit while its switch is on (the key's `lit`), a dim amber dot when off.
    let on = clamp(self.lit, 0.0, 1.0)
    let col = mix(self.led_off.xyz, mix(self.glow_ink.xyz, vec3(1.0, 0.95, 0.8), 0.35), on)
    o = vec4(mix(o.xyz, col, core), o.w)
    let halo = exp(-max(d, 0.0) / 2.2) * 0.5 * (1.0 - core) * on
    o = vec4(o.xyz + self.glow_ink.xyz * halo * o.w, o.w)
    return o
}
