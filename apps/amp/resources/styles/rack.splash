mod.widgets.HwPanel.draw_bg.pattern = vec4(5.0, 0.6, 0.06, 0.0)
mod.widgets.HwPanel.draw_bg.inner = vec4(0.95, 9.0, 0.0, 0.55)
mod.widgets.HwPanel.draw_bg.glow_ink = vec4(0.15, 0.85, 1.0, 1.0)
