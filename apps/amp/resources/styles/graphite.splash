// ---- meter: hairline white ticks on black, orange at the top ----
mod.widgets.HwMeterFace.radius = 8
mod.widgets.HwMeterFace.depth = -1.5
mod.widgets.HwMeterFace.draw_bg.ground = #x0e0f10
mod.widgets.HwMeterFace.draw_bg.light_ink = vec4(0.5, 0.51, 0.53, 1.0)
mod.widgets.HwMeterFace.draw_bg.shadow_ink = vec4(0.0, 0.0, 0.0, 1.0)
mod.widgets.HwMeterFace.draw_bg.inner = vec4(0.85, 7.0, 0.0, 0.0)
mod.widgets.HwMeterFace.draw_bg.meter = vec4(0.0, 30.0, 1.0, 0.8)
mod.widgets.HwMeterFace.draw_bg.spill = vec2(0.0, 0.2)
mod.widgets.HwMeterFace.draw_bg.glow_ink = vec4(0.92, 0.92, 0.93, 1.0)
mod.widgets.HwMeterFace.draw_bg.hot_ink = vec4(1.0, 0.48, 0.11, 1.0)
mod.widgets.HwMeterFace.draw_bg.led_off = vec4(0.16, 0.165, 0.175, 1.0)
mod.widgets.HwMeterFace.emissive = vec4(0.9, 0.9, 0.92, 0.35)
mod.widgets.HwMeterFace.draw_bg.pixel = fn() {
    let p = self.pos * self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    var o = self.layer(self.surface(p, self.ground.xyz))
    // Two rows of hairline ticks, L over R, like the reference spectrum.
    let a = vec2(self.inset + 14.0, self.inset + 8.0)
    let b = self.rect_size - vec2(self.inset + 10.0, self.inset + 8.0)
    let n = max(self.meter.y, 4.0)
    let pitch = (b.x - a.x) / n
    let rowh = (b.y - a.y) * 0.5
    let col_i = floor((p.x - a.x) / pitch)
    let lane = clamp(floor((p.y - a.y) / max(rowh, 1.0)), 0.0, 1.0)
    let cx = a.x + (col_i + 0.5) * pitch
    let lv = mix(self.level.x, self.level.y, lane)
    let t = (col_i + 0.5) / n
    let valid = step(0.0, col_i) * step(col_i, n - 1.0)
    let on = step(t, lv) * valid
    let ry0 = a.y + lane * rowh + rowh * 0.18
    let ry1 = a.y + (lane + 1.0) * rowh - rowh * 0.18
    let inrow = step(ry0, p.y) * step(p.y, ry1) * step(a.y, p.y) * step(p.y, b.y)
    let hw = mix(0.35, 0.8, on)
    let tick = (1.0 - smoothstep(hw - px * 0.5, hw + px * 0.5, abs(p.x - cx))) * inrow * valid
    var zc = self.glow_ink.xyz
    zc = mix(zc, self.hot_ink.xyz, step(0.84, t))
    let tc = mix(self.led_off.xyz, zc, on)
    o = vec4(mix(o.xyz, tc, tick), o.w)
    // The held peak: an orange tick.
    let pk = floor(self.level.z * n)
    let pkm = step(abs(col_i - pk + 1.0), 0.1) * step(0.02, self.level.z) * valid
    let ptick = (1.0 - smoothstep(0.8 - px * 0.5, 0.8 + px * 0.5, abs(p.x - cx))) * inrow * pkm
    o = vec4(mix(o.xyz, self.hot_ink.xyz, ptick), o.w)
    // L and R: tiny grey dots at the start of each row.
    let ld = length(p - vec2(self.inset + 7.0, a.y + rowh * 0.5)) - 1.3
    let rd = length(p - vec2(self.inset + 7.0, a.y + rowh * 1.5)) - 1.3
    let dm = 1.0 - smoothstep(-px, px, min(ld, rd))
    o = vec4(mix(o.xyz, vec3(0.45, 0.46, 0.48), dm), o.w)
    return vec4(o.xyz + self.dither() * step(0.002, o.w), o.w)
}

// ---- the spectrum: hairline white bars, tiny peak ticks, one orange ----
// Parts by `self.part` (1 well, 2 rule, 3 slot, 4 bar, 5 peak, 6 midline, 7 fill).
mod.widgets.HwSpectrum.draw_round.pixel = fn() {
    let p = self.pos * self.rect_size
    let s = self.rect_size
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let accent = step(abs(self.band - floor(self.bands * 0.40)), 0.1)
    if self.part > 0.5 && self.part < 1.5 {
        let sdf = Sdf2d.viewport(p)
        sdf.box(0.0, 0.0, s.x, s.y, 8.0)
        let v = p.y / max(s.y, 1.0)
        sdf.fill(vec4(vec3(0.052, 0.055, 0.058) - vec3(0.012, 0.012, 0.012) * v, 1.0))
        return sdf.result
    }
    if (self.part > 1.5 && self.part < 2.5) || (self.part > 5.5 && self.part < 6.5) {
        let w = self.rect_pos.x + p.x
        let dm = step(fract(w / 3.0), 0.34)
        let a = self.color.w * dm * 1.2
        return vec4(vec3(0.55, 0.56, 0.58) * a, a)
    }
    if self.part > 6.5 {
        return vec4(self.color.xyz * self.color.w, self.color.w)
    }
    // A peak: a small tick over the bar, orange on the accent band.
    if self.part > 4.5 && self.part < 5.5 {
        let cx = s.x * 0.5
        let m = 1.0 - smoothstep(0.9 - px * 0.5, 0.9 + px * 0.5, abs(p.x - cx))
        let c = mix(vec3(0.80, 0.81, 0.83), vec3(1.0, 0.48, 0.11), accent)
        let a = m * 0.9
        return vec4(c * a, a)
    }
    let cx = s.x * 0.5
    if self.part > 2.5 && self.part < 3.5 {
        // The empty slot: a small base tick, so the scale reads at rest.
        let fb = s.y - p.y
        let m = (1.0 - smoothstep(0.4, 0.4 + px, abs(p.x - cx))) * step(fb, 3.0)
        let a = m * 0.35
        return vec4(vec3(0.6, 0.61, 0.63) * a, a)
    }
    // A bar: a hairline, brighter toward its top.
    let m = 1.0 - smoothstep(0.85 - px * 0.5, 0.85 + px * 0.5, abs(p.x - cx))
    let v = 1.0 - p.y / max(s.y, 1.0)
    var c = vec3(0.93, 0.93, 0.94) * (0.72 + 0.28 * (1.0 - v))
    c = mix(c, vec3(1.0, 0.48, 0.11), accent)
    return vec4(c * m, m)
}
mod.widgets.HwSpectrum.draw_line.pixel = fn() {
    let p = self.pos * self.rect_size
    let a = self.seg_a
    let b = self.seg_b
    let pa = p - a
    let ba = b - a
    let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    let d = length(pa - ba * h)
    let al = (1.0 - smoothstep(0.35, 1.0, d)) * 0.62
    return vec4(vec3(0.86, 0.87, 0.89) * al, al)
}
