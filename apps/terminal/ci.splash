// CI smoke test for apps/terminal. Run by devhub ci, which finds every `ci.splash`
// in the checkout. The script decides every input; the vision model only
// judges the grab against the acceptance text below. Basic on purpose: does
// it check everywhere, build and come up here, and look like what it is.

use mod.std.*
use mod.ci;

ci.step("check other platforms", fn(){
    ci.check_targets({packages: ["makepad-app-terminal"] targets: ci.host.targets})
})

// On macOS the terminal starts its shell through the pty helper that lives
// next to it; an app build alone does not produce it.
ci.step("build the pty helper", fn(){
    ci.build({package: "makepad-agents" binary: "agents"})
})

let app = ci.launch({package: "makepad-app-terminal" binary: "makepad-app-terminal" cwd: "."})

ci.step("comes up", fn(){
    ci.sleep(3.0)
    app.no_errors()
    let shot = app.grab("start")
    // No "is any user interface visible" point: a terminal's interface is its text, which the
    // terminal point asks about. Asked both of a shell's banner and prompt, the judge answered
    // the generic one NO and the terminal one YES, and failed a terminal that came up (11-08).
    ci.accept(shot, "This is a screenshot of one application window. A thin bright red frame runs around the very edge of the picture; it is the test harness's marker and is not part of the application. Ignore it. The application is a terminal emulator. 1. Is the whole picture one flat colour from edge to edge, such as entirely black or entirely white? expected NO 2. Does an error panel cover the window: a large block of text with words such as panic, error, failed, backtrace or unwrap? expected NO 3. Is a terminal visible: a large area of one flat dark or light colour with monospace text lines starting at the left edge, such as a prompt? expected YES")
})

app.no_errors()
app.quit()
nil
