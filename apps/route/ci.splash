// CI smoke test for apps/route. Run by tools/ci, which finds every `ci.splash`
// in the checkout. The script decides every input; the vision model only
// judges the grab against the acceptance text below. Basic on purpose: does
// it check everywhere, build and come up here, and look like what it is.

use mod.std.*
use mod.ci;

ci.step("check other platforms", fn(){
    ci.check_targets({packages: ["makepad-app-route"] targets: ci.host.targets})
})

let app = ci.launch({package: "makepad-app-route" binary: "makepad-app-route" cwd: "."})

ci.step("comes up", fn(){
    ci.sleep(3.0)
    app.no_errors()
    let shot = app.grab("start")
    ci.accept(shot, "This is a screenshot of one application window. A thin bright red frame runs around the very edge of the picture; it is the test harness's marker and is not part of the application. Ignore it. The application is a map and route planner. 1. Is the whole picture one flat colour from edge to edge, such as entirely black or entirely white? expected NO 2. Is a map or other user interface visible, such as streets, roads, water, land or city areas, text labels, buttons, icons, panels, lists, input fields or a toolbar? expected YES 3. Does an error panel cover the window: a large block of text with words such as panic, error, failed, backtrace or unwrap? expected NO")
})

app.no_errors()
app.quit()
nil
