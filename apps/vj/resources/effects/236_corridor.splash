// CORRIDOR — an endless flight down a square duct whose four walls all
// play the clip, one copy per segment: the video rushes past on the left,
// right, floor and ceiling while a hot light-line sweeps down every
// segment in beat time. Pattern taught here: the corridor rig — identical
// segments one pitch apart, the camera looping a single pitch under
// fract(), fog hiding the wrap.
{
    name: "Corridor"
    engine: "videomesh"
    shape: "corridor"
    seed: 7

    instances: 18
    size: 2.3
    spread: 3.0
    aspect: 0.72
    fly: 1.1

    beat_pulse: 0.45
    input0: "test"

    color_bg: #x04050c
    color_a: #x40c8f0
    color_b: #x1a3a6a
    color_c: #xd0ecff

    fog: 0.10
    glow: 1.0

    stages: [
        {kind: "bloom", threshold: 0.68, strength: 0.9, levels: 2}
    ]

    // THE LOOK LIVES HERE — the wall fragment: the clip lit by the
    // engine's headlamp term, a beat-phase light-line sweeping u along
    // every segment, seams kept dark.
    shader: draw.DrawVjFxVideomesh {
        fx_color: fn(t: float, attr: vec4, content: vec4, cmix: float) -> vec4 {
            let d = abs(fract(self.v_uv.x - self.time_beat.z + 0.5) - 0.5) * 2.0
            let line = 1.0 - smoothstep(0.0, 0.12, d)
            let lit = content.xyz * (t * (0.55 + 0.45 * attr.z))
            let sweep = self.col_a.xyz * line
                * (0.45 + self.time_beat.w * 1.4 + clamp(self.user.z, 0.0, 4.0))
            return vec4((lit + sweep) * self.fog.y, 1.0)
        }
    }
}
