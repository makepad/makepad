// PULSE WORMHOLE — the binding layer at work on a mesh engine: glow and
// fog both ride the beat envelope, the radial-blur stage hits on the pulse,
// and p0 feeds a custom sweep into the standard `self.user` uniform.
{
    name: "Pulse Wormhole"
    engine: "tunnel"

    knot_p: 2.0
    knot_q: 5.0
    major: 6.0
    tube: 1.4
    rings: 800
    sides: 20
    fly: 5.0
    bands: 130.0

    beat_pulse: 0.8
    glow: "0.8 + env(phase) * 1.3"
    fog: "0.08 + env(phase) * 0.05"
    p0: "tri(bar)"
    // Declared dials: hosts label their knobs from these.
    dials: [ {name: "SWEEP", bind: "p0", default: 0.5} ]

    color_bg: #x000208
    color_a: #x00ffcc
    color_b: #x0066ff
    color_c: #xccffee

    stages: [
        {kind: "radial_blur", p1: "pulse * 0.7", p2: 0.5},
        {kind: "bloom", threshold: 0.4, strength: 1.5, levels: 3}
    ]
}
