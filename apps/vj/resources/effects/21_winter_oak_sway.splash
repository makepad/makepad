// WINTER OAK — a bare oak silhouette in cold light. Pattern taught here:
// a thick-trunked tree needs `!` radius decay ON THE BRANCH (inside the
// brackets) so the trunk keeps its girth while twigs thin out.
{
    name: "Winter Oak"
    engine: "lsystem"
    seed: 23

    axiom: "T"
    rules: ["T=F!X", "X=F[!+X][!-X][!&X]FX", "F=FF"]
    iterations: 5
    angle: 32.0
    angle_jitter: 8.0
    step: 0.11
    radius: 0.10
    radius_decay: 0.68
    sides: 6

    sway: "0.5 + pulse * 0.4"
    sway_freq: 0.55
    beat_pulse: 0.25

    color_bg: #x060a12
    color_a: #x8899bb
    color_b: #xdde8ff
    color_c: #xffffff

    cam_orbit: 0.08
    fog: 0.03
    glow: 1.1

    stages: [
        {kind: "bloom", threshold: 0.55, strength: 1.1, levels: 2}
    ]
}
