// MONASTERY SPIRAL — seven hundred ivory dominoes on an Archimedean
// spiral, toppling at exactly four per beat (sixteenths in 4/4), candle
// light flaring at each impact. When the run completes it rests four
// beats, then the whole liturgy RESURRECTS in reverse (the front is a
// triangle wave of the beat — pure shader math). Pattern taught: the
// domino engine's musical clock is `per_beat`; anticipation glow (`p2`)
// makes the pins ahead of the line breathe on the pulse.
{
    name: "Monastery Spiral"
    engine: "domino"
    seed: 47

    layout: "spiral"
    count: 700
    per_beat: 4
    spacing: 0.30
    resurrect: 1
    pause_beats: 4
    flash: 1.0
    jitter: 0.10

    beat_pulse: 0.4
    p2: 0.4                 // soft anticipation ahead of the front

    color_bg: #x120a04
    color_a: #xf2e8d0
    color_b: #x8a6a3a
    color_c: #xffd890

    cam_orbit: 0.07
    fog: 0.018
    glow: 1.3

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.1, levels: 2},
        {kind: "tiltshift", focus: 0.5, width: 0.35, levels: 2}
    ]
}
