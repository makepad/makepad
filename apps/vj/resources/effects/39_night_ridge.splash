// NIGHT RIDGE — the night-vision flythrough: mono-green ridged terrain,
// fast scroll, hard grid. Battlezone energy.
{
    name: "Night Ridge"
    engine: "heightmap"

    res: 140
    size: 30.0
    height: 4.0
    noise_scale: 0.22
    scroll: 5.5
    ridged: 1.0

    beat_pulse: "0.45 * (0.2 + 1.6*p0)"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "GLOW", bind: "p1", default: 0.5},
        {name: "CRUSH", bind: "p2", default: 0.5}
    ]

    color_bg: #x020a04
    color_a: #x22cc55
    color_b: #x66ff99
    color_c: #xccffdd

    cam_fov: 74.0
    cam_height: 3.2
    fog: 0.05
    glow: "1.25 * (0.25 + 1.5*p1)"

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 2},
        {kind: "posterize", p1: "0.7 + (0.5 - p2)*0.6", p2: 0.6}
    ]
}
