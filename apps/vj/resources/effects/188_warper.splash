// WARPER — two independent travelling sine warps, one per axis, each
// optionally layered with a faster second phase; COMPLEX thickens the mix.
{
    name: "Warper"
    engine: "screen"
    input0: "test"

    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "DEPTH", bind: "p0", default: 0.5},
        {name: "SPEED", bind: "p1", default: 0.5},
        {name: "COMPLEX", bind: "p2", default: 0.5}
    ]

    stages: [
        {kind: "bloom", threshold: 0.6, strength: 1.05, levels: 2}
    ]

    shader: draw.DrawVjFxScreen {
        fx_color: fn(uv: vec2, content: vec4, cmix: float) -> vec4 {
            let t = self.time_beat.x
            let speed = 0.3 + 1.3 * self.user.y
            let amp = (0.012 + 0.045 * self.user.x) * (0.6 + 0.4 * self.time_beat.w)
            let cplx = clamp(self.user.z, 0.0, 1.0)
            let wx = sin(uv.y * 12.0 + t * speed) + cplx * 0.5 * sin(uv.y * 27.0 - t * speed * 1.7)
            let wy = sin(uv.x * 9.0 - t * speed * 1.3) + cplx * 0.5 * sin(uv.x * 23.0 + t * speed * 2.1)
            let w = uv + vec2(wx, wy) * amp
            let tex = self.tex0.sample_as_bgra(clamp(w, vec2(0.0, 0.0), vec2(1.0, 1.0)))
            return vec4(tex.xyz, 1.0)
        }
    }
}
