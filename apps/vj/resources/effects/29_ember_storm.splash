// EMBER STORM — burst particles in fire colors with heavy fallout and a
// long feedback tail: campfire sparks scaled to a stadium.
{
    name: "Ember Storm"
    engine: "particles"
    mode: "burst"
    seed: 9

    count: 8000
    spread: 6.0
    size: 0.10
    rate: 0.5
    gravity: 1.8

    beat_pulse: "0.6 * (0.2 + 1.6*p0)"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "TRAIL", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x0a0402
    color_a: #xff9030
    color_b: #xff3a10
    color_c: #xffd9a0

    cam_dist: 14.0
    cam_height: 2.0
    cam_orbit: 0.06
    fog: 0.03

    stages: [
        {kind: "feedback", amount: "min(0.7 + (p1-0.5)*0.56, 0.97)", zoom: 1.004, rotate: 0.0, dim: 0.90},
        {kind: "bloom", threshold: 0.35, strength: "1.5 * (0.25 + 1.5*p2)", levels: 3}
    ]

    // THE LOOK LIVES HERE. This block is not a reference to the
    // engine's shader — it IS the pixel math this effect runs.
    // Rewrite it and the effect looks different; everything else
    // (geometry, motion, the content coupling, the beat) keeps
    // working, because the block SUBCLASSES the engine shader.
    // Inputs: t = life 0..1, attr = (id, spawn phase, hue, rnd).
    // Signals: self.time_beat (time, beat, phase, pulse),
    // self.sig (bar, bpm, energy, dt), self.user (p0..p3),
    // self.col_a/b/c/bg, self.fog (density, glow, content, -).
    shader: draw.DrawVjFxParticles {
        fx_color: fn(t: float, attr: vec4, normal: vec3, wpos: vec3) -> vec4 {
            let base = self.col_a.mix(self.col_b, attr.z)
            let hot = base.xyz + vec3(0.5, 0.4, 0.3) * pow(1.0 - t, 6.0)
            let fade = (1.0 - t) * smoothstep(0.0, 0.08, t)
            let boost = 0.85 + self.time_beat.w * 0.9
            return vec4(hot * boost, fade)
        }

        fx_sprite: fn(uv: vec2, tint: vec4) -> vec4 {
            let d = length(uv - vec2(0.5, 0.5)) * 2.0
            let core = 1.0 - smoothstep(0.0, 0.5, d)
            let halo = 1.0 - smoothstep(0.15, 1.0, d)
            let a = clamp(core + halo * 0.5, 0.0, 1.0) * tint.w
            return vec4(tint.x * a, tint.y * a, tint.z * a, 0.0)
        }
    }
}
