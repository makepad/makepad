// BEAT SALVO — hard techno emitters: a burst SLAMS on every beat,
// alternating left/right, in venue-laser colors. Minimal script, maximal
// punch — the template for "just hit on the beat".
{
    name: "Beat Salvo"
    engine: "emitters"
    particles: 1400
    size: 0.15

    color_bg: #x030306
    cam_dist: 13.0
    cam_height: 1.0
    cam_orbit: 0.0

    stages: [
        {kind: "bloom", threshold: 0.3, strength: 1.8, levels: 3},
        {kind: "feedback", amount: 0.45, zoom: 1.01, rotate: 0.0, dim: 0.85}
    ]

    frame: fn(fx) {
        let out = []
        if fx.phase < fx.dt * 2.0 {
            let side = modf(fx.beat, 2.0) * 2.0 - 1.0
            let col = #x00ffcc
            let col2 = #x0066ff
            if side > 0.0 {
                col = #xff2299
                col2 = #xaa00ff
            }
            out.push({
                kind: "burst"
                pos: vec3(side * 4.0, 1.0, 0.0)
                life: 1.1
                speed: 7.0
                size: 0.26
                gravity: 0.4
                color: col
                color2: col2
                seed: fx.beat * 1.3
            })
        }
        return out
    }
}
