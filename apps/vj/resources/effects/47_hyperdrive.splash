// HYPERDRIVE — a (5,2) knot flown FAST, ice-blue, radial blur hammering
// on the beat. The hard-techno tunnel.
{
    name: "Hyperdrive"
    engine: "tunnel"

    knot_p: 5.0
    knot_q: 2.0
    major: 7.5
    tube: 1.3
    rings: 1100
    sides: 20
    fly: 9.0
    bands: 150.0

    beat_pulse: 0.85
    glow: "0.9 + env(phase) * 1.2"

    color_bg: #x020410
    color_a: #x66ccff
    color_b: #x2244cc
    color_c: #xffffff

    fog: 0.11

    stages: [
        {kind: "radial_blur", p1: "0.15 + pulse * 0.6", p2: 0.5},
        {kind: "bloom", threshold: 0.4, strength: 1.5, levels: 3}
    ]
}
