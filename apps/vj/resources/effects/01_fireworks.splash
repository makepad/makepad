// FIREWORKS — staggered burst shells, stateless GPU particles.
// The vertex shader re-derives every spark from (id, seed, time); the CPU
// uploaded one quad per particle once and will never touch it again.
{
    name: "Fireworks"
    engine: "particles"
    mode: "burst"
    seed: 12

    count: 9000
    spread: 7.0
    size: 0.14
    rate: 0.35
    gravity: 1.1

    speed: 1.0
    // PERFORMANCE DIALS — p0..p2 route through binding expressions; each
    // default reproduces the stock look exactly (dials only act when moved).
    beat_pulse: "0.65 * (0.2 + 1.6*p0)"
    beat_rate: 1.0
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "TRAIL", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x040308
    color_a: #xffd24a
    color_b: #x66aaff
    color_c: #xfff6e0

    cam_dist: 16.0
    cam_height: 3.5
    cam_orbit: 0.05
    fog: 0.02

    stages: [
        {kind: "bloom", threshold: 0.35, strength: "1.6 * (0.25 + 1.5*p2)", levels: 3},
        {kind: "feedback", amount: "min(0.55 + (p1-0.5)*0.7, 0.97)", zoom: 1.0, rotate: 0.0, dim: 0.9}
    ]
}
