// LORENZ STORM — ribbons riding the genuine Lorenz attractor ODEs: the
// two-winged butterfly drawn by glowing trails. Pattern taught: the
// `field:` key swaps the ribbon engine's velocity field.
{
    name: "Lorenz Storm"
    engine: "ribbons"
    seed: 28
    field: "lorenz"

    ribbons: 40
    trail: 90
    width: 0.09
    flow_speed: 2.4
    bound: 6.0

    beat_pulse: 0.5

    color_bg: #x080410
    color_a: #xffaa44
    color_b: #xff4488
    color_c: #xffffff

    cam_dist: 12.0
    cam_orbit: 0.10
    fog: 0.02

    stages: [
        {kind: "feedback", amount: 0.75, zoom: 1.002, rotate: 0.0, dim: 0.93},
        {kind: "bloom", threshold: 0.4, strength: 1.4, levels: 3}
    ]
}
