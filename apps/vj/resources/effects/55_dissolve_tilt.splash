// DISSOLVE TILT — the hybrid crown jewel: the live video becomes a field
// of particles (each carrying its pixel) that dissolves and re-forms on
// the bars, then a TILTSHIFT pass miniaturizes the whole thing.
// video -> particles -> tiltshift, one document.
{
    name: "Dissolve Tilt"
    engine: "particles"
    mode: "image"
    seed: 4
    input0: "test"

    count: 16384
    spread: 6.0
    size: 0.09

    beat_pulse: "0.4 * (0.2 + 1.6*p0)"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "FOCUS", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x050508

    cam_dist: 7.5
    cam_height: 0.0
    cam_orbit: 0.0
    fog: 0.0

    stages: [
        {kind: "tiltshift", focus: "p1", width: 0.26, levels: 3},
        {kind: "bloom", threshold: 0.6, strength: "1.1 * (0.25 + 1.5*p2)", levels: 2}
    ]
}
