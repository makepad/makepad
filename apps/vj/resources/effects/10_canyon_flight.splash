// CANYON FLIGHT — the same terrain engine with ridged folding: fbm folds
// into canyon walls either side of the corridor, warm ember palette.
{
    name: "Canyon Flight"
    engine: "heightmap"

    res: 150
    size: 30.0
    height: 4.2
    noise_scale: 0.20
    scroll: 4.5
    ridged: 1.0

    beat_pulse: 0.4
    beat_rate: 0.5

    color_bg: #x100404
    color_a: #xff6a20
    color_b: #xffd050
    color_c: #xfff8e8

    cam_fov: 70.0
    cam_height: 3.4
    fog: 0.06
    glow: 1.1

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 3},
        {kind: "feedback", amount: 0.35, zoom: 1.008, rotate: 0.0, dim: 0.92}
    ]
}
