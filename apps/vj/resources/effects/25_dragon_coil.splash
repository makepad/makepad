// DRAGON COIL — the dragon-curve rewriting system drawn as a glowing
// space-filling ribbon. Pattern taught: structure symbols X/Y carry the
// program; only F draws — 90-degree angles give the classic fold.
{
    name: "Dragon Coil"
    engine: "lsystem"
    seed: 3

    axiom: "FX"
    rules: ["X=X+YF+", "Y=-FX-Y"]
    iterations: 12
    angle: 90.0
    step: 0.10
    radius: 0.035
    sides: 4

    grow: "loop"
    grow_beats: 16
    sway: 0.15
    sway_freq: 0.4
    beat_pulse: 0.5
    twist: 0.04

    color_bg: #x0a0312
    color_a: #xff3fd8
    color_b: #x3fd8ff
    color_c: #xffffff

    cam_orbit: 0.11
    fog: 0.03
    glow: 1.35

    stages: [
        {kind: "bloom", threshold: 0.45, strength: 1.4, levels: 3},
        {kind: "feedback", amount: 0.45, zoom: 1.003, rotate: 0.002, dim: 0.94}
    ]
}
