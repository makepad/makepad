// LUMA CANYON — the live content EXTRUDED: terrain height is 70% the
// input's luminance, 30% noise, flown through in ember colors. The
// pin-screen video effect.
{
    name: "Luma Canyon"
    engine: "heightmap"
    input0: "test"

    res: 150
    size: 28.0
    height: 3.8
    scroll: 0.8
    tex_displace: 0.7
    noise_scale: 0.18

    beat_pulse: "0.45 * (0.2 + 1.6*p0)"
    glow: "0.25 + 1.5*p1"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "GLOW", bind: "p1", default: 0.5},
        {name: "HAZE", bind: "p2", default: 0.5}
    ]

    color_bg: #x0c0503
    color_a: #xff8830
    color_b: #xffd070
    color_c: #xfff4dd

    cam_fov: 60.0
    cam_height: 4.4
    fog: "0.05 * (0.2 + 1.6*p2)"

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 3}
    ]
}
