// CODE RAIN — terminal-green streaks with a glitch slice on the beat.
// Pattern taught: rain mode + heavy stretch reads as falling code; the
// glitch stage's jitter is BOUND so rows tear only on the pulse.
{
    name: "Code Rain"
    engine: "particles"
    mode: "rain"
    seed: 13

    count: 6000
    spread: 6.0
    size: 0.05
    rate: 0.9
    stretch: 11.0

    beat_pulse: 0.5

    color_bg: #x020803
    color_a: #x33ff66
    color_b: #x0d8833
    color_c: #xccffdd

    cam_dist: 9.0
    cam_height: 0.0
    cam_orbit: 0.0
    fog: 0.04

    stages: [
        {kind: "glitch", p1: 0.6, p2: "pulse * 0.8"},
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 2}
    ]
}
