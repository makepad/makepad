// FERN UNFURL — the classic asymmetric fern rule, breathing open and
// closed (pingpong growth). Pattern taught here: asymmetric rules
// (`[+X]` vs bare `-X`) give fronds instead of symmetric shrubs.
{
    name: "Fern Unfurl"
    engine: "lsystem"
    seed: 31

    axiom: "X"
    rules: ["X=F[+X]F[-X]+X", "F=FF"]
    iterations: 6
    angle: 22.0
    step: 0.055
    radius: 0.03
    sides: 4

    grow: "pingpong"
    grow_beats: 12
    sway: "0.7 * (0.25 + 1.5*p0)"
    sway_freq: 0.6
    beat_pulse: "0.3 * (0.2 + 1.6*p1)"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "WIND", bind: "p0", default: 0.5},
        {name: "PUMP", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x03080a
    color_a: #x1fbb66
    color_b: #x9fee66
    color_c: #xeaffcc

    cam_orbit: 0.10
    fog: 0.03
    glow: "1.25 * (0.25 + 1.5*p2)"

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.2, levels: 2}
    ]
}
