// NIGHT STRIKE — the night-vision sortie: mono-green luminance ramp with
// live sensor grain, the jet a hot silhouette over cold ridges, burner
// blooming hard. Pattern taught: the `look: "nightvision"` branch — one
// palette slot (color_a) carries the whole phosphor look.
{
    name: "Night Strike"
    engine: "mountainjet"

    res: 140
    size: 34.0
    height: 4.8
    noise_scale: 0.19
    scroll: 5.0
    ridged: 0.6
    cells: 40
    look: "nightvision"
    jet_size: 1.0
    weave: 0.9

    beat_pulse: 0.45
    beat_rate: 0.5
    p0: "0.4 + 1.5 * pulse"

    color_bg: #x021006
    color_a: #x48ff88
    color_b: #x90ffb8
    color_c: #xd8ffe8

    cam_fov: 66.0
    cam_height: 4.2
    cam_orbit: 0.0
    fog: 0.055
    glow: 1.15

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.4, levels: 3},
        {kind: "posterize", p1: 0.6, p2: 0.55}
    ]
}
