// ROTO SLIDE — rotate the frame, then slide it along the tilted axis;
// the picture streams past at an angle and wraps, tiled.
{
    name: "Roto Slide"
    engine: "screen"
    input0: "test"

    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "SPIN", bind: "p0", default: 0.5},
        {name: "SLIDE", bind: "p1", default: 0.5},
        {name: "ZOOM", bind: "p2", default: 0.5}
    ]

    stages: [
        {kind: "bloom", threshold: 0.6, strength: 1.05, levels: 2}
    ]

    shader: draw.DrawVjFxScreen {
        fx_color: fn(uv: vec2, content: vec4, cmix: float) -> vec4 {
            let ang = (self.user.x - 0.5) * 1.2
            let cs = cos(ang)
            let sn = sin(ang)
            let zoom = 0.2 + 1.6 * self.user.z
            let slide = modf(self.time_beat.x * 0.12 * (0.2 + 1.6 * self.user.y), 1.0)
            let c = uv - vec2(0.5, 0.5)
            let r = vec2(c.x * cs - c.y * sn, c.x * sn + c.y * cs) / zoom
            let w = fract(r + vec2(0.5 + slide, 0.5))
            let tex = self.tex0.sample_as_bgra(w)
            return vec4(tex.xyz, 1.0)
        }
    }
}
