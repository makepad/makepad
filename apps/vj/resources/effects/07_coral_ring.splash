// CORAL RING — five 3D L-system shrubs in a ring, pitch-and-roll rules so
// they branch in all three axes, breathing in and out (pingpong growth).
{
    name: "Coral Ring"
    engine: "lsystem"
    seed: 41

    axiom: "A"
    rules: ["A=!F[&FA][^FA][+FA][-FA]", "F=F'F"]
    iterations: 5
    angle: 28.0
    angle_jitter: 6.0
    step: 0.14
    radius: 0.075
    radius_decay: 0.72
    sides: 6
    copies: 5

    grow: "pingpong"
    grow_beats: 8
    sway: "1.1 * (0.25 + 1.5*p0)"
    sway_freq: 0.5
    twist: 0.25
    beat_pulse: "0.5 * (0.2 + 1.6*p1)"
    beat_rate: 1.0
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "WIND", bind: "p0", default: 0.5},
        {name: "PUMP", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x0a0304
    color_a: #xff8850
    color_b: #xffd080
    color_c: #xfff4e0

    cam_orbit: 0.10
    fog: 0.02
    glow: "1.5 * (0.25 + 1.5*p2)"

    stages: [
        {kind: "bloom", threshold: 0.45, strength: 1.3, levels: 3},
        {kind: "feedback", amount: 0.4, zoom: 1.004, rotate: 0.002, dim: 0.93}
    ]
}
