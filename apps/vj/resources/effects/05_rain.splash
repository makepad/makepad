// NEON RAIN — stretched streak sprites falling through the volume, a
// short feedback tail smearing them into rods of light.
{
    name: "Neon Rain"
    engine: "particles"
    mode: "rain"
    seed: 5

    count: 5000
    spread: 6.0
    size: 0.05
    rate: 0.8
    stretch: 9.0

    beat_pulse: "0.5 * (0.2 + 1.6*p0)"
    beat_rate: 1.0
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "TRAIL", bind: "p1", default: 0.5},
        {name: "GLOW", bind: "p2", default: 0.5}
    ]

    color_bg: #x04060c
    color_a: #x66ccff
    color_b: #x3344dd
    color_c: #xeaf6ff

    cam_dist: 10.0
    cam_height: 0.5
    cam_orbit: 0.04
    fog: 0.04

    stages: [
        {kind: "feedback", amount: "min(0.5 + (p1-0.5)*0.8, 0.97)", zoom: 1.0, rotate: 0.0, dim: 0.88},
        {kind: "bloom", threshold: 0.45, strength: "1.3 * (0.25 + 1.5*p2)", levels: 2}
    ]
}
