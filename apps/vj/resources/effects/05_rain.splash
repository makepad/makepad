// NEON RAIN — stretched streak sprites falling through the volume, a
// short feedback tail smearing them into rods of light.
{
    name: "Neon Rain"
    engine: "particles"
    mode: "rain"
    seed: 5

    count: 5000
    spread: 6.0
    size: 0.05
    rate: 0.8
    stretch: 9.0

    beat_pulse: 0.5
    beat_rate: 1.0

    color_bg: #x04060c
    color_a: #x66ccff
    color_b: #x3344dd
    color_c: #xeaf6ff

    cam_dist: 10.0
    cam_height: 0.5
    cam_orbit: 0.04
    fog: 0.04

    stages: [
        {kind: "feedback", amount: 0.5, zoom: 1.0, rotate: 0.0, dim: 0.88},
        {kind: "bloom", threshold: 0.45, strength: 1.3, levels: 2}
    ]
}
