// LISSAJOUS SCOPE — flying through an oscilloscope figure: the tunnel's
// centerline is a 3:2 Lissajous curve, phosphor-green on black, thin
// bands. Pattern taught: `path: "lissajous"` + knot_p/q as frequencies.
{
    name: "Lissajous Scope"
    engine: "tunnel"
    path: "lissajous"

    knot_p: 3.0
    knot_q: 2.0
    major: 6.5
    tube: 1.1
    rings: 900
    sides: 18
    fly: 3.6
    bands: 160.0

    beat_pulse: "0.6 * (0.2 + 1.6*p0)"
    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "PUMP", bind: "p0", default: 0.5},
        {name: "GLOW", bind: "p1", default: 0.5},
        {name: "FLARE", bind: "p2", default: 0.5}
    ]

    color_bg: #x020604
    color_a: #x33ff88
    color_b: #x11aa55
    color_c: #xbbffcc

    fog: 0.09
    glow: "1.3 * (0.25 + 1.5*p1)"

    stages: [
        {kind: "bloom", threshold: "clamp(0.35 - (p2-0.5)*0.5, 0.02, 0.95)", strength: 1.6, levels: 3}
    ]
}
