// LISSAJOUS SCOPE — flying through an oscilloscope figure: the tunnel's
// centerline is a 3:2 Lissajous curve, phosphor-green on black, thin
// bands. Pattern taught: `path: "lissajous"` + knot_p/q as frequencies.
{
    name: "Lissajous Scope"
    engine: "tunnel"
    path: "lissajous"

    knot_p: 3.0
    knot_q: 2.0
    major: 6.5
    tube: 1.1
    rings: 900
    sides: 18
    fly: 3.6
    bands: 160.0

    beat_pulse: 0.6

    color_bg: #x020604
    color_a: #x33ff88
    color_b: #x11aa55
    color_c: #xbbffcc

    fog: 0.09
    glow: 1.3

    stages: [
        {kind: "bloom", threshold: 0.35, strength: 1.6, levels: 3}
    ]
}
