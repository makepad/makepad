// STARFIELD WARP — the jump-to-lightspeed: tunnel-mode particles with
// heavy stretch + radial blur that KICKS on the beat (bound parameter).
{
    name: "Starfield Warp"
    engine: "particles"
    mode: "tunnel"
    seed: 42

    count: 5000
    spread: 4.0
    size: 0.06
    rate: 0.7
    swirl: 0.2
    stretch: 14.0

    beat_pulse: 0.7

    color_bg: #x020208
    color_a: #xffffff
    color_b: #x88aaff
    color_c: #xffffff

    cam_dist: 3.0
    cam_height: 0.0
    cam_orbit: 0.0
    cam_fov: 85.0
    fog: 0.015

    stages: [
        {kind: "radial_blur", p1: "0.2 + pulse * 0.75", p2: 0.5},
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 2}
    ]
}
