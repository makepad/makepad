// WIPE VERTICAL — the top-to-bottom edge; FLIP runs it bottom-up.
// Same idiom as 102, on uv.y.
{
    name: "Wipe Vertical"
    engine: "transition"
    dials: [
        {name: "SOFT", bind: "p0", default: 0.15},
        {name: "FLIP", bind: "p1", default: 0.0},
        {name: "DIP", bind: "p2", default: 0.0}
    ]
    shader: draw.DrawVjFxDuo {
        trans: fn(uv: vec2, t: float) -> vec4 {
            let y = mix(uv.y, 1.0 - uv.y, step(0.5, self.user.y))
            let soft = 0.004 + self.user.x * 0.25
            let tt = t * (1.0 + 2.0 * soft) - soft
            let m = smoothstep(tt - soft, tt + soft, y)
            let c = self.deck_b(uv).mix(self.deck_a(uv), m)
            // DIP: duck through black mid-fade (0 = off, the stock wipe).
            let dim = 1.0 - 4.0 * clamp(t, 0.0, 1.0) * (1.0 - clamp(t, 0.0, 1.0)) * self.user.z * 0.9
            return vec4(c.xyz * dim, 1.0)
        }
    }
}
