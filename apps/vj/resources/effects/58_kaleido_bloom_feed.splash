// KALEIDO BLOOM FEED — the required combined chain over live content:
// kaleidoscope -> bloom -> feedback, every stage beat-aware. The maximal
// fullscreen stack.
{
    name: "Kaleido Bloom Feed"
    engine: "screen"
    input0: "test"

    bar_beats: 8

    // PERFORMANCE DIALS — mid-knob = the stock look, exact.
    p0: 0.5  p1: 0.5  p2: 0.5
    dials: [
        {name: "SEGS", bind: "p0", default: 0.5},
        {name: "GLOW", bind: "p1", default: 0.5},
        {name: "TRAIL", bind: "p2", default: 0.5}
    ]

    stages: [
        {kind: "kaleido", p1: "(0.4 + tri(bar) * 0.5) * (0.2 + 1.6*p0)", p2: "0.15 + pulse * 0.5"},
        {kind: "bloom", threshold: 0.5, strength: "(1.1 + pulse * 0.6) * (0.25 + 1.5*p1)", levels: 3},
        {kind: "feedback", amount: "min(0.7 + (p2-0.5)*0.54, 0.97)", zoom: 1.015, rotate: 0.005, dim: 0.94}
    ]
}
