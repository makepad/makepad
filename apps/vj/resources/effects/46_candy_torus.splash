// CANDY TORUS — a plain ring (p=1, q=0 degenerates the knot into a torus)
// striped like a candy cane, bright and bouncy.
{
    name: "Candy Torus"
    engine: "tunnel"

    knot_p: 1.0
    knot_q: 0.0
    major: 6.0
    tube: 1.6
    rings: 520
    sides: 24
    fly: 4.5
    bands: 220.0

    beat_pulse: 0.7

    color_bg: #x12040a
    color_a: #xff6688
    color_b: #xffffff
    color_c: #xffccdd

    fog: 0.07
    glow: 1.25

    stages: [
        {kind: "bloom", threshold: 0.5, strength: 1.3, levels: 3}
    ]
}
