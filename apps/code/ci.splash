// CI smoke test for apps/code. Run by devhub ci, which finds every `ci.splash`
// in the checkout. The script decides every input; the vision model only
// judges the grab against the acceptance text below. Basic on purpose: does
// it check everywhere, build and come up here, and look like what it is.
// CODE_MOCK=1 runs the window against its scripted agent, so no model or
// hub is needed.

use mod.std.*
use mod.ci;

ci.step("check other platforms", fn(){
    ci.check_targets({packages: ["makepad-app-code"] targets: ci.host.targets})
})

let app = ci.launch({package: "makepad-app-code" binary: "makepad-app-code" cwd: "." app_env: {CODE_MOCK: "1"}})

ci.step("comes up", fn(){
    ci.sleep(3.0)
    app.no_errors()
    let shot = app.grab("start")
    ci.accept(shot, "This is a screenshot of one application window. A thin bright red frame runs around the very edge of the picture; it is the test harness's marker and is not part of the application. Ignore it. The application is a coding assistant: a dark window with a left sidebar (a New session button, a list of sessions, a file list), a large conversation area, a message box at the bottom and a status bar. 1. Is the whole picture one flat colour from edge to edge, such as entirely black or entirely white? expected NO 2. Is any user interface visible, such as text labels, buttons, icons, panels, lists, input fields or a toolbar? expected YES 3. Does an error panel cover the window: a large block of text with words such as panic, error, failed, backtrace or unwrap? expected NO")
})

app.no_errors()
app.quit()
nil
