            }
            View{width: Fill height: Fit flow: Down align: Center spacing: 4
                RoundedView{width: 14 height: 120 draw_bg.color: #xcc66ff draw_bg.radius: 2.}
                Label{text: "19" draw_text.color: #x888899 draw_text.text_style.font_size: 7}
            }
            View{width: Fill height: Fit flow: Down align: Center spacing: 4
                RoundedView{width: 14 height: 112 draw_bg.color: #xbb55ff draw_bg.radius: 2.}
                Label{text: "20" draw_text.color: #x666677 draw_text.text_style.font_size: 7}
            }
        }
    }

    // Model distribution
    RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 16. bottom: 16.} flow: Down spacing: 12
        Label{text: "Model Distribution" draw_text.color: #xaaaacc draw_text.text_style.font_size: 12}
        View{width: Fill height: 24 flow: Right
            RoundedView{width: 496 height: Fill draw_bg.color: #x7733cc draw_bg.radius: 4.}
            RoundedView{width: 224 height: Fill draw_bg.color: #x3366aa draw_bg.radius: 4.}
            RoundedView{width: 80 height: Fill draw_bg.color: #x33aa66 draw_bg.radius: 4.}
        }
        View{width: Fill height: Fit flow: Right spacing: 24
            View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                RoundedView{width: 10 height: 10 draw_bg.color: #xcc66ff draw_bg.radius: 2.}
                Label{text: "Opus 4 — 62%" draw_text.color: #xcc66ff draw_text.text_style.font_size: 11}
            }
            View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                RoundedView{width: 10 height: 10 draw_bg.color: #x66aaff draw_bg.radius: 2.}
                Label{text: "Sonnet 4 — 28%" draw_text.color: #x66aaff draw_text.text_style.font_size: 11}
            }
            View{width: Fit height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                RoundedView{width: 10 height: 10 draw_bg.color: #x66ffaa draw_bg.radius: 2.}
                Label{text: "Haiku 4 — 10%" draw_text.color: #x66ffaa draw_text.text_style.font_size: 11}
            }
        }
    }

    // Peak day
    RoundedView{width: Fill height: Fit draw_bg.color: #x1a1122 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 12. bottom: 12.} flow: Right spacing: 12 align: Align{y: 0.5}
        Label{text: "📈" draw_text.text_style.font_size: 18}
        View{flow: Down spacing: 2
            Label{text: "Peak Day: March 19 — 3.1M input + 850K output" draw_text.color: #xddddee draw_text.text_style.font_size: 11}
        }
