SolidView{width: Fill height: Fit draw_bg.color: #x0c0c18 flow: Down padding: Inset{left: 32. right: 32. top: 24. bottom: 24.} spacing: 20

    // Header
    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
        Label{text: "March 2025 Token Usage" draw_text.color: #xeeeeff draw_text.text_style.font_size: 20}
        Filler{}
        Label{text: "Claude Code" draw_text.color: #x666688 draw_text.text_style.font_size: 12}
    }

    // Summary cards
    View{width: Fill height: Fit flow: Right spacing: 16
        RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 16. bottom: 16.} flow: Down spacing: 6
            Label{text: "Input Tokens" draw_text.color: #x888899 draw_text.text_style.font_size: 10}
            Label{text: "48.5M" draw_text.color: #xcc66ff draw_text.text_style.font_size: 28}
        }
        RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 16. bottom: 16.} flow: Down spacing: 6
            Label{text: "Output Tokens" draw_text.color: #x888899 draw_text.text_style.font_size: 10}
            Label{text: "12.3M" draw_text.color: #x66aaff draw_text.text_style.font_size: 28}
        }
        RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 16. bottom: 16.} flow: Down spacing: 6
            Label{text: "Estimated Cost" draw_text.color: #x888899 draw_text.text_style.font_size: 10}
            Label{text: "$186.50" draw_text.color: #x66ffaa draw_text.text_style.font_size: 28}
        }
        RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 20. right: 20. top: 16. bottom: 16.} flow: Down spacing: 6
            Label{text: "Active Days" draw_text.color: #x888899 draw_text.text_style.font_size: 10}
            Label{text: "20 / 31" draw_text.color: #xffaa66 draw_text.text_style.font_size: 28}
        }
    }

    // Bar chart — each column is a View{flow:Down} with bar + date label
    RoundedView{width: Fill height: Fit draw_bg.color: #x161628 draw_bg.radius: 8. padding: Inset{left: 16. right: 16. top: 16. bottom: 12.} flow: Down spacing: 6
        Label{text: "Daily Input Tokens" draw_text.color: #xaaaacc draw_text.text_style.font_size: 12}
        View{width: Fill height: 130 flow: Right spacing: 2 align: Align{y: 1.0}
            View{width: Fill height: Fit flow: Down align: Center spacing: 4
                RoundedView{width: 14 height: 38 draw_bg.color: #x7733cc draw_bg.radius: 2.}
                Label{text: "01" draw_text.color: #x444455 draw_text.text_style.font_size: 7}
            }
            View{width: Fill height: Fit flow: Down align: Center spacing: 4
                RoundedView{width: 14 height: 43 draw_bg.color: #x7733cc draw_bg.radius: 2.}
                Label{text: "02" draw_text.color: #x444455 draw_text.text_style.font_size: 7}
            }
            View{width: Fill height: Fit flow: Down align: Center spacing: 4
