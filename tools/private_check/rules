# Generic private-data rules (tools/private_check/scan.sh reads this file and ~/.makepad/private_patterns).
#
# <rule> <ERE>         a line the POSIX extended regex matches, case-insensitively, breaks <rule>
# except <rule> <ERE>  a match of <rule> this regex matches in full is fine (placeholders)
# define <name> <ERE>  `@<name>@` in a rule stands for (<ERE>); a rule naming one no file defines is off
#
# Only the ERE subset grep, git grep and awk share: no \b \d \s \w, no {m,n}, no backreferences.
# Always fine: the documentation ranges 192.0.2/24, 198.51.100/24 and 203.0.113/24, the hotspot subnet
# 192.168.77/24 with the test ranges 10.77.0/24 and 172.16.77/24, and loopback: no rule matches them.

# RFC 1918 addresses
lan-address (^|[^0-9.])10\.(([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9])\.[0-9][0-9]?[0-9]?|77\.[1-9][0-9]?[0-9]?)\.[0-9][0-9]?[0-9]?([^0-9.]|\.[^0-9]|\.?$)
lan-address (^|[^0-9.])192\.168\.([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9])\.[0-9][0-9]?[0-9]?([^0-9.]|\.[^0-9]|\.?$)
lan-address (^|[^0-9.])172\.((1[7-9]|2[0-9]|3[01])\.[0-9][0-9]?[0-9]?|16\.([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9]))\.[0-9][0-9]?[0-9]?([^0-9.]|\.[^0-9]|\.?$)
# the same as Rust writes them: a byte array (`[10, 0, 0, N].into()`) or Ipv4Addr::new (same exemptions)
lan-address \[ *10, *0, *0, *[0-9][0-9]?[0-9]? *\]
lan-address ipv4addr::new\( *10, *(([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9]), *[0-9][0-9]?[0-9]?|77, *[1-9][0-9]?[0-9]?), *[0-9][0-9]?[0-9]? *\)
lan-address (\[|ipv4addr::new\() *192, *168, *([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9]), *[0-9][0-9]?[0-9]? *(\]|\))
lan-address (\[|ipv4addr::new\() *172, *((1[7-9]|2[0-9]|3[01]), *[0-9][0-9]?[0-9]?|16, *([0-9]|[0-689][0-9]|7[0-689]|[0-9][0-9][0-9])), *[0-9][0-9]?[0-9]? *(\]|\))

# a home directory under its owner's name: write repo-relative paths, ~ or $HOME
home-path (^|[^a-z0-9_.-])/users/[a-z0-9_.-]+
home-path (^|[^a-z0-9_.-])/home/[a-z0-9_.-]+
home-path [a-z]:(\\|/)+users(\\|/)+[a-z0-9_.-]+
home-path (^|[^a-z0-9_.-])/[a-z]/users/[a-z0-9_.-]+
except home-path .?/users/(me|you|[a-z]|name|user|username|someone|someone-backup|someone-else|someone_else|owner|shared|public|runner|janedoe)[.]*
except home-path .?/home/(me|you|[a-z]|name|user|username|someone|owner|runner|\.[a-z0-9_.-]+)[.]*
except home-path [a-z]:(\\|/)+users(\\|/)+(me|you|[a-z]|name|user|username|someone|public|default|runneradmin)[.]*
except home-path .?/[a-z]/users/(me|you|[a-z]|name|user|username|someone|public)[.]*

# a GPU model on the same line as an address or a node: a machine's inventory
gpu-near-host (rtx|gtx|quadro|titan)[ -]?(pro[ -]?)?[0-9][0-9][0-9]|radeon[ -](rx|pro)|geforce|apple m[1-9]|(^|[^a-z0-9])m[1-9] (pro|max|ultra)
and gpu-near-host [0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?|(node|box|host|machine)[ #-]?[0-9]

# a node's number as its machine's name, for the numbers the untracked patterns give as
# `define node-number <ERE>` (none there: these are off): "<N>'s", "<N>, <date>", "<N> sat" (the
# subject of a verb), "(<N>, ... <date>)", "(<date>, ... <N>)". Seven comments such as "(<N>, 11-06)"
# and "<N>'s" reached work through the hooks (11-06). The number after a word that makes it a code,
# a count or a place in something (`exit <N>`, `line <N> is`) is none, nor one inside a name.
node-number (^|[^0-9a-z.#_:/=-])([a-z]+ +)?@node-number@'s([^a-z0-9_]|$)
node-number (^|[^0-9a-z.#_:/=-])([a-z]+ +)?@node-number@, (20[0-9][0-9]-)?[01][0-9]-[0-3][0-9]([^0-9]|$)
node-number (^|[^0-9a-z.#_:/=-])([a-z]+ +)?@node-number@ (sat|sits|ran|runs|took|takes|showed|shows|saw|sees|lost|loses|kept|keeps|went|goes|booted|boots|rebooted|reboots|crashed|crashes|hung|hangs|stalled|stalls|froze|freezes|died|dies|answered|answers|refused|refuses|restarted|restarts|stopped|stops|served|serves|built|builds|rebuilt|rebuilds|rolled|rolls|woke|wakes|slept|sleeps|swapped|swaps|panicked|idled|idles|shipped|ships)([^a-z0-9_]|$)
node-number \(([^()]*[^0-9a-z.#_:/=-])?([a-z]+ +)?@node-number@(,|;| and | or )([^()]*[^0-9])?(20[0-9][0-9]-)?[01][0-9]-[0-3][0-9]([^0-9)][^()]*)?\)
node-number \(([^()]*[^0-9])?(20[0-9][0-9]-)?[01][0-9]-[0-3][0-9][^0-9)]([^()]*[^0-9a-z.#_:/=-])?([a-z]+ +)?@node-number@(\)|(,|;| and | or )[^()]*\))
# "(<N>: ...)", a note the box's number leads, and "held <N> at", "on <N>.", a box held or worked on:
# "(<N>: budget cores 16)" and "held <N> at" reached work past the shapes above (11-07). The number
# ends the phrase there or a small word follows it, so "holds <N> bytes" or "on <N> files" is none.
node-number \(@node-number@:([^0-9]|$)
node-number (^|[^a-z0-9_])(held|holds|holding|hold|on|onto|to|from|beside|behind|left|leaves) +@node-number@( *([^ 0-9a-z_.]|$|\.([^0-9]|$))| +(at|and|or|in|by|for|with|while|behind|beside|until|since|before|after|when|as|is|was|its)([^a-z0-9_]|$))
# "<word>-<N>", a job or lease named after its box ("prebuild-<N>"): two doc comments reached work
# past the shapes above (11-08). A two-letter code ("WR-<N>"), a number inside a longer one, or a
# field, line or test number ("field-<N>") is none.
node-number (^|[^0-9a-z.#_:/=-])[a-z][a-z][a-z]+-@node-number@([^0-9a-z_.]|$|\.([^0-9]|$))
except node-number (.*[^a-z])?(field|issue|line|page|item|step|frame|test|case|version|port)-@node-number@.*
except node-number (.*[^a-z])?(exit|code|codes|status|signal|errno|rc|returns|returned|error|errors|line|lines|col|column|row|page|item|items|step|steps|frame|frames|byte|bytes|seq|id|pid|port|lease|job|issue|pr|version|test|tests|case|cases|count|took|value|len|size|width|height|offset|index|slot|round|rounds|attempt|tries) +@node-number@.*

# the same numbers in the shapes a machine name takes in scripts, confs, usage lines and tests (several of
# them reached work because only the prose shapes above were scanned): a shell case arm
# (`<N>)`, `a|<N>)`, `<N>|a)`), a quoted name beside node, host, name or server, `name = <N>`,
# `[host.<N>]`, `-Name <N>`, `--node <N>`, `node=<N>`, `usage (<N>)`, and the notes "(<N>, the ...",
# "(lane ..., <N>)". A bare number is none: it would flag every constant.
node-number ^[ 	]*(@node-number@\|)*@node-number@\)
node-number (^|[^0-9a-z_.-])@node-number@\|[a-z*]
node-number [a-z*]\|@node-number@\)
node-number (node|nodes|host|hosts|name|names|server|box|machine|--node)[^"']?[^"']?[^"']?[^"']?[^"']?[^"']?["']@node-number@["']
node-number (^|[^a-z0-9_])(name|node) *[=:] *["']?@node-number@([^0-9.]|$)
node-number \[host\.@node-number@\]
node-number (^|[^a-z0-9_])-name +@node-number@([^0-9]|$)
node-number (--node[ =]+|node=)@node-number@([^0-9.]|$)
node-number usage *\(@node-number@\)
node-number \(@node-number@, +(the|a|an|lane|user|node|when|after|before|on|with)([^a-z]|$)
node-number (lane|trace|user|session|run|bench|measured)[a-z ]*, @node-number@\)
